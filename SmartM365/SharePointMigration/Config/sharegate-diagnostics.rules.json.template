{
  "Rules": [
    {"Id":"SG-IMPORT","Regex":"(?i)(?:import status|import microsoft 365\\s*:\\s*statut).{0,80}(?:failed|error|failed import|echec|échoué)|(?:insane|import job).{0,80}(?:failed|error|echec|échoué)","Category":"Import failure","Severity":"Error","ProbableCause":"Microsoft 365 import did not complete.","Remediation":"Review import job details and ShareGate logs before choosing NormalMode.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-THROTTLE","Regex":"(?i)(?:throttl|429|503|too many requests|limitation de débit)","Category":"Throttling","Severity":"Warning","ProbableCause":"The service limited the import rate.","Remediation":"Review retry timing and import statistics.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-ACCESS-SOURCE","Regex":"(?i)(?:source|on.prem|on premises).{0,80}(?:access denied|unauthori[sz]ed|permission|refus d.accès)|(?:access denied|unauthori[sz]ed|permission|refus d.accès).{0,80}(?:source|on.prem|on premises)","Category":"Source access","Severity":"Error","ProbableCause":"The migration account may lack source permissions.","Remediation":"Verify source farm, site and item access with the migration account.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-ACCESS-TARGET","Regex":"(?i)(?:destination|target|sharepoint online|spo).{0,80}(?:access denied|unauthori[sz]ed|permission|refus d.accès)|(?:access denied|unauthori[sz]ed|permission|refus d.accès).{0,80}(?:destination|target|sharepoint online|spo)","Category":"Destination access","Severity":"Error","ProbableCause":"The migration account may lack destination permissions.","Remediation":"Verify SharePoint Online site collection administration and item access.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-ACCESS-UNKNOWN","Regex":"(?i)(?:access denied|unauthori[sz]ed|permission denied|refus d.accès|not authorized)","Category":"Access side undetermined","Severity":"Error","ProbableCause":"The report does not identify which endpoint rejected access.","Remediation":"Inspect the raw details and test source and destination access separately.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-DEST-MULTIPLE","Regex":"(?i)(?:multiple|several|plusieurs).{0,80}(?:matching|correspond|destination)|(?:matching|correspond).{0,80}(?:multiple|several|plusieurs)","Category":"Ambiguous destination match","Severity":"Error","ProbableCause":"More than one destination object matches the source.","Remediation":"Resolve destination identity and mapping before any retry.","ShareGateAction":"MappingReview","DefaultState":"To fix"},
    {"Id":"SG-INACTIVE-USER","Regex":"(?i)(?:user|utilisateur|account|compte).{0,100}(?:inactive|disabled|deleted|désactivé|supprimé)|(?:inactive|disabled|deleted|désactivé|supprimé).{0,100}(?:user|utilisateur|account|compte)","Category":"Inactive or deleted user","Severity":"Warning","ProbableCause":"The source principal has no active destination identity.","Remediation":"Complete and review the user/group mapping before any retry.","ShareGateAction":"MappingReview","DefaultState":"To fix"},
    {"Id":"SG-SITE-FEATURE","Regex":"(?i)(?:feature|fonctionnalité).{0,100}(?:not available|unavailable|not supported|indisponible|non prise en charge)|(?:not available|unavailable|not supported|indisponible|non prise en charge).{0,100}(?:feature|fonctionnalité)","Category":"Unavailable site feature","Severity":"Warning","ProbableCause":"The source feature may not exist in SharePoint Online.","Remediation":"Confirm the functional impact and document acceptance or replacement.","ShareGateAction":"Manual","DefaultState":"Accepted"},
    {"Id":"SG-MODERN-LINK","Regex":"(?i)(?:modern web part|composant moderne).{0,150}(?:references another|different site|autre site|référence un autre)","Category":"Modern component link","Severity":"Warning","ProbableCause":"A component link refers to another site.","Remediation":"Review and update the link after migration.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-SHORTCUT","Regex":"(?i)(?:shortcut links|_ShortcutUrl|liens? de raccourci).{0,150}(?:doesn.t support|unsupported|not supported|non pris|non prise)|(?:doesn.t support|unsupported|not supported|non pris|non prise).{0,150}(?:shortcut links|_ShortcutUrl|liens? de raccourci)","Category":"Unsupported shortcut","Severity":"Warning","ProbableCause":"The shortcut cannot be migrated automatically.","Remediation":"Recreate or replace the shortcut after migration.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-WEBPART","Regex":"(?i)(?:web part|composant).{0,100}(?:could not be found|misconfigured|introuvable|mal configuré)","Category":"Missing or misconfigured web part","Severity":"Warning","ProbableCause":"The destination lacks an app or compatible component.","Remediation":"Review the destination app and replace the component manually.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-PATH","Regex":"(?i)(?:path|chemin|name|nom).{0,80}(?:too long|invalid character|trop long|caractère invalide)","Category":"Invalid path or name","Severity":"Error","ProbableCause":"A source path or name violates destination limits.","Remediation":"Review a safe rename or restructuring plan.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-FILE-BLOCK","Regex":"(?i)(?:file size|file type|taille du fichier|type de fichier).{0,80}(?:blocked|unsupported|exceed|bloqué|non pris|dépasse)","Category":"Blocked file","Severity":"Error","ProbableCause":"The destination blocks this file size or type.","Remediation":"Review policy and file handling options.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-LOCK","Regex":"(?i)(?:checked out|locked|extrait|verrouillé)","Category":"Checked out or locked item","Severity":"Warning","ProbableCause":"The source item may be locked or checked out.","Remediation":"Resolve the lock or checkout with the owner.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-TERM","Regex":"(?i)(?:term|terme).{0,80}(?:not found|missing|introuvable|manquant)","Category":"Missing taxonomy term","Severity":"Error","ProbableCause":"A managed metadata term is absent from the destination.","Remediation":"Create or map the destination term.","ShareGateAction":"MappingReview","DefaultState":"To fix"},
    {"Id":"SG-LOOKUP","Regex":"(?i)(?:lookup|recherche).{0,80}(?:not found|missing|introuvable|manquant)","Category":"Missing lookup","Severity":"Error","ProbableCause":"The referenced destination list or item is absent.","Remediation":"Migrate or map the referenced list first.","ShareGateAction":"MappingReview","DefaultState":"To fix"},
    {"Id":"SG-SCHEMA","Regex":"(?i)(?:content type|site column|type de contenu|colonne de site).{0,80}(?:not found|missing|introuvable|manquant)","Category":"Missing content schema","Severity":"Error","ProbableCause":"A destination content type or site column is absent.","Remediation":"Create or map the schema before retry.","ShareGateAction":"MappingReview","DefaultState":"To fix"},
    {"Id":"SG-CUSTOM","Regex":"(?i)(?:workflow|infopath|custom solution|web part|flux de travail|solution personnalisée).{0,80}(?:unsupported|not supported|non pris|non prise)","Category":"Unsupported customization","Severity":"Warning","ProbableCause":"The customization is not supported in SharePoint Online.","Remediation":"Plan a manual replacement or document acceptance.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-TEMPLATE","Regex":"(?i)(?:list template|site template|modèle de liste|modèle de site).{0,80}(?:unsupported|not supported|non pris|non prise)","Category":"Unsupported template","Severity":"Warning","ProbableCause":"The source template is not supported by the destination.","Remediation":"Choose a supported replacement template.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-VERSIONS","Regex":"(?i)(?:version limit|too many versions|limite de versions)","Category":"Version limit","Severity":"Warning","ProbableCause":"The version history exceeds a configured limit.","Remediation":"Review preservation requirements and copy settings.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-EXISTS","Regex":"(?i)(?:already exists|existe déjà)","Category":"Already exists","Severity":"Warning","ProbableCause":"A destination object already exists.","Remediation":"Compare identities and copy options before retry.","ShareGateAction":"Review","DefaultState":"To fix"},
    {"Id":"SG-UNIQUE-PERM","Regex":"(?i)(?:unique permission|unique security|permissions uniques).{0,80}(?:limit|threshold|limite|seuil)","Category":"Unique permission limit","Severity":"Error","ProbableCause":"The destination may have reached a permission-scope limit.","Remediation":"Review permission design and inheritance.","ShareGateAction":"Manual","DefaultState":"To fix"},
    {"Id":"SG-LARGE-LIST","Regex":"(?i)(?:list view threshold|large list threshold|seuil de liste|liste volumineuse)","Category":"Large list threshold","Severity":"Warning","ProbableCause":"A SharePoint list threshold affected the operation.","Remediation":"Review list indexing and batch strategy.","ShareGateAction":"Review","DefaultState":"To fix"}
  ]
}
