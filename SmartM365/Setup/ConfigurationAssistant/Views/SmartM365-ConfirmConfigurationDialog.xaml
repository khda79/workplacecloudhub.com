<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Confirm configuration" Width="700" Height="600" MinHeight="440" MinWidth="520" WindowStartupLocation="CenterOwner" Background="#F4F8FC">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Ready to apply" FontSize="23" FontWeight="SemiBold" Foreground="#17314D"/><TextBlock Text="Review the actions below before continuing." Margin="0,6,0,16" Foreground="#52677D"/></StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#D8E5F1" BorderThickness="1" CornerRadius="8" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock x:Name="Summary" TextWrapping="Wrap" FontSize="13" LineHeight="21" Foreground="#263B50"/></ScrollViewer></Border>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Changes can be partial if an action fails." Foreground="#52677D" VerticalAlignment="Center" TextWrapping="Wrap"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="Cancel" Content="Cancel" Width="95" Height="34" Margin="8,0,0,0" IsCancel="True"/><Button x:Name="Apply" Content="Apply" Width="105" Height="34" Margin="8,0,0,0" FontWeight="Bold" IsDefault="True"/></StackPanel></Grid>
 </Grid>
</Window>
