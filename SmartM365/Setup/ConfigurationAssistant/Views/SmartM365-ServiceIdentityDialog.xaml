<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Existing service account" Width="560" Height="310" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Check an existing identity" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Account as DOMAIN\account or UPN" Margin="0,16,0,4"/><TextBox x:Name="Account" Padding="5"/><TextBlock Text="Resolution may contact the directory. It checks only that the account resolves, not its permissions or credentials." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Check" Content="Check" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
