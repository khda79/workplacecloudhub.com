<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Check folder" Width="600" Height="290" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Check folder read access" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Absolute local or UNC path" Margin="0,16,0,4"/><TextBox x:Name="Path" Padding="5"/><TextBlock Text="The test attempts to list the folder as the current account. It does not test writing or the service account. It may contact the selected share." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Check" Content="Check" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
