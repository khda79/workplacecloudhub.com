<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SmartInventory Configuration" Width="1200" Height="800" MinWidth="950" MinHeight="650" Background="#F5F8FB" WindowStartupLocation="CenterScreen" WindowState="Maximized">
 <Window.Resources>
  <Style TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="16,0"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#E6F4FF"/><Setter Property="Foreground" Value="#005A9E"/><Setter Property="BorderBrush" Value="#B9DDF7"/></Style>
  <Style TargetType="Border" x:Key="Card"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DDE7F0"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18"/><Setter Property="Margin" Value="0,0,0,12"/></Style>
 </Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Style="{StaticResource Card}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SMARTM365  /  SMARTINVENTORY" Foreground="#0078D4" FontWeight="SemiBold"/><TextBlock Text="Configuration assistant" FontSize="25" FontWeight="SemiBold" Foreground="#1F2937" Margin="0,5,0,0"/><TextBlock Text="Offline tested · test qualification pending" Foreground="#5F6B7A" Margin="0,5,0,0"/></StackPanel><Image x:Name="Logo" Grid.Column="1" Height="65" Stretch="Uniform"/></Grid></Border>
  <Border Grid.Row="1" Style="{StaticResource Card}"><DockPanel><Button x:Name="Refresh" DockPanel.Dock="Right" Content="Refresh"/><Button x:Name="RunLocalBatch" Visibility="Collapsed" DockPanel.Dock="Right" Content="Run local checks" ToolTip="Read local configuration, certificate stores and local tasks. Clears session review decisions; no tenant connections or configuration changes are made."/><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Tenant profile" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="Tenant" Visibility="Collapsed"/><ComboBox x:Name="ProfileChoices" Width="170" IsEnabled="{Binding IsEnabled, ElementName=Tenant}"/><Button x:Name="NewProfile" Content="Create new profile" IsEnabled="{Binding IsEnabled, ElementName=Tenant}"/><TextBlock x:Name="ProfileDiscoveryStatus" MaxWidth="210" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#5F6B7A" TextWrapping="Wrap"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,12,12" Padding="8"><Grid><ListBox x:Name="Steps" Visibility="Collapsed" BorderThickness="0" DisplayMemberPath="Title"/><DockPanel><StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,4"><TextBlock Text="Section" Margin="0,0,0,5"/><ComboBox x:Name="PhaseOptions" DisplayMemberPath="Title"/></StackPanel><ListBox x:Name="Phases" BorderThickness="0" DisplayMemberPath="Title" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel></Grid></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock x:Name="Title" FontSize="21" FontWeight="SemiBold" Foreground="#1F2937" TextWrapping="Wrap"/><Border Grid.Row="1" Background="#E6F4FF" CornerRadius="8" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock Text="STATUS" Foreground="#005A9E" FontWeight="SemiBold"/><TextBlock x:Name="StepState" FontSize="16" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel></Border><ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,18,0,0"><TextBlock Text="Review required" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="Detail" Margin="0,8,0,18" TextWrapping="Wrap" Foreground="#1F2937"/><TextBlock Text="Action or verification required" FontWeight="SemiBold" FontSize="16"/><TextBlock x:Name="Action" Margin="0,8,0,18" TextWrapping="Wrap" Foreground="#1F2937"/><TextBlock Text="Effective access and remote permissions require separate verification." Foreground="#5F6B7A" TextWrapping="Wrap"/><StackPanel x:Name="Editor" Visibility="Collapsed" Margin="0,20,0,0"><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><ComboBox x:Name="Field" Width="230"/><Button x:Name="LoadField" Content="Read value"/></StackPanel><TextBox x:Name="Value" Margin="0,8,0,0" Padding="6"/><Button x:Name="SaveField" HorizontalAlignment="Left" Content="Review and save"/></StackPanel></StackPanel></ScrollViewer><WrapPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CheckServiceRights" Content="Direct local rights" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="ConfigureService" Content="Configure service account" Visibility="Collapsed"/><Button x:Name="CheckService" Content="Check account" Visibility="Collapsed"/><Button x:Name="ReconcileBootstrap" Content="Review a proposal" Visibility="Collapsed"/><Button x:Name="PlanBootstrap" Content="Prepare bootstrap" Visibility="Collapsed"/><Button x:Name="CheckPermissions" Content="Check Graph / Exchange" Visibility="Collapsed"/><Button x:Name="StopPermissions" Content="Stop check" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="SetScope" Content="Select scope" Visibility="Collapsed"/><Button x:Name="SetUploadCategory" Content="Categories" Visibility="Collapsed"/><Button x:Name="SetEnabled" Content="Enable / disable" Visibility="Collapsed"/><Button x:Name="CheckCatalog" Content="Analyze a catalog" Visibility="Collapsed"/><Button x:Name="StopMail" Content="Stop test" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="TestMail" Content="Test mail" Visibility="Collapsed"/><Button x:Name="CheckMail" Content="Review mail" Visibility="Collapsed"/><Button x:Name="SetCertificate" Content="Configure certificate" Visibility="Collapsed"/><Button x:Name="CheckCertificate" Content="Inspect certificate" Visibility="Collapsed"/><Button x:Name="RegisterTask" Content="Create disabled" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="PlanTask" Content="Prepare task" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="EditOrchestratorSettings" Content="Local settings" Visibility="Collapsed"/><Button x:Name="OpenOrchestratorConsole" Content="Shared jobs and cluster" Visibility="Collapsed"/><Button x:Name="CheckTask" Content="Find task" Visibility="Collapsed"/><Button x:Name="CheckShareWrite" Content="Test write access" Visibility="Collapsed"/><Button x:Name="CheckShare" Content="Test read access" Visibility="Collapsed"/><Button x:Name="CheckShareAsService" Content="Read as selected account" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="CreateService" Content="Create local account" Visibility="Collapsed"/><Button x:Name="CreateDirectoryService" Content="Create domain account" Visibility="Collapsed"/><Button x:Name="StopPrerequisites" Content="Stop" Visibility="Collapsed" IsEnabled="False"/><Button x:Name="InstallSigningCertificate" Content="Trust code-signing certificate" Visibility="Collapsed"/><Button x:Name="InstallPrerequisites" Content="Install prerequisites" Visibility="Collapsed"/><Button x:Name="AuditPrerequisites" Content="Audit local modules" Visibility="Collapsed"/><Button x:Name="CreateProfile" Content="Create profile" Visibility="Collapsed"/><Button x:Name="Previous" Content="Previous"/><Button x:Name="GuidedAction" Content="Guided action"/><ComboBox x:Name="ReviewDecision" Width="135" Height="30" Margin="4" SelectedIndex="0"><ComboBoxItem Content="Reviewed"/><ComboBoxItem Content="Needs action"/><ComboBoxItem Content="Not applicable"/></ComboBox><Button x:Name="MarkReviewed" Content="Record and continue" ToolTip="Session decision only; it does not verify access or perform actions."/><Button x:Name="Next" Content="Next"/></WrapPanel></Grid></Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0" MaxHeight="64" ClipToBounds="True"><DockPanel><Button x:Name="ShowInstallDetails" DockPanel.Dock="Right" Content="View installation details" Visibility="Collapsed"/><TextBlock x:Name="Status" Foreground="#5F6B7A" Text="Local assessment only" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxHeight="36" VerticalAlignment="Center"/></DockPanel></Border>
 </Grid>
</Window>
