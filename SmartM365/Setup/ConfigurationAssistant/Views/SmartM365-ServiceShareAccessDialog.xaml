<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Service account share access" Width="640" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Verify service account access" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Identity" Margin="0,12,0,0" TextWrapping="Wrap"/><TextBlock x:Name="Share" Margin="0,5,0,10" TextWrapping="Wrap"/><TextBlock Text="Service account password"/><PasswordBox x:Name="Password" Margin="0,4,0,0" Padding="5"/><TextBlock Text="A temporary file is written, read and removed using this account. If access is denied, you can approve granting SMB Change and folder Modify rights. The file server must be accessible and manageable." Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#5F6B7A"/><TextBlock x:Name="ProgressText" Margin="0,12,0,0" TextWrapping="Wrap"/><ProgressBar x:Name="Progress" Height="12" Margin="0,6,0,0" IsIndeterminate="True" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Check" Content="Verify access" Width="115" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
