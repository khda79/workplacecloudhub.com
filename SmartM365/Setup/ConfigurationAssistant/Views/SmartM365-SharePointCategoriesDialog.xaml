<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SharePoint categories" Width="590" Height="355" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="SharePoint upload by category" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Category" Margin="0,16,0,4"/><ComboBox x:Name="Category" SelectedIndex="0"><ComboBoxItem Content="DataAll"/><ComboBoxItem Content="DataLast"/><ComboBoxItem Content="DataPowerBI"/><ComboBoxItem Content="LogAll"/></ComboBox><TextBlock x:Name="Current" Margin="0,10,0,4"/><TextBlock Text="New selection" Margin="0,8,0,4"/><ComboBox x:Name="Choice" SelectedIndex="0"><ComboBoxItem Content="Inherit"/><ComboBoxItem Content="Enabled"/><ComboBoxItem Content="Disabled"/></ComboBox><TextBlock Text="Inherit uses the global or legacy policy. An explicit value can override the general setting. Site access and upload are not tested here." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Save" Content="Save" Width="110" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
