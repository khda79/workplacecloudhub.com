<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Reconcile a proposal" Width="760" Height="620" MinWidth="620" MinHeight="480" WindowStartupLocation="CenterOwner" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Review proposed changes" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Only unchanged defaults of a newly created profile may be replaced. Other existing values are preserved. Conflicting groups are blocked." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,8,0,12"/></StackPanel><TextBox x:Name="Summary" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10"/><StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"><Button x:Name="Cancel" Content="Close" Width="90" Height="32" Margin="4"/><Button x:Name="Apply" Content="Add to review" Padding="12,0" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
