<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Existing certificate" Width="650" Height="340" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Configure an existing certificate" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Current" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock Text="New thumbprint (40 hexadecimal characters)" Margin="0,12,0,4"/><TextBox x:Name="Thumbprint" Padding="5"/><TextBlock Text="Thumb and Thumbprint are changed together. Saving does not prove application association or service account access to the private key." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Save" Content="Save" Width="110" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
