<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="New tenant profile" Width="580" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Create a private profile from the template" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Microsoft 365 tenant" Margin="0,12,0,4"/><TextBlock x:Name="TenantStatus" Text="Connect to Microsoft 365 and confirm the tenant." TextWrapping="Wrap"/><Button x:Name="DetectTenant" Content="Connect Microsoft 365" HorizontalAlignment="Left" Width="170" Height="32" Margin="0,6,0,0"/><TextBlock Text="Profile name" Margin="0,16,0,4"/><TextBox x:Name="ProfileKey" Padding="5"/><TextBlock Text="Environment (e.g. Prod or Test)" Margin="0,10,0,4"/><TextBox x:Name="EnvironmentKey" Padding="5"/><TextBlock Text="CSV and log share (WorkspaceRootPath)" Margin="0,10,0,4"/><TextBox x:Name="WorkspaceRootPath" Padding="5" ToolTip="UNC path, for example \\server\share"/><TextBlock Text="The workspace is global and can affect other profiles." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,4,0,0"/><TextBlock Text="Proposed values" FontWeight="SemiBold" Margin="0,16,0,4"/><TextBlock x:Name="ProfilePreview" TextWrapping="Wrap"/><TextBlock x:Name="OrganizationPreview" TextWrapping="Wrap"/><TextBlock x:Name="EnvironmentPreview" TextWrapping="Wrap"/><TextBlock x:Name="TenantPreview" TextWrapping="Wrap"/><TextBlock Text="Enter the environment explicitly. Existing profiles will not be replaced." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Create" Content="Create" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
