<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Review tenant identity" Width="640" Height="430" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel>
  <TextBlock Text="Review tenant identity" FontSize="18" FontWeight="SemiBold"/>
  <TextBlock x:Name="Current" Margin="0,10,0,0" TextWrapping="Wrap"/>
  <TextBlock Text="Organization key" Margin="0,14,0,4"/><TextBox x:Name="Organization" Padding="5"/>
  <TextBlock Text="Environment key" Margin="0,10,0,4"/><TextBox x:Name="Environment" Padding="5"/>
  <TextBlock Text="TenantKey is recalculated from both keys. Changing it can redirect tenant data and logs; existing files are not moved. The separate Environment field is preserved." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/>
 </StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Save" Content="Review and save" Width="140" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
