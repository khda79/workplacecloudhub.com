<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Export application certificate" Width="590" Height="365" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F4F8FC">
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Export application certificate" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Protect the PFX containing the private key with a password. Keep this password safe; it is required to import the certificate later." Margin="0,12,0,10" TextWrapping="Wrap" Foreground="#52677D"/><TextBlock x:Name="Destination" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="PFX password (at least 12 characters)"/><PasswordBox x:Name="Password" Height="29" Margin="0,4,0,8"/><TextBlock Text="Confirm password"/><PasswordBox x:Name="Confirm" Height="29" Margin="0,4,0,5"/><TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="#A4262C"/></StackPanel><StackPanel Grid.Row="1" HorizontalAlignment="Right" Orientation="Horizontal"><Button x:Name="Cancel" Content="Later" Width="90" Height="32" Margin="4" IsCancel="True"/><Button x:Name="Export" Content="Export" Width="100" Height="32" Margin="4" FontWeight="Bold"/></StackPanel></Grid>
</Window>
