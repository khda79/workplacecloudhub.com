<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Check share as selected account" Width="640" Height="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel>
  <TextBlock Text="Check folder read access as the selected service account" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
  <TextBlock x:Name="Identity" Margin="0,10,0,0" TextWrapping="Wrap"/>
  <TextBlock Text="Absolute local or UNC path" Margin="0,14,0,4"/><TextBox x:Name="Path" Padding="5"/>
  <TextBlock Text="The child process checks its own SID before accessing the folder. A mismatch prevents access. This does not prove access for a scheduled task or establish its group memberships or rights." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/>
 </StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ReviewAcceptance" Content="Review local acceptance result" Width="220" Height="32" Margin="4"/><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Check" Content="Check" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
