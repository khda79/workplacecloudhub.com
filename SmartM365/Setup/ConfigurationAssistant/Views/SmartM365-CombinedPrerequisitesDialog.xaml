<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Install prerequisites" Width="630" Height="460" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Prepare prerequisite installation" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="This prepares the public code-signing certificate for LocalMachine Root and TrustedPublisher and the module installation below. Administrator rights are required for machine-wide trust. Both actions will be shown for final review." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,10,0,0"/><TextBlock Text="Installation scope" Margin="0,16,0,4"/><ComboBox x:Name="Scope" SelectedIndex="0"><ComboBoxItem Content="CurrentUser"/><ComboBoxItem Content="AllUsers"/></ComboBox><CheckBox x:Name="Trust" Content="Trust PSGallery for this account" Margin="0,14,0,0"/><TextBlock Text="This permanently changes PowerShell repository trust for the current account. Without it, an untrusted repository may block unattended installation." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,8,0,0"/><TextBlock Text="This action may install the NuGet provider and download modules. Force and AllowClobber remain disabled. AllUsers may require elevation. Service account access and modules must be checked separately." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Install" Content="Add to review" Width="120" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
