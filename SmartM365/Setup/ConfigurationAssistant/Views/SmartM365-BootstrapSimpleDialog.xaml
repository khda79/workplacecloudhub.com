<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Prepare bootstrap" Width="610" Height="520" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="Prepare identity configuration" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Tenant: GUID or verified domain" Margin="0,14,0,4"/><TextBox x:Name="Directory" Padding="5"/><TextBlock Text="Application name" Margin="0,10,0,4"/><TextBox x:Name="DisplayName" Text="SMART-M365-INVENTORY" Padding="5"/><CheckBox x:Name="UpdateExisting" Content="Plan an existing application update" Margin="0,14,0,0"/><CheckBox x:Name="ConfigureTeams" Content="Create or reuse SharePoint through a Teams workspace" Margin="0,10,0,0"/><TextBlock Text="The existing bootstrap can create a Teams team and channels for the site. This does not enable Teams notifications. Review and isolated preparation are local. Updating an existing application requires additional identity verification." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,16,0,0"/></StackPanel></ScrollViewer><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Stage" Content="Add to review" Width="145" Height="32" Margin="4"/><Button x:Name="Prepare" Content="Review plan" Visibility="Collapsed" Width="110" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
