<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Test write access" Width="640" Height="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Test write access" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Absolute local or UNC path" Margin="0,16,0,4"/><TextBox x:Name="Path" Padding="5"/><CheckBox x:Name="RequireService" Content="Require the selected service identity before writing" Margin="0,10,0,0"/><TextBlock Text="The test creates a randomly named marker, writes and reads a few bytes, and requests deletion on close. It never replaces a file. After interruption or failure the marker may remain; its path will be shown." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/><TextBlock Text="A matching SID does not prove access for the scheduled task." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Check" Content="Check" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
