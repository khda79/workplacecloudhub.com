<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Create disabled task" Width="620" Height="345" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Create a new disabled task" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="Account" Margin="0,14,0,0" TextWrapping="Wrap"/><TextBlock Text="The existing installer requests the service account password interactively." Margin="0,12,0,4" TextWrapping="Wrap"/><TextBlock x:Name="CredentialInfo" Text="Windows Task Scheduler receives and stores the required credentials. The task remains disabled and is not started. Existing tasks are not replaced or deleted. Elevation and further checks are required." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Create" Content="Create" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
