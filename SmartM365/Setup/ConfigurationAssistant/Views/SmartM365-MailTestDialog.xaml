<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mail test" Width="620" Height="410" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Test mail to one recipient" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Sender" Margin="0,15,0,4"/><TextBox x:Name="From" Padding="5"/><TextBlock Text="Single recipient (ASCII address)" Margin="0,10,0,4"/><TextBox x:Name="To" Padding="5"/><TextBlock Text="Test transport (no automatic fallback)" Margin="0,10,0,4"/><ComboBox x:Name="Transport" SelectedIndex="0"><ComboBoxItem Content="Graph"/><ComboBoxItem Content="SMTP"/></ComboBox><TextBlock Text="This sends a real message outside the report queue. The SmartM365 guard rejects routing that adds or replaces a recipient. Loading may enrich local files and create logs. The test does not prove delivery." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Send" Content="Test" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
