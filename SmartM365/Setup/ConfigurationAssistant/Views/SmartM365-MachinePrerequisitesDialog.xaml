<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Install prerequisites" Width="600" Height="310" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Install machine prerequisites" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Install PowerShell modules for all users, the Active Directory RSAT Windows feature, and trust the public signing certificate in LocalMachine Root and TrustedPublisher. Administrator rights and network access are required." TextWrapping="Wrap" Margin="0,12,0,0"/><CheckBox x:Name="Trust" Content="Trust PSGallery for this account" Margin="0,14,0,0"/><TextBlock Text="Repository trust is optional and changes the current account. Installing RSAT may require a Windows restart." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Install" Content="Install" Width="90" Height="32" Margin="4"/></StackPanel></Grid></Window>