<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Local service account" Width="550" Height="370" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Create a local account on this computer" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Account name" Margin="0,16,0,4"/><TextBox x:Name="AccountName" Padding="5"/><TextBlock Text="Password" Margin="0,10,0,4"/><PasswordBox x:Name="AccountPassword" Padding="5"/><TextBlock Text="The password is sent to Windows and is not saved by this assistant. Scheduled task, share and certificate rights must be assigned and checked separately. This option creates only a local account." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Create" Content="Create" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
