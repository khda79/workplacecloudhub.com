<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configure service account" Width="520" Height="270" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Choose a standard service account" FontSize="18" FontWeight="SemiBold"/><RadioButton x:Name="Existing" Content="Use an existing account" IsChecked="True" Margin="0,18,0,6"/><RadioButton x:Name="Local" Content="Create a local account" Margin="0,0,0,6"/><RadioButton x:Name="Domain" Content="Create a domain account"/><TextBlock Text="New accounts are prepared for final review before creation." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,12,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Continue" Content="Continue" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
