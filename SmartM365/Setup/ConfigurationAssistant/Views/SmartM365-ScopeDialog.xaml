<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Workflow scope" Width="570" Height="410" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB">
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Select features to prepare" FontSize="18" FontWeight="SemiBold"/><CheckBox x:Name="Cloud" Content="Microsoft 365 and Intune inventories" IsChecked="True" IsEnabled="False" Margin="0,14,0,0"/><CheckBox x:Name="AD" IsChecked="True" Content="On-premises Active Directory" Margin="0,10,0,0"/><CheckBox x:Name="Exchange" IsChecked="True" Content="On-premises Exchange" Margin="0,10,0,0"/><CheckBox x:Name="SharePoint" Content="On-premises SharePoint" Margin="0,10,0,0"/><CheckBox x:Name="Teams" Content="Teams notifications" Margin="0,10,0,0"/><CheckBox x:Name="Mail" IsChecked="True" Content="Email notifications and reports" Margin="0,10,0,0"/><TextBlock Text="This selection is used for this session summary. It does not change the job catalog or enable collectors." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,16,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Apply" Content="Apply" Width="90" Height="32" Margin="4"/></StackPanel></Grid>
</Window>
