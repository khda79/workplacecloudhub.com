<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="CSV and log share" Width="580" Height="235" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F5F8FB"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="CSV and log share" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="UNC path" Margin="0,12,0,4"/><TextBox x:Name="Workspace" Padding="5"/><TextBlock Text="This share is global and can affect other profiles. Changes are added to the final review." TextWrapping="Wrap" Foreground="#5F6B7A" Margin="0,10,0,0"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="Cancel" Content="Cancel" Width="90" Height="32" Margin="4"/><Button x:Name="Save" Content="Add to review" Width="110" Height="32" Margin="4"/></StackPanel></Grid></Window>