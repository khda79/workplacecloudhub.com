# SmartM365 Windows 11 Upgrade Toolkit LOT defaults.
# Copy this file to Windows11UpgradeToolkit.config in the LOT folder and edit local values.
# LOT values override toolkit defaults unless an environment variable is already defined.
# For LOT/PsExec runs, W11UT_SETUP_SOURCE should be a UNC path reachable from target computers.
# Example: W11UT_SETUP_SOURCE=\\server\share\Windows11
# Multiple candidates are supported; each target validates candidates and reads a small sample to select the nearest valid source.
# Example: W11UT_SETUP_SOURCE=\\srv-paris\share\Windows11;\\srv-lyon\share\Windows11

W11UT_SETUP_SOURCE=
W11UT_SETUP_SOURCE_MAP=
W11UT_SETUP_SOURCE_CANDIDATE_LIMIT=5
W11UT_SETUP_EXECUTION_MODE=LocalCache
W11UT_SETUP_MEDIA_ID=Win11
W11UT_SETUP_LANGUAGE=MatchSystem
W11UT_SETUP_DYNAMIC_UPDATE=Disable
W11UT_SETUP_COPY_IPG_MS=20
W11UT_SETUP_COPY_JITTER_SECONDS=300
W11UT_SETUP_SOURCE_CONCURRENCY_LIMIT=0
W11UT_SETUP_SOURCE_CONCURRENCY_LEASE_MINUTES=240
W11UT_SETUP_SOURCE_CONCURRENCY_GATE_ROOT=
W11UT_SETUP_SUBNET_CONCURRENCY_LIMIT=1
W11UT_SETUP_SUBNET_PREFIX_LENGTH=Auto
W11UT_SETUP_SUBNET_CONCURRENCY_LEASE_MINUTES=60
W11UT_SETUP_SUBNET_CONCURRENCY_GATE_ROOT=
W11UT_AD_DOMAIN=

W11UT_ALLOW_POLICY_REPAIR=1
W11UT_ALLOW_WU_RESET=1
W11UT_ALLOW_FORCE_UPGRADE=1
W11UT_ALLOW_SETUP_UPGRADE=1
W11UT_DIRECT_SETUP_UPGRADE=0
W11UT_ALLOW_REBOOT=1
W11UT_SETUP_REBOOT_WHEN_NO_USER=0
W11UT_SKIP_VIRTUAL_MACHINES=1
W11UT_ALLOW_DISK_CLEANUP=1
W11UT_ALLOW_ADVANCED_DISK_CLEANUP=0
W11UT_SKIP_SETUP_MEDIA_PRECOPY=0

W11UT_THROTTLE=10
W11UT_GLOBAL_CONCURRENCY_LIMIT=15
W11UT_GLOBAL_CONCURRENCY_LEASE_TIMEOUT_MINUTES=0
W11UT_DELAY_BETWEEN_COMPUTERS_SECONDS=0
W11UT_DELAY_BETWEEN_CYCLES_MINUTES=5
W11UT_PSEXEC_TIMEOUT_MINUTES=180
W11UT_CENTRAL_LOG_COLLECTION_MODE=Standard
