// SmartInventory source tables are generated from source-selection.json.
// Each model table uses the exact CSV base name and retains every source column.
// fnLoadSourceTable receives the explicit delimiter, expected columns, typed fields
// and a flag controlling whether deduplicated weekly history is appended.
// Examples generated by scripts/Build-SmartWorkplaceDashboard.js:
// M365_Users_Active = fnLoadSourceTable("M365_Users_Active.csv", ",", {...}, {...}, false)
// M365_Licenses_Tenant = fnLoadSourceTable("M365_Licenses_Tenant.csv", ",", {...}, {...}, true)
