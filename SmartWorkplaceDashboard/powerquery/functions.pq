// Smart Workplace Dashboard - autonomous source adapter reference.
// The executable Power Query expressions live in model.bim and are generated by
// scripts/Build-SmartWorkplaceDashboard.js to prevent documentation drift.

SourceMode = "LocalFolder";
DataRootPath = "C:\SmartM365\DATA";
SharePointSiteUrl = "";
SharePointDataFolderUrl = "";
HistoryMonths = 24;
HistoryMinRowRatio = 0.5;

// fnGetSourceFiles(relativeFolder)
// - LocalFolder: Folder.Files(DataRootPath + relativeFolder)
// - SharePoint: SharePoint.Files filtered below SharePointDataFolderUrl

// fnLoadSourceTable(fileName, delimiter, expectedColumns, typeMap, includeHistory)
// - loads the latest DATA-LAST CSV;
// - preserves every expected source column;
// - applies only the declared reliable types;
// - optionally adds one deduplicated WeeklyHistory snapshot per prior week;
// - rejects historical snapshots below 50% of the current row count;
// - adds snapshot/source metadata inside the same CSV-named table.
