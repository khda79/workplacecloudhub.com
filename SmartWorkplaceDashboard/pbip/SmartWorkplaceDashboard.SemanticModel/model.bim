          {
            "name": "DimUser",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = fnLoadCmdbTable(\"DimUser.csv\"), Selected = Table.SelectColumns(Source, {\"TenantKey\", \"CmdbUserId\", \"UserPrincipalName\", \"DisplayName\", \"AccountEnabled\", \"UserType\", \"Department\", \"JobTitle\", \"ConfidenceScore\"}, MissingField.UseNull), WithTenant = Table.TransformColumns(Selected, {{\"TenantKey\", each if _ = null or Text.Trim(Text.From(_)) = \"\" then TenantKey else Text.From(_), type text}}), WithTenantUserKey = Table.AddColumn(WithTenant, \"TenantUserKey\", each if [CmdbUserId] = null or Text.Trim(Text.From([CmdbUserId])) = \"\" then null else [TenantKey] & \"|\" & Text.From([CmdbUserId]), type text), Output = WithTenantUserKey in Output"
            }
