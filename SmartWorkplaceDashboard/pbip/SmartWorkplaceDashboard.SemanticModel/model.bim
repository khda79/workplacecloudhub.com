        "description": "Unified current-state device inventory derived from AD, Entra ID and Intune using exact identifiers only.",
        "lineageTag": "10bf467e-07b4-408b-8387-1b93d59d37ec",
        "partitions": [
          {
            "name": "DeviceDetail",
            "mode": "import",
            "source": {
              "expression": [
                "let",
                " CleanText=(v as any) as nullable text => let t=if v=null then null else Text.Trim(Text.From(v)) in if t=null or t=\"\" then null else t,",
                " Norm=(v as any) as nullable text => let t=CleanText(v) in if t=null then null else Text.Lower(t),",
                " FirstText=(values as list) as nullable text => let usable=List.RemoveNulls(List.Transform(values,each CleanText(_))) in if List.Count(usable)=0 then null else usable{0},",
                " MaxDate=(values as list) as nullable datetime => let usable=List.RemoveNulls(List.Transform(values,each fnToDateTime(_))) in if List.Count(usable)=0 then null else List.Max(usable),",
                " EntraCurrent=Table.SelectRows(#\"M365_Entra_Devices\",each [__IsCurrent]=true),",
                " EntraSelected=Table.SelectColumns(EntraCurrent,{\"ObjectId\",\"DeviceId\",\"DisplayName\",\"OperatingSystem\",\"OperatingSystemVersion\",\"IsCompliant\",\"IsManaged\",\"DeviceOwnership\",\"AccountEnabled\",\"TrustType\",\"Manufacturer\",\"Model\",\"ApproximateLastSignInDateTime\"},MissingField.UseNull),",
                " EntraRenamed=Table.RenameColumns(EntraSelected,{{\"ObjectId\",\"E_ObjectId\"},{\"DeviceId\",\"E_DeviceId\"},{\"DisplayName\",\"E_DisplayName\"},{\"OperatingSystem\",\"E_OperatingSystem\"},{\"OperatingSystemVersion\",\"E_OSVersion\"},{\"IsCompliant\",\"E_IsCompliant\"},{\"IsManaged\",\"E_IsManaged\"},{\"DeviceOwnership\",\"E_Ownership\"},{\"AccountEnabled\",\"E_AccountEnabled\"},{\"TrustType\",\"E_TrustType\"},{\"Manufacturer\",\"E_Manufacturer\"},{\"Model\",\"E_Model\"},{\"ApproximateLastSignInDateTime\",\"E_LastSignIn\"}}),",
                " EntraKey1=Table.AddColumn(EntraRenamed,\"E_ObjectKey\",each Norm([E_ObjectId]),type nullable text),",
                " EntraKey2=Table.AddColumn(EntraKey1,\"E_DeviceKey\",each Norm([E_DeviceId]),type nullable text),",
                " EntraKeyed=Table.AddColumn(EntraKey2,\"CanonicalDeviceKey\",each if [E_ObjectKey]<>null then \"ENTRA:\"&[E_ObjectKey] else if [E_DeviceKey]<>null then \"ENTRADEVICE:\"&[E_DeviceKey] else null,type nullable text),",
                " EntraPrepared=fnUnique(fnRequireKey(EntraKeyed,\"CanonicalDeviceKey\"),{\"CanonicalDeviceKey\"}),",
                " EntraObjectMap=fnUnique(Table.SelectRows(Table.SelectColumns(EntraPrepared,{\"E_ObjectKey\",\"CanonicalDeviceKey\"}),each [E_ObjectKey]<>null),{\"E_ObjectKey\"}),",
                " EntraDeviceMap=fnUnique(Table.SelectRows(Table.SelectColumns(EntraPrepared,{\"E_DeviceKey\",\"CanonicalDeviceKey\"}),each [E_DeviceKey]<>null),{\"E_DeviceKey\"}),",
                " IntuneCurrent=Table.SelectRows(#\"Intune_Devices_Inventory\",each [__IsCurrent]=true),",
                " IntuneSelected=Table.SelectColumns(IntuneCurrent,{\"Device ID\",\"Device name\",\"Entra ObjectId\",\"Azure AD Device ID\",\"Entra DeviceId\",\"Primary user UPN\",\"Ownership\",\"Compliance\",\"IsCompliant\",\"OS\",\"OS version\",\"WindowsVersionFamily\",\"Manufacturer\",\"Model\",\"Serial number\",\"PhysicalMemoryGB\",\"Total storage\",\"Free storage\",\"LastSyncDateTime\"},MissingField.UseNull),",
                " IntuneRenamed=Table.RenameColumns(IntuneSelected,{{\"Device ID\",\"I_DeviceId\"},{\"Device name\",\"I_DeviceName\"},{\"Entra ObjectId\",\"I_EntraObjectId\"},{\"Azure AD Device ID\",\"I_AzureADDeviceId\"},{\"Entra DeviceId\",\"I_EntraDeviceId\"},{\"Primary user UPN\",\"I_PrimaryUserUPN\"},{\"Ownership\",\"I_Ownership\"},{\"Compliance\",\"I_Compliance\"},{\"IsCompliant\",\"I_IsCompliant\"},{\"OS\",\"I_OS\"},{\"OS version\",\"I_OSVersion\"},{\"WindowsVersionFamily\",\"I_WindowsVersionFamily\"},{\"Manufacturer\",\"I_Manufacturer\"},{\"Model\",\"I_Model\"},{\"Serial number\",\"I_SerialNumber\"},{\"PhysicalMemoryGB\",\"I_PhysicalMemoryGB\"},{\"Total storage\",\"I_TotalStorage\"},{\"Free storage\",\"I_FreeStorage\"},{\"LastSyncDateTime\",\"I_LastSync\"}}),",
                " IntuneKey1=Table.AddColumn(IntuneRenamed,\"I_ObjectKey\",each Norm([I_EntraObjectId]),type nullable text),",
                " IntuneKey2=Table.AddColumn(IntuneKey1,\"I_EntraDeviceKey\",each Norm(FirstText({[I_EntraDeviceId],[I_AzureADDeviceId]})),type nullable text),",
                " IntuneJoinObject=Table.NestedJoin(IntuneKey2,{\"I_ObjectKey\"},EntraObjectMap,{\"E_ObjectKey\"},\"ObjectMatch\",JoinKind.LeftOuter),",
                " IntuneExpandObject=Table.ExpandTableColumn(IntuneJoinObject,\"ObjectMatch\",{\"CanonicalDeviceKey\"},{\"CanonicalByObject\"}),",
                " IntuneJoinDevice=Table.NestedJoin(IntuneExpandObject,{\"I_EntraDeviceKey\"},EntraDeviceMap,{\"E_DeviceKey\"},\"DeviceMatch\",JoinKind.LeftOuter),",
                " IntuneExpandDevice=Table.ExpandTableColumn(IntuneJoinDevice,\"DeviceMatch\",{\"CanonicalDeviceKey\"},{\"CanonicalByDevice\"}),",
                " IntuneCanonical=Table.AddColumn(IntuneExpandDevice,\"CanonicalDeviceKey\",each if List.Count(List.Distinct(List.RemoveNulls({[CanonicalByDevice],[CanonicalByObject]})))>1 then error Error.Record(\"SmartInventoryIdentityConflict\",\"Exact identifiers point to different entities; resolve before refresh.\",null) else FirstText({[CanonicalByDevice],[CanonicalByObject],if Norm([I_DeviceId])<>null then \"INTUNE:\"&Norm([I_DeviceId]) else null}),type nullable text),",
                " IntunePrepared=fnUnique(fnRequireKey(Table.RemoveColumns(IntuneCanonical,{\"CanonicalByObject\",\"CanonicalByDevice\"}),\"CanonicalDeviceKey\"),{\"CanonicalDeviceKey\"}),",
                " IntuneDeviceMap0=Table.AddColumn(Table.SelectColumns(IntunePrepared,{\"I_DeviceId\",\"CanonicalDeviceKey\"}),\"I_DeviceKey\",each Norm([I_DeviceId]),type nullable text),",
                " IntuneDeviceMap=fnUnique(Table.SelectRows(Table.RemoveColumns(IntuneDeviceMap0,{\"I_DeviceId\"}),each [I_DeviceKey]<>null),{\"I_DeviceKey\"}),",
                " ADCurrent=Table.SelectRows(#\"AD_Computers_AllDomains\",each [__IsCurrent]=true),",
                " ADSelected=Table.SelectColumns(ADCurrent,{\"ObjectGUID\",\"Name\",\"DNSHostName\",\"DomainName\",\"OrganizationalUnitLeafName\",\"Enabled\",\"LastLogonDate\",\"OperatingSystem\",\"operatingSystemVersion\",\"Manufacturer\",\"IntunePrimaryUserPrincipalName\",\"IntuneDeviceId\",\"EntraObjectId\",\"EntraDeviceIdNormalized\",\"IntuneOwnership\",\"IntuneDeviceModel\",\"PhysicalMemoryGB\",\"Windows11UpgradeEligibility\",\"Windows11MigrationPhase\",\"DeviceMigrationIssueSeverity\",\"Windows11MigrationAction\",\"WindowsUpdateWindows1125H2RiskBucket\",\"WindowsUpdateWindows1124H2RiskBucket\",\"WindowsUpdateAutopatchFeatureUpdateAnchorRiskBucket\"},MissingField.UseNull),",
                " ADRenamed=Table.RenameColumns(ADSelected,{{\"ObjectGUID\",\"A_ObjectGUID\"},{\"Name\",\"A_Name\"},{\"DNSHostName\",\"A_DNSHostName\"},{\"DomainName\",\"A_DomainName\"},{\"OrganizationalUnitLeafName\",\"A_OrganizationalUnit\"},{\"Enabled\",\"A_Enabled\"},{\"LastLogonDate\",\"A_LastLogon\"},{\"OperatingSystem\",\"A_OperatingSystem\"},{\"operatingSystemVersion\",\"A_OSVersion\"},{\"Manufacturer\",\"A_Manufacturer\"},{\"IntunePrimaryUserPrincipalName\",\"A_PrimaryUserUPN\"},{\"IntuneDeviceId\",\"A_IntuneDeviceId\"},{\"EntraObjectId\",\"A_EntraObjectId\"},{\"EntraDeviceIdNormalized\",\"A_EntraDeviceId\"},{\"IntuneOwnership\",\"A_IntuneOwnership\"},{\"IntuneDeviceModel\",\"A_IntuneModel\"},{\"PhysicalMemoryGB\",\"A_PhysicalMemoryGB\"},{\"Windows11UpgradeEligibility\",\"A_Windows11Readiness\"},{\"Windows11MigrationPhase\",\"A_Windows11MigrationPhase\"},{\"DeviceMigrationIssueSeverity\",\"A_MigrationSeverity\"},{\"Windows11MigrationAction\",\"A_MigrationAction\"},{\"WindowsUpdateWindows1125H2RiskBucket\",\"A_UpdateRisk25H2\"},{\"WindowsUpdateWindows1124H2RiskBucket\",\"A_UpdateRisk24H2\"},{\"WindowsUpdateAutopatchFeatureUpdateAnchorRiskBucket\",\"A_UpdateRiskAutopatch\"}}),",
                " ADKey1=Table.AddColumn(ADRenamed,\"A_ObjectKey\",each Norm([A_EntraObjectId]),type nullable text),",
                " ADKey2=Table.AddColumn(ADKey1,\"A_EntraDeviceKey\",each Norm([A_EntraDeviceId]),type nullable text),",
                " ADKey3=Table.AddColumn(ADKey2,\"A_IntuneDeviceKey\",each Norm([A_IntuneDeviceId]),type nullable text),",
                " ADJoinObject=Table.NestedJoin(ADKey3,{\"A_ObjectKey\"},EntraObjectMap,{\"E_ObjectKey\"},\"ObjectMatch\",JoinKind.LeftOuter),",
                " ADExpandObject=Table.ExpandTableColumn(ADJoinObject,\"ObjectMatch\",{\"CanonicalDeviceKey\"},{\"CanonicalByObject\"}),",
                " ADJoinDevice=Table.NestedJoin(ADExpandObject,{\"A_EntraDeviceKey\"},EntraDeviceMap,{\"E_DeviceKey\"},\"DeviceMatch\",JoinKind.LeftOuter),",
                " ADExpandDevice=Table.ExpandTableColumn(ADJoinDevice,\"DeviceMatch\",{\"CanonicalDeviceKey\"},{\"CanonicalByDevice\"}),",
                " ADJoinIntune=Table.NestedJoin(ADExpandDevice,{\"A_IntuneDeviceKey\"},IntuneDeviceMap,{\"I_DeviceKey\"},\"IntuneMatch\",JoinKind.LeftOuter),",
                " ADExpandIntune=Table.ExpandTableColumn(ADJoinIntune,\"IntuneMatch\",{\"CanonicalDeviceKey\"},{\"CanonicalByIntune\"}),",
                " ADCanonical=Table.AddColumn(ADExpandIntune,\"CanonicalDeviceKey\",each if List.Count(List.Distinct(List.RemoveNulls({[CanonicalByIntune],[CanonicalByObject],[CanonicalByDevice]})))>1 then error Error.Record(\"SmartInventoryIdentityConflict\",\"Exact identifiers point to different entities; resolve before refresh.\",null) else FirstText({[CanonicalByIntune],[CanonicalByObject],[CanonicalByDevice],if Norm([A_ObjectGUID])<>null then \"AD:\"&Norm([A_ObjectGUID]) else null}),type nullable text),",
                " ADPrepared=fnUnique(fnRequireKey(Table.RemoveColumns(ADCanonical,{\"CanonicalByObject\",\"CanonicalByDevice\",\"CanonicalByIntune\"}),\"CanonicalDeviceKey\"),{\"CanonicalDeviceKey\"}),",
                " Keys=fnUnique(Table.Combine({Table.SelectColumns(ADPrepared,{\"CanonicalDeviceKey\"}),Table.SelectColumns(EntraPrepared,{\"CanonicalDeviceKey\"}),Table.SelectColumns(IntunePrepared,{\"CanonicalDeviceKey\"})}),{\"CanonicalDeviceKey\"}),",
                " JoinAD=Table.NestedJoin(Keys,{\"CanonicalDeviceKey\"},ADPrepared,{\"CanonicalDeviceKey\"},\"AD\",JoinKind.LeftOuter),",
                " ExpandAD=Table.ExpandTableColumn(JoinAD,\"AD\",{\"A_ObjectGUID\",\"A_Name\",\"A_DNSHostName\",\"A_DomainName\",\"A_OrganizationalUnit\",\"A_Enabled\",\"A_LastLogon\",\"A_OperatingSystem\",\"A_OSVersion\",\"A_Manufacturer\",\"A_PrimaryUserUPN\",\"A_IntuneDeviceId\",\"A_EntraObjectId\",\"A_EntraDeviceId\",\"A_IntuneOwnership\",\"A_IntuneModel\",\"A_PhysicalMemoryGB\",\"A_Windows11Readiness\",\"A_Windows11MigrationPhase\",\"A_MigrationSeverity\",\"A_MigrationAction\",\"A_UpdateRisk25H2\",\"A_UpdateRisk24H2\",\"A_UpdateRiskAutopatch\"}),",
                " JoinEntra=Table.NestedJoin(ExpandAD,{\"CanonicalDeviceKey\"},EntraPrepared,{\"CanonicalDeviceKey\"},\"Entra\",JoinKind.LeftOuter),",
                " ExpandEntra=Table.ExpandTableColumn(JoinEntra,\"Entra\",{\"E_ObjectId\",\"E_DeviceId\",\"E_DisplayName\",\"E_OperatingSystem\",\"E_OSVersion\",\"E_IsCompliant\",\"E_IsManaged\",\"E_Ownership\",\"E_AccountEnabled\",\"E_TrustType\",\"E_Manufacturer\",\"E_Model\",\"E_LastSignIn\"}),",
                " JoinIntune=Table.NestedJoin(ExpandEntra,{\"CanonicalDeviceKey\"},IntunePrepared,{\"CanonicalDeviceKey\"},\"Intune\",JoinKind.LeftOuter),",
                " ExpandIntune=Table.ExpandTableColumn(JoinIntune,\"Intune\",{\"I_DeviceId\",\"I_DeviceName\",\"I_EntraObjectId\",\"I_AzureADDeviceId\",\"I_EntraDeviceId\",\"I_PrimaryUserUPN\",\"I_Ownership\",\"I_Compliance\",\"I_IsCompliant\",\"I_OS\",\"I_OSVersion\",\"I_WindowsVersionFamily\",\"I_Manufacturer\",\"I_Model\",\"I_SerialNumber\",\"I_PhysicalMemoryGB\",\"I_TotalStorage\",\"I_FreeStorage\",\"I_LastSync\"}),",
                " WithInAD=Table.AddColumn(ExpandIntune,\"InAD\",each [A_ObjectGUID]<>null,type logical),",
                " WithInEntra=Table.AddColumn(WithInAD,\"InEntra\",each [E_ObjectId]<>null,type logical),",
                " WithInIntune=Table.AddColumn(WithInEntra,\"InIntune\",each [I_DeviceId]<>null,type logical),",
                " WithCoverage=Table.AddColumn(WithInIntune,\"SourceCoverage\",each if [InAD] and [InEntra] and [InIntune] then \"AD + Entra + Intune\" else if [InAD] and [InEntra] then \"AD + Entra\" else if [InAD] and [InIntune] then \"AD + Intune\" else if [InEntra] and [InIntune] then \"Entra + Intune\" else if [InAD] then \"AD only\" else if [InEntra] then \"Entra only\" else \"Intune only\",type text),",
                " WithDeviceName=Table.AddColumn(WithCoverage,\"DeviceName\",each FirstText({[I_DeviceName],[E_DisplayName],[A_Name],[A_DNSHostName]}),type nullable text),",
                " WithPrimaryUser=Table.AddColumn(WithDeviceName,\"PrimaryUserUPN\",each FirstText({[I_PrimaryUserUPN],[A_PrimaryUserUPN]}),type nullable text),",
                " WithUserKey=Table.AddColumn(WithPrimaryUser,\"UserKey\",each Norm([PrimaryUserUPN]),type nullable text),",
                " UsersCurrent=Table.SelectRows(#\"M365_Users_Active\",each [__IsCurrent]=true),",
                " UsersSelected=Table.SelectColumns(UsersCurrent,{\"User principal name\",\"CountryOrRegion\"},MissingField.UseNull),",
                " UsersKeyed=Table.AddColumn(UsersSelected,\"UserKey\",each Norm([#\"User principal name\"]),type nullable text),",
                " UsersMap=fnUnique(Table.SelectRows(Table.SelectColumns(UsersKeyed,{\"UserKey\",\"CountryOrRegion\"}),each [UserKey]<>null),{\"UserKey\"}),",
                " JoinUsers=Table.NestedJoin(WithUserKey,{\"UserKey\"},UsersMap,{\"UserKey\"},\"User\",JoinKind.LeftOuter),",
                " ExpandUsers=Table.ExpandTableColumn(JoinUsers,\"User\",{\"CountryOrRegion\"},{\"UserCountry\"}),",
                " WithCountry=Table.AddColumn(ExpandUsers,\"Country\",each let c=CleanText([UserCountry]) in if c=null then \"Unknown / not user-linked\" else c,type text),",
                " WithADObject=Table.AddColumn(WithCountry,\"ADObjectGUID\",each CleanText([A_ObjectGUID]),type nullable text),",
                " WithEntraObject=Table.AddColumn(WithADObject,\"EntraObjectId\",each FirstText({[E_ObjectId],[I_EntraObjectId],[A_EntraObjectId]}),type nullable text),",
                " WithEntraDevice=Table.AddColumn(WithEntraObject,\"EntraDeviceId\",each FirstText({[E_DeviceId],[I_EntraDeviceId],[I_AzureADDeviceId],[A_EntraDeviceId]}),type nullable text),",
                " WithIntuneDevice=Table.AddColumn(WithEntraDevice,\"IntuneDeviceId\",each FirstText({[I_DeviceId],[A_IntuneDeviceId]}),type nullable text),",
                " WithDomain=Table.AddColumn(WithIntuneDevice,\"DomainName\",each CleanText([A_DomainName]),type nullable text),",
                " WithOU=Table.AddColumn(WithDomain,\"OrganizationalUnit\",each CleanText([A_OrganizationalUnit]),type nullable text),",
                " WithADEnabled=Table.AddColumn(WithOU,\"ADEnabled\",each fnToLogical([A_Enabled]),type nullable logical),",
                " WithADLastLogon=Table.AddColumn(WithADEnabled,\"ADLastLogonDateTime\",each fnToDateTime([A_LastLogon]),type nullable datetime),",
                " WithEntraEnabled=Table.AddColumn(WithADLastLogon,\"EntraAccountEnabled\",each fnToLogical([E_AccountEnabled]),type nullable logical),",
                " WithTrust=Table.AddColumn(WithEntraEnabled,\"TrustType\",each let t=CleanText([E_TrustType]) in if t=null then \"Unknown\" else t,type text),",
                " WithEntraManaged=Table.AddColumn(WithTrust,\"EntraIsManaged\",each fnToLogical([E_IsManaged]),type nullable logical),",
                " WithEntraCompliant=Table.AddColumn(WithEntraManaged,\"EntraIsCompliant\",each fnToLogical([E_IsCompliant]),type nullable logical),",
                " WithEntraOwnership=Table.AddColumn(WithEntraCompliant,\"EntraOwnership\",each CleanText([E_Ownership]),type nullable text),",
                " WithEntraLastSignIn=Table.AddColumn(WithEntraOwnership,\"EntraLastSignInDateTime\",each fnToDateTime([E_LastSignIn]),type nullable datetime),",
                " WithOwnership=Table.AddColumn(WithEntraLastSignIn,\"Ownership\",each let v=FirstText({[I_Ownership],[E_Ownership],[A_IntuneOwnership]}) in if v=null then \"Unknown\" else v,type text),",
                " WithIntuneCompliant=Table.AddColumn(WithOwnership,\"IntuneIsCompliant\",each fnToLogical([I_IsCompliant]),type nullable logical),",
                " WithCompliance=Table.AddColumn(WithIntuneCompliant,\"ComplianceStatus\",each let c=CleanText([I_Compliance]),b=[IntuneIsCompliant] in if not [InIntune] then \"Not managed by Intune\" else if c<>null then c else if b=true then \"compliant\" else if b=false then \"noncompliant\" else \"unknown\",type text),",
                " WithOS=Table.AddColumn(WithCompliance,\"OperatingSystem\",each FirstText({[I_OS],[E_OperatingSystem],[A_OperatingSystem]}),type nullable text),",
                " WithOSVersion=Table.AddColumn(WithOS,\"OSVersion\",each FirstText({[I_OSVersion],[E_OSVersion],[A_OSVersion]}),type nullable text),",
                " WithWindowsFamily=Table.AddColumn(WithOSVersion,\"WindowsVersionFamily\",each let f=CleanText([I_WindowsVersionFamily]),os=Text.Upper(if [OperatingSystem]=null then \"\" else [OperatingSystem]),parts=if [OSVersion]=null then {} else Text.Split([OSVersion],\".\"),build=if List.Count(parts)>2 then try Number.FromText(parts{2}) otherwise null else null in if f<>null then f else if not Text.Contains(os,\"WINDOWS\") then if [OperatingSystem]=null then \"Unknown\" else [OperatingSystem] else if build=null then \"Unknown\" else if build>=22000 then \"Windows 11\" else \"Windows 10\",type text),",
                " WithManufacturer=Table.AddColumn(WithWindowsFamily,\"Manufacturer\",each FirstText({[I_Manufacturer],[E_Manufacturer],[A_Manufacturer]}),type nullable text),",
                " WithModel=Table.AddColumn(WithManufacturer,\"Model\",each FirstText({[I_Model],[E_Model],[A_IntuneModel]}),type nullable text),",
                " WithSerial=Table.AddColumn(WithModel,\"SerialNumber\",each CleanText([I_SerialNumber]),type nullable text),",
                " WithMemory=Table.AddColumn(WithSerial,\"PhysicalMemoryGB\",each let n=fnToNumber(FirstText({[I_PhysicalMemoryGB],[A_PhysicalMemoryGB]})) in n,type nullable number),",
                " WithStorageTotal=Table.AddColumn(WithMemory,\"StorageTotalGB\",each let n=fnToNumber([I_TotalStorage]) in if n=null then null else n/1073741824,type nullable number),",
                " WithStorageFree=Table.AddColumn(WithStorageTotal,\"StorageFreeGB\",each let n=fnToNumber([I_FreeStorage]) in if n=null then null else n/1073741824,type nullable number),",
                " WithIntuneLastSync=Table.AddColumn(WithStorageFree,\"IntuneLastSyncDateTime\",each fnToDateTime([I_LastSync]),type nullable datetime),",
                " WithLastActivity=Table.AddColumn(WithIntuneLastSync,\"LastActivityDateTime\",each MaxDate({[IntuneLastSyncDateTime],[EntraLastSignInDateTime],[ADLastLogonDateTime]}),type nullable datetime),",
                " WithDays=Table.AddColumn(WithLastActivity,\"DaysSinceLastActivity\",each if [LastActivityDateTime]=null or [LastActivityDateTime]>DateTime.LocalNow() then null else Duration.Days(DateTime.LocalNow()-[LastActivityDateTime]),Int64.Type),",
                " WithActivity=Table.AddColumn(WithDays,\"ActivityBucket\",each if [DaysSinceLastActivity]=null then \"Unknown\" else if [DaysSinceLastActivity]<=30 then \"Active <= 30d\" else if [DaysSinceLastActivity]<=90 then \"Inactive 31-90d\" else \"Stale > 90d\",type text),",
                " WithReadiness=Table.AddColumn(WithActivity,\"Windows11Readiness\",each let v=CleanText([A_Windows11Readiness]) in if v=null then \"Unknown / not assessed\" else v,type text),",
                " WithMigration=Table.AddColumn(WithReadiness,\"Windows11MigrationPhase\",each let v=CleanText([A_Windows11MigrationPhase]) in if v=null then \"Unknown / not assessed\" else v,type text),",
                " WithRisk=Table.AddColumn(WithMigration,\"UpdateRisk\",each let v=FirstText({[A_UpdateRisk25H2],[A_UpdateRisk24H2],[A_UpdateRiskAutopatch]}) in if v=null then \"Unknown / not assessed\" else v,type text),",
                " WithSeverity=Table.AddColumn(WithRisk,\"ActionSeverity\",each let risk=Text.Upper([UpdateRisk]),migration=Text.Upper(if [A_MigrationSeverity]=null then \"\" else Text.From([A_MigrationSeverity])) in if [IntuneIsCompliant]=false or risk=\"HIGH\" or List.Contains({\"CRITICAL\",\"HIGH\"},migration) then \"Critical\" else if [ADEnabled]=false or ([DaysSinceLastActivity]<>null and [DaysSinceLastActivity]>90) or [SourceCoverage]<>\"AD + Entra + Intune\" then \"Warning\" else if [DaysSinceLastActivity]=null then \"Unknown\" else \"Healthy\",type text),",
                " WithPriority=Table.AddColumn(WithSeverity,\"ActionPriority\",each if [ActionSeverity]=\"Critical\" then 1 else if [ActionSeverity]=\"Warning\" then 2 else 3,Int64.Type),",
                " WithActionRequired=Table.AddColumn(WithPriority,\"ActionRequired\",each [ActionSeverity]<>\"Healthy\",type logical),",
                " WithRecommendedAction=Table.AddColumn(WithActionRequired,\"RecommendedAction\",each if [ActionSeverity]=\"Unknown\" then \"Review missing or future activity evidence\" else if [IntuneIsCompliant]=false then \"Remediate Intune noncompliance\" else if Text.Upper([UpdateRisk])=\"HIGH\" then \"Investigate Windows Update blocking risk\" else if [ADEnabled]=false then \"Review disabled AD computer\" else if [DaysSinceLastActivity]<>null and [DaysSinceLastActivity]>90 then \"Validate stale device and retire if obsolete\" else if [SourceCoverage]<>\"AD + Entra + Intune\" then \"Reconcile missing inventory source\" else let a=CleanText([A_MigrationAction]) in if a=null then \"No immediate action\" else a,type text),",
                " Result=Table.SelectColumns(WithRecommendedAction,{\"CanonicalDeviceKey\",\"DeviceName\",\"PrimaryUserUPN\",\"Country\",\"SourceCoverage\",\"InAD\",\"InEntra\",\"InIntune\",\"ADObjectGUID\",\"EntraObjectId\",\"EntraDeviceId\",\"IntuneDeviceId\",\"DomainName\",\"OrganizationalUnit\",\"ADEnabled\",\"ADLastLogonDateTime\",\"EntraAccountEnabled\",\"TrustType\",\"EntraIsManaged\",\"EntraIsCompliant\",\"EntraOwnership\",\"EntraLastSignInDateTime\",\"Ownership\",\"ComplianceStatus\",\"IntuneIsCompliant\",\"OperatingSystem\",\"OSVersion\",\"WindowsVersionFamily\",\"Manufacturer\",\"Model\",\"SerialNumber\",\"PhysicalMemoryGB\",\"StorageTotalGB\",\"StorageFreeGB\",\"IntuneLastSyncDateTime\",\"LastActivityDateTime\",\"DaysSinceLastActivity\",\"ActivityBucket\",\"Windows11Readiness\",\"Windows11MigrationPhase\",\"UpdateRisk\",\"ActionSeverity\",\"ActionPriority\",\"ActionRequired\",\"RecommendedAction\"})",
                "in Result"
              ],
              "type": "m"
            }
          }
        ]
      },
