        "partitions": [
          {
            "name": "AD_Users_DailyStats",
            "mode": "import",
            "source": {
              "expression": "let Source=fnLoadSourceTable(\"AD_Users_DailyStats.csv\", \";\", {\"TenantKey\", \"OrganizationKey\", \"EnvironmentKey\", \"TenantId\", \"Date\", \"DomainName\", \"TotalUsers\", \"EnabledUsers\", \"DisabledUsers\", \"Inactive90DaysUsers\"}, {{\"Date\", \"datetime\"}, {\"TotalUsers\", \"int64\"}, {\"EnabledUsers\", \"int64\"}, {\"DisabledUsers\", \"int64\"}, {\"Inactive90DaysUsers\", \"int64\"}}, false), WithWeekStart=Table.AddColumn(Source, \"__WeekStart\", each if [Date]=null then null else DateTime.From(Date.StartOfWeek(Date.From([Date]),Day.Monday)), type nullable datetime) in WithWeekStart",
              "type": "m"
            }
          }
        ]
      },
