{
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "SourceMode",
        "kind": "m",
        "expression": "\"LocalFolder\"",
        "annotations": [
          {
            "name": "IsParameterQuery",
            "value": "True"
          },
          {
            "name": "Type",
            "value": "Text"
          },
          {
            "name": "IsParameterQueryRequired",
            "value": "True"
          }
        ]
      },
      {
        "name": "DataRootPath",
        "kind": "m",
        "expression": "\"C:\\SmartM365\\DATA\"",
        "annotations": [
          {
            "name": "IsParameterQuery",
            "value": "True"
          },
          {
            "name": "Type",
            "value": "Text"
          },
          {
            "name": "IsParameterQueryRequired",
            "value": "True"
          }
        ]
      },
      {
        "name": "SharePointSiteUrl",
        "kind": "m",
        "expression": "\"\"",
        "annotations": [
          {
            "name": "IsParameterQuery",
            "value": "True"
          },
          {
            "name": "Type",
            "value": "Text"
          },
          {
            "name": "IsParameterQueryRequired",
            "value": "True"
          }
        ]
      },
      {
        "name": "SharePointDataFolderUrl",
        "kind": "m",
        "expression": "\"\"",
        "annotations": [
          {
            "name": "IsParameterQuery",
            "value": "True"
          },
          {
            "name": "Type",
            "value": "Text"
          },
          {
            "name": "IsParameterQueryRequired",
            "value": "True"
          }
        ]
      },
      {
        "name": "HistoryMonths",
        "kind": "m",
        "expression": "24",
        "annotations": [
          {
            "name": "IsParameterQuery",
            "value": "True"
          },
          {
            "name": "Type",
            "value": "Number"
          },
          {
            "name": "IsParameterQueryRequired",
            "value": "True"
          }
        ]
      },
      {
        "name": "HistoryMinRowRatio",
        "kind": "m",
        "expression": "0.5",
        "annotations": [
          {
            "name": "IsParameterQuery",
            "value": "True"
          },
          {
            "name": "Type",
            "value": "Number"
          },
          {
            "name": "IsParameterQueryRequired",
            "value": "True"
          }
        ]
      },
      {
        "name": "fnGetSourceFiles",
        "kind": "m",
        "expression": "(relativeFolder as text) as table =>\nlet\n RelativeWindows=Text.Replace(relativeFolder,\"/\",\"\\\"), RelativeUrl=Text.Replace(relativeFolder,\"\\\",\"/\"),\n LocalPath=Text.TrimEnd(DataRootPath,{\"\\\",\"/\"})&\"\\\"&RelativeWindows,\n Empty=#table(type table [Name=text,Content=binary,Extension=text,Folder Path=text,Date modified=nullable datetime,Size=nullable number],{}),\n LocalFiles=if SourceMode=\"LocalFolder\" then Folder.Files(LocalPath) else Empty,\n SharePointFiles=if SourceMode=\"SharePoint\" then let All=SharePoint.Files(SharePointSiteUrl,[ApiVersion=15]),Prefix=Text.TrimEnd(SharePointDataFolderUrl,{\"/\"})&\"/\"&RelativeUrl&\"/\" in Table.SelectRows(All,each Text.StartsWith([Folder Path],Prefix,Comparer.OrdinalIgnoreCase)) else Empty,\n Selected=if SourceMode=\"SharePoint\" then SharePointFiles else LocalFiles\nin Table.SelectColumns(Selected,{\"Name\",\"Content\",\"Extension\",\"Folder Path\",\"Date modified\",\"Size\"},MissingField.UseNull)"
      },
      {
        "name": "fnToLogical",
        "kind": "m",
        "expression": "(v as any) as nullable logical => let t=if v=null then null else Text.Lower(Text.Trim(Text.From(v))) in if v=null or t=\"\" then null else if Value.Is(v,type logical) then v else if List.Contains({\"true\",\"1\",\"yes\",\"oui\"},t) then true else if List.Contains({\"false\",\"0\",\"no\",\"non\"},t) then false else null"
      },
      {
        "name": "fnToDateTime",
        "kind": "m",
        "expression": "(v as any) as nullable datetime => if v=null or Text.Trim(Text.From(v))=\"\" then null else try DateTime.From(v) otherwise try DateTime.FromText(Text.From(v),[Culture=\"en-US\"]) otherwise try DateTime.FromText(Text.From(v),[Culture=\"fr-FR\"]) otherwise null"
      },
      {
        "name": "fnToNumber",
        "kind": "m",
        "expression": "(v as any) as nullable number => let t=if v=null then \"\" else Text.Trim(Text.From(v)), normalized=if Text.Contains(t,\",\") and not Text.Contains(t,\".\") then Text.Replace(t,\",\",\".\") else t in if t=\"\" then null else try Number.FromText(normalized,\"en-US\") otherwise try Number.FromText(t,\"fr-FR\") otherwise null"
      },
      {
        "name": "fnToInt64",
        "kind": "m",
        "expression": "(v as any) as nullable number => let n=fnToNumber(v) in if n=null then null else try Int64.From(n) otherwise null"
      },
      {
        "name": "fnLoadSourceTable",
        "kind": "m",
        "expression": "(fileName as text,delimiter as text,expectedColumns as list,typeMap as list,includeHistory as logical) as table =>\nlet\n CurrentFiles=Table.Sort(Table.SelectRows(fnGetSourceFiles(\"DATA-LAST\"),each [Name]=fileName),{{\"Date modified\",Order.Descending}}),\n Current=if Table.RowCount(CurrentFiles)=0 then error Error.Record(\"SmartInventorySourceMissing\",\"Required CSV not found.\",[FileName=fileName,SourceMode=SourceMode]) else CurrentFiles{0},\n CurrentModified=if Current[Date modified]=null then DateTime.LocalNow() else Current[Date modified], CurrentWeek=Date.StartOfWeek(Date.From(CurrentModified),Day.Monday),\n Parse=(item as record,isCurrent as logical) as table => let\n  Csv=Csv.Document(Binary.Buffer(item[Content]),[Delimiter=delimiter,Encoding=65001,QuoteStyle=QuoteStyle.Csv]), Promoted=Table.PromoteHeaders(Csv,[PromoteAllScalars=true]), Base=Table.SelectColumns(Promoted,expectedColumns,MissingField.UseNull),\n  Stamp=if item[Date modified]=null then CurrentModified else item[Date modified],\n  A=Table.AddColumn(Base,\"__SnapshotDate\",each DateTime.From(Date.From(Stamp)),type datetime), B=Table.AddColumn(A,\"__SnapshotDateTime\",each Stamp,type datetime),\n  C=Table.AddColumn(B,\"__SnapshotPeriod\",each Date.ToText(Date.StartOfWeek(Date.From(Stamp),Day.Monday),\"yyyy-MM-dd\"),type text), D=Table.AddColumn(C,\"__IsCurrent\",each isCurrent,type logical),\n  E=Table.AddColumn(D,\"__SourceFile\",each fileName,type text), F=Table.AddColumn(E,\"__SourceFolder\",each item[Folder Path],type text)\n in F,\n Historical=if not includeHistory then #table({}, {}) else let\n  Earliest=Date.AddMonths(Date.From(CurrentModified),-Number.RoundDown(HistoryMonths)), Candidates=Table.SelectRows(fnGetSourceFiles(\"DATA-ALL\"),each [Name]=fileName and [Date modified]<>null and Date.From([Date modified])>=Earliest and Date.From([Date modified])<CurrentWeek and Text.Contains(Text.Replace([Folder Path],\"\\\",\"/\"),\"/WeeklyHistory/\",Comparer.OrdinalIgnoreCase)),\n  WithPeriod=Table.AddColumn(Candidates,\"__Period\",each Date.ToText(Date.StartOfWeek(Date.From([Date modified]),Day.Monday),\"yyyy-MM-dd\"),type text), Grouped=Table.Group(WithPeriod,{\"__Period\"},{{\"Latest\",each Table.FirstN(Table.Sort(_,{{\"Date modified\",Order.Descending}}),1)}})\n in if Table.RowCount(Grouped)=0 then Candidates else Table.Combine(Grouped[Latest]),\n CurrentTable=Parse(Current,true), MinimumHistoryRows=Number.RoundDown(Table.RowCount(CurrentTable)*HistoryMinRowRatio), CandidateHistoryTables=if includeHistory and Table.RowCount(Historical)>0 then List.Transform(Table.ToRecords(Historical),each Parse(_,false)) else {}, HistoryTables=List.Select(CandidateHistoryTables,each Table.RowCount(_)>=MinimumHistoryRows), Combined=Table.Combine(List.Combine({HistoryTables,{CurrentTable}})),\n Typed=List.Accumulate(typeMap,Combined,(state as table,item as list)=>if not Table.HasColumns(state,item{0}) then state else if item{1}=\"logical\" then Table.TransformColumns(state,{{item{0},fnToLogical,type nullable logical}}) else if item{1}=\"datetime\" then Table.TransformColumns(state,{{item{0},fnToDateTime,type nullable datetime}}) else if item{1}=\"number\" or item{1}=\"double\" then Table.TransformColumns(state,{{item{0},fnToNumber,type nullable number}}) else if item{1}=\"int64\" then Table.TransformColumns(state,{{item{0},fnToInt64,Int64.Type}}) else Table.TransformColumns(state,{{item{0},each if _=null then null else Text.From(_),type nullable text}}))\nin Table.SelectColumns(Typed,List.Combine({expectedColumns,{\"__SnapshotDate\",\"__SnapshotDateTime\",\"__SnapshotPeriod\",\"__IsCurrent\",\"__SourceFile\",\"__SourceFolder\"}}),MissingField.UseNull)"
      }
    ],
