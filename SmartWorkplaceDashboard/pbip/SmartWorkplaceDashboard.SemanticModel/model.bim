        "description": "SmartInventory source: M365_Users_Active.csv",
        "lineageTag": "b6658836-cae8-46ff-8443-45b083302c86",
        "measures": [
          {
            "name": "Enabled Users",
            "displayFolder": "Identity",
            "expression": "CALCULATE(DISTINCTCOUNTNOBLANK('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[AccountEnabled]=TRUE())",
            "formatString": "#,0.0",
            "lineageTag": "bbec41e3-c29d-4216-9c6a-b500e8c1bc0c"
          },
          {
            "name": "Disabled Users",
            "displayFolder": "Identity",
            "expression": "CALCULATE(DISTINCTCOUNTNOBLANK('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[AccountEnabled]==FALSE())",
            "formatString": "#,0.0",
            "lineageTag": "f4e2e82d-8559-4f7f-8711-4686d22c6d61"
          },
          {
            "name": "Guest Users",
            "displayFolder": "Identity",
            "expression": "CALCULATE(DISTINCTCOUNTNOBLANK('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[UserType]=\"Guest\")",
            "formatString": "#,0.0",
            "lineageTag": "ca083ef1-128c-4ec4-837f-acecc9681e57"
          },
          {
            "name": "Enabled Users Inactive 90d",
            "displayFolder": "Identity",
            "expression": "CALCULATE(DISTINCTCOUNTNOBLANK('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[AccountEnabled]=TRUE(),FILTER('M365_Users_Active',VAR LastActivity=MAX('M365_Users_Active'[LastSignInDateTime],'M365_Users_Active'[LastNonInteractiveSignInDateTime]) RETURN NOT ISBLANK(LastActivity)&&LastActivity<NOW()-90))",
            "formatString": "#,0.0",
            "lineageTag": "15d9cb8a-c39c-4884-af51-931a7cc26f57"
          },
          {
            "name": "Active M365 Users",
            "displayFolder": "Identity",
            "expression": "CALCULATE(DISTINCTCOUNTNOBLANK('M365_Users_Activity'[UserPrincipalName]),'M365_Users_Activity'[__IsCurrent]=TRUE(),'M365_Users_Activity'[HasAnyM365Activity]=TRUE())",
            "formatString": "#,0.0",
            "lineageTag": "b5652900-7e8b-420f-b293-d316e259fe19"
          },
          {
            "name": "Inactive M365 Users",
            "displayFolder": "Identity",
            "expression": "CALCULATE(DISTINCTCOUNTNOBLANK('M365_Users_Activity'[UserPrincipalName]),'M365_Users_Activity'[__IsCurrent]=TRUE(),'M365_Users_Activity'[HasAnyM365Activity]==FALSE())",
            "formatString": "#,0.0",
            "lineageTag": "3c85c50b-e7fa-48d3-a465-68bfffa2275b"
          },
          {
            "name": "M365 Activity Rate",
            "displayFolder": "Identity",
            "expression": "DIVIDE([Active M365 Users],[Active M365 Users]+[Inactive M365 Users])",
            "formatString": "0.0%",
            "lineageTag": "4748fb93-6176-4655-be14-939d10304efc"
          },
          {
            "name": "Hybrid Identity Issue Rows",
            "displayFolder": "Identity",
            "expression": "COUNTROWS('Exchange_HybridIdentity_Issues')",
            "formatString": "#,0.0",
            "lineageTag": "30ba12b9-6ef0-4ffe-b4df-c2e9e5c7483f"
          },
          {
            "name": "Hybrid Identity Affected Users",
            "displayFolder": "Identity",
            "expression": "DISTINCTCOUNTNOBLANK('Exchange_HybridIdentity_Issues'[ObjectGUID])",
            "formatString": "#,0.0",
            "lineageTag": "32436bf3-942b-42be-91eb-3d71184e8a82"
          },
          {
            "name": "M365 E3 Purchased",
            "displayFolder": "Licensing",
            "expression": "VAR _LicenseRows=FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&('M365_Licenses_Tenant'[TenantSkuPartNumber]=\"SPE_E3\")) RETURN IF(COUNTROWS(_LicenseRows)=0,BLANK(),IF(COUNTROWS(FILTER(_LicenseRows,ISBLANK('M365_Licenses_Tenant'[TenantPrepaidEnabled])||'M365_Licenses_Tenant'[TenantPrepaidEnabled]<0))>0,BLANK(),SUMX(_LicenseRows,'M365_Licenses_Tenant'[TenantPrepaidEnabled])))",
            "formatString": "#,0.0",
            "lineageTag": "8f7ba509-c4dd-41ee-9027-a702481e8be4"
          },
          {
            "name": "M365 E3 Consumed",
            "displayFolder": "Licensing",
            "expression": "VAR _LicenseRows=FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&('M365_Licenses_Tenant'[TenantSkuPartNumber]=\"SPE_E3\")) RETURN IF(COUNTROWS(_LicenseRows)=0,BLANK(),IF(COUNTROWS(FILTER(_LicenseRows,ISBLANK('M365_Licenses_Tenant'[TenantConsumedUnits])||'M365_Licenses_Tenant'[TenantConsumedUnits]<0))>0,BLANK(),SUMX(_LicenseRows,'M365_Licenses_Tenant'[TenantConsumedUnits])))",
            "formatString": "#,0.0",
            "lineageTag": "f5e9eba8-cee1-4c8e-a44f-33acf90cf234"
          },
          {
            "name": "M365 E3 Available",
            "displayFolder": "Licensing",
            "expression": "IF(ISBLANK([M365 E3 Purchased])||ISBLANK([M365 E3 Consumed]),BLANK(),[M365 E3 Purchased]-[M365 E3 Consumed])",
            "formatString": "#,0.0",
            "lineageTag": "d9f5496a-d35e-4f03-b94a-386612ca28bf"
          },
          {
            "name": "M365 E3 Utilization",
            "displayFolder": "Licensing",
            "expression": "IF([M365 E3 Purchased]=0,BLANK(),DIVIDE([M365 E3 Consumed],[M365 E3 Purchased]))",
            "formatString": "0.0%",
            "lineageTag": "077cad60-b265-4ea5-96fd-9638d154ad63"
          },
          {
            "name": "M365 E5 Purchased",
            "displayFolder": "Licensing",
            "expression": "VAR _LicenseRows=FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&('M365_Licenses_Tenant'[TenantSkuPartNumber] IN {\"SPE_E5\",\"Microsoft_365_E5\"})) RETURN IF(COUNTROWS(_LicenseRows)=0,BLANK(),IF(COUNTROWS(FILTER(_LicenseRows,ISBLANK('M365_Licenses_Tenant'[TenantPrepaidEnabled])||'M365_Licenses_Tenant'[TenantPrepaidEnabled]<0))>0,BLANK(),SUMX(_LicenseRows,'M365_Licenses_Tenant'[TenantPrepaidEnabled])))",
            "formatString": "#,0.0",
            "lineageTag": "6b843060-1d59-4f18-baf8-16de2f1cbe14"
          },
          {
