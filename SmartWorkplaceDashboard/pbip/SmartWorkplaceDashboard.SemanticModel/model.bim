        "partitions": [
          {
            "name": "M365_Users_Active",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "fnLoadSourceTable(\"M365_Users_Active.csv\", \",\", {\"TenantKey\", \"OrganizationKey\", \"EnvironmentKey\", \"TenantId\", \"Display name\", \"DirSyncEnabled\", \"User principal name\", \"Object Id\", \"First name\", \"Last name\", \"When created\", \"Soft deletion time stamp\", \"Title\", \"Department\", \"Preferred data location\", \"City\", \"CountryOrRegion\", \"Office\", \"StateOrProvince\", \"Usage location\", \"Last dirsync time\", \"Block credential\", \"Licenses\", \"Password never expires\", \"Last password change time stamp\", \"Mobile Phone\", \"Phone number\", \"Postal code\", \"Preferred language\", \"Street address\", \"Fax\", \"Proxy addresses\", \"OnPremisesImmutableId\", \"OnPremisesSecurityIdentifier\", \"OnPremisesSyncEnabled\", \"AccountEnabled\", \"UserType\", \"LastSignInDateTime\", \"LastNonInteractiveSignInDateTime\"}, {{\"DirSyncEnabled\", \"logical\"}, {\"When created\", \"datetime\"}, {\"Last dirsync time\", \"datetime\"}, {\"Block credential\", \"logical\"}, {\"OnPremisesSyncEnabled\", \"logical\"}, {\"AccountEnabled\", \"logical\"}, {\"LastSignInDateTime\", \"datetime\"}, {\"LastNonInteractiveSignInDateTime\", \"datetime\"}}, false)"
            }
          }
        ],
        "measures": [
          {
            "name": "Enabled Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[AccountEnabled]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "Disabled Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[AccountEnabled]=FALSE())",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "Guest Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[UserType]=\"Guest\")",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "Enabled Users Inactive 90d",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Users_Active'[Object Id]),'M365_Users_Active'[__IsCurrent]=TRUE(),'M365_Users_Active'[AccountEnabled]=TRUE(),FILTER('M365_Users_Active',VAR LastActivity=MAX('M365_Users_Active'[LastSignInDateTime],'M365_Users_Active'[LastNonInteractiveSignInDateTime]) RETURN ISBLANK(LastActivity)||LastActivity<NOW()-90))",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "Active M365 Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Users_Activity'[UserPrincipalName]),'M365_Users_Activity'[__IsCurrent]=TRUE(),'M365_Users_Activity'[HasAnyM365Activity]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "Inactive M365 Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Users_Activity'[UserPrincipalName]),'M365_Users_Activity'[__IsCurrent]=TRUE(),'M365_Users_Activity'[HasAnyM365Activity]=FALSE())",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "M365 Activity Rate",
            "expression": "DIVIDE([Active M365 Users],[Active M365 Users]+[Inactive M365 Users])",
            "formatString": "0.0%",
            "displayFolder": "Identity"
          },
          {
            "name": "Hybrid Identity Issue Rows",
            "expression": "COUNTROWS('Exchange_HybridIdentity_Issues')",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "Hybrid Identity Affected Users",
            "expression": "DISTINCTCOUNT('Exchange_HybridIdentity_Issues'[ObjectGUID])",
            "formatString": "#,0",
            "displayFolder": "Identity"
          },
          {
            "name": "Purchased Licenses",
            "expression": "CALCULATE(SUM('M365_Licenses_Tenant'[TenantPrepaidEnabled]),'M365_Licenses_Tenant'[__IsCurrent]=TRUE(),KEEPFILTERS('M365_Licenses_Tenant'[TenantSkuPartNumber] IN {\"SPE_E3\",\"SPE_F1\"}))",
            "formatString": "#,0",
            "displayFolder": "Licensing"
          },
          {
            "name": "Consumed Licenses",
            "expression": "CALCULATE(SUM('M365_Licenses_Tenant'[TenantConsumedUnits]),'M365_Licenses_Tenant'[__IsCurrent]=TRUE(),KEEPFILTERS('M365_Licenses_Tenant'[TenantSkuPartNumber] IN {\"SPE_E3\",\"SPE_F1\"}))",
            "formatString": "#,0",
            "displayFolder": "Licensing"
          },
          {
            "name": "Available Licenses",
            "expression": "[Purchased Licenses]-[Consumed Licenses]",
            "formatString": "#,0",
            "displayFolder": "Licensing"
          },
          {
            "name": "License Utilization",
            "expression": "DIVIDE([Consumed Licenses],[Purchased Licenses])",
            "formatString": "0.0%",
            "displayFolder": "Licensing"
          },
          {
            "name": "M365 SKU Purchased",
            "expression": "CALCULATE(SUM('M365_Licenses_Tenant'[TenantPrepaidEnabled]),'M365_Licenses_Tenant'[__IsCurrent]=TRUE(),KEEPFILTERS('M365_Licenses_Tenant'[TenantSkuPartNumber] IN {\"SPE_E3\",\"SPE_F1\"}))",
            "formatString": "#,0",
            "displayFolder": "Licensing"
          },
          {
            "name": "M365 SKU Consumed",
            "expression": "CALCULATE(SUM('M365_Licenses_Tenant'[TenantConsumedUnits]),'M365_Licenses_Tenant'[__IsCurrent]=TRUE(),KEEPFILTERS('M365_Licenses_Tenant'[TenantSkuPartNumber] IN {\"SPE_E3\",\"SPE_F1\"}))",
            "formatString": "#,0",
            "displayFolder": "Licensing"
          },
          {
            "name": "M365 SKU Available",
            "expression": "[M365 SKU Purchased]-[M365 SKU Consumed]",
            "formatString": "#,0",
            "displayFolder": "Licensing"
          },
          {
            "name": "M365 SKU Utilization",
            "expression": "DIVIDE([M365 SKU Consumed],[M365 SKU Purchased])",
            "formatString": "0.0%",
            "displayFolder": "Licensing"
          },
          {
            "name": "Service Plan Assignments",
            "expression": "CALCULATE(COUNTROWS('M365_Licenses_UserServicePlanStates'),'M365_Licenses_UserServicePlanStates'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Licensing Service Plans"
          },
          {
            "name": "Service Plan Assigned Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Licenses_UserServicePlanStates'[UserId]),'M365_Licenses_UserServicePlanStates'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Licensing Service Plans"
          },
          {
            "name": "Enabled Service Plan Assignments",
            "expression": "CALCULATE(COUNTROWS('M365_Licenses_UserServicePlanStates'),'M365_Licenses_UserServicePlanStates'[__IsCurrent]=TRUE(),'M365_Licenses_UserServicePlanStates'[IsEnabled]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Licensing Service Plans"
          },
          {
            "name": "Disabled Service Plan Assignments",
            "expression": "CALCULATE(COUNTROWS('M365_Licenses_UserServicePlanStates'),'M365_Licenses_UserServicePlanStates'[__IsCurrent]=TRUE(),'M365_Licenses_UserServicePlanStates'[IsEnabled]=FALSE())",
            "formatString": "#,0",
            "displayFolder": "Licensing Service Plans"
          },
          {
            "name": "Users with Disabled Service Plans",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Licenses_UserServicePlanStates'[UserId]),'M365_Licenses_UserServicePlanStates'[__IsCurrent]=TRUE(),'M365_Licenses_UserServicePlanStates'[IsEnabled]=FALSE())",
            "formatString": "#,0",
            "displayFolder": "Licensing Service Plans"
          },
          {
            "name": "Service Plan Enablement Rate",
            "expression": "DIVIDE([Enabled Service Plan Assignments],[Service Plan Assignments])",
            "formatString": "0.0%",
            "displayFolder": "Licensing Service Plans"
          },
          {
            "name": "Managed Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Devices_Inventory'[Device ID]),'Intune_Devices_Inventory'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Devices"
          },
          {
            "name": "Compliant Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Devices_Inventory'[Device ID]),'Intune_Devices_Inventory'[__IsCurrent]=TRUE(),'Intune_Devices_Inventory'[IsCompliant]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Devices"
          },
          {
            "name": "Noncompliant Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Devices_Inventory'[Device ID]),'Intune_Devices_Inventory'[__IsCurrent]=TRUE(),'Intune_Devices_Inventory'[IsCompliant]=FALSE())",
            "formatString": "#,0",
            "displayFolder": "Devices"
          },
          {
            "name": "Device Compliance Rate",
            "expression": "DIVIDE([Compliant Devices],[Managed Devices])",
            "formatString": "0.0%",
            "displayFolder": "Devices"
          },
          {
            "name": "Stale Devices 30d",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Devices_Inventory'[Device ID]),'Intune_Devices_Inventory'[__IsCurrent]=TRUE(),FILTER('Intune_Devices_Inventory',NOT ISBLANK('Intune_Devices_Inventory'[LastSyncDateTime])&&'Intune_Devices_Inventory'[LastSyncDateTime]<NOW()-30))",
            "formatString": "#,0",
            "displayFolder": "Devices"
          },
          {
            "name": "Autopilot Devices",
            "expression": "CALCULATE(COUNTROWS('Intune_Autopilot_Devices'),'Intune_Autopilot_Devices'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Devices"
          },
          {
            "name": "Entra Removal Candidates",
            "expression": "COUNTROWS('M365_Entra_Devices_RemovalCandidates')",
            "formatString": "#,0",
            "displayFolder": "Devices"
          },
          {
            "name": "Hardware ID Conflicts",
            "expression": "COUNTROWS('M365_Entra_Devices_HardwareIdConflicts')",
            "formatString": "#,0",
            "displayFolder": "Devices"
          },
          {
            "name": "Update Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_WindowsUpdate_Status'[DeviceId]),'Intune_WindowsUpdate_Status'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "High Risk Update Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_WindowsUpdate_Status'[DeviceId]),'Intune_WindowsUpdate_Status'[__IsCurrent]=TRUE(),'Intune_WindowsUpdate_Status'[RiskBucket]=\"High\")",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Medium Risk Update Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_WindowsUpdate_Status'[DeviceId]),'Intune_WindowsUpdate_Status'[__IsCurrent]=TRUE(),'Intune_WindowsUpdate_Status'[RiskBucket]=\"Medium\")",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Upgrade Assessed Devices",
            "expression": "DISTINCTCOUNT('Intune_Devices_UpgradeEligibility'[GraphId])",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Eligible Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Devices_UpgradeEligibility'[GraphId]),'Intune_Devices_UpgradeEligibility'[UpgradeEligibilityLabel]=\"Eligible\")",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Not Eligible Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Devices_UpgradeEligibility'[GraphId]),'Intune_Devices_UpgradeEligibility'[UpgradeEligibilityLabel]=\"NotEligible\")",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Upgraded Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Devices_UpgradeEligibility'[GraphId]),'Intune_Devices_UpgradeEligibility'[UpgradeEligibilityLabel]=\"Upgraded\")",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Windows 11 Affected Devices",
            "expression": "DISTINCTCOUNT('Intune_Windows11_Readiness_Issues'[ObjectGUID_Norm])",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Windows 11 Blocking Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_Windows11_Readiness_Issues'[ObjectGUID_Norm]),'Intune_Windows11_Readiness_Issues'[IsBlocking]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Windows Lifecycle"
          },
          {
            "name": "Mailboxes",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_EXO_Mailboxes_AllDomains'[MailboxGuid]),'Exchange_EXO_Mailboxes_AllDomains'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Online"
          },
          {
            "name": "Shared Mailboxes",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_EXO_Mailboxes_AllDomains'[MailboxGuid]),'Exchange_EXO_Mailboxes_AllDomains'[__IsCurrent]=TRUE(),'Exchange_EXO_Mailboxes_AllDomains'[MailboxType]=\"SharedMailbox\")",
            "formatString": "#,0",
            "displayFolder": "Exchange Online"
          },
          {
            "name": "Mailbox Storage TB",
            "expression": "DIVIDE(CALCULATE(SUM('M365_Mailbox_Usage'[Storage Used (Byte)]),'M365_Mailbox_Usage'[__IsCurrent]=TRUE()),1099511627776)",
            "formatString": "#,0.0",
            "displayFolder": "Exchange Online"
          },
          {
            "name": "Mailbox Aggregate Quota TB",
            "expression": "DIVIDE(CALCULATE(SUM('M365_Mailbox_Usage'[Prohibit Send/Receive Quota (Byte)]),'M365_Mailbox_Usage'[__IsCurrent]=TRUE()),1099511627776)",
            "formatString": "#,0.0",
            "displayFolder": "Exchange Online"
          },
          {
            "name": "Mailbox Quota Utilization",
            "expression": "DIVIDE([Mailbox Storage TB],[Mailbox Aggregate Quota TB])",
            "formatString": "0.0%",
            "displayFolder": "Exchange Online"
          },
          {
            "name": "On-prem Hosted Mailboxes",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Mailboxes_AllDomains'[ExchangeGuid]),'Exchange_OnPrem_Mailboxes_AllDomains'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Online Hosted Mailboxes",
            "expression": "[Mailboxes]",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Hybrid Hosted Mailboxes",
            "expression": "[On-prem Hosted Mailboxes]+[Online Hosted Mailboxes]",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Online Placement Rate",
            "expression": "DIVIDE([Online Hosted Mailboxes],[Hybrid Hosted Mailboxes])",
            "formatString": "0.0%",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Remote Mailbox Objects",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_RemoteMailboxes_AllDomains'[PrimarySmtpAddress]),'Exchange_OnPrem_RemoteMailboxes_AllDomains'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Remote Mailboxes Matched EXO",
            "expression": "VAR ExoAddresses=CALCULATETABLE(VALUES('Exchange_EXO_Mailboxes_AllDomains'[PrimarySmtpAddress]),'Exchange_EXO_Mailboxes_AllDomains'[__IsCurrent]=TRUE()) RETURN CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_RemoteMailboxes_AllDomains'[PrimarySmtpAddress]),'Exchange_OnPrem_RemoteMailboxes_AllDomains'[__IsCurrent]=TRUE(),TREATAS(ExoAddresses,'Exchange_OnPrem_RemoteMailboxes_AllDomains'[PrimarySmtpAddress]))",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Remote Mailboxes without EXO",
            "expression": "[Remote Mailbox Objects]-[Remote Mailboxes Matched EXO]",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "EXO Mailboxes without Remote",
            "expression": "[Online Hosted Mailboxes]-[Remote Mailboxes Matched EXO]",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Remote to EXO Match Rate",
            "expression": "DIVIDE([Remote Mailboxes Matched EXO],[Remote Mailbox Objects])",
            "formatString": "0.0%",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Potential Dual-hosted SMTP",
            "expression": "VAR ExoAddresses=CALCULATETABLE(VALUES('Exchange_EXO_Mailboxes_AllDomains'[PrimarySmtpAddress]),'Exchange_EXO_Mailboxes_AllDomains'[__IsCurrent]=TRUE()) RETURN CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Mailboxes_AllDomains'[PrimarySMTPaddress]),'Exchange_OnPrem_Mailboxes_AllDomains'[__IsCurrent]=TRUE(),TREATAS(ExoAddresses,'Exchange_OnPrem_Mailboxes_AllDomains'[PrimarySMTPaddress]))",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "On-prem Local Mailboxes Trend",
            "expression": "SUM('Exchange_OnPrem_Mailboxes_DailyStats'[TotalLocalMailboxCount])",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Remote Mailbox Objects Trend",
            "expression": "SUM('Exchange_OnPrem_Mailboxes_DailyStats'[TotalRemoteMailboxCount])",
            "formatString": "#,0",
            "displayFolder": "Exchange Hybrid"
          },
          {
            "name": "Migration Batches",
            "expression": "DISTINCTCOUNT('Exchange_EXO_MigrationJobs'[BatchGuid])",
            "formatString": "#,0",
            "displayFolder": "Migration"
          },
          {
            "name": "Migration Users",
            "expression": "DISTINCTCOUNT('Exchange_EXO_MigrationJobs'[MigrationUser])",
            "formatString": "#,0",
            "displayFolder": "Migration"
          },
          {
            "name": "Migration Failed Users",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_EXO_MigrationJobs'[MigrationUser]),'Exchange_EXO_MigrationJobs'[UserStatus]=\"Failed\")",
            "formatString": "#,0",
            "displayFolder": "Migration"
          },
          {
            "name": "Migration Failed Items",
            "expression": "SUMX(VALUES('Exchange_EXO_MigrationJobs'[BatchGuid]),CALCULATE(MAX('Exchange_EXO_MigrationJobs'[FailedCount])))",
            "formatString": "#,0",
            "displayFolder": "Migration"
          },
          {
            "name": "Migration Failed Batches",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_EXO_MigrationJobs'[BatchGuid]),'Exchange_EXO_MigrationJobs'[FailedCount]>0)",
            "formatString": "#,0",
            "displayFolder": "Migration"
          },
          {
            "name": "Migration Success Rate",
            "expression": "1-DIVIDE([Migration Failed Users],[Migration Users])",
            "formatString": "0.0%",
            "displayFolder": "Migration"
          },
          {
            "name": "Migration Readiness Settings",
            "expression": "COUNTROWS('Exchange_OnPrem_MigrationReadiness_Config')",
            "formatString": "#,0",
            "displayFolder": "Migration"
          },
          {
            "name": "Migration Readiness Errors",
            "expression": "CALCULATE(COUNTROWS('Exchange_OnPrem_MigrationReadiness_Config'),'Exchange_OnPrem_MigrationReadiness_Config'[CollectionStatus]<>\"OK\")",
            "formatString": "#,0",
            "displayFolder": "Migration"
          },
          {
            "name": "Exchange Servers",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Servers_Inventory'[Name]),'Exchange_OnPrem_Servers_Inventory'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Mailbox Role Servers",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Servers_Inventory'[Name]),'Exchange_OnPrem_Servers_Inventory'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_Inventory'[ServerRole]=\"Mailbox\")",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Edge Role Servers",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Servers_Inventory'[Name]),'Exchange_OnPrem_Servers_Inventory'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_Inventory'[ServerRole]=\"Edge\")",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange 2016 Servers",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Servers_Inventory'[Name]),'Exchange_OnPrem_Servers_Inventory'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_Inventory'[IsExchange2016]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Compute Inventoried Servers",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Servers_Compute'[ExchangeServerName]),'Exchange_OnPrem_Servers_Compute'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_Compute'[CollectionStatus]=\"OK\")",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Server Inventory Coverage",
            "expression": "DIVIDE([Compute Inventoried Servers],[Exchange Servers])",
            "formatString": "0.0%",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Virtual Servers",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Servers_Compute'[ExchangeServerName]),'Exchange_OnPrem_Servers_Compute'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_Compute'[CollectionStatus]=\"OK\",'Exchange_OnPrem_Servers_Compute'[IsVirtualMachine]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Memory TB",
            "expression": "DIVIDE(CALCULATE(SUM('Exchange_OnPrem_Servers_Compute'[MemoryGB]),'Exchange_OnPrem_Servers_Compute'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_Compute'[CollectionStatus]=\"OK\"),1024)",
            "formatString": "#,0.0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Physical Cores",
            "expression": "CALCULATE(SUM('Exchange_OnPrem_Servers_Compute'[PhysicalCoreCount]),'Exchange_OnPrem_Servers_Compute'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_Compute'[CollectionStatus]=\"OK\")",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Logical Storage TB",
            "expression": "DIVIDE(CALCULATE(SUM('Exchange_OnPrem_Servers_LogicalDisks'[SizeGB]),'Exchange_OnPrem_Servers_LogicalDisks'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_LogicalDisks'[CollectionStatus]=\"OK\"),1024)",
            "formatString": "#,0.0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Logical Free TB",
            "expression": "DIVIDE(CALCULATE(SUM('Exchange_OnPrem_Servers_LogicalDisks'[FreeGB]),'Exchange_OnPrem_Servers_LogicalDisks'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_LogicalDisks'[CollectionStatus]=\"OK\"),1024)",
            "formatString": "#,0.0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Storage Used Rate",
            "expression": "1-DIVIDE([Exchange Logical Free TB],[Exchange Logical Storage TB])",
            "formatString": "0.0%",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Low Space Volumes",
            "expression": "CALCULATE(COUNTROWS('Exchange_OnPrem_Servers_LogicalDisks'),'Exchange_OnPrem_Servers_LogicalDisks'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_LogicalDisks'[LowSpaceWarning]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "WMI Inaccessible Servers",
            "expression": "CALCULATE(DISTINCTCOUNT('Exchange_OnPrem_Servers_RemoteAccess'[ExchangeServerName]),'Exchange_OnPrem_Servers_RemoteAccess'[__IsCurrent]=TRUE(),'Exchange_OnPrem_Servers_RemoteAccess'[WmiDcomOk]=FALSE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Server Readiness Warnings",
            "expression": "CALCULATE(MAX('Exchange_OnPrem_Servers_Inventory_Summary'[ExchangeReadinessWarnings]),'Exchange_OnPrem_Servers_Inventory_Summary'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Server Readiness Errors",
            "expression": "CALCULATE(MAX('Exchange_OnPrem_Servers_Inventory_Summary'[ExchangeReadinessErrors]),'Exchange_OnPrem_Servers_Inventory_Summary'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Schema Range Upper",
            "expression": "CALCULATE(MAX('Exchange_OnPrem_Servers_Inventory_Summary'[ExchangeSchemaRangeUpper]),'Exchange_OnPrem_Servers_Inventory_Summary'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Exchange Infrastructure"
          },
          {
            "name": "Exchange Servers Trend",
            "expression": "MAX('Exchange_OnPrem_Servers_Inventory_Summary'[ExchangeServersCount])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Exchange Memory TB Trend",
            "expression": "MAX('Exchange_OnPrem_Servers_Inventory_Summary'[TotalMemoryTB])",
            "formatString": "#,0.0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Exchange Logical Free TB Trend",
            "expression": "MAX('Exchange_OnPrem_Servers_Inventory_Summary'[TotalLogicalDiskFreeTB])",
            "formatString": "#,0.0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Exchange Readiness Errors Trend",
            "expression": "MAX('Exchange_OnPrem_Servers_Inventory_Summary'[ExchangeReadinessErrors])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Protected Mailboxes",
            "expression": "DISTINCTCOUNT('M365_Backup_ProtectedMailboxes'[ProtectionUnitId])",
            "formatString": "#,0",
            "displayFolder": "Protection"
          },
          {
            "name": "Backup Scope Mailboxes",
            "expression": "DISTINCTCOUNT('M365_BackupPolicyScope_MailboxCoverage'[MemberId])",
            "formatString": "#,0",
            "displayFolder": "Protection"
          },
          {
            "name": "Protected Mailboxes in Scope",
            "expression": "VAR ProtectedIds=VALUES('M365_Backup_ProtectedMailboxes'[MailboxId]) RETURN CALCULATE(DISTINCTCOUNT('M365_BackupPolicyScope_MailboxCoverage'[MemberId]),TREATAS(ProtectedIds,'M365_BackupPolicyScope_MailboxCoverage'[MemberId]))",
            "formatString": "#,0",
            "displayFolder": "Protection"
          },
          {
            "name": "Backup Scope Gap",
            "expression": "[Backup Scope Mailboxes]-[Protected Mailboxes in Scope]",
            "formatString": "#,0",
            "displayFolder": "Protection"
          },
          {
            "name": "Backup Coverage Rate",
            "expression": "DIVIDE([Protected Mailboxes in Scope],[Backup Scope Mailboxes])",
            "formatString": "0.0%",
            "displayFolder": "Protection"
          },
          {
            "name": "Protected Mailboxes Outside Scope",
            "expression": "COUNTROWS(EXCEPT(VALUES('M365_Backup_ProtectedMailboxes'[MailboxId]),VALUES('M365_BackupPolicyScope_MailboxCoverage'[MemberId])))",
            "formatString": "#,0",
            "displayFolder": "Protection"
          },
          {
            "name": "Backup Coverage Warnings",
            "expression": "CALCULATE(COUNTROWS('M365_BackupPolicyScope_MailboxCoverage'),'M365_BackupPolicyScope_MailboxCoverage'[Status]<>\"OK\")",
            "formatString": "#,0",
            "displayFolder": "Protection"
          },
          {
            "name": "Teams",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Teams_Teams'[TeamId]),'M365_Teams_Teams'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "Inactive Teams",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Teams_Teams'[TeamId]),'M365_Teams_Teams'[__IsCurrent]=TRUE(),'M365_Teams_Teams'[InactiveDays]>90)",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "Active Teams Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Teams_UserActivity'[User Principal Name]),'M365_Teams_UserActivity'[__IsCurrent]=TRUE(),'M365_Teams_UserActivity'[Last Activity Date]<>BLANK())",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "Teams Storage Used TB",
            "expression": "DIVIDE(CALCULATE(SUM('M365_Teams_Teams'[StorageUsedGB]),'M365_Teams_Teams'[__IsCurrent]=TRUE()),1024)",
            "formatString": "#,0.0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Sites",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_SPO_Sites'[SiteUrl]),'M365_SPO_Sites'[__IsCurrent]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "Inactive SharePoint Sites",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_SPO_Sites'[SiteUrl]),'M365_SPO_Sites'[__IsCurrent]=TRUE(),'M365_SPO_Sites'[IsInactive]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "Orphaned SharePoint Sites",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_SPO_Sites'[SiteUrl]),'M365_SPO_Sites'[__IsCurrent]=TRUE(),'M365_SPO_Sites'[IsOrphaned]=TRUE())",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "External Sharing Signals",
            "expression": "COUNTROWS('M365_SPO_ExternalSharing')",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Storage Used TB",
            "expression": "CALCULATE(MAX('M365_SPO_Tenant'[StorageUsedTB]),'M365_SPO_Tenant'[__IsCurrent]=TRUE())",
            "formatString": "#,0.0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Storage License Units",
            "expression": "SUMX(FILTER('M365_Licenses_Tenant',VAR Sku=UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuPartNumber],\"\")) VAR SkuName=UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")) RETURN 'M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&NOT(CONTAINSSTRING(SkuName,\"FREE\"))&&NOT(CONTAINSSTRING(SkuName,\"TRIAL\"))&&NOT(CONTAINSSTRING(SkuName,\"DEVELOPER\"))&&NOT(Sku IN {\"SPE_F1\",\"SPE_F3\",\"STANDARDPACK_FACULTY\",\"STANDARDPACK_STUDENT\"})&&(Sku IN {\"SPE_E3\",\"SPE_E5\",\"ENTERPRISEPACK\",\"ENTERPRISEPREMIUM\",\"STANDARDPACK\",\"O365_BUSINESS_ESSENTIALS\",\"O365_BUSINESS_PREMIUM\",\"SPB\",\"SHAREPOINTSTANDARD\",\"SHAREPOINTENTERPRISE\"}||CONTAINSSTRING(SkuName,\"MICROSOFT 365 E3\")||CONTAINSSTRING(SkuName,\"MICROSOFT 365 E5\")||CONTAINSSTRING(SkuName,\"OFFICE 365 E1\")||CONTAINSSTRING(SkuName,\"OFFICE 365 E3\")||CONTAINSSTRING(SkuName,\"OFFICE 365 E5\")||CONTAINSSTRING(SkuName,\"BUSINESS BASIC\")||CONTAINSSTRING(SkuName,\"BUSINESS STANDARD\")||CONTAINSSTRING(SkuName,\"BUSINESS PREMIUM\")||CONTAINSSTRING(SkuName,\"SHAREPOINT ONLINE PLAN 1\")||CONTAINSSTRING(SkuName,\"SHAREPOINT ONLINE PLAN 2\")||CONTAINSSTRING(SkuName,\"TEAMS ESSENTIALS\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled])",
            "formatString": "#,0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Extra File Storage GB",
            "expression": "SUMX(FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&(CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuPartNumber],\"\")),\"SHAREPOINTSTORAGE\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"EXTRA FILE STORAGE\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled])",
            "formatString": "#,0.0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint OneDrive Standalone Storage GB",
            "expression": "0.5*SUMX(FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&(CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuPartNumber],\"\")),\"ONEDRIVE\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"ONEDRIVE\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled])",
            "formatString": "#,0.0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Estimated Capacity TB",
            "expression": "DIVIDE(1024+10*[SharePoint Storage License Units]+[SharePoint Extra File Storage GB]+[SharePoint OneDrive Standalone Storage GB],1024)",
            "formatString": "#,0.0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Estimated Remaining TB",
            "expression": "MAX(0,[SharePoint Estimated Capacity TB]-[SharePoint Storage Used TB])",
            "formatString": "#,0.0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Estimated Utilization",
            "expression": "DIVIDE([SharePoint Storage Used TB],[SharePoint Estimated Capacity TB])",
            "formatString": "0.0%",
            "displayFolder": "Collaboration"
          },
          {
            "name": "SharePoint Approx Project Visio Capacity TB",
            "expression": "DIVIDE(10*SUMX(FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&(CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"PROJECT PLAN 3\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"PROJECT PLAN 5\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"PROJECT ONLINE PREMIUM\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"VISIO PLAN 2\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled]),1024)",
            "formatString": "#,0.0",
            "displayFolder": "Collaboration"
          },
          {
            "name": "Endpoint Analytics Devices",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_EndpointAnalytics_DevicePerformance'[DeviceId]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "#,0",
            "displayFolder": "Experience"
          },
          {
            "name": "Endpoint Analytics Score",
            "expression": "CALCULATE(AVERAGE('Intune_EndpointAnalytics_DevicePerformance'[EndpointAnalyticsScore]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "0.0",
            "displayFolder": "Experience"
          },
          {
            "name": "Startup Score",
            "expression": "CALCULATE(AVERAGE('Intune_EndpointAnalytics_DevicePerformance'[StartupScore]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "0.0",
            "displayFolder": "Experience"
          },
          {
            "name": "App Reliability Score",
            "expression": "CALCULATE(AVERAGE('Intune_EndpointAnalytics_DevicePerformance'[AppReliabilityScore]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "0.0",
            "displayFolder": "Experience"
          },
          {
            "name": "Device Crashes",
            "expression": "CALCULATE(SUM('Intune_EndpointAnalytics_DevicePerformance'[CrashCount]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "#,0",
            "displayFolder": "Experience"
          },
          {
            "name": "Model Device Count",
            "expression": "CALCULATE(DISTINCTCOUNT('Intune_EndpointAnalytics_DevicePerformance'[DeviceId]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "#,0",
            "displayFolder": "Experience"
          },
          {
            "name": "Model Endpoint Analytics Score",
            "expression": "CALCULATE(AVERAGE('Intune_EndpointAnalytics_DevicePerformance'[EndpointAnalyticsScore]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "0.0",
            "displayFolder": "Experience"
          },
          {
            "name": "Model Startup Score",
            "expression": "CALCULATE(AVERAGE('Intune_EndpointAnalytics_DevicePerformance'[StartupScore]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "0.0",
            "displayFolder": "Experience"
          },
          {
            "name": "Model App Reliability Score",
            "expression": "CALCULATE(AVERAGE('Intune_EndpointAnalytics_DevicePerformance'[AppReliabilityScore]),'Intune_EndpointAnalytics_DevicePerformance'[__IsCurrent]=TRUE(),'Intune_EndpointAnalytics_DevicePerformance'[ReportName]=\"EADeviceScoresV2\")",
            "formatString": "0.0",
            "displayFolder": "Experience"
          },
          {
            "name": "Discovered Applications",
            "expression": "DISTINCTCOUNT('Intune_DiscoveredApps_Summary'[AppId])",
            "formatString": "#,0",
            "displayFolder": "Applications"
          },
          {
            "name": "Application Versions",
            "expression": "COUNTROWS('Intune_DiscoveredApps_Summary')",
            "formatString": "#,0",
            "displayFolder": "Applications"
          },
          {
            "name": "Devices per Application",
            "expression": "MAX('Intune_DiscoveredApps_Summary'[DeviceCount])",
            "formatString": "#,0",
            "displayFolder": "Applications"
          },
          {
            "name": "Copilot Active Users",
            "expression": "CALCULATE(DISTINCTCOUNT('M365_Copilot_UserUsage'[UserPrincipalName]),'M365_Copilot_UserUsage'[LastActivityDate]<>BLANK())",
            "formatString": "#,0",
            "displayFolder": "Adoption"
          },
          {
            "name": "AD Health Critical",
            "expression": "CALCULATE(COUNTROWS('AD_HealthCheck'),'AD_HealthCheck'[Status]=\"Critical\")",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "AD Health Warnings",
            "expression": "CALCULATE(COUNTROWS('AD_HealthCheck'),'AD_HealthCheck'[Status]=\"Warning\")",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "Selected Source Tables",
            "expression": "89",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "Source Columns",
            "expression": "2218",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "Historical Series",
            "expression": "14",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "Users Source Age Hours",
            "expression": "DATEDIFF(MAX('M365_Users_Active'[__SnapshotDateTime]),NOW(),HOUR)",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "Devices Source Age Hours",
            "expression": "DATEDIFF(MAX('Intune_Devices_Inventory'[__SnapshotDateTime]),NOW(),HOUR)",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "Licenses Source Age Hours",
            "expression": "DATEDIFF(MAX('M365_Licenses_Tenant'[__SnapshotDateTime]),NOW(),HOUR)",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "Exchange Source Age Hours",
            "expression": "DATEDIFF(MAX('Exchange_EXO_Mailboxes_AllDomains'[__SnapshotDateTime]),NOW(),HOUR)",
            "formatString": "#,0",
            "displayFolder": "Data Trust"
          },
          {
            "name": "AD Enabled Users Trend",
            "expression": "SUM('AD_Users_DailyStats'[EnabledUsers])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "AD Enabled Computers Trend",
            "expression": "SUM('AD_Computers_DailyStats'[EnabledAccounts])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "On-prem Mailboxes Trend",
            "expression": "SUM('Exchange_OnPrem_Mailboxes_DailyStats'[TotalMailboxCount])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Managed Devices Trend",
            "expression": "DISTINCTCOUNT('Intune_Devices_Inventory'[Device ID])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Consumed Licenses Trend",
            "expression": "SUM('M365_Licenses_Tenant'[TenantConsumedUnits])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Mailboxes Trend",
            "expression": "DISTINCTCOUNT('Exchange_EXO_Mailboxes_AllDomains'[MailboxGuid])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "Teams Trend",
            "expression": "DISTINCTCOUNT('M365_Teams_Teams'[TeamId])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          },
          {
            "name": "SharePoint Sites Trend",
            "expression": "DISTINCTCOUNT('M365_SPO_Sites'[SiteUrl])",
            "formatString": "#,0",
            "displayFolder": "Evolution"
          }
        ]
      },
