            "dataType": "string",
            "sourceColumn": "SourceName"
          },
          {
            "name": "FileName",
            "dataType": "string",
            "sourceColumn": "FileName"
          },
          {
            "name": "SourceRoot",
            "dataType": "string",
            "sourceColumn": "SourceRoot"
          },
          {
            "name": "LoadPriority",
            "dataType": "int64",
            "sourceColumn": "LoadPriority"
          }
        ],
        "partitions": [
          {
            "name": "SourceCatalog",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Source = #table(type table [SourceArea = text, SourceName = text, FileName = text, SourceRoot = text, LoadPriority = number], {{\"CMDB\", \"Tenant\", \"DimTenant.csv\", \"CMDBPowerBIPath\", 1}, {\"CMDB\", \"Users\", \"DimUser.csv\", \"CMDBPowerBIPath\", 1}, {\"CMDB\", \"Devices\", \"DimDevice.csv\", \"CMDBPowerBIPath\", 1}, {\"CMDB\", \"Licenses\", \"DimLicenseSku.csv\", \"CMDBPowerBIPath\", 1}, {\"CMDB\", \"Mailbox fact\", \"FactMailbox.csv\", \"CMDBPowerBIPath\", 1}, {\"SmartInventory\", \"Active users\", \"M365_Users_Active.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"Entra devices\", \"M365_Entra_Devices.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"Intune devices\", \"Intune_Devices_Inventory.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"Windows 11 readiness\", \"Intune_Devices_UpgradeEligibility.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"EXO mailboxes\", \"Exchange_EXO_Mailboxes_AllDomains.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"On-prem mailboxes\", \"Exchange_OnPrem_Mailboxes_AllDomains.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"License assignments\", \"M365_Licenses_Users.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"Backup protected mailboxes\", \"M365_Backup_ProtectedMailboxes.csv\", \"SmartInventoryLatestPath\", 2}, {\"SmartInventory\", \"Sync health\", \"M365_Entra_AzureADConnect_SyncHealth.csv\", \"SmartInventoryLatestPath\", 2}}), Output = Table.AddColumn(Source, \"TenantKey\", each TenantKey, type text) in Output"
            }
          }
        ]
      },
      {
        "name": "FactSourceFreshness",
        "columns": [
          {
            "name": "TenantKey",
            "dataType": "string",
            "sourceColumn": "TenantKey"
          },
          {
            "name": "SourceName",
            "dataType": "string",
            "sourceColumn": "SourceName"
          },
          {
            "name": "FileName",
            "dataType": "string",
            "sourceColumn": "FileName"
          },
          {
            "name": "Exists",
            "dataType": "boolean",
            "sourceColumn": "Exists"
          },
          {
            "name": "LastModifiedDateTime",
            "dataType": "dateTime",
            "sourceColumn": "LastModifiedDateTime"
          },
          {
            "name": "RowCount",
            "dataType": "int64",
            "sourceColumn": "RowCount"
          }
        ],
        "partitions": [
          {
            "name": "FactSourceFreshness",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let Rows = Table.ToRecords(SourceCatalog), Tables = List.Transform(Rows, each fnSourceFreshness(if [SourceRoot] = \"CMDBPowerBIPath\" then CMDBPowerBIPath else SmartInventoryLatestPath, [FileName], [SourceName])), Base = if List.Count(Tables) = 0 then #table(type table [SourceName = text, FileName = text, Exists = logical, LastModifiedDateTime = nullable datetime, RowCount = nullable number], {}) else Table.Combine(Tables), Output = Table.AddColumn(Base, \"TenantKey\", each TenantKey, type text) in Output"
            }
          }
        ]
      },
      {
        "name": "Measures",
        "columns": [
          {
            "name": "MeasureHost",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "MeasureHost"
          }
        ],
        "partitions": [
          {
            "name": "Measures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "#table(type table [MeasureHost = text], {{\"Measures\"}})"
            }
          }
        ],
        "measures": [
          {
            "name": "Users",
            "expression": "DISTINCTCOUNT(DimUser[TenantUserKey])",
            "formatString": "0"
          },
          {
            "name": "Enabled Users",
            "expression": "CALCULATE(DISTINCTCOUNT(DimUser[TenantUserKey]), DimUser[AccountEnabled] = TRUE())",
            "formatString": "0"
          },
          {
            "name": "Devices",
            "expression": "DISTINCTCOUNT(DimDevice[TenantDeviceKey])",
            "formatString": "0"
          },
          {
            "name": "Compliant Devices",
            "expression": "CALCULATE(DISTINCTCOUNT(FactDeviceCompliance[TenantDeviceKey]), FactDeviceCompliance[ComplianceState] = \"Compliant\")",
            "formatString": "0"
          },
          {
            "name": "Mailboxes",
            "expression": "DISTINCTCOUNT(FactMailbox[TenantMailboxKey])",
            "formatString": "0"
          },
          {
            "name": "Assigned Licenses",
            "expression": "COUNTROWS(FactUserLicense)",
            "formatString": "0"
          },
          {
            "name": "Enabled License Units",
            "expression": "SUM(DimLicenseSku[EnabledUnits])",
            "formatString": "0"
          },
          {
            "name": "Consumed License Units",
            "expression": "SUM(DimLicenseSku[ConsumedUnits])",
            "formatString": "0"
          },
          {
            "name": "Available License Units",
            "expression": "[Enabled License Units] - [Consumed License Units]",
            "formatString": "0"
          },
          {
            "name": "Data Quality Findings",
            "expression": "COUNTROWS(FactDataQuality)",
            "formatString": "0"
          },
          {
            "name": "Sources Expected",
            "expression": "COUNTROWS(SourceCatalog)",
            "formatString": "0"
          },
          {
            "name": "Sources Available",
            "expression": "CALCULATE(COUNTROWS(FactSourceFreshness), FactSourceFreshness[Exists] = TRUE())",
            "formatString": "0"
          },
          {
            "name": "Source Availability %",
            "expression": "DIVIDE([Sources Available], [Sources Expected])",
            "formatString": "0.0%"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "FactUserLicense_DimUser",
        "fromTable": "FactUserLicense",
        "fromColumn": "TenantUserKey",
        "toTable": "DimUser",
        "toColumn": "TenantUserKey"
      },
      {
        "name": "FactUserLicense_DimLicenseSku",
        "fromTable": "FactUserLicense",
        "fromColumn": "TenantSkuKey",
        "toTable": "DimLicenseSku",
        "toColumn": "TenantSkuKey"
      },
      {
        "name": "FactDeviceCompliance_DimDevice",
        "fromTable": "FactDeviceCompliance",
        "fromColumn": "TenantDeviceKey",
        "toTable": "DimDevice",
        "toColumn": "TenantDeviceKey"
      },
      {
        "name": "FactUserDeviceRelationship_DimUser",
        "fromTable": "FactUserDeviceRelationship",
        "fromColumn": "TenantUserKey",
        "toTable": "DimUser",
        "toColumn": "TenantUserKey"
      },
      {
        "name": "FactUserDeviceRelationship_DimDevice",
        "fromTable": "FactUserDeviceRelationship",
        "fromColumn": "TenantDeviceKey",
        "toTable": "DimDevice",
        "toColumn": "TenantDeviceKey"
      },
      {
        "name": "FactMailbox_DimUser",
        "fromTable": "FactMailbox",
        "fromColumn": "TenantUserKey",
        "toTable": "DimUser",
        "toColumn": "TenantUserKey"
      }
    ],
    "annotations": [
      {
        "name": "SmartWorkplaceDashboard.SourcePolicy",
        "value": "CMDB tables are curated; SmartInventory latest and weekly history provide operational state and trends."
      }
    ]
  }
}
