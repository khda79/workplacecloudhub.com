            "source": {
              "type": "m",
              "expression": "let Source = fnLoadCmdbTable(\"DimDate.csv\"), Output = Table.SelectColumns(Source, {\"Date\", \"Year\", \"Quarter\", \"Month\", \"MonthName\", \"Day\"}, MissingField.UseNull) in Output"
            }
