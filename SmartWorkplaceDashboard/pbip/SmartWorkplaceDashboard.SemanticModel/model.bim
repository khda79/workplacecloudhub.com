              "expression": "let Source=fnLoadSourceTable(\"Intune_Devices_Inventory.csv\", \",\", {\"TenantKey\", \"OrganizationKey\", \"EnvironmentKey\", \"TenantId\", \"Device ID\", \"Device name\", \"Enrollment date\", \"Last check-in\", \"LastSyncDateTime\", \"Intune registered\", \"Azure AD Device ID\", \"Azure AD registered\", \"OS\", \"OS version\", \"Manufacturer\", \"Model\", \"Serial number\", \"Supervised\", \"Encrypted\", \"Compliance\", \"IsCompliant\", \"Device state\", \"Managed by\", \"Ownership\", \"Primary user UPN\", \"Primary user email address\", \"Primary user display name\", \"UserId\", \"Registered owners\", \"EAS activation ID\", \"EAS activated\", \"Last EAS sync time\", \"EAS status\", \"EAS reason\", \"Total storage\", \"Free storage\", \"Management name\", \"Category\", \"PhysicalMemoryGB\", \"Entra ObjectId\", \"Entra DeviceId\", \"Entra DisplayName\", \"Entra ApproximateLastSignInDateTime\"}, {{\"Enrollment date\", \"datetime\"}, {\"Last check-in\", \"datetime\"}, {\"LastSyncDateTime\", \"datetime\"}, {\"Intune registered\", \"logical\"}, {\"Azure AD registered\", \"logical\"}, {\"Supervised\", \"logical\"}, {\"Encrypted\", \"logical\"}, {\"IsCompliant\", \"logical\"}, {\"EAS activated\", \"logical\"}, {\"Last EAS sync time\", \"datetime\"}, {\"Total storage\", \"number\"}, {\"Free storage\", \"number\"}, {\"PhysicalMemoryGB\", \"number\"}, {\"Entra ApproximateLastSignInDateTime\", \"datetime\"}}, true), WithWindowsVersion=Table.AddColumn(Source, \"WindowsVersionFamily\", each let OsName=if [OS]=null then \"\" else Text.Upper(Text.Trim(Text.From([OS]))), Parts=if [OS version]=null then {} else Text.Split(Text.From([OS version]),\".\"), Build=if List.Count(Parts)>2 then try Number.FromText(Parts{2}) otherwise null else null in if OsName<>\"WINDOWS\" then if [OS]=null then \"Unknown\" else Text.From([OS]) else if Build=null then \"Unknown\" else if Build>=22000 then \"Windows 11\" else \"Windows 10\", type text) in WithWindowsVersion",
              "type": "m"
            }
          }
        ]
