            "source": {
              "expression": [
                "let",
                " CleanText=(v as any) as nullable text => let t=if v=null then null else Text.Trim(Text.From(v)) in if t=null or t=\"\" then null else t,",
                " Norm=(v as any) as nullable text => let t=CleanText(v) in if t=null then null else Text.Lower(t),",
                " FirstText=(values as list) as nullable text => let usable=List.RemoveNulls(List.Transform(values,each CleanText(_))) in if List.Count(usable)=0 then null else usable{0},",
