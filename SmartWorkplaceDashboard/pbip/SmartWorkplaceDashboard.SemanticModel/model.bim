          {
            "name": "SharePoint Storage License Units",
            "displayFolder": "Collaboration",
            "expression": "SUMX(FILTER('M365_Licenses_Tenant',VAR Sku=UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuPartNumber],\"\")) VAR SkuName=UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")) RETURN 'M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&NOT(CONTAINSSTRING(SkuName,\"FREE\"))&&NOT(CONTAINSSTRING(SkuName,\"TRIAL\"))&&NOT(CONTAINSSTRING(SkuName,\"DEVELOPER\"))&&NOT(Sku IN {\"SPE_F1\",\"SPE_F3\",\"STANDARDPACK_FACULTY\",\"STANDARDPACK_STUDENT\"})&&(Sku IN {\"SPE_E3\",\"SPE_E5\",\"ENTERPRISEPACK\",\"ENTERPRISEPREMIUM\",\"STANDARDPACK\",\"O365_BUSINESS_ESSENTIALS\",\"O365_BUSINESS_PREMIUM\",\"SPB\",\"SHAREPOINTSTANDARD\",\"SHAREPOINTENTERPRISE\"}||CONTAINSSTRING(SkuName,\"MICROSOFT 365 E3\")||CONTAINSSTRING(SkuName,\"MICROSOFT 365 E5\")||CONTAINSSTRING(SkuName,\"OFFICE 365 E1\")||CONTAINSSTRING(SkuName,\"OFFICE 365 E3\")||CONTAINSSTRING(SkuName,\"OFFICE 365 E5\")||CONTAINSSTRING(SkuName,\"BUSINESS BASIC\")||CONTAINSSTRING(SkuName,\"BUSINESS STANDARD\")||CONTAINSSTRING(SkuName,\"BUSINESS PREMIUM\")||CONTAINSSTRING(SkuName,\"SHAREPOINT ONLINE PLAN 1\")||CONTAINSSTRING(SkuName,\"SHAREPOINT ONLINE PLAN 2\")||CONTAINSSTRING(SkuName,\"TEAMS ESSENTIALS\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled])",
            "formatString": "#,0.0",
            "lineageTag": "aaed00a7-88f2-4d9d-aab6-dfce790fb087"
          },
          {
            "name": "SharePoint Extra File Storage GB",
            "displayFolder": "Collaboration",
            "expression": "SUMX(FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&(CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuPartNumber],\"\")),\"SHAREPOINTSTORAGE\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"EXTRA FILE STORAGE\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled])",
            "formatString": "#,0.0",
            "lineageTag": "4fa7d789-58f2-48aa-9f0f-f24550c9a610"
          },
          {
            "name": "SharePoint OneDrive Standalone Storage GB",
            "displayFolder": "Collaboration",
            "expression": "0.5*SUMX(FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&(CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuPartNumber],\"\")),\"ONEDRIVE\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"ONEDRIVE\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled])",
            "formatString": "#,0.0",
            "lineageTag": "87c67a37-fe00-4a55-9e71-a10d93cc1789"
          },
          {
            "name": "SharePoint Estimated Capacity TB",
            "displayFolder": "Collaboration",
            "expression": "VAR _LicenseRows=FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()) RETURN IF(COUNTROWS(_LicenseRows)=0||COUNTROWS(FILTER(_LicenseRows,ISBLANK('M365_Licenses_Tenant'[TenantPrepaidEnabled])||'M365_Licenses_Tenant'[TenantPrepaidEnabled]<0))>0,BLANK(),DIVIDE(1024+10*[SharePoint Storage License Units]+[SharePoint Extra File Storage GB]+[SharePoint OneDrive Standalone Storage GB],1024))",
            "formatString": "#,0.0",
            "lineageTag": "6d403ba8-c3b6-4361-8098-8a0b5c74fe82"
          },
          {
            "name": "SharePoint Estimated Remaining TB",
            "displayFolder": "Collaboration",
            "expression": "IF(ISBLANK([SharePoint Estimated Capacity TB])||ISBLANK([SharePoint Storage Used TB]),BLANK(),MAX(0,[SharePoint Estimated Capacity TB]-[SharePoint Storage Used TB]))",
            "formatString": "#,0.0",
            "lineageTag": "05448e36-2aae-4dcb-879e-bf7dc2c54f78"
          },
          {
            "name": "SharePoint Estimated Utilization",
            "displayFolder": "Collaboration",
            "expression": "DIVIDE([SharePoint Storage Used TB],[SharePoint Estimated Capacity TB])",
            "formatString": "0.0%",
            "lineageTag": "698f15d2-2f8a-4f0d-ac3d-5af4491d0499"
          },
          {
            "name": "SharePoint Approx Project Visio Capacity TB",
            "displayFolder": "Collaboration",
            "expression": "DIVIDE(10*SUMX(FILTER('M365_Licenses_Tenant','M365_Licenses_Tenant'[__IsCurrent]=TRUE()&&(CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"PROJECT PLAN 3\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"PROJECT PLAN 5\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"PROJECT ONLINE PREMIUM\")||CONTAINSSTRING(UPPER(COALESCE('M365_Licenses_Tenant'[TenantSkuDisplayName],\"\")),\"VISIO PLAN 2\"))),'M365_Licenses_Tenant'[TenantPrepaidEnabled]),1024)",
            "formatString": "#,0.0",
