                " WithServiceAccount=Table.AddColumn(WithOnPremSync,\"IsLikelyServiceAccount\",each fnToLogical([A_IsLikelyServiceAccount]),type nullable logical),",
                " WithLicense=Table.AddColumn(WithServiceAccount,\"LicenseSummary\",each let v=FirstText({[A_M365LicenseName],[A_M365LicenseType],[E_Licenses]}) in if v=null then \"Unlicensed / not identified\" else v,type text),",
                " WithPlacement=Table.AddColumn(WithLicense,\"MailboxPlacement\",each if [InExchangeOnPrem] and [InExchangeOnline] then \"On-premises + Online\" else if [InExchangeOnline] then \"Exchange Online\" else if [InExchangeOnPrem] then \"Exchange On-premises\" else \"No mailbox\",type text),",
                " WithEXOType=Table.AddColumn(WithPlacement,\"EXOMailboxType\",each FirstText({[X_MailboxType],[X_RecipientTypeDetails]}),type nullable text),",
                " WithOnPremType=Table.AddColumn(WithEXOType,\"OnPremMailboxType\",each CleanText([O_RecipientType]),type nullable text),",
                " WithEXOSize=Table.AddColumn(WithOnPremType,\"EXOMailboxSizeGB\",each fnToNumber([X_SizeGB]),type nullable number),",
                " WithOnPremSize=Table.AddColumn(WithEXOSize,\"OnPremMailboxSizeGB\",each let n=fnToNumber([O_SizeMB]) in if n=null then null else n/1024,type nullable number),",
                " WithTotalSize=Table.AddColumn(WithOnPremSize,\"TotalMailboxSizeGB\",each List.Sum(List.RemoveNulls({[EXOMailboxSizeGB],[OnPremMailboxSizeGB]})),type number),",
                " WithArchiveSize=Table.AddColumn(WithTotalSize,\"ArchiveMailboxSizeGB\",each let n=fnToNumber([O_ArchiveSizeMB]) in if n=null then null else n/1024,type nullable number),",
                " WithItemCount=Table.AddColumn(WithArchiveSize,\"MailboxItemCount\",each let values=List.RemoveNulls({fnToInt64([X_ItemCount]),fnToInt64([O_ItemCount])}) in if List.Count(values)=0 then null else List.Sum(values),Int64.Type),",
                " WithADLastLogon=Table.AddColumn(WithItemCount,\"ADLastLogonDateTime\",each MaxDate({[A_ResolvedLastActivity],[A_LastLogon]}),type nullable datetime),",
                " WithEntraLastSignIn=Table.AddColumn(WithADLastLogon,\"EntraLastSignInDateTime\",each MaxDate({[E_LastSignIn],[E_LastNonInteractiveSignIn]}),type nullable datetime),",
                " WithEXOLastAction=Table.AddColumn(WithEntraLastSignIn,\"EXOLastUserActionDateTime\",each MaxDate({[X_LastUserAction],[X_LastLogon]}),type nullable datetime),",
                " WithOnPremLastLogon=Table.AddColumn(WithEXOLastAction,\"OnPremLastLogonDateTime\",each fnToDateTime([O_LastLogon]),type nullable datetime),",
                " WithLastActivity=Table.AddColumn(WithOnPremLastLogon,\"LastActivityDateTime\",each MaxDate({[ADLastLogonDateTime],[EntraLastSignInDateTime],[EXOLastUserActionDateTime],[OnPremLastLogonDateTime]}),type nullable datetime),",
                " WithDays=Table.AddColumn(WithLastActivity,\"DaysSinceLastActivity\",each if [LastActivityDateTime]=null or [LastActivityDateTime]>DateTime.LocalNow() then null else Duration.Days(DateTime.LocalNow()-[LastActivityDateTime]),Int64.Type),",
                " WithActivity=Table.AddColumn(WithDays,\"ActivityBucket\",each if [DaysSinceLastActivity]=null then \"Unknown\" else if [DaysSinceLastActivity]<=30 then \"Active <= 30d\" else if [DaysSinceLastActivity]<=90 then \"Inactive 31-90d\" else \"Inactive > 90d\",type text),",
                " WithSeverity=Table.AddColumn(WithActivity,\"ActionSeverity\",each if Text.Contains([IdentityMatchStatus],\"conflicting\",Comparer.OrdinalIgnoreCase) or [AccountStatus]=\"Conflict\" then \"Critical\" else if ([IsEnabled]=true and [DaysSinceLastActivity]<>null and [DaysSinceLastActivity]>90) or ([InAD] and not [InEntra]) or ([InExchangeOnPrem] and [InExchangeOnline]) or (not [InAD] and not [InEntra]) then \"Warning\" else if [DaysSinceLastActivity]=null then \"Unknown\" else \"Healthy\",type text),",
                " WithPriority=Table.AddColumn(WithSeverity,\"ActionPriority\",each if [ActionSeverity]=\"Critical\" then 1 else if [ActionSeverity]=\"Warning\" then 2 else 3,Int64.Type),",
                " WithActionRequired=Table.AddColumn(WithPriority,\"ActionRequired\",each [ActionSeverity]<>\"Healthy\",type logical),",
                " WithRecommendedAction=Table.AddColumn(WithActionRequired,\"RecommendedAction\",each if [ActionSeverity]=\"Unknown\" then \"Review missing or future activity evidence\" else if [IdentityMatchStatus]=\"Matched Entra; conflicting UPN\" then \"Reconcile UPN with concordant immutable ID and SID\" else if [IdentityMatchStatus]=\"Conflicting exact identifiers\" then \"Resolve conflicting immutable ID, SID or UPN mapping\" else if [AccountStatus]=\"Conflict\" then \"Reconcile AD and Entra account status\" else if [IsEnabled]=true and [DaysSinceLastActivity]<>null and [DaysSinceLastActivity]>90 then \"Review enabled inactive account\" else if [InAD] and not [InEntra] then \"Investigate AD identity missing from Entra\" else if [InExchangeOnPrem] and [InExchangeOnline] then \"Validate coexistence or migration mailbox placement\" else if not [InAD] and not [InEntra] then \"Investigate mailbox without identity inventory\" else \"No immediate action\",type text),",
                " Result=Table.SelectColumns(WithRecommendedAction,{\"CanonicalUserKey\",\"DisplayName\",\"UserPrincipalName\",\"PrimarySmtpAddress\",\"Country\",\"Department\",\"Title\",\"Company\",\"Office\",\"Manager\",\"SourceCoverage\",\"IdentityMatchStatus\",\"HybridIdentityType\",\"InAD\",\"InEntra\",\"InExchangeOnPrem\",\"InExchangeOnline\",\"ADObjectGUID\",\"EntraObjectId\",\"OnPremExchangeGuid\",\"EXOMailboxGuid\",\"ADDomain\",\"ADOrganizationalUnit\",\"ADAccountEnabled\",\"EntraAccountEnabled\",\"IsEnabled\",\"AccountStatus\",\"UserType\",\"DirSyncEnabled\",\"OnPremisesSyncEnabled\",\"IsLikelyServiceAccount\",\"LicenseSummary\",\"MailboxPlacement\",\"EXOMailboxType\",\"OnPremMailboxType\",\"EXOMailboxSizeGB\",\"OnPremMailboxSizeGB\",\"TotalMailboxSizeGB\",\"ArchiveMailboxSizeGB\",\"MailboxItemCount\",\"ADLastLogonDateTime\",\"EntraLastSignInDateTime\",\"EXOLastUserActionDateTime\",\"OnPremLastLogonDateTime\",\"LastActivityDateTime\",\"DaysSinceLastActivity\",\"ActivityBucket\",\"ActionSeverity\",\"ActionPriority\",\"ActionRequired\",\"RecommendedAction\"})",
                "in Result"
              ],
              "type": "m"
            }
          }
        ]
      }
    ]
  }
}