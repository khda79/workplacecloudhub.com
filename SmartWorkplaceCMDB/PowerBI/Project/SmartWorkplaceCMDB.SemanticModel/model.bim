            "variations": [
              {
                "name": "Variation",
                "relationship": "4d997631-b344-47d3-8aa9-4f369ecdab40",
                "defaultHierarchy": {
                  "table": "LocalDateTable_e858f09e-e4f7-4f88-bf31-53a9580e4302",
                  "hierarchy": "Date Hierarchy"
                },
                "isDefault": true
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Tenant Intune device key",
            "dataType": "string",
            "description": "Exact lookup of the native managed-device ID within its tenant to the prepared bridge key. Unresolved weekly relations remain blank without a fabricated parent.",
            "expression": "LOOKUPVALUE ( 'DimIntuneManagedDevice'[TenantIntuneDeviceKey], 'DimIntuneManagedDevice'[ManagedDeviceId], 'FactDeviceApplication'[ManagedDeviceId], 'DimIntuneManagedDevice'[TenantKey], 'FactDeviceApplication'[TenantKey] )",
            "lineageTag": "1688a97a-3143-43b6-84f7-3bb610326096",
            "summarizeBy": "none"
          },
          {
            "name": "ApplicationLinkStatus",
            "dataType": "string",
            "sourceColumn": "ApplicationLinkStatus",
            "lineageTag": "fcd96aa3-db5b-415c-9e77-644f7cbad81d",
            "summarizeBy": "none"
          },
          {
            "name": "DeviceLinkStatus",
            "dataType": "string",
            "sourceColumn": "DeviceLinkStatus",
            "lineageTag": "0fe453a7-2036-4aa2-a531-88dcee180d4a",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "FactDeviceApplication",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactDeviceApplication\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantDeviceApplicationKey\", dataType=\"String\"], [name=\"TenantApplicationKey\", dataType=\"String\"], [name=\"ManagedDeviceId\", dataType=\"String\"], [name=\"AppId\", dataType=\"String\"], [name=\"ApplicationLinkStatus\", dataType=\"String\"], [name=\"DeviceLinkStatus\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Installed application products",
            "description": "Distinct normalized installed products in the selected native application evidence, respecting the resolved fleet and Country scope.",
            "expression": "VAR _countries = VALUES ( 'DimCountry'[CountryLabel] )\nRETURN\nIF ( ISCROSSFILTERED ( 'DimCountry' ),\n    VAR _countryApps = CALCULATETABLE ( VALUES ( 'FactDeviceApplication'[TenantApplicationKey] ), KEEPFILTERS ( TREATAS ( _countries, 'DimDevice'[CountryLabel] ) ) )\n    RETURN CALCULATE ( DISTINCTCOUNT ( 'DimDetectedApplication'[Application product key] ), KEEPFILTERS ( TREATAS ( _countryApps, 'DimDetectedApplication'[TenantApplicationKey] ) ) ),\n    VAR _scopeApps = VALUES ( 'FactDeviceApplication'[TenantApplicationKey] )\n    RETURN CALCULATE ( DISTINCTCOUNT ( 'DimDetectedApplication'[Application product key] ), KEEPFILTERS ( TREATAS ( _scopeApps, 'DimDetectedApplication'[TenantApplicationKey] ) ) ) )",
            "formatString": "#,0",
            "lineageTag": "40a9bf42-04e7-43bd-9f3f-cf62431ee20f"
          },
          {
            "name": "Application-device installations",
            "description": "Native application-version/device relations, not distinct products or distinct fleet devices. Unresolved native evidence remains in global scope.",
            "expression": "VAR _countries = VALUES ( 'DimCountry'[CountryLabel] )\nRETURN IF ( ISCROSSFILTERED ( 'DimCountry' ), CALCULATE ( COUNTROWS ( 'FactDeviceApplication' ), KEEPFILTERS ( TREATAS ( _countries, 'DimDevice'[CountryLabel] ) ) ), COUNTROWS ( 'FactDeviceApplication' ) )",
            "formatString": "#,0",
            "lineageTag": "d6d7560d-d63f-41f8-8b34-a25bdca5812c"
          },
          {
            "name": "Devices reporting applications",
            "description": "Distinct managed-device IDs in native weekly application evidence. Global scope retains unresolved IDs; Country/ownership scope requires a resolved device.",
            "expression": "VAR _countries = VALUES ( 'DimCountry'[CountryLabel] )\nRETURN IF ( ISCROSSFILTERED ( 'DimCountry' ), CALCULATE ( DISTINCTCOUNT ( 'FactDeviceApplication'[ManagedDeviceId] ), KEEPFILTERS ( TREATAS ( _countries, 'DimDevice'[CountryLabel] ) ) ), DISTINCTCOUNT ( 'FactDeviceApplication'[ManagedDeviceId] ) )",
            "formatString": "#,0",
            "lineageTag": "69690fa3-69df-4c25-ab68-2f39fa66c613"
          },
          {
            "name": "Application device rate",
            "description": "Share of distinct reporting-device IDs for this product, over reporting-device IDs across all products in the same fleet scope. Product shares are not additive.",
            "expression": "DIVIDE ( [Devices reporting applications], CALCULATE ( [Devices reporting applications], REMOVEFILTERS ( 'DimDetectedApplication' ) ) )",
            "formatString": "0.0%",
            "lineageTag": "1bd2f6e6-d960-4bfd-a1ea-d8bbe067182c"
          }
        ]
      },
