        "partitions": [
          {
            "name": "FactMailboxHosting",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactMailboxHosting\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"MailboxHostingKey\", dataType=\"String\"], [name=\"CountryLabel\", dataType=\"String\"], [name=\"HostingLocation\", dataType=\"String\"], [name=\"RecipientTypeDetails\", dataType=\"String\"], [name=\"MailboxTypeGroup\", dataType=\"String\"], [name=\"EvidenceSource\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Hosted mailboxes",
            "description": "Distinct mailbox addresses after reconciliation of Exchange Online, RemoteMailbox and local Mailbox evidence.",
            "expression": "COALESCE(COUNTROWS('FactMailboxHosting'), 0)",
            "formatString": "#,0",
            "lineageTag": "dc6a4bad-2fad-429e-b2c0-17418b4a49f1"
          },
          {
            "name": "Exchange Online mailboxes",
            "description": "Mailboxes observed in Exchange Online or as RemoteMailbox; duplicate addresses are counted once.",
            "expression": "CALCULATE([Hosted mailboxes], KEEPFILTERS('FactMailboxHosting'[HostingLocation] == \"Exchange Online\"))",
            "formatString": "#,0",
            "lineageTag": "1153f307-700a-4be5-8bde-a185f798b426"
          },
          {
            "name": "Exchange On-premises mailboxes",
            "description": "Local Mailbox recipients not already observed as Exchange Online or RemoteMailbox; duplicate addresses are counted once.",
            "expression": "CALCULATE([Hosted mailboxes], KEEPFILTERS('FactMailboxHosting'[HostingLocation] == \"Exchange On-premises\"))",
            "formatString": "#,0",
            "lineageTag": "43939841-d21d-487e-bb21-0e66eb3262fc"
          },
          {
            "name": "Exchange Online share",
            "description": "Exchange Online mailboxes divided by the reconciled mailbox footprint.",
            "expression": "DIVIDE([Exchange Online mailboxes], [Hosted mailboxes])",
            "formatString": "0.0%",
            "lineageTag": "7f3b7796-da3a-4fc7-8c3f-f9d71bc2d99d"
          },
          {
            "name": "Exchange On-premises share",
            "description": "Exchange On-premises mailboxes divided by the reconciled mailbox footprint.",
            "expression": "DIVIDE([Exchange On-premises mailboxes], [Hosted mailboxes])",
            "formatString": "0.0%",
            "lineageTag": "24389303-b1fc-4b99-878c-0e5dd67a663a"
          },
          {
            "name": "User mailboxes",
            "description": "UserMailbox and RemoteUserMailbox recipients after mailbox-hosting reconciliation.",
            "expression": "CALCULATE([Hosted mailboxes], KEEPFILTERS('FactMailboxHosting'[MailboxTypeGroup] == \"User mailbox\"))",
            "formatString": "#,0",
            "lineageTag": "a4d7d48c-f109-4721-ac61-d891f32a41d3"
          },
          {
            "name": "Shared mailboxes",
            "description": "SharedMailbox and RemoteSharedMailbox recipients after mailbox-hosting reconciliation.",
            "expression": "CALCULATE([Hosted mailboxes], KEEPFILTERS('FactMailboxHosting'[MailboxTypeGroup] == \"Shared mailbox\"))",
            "formatString": "#,0",
            "lineageTag": "0396caf2-3d96-40da-993e-d1fb6675c3c8"
          },
          {
            "name": "Other mailbox types",
            "description": "Room, scheduling, discovery and other recipient types after mailbox-hosting reconciliation.",
            "expression": "CALCULATE([Hosted mailboxes], KEEPFILTERS('FactMailboxHosting'[MailboxTypeGroup] == \"Other mailbox types\"))",
            "formatString": "#,0",
            "lineageTag": "d3762144-1b60-4bd4-927e-6d27f20ecc0a"
          },
          {
            "name": "User mailbox share",
            "description": "User mailbox family divided by all reconciled mailboxes.",
            "expression": "DIVIDE([User mailboxes], [Hosted mailboxes])",
            "formatString": "0.0%",
            "lineageTag": "ff0e1677-7192-4158-8f93-5acd3482e964"
          },
          {
            "name": "Shared mailbox share",
            "description": "Shared mailbox family divided by all reconciled mailboxes.",
            "expression": "DIVIDE([Shared mailboxes], [Hosted mailboxes])",
            "formatString": "0.0%",
            "lineageTag": "621d1491-1b10-4743-9bdc-5c0822791626"
          },
          {
            "name": "Other mailbox type share",
            "description": "Other mailbox types divided by all reconciled mailboxes.",
            "expression": "DIVIDE([Other mailbox types], [Hosted mailboxes])",
            "formatString": "0.0%",
            "lineageTag": "8ec53288-7435-4d83-aea8-38818ec332a1"
          },
          {
            "name": "Mailbox type share",
            "description": "Share of the current mailbox-type category within the filtered reconciled mailbox population.",
            "expression": "DIVIDE([Hosted mailboxes], CALCULATE([Hosted mailboxes], REMOVEFILTERS('FactMailboxHosting'[MailboxTypeGroup])))",
            "formatString": "0.0%",
            "lineageTag": "b7cdc366-bb7c-4a20-98cc-7bb8db487a57"
          },
          {
            "name": "Mailbox hosting rate",
            "description": "Share of each mailbox-hosting location within the filtered reconciled mailbox population.",
            "expression": "DIVIDE([Hosted mailboxes], CALCULATE([Hosted mailboxes], REMOVEFILTERS('FactMailboxHosting'[HostingLocation])))",
            "formatString": "0.0%",
            "lineageTag": "d9ac2d90-dfc6-49c0-9b48-d00ce222ca51"
          }
        ]
      },
