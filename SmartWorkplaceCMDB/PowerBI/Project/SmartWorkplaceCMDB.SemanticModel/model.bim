            "expression": "CALCULATE([License Report Recovery Candidates], 'License Report Summary'[Product] = \"Microsoft 365 E5\")",
            "formatString": "#,0",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "106c29d6-9ba1-4f10-b6dd-023573235243"
          },
          {
            "name": "License Report F3/F1 Recovery Candidates",
            "expression": "VAR _f1 = [License Report F1 Recovery Candidates] VAR _f3 = [License Report F3 Recovery Candidates] RETURN IF(ISBLANK(_f1) || ISBLANK(_f3), BLANK(), _f1 + _f3)",
            "formatString": "#,0",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "f63f3ba1-de1f-4013-b52e-b52e50d155df"
          },
          {
            "name": "License Report Evidence Status",
            "expression": "VAR _unknown = CALCULATE(COUNTROWS('License Report Summary'), 'License Report Summary'[EvidenceStatus] = \"N/D\") VAR _provisional = CALCULATE(COUNTROWS('License Report Summary'), 'License Report Summary'[EvidenceStatus] = \"Provisional\") RETURN IF([License Report Snapshot Consistent] <> 1, \"Snapshot mismatch\", IF(_unknown > 0, \"N/D\", IF(_provisional > 0, \"Provisional\", \"Qualified\")))",
            "formatString": "@",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "d1e8263d-800e-4d45-a76f-5567ad636dcf"
          },
          {
            "name": "License Report Available (%)",
            "expression": "IF([License Report Snapshot Consistent] = 1, DIVIDE(SUM('License Report Summary'[AvailableUnits]), SUM('License Report Summary'[EnabledUnits])))",
            "formatString": "0.0%",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "a002cb52-6327-4fb2-bdbc-5e647cb10b33"
          },
          {
            "name": "License Report Subscription Status",
            "expression": "IF(SELECTEDVALUE('License Report Summary'[Subscribed]) = \"True\", \"Subscribed\", \"Not subscribed\")",
            "formatString": "@",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "15158f23-cfb5-46e3-8c10-ba59cd21e6ba"
          },
          {
            "name": "License Report F1 Utilization Label",
            "expression": "VAR _enabled = CALCULATE(SUM('License Report Summary'[EnabledUnits]), 'License Report Summary'[Product] = \"Microsoft 365 F1\") VAR _used = [License Report F1 Used (%)] RETURN IF([License Report Snapshot Consistent] <> 1, \"N/D\", IF(_enabled <= 0, \"N/A\", FORMAT(_used, \"0.0%\")))",
