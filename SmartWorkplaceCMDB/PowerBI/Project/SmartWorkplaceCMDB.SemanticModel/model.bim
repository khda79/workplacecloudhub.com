          {
            "name": "Selected Endpoint Analytics score",
            "description": "Average Endpoint Analytics score for exact Intune device identifiers in the filtered device population.",
            "expression": "VAR _deviceKeys = VALUES('DimDevice'[TenantDeviceKey]) VAR _intuneIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_deviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) RETURN CALCULATE(AVERAGE('FactEndpointAnalyticsDevice'[EndpointAnalyticsScore]), TREATAS(_intuneIds, 'FactEndpointAnalyticsDevice'[DeviceId]))",
            "formatString": "0.0",
            "lineageTag": "fa3e4d1e-a6ea-409f-8081-6975143ef585"
          },
          {
            "name": "Selected startup performance score",
            "description": "Average startup score for exact Intune device identifiers in the filtered device population.",
            "expression": "VAR _deviceKeys = VALUES('DimDevice'[TenantDeviceKey]) VAR _intuneIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_deviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) RETURN CALCULATE(AVERAGE('FactEndpointAnalyticsDevice'[StartupPerformanceScore]), TREATAS(_intuneIds, 'FactEndpointAnalyticsDevice'[DeviceId]))",
            "formatString": "0.0",
            "lineageTag": "a46b5f51-992c-4617-a980-de4f890fbe25"
          },
          {
            "name": "Selected app reliability score",
            "description": "Average app reliability score for exact Intune device identifiers in the filtered device population.",
            "expression": "VAR _deviceKeys = VALUES('DimDevice'[TenantDeviceKey]) VAR _intuneIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_deviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) RETURN CALCULATE(AVERAGE('FactEndpointAnalyticsDevice'[AppReliabilityScore]), TREATAS(_intuneIds, 'FactEndpointAnalyticsDevice'[DeviceId]))",
            "formatString": "0.0",
            "lineageTag": "1ec3743e-1898-4c80-97af-cde777ff297a"
          },
          {
            "name": "Selected work from anywhere score",
            "description": "Average work-from-anywhere score for exact Intune device identifiers in the filtered device population.",
            "expression": "VAR _deviceKeys = VALUES('DimDevice'[TenantDeviceKey]) VAR _intuneIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_deviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) RETURN CALCULATE(AVERAGE('FactEndpointAnalyticsDevice'[WorkFromAnywhereScore]), TREATAS(_intuneIds, 'FactEndpointAnalyticsDevice'[DeviceId]))",
            "formatString": "0.0",
            "lineageTag": "21a3e7b0-b089-41e2-b32f-b9fc6e9f45ea"
          }
        ]
