          }
        ],
        "partitions": [
          {
            "name": "License Report Summary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBReadLicenseReportCsv(\"M365_Licenses_ReportSummary.csv\", {\"SnapshotId\", \"TenantKey\", \"GeneratedAtUtc\", \"LicenseCollectedAtUtc\", \"Product\", \"Category\", \"EnabledUnits\", \"ConsumedUnits\", \"AvailableUnits\", \"Subscribed\", \"AssignedUsers\", \"RecoveryCandidates\", \"RecoveryUnknown\", \"DisabledUsers\", \"DisabledUnknown\", \"NoM365Activity\", \"NoM365ActivityUnknown\", \"MultipleTargetSuites\", \"MultipleTargetSuitesUnknown\", \"MultipleAssignedSkus\", \"MultipleAssignedSkusUnknown\", \"NoAdOrEntraActivity\", \"NoAdOrEntraActivityUnknown\", \"NoMailboxActivity\", \"NoMailboxActivityUnknown\", \"NoLocalAppsUse\", \"NoLocalAppsUseUnknown\", \"CandidatesPrimaryIntunePc\", \"CandidatesPrimaryIntunePcUnknown\", \"SharedMailboxesLicensed\", \"SharedUnder50Gb\", \"SharedRemovalCandidates\", \"SharedUnknown\", \"E3ToF3ReviewAssigned\", \"E3ToF3ReviewCandidates\", \"E3ToF3ReviewUnknown\", \"E3ToF3ReviewExcluded\", \"E3ToF3ReviewRecoveryExcluded\", \"EvidenceStatus\", \"WorkbookQualification\"}, {{\"SnapshotId\", type text}, {\"TenantKey\", type text}, {\"GeneratedAtUtc\", type text}, {\"LicenseCollectedAtUtc\", type text}, {\"Product\", type text}, {\"Category\", type text}, {\"EnabledUnits\", Int64.Type}, {\"ConsumedUnits\", Int64.Type}, {\"AvailableUnits\", Int64.Type}, {\"Subscribed\", type text}, {\"AssignedUsers\", Int64.Type}, {\"RecoveryCandidates\", Int64.Type}, {\"RecoveryUnknown\", Int64.Type}, {\"DisabledUsers\", Int64.Type}, {\"DisabledUnknown\", Int64.Type}, {\"NoM365Activity\", Int64.Type}, {\"NoM365ActivityUnknown\", Int64.Type}, {\"MultipleTargetSuites\", Int64.Type}, {\"MultipleTargetSuitesUnknown\", Int64.Type}, {\"MultipleAssignedSkus\", Int64.Type}, {\"MultipleAssignedSkusUnknown\", Int64.Type}, {\"NoAdOrEntraActivity\", Int64.Type}, {\"NoAdOrEntraActivityUnknown\", Int64.Type}, {\"NoMailboxActivity\", Int64.Type}, {\"NoMailboxActivityUnknown\", Int64.Type}, {\"NoLocalAppsUse\", Int64.Type}, {\"NoLocalAppsUseUnknown\", Int64.Type}, {\"CandidatesPrimaryIntunePc\", Int64.Type}, {\"CandidatesPrimaryIntunePcUnknown\", Int64.Type}, {\"SharedMailboxesLicensed\", Int64.Type}, {\"SharedUnder50Gb\", Int64.Type}, {\"SharedRemovalCandidates\", Int64.Type}, {\"SharedUnknown\", Int64.Type}, {\"E3ToF3ReviewAssigned\", Int64.Type}, {\"E3ToF3ReviewCandidates\", Int64.Type}, {\"E3ToF3ReviewUnknown\", Int64.Type}, {\"E3ToF3ReviewExcluded\", Int64.Type}, {\"E3ToF3ReviewRecoveryExcluded\", Int64.Type}, {\"EvidenceStatus\", type text}, {\"WorkbookQualification\", type text}})"
            }
          }
        ],
        "measures": [
          {
            "name": "License Report Snapshot Consistent",
            "description": "1 when the imported snapshot IDs and candidate row counts match the daily email; an empty candidate table is valid only when both counts are zero.",
            "expression": "VAR _summary = CALCULATE(SELECTEDVALUE('License Report Summary'[SnapshotId]), REMOVEFILTERS('License Report Summary'))\nVAR _detailRows = COALESCE(CALCULATE(COUNTROWS('License Report Candidates'), REMOVEFILTERS('License Report Candidates')), 0)\nVAR _detailSnapshot = CALCULATE(SELECTEDVALUE('License Report Candidates'[SnapshotId]), REMOVEFILTERS('License Report Candidates'))\nVAR _gaps = CALCULATE(SELECTEDVALUE('License Report Gaps'[SnapshotId]), REMOVEFILTERS('License Report Gaps'))\nVAR _sources = CALCULATE(SELECTEDVALUE('License Report Sources'[SnapshotId]), REMOVEFILTERS('License Report Sources'))\nVAR _recoveryKpi = CALCULATE(SUM('License Report Summary'[RecoveryCandidates]), REMOVEFILTERS('License Report Summary'))\nVAR _recoveryRows = COALESCE(CALCULATE(COUNTROWS('License Report Candidates'), REMOVEFILTERS('License Report Candidates'), 'License Report Candidates'[CandidateType] = \"Recovery\"), 0)\nVAR _reviewKpi = CALCULATE(MAX('License Report Summary'[E3ToF3ReviewCandidates]), REMOVEFILTERS('License Report Summary'))\nVAR _reviewRows = COALESCE(CALCULATE(COUNTROWS('License Report Candidates'), REMOVEFILTERS('License Report Candidates'), 'License Report Candidates'[CandidateType] = \"E3 to F3 review\"), 0)\nRETURN IF(NOT ISBLANK(_summary) && _summary = _gaps && _summary = _sources &&\n    (_detailRows = 0 || _summary = _detailSnapshot) &&\n    COALESCE(_recoveryKpi, 0) = _recoveryRows &&\n    COALESCE(_reviewKpi, 0) = _reviewRows, 1, 0)",
            "formatString": "0",
            "lineageTag": "1e47cd9c-3636-4b53-8258-89eb5704a2a8"
          },
          {
            "name": "License Report Snapshot ID",
            "description": "Immutable ID of the daily email snapshot currently loaded in the report.",
            "expression": "IF([License Report Snapshot Consistent] = 1, SELECTEDVALUE('License Report Summary'[SnapshotId]))",
            "lineageTag": "3c244fc1-c688-4d94-880f-851c2a7c0977"
          },
          {
            "name": "License Report Recovery Candidates",
            "description": "Qualified recovery assignments for the current product or selected suites. BLANK when any selected suite is unqualified or snapshot counts differ.",
            "expression": "VAR _unqualified = COALESCE(CALCULATE(COUNTROWS('License Report Summary'), KEEPFILTERS('License Report Summary'[Category] = \"Suite\"), ISBLANK('License Report Summary'[RecoveryCandidates])), 0)\nRETURN IF([License Report Snapshot Consistent] = 1 && _unqualified = 0, SUM('License Report Summary'[RecoveryCandidates]))",
            "formatString": "#,0",
            "lineageTag": "67da8ea2-1f67-4b40-9e8c-1239a41ecd95"
          },
          {
            "name": "License Report E3 to F3 Review",
            "description": "E3 to F3 manual review candidates from the email workbook.",
            "expression": "IF([License Report Snapshot Consistent] = 1, MAX('License Report Summary'[E3ToF3ReviewCandidates]))",
            "formatString": "#,0",
            "lineageTag": "44b48757-b73a-4145-96cf-91ee9451e973"
          },
          {
            "name": "License Report Used (%)",
            "expression": "IF([License Report Snapshot Consistent] = 1, DIVIDE(SUM('License Report Summary'[ConsumedUnits]), SUM('License Report Summary'[EnabledUnits])))",
            "formatString": "0.0%",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "52dd88f0-fe5f-4f1e-a871-08b8e14c4db2"
          },
          {
            "name": "License Report F1 Used (%)",
            "expression": "CALCULATE([License Report Used (%)], 'License Report Summary'[Product] = \"Microsoft 365 F1\")",
            "formatString": "0.0%",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "ebc8ab6e-de9e-454e-b168-1e9147a0e673"
          },
          {
            "name": "License Report F3 Used (%)",
            "expression": "CALCULATE([License Report Used (%)], 'License Report Summary'[Product] = \"Microsoft 365 F3\")",
            "formatString": "0.0%",
            "displayFolder": "Licensing | Mail parity",
            "lineageTag": "3a0a1bc8-a1f2-4fec-870c-ed94aa7ad4b8"
          },
          {
            "name": "License Report E3 Used (%)",
