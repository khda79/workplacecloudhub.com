            }
          }
        ],
        "measures": [
          {
            "name": "Hybrid identities matched",
            "description": "Matched on-premises/cloud identities for the selected entity type using the collector's declared match method.",
            "expression": "COALESCE(SUM('FactHybridIdentityCoverage'[MatchedCount]),0)",
            "formatString": "#,0",
            "displayFolder": "Identity",
            "lineageTag": "f78c0f49-f1e5-4265-a3d1-f39eddb1aada"
          },
          {
            "name": "Hybrid identity match rate",
            "description": "Matched identities divided by on-premises identities for the selected entity type. User and device populations must be reviewed separately.",
            "expression": "DIVIDE(SUM('FactHybridIdentityCoverage'[MatchedCount]),SUM('FactHybridIdentityCoverage'[OnPremisesCount]))",
            "formatString": "0.0%",
            "displayFolder": "Identity",
            "lineageTag": "b2e01334-2f83-4911-8e4c-a0e579afcda7"
          }
        ]
      },
