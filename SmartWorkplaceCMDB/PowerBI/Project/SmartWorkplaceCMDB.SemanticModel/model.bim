            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"EntityFinding\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantFindingKey\", dataType=\"String\"], [name=\"TenantUserKey\", dataType=\"String\"], [name=\"TenantDeviceKey\", dataType=\"String\"], [name=\"TenantGroupKey\", dataType=\"String\"], [name=\"EntityType\", dataType=\"String\"], [name=\"EntityId\", dataType=\"String\"], [name=\"Severity\", dataType=\"String\"], [name=\"FindingType\", dataType=\"String\"], [name=\"Description\", dataType=\"String\"], [name=\"RecommendedAction\", dataType=\"String\"], [name=\"DetectedDateTime\", dataType=\"DateTime\"], [name=\"LinkStatus\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Device finding details",
            "description": "Detail rows only when exactly one device is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimDevice')) = 1, COUNTROWS('EntityFinding'))",
            "formatString": "#,0",
            "lineageTag": "34746e5c-a1f2-4d8a-88c1-8056ad08d210"
          },
          {
            "name": "User finding details",
            "description": "Detail rows only when exactly one user is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimUser')) = 1, COUNTROWS('EntityFinding'))",
            "formatString": "#,0",
            "lineageTag": "6a8b524a-3307-48fe-a5b5-fa8dd47c28e8"
          },
          {
            "name": "Group finding details",
            "description": "Detail rows only when exactly one group is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimGroup')) = 1, COUNTROWS('EntityFinding'))",
            "formatString": "#,0",
            "lineageTag": "08585cb3-108f-467a-b309-6db9c488963a"
          },
          {
            "name": "Finding records",
            "description": "Finding evidence records in the current entity and filter context.",
            "expression": "COUNTROWS('EntityFinding')",
            "formatString": "#,0",
            "lineageTag": "41b8c199-c32c-4e4e-9056-dec869a22c1f"
          },
          {
            "name": "Affected devices",
            "description": "Distinct devices referenced by the current finding context.",
            "expression": "CALCULATE(DISTINCTCOUNT('EntityFinding'[TenantDeviceKey]), KEEPFILTERS(NOT ISBLANK('EntityFinding'[TenantDeviceKey])))",
            "formatString": "#,0",
            "lineageTag": "cb9881e4-e45d-4cf0-962a-4e7ff8856f74"
          },
          {
            "name": "Finding severity rate",
            "description": "Share of entity findings by severity.",
            "expression": "DIVIDE([Finding records], CALCULATE([Finding records], REMOVEFILTERS('EntityFinding'[Severity])))",
            "formatString": "0.0%",
            "lineageTag": "c850d23c-391b-472b-bdd7-f5e3ab7c43dc"
          }
        ]
      },
      {
        "name": "DimCountry",
        "lineageTag": "7f547550-5aa5-49ee-b790-f9b1b338fa59",
        "columns": [
          {
            "name": "CountryLabel",
            "dataType": "string",
            "sourceColumn": "CountryLabel",
            "lineageTag": "6dec3ee9-0ea5-4d14-8dd9-2e687e03c1f4",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Country footprint label",
            "dataType": "string",
            "description": "Compact country label used only by Executive Overview footprint charts; the full country key remains unchanged.",
            "expression": "IF('DimCountry'[CountryLabel] = \"Unknown / unassigned\", \"Unknown\", 'DimCountry'[CountryLabel])",
            "lineageTag": "9be20f8f-8d6d-4622-a684-4c847511069d",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimCountry",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimCountry\"), {[name=\"CountryLabel\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Executive workplace devices",
            "description": "Devices in the selected shared country context; the ownership slicer may further restrict the population.",
            "expression": "CALCULATE([Devices], TREATAS(VALUES('DimCountry'[CountryLabel]), 'DimDevice'[CountryLabel]))",
            "formatString": "#,0",
            "lineageTag": "f913a640-cf63-42da-a0bb-3aedc37cacbe"
          },
          {
            "name": "Executive managed device share",
            "description": "Managed-device share in the selected shared country context.",
            "expression": "CALCULATE([Managed device share], TREATAS(VALUES('DimCountry'[CountryLabel]), 'DimDevice'[CountryLabel]))",
            "formatString": "0.0%",
            "lineageTag": "0f45569d-4b97-4fdf-87a7-3c547f95d9b4"
          },
          {
            "name": "Executive compliant device share",
            "description": "Compliant-device share in the selected shared country context.",
            "expression": "CALCULATE([Compliant device share], TREATAS(VALUES('DimCountry'[CountryLabel]), 'DimDevice'[CountryLabel]))",
            "formatString": "0.0%",
            "lineageTag": "fbd399f4-3eae-4222-9cb7-b141f22ae832"
          },
          {
            "name": "Executive corporate devices",
            "description": "Corporate devices in the selected shared country context; ownership selection is intentionally ignored by the base measure.",
            "expression": "CALCULATE([Corporate devices], TREATAS(VALUES('DimCountry'[CountryLabel]), 'DimDevice'[CountryLabel]))",
            "formatString": "#,0",
            "lineageTag": "562b279c-401a-4f6c-9b16-3f8b239f809c"
          },
          {
            "name": "Executive corporate country share",
            "description": "Corporate devices for each country divided by all corporate devices.",
            "expression": "VAR _selected = [Executive corporate devices] VAR _all = CALCULATE([Executive corporate devices], REMOVEFILTERS('DimCountry')) RETURN DIVIDE(_selected, _all)",
            "formatString": "0.0%",
            "lineageTag": "cb331f57-6c29-4979-b2a0-907071907ecc"
          },
          {
            "name": "Executive user country share",
            "description": "Users for each country divided by all users, including unknown or unassigned country.",
            "expression": "DIVIDE([Users], CALCULATE([Users], REMOVEFILTERS('DimCountry')))",
            "formatString": "0.0%",
            "lineageTag": "e1dccc88-d030-4da0-ad2d-b86506e1aab8"
          },
          {
            "name": "Executive mailbox country share",
            "description": "Reconciled mailboxes for each country divided by all reconciled mailboxes, including unknown or unassigned country.",
            "expression": "DIVIDE([Hosted mailboxes], CALCULATE([Hosted mailboxes], REMOVEFILTERS('DimCountry')))",
            "formatString": "0.0%",
            "lineageTag": "3d5583a2-fa6f-478c-9669-5a68afe6f812"
          },
          {
            "name": "Executive M365 F1 country share",
            "description": "Microsoft 365 F1 assignments for each country divided by all observed Microsoft 365 F1 assignments. Assignment does not prove usage.",
            "expression": "VAR _countryAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"M365_F1\")) VAR _allAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"M365_F1\"), REMOVEFILTERS('DimCountry')) RETURN DIVIDE(_countryAssignments, _allAssignments)",
            "formatString": "0.0%",
            "lineageTag": "fee3bb05-ca5e-4450-8733-1d24f06dc55a"
          },
          {
            "name": "Executive M365 F3 country share",
            "description": "Microsoft 365 F3 assignments for each country divided by all observed Microsoft 365 F3 assignments. Assignment does not prove usage.",
            "expression": "VAR _countryAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"SPE_F1\")) VAR _allAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"SPE_F1\"), REMOVEFILTERS('DimCountry')) RETURN DIVIDE(_countryAssignments, _allAssignments)",
            "formatString": "0.0%",
            "lineageTag": "40278f98-4a90-4e62-8684-307c8ea284bd"
          },
          {
            "name": "Executive M365 E3 country share",
            "description": "Microsoft 365 E3 assignments for each country divided by all observed Microsoft 365 E3 assignments. Assignment does not prove usage.",
            "expression": "VAR _countryAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"SPE_E3\")) VAR _allAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"SPE_E3\"), REMOVEFILTERS('DimCountry')) RETURN DIVIDE(_countryAssignments, _allAssignments)",
            "formatString": "0.0%",
            "lineageTag": "40ef1cf3-f81a-4c24-9499-21cd66347d54"
          },
          {
            "name": "Executive M365 E5 country share",
            "description": "Microsoft 365 E5 assignments for each country divided by all observed Microsoft 365 E5 assignments. Assignment does not prove usage.",
            "expression": "VAR _countryAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"SPE_E5\")) VAR _allAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"SPE_E5\"), REMOVEFILTERS('DimCountry')) RETURN DIVIDE(_countryAssignments, _allAssignments)",
            "formatString": "0.0%",
            "lineageTag": "ef833b74-8b73-4fa1-882e-9c0dfa8241fe"
          },
          {
            "name": "Executive Copilot country share",
            "description": "Microsoft 365 Copilot assignments for each country divided by all observed Microsoft 365 Copilot assignments. Assignment does not prove usage.",
            "expression": "VAR _countryAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"Microsoft_365_Copilot\")) VAR _allAssignments = CALCULATE([License assignments], KEEPFILTERS('DimLicenseSku'[SkuPartNumber] == \"Microsoft_365_Copilot\"), REMOVEFILTERS('DimCountry')) RETURN DIVIDE(_countryAssignments, _allAssignments)",
            "formatString": "0.0%",
            "lineageTag": "30de9d90-d91a-41fe-aaa4-3ca8a756792c"
          },
          {
            "name": "Executive device form factor share",
            "description": "Share of each device form-factor category in the selected shared country and ownership context.",
            "expression": "VAR _countries = VALUES('DimCountry'[CountryLabel]) VAR _selected = CALCULATE([Devices], TREATAS(_countries, 'DimDevice'[CountryLabel])) VAR _all = CALCULATE([Devices], REMOVEFILTERS('DimDevice'[Device form factor]), TREATAS(_countries, 'DimDevice'[CountryLabel])) RETURN DIVIDE(_selected, _all)",
            "formatString": "0.0%",
            "lineageTag": "eb19e2a2-1bfb-409f-bba7-f1e3024e44c9"
          },
          {
            "name": "Executive device ownership share",
            "description": "Share of each device-ownership category in the selected shared country context.",
            "expression": "VAR _countries = VALUES('DimCountry'[CountryLabel]) VAR _selected = CALCULATE([Devices], TREATAS(_countries, 'DimDevice'[CountryLabel])) VAR _all = CALCULATE([Devices], REMOVEFILTERS('DimDevice'[Device ownership group]), TREATAS(_countries, 'DimDevice'[CountryLabel])) RETURN DIVIDE(_selected, _all)",
            "formatString": "0.0%",
            "lineageTag": "2abd3928-1f81-4d9a-a66c-e38c11b05c59"
          },
          {
            "name": "Executive Windows version share",
            "description": "Share of each Windows-version category in the selected shared country and ownership context.",
            "expression": "VAR _countries = VALUES('DimCountry'[CountryLabel]) VAR _selected = CALCULATE([Devices], TREATAS(_countries, 'DimDevice'[CountryLabel])) VAR _all = CALCULATE([Devices], REMOVEFILTERS('DimDevice'[Windows version group]), TREATAS(_countries, 'DimDevice'[CountryLabel])) RETURN DIVIDE(_selected, _all)",
            "formatString": "0.0%",
            "lineageTag": "aefe4b27-bd00-407b-bebd-87525468e37a"
          },
          {
            "name": "Executive Windows 10 devices",
            "description": "Windows 10 devices identified from the reported operating-system version in the selected country and ownership context. This is an OS count, not a hardware-readiness assessment.",
            "expression": "VAR _countries = VALUES('DimCountry'[CountryLabel]) RETURN CALCULATE([Devices], TREATAS(_countries, 'DimDevice'[CountryLabel]), KEEPFILTERS(FILTER('DimDevice', VAR _os = COALESCE('DimDevice'[OperatingSystem], \"\") VAR _version = COALESCE('DimDevice'[OperatingSystemVersion], \"\") VAR _isNumericVersion = LEFT(_version, 5) = \"10.0.\" VAR _build = IF(_isNumericVersion, IFERROR(VALUE(PATHITEM(SUBSTITUTE(_version, \".\", \"|\"), 3, INTEGER)), BLANK())) RETURN _os = \"Windows\" && (_version = \"Windows 10\" || (_build > 0 && _build < 22000)))))",
            "formatString": "#,0",
            "lineageTag": "28670fdd-94f5-48eb-b5df-d270faf0a05f"
          },
          {
            "name": "Executive Windows 10 not compatible devices",
            "description": "Distinct Windows 10 Intune devices explicitly reported as notCapable by Endpoint Analytics in the selected country and ownership context. Returns blank when no readiness evidence exists; unknown is never treated as incompatible.",
            "expression": "VAR _countries = VALUES('DimCountry'[CountryLabel]) VAR _windows10DeviceKeys = CALCULATETABLE(VALUES('DimDevice'[TenantDeviceKey]), TREATAS(_countries, 'DimDevice'[CountryLabel]), KEEPFILTERS(FILTER('DimDevice', VAR _os = COALESCE('DimDevice'[OperatingSystem], \"\") VAR _version = COALESCE('DimDevice'[OperatingSystemVersion], \"\") VAR _isNumericVersion = LEFT(_version, 5) = \"10.0.\" VAR _build = IF(_isNumericVersion, IFERROR(VALUE(PATHITEM(SUBSTITUTE(_version, \".\", \"|\"), 3, INTEGER)), BLANK())) RETURN _os = \"Windows\" && (_version = \"Windows 10\" || (_build > 0 && _build < 22000))))) VAR _intuneDeviceIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_windows10DeviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) VAR _observed = CALCULATE(COUNTROWS('FactEndpointAnalyticsUpgradeEligibility'), TREATAS(_intuneDeviceIds, 'FactEndpointAnalyticsUpgradeEligibility'[DeviceId]), KEEPFILTERS('FactEndpointAnalyticsUpgradeEligibility'[UpgradeEligibility] IN {\"upgraded\", \"unknown\", \"notCapable\", \"capable\", \"unknownFutureValue\"})) VAR _notCapable = CALCULATE(DISTINCTCOUNT('FactEndpointAnalyticsUpgradeEligibility'[DeviceId]), TREATAS(_intuneDeviceIds, 'FactEndpointAnalyticsUpgradeEligibility'[DeviceId]), KEEPFILTERS('FactEndpointAnalyticsUpgradeEligibility'[UpgradeEligibility] = \"notCapable\")) RETURN IF(_observed = 0, BLANK(), _notCapable)",
            "formatString": "#,0",
            "lineageTag": "36e4805e-b6ed-42cb-b8c4-a121d91b2ac9"
          },
          {
            "name": "Executive Endpoint Analytics score",
            "description": "Average Endpoint Analytics score from 0 to 100, linked by exact Intune device identifier in the selected country and ownership context; it is a normalized score, not a population percentage.",
            "expression": "VAR _countries = VALUES('DimCountry'[CountryLabel]) VAR _deviceKeys = CALCULATETABLE(VALUES('DimDevice'[TenantDeviceKey]), TREATAS(_countries, 'DimDevice'[CountryLabel])) VAR _intuneIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_deviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) RETURN CALCULATE(AVERAGE('FactEndpointAnalyticsDevice'[EndpointAnalyticsScore]), TREATAS(_intuneIds, 'FactEndpointAnalyticsDevice'[DeviceId]))",
            "formatString": "0.0",
            "lineageTag": "194e3b29-1e38-440a-8bf7-ef175e814b29"
          }
        ]
      },
