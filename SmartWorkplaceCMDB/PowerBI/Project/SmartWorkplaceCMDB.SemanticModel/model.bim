          {
            "name": "ADComputerSource",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"ADComputerSource\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantADComputerKey\", dataType=\"String\"], [name=\"ObjectGUID\", dataType=\"String\"], [name=\"ObjectSID\", dataType=\"String\"], [name=\"DomainName\", dataType=\"String\"], [name=\"DistinguishedName\", dataType=\"String\"], [name=\"Name\", dataType=\"String\"], [name=\"DNSHostName\", dataType=\"String\"], [name=\"Enabled\", dataType=\"Boolean\"], [name=\"OperatingSystem\", dataType=\"String\"], [name=\"OperatingSystemVersion\", dataType=\"String\"], [name=\"TenantDeviceKey\", dataType=\"String\"], [name=\"CloudMatchStatus\", dataType=\"String\"], [name=\"LastLogonTimestampRaw\", dataType=\"String\"], [name=\"LastLogonUtcDateTime\", dataType=\"DateTime\"], [name=\"LastLogonStatus\", dataType=\"String\"], [name=\"CreationRaw\", dataType=\"String\"], [name=\"CreationUtcDateTime\", dataType=\"DateTime\"], [name=\"CreationStatus\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "AD objects without DNS",
            "description": "Native AD computer objects whose DNSHostName is absent; this does not prove physical use or non-use.",
            "expression": "COUNTROWS ( FILTER ( 'ADComputerSource', ISBLANK ( 'ADComputerSource'[DNSHostName] ) || TRIM ( 'ADComputerSource'[DNSHostName] ) = \"\" ) )",
            "formatString": "#,##0",
            "lineageTag": "4d3cb99e-1a3a-40db-9d51-65d50d922364"
          },
          {
            "name": "Selected device AD objects",
            "description": "Native AD records explicitly linked to one selected CMDB device identity; no name-based guessed relation.",
            "expression": "IF ( HASONEVALUE ( 'DimDevice'[TenantDeviceKey] ), CALCULATE ( COUNTROWS ( 'ADComputerSource' ), TREATAS ( VALUES ( 'DimDevice'[TenantDeviceKey] ), 'ADComputerSource'[TenantDeviceKey] ) ) )",
            "formatString": "#,##0",
            "lineageTag": "d6f934dc-0691-4621-9e58-589248b64a5a"
          }
        ]
      },
