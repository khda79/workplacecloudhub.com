            "summarizeBy": "none"
          },
          {
            "name": "UserActivityStatus",
            "dataType": "string",
            "sourceColumn": "UserActivityStatus",
            "lineageTag": "a1634056-5c8b-47fc-8af3-f6d62797b6f6",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "License review band",
            "dataType": "string",
            "description": "License-review prioritization from exact Office 365 workload activity evidence and account status. It is evidence for review, not proof that a license is unused.",
            "expression": "VAR _activityMatch = LOOKUPVALUE('FactUserActivity'[MatchStatus], 'FactUserActivity'[TenantUserKey], 'DimUser'[TenantUserKey]) VAR _workloadLast = LOOKUPVALUE('FactUserActivity'[LastActivityDate], 'FactUserActivity'[TenantUserKey], 'DimUser'[TenantUserKey]) VAR _days = IF(NOT ISBLANK(_workloadLast), DATEDIFF(_workloadLast, TODAY(), DAY)) RETURN SWITCH(TRUE(), 'DimUser'[AccountEnabled] = FALSE(), \"Priority · disabled account\", _activityMatch <> \"ExactUPN\", \"Coverage gap · no exact workload row\", ISBLANK(_workloadLast), \"Priority · no M365 activity in D180\", _days > 90, \"Priority · workload over 90 days\", _days > 30, \"Watch · workload 31–90 days\", \"Recent M365 workload activity\")",
            "lineageTag": "41f5677f-c9b9-4317-86c6-2714e5f5638e",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimUser",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimUser\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantUserKey\", dataType=\"String\"], [name=\"CmdbUserId\", dataType=\"String\"], [name=\"UserPrincipalName\", dataType=\"String\"], [name=\"DisplayName\", dataType=\"String\"], [name=\"AccountEnabled\", dataType=\"Boolean\"], [name=\"UserType\", dataType=\"String\"], [name=\"Department\", dataType=\"String\"], [name=\"JobTitle\", dataType=\"String\"], [name=\"CountryCode\", dataType=\"String\"], [name=\"CountryLabel\", dataType=\"String\"], [name=\"CountryStatus\", dataType=\"String\"], [name=\"LastSignInDateTime\", dataType=\"DateTime\", allowSourceWallClock=true], [name=\"LastNonInteractiveSignInDateTime\", dataType=\"DateTime\", allowSourceWallClock=true], [name=\"LastSuccessfulSignInDateTime\", dataType=\"DateTime\", allowSourceWallClock=true], [name=\"ActivityState\", dataType=\"String\"], [name=\"ConfidenceScore\", dataType=\"Double\"], [name=\"AccountStatusLabel\", dataType=\"String\"], [name=\"DisplayNameLabel\", dataType=\"String\"], [name=\"UserPrincipalNameLabel\", dataType=\"String\"], [name=\"DepartmentLabel\", dataType=\"String\"], [name=\"UserTypeLabel\", dataType=\"String\"], [name=\"UserSelection\", dataType=\"String\"], [name=\"SourceUserId\", dataType=\"String\"], [name=\"CreationRaw\", dataType=\"String\"], [name=\"CreationUtcDateTime\", dataType=\"DateTime\"], [name=\"CreationStatus\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"], [name=\"ManagerStatus\", dataType=\"String\"], [name=\"UserActivityStatus\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Users",
            "description": "Distinct accounts in the Entra export, subject to page filters.",
            "expression": "COALESCE(COUNTROWS('DimUser'),0)",
            "formatString": "#,0",
            "lineageTag": "7bf4de99-ff98-464d-b7c0-4268d85d0119"
          },
          {
            "name": "Enabled accounts",
            "description": "AccountEnabled=true; this is not a measure of activity or sign-ins.",
            "expression": "CALCULATE([Users], KEEPFILTERS('DimUser'[AccountEnabled] == TRUE()))",
            "formatString": "#,0",
            "lineageTag": "d914c04c-4c31-4ef7-b202-d5ad16c1feb9"
          },
          {
            "name": "Disabled accounts",
            "description": "AccountEnabled=false; unknown values remain separate.",
            "expression": "CALCULATE([Users], KEEPFILTERS('DimUser'[AccountEnabled] == FALSE()))",
            "formatString": "#,0",
            "lineageTag": "cff1abb3-5c64-47f8-b9bb-97b58af4ecb6"
          },
          {
            "name": "Enabled account share",
            "description": "Enabled accounts / all filtered users; no activity information is implied.",
            "expression": "DIVIDE([Enabled accounts], [Users])",
            "formatString": "0.0%",
            "lineageTag": "38679ea5-7d08-4359-85f8-1ee99eb57cf7"
          },
          {
            "name": "User details",
            "description": "Detail rows only when exactly one user is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimUser')) = 1, COUNTROWS('DimUser'))",
            "formatString": "#,0",
            "lineageTag": "62ed17e2-65b2-47fa-a013-a58f5c484735"
          },
          {
            "name": "Account status share",
            "description": "Share of the current account-status category within the filtered user population.",
            "expression": "DIVIDE([Users], CALCULATE([Users], REMOVEFILTERS('DimUser'[AccountStatusLabel])))",
            "formatString": "0.0%",
            "lineageTag": "b16eedd5-d0ba-44e6-8c27-37dc91d8b2bd"
          },
          {
            "name": "Activity state rate",
            "description": "Share of each observed activity state within the filtered user population.",
            "expression": "DIVIDE([Users], CALCULATE([Users], REMOVEFILTERS('DimUser'[ActivityState])))",
            "formatString": "0.0%",
            "lineageTag": "bc579dc9-29c3-4679-87c8-b969f3487e35"
          },
          {
            "name": "License review candidates",
            "description": "Distinct licensed users in priority or watch bands based on exact M365 workload evidence; coverage gaps are excluded and non-use is not asserted.",
            "expression": "CALCULATE(DISTINCTCOUNT('LicenseAssignmentPath'[TenantUserKey]), KEEPFILTERS(FILTER('DimUser', LEFT('DimUser'[License review band], 8) = \"Priority\" || LEFT('DimUser'[License review band], 5) = \"Watch\")))",
            "formatString": "#,0",
            "lineageTag": "5e8bd7bf-b738-4969-97af-4a8bee666142"
          }
        ]
      },
