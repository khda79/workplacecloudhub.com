        "partitions": [
          {
            "name": "FactAutopilotDevice",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactAutopilotDevice\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantAutopilotDeviceKey\", dataType=\"String\"], [name=\"AutopilotDeviceId\", dataType=\"String\"], [name=\"DisplayName\", dataType=\"String\"], [name=\"SerialNumber\", dataType=\"String\"], [name=\"Manufacturer\", dataType=\"String\"], [name=\"Model\", dataType=\"String\"], [name=\"GroupTag\", dataType=\"String\"], [name=\"EnrollmentState\", dataType=\"String\"], [name=\"LastContactedDateTime\", dataType=\"DateTime\", allowSourceWallClock=true, allowEmptyAutopilotContact=true], [name=\"AzureAdDeviceId\", dataType=\"String\"], [name=\"ManagedDeviceId\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Autopilot devices",
            "description": "Windows Autopilot device identities observed in the frozen collection.",
            "expression": "COALESCE(COUNTROWS('FactAutopilotDevice'),0)",
            "formatString": "#,0",
            "displayFolder": "Transformation",
            "lineageTag": "c04c9306-77be-495a-b2fa-cd010dbebd5e"
          },
          {
            "name": "Autopilot enrolled devices",
            "description": "Autopilot rows explicitly reported with enrollment state enrolled.",
            "expression": "CALCULATE([Autopilot devices],KEEPFILTERS('FactAutopilotDevice'[EnrollmentState] = \"enrolled\"))",
            "formatString": "#,0",
            "displayFolder": "Transformation",
            "lineageTag": "be22b0b9-5423-4561-a162-45c6195d8d89"
          },
          {
            "name": "Autopilot enrollment rate",
            "description": "Share of each Autopilot enrollment state within exact matched Intune devices.",
            "expression": "DIVIDE([Selected Autopilot devices], CALCULATE([Selected Autopilot devices], REMOVEFILTERS('FactAutopilotDevice'[EnrollmentState])))",
            "formatString": "0.0%",
            "lineageTag": "ab2316fb-2e82-44df-9018-49548eec9288"
          },
          {
            "name": "Selected Autopilot devices",
            "description": "Autopilot records linked by exact Intune managed-device identifier to the filtered device population.",
            "expression": "VAR _deviceKeys = VALUES('DimDevice'[TenantDeviceKey]) VAR _intuneIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_deviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) RETURN CALCULATE(DISTINCTCOUNT('FactAutopilotDevice'[ManagedDeviceId]), TREATAS(_intuneIds, 'FactAutopilotDevice'[ManagedDeviceId]))",
            "formatString": "#,0",
            "lineageTag": "32ea9fc7-aaa5-4b55-aaf1-4be5f8e44ab9"
          }
        ]
      },
