        "partitions": [
          {
            "name": "DimTeam",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimTeam\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantTeamKey\", dataType=\"String\"], [name=\"TeamId\", dataType=\"String\"], [name=\"DisplayName\", dataType=\"String\"], [name=\"Visibility\", dataType=\"String\"], [name=\"CreatedDateTime\", dataType=\"DateTime\"], [name=\"LastActivityDate\", dataType=\"DateTime\"], [name=\"ActivityState\", dataType=\"String\"], [name=\"OwnerCount\", dataType=\"Int64\"], [name=\"MemberCount\", dataType=\"Int64\"], [name=\"GuestCount\", dataType=\"Int64\"], [name=\"UnresolvedMemberCount\", dataType=\"Int64\"], [name=\"MembershipCoverageStatus\", dataType=\"String\"], [name=\"IsArchived\", dataType=\"Boolean\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Teams",
            "description": "Distinct Microsoft 365 groups provisioned as Teams.",
            "expression": "DISTINCTCOUNT('DimTeam'[TenantTeamKey])",
            "formatString": "#,0",
            "lineageTag": "10a00305-9419-4458-aeb9-ad6b7eaa0c78"
          },
          {
            "name": "Active Teams",
            "description": "Teams with activity reported within 90 days.",
            "expression": "CALCULATE([Teams], KEEPFILTERS('DimTeam'[ActivityState] = \"Active (90d)\"))",
            "formatString": "#,0",
            "lineageTag": "352af4a2-5601-4942-9366-56645d254584"
          },
          {
            "name": "Teams active rate",
            "description": "Teams active within 90 days divided by all Teams.",
            "expression": "DIVIDE([Active Teams], [Teams])",
            "formatString": "0.0%",
            "lineageTag": "d999d8f1-0710-4691-9379-29f8db2e76e4"
          },
          {
            "name": "Teams activity state rate",
            "description": "Share of Teams by explicit 90-day activity state.",
            "expression": "DIVIDE([Teams], CALCULATE([Teams], REMOVEFILTERS('DimTeam'[ActivityState])))",
            "formatString": "0.0%",
            "lineageTag": "e4992053-3ca3-4e82-af39-9a9e7768a8d7"
          },
          {
            "name": "Average members per Team",
            "description": "Average exact enumerated group-member count across Teams with complete membership coverage. Partial Teams are excluded.",
            "expression": "CALCULATE(AVERAGE('DimTeam'[MemberCount]), KEEPFILTERS('DimTeam'[MembershipCoverageStatus] = \"Complete\"))",
            "formatString": "#,0.0",
            "lineageTag": "6e31d2e4-15ba-4bcd-aefa-50eb9a3dd8d0"
          },
          {
            "name": "Teams with partial membership coverage",
            "description": "Teams for which Graph returned one or more member objects without an immutable identifier; exact links are preserved but the member total is incomplete.",
            "expression": "CALCULATE([Teams], KEEPFILTERS('DimTeam'[MembershipCoverageStatus] = \"Partial\"))",
            "formatString": "#,0",
