        "partitions": [
          {
            "name": "DimLicenseSku",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimLicenseSku\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantSkuKey\", dataType=\"String\"], [name=\"SkuId\", dataType=\"String\"], [name=\"SkuPartNumber\", dataType=\"String\"], [name=\"ConsumedUnits\", dataType=\"Int64\"], [name=\"EnabledUnits\", dataType=\"Int64\"], [name=\"SkuPartNumberLabel\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "License SKUs",
            "description": "Subscribed product SKUs. A SKU does not represent a person.",
            "expression": "COALESCE(COUNTROWS('DimLicenseSku'),0)",
            "formatString": "#,0",
            "lineageTag": "b7d0ca48-8285-4c38-a27d-ea12f06184c9"
          },
          {
            "name": "SKU enabled units",
            "description": "Available only for a single SKU; do not sum different products as a count of people.",
            "expression": "IF(HASONEVALUE('DimLicenseSku'[TenantSkuKey]), SUM('DimLicenseSku'[EnabledUnits]))",
            "formatString": "#,0",
            "lineageTag": "6b811e6b-e433-4fbe-8454-82b5dd8b73ec"
          },
          {
            "name": "SKU consumed units",
            "description": "Available only for a single SKU; do not sum different products as a count of people.",
            "expression": "IF(HASONEVALUE('DimLicenseSku'[TenantSkuKey]), SUM('DimLicenseSku'[ConsumedUnits]))",
            "formatString": "#,0",
            "lineageTag": "8e69ea2c-6f16-4adb-a5cd-4991af74436d"
          },
          {
            "name": "Microsoft 365 plans observed",
            "description": "Count of subscribed Microsoft 365 target plans observed in the current filter context. Scope: Microsoft 365 F1 (M365_F1), F3 (SPE_F1), E3 (SPE_E3), E5 (SPE_E5), and Microsoft 365 Copilot. A plan is not a person.",
            "expression": "VAR _targetSkus =\n    { \"M365_F1\", \"SPE_F1\", \"SPE_E3\", \"SPE_E5\", \"Microsoft_365_Copilot\" }\nRETURN\n    COALESCE(\n        CALCULATE(\n            COUNTROWS('DimLicenseSku'),\n            KEEPFILTERS('DimLicenseSku'[SkuPartNumber] IN _targetSkus)\n        ),\n        0\n    )",
            "formatString": "0",
            "displayFolder": "Cockpit DSI\\Licensing",
            "lineageTag": "cd6ee597-2c51-4cdb-85bd-f62101fb91bd"
          },
          {
            "name": "SKU allocation rate",
            "description": "Assigned-seat allocation rate for the single Microsoft 365 SKU in filter context: ConsumedUnits divided by EnabledUnits. This measures seat allocation, not product usage.",
            "expression": "DIVIDE ( [SKU consumed units], [SKU enabled units] )",
            "formatString": "0.0%",
            "displayFolder": "Cockpit DSI\\Licensing",
            "lineageTag": "e3c2f47b-3b12-4932-8f79-48f787b6228b"
          },
          {
            "name": "SKU allocation summary",
            "description": "Executive text summary for one Microsoft 365 SKU: assigned (ConsumedUnits) / enabled seats and allocation rate. Returns Not observed when the filtered SKU is absent from the snapshot.",
            "expression": "VAR _skuObserved = HASONEVALUE ( 'DimLicenseSku'[TenantSkuKey] )\nVAR _assigned = [SKU consumed units]\nVAR _enabled = [SKU enabled units]\nVAR _rate = [SKU allocation rate]\nRETURN\n    IF (\n        NOT _skuObserved,\n        \"Not observed\",\n        FORMAT ( _assigned, \"#,0\" )\n            & \" / \"\n            & FORMAT ( _enabled, \"#,0\" )\n            & \" · \"\n            & FORMAT ( _rate, \"0.0%\" )\n    )",
            "formatString": "@",
            "displayFolder": "Cockpit DSI\\Licensing",
            "lineageTag": "a596492e-126c-4994-83e3-0b321d7e5d16"
          }
        ]
      },
