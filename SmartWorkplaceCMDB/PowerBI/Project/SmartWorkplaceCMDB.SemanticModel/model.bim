        "partitions": [
          {
            "name": "FactDataQuality",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactDataQuality\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantFindingKey\", dataType=\"String\"], [name=\"FindingId\", dataType=\"String\"], [name=\"Severity\", dataType=\"String\"], [name=\"EntityType\", dataType=\"String\"], [name=\"FindingType\", dataType=\"String\"], [name=\"DetectedDateTime\", dataType=\"DateTime\"], [name=\"SourceSystem\", dataType=\"String\"], [name=\"Description\", dataType=\"String\"], [name=\"RecommendedAction\", dataType=\"String\"], [name=\"SeverityLabel\", dataType=\"String\"], [name=\"FindingTypeLabel\", dataType=\"String\"], [name=\"DescriptionLabel\", dataType=\"String\"], [name=\"RecommendedActionLabel\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Quality findings",
            "description": "Retained findings, including technical information.",
            "expression": "COALESCE(COUNTROWS('FactDataQuality'),0)",
            "formatString": "#,0",
            "lineageTag": "ee877d12-3eb6-4587-949c-2da5b1edd43c"
          },
          {
            "name": "Warnings",
            "description": "Findings classified as Warning by the quality normalizer.",
            "expression": "CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[Severity] == \"Warning\"))",
            "formatString": "#,0",
            "lineageTag": "cb560973-7c58-4663-99ad-7a55438e2858"
          },
          {
            "name": "Information",
            "description": "Retained information, including technical DiscoveryMailbox findings classified by the local rule.",
            "expression": "CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[Severity] == \"Information\"))",
            "formatString": "#,0",
            "lineageTag": "1973d0f9-efe2-4528-8ae2-992f0d69b009"
          },
          {
            "name": "Critical findings",
            "description": "Findings classified as Critical by the quality normalizer.",
            "expression": "CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[Severity] == \"Critical\"))",
            "formatString": "#,0",
            "lineageTag": "78ea9e7d-fb47-4479-b20c-eadbc1731a8c"
          },
          {
            "name": "Integrity issues",
            "description": "Orphan primary-user references plus observed Microsoft 365 license-assignment errors.",
            "expression": "CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"OrphanPrimaryUserReference\")) + CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"ObservedLicenseAssignmentError\"))",
            "formatString": "#,0",
            "lineageTag": "c4a714d1-d75c-457a-9e15-4a1f9f342032"
          },
          {
            "name": "Coverage gaps",
            "description": "User records without a country plus devices without a primary user; these are coverage gaps, not integrity failures.",
            "expression": "CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"UserCountryUnknown\")) + CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"DeviceWithoutPrimaryUser\"))",
            "formatString": "#,0",
            "lineageTag": "a76cb4a2-d97d-4666-985a-cd53a3326449"
          },
          {
            "name": "Derived country gaps",
            "description": "Devices whose country cannot be derived. This overlaps device primary-user findings and must not be added to Coverage gaps.",
            "expression": "CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"DeviceCountryUnknown\"))",
            "formatString": "#,0",
            "lineageTag": "b5abfb3e-2ccd-4567-82d1-c51d28af2a2e"
          },
          {
            "name": "Data quality score",
            "description": "Lowest non-blank global completeness rate across user country, device primary-user, device country and integrity checks. Overlapping findings are assessed separately, never added together. Country and ownership selections are intentionally ignored because quality findings are not country-grained.",
            "expression": "VAR _users = CALCULATE([Users], REMOVEFILTERS('DimUser'), REMOVEFILTERS('DimCountry')) VAR _devices = CALCULATE([Devices], REMOVEFILTERS('DimDevice'), REMOVEFILTERS('DimCountry')) VAR _userCountryCoverage = IF(_users > 0, MAX(0, DIVIDE(_users - CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"UserCountryUnknown\")), _users))) VAR _primaryUserCoverage = IF(_devices > 0, MAX(0, DIVIDE(_devices - CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"DeviceWithoutPrimaryUser\")), _devices))) VAR _deviceCountryCoverage = IF(_devices > 0, MAX(0, DIVIDE(_devices - CALCULATE([Quality findings], KEEPFILTERS('FactDataQuality'[FindingType] == \"DeviceCountryUnknown\")), _devices))) VAR _population = _users + _devices VAR _integrityCoverage = IF(_population > 0, MAX(0, DIVIDE(_population - [Integrity issues], _population))) VAR _rates = {_userCountryCoverage, _primaryUserCoverage, _deviceCountryCoverage, _integrityCoverage} RETURN MINX(FILTER(_rates, NOT ISBLANK([Value])), [Value])",
            "formatString": "0.0%",
            "lineageTag": "4346567d-cba9-4e10-a9b4-f0eb626faf66"
          },
          {
            "name": "Data quality status",
            "description": "Traffic-light assessment of the data quality score: Good at 90% or above, Average from 60% to below 90%, and Poor below 60%.",
            "expression": "VAR _score = [Data quality score] RETURN SWITCH(TRUE(), ISBLANK(_score), \"Not assessed\", _score >= 0.9, \"Good\", _score >= 0.6, \"Average\", \"Poor\")",
            "formatString": "General",
            "lineageTag": "b59c38d5-2596-4f7f-b240-566c22200c1b"
          },
          {
            "name": "Data quality health",
            "description": "Compact status and score intended for the Executive Overview; open Workplace Health for the underlying findings.",
            "expression": "VAR _score = [Data quality score] VAR _status = [Data quality status] RETURN IF(ISBLANK(_score), _status, _status & \" · \" & FORMAT(_score, \"0.0%\"))",
            "formatString": "General",
            "lineageTag": "41cdf5dc-650e-4de1-b978-c04a8d7e7478"
          }
        ]
      },
