            }
          }
        ],
        "measures": [
          {
            "name": "Windows update alert records",
            "description": "Windows Update report rows in the frozen collection; a device can contribute more than one row.",
            "expression": "COALESCE(COUNTROWS('FactWindowsUpdateAlert'),0)",
            "formatString": "#,0",
            "displayFolder": "Workplace Health",
            "lineageTag": "e9c418d6-509c-49f6-bfe8-470770bb482c"
          },
          {
            "name": "Devices with Windows update alerts",
            "description": "Distinct source device identifiers represented in Windows Update report rows.",
            "expression": "COALESCE(DISTINCTCOUNTNOBLANK('FactWindowsUpdateAlert'[DeviceId]),0)",
            "formatString": "#,0",
            "displayFolder": "Workplace Health",
            "lineageTag": "5b0fece3-ded4-42c5-b7f4-b68d9b166ef5"
          },
          {
            "name": "Windows update alerts needing attention",
            "description": "Windows Update report rows whose current device update status is explicitly Needs attention.",
            "expression": "CALCULATE([Windows update alert records],KEEPFILTERS('FactWindowsUpdateAlert'[CurrentDeviceUpdateStatus] = \"Needs attention\"))",
            "formatString": "#,0",
            "displayFolder": "Workplace Health",
            "lineageTag": "61fb002d-b0e6-4823-8148-b2bd8610696d"
          },
          {
            "name": "Update aggregate state rate",
            "description": "Share of Windows Update evidence records by aggregate state.",
            "expression": "DIVIDE([Windows update alert records], CALCULATE([Windows update alert records], REMOVEFILTERS('FactWindowsUpdateAlert'[AggregateState])))",
            "formatString": "0.0%",
            "lineageTag": "12a9c228-c33d-4ee4-ba23-320bc97e01f1"
          }
        ]
      },
