        "partitions": [
          {
            "name": "FactUserLicense",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactUserLicense\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantUserKey\", dataType=\"String\"], [name=\"TenantSkuKey\", dataType=\"String\"], [name=\"CmdbUserId\", dataType=\"String\"], [name=\"SkuId\", dataType=\"String\"], [name=\"AssignmentState\", dataType=\"String\"], [name=\"AssignedDateTime\", dataType=\"DateTime\"], [name=\"SourceSystem\", dataType=\"String\"], [name=\"AssignmentStateLabel\", dataType=\"String\"], [name=\"SourceUserId\", dataType=\"String\"], [name=\"UserLinkStatus\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "License assignments",
            "description": "Unique user/SKU pairs across all assignment states.",
            "expression": "COALESCE(COUNTROWS('FactUserLicense'),0)",
            "formatString": "#,0",
            "lineageTag": "bdb51453-fb03-4b19-b542-b53731dcbdf9"
          },
          {
            "name": "Users with assignments",
            "description": "Distinct users with at least one assignment across all states; does not establish an active or used license.",
            "expression": "COALESCE(DISTINCTCOUNTNOBLANK('FactUserLicense'[TenantUserKey]),0)",
            "formatString": "#,0",
            "lineageTag": "344b84ea-00dc-49d9-a925-0af3866dd82a"
          },
          {
            "name": "User license assignment coverage",
            "description": "Users with at least one observed license assignment divided by all filtered users. This is not license usage.",
            "expression": "DIVIDE([Users with assignments], [Users])",
            "formatString": "0.0%",
            "lineageTag": "6add5ac3-b2fc-44dd-9803-61b3c05849a4"
          },
          {
            "name": "Microsoft 365 license assignments",
            "description": "Unique user/SKU assignment rows for Microsoft 365 F1, F3, E3, E5, and Microsoft 365 Copilot across all observed assignment states. This is entitlement assignment, not usage.",
            "expression": "VAR _targetSkus =\n    { \"M365_F1\", \"SPE_F1\", \"SPE_E3\", \"SPE_E5\", \"Microsoft_365_Copilot\" }\nRETURN\n    COALESCE(\n        CALCULATE(\n            COUNTROWS('FactUserLicense'),\n            KEEPFILTERS('DimLicenseSku'[SkuPartNumber] IN _targetSkus)\n        ),\n        0\n    )",
            "formatString": "#,0",
            "displayFolder": "Cockpit DSI\\Licensing",
            "lineageTag": "a6e0c035-f9a7-4ff6-81ec-b18a8063efdf"
          },
          {
            "name": "Microsoft 365 users assigned",
            "description": "Distinct users with at least one observed assignment to Microsoft 365 F1, F3, E3, E5, or Microsoft 365 Copilot. This does not establish active use.",
            "expression": "VAR _targetSkus =\n    { \"M365_F1\", \"SPE_F1\", \"SPE_E3\", \"SPE_E5\", \"Microsoft_365_Copilot\" }\nRETURN\n    COALESCE(\n        CALCULATE(\n            DISTINCTCOUNTNOBLANK('FactUserLicense'[TenantUserKey]),\n            KEEPFILTERS('DimLicenseSku'[SkuPartNumber] IN _targetSkus)\n        ),\n        0\n    )",
            "formatString": "#,0",
            "displayFolder": "Cockpit DSI\\Licensing",
            "lineageTag": "88b79411-91d8-4d03-8030-0e2d6f99ca75"
          },
          {
            "name": "Microsoft 365 assignment coverage",
            "description": "Distinct users assigned to Microsoft 365 F1, F3, E3, E5, or Microsoft 365 Copilot divided by all filtered users. This is assignment coverage, not license usage.",
            "expression": "VAR _assignedUsers =\n    [Microsoft 365 users assigned]\nVAR _allUsers =\n    CALCULATE(\n        [Users],\n        REMOVEFILTERS('DimLicenseSku')\n    )\nRETURN\n    DIVIDE(_assignedUsers, _allUsers)",
            "formatString": "0.0%",
            "displayFolder": "Cockpit DSI\\Licensing",
            "lineageTag": "167822c7-ea24-4eb6-9c69-777836a1c833"
          },
          {
            "name": "Assignment state rate",
            "description": "Share of license assignments by normalized assignment state.",
            "expression": "DIVIDE([License assignments], CALCULATE([License assignments], REMOVEFILTERS('FactUserLicense'[AssignmentStateLabel])))",
            "formatString": "0.0%",
            "lineageTag": "8b8262e2-1c47-414f-8d15-ea761fb47f51"
          }
        ]
      },
