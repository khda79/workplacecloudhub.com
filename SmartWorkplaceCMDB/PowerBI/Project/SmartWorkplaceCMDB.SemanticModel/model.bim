        "partitions": [
          {
            "name": "DimDetectedApplication",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimDetectedApplication\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantApplicationKey\", dataType=\"String\"], [name=\"AppId\", dataType=\"String\"], [name=\"SourceApplicationKey\", dataType=\"String\"], [name=\"DisplayName\", dataType=\"String\"], [name=\"Version\", dataType=\"String\"], [name=\"Publisher\", dataType=\"String\"], [name=\"DeviceCount\", dataType=\"Int64\"], [name=\"ReportedDeviceCount\", dataType=\"Int64\"], [name=\"ExactRelatedDeviceCount\", dataType=\"Int64\"], [name=\"ResolvedDeviceCount\", dataType=\"Int64\"], [name=\"UnresolvedDeviceCount\", dataType=\"Int64\"], [name=\"RelationshipCoverageStatus\", dataType=\"String\"], [name=\"Platform\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"], [name=\"Application product key\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Detected applications",
            "description": "Distinct detected-application rows in the Intune export; versions can create separate rows.",
            "expression": "COALESCE(COUNTROWS('DimDetectedApplication'),0)",
            "formatString": "#,0",
            "displayFolder": "Applications",
            "lineageTag": "cca61704-a828-457a-b7e4-2fca0c46664b"
          },
          {
            "name": "Reported application-device occurrences",
            "description": "Source-reported application-device occurrences. Exact device-level reporting uses FactDeviceApplication instead.",
            "expression": "SUM('DimDetectedApplication'[ReportedDeviceCount])",
            "formatString": "#,0",
            "lineageTag": "cfbf0786-eb5d-4700-86b6-40024d62a6d8"
          },
          {
            "name": "Application products",
            "description": "Distinct normalized application name, publisher and platform products; versions are not products.",
            "expression": "DISTINCTCOUNT ( 'DimDetectedApplication'[Application product key] )",
            "formatString": "#,0",
            "lineageTag": "4162d626-9d33-45d5-8363-14f1b0551df4"
          },
          {
            "name": "Application version rows",
            "description": "Source-reported application product-version rows.",
            "expression": "COUNTROWS('DimDetectedApplication')",
            "formatString": "#,0",
            "lineageTag": "cf3c6e36-522e-46cc-83ec-0b20ec887ee6"
          },
          {
            "name": "Application occurrence rate",
            "description": "Share of source-reported application-device occurrences for each product; occurrences are not distinct devices.",
            "expression": "DIVIDE ( [Reported application-device occurrences], CALCULATE ( [Reported application-device occurrences], REMOVEFILTERS ( 'DimDetectedApplication' ) ) )",
            "formatString": "0.0%",
            "lineageTag": "8c08ffee-108b-4169-aa61-f08531c0901c"
          },
          {
            "name": "Application Top 5",
            "description": "Deterministic Top 5 normalized products by distinct native reporting devices in the selected fleet; product-key tie breaker.",
            "expression": "VAR _current = SELECTEDVALUE ( 'DimDetectedApplication'[Application product key] )\nVAR _scored = CALCULATETABLE (\n    SUMMARIZECOLUMNS ( 'DimDetectedApplication'[Application product key], \"DeviceCount\", [Devices reporting applications] ),\n    ALLSELECTED ( 'DimDetectedApplication' )\n)\nVAR _top = TOPN ( 5, FILTER ( _scored, [DeviceCount] > 0 ), [DeviceCount], DESC, 'DimDetectedApplication'[Application product key], ASC )\nRETURN IF ( NOT ISBLANK ( _current ), INT ( CONTAINS ( _top, 'DimDetectedApplication'[Application product key], _current ) ) )",
            "formatString": "0",
            "lineageTag": "5dd9ac89-d86d-4b72-90b5-98203ae68f61"
          }
        ]
      },
