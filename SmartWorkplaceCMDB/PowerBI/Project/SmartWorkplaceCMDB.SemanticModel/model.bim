            "name": "FactEndpointAnalyticsUpgradeEligibility",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactEndpointAnalyticsUpgradeEligibility\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantUpgradeEligibilityDeviceKey\", dataType=\"String\"], [name=\"MetricId\", dataType=\"String\"], [name=\"MetricDeviceId\", dataType=\"String\"], [name=\"DeviceId\", dataType=\"String\"], [name=\"DeviceIdSource\", dataType=\"String\"], [name=\"DeviceName\", dataType=\"String\"], [name=\"UpgradeEligibility\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"], [name=\"SourceSystem\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Selected upgrade eligibility devices",
            "description": "Distinct readiness records linked by exact Intune device identifier to the filtered device population.",
            "expression": "VAR _deviceKeys = VALUES('DimDevice'[TenantDeviceKey]) VAR _intuneIds = CALCULATETABLE(VALUES('DeviceSource'[SourceObjectId]), TREATAS(_deviceKeys, 'DeviceSource'[TenantDeviceKey]), KEEPFILTERS('DeviceSource'[SourceSystem] = \"Intune\")) RETURN CALCULATE(DISTINCTCOUNT('FactEndpointAnalyticsUpgradeEligibility'[DeviceId]), TREATAS(_intuneIds, 'FactEndpointAnalyticsUpgradeEligibility'[DeviceId]))",
            "formatString": "#,0",
            "lineageTag": "302a86cd-31e3-4dee-a72c-2e7d7b18ad0a"
          },
          {
            "name": "Upgrade eligibility rate",
            "description": "Share of each reported Windows upgrade-eligibility state within exact matched Intune devices.",
            "expression": "DIVIDE([Selected upgrade eligibility devices], CALCULATE([Selected upgrade eligibility devices], REMOVEFILTERS('FactEndpointAnalyticsUpgradeEligibility'[UpgradeEligibility])))",
            "formatString": "0.0%",
            "lineageTag": "f9f2bd24-2dc1-4f66-963b-2470e61d87e9"
          }
        ]
      },
