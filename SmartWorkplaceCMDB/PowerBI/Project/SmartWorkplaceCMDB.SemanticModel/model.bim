          {
            "name": "Average Endpoint Analytics score",
            "description": "Arithmetic mean of the source-reported Endpoint Analytics device score across rows with a value.",
            "expression": "AVERAGE('FactEndpointAnalyticsDevice'[EndpointAnalyticsScore])",
