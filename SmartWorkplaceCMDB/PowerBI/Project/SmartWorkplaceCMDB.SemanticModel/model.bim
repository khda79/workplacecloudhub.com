        "partitions": [
          {
            "name": "SourceHealth",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"SourceHealth\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"SourceName\", dataType=\"String\"], [name=\"Status\", dataType=\"String\"], [name=\"Coverage\", dataType=\"String\"], [name=\"SourceRows\", dataType=\"Int64\"], [name=\"MaxItems\", dataType=\"Int64\"], [name=\"StartedDateTime\", dataType=\"DateTime\"], [name=\"CompletedDateTime\", dataType=\"DateTime\"], [name=\"Evidence\", dataType=\"String\"], [name=\"SourceRowsLabel\", dataType=\"String\"], [name=\"CompletedDateTimeLabel\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Source feeds",
            "description": "Configured source feeds represented in SourceHealth for the frozen snapshot.",
            "expression": "COALESCE(COUNTROWS('SourceHealth'), 0)",
            "formatString": "#,0",
            "lineageTag": "f0f1fdb5-6001-4db5-a565-875f1c7955f0"
          },
          {
            "name": "Collected source feeds",
            "description": "Source feeds whose collection status is explicitly Completed. Completed is not tenant certification.",
            "expression": "CALCULATE([Source feeds], KEEPFILTERS('SourceHealth'[Status] == \"Completed\"))",
            "formatString": "#,0",
            "lineageTag": "18a96dc8-b908-4361-baa0-6f77041d76ba"
          },
          {
            "name": "Missing source feeds",
            "description": "Source feeds not explicitly completed in the frozen snapshot.",
            "expression": "MAX(0, [Source feeds] - [Collected source feeds])",
            "formatString": "#,0",
            "lineageTag": "f68aa263-60a1-4b80-9a37-4f77865af04c"
          },
          {
            "name": "Source collection coverage",
            "description": "Completed source feeds divided by represented source feeds. This is collection coverage, not a composite CMDB quality score.",
            "expression": "DIVIDE([Collected source feeds], [Source feeds])",
            "formatString": "0.0%",
            "lineageTag": "2b446e12-66ec-4382-ad0b-9e0459042b1d"
          }
        ]
      },
