        "partitions": [
          {
            "name": "LicenseAssignmentPath",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"LicenseAssignmentPath\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantAssignmentPathKey\", dataType=\"String\"], [name=\"TenantUserKey\", dataType=\"String\"], [name=\"TenantGroupKey\", dataType=\"String\"], [name=\"TenantSkuKey\", dataType=\"String\"], [name=\"SourceUserId\", dataType=\"String\"], [name=\"AssignedByGroupId\", dataType=\"String\"], [name=\"SkuId\", dataType=\"String\"], [name=\"Account\", dataType=\"String\"], [name=\"Product\", dataType=\"String\"], [name=\"AssignmentRoute\", dataType=\"String\"], [name=\"GroupName\", dataType=\"String\"], [name=\"AssignmentState\", dataType=\"String\"], [name=\"AssignmentError\", dataType=\"String\"], [name=\"ErrorStatus\", dataType=\"String\"], [name=\"DisabledPlanIds\", dataType=\"String\"], [name=\"AssignmentUpdatedRaw\", dataType=\"String\"], [name=\"AssignmentUpdatedUtcDateTime\", dataType=\"DateTime\"], [name=\"AssignmentUpdatedStatus\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"], [name=\"GroupLinkStatus\", dataType=\"String\"], [name=\"UserLinkStatus\", dataType=\"String\"], [name=\"SkuLinkStatus\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Assignment paths",
            "description": "Individual direct/group assignment paths, not distinct user/SKU pairs.",
            "expression": "COALESCE(COUNTROWS('LicenseAssignmentPath'),0)",
            "formatString": "#,0",
            "lineageTag": "17f1d099-4177-4138-9d9c-2e6b85db087e"
          },
          {
            "name": "Group assignment paths",
            "description": "Observed group-based paths, not membership or effective access.",
            "expression": "CALCULATE([Assignment paths], KEEPFILTERS('LicenseAssignmentPath'[AssignmentRoute] == \"Group\"))",
            "formatString": "#,0",
            "lineageTag": "948082ce-0c20-4137-a408-4b002ed109ec"
          },
          {
            "name": "Direct assignment paths",
            "description": "Observed direct assignment paths.",
            "expression": "CALCULATE([Assignment paths], KEEPFILTERS('LicenseAssignmentPath'[AssignmentRoute] == \"Direct\"))",
            "formatString": "#,0",
            "lineageTag": "5640cd13-9e72-4ad2-9dbf-ef692e39cb5c"
          },
          {
            "name": "Assignment paths with errors",
            "description": "Paths reporting an error; another path may still supply the entitlement.",
            "expression": "CALCULATE([Assignment paths], KEEPFILTERS('LicenseAssignmentPath'[ErrorStatus] == \"Error reported\"))",
            "formatString": "#,0",
            "lineageTag": "a4401d1f-d1cf-4ef2-9131-be174d5cb876"
          },
          {
            "name": "Assignment error rate",
            "description": "Assignment paths reporting an error divided by all observed assignment paths. Another path may still supply the entitlement.",
            "expression": "DIVIDE([Assignment paths with errors], [Assignment paths])",
            "formatString": "0.000%",
            "lineageTag": "20e9746c-ad87-49f1-bab0-bbd772ddaabd"
          },
          {
            "name": "User assignment details",
            "description": "Detail rows only when exactly one user is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimUser')) = 1, COUNTROWS('LicenseAssignmentPath'))",
            "formatString": "#,0",
            "lineageTag": "b4ab01a1-2e8c-4fde-807d-1b0290627906"
          },
          {
            "name": "Group assignment details",
            "description": "Detail rows only when exactly one group is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimGroup')) = 1, COUNTROWS('LicenseAssignmentPath'))",
            "formatString": "#,0",
            "lineageTag": "37010a8e-92b8-4658-b33d-12c77cedcbd1"
          },
          {
            "name": "Assignment route rate",
            "description": "Share of each observed license-assignment route.",
            "expression": "DIVIDE([Assignment paths], CALCULATE([Assignment paths], REMOVEFILTERS('LicenseAssignmentPath'[AssignmentRoute])))",
            "formatString": "0.0%",
            "lineageTag": "aef8b667-95c0-4558-87bb-5cf1519e37fd"
          }
        ]
      },
