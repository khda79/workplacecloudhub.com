          {
            "name": "DimSharePointSite",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimSharePointSite\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantSiteKey\", dataType=\"String\"], [name=\"SiteId\", dataType=\"String\"], [name=\"SiteUrl\", dataType=\"String\"], [name=\"SiteName\", dataType=\"String\"], [name=\"OwnerPrincipalName\", dataType=\"String\"], [name=\"LastActivityDate\", dataType=\"DateTime\"], [name=\"ActivityState\", dataType=\"String\"], [name=\"StorageUsedBytes\", dataType=\"Double\"], [name=\"StorageAllocatedBytes\", dataType=\"Double\"], [name=\"RootWebTemplate\", dataType=\"String\"], [name=\"IsDeleted\", dataType=\"Boolean\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "SharePoint sites",
            "description": "Distinct SharePoint sites from the Microsoft 365 D180 site-usage report; OneDrive personal sites are excluded.",
            "expression": "DISTINCTCOUNT('DimSharePointSite'[TenantSiteKey])",
            "formatString": "#,0",
            "lineageTag": "54596a02-0838-4cfc-a555-dbdfff594c56"
          },
          {
            "name": "Active SharePoint sites",
            "description": "SharePoint sites with activity reported within 90 days.",
            "expression": "CALCULATE([SharePoint sites], KEEPFILTERS('DimSharePointSite'[ActivityState] = \"Active (90d)\"))",
            "formatString": "#,0",
            "lineageTag": "c681323f-d5be-428d-ac95-1a9cfcfad3c2"
          },
          {
            "name": "SharePoint active rate",
            "description": "SharePoint sites active within 90 days divided by all reported SharePoint sites.",
            "expression": "DIVIDE([Active SharePoint sites], [SharePoint sites])",
            "formatString": "0.0%",
            "lineageTag": "1e25fc68-5107-472f-9a06-968ce694791c"
          },
          {
            "name": "SharePoint activity state rate",
            "description": "Share of SharePoint sites by explicit 90-day activity state.",
            "expression": "DIVIDE([SharePoint sites], CALCULATE([SharePoint sites], REMOVEFILTERS('DimSharePointSite'[ActivityState])))",
            "formatString": "0.0%",
            "lineageTag": "2021c610-7c61-4e25-b1d5-086ca607855e"
          },
          {
            "name": "SharePoint storage used GB",
            "description": "Total reported SharePoint site storage in GiB.",
            "expression": "DIVIDE(SUM('DimSharePointSite'[StorageUsedBytes]), 1073741824)",
            "formatString": "#,0.0",
            "lineageTag": "c884da41-4255-4bf8-a2a5-9a420f5987bc"
          },
          {
            "name": "SharePoint storage utilization",
            "description": "Reported SharePoint storage used divided by reported allocated storage.",
            "expression": "DIVIDE(SUM('DimSharePointSite'[StorageUsedBytes]), SUM('DimSharePointSite'[StorageAllocatedBytes]))",
            "formatString": "0.0%",
            "lineageTag": "4b50be09-3a21-4991-a263-a34c5fbad562"
          }
        ]
      },
