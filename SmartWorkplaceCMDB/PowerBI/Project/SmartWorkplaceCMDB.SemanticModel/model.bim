        "measures": [
          {
            "name": "Mailboxes",
            "description": "All exported mailboxes, including technical and shared mailboxes.",
            "expression": "COALESCE(COUNTROWS('FactMailbox'),0)",
            "formatString": "#,0",
            "lineageTag": "1473458e-bc64-4a8d-affb-9702a43186ca"
          },
          {
            "name": "Mailboxes without a resolved user",
            "description": "Includes technical mailboxes; a missing user link is not always an issue.",
            "expression": "CALCULATE([Mailboxes], KEEPFILTERS(ISBLANK('FactMailbox'[TenantUserKey])))",
            "formatString": "#,0",
            "lineageTag": "99bc079c-8e1e-4b52-8e13-2370103b4e4c"
          },
          {
            "name": "Mailbox link gap rate",
            "description": "Mailboxes without a resolved user divided by all mailboxes. Technical and shared mailboxes can be legitimate.",
            "expression": "DIVIDE([Mailboxes without a resolved user], [Mailboxes])",
            "formatString": "0.000%",
            "lineageTag": "13a4d01f-767b-4952-8c08-75a5a6955600"
          },
          {
            "name": "User mailbox details",
            "description": "Detail rows only when exactly one user is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimUser')) = 1, COUNTROWS('FactMailbox'))",
            "formatString": "#,0",
            "lineageTag": "7d7b7e09-2af5-4152-a7c9-3ae0c1790dfe"
          }
        ]
