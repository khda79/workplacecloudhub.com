        "partitions": [
          {
            "name": "DeviceHardware",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DeviceHardware\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantDeviceKey\", dataType=\"String\"], [name=\"ManagedDeviceId\", dataType=\"String\"], [name=\"SerialNumber\", dataType=\"String\"], [name=\"Manufacturer\", dataType=\"String\"], [name=\"Model\", dataType=\"String\"], [name=\"Storage\", dataType=\"String\"], [name=\"PhysicalMemoryGiB\", dataType=\"Double\"], [name=\"StorageStatus\", dataType=\"String\"], [name=\"MemoryStatus\", dataType=\"String\"], [name=\"HardwareCollectedDateTime\", dataType=\"DateTime\"], [name=\"InventoryCollectedDateTime\", dataType=\"DateTime\"], [name=\"CollectionCoverage\", dataType=\"String\"], [name=\"CollectionMode\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Hardware records",
            "description": "Native hardware inventory rows/device identities in the selected fleet and Country. Missing attributes do not become zero.",
            "expression": "VAR _countries = VALUES ( 'DimCountry'[CountryLabel] )\nRETURN IF ( ISCROSSFILTERED ( 'DimCountry' ), CALCULATE ( COALESCE ( COUNTROWS ( 'DeviceHardware' ), 0 ), KEEPFILTERS ( TREATAS ( _countries, 'DimDevice'[CountryLabel] ) ) ), COALESCE ( COUNTROWS ( 'DeviceHardware' ), 0 ) )",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "a55d0cc1-a7e0-43eb-ab4d-1a57db134678"
          },
          {
            "name": "Devices with hardware",
            "description": "Native hardware inventory rows/device identities in the selected fleet and Country. Missing attributes do not become zero.",
            "expression": "VAR _countries = VALUES ( 'DimCountry'[CountryLabel] )\nRETURN IF ( ISCROSSFILTERED ( 'DimCountry' ), CALCULATE ( COALESCE ( DISTINCTCOUNT ( 'DeviceHardware'[TenantDeviceKey] ), 0 ), KEEPFILTERS ( TREATAS ( _countries, 'DimDevice'[CountryLabel] ) ) ), COALESCE ( DISTINCTCOUNT ( 'DeviceHardware'[TenantDeviceKey] ), 0 ) )",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "d05a5334-9f8a-4938-8c7f-95b2e49aea34"
          },
          {
            "name": "Devices without hardware",
            "description": "Imported scoped devices with no hardware row; distinguishes row coverage from attribute completeness.",
            "expression": "MAX ( 0, [Devices] - [Devices with hardware] )",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "f674ae02-f03c-4805-819d-ffca31ae20dc"
          },
          {
            "name": "Hardware detail rows",
            "description": "Current device filter; separate native records are retained. Coverage does not prove hardware freshness.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimDevice')) = 1, COUNTROWS('DeviceHardware'))",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "11d2cbaf-a940-4141-8bce-5693080dbc17"
          },
          {
            "name": "Hardware source message",
            "description": "Current device filter; separate native records are retained. Coverage does not prove hardware freshness.",
            "expression": "VAR _status = SELECTEDVALUE('HardwareCoverage'[Status], \"NotProvided\") RETURN IF(_status = \"NotProvided\", \"Hardware source not supplied. Existing inventory is retained; hardware attributes are unavailable.\", IF(COUNTROWS(ALLSELECTED('DimDevice')) <> 1, \"Select one device to inspect its hardware. Coverage: \" & SELECTEDVALUE('HardwareCoverage'[Coverage]) & \".\", IF([Hardware records] = 0, \"No hardware record for this device in the supplied snapshot.\", \"Source-reported hardware. Missing values remain unknown; each source retains its own collection date.\")))",
            "formatString": "@",
            "displayFolder": "Hardware",
            "lineageTag": "8cc3ac98-a228-4575-9ea8-e70fdf5f48cd"
          },
          {
            "name": "Hardware covered devices",
            "description": "Distinct devices with a hardware record in the current DimDevice scope. Hardware-attribute selections are excluded from this coverage numerator.",
            "expression": "CALCULATE([Devices with hardware], REMOVEFILTERS('DeviceHardware'[Manufacturer]), REMOVEFILTERS('DeviceHardware'[Model]), REMOVEFILTERS('DeviceHardware'[SerialNumber]), REMOVEFILTERS('DeviceHardware'[Storage]))",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "85c256a8-3b1b-4f7f-b1fe-e9101e69a230"
          },
          {
            "name": "Hardware uncovered devices",
            "description": "Devices in the current DimDevice scope minus covered devices. The denominator is the filtered device inventory, not hardware records.",
            "expression": "MAX(0, [Devices] - [Hardware covered devices])",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "b59fc375-7d2c-4716-8806-ce4b86717ca4"
          },
          {
            "name": "Hardware coverage rate",
            "description": "Covered devices divided by devices in the current DimDevice scope. Hardware-attribute selections do not change the coverage numerator.",
            "expression": "DIVIDE([Hardware covered devices], [Devices])",
            "formatString": "0.0%",
            "displayFolder": "Hardware",
            "lineageTag": "2602bb80-ef20-4e60-a268-18239fd33c9e"
          },
          {
            "name": "Missing serial records",
            "description": "Hardware records whose source serial status was Missing. This is distinct from a reported value and never defines identity or ownership.",
            "expression": "CALCULATE([Hardware records], KEEPFILTERS('DeviceHardware'[SerialNumber] = \"Not provided\"))",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "f924973b-a70a-4032-9a7b-e92f1a9e8699"
          },
          {
            "name": "Missing manufacturer records",
            "description": "Hardware records whose source manufacturer status was Missing.",
            "expression": "CALCULATE([Hardware records], KEEPFILTERS('DeviceHardware'[Manufacturer] = \"Not provided\"))",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "64d3bba5-d53b-4718-b1a3-8f5384930c97"
          },
          {
            "name": "Missing model records",
            "description": "Hardware records whose source model status was Missing.",
            "expression": "CALCULATE([Hardware records], KEEPFILTERS('DeviceHardware'[Model] = \"Not provided\"))",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "1e26eaea-38fa-4f93-8c3e-6ad919e0e480"
          },
          {
            "name": "Zero-reported storage records",
            "description": "Hardware records where the source explicitly reported zero storage. This is not a missing value.",
            "expression": "CALCULATE([Hardware records], KEEPFILTERS('DeviceHardware'[Storage] = \"Unknown (reported 0)\"))",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "22eb2532-1eec-4347-96a5-c53b4b052d3d"
          },
          {
            "name": "Repeated serial values",
            "description": "Distinct non-missing serial values appearing on more than one hardware record in the current filter. Records remain separate; serial never defines identity or ownership.",
            "expression": "VAR _serials = FILTER(ADDCOLUMNS(VALUES('DeviceHardware'[SerialNumber]), \"_RecordCount\", CALCULATE(COUNTROWS('DeviceHardware'))), 'DeviceHardware'[SerialNumber] <> \"Not provided\" && [_RecordCount] > 1) RETURN COUNTROWS(_serials)",
            "formatString": "#,0",
            "displayFolder": "Hardware",
            "lineageTag": "f6a864b9-0341-4ec8-80d6-7ac8134b68eb"
          },
          {
            "name": "Hardware fleet rows",
            "description": "Native hardware inventory rows/device identities in the selected fleet and Country. Missing attributes do not become zero.",
            "expression": "VAR _countries = VALUES ( 'DimCountry'[CountryLabel] )\nRETURN IF ( ISCROSSFILTERED ( 'DimCountry' ), CALCULATE ( COUNTROWS ( 'DeviceHardware' ), KEEPFILTERS ( TREATAS ( _countries, 'DimDevice'[CountryLabel] ) ) ), COUNTROWS ( 'DeviceHardware' ) )",
            "formatString": "#,0",
            "isHidden": true,
            "displayFolder": "Hardware",
            "lineageTag": "64c170f6-046e-44da-a708-f6582e624cc7"
          },
          {
            "name": "Hardware data gap rate",
            "description": "Devices without a hardware record divided by all devices in the current DimDevice scope.",
            "expression": "DIVIDE([Hardware uncovered devices], [Devices])",
            "formatString": "0.0%",
            "displayFolder": "Cockpit DSI",
            "lineageTag": "c9131657-fb55-41ba-b6a4-3eab3739e35f"
          },
          {
            "name": "Manufacturer record rate",
            "description": "Share of source-reported hardware records by manufacturer.",
            "expression": "DIVIDE([Hardware records], CALCULATE([Hardware records], REMOVEFILTERS('DeviceHardware'[Manufacturer])))",
            "formatString": "0.0%",
            "lineageTag": "ffe26008-cf9f-4ccf-a6a6-e1c92413374a"
          }
        ]
      },
