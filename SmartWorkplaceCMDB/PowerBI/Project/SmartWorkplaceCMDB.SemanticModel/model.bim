          },
          {
            "type": "calculated",
            "name": "Device form factor",
            "dataType": "string",
            "description": "Executive device grouping inferred from OperatingSystem: Windows is PC; Android and iOS families are Mobile; all other or missing values are Unclassified.",
            "expression": "VAR _os = COALESCE ( 'DimDevice'[OperatingSystem], \"\" )\nRETURN\n    SWITCH (\n        TRUE (),\n        _os = \"Windows\", \"PC\",\n        _os IN { \"Android\", \"AndroidEnterprise\", \"AndroidForWork\", \"iOS\" }, \"Mobile\",\n        \"Unclassified\"\n    )",
            "lineageTag": "777892b9-2645-4217-9fb8-669ed16c9ac1",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Windows version group",
            "dataType": "string",
            "description": "Windows adoption grouping inferred from OperatingSystemVersion. Build 22000 or later is Windows 11; older recognized Windows builds are Other Windows; missing or unparseable versions remain Unknown version. Non-Windows rows are blank.",
            "expression": "VAR _os = COALESCE ( 'DimDevice'[OperatingSystem], \"\" )\nVAR _version = COALESCE ( 'DimDevice'[OperatingSystemVersion], \"\" )\nVAR _isNumericVersion = LEFT ( _version, 5 ) = \"10.0.\"\nVAR _build =\n    IF (\n        _isNumericVersion,\n        IFERROR (\n            VALUE ( PATHITEM ( SUBSTITUTE ( _version, \".\", \"|\" ), 3, INTEGER ) ),\n            BLANK ()\n        )\n    )\nRETURN\n    SWITCH (\n        TRUE (),\n        _os <> \"Windows\", BLANK (),\n        _version = \"Windows 11\" || _build >= 22000, \"Windows 11\",\n        _version = \"Windows 10\" || _build > 0, \"Other Windows\",\n        \"Unknown version\"\n    )",
            "lineageTag": "7e6d3db7-74bf-456a-914e-b1888b1aff9f",
            "summarizeBy": "none"
          },
          {
            "type": "calculated",
            "name": "Device ownership group",
            "dataType": "string",
            "description": "Executive ownership grouping: Corporate and Personal remain distinct; missing, Not provided, and Unknown values are retained as Unknown / missing.",
            "expression": "VAR _ownership = COALESCE ( 'DimDevice'[Ownership], \"\" )\nRETURN\n    SWITCH (\n        TRUE (),\n        _ownership = \"Corporate\", \"Corporate\",\n        _ownership = \"Personal\", \"Personal\",\n        \"Unknown / missing\"\n    )",
            "lineageTag": "e903a26f-7fb1-4ac7-a3f1-78c699c6df97",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DimDevice",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimDevice\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantDeviceKey\", dataType=\"String\"], [name=\"CmdbDeviceId\", dataType=\"String\"], [name=\"DeviceName\", dataType=\"String\"], [name=\"OperatingSystem\", dataType=\"String\"], [name=\"OperatingSystemVersion\", dataType=\"String\"], [name=\"Ownership\", dataType=\"String\"], [name=\"ComplianceState\", dataType=\"String\"], [name=\"EncryptionState\", dataType=\"String\"], [name=\"ManagementState\", dataType=\"String\"], [name=\"ConfidenceScore\", dataType=\"Double\"], [name=\"DeviceNameLabel\", dataType=\"String\"], [name=\"OperatingSystemLabel\", dataType=\"String\"], [name=\"OperatingSystemVersionLabel\", dataType=\"String\"], [name=\"OwnershipLabel\", dataType=\"String\"], [name=\"ComplianceStateLabel\", dataType=\"String\"], [name=\"EncryptionStateLabel\", dataType=\"String\"], [name=\"ManagementStateLabel\", dataType=\"String\"], [name=\"DeviceSelection\", dataType=\"String\"], [name=\"SourceDeviceId\", dataType=\"String\"], [name=\"SourceSystems\", dataType=\"String\"], [name=\"AssociatedAccount\", dataType=\"String\"], [name=\"AssociationStatus\", dataType=\"String\"], [name=\"CountryCode\", dataType=\"String\"], [name=\"CountryLabel\", dataType=\"String\"], [name=\"CountryStatus\", dataType=\"String\"], [name=\"PrimaryUserSourceId\", dataType=\"String\"], [name=\"SyncRaw\", dataType=\"String\"], [name=\"SyncUtcDateTime\", dataType=\"DateTime\"], [name=\"SyncStatus\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Devices",
            "description": "Distinct imported device identities in the selected fleet and Country. Directory objects are not proof of active physical endpoints.",
            "expression": "VAR _countries = VALUES ( 'DimCountry'[CountryLabel] )\nRETURN IF ( ISCROSSFILTERED ( 'DimCountry' ), CALCULATE ( COALESCE ( DISTINCTCOUNT ( 'DimDevice'[TenantDeviceKey] ), 0 ), KEEPFILTERS ( TREATAS ( _countries, 'DimDevice'[CountryLabel] ) ) ), COALESCE ( DISTINCTCOUNT ( 'DimDevice'[TenantDeviceKey] ), 0 ) )",
            "formatString": "#,0",
            "lineageTag": "4eaa6aaa-e552-4c7f-b998-8137fe9654ca"
          },
          {
            "name": "Compliant devices",
            "description": "State explicitly reported as compliant in the export.",
            "expression": "CALCULATE([Devices], KEEPFILTERS('DimDevice'[ComplianceState] == \"compliant\"))",
            "formatString": "#,0",
            "lineageTag": "63442bcb-3429-43cd-a475-20d2eb5d4d5a"
          },
          {
            "name": "Noncompliant devices",
            "description": "State explicitly reported as noncompliant; missing states are not classified as noncompliant.",
            "expression": "CALCULATE([Devices], KEEPFILTERS('DimDevice'[ComplianceState] == \"noncompliant\"))",
            "formatString": "#,0",
            "lineageTag": "f76988b1-77e2-4d02-a23d-12764687fa0a"
          },
          {
            "name": "Compliant device share",
            "description": "Compliant devices / all filtered devices, including unknown states in the denominator.",
            "expression": "DIVIDE([Compliant devices], [Devices])",
            "formatString": "0.0%",
            "lineageTag": "19abc54a-94cf-43a1-a9d9-0439cee44146"
          },
          {
            "name": "Managed devices",
            "description": "Devices whose exported management state is explicitly Managed. This does not prove current Intune enrollment or activity.",
            "expression": "CALCULATE([Devices], KEEPFILTERS('DimDevice'[ManagementState] == \"Managed\"))",
            "formatString": "#,0",
            "lineageTag": "0bf4abc7-3db7-45e9-a6fb-e6988b62a13e"
          },
          {
            "name": "Unmanaged devices",
            "description": "Devices whose exported management state is explicitly Unmanaged.",
            "expression": "CALCULATE([Devices], KEEPFILTERS('DimDevice'[ManagementState] == \"Unmanaged\"))",
            "formatString": "#,0",
            "lineageTag": "bfa8b650-fc96-46ab-991c-166afcbb81b0"
          },
          {
            "name": "Devices with missing management state",
            "description": "Devices without a management state in the frozen snapshot; they are not classified as unmanaged.",
            "expression": "CALCULATE([Devices], KEEPFILTERS(ISBLANK('DimDevice'[ManagementState])))",
            "formatString": "#,0",
            "lineageTag": "140f2acf-f188-45f6-8dee-34146e607b56"
          },
          {
            "name": "Managed device share",
            "description": "Explicitly managed devices divided by all filtered devices. Missing management states remain in the denominator.",
            "expression": "DIVIDE([Managed devices], [Devices])",
            "formatString": "0.0%",
            "lineageTag": "eaacb0f9-d2a2-4ece-bc6b-c0449763d791"
          },
          {
            "name": "Other or missing compliance devices",
            "description": "Devices not explicitly classified as compliant or noncompliant, including missing, unknown and grace-period states.",
            "expression": "MAX(0, [Devices] - [Compliant devices] - [Noncompliant devices])",
            "formatString": "#,0",
            "lineageTag": "91d01e65-c13b-4be6-8326-b0c40db56086"
          },
          {
            "name": "Corporate devices",
            "description": "Corporate devices in the current country and device context. The ownership slicer is intentionally ignored so this remains a corporate-only metric.",
            "expression": "CALCULATE([Devices], REMOVEFILTERS('DimDevice'[Ownership]), 'DimDevice'[Ownership] == \"Corporate\")",
            "formatString": "#,0",
            "lineageTag": "6b538b12-aaa3-478f-b5c1-5498281b14b0"
          },
          {
            "name": "Corporate device country share",
            "description": "Corporate imported-device share across countries; keeps other fleet filters.",
            "expression": "DIVIDE ( [Corporate devices], CALCULATE ( [Corporate devices], REMOVEFILTERS ( 'DimCountry' ), REMOVEFILTERS ( 'DimDevice'[CountryCode], 'DimDevice'[CountryLabel], 'DimDevice'[CountryStatus] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "2b0ccabf-32e6-4faa-b0ba-289a07662488"
          },
          {
            "name": "Device details",
            "description": "Detail rows only when exactly one device is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimDevice')) = 1, COUNTROWS('DimDevice'))",
            "formatString": "#,0",
            "lineageTag": "8b255e5c-e071-4b53-a16c-b928fbae4a8c"
          },
          {
            "name": "Compliance state rate",
            "description": "Share of each compliance state in the filtered device population.",
            "expression": "DIVIDE([Devices], CALCULATE([Devices], REMOVEFILTERS('DimDevice'[ComplianceStateLabel])))",
            "formatString": "0.0%",
            "lineageTag": "c0e8e344-d126-4b23-9d50-11e640c18cd5"
          },
          {
            "name": "Operating system rate",
            "description": "Share of each operating-system family in the filtered device population.",
            "expression": "DIVIDE([Devices], CALCULATE([Devices], REMOVEFILTERS('DimDevice'[OperatingSystemLabel])))",
            "formatString": "0.0%",
            "lineageTag": "1fdfc2a0-0c10-4980-ac57-bc85374d8fc8"
          },
          {
            "name": "Management state rate",
            "description": "Share of each management state in the filtered device population.",
            "expression": "DIVIDE([Devices], CALCULATE([Devices], REMOVEFILTERS('DimDevice'[ManagementStateLabel])))",
            "formatString": "0.0%",
            "lineageTag": "54796fa0-f453-4c17-8100-7e8586462ccf"
          },
          {
            "name": "Ownership rate",
            "description": "Share of each ownership state in the filtered device population.",
            "expression": "DIVIDE([Devices], CALCULATE([Devices], REMOVEFILTERS('DimDevice'[OwnershipLabel])))",
            "formatString": "0.0%",
            "lineageTag": "962aa128-f911-4f63-8231-115baea327ba"
          }
        ]
      },
      {
        "name": "DimGroup",
