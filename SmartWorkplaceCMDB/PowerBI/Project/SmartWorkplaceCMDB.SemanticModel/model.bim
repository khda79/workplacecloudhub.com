          {
            "name": "FactUserDeviceRelationship",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactUserDeviceRelationship\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantRelationshipKey\", dataType=\"String\"], [name=\"TenantUserKey\", dataType=\"String\"], [name=\"TenantDeviceKey\", dataType=\"String\"], [name=\"CmdbRelationshipId\", dataType=\"String\"], [name=\"CmdbUserId\", dataType=\"String\"], [name=\"CmdbDeviceId\", dataType=\"String\"], [name=\"RelationshipType\", dataType=\"String\"], [name=\"ConfidenceScore\", dataType=\"Double\"], [name=\"SourceSystem\", dataType=\"String\"], [name=\"Account\", dataType=\"String\"], [name=\"Device\", dataType=\"String\"], [name=\"DeviceSelection\", dataType=\"String\"], [name=\"DeviceCompliance\", dataType=\"String\"], [name=\"DeviceSyncStatus\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "User-device links",
            "description": "Resolved relationships between a user and a device.",
            "expression": "COALESCE(COUNTROWS('FactUserDeviceRelationship'),0)",
            "formatString": "#,0",
            "lineageTag": "f9c538eb-7bd4-4063-9f59-e6dbaf33a0f5"
          },
          {
            "name": "Devices with a resolved user",
            "description": "Distinct devices with a resolved user relationship.",
            "expression": "COALESCE(DISTINCTCOUNTNOBLANK('FactUserDeviceRelationship'[TenantDeviceKey]),0)",
            "formatString": "#,0",
            "lineageTag": "cb334dd1-4bc7-42c9-bb2f-a7734d9e3e56"
          },
          {
            "name": "Users with a resolved device",
            "description": "Distinct users with at least one resolved device relationship.",
            "expression": "COALESCE(DISTINCTCOUNTNOBLANK('FactUserDeviceRelationship'[TenantUserKey]),0)",
            "formatString": "#,0",
            "lineageTag": "2d03df41-0e23-4104-92b7-129897eaa5e3"
          },
          {
            "name": "Device user-link coverage",
            "description": "Devices with at least one resolved user relationship divided by all filtered devices. A relationship does not prove exclusive ownership.",
            "expression": "DIVIDE([Devices with a resolved user], [Devices])",
            "formatString": "0.0%",
            "lineageTag": "9aba52f0-e1f7-4ab3-bcba-654f00c11f74"
          },
          {
            "name": "User device-link coverage",
            "description": "Users with at least one resolved device relationship divided by all filtered users.",
            "expression": "DIVIDE([Users with a resolved device], [Users])",
            "formatString": "0.0%",
            "lineageTag": "02e8a7cf-0249-423e-8085-723faa7b3a65"
          },
          {
            "name": "User device details",
            "description": "Detail rows only when exactly one user is selected outside visual row grouping. Blank otherwise.",
            "expression": "IF(COUNTROWS(ALLSELECTED('DimUser')) = 1, COUNTROWS('FactUserDeviceRelationship'))",
            "formatString": "#,0",
            "lineageTag": "e006ca0b-44f1-4f10-a35b-e0c1b1cb64ef"
          },
          {
            "name": "User-device relationship type rate",
            "description": "Share of each observed user-device relationship type.",
            "expression": "DIVIDE([User-device links], CALCULATE([User-device links], REMOVEFILTERS('FactUserDeviceRelationship'[RelationshipType])))",
            "formatString": "0.0%",
            "lineageTag": "25214da0-bf3d-4069-af7b-432c628ce36c"
          }
        ]
      },
