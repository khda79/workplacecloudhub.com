              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"TopApplication\"), {[name=\"ApplicationProduct\", dataType=\"String\"], [name=\"DisplayName\", dataType=\"String\"], [name=\"Publisher\", dataType=\"String\"], [name=\"Platform\", dataType=\"String\"], [name=\"VersionCount\", dataType=\"Int64\"], [name=\"ReportedDeviceCount\", dataType=\"Int64\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Top application occurrences",
            "description": "Source-reported application-device occurrences for the five highest-volume normalized products; not distinct devices.",
            "expression": "SUM('TopApplication'[ReportedDeviceCount])",
            "formatString": "#,0",
            "lineageTag": "c314e4f9-0b44-433d-9984-11ff26a4dbdd"
          },
          {
            "name": "Top application occurrence rate",
            "description": "Share within the five highest-volume normalized application products; source-reported occurrences are not distinct devices.",
            "expression": "DIVIDE([Top application occurrences], CALCULATE([Top application occurrences], REMOVEFILTERS('TopApplication'[ApplicationProduct])))",
            "formatString": "0.0%",
            "lineageTag": "361ad3d8-1021-4f92-a650-42ef38db78e3"
