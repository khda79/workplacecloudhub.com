            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"DimLicenseServicePlan\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantServicePlanKey\", dataType=\"String\"], [name=\"TenantSkuKey\", dataType=\"String\"], [name=\"SkuId\", dataType=\"String\"], [name=\"SkuPartNumber\", dataType=\"String\"], [name=\"ServicePlanId\", dataType=\"String\"], [name=\"ServicePlanName\", dataType=\"String\"], [name=\"ProvisioningStatus\", dataType=\"String\"], [name=\"AppliesTo\", dataType=\"String\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "License service plans",
            "description": "Service plans published by the subscribed Microsoft 365 SKUs in the frozen collection.",
            "expression": "COALESCE(COUNTROWS('DimLicenseServicePlan'),0)",
            "formatString": "#,0",
            "displayFolder": "Licensing",
            "lineageTag": "cc162a70-4c4e-4fd0-ad3b-0ecfaafe8bb6"
          },
          {
            "name": "Service plan provisioning rate",
            "description": "Share of each service-plan provisioning status.",
            "expression": "DIVIDE([License service plans], CALCULATE([License service plans], REMOVEFILTERS('DimLicenseServicePlan'[ProvisioningStatus])))",
            "formatString": "0.0%",
            "lineageTag": "bdee2025-c011-434c-80f1-c6dbfe835bbb"
          }
        ]
      },
