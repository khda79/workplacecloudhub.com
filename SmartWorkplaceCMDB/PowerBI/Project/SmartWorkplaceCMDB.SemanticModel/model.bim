            "name": "Teams with guests",
            "description": "Teams containing at least one exact guest membership.",
            "expression": "CALCULATE(DISTINCTCOUNT('FactTeamMember'[TenantTeamKey]), KEEPFILTERS('FactTeamMember'[UserType] = \"Guest\"))",
            "formatString": "#,0",
