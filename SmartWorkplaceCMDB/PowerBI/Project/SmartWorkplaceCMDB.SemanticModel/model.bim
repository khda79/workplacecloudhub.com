        "partitions": [
          {
            "name": "FactADIntuneCoverage",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "CMDBPreparedTypes(CMDBPreparedRead(CMDBReadBaseUrl, CMDBReadToken, CMDBReadBatch, CMDBExpectedIdentity, \"FactADIntuneCoverage\"), {[name=\"TenantKey\", dataType=\"String\"], [name=\"OrganizationKey\", dataType=\"String\"], [name=\"EnvironmentKey\", dataType=\"String\"], [name=\"TenantId\", dataType=\"String\"], [name=\"TenantADComputerKey\", dataType=\"String\"], [name=\"CmdbAdComputerId\", dataType=\"String\"], [name=\"DeviceName\", dataType=\"String\"], [name=\"Enabled\", dataType=\"Boolean\"], [name=\"OperatingSystem\", dataType=\"String\"], [name=\"OperatingSystemVersion\", dataType=\"String\"], [name=\"TenantDeviceKey\", dataType=\"String\"], [name=\"EntraDeviceId\", dataType=\"String\"], [name=\"IntuneManagedDeviceId\", dataType=\"String\"], [name=\"CoverageState\", dataType=\"String\"], [name=\"MatchMethod\", dataType=\"String\"], [name=\"SourceCollectedDateTime\", dataType=\"DateTime\"]})"
            }
          }
        ],
        "measures": [
          {
            "name": "Enabled AD Windows workstations",
            "description": "Enabled Windows 7/8/10/11 workstation directory objects, excluding Windows Server. Includes native AD objects without DNSHostName; not a count of active physical machines. AD-only objects have no inferred Country/ownership.",
            "expression": "COUNTROWS ( FILTER ( 'FactADIntuneCoverage',\nVAR _os = LOWER ( COALESCE ( 'FactADIntuneCoverage'[OperatingSystem], \"\" ) )\nRETURN 'FactADIntuneCoverage'[Enabled] = TRUE ()\n&& NOT CONTAINSSTRING ( _os, \"server\" )\n&& ( CONTAINSSTRING ( _os, \"windows 7\" ) || CONTAINSSTRING ( _os, \"windows 8\" )\n|| CONTAINSSTRING ( _os, \"windows 10\" ) || CONTAINSSTRING ( _os, \"windows 11\" ) ) ) )",
            "formatString": "#,0",
            "lineageTag": "68faca06-21c8-4124-91a3-cf803a1154fb"
          },
          {
            "name": "AD Windows workstations managed in Intune",
            "description": "Enabled AD workstations linked exactly through AD ObjectSid to Entra onPremisesSecurityIdentifier, then Entra deviceId to Intune azureADDeviceId.",
            "expression": "CALCULATE([Enabled AD Windows workstations], KEEPFILTERS('FactADIntuneCoverage'[CoverageState] = \"Managed in Intune\"))",
            "formatString": "#,0",
            "lineageTag": "c88ea4ea-ecf3-44de-b533-16c1338efb78"
          },
          {
            "name": "AD to Intune coverage rate",
            "description": "Matched Intune coverage of enabled AD Windows workstation objects, using the full workstation-state denominator.",
            "expression": "DIVIDE ( [AD Windows workstations managed in Intune], CALCULATE ( [Enabled AD Windows workstations], REMOVEFILTERS ( 'FactADIntuneCoverage'[CoverageState] ) ) )",
            "formatString": "0.0%",
            "lineageTag": "d35a1a90-816d-442c-abfc-c9a41b003b1f"
          },
          {
            "name": "AD workstation coverage state rate",
            "description": "Share of enabled AD Windows workstations by exact coverage state.",
            "expression": "DIVIDE([Enabled AD Windows workstations], CALCULATE([Enabled AD Windows workstations], REMOVEFILTERS('FactADIntuneCoverage'[CoverageState])))",
            "formatString": "0.0%",
            "lineageTag": "6e2cc84c-7e1f-43d8-ba55-c811abdb4a4a"
          }
        ]
      },
