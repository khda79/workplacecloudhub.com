      {
        "name": "CMDBReportDataRoot",
        "description": "Private local directory containing the validated CMDB ReportData CSVs, including the SmartInventory license email snapshot.",
        "kind": "m",
        "expression": "\"CONFIGURE_PRIVATE_LEGACY_ROOT\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "578b1f32-0b5e-437a-a613-86238e903753"
      },
      {
        "name": "CMDBReadLicenseReportCsv",
        "description": "Read a published SmartM365 license CSV and verify its schema, tenant, and mail snapshot identity.",
        "kind": "m",
        "expression": "(fileName as text, expectedColumns as list, columnTypes as list) as table =>\nlet\n    Allowed = List.Contains({\"M365_Licenses_ReportSummary.csv\", \"M365_Licenses_ReportCandidates.csv\", \"M365_Licenses_ReportGaps.csv\", \"M365_Licenses_ReportSources.csv\"}, fileName),\n    Path = Text.TrimEnd(CMDBLicenseReportRoot, {\"\\\", \"/\"}) & \"\\\" & fileName,\n    Raw = if Allowed then Csv.Document(File.Contents(Path),\n        [Delimiter=\",\", Columns=List.Count(expectedColumns), Encoding=65001,\n         QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error])\n        else error \"Unexpected SmartM365 license report table\",\n    Rows = Table.PromoteHeaders(Raw, [PromoteAllScalars=true]),\n    Checked = if Table.ColumnNames(Rows) = expectedColumns then Rows\n        else error \"SmartM365 license report CSV schema differs from the published contract\",\n    Snapshot = Json.Document(File.Contents(Text.TrimEnd(CMDBLicenseReportRoot, {\"\\\", \"/\"}) & \"\\M365_Licenses_ReportSnapshot.json.txt\")),\n    IdentityChecked = if Table.RowCount(Checked) = 0 or\n        (List.Distinct(Checked[SnapshotId]) = {Snapshot[SnapshotId]} and List.Distinct(Checked[TenantKey]) = {Snapshot[TenantKey]})\n        then Checked else error \"SmartM365 CSV and email snapshot identities differ\",\n    TypedColumns = List.Transform(List.Select(columnTypes, each _{1} <> type text), each _{0}),\n    NonBlank = Table.ReplaceValue(IdentityChecked, \"\", null, Replacer.ReplaceValue, TypedColumns),\n    Typed = Table.TransformColumnTypes(NonBlank, columnTypes, \"en-US\")\nin\n    Typed",
        "lineageTag": "b8bdf2af-13a3-4fa9-82b6-b34945b03bcb"
      },
      {
        "name": "CMDBLicenseReportRoot",
        "description": "Private local SmartM365 DATA-LAST folder synchronized from the published mail snapshot.",
        "kind": "m",
        "expression": "\"CONFIGURE_PRIVATE_LICENSE_ROOT\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]",
        "lineageTag": "b4d40971-e2f1-40b3-85ac-2f2c915bd040"
      }
    ],
