{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workplacecloudhub.com/schemas/SmartWorkplaceCMDB.schema.json",
  "title": "SmartWorkplaceCMDB Schema",
  "type": "object",
  "required": [
    "identity",
    "entities",
    "relationships",
    "powerBI"
  ],
  "properties": {
    "identity": {
      "type": "object",
      "required": [
        "ProfileKey",
        "TenantKey",
        "OrganizationKey",
        "EnvironmentKey"
      ],
      "properties": {
        "ProfileKey": {
          "$ref": "#/$defs/componentKey"
        },
        "TenantKey": {
          "type": "string",
          "minLength": 3,
          "maxLength": 129,
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?-[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        },
        "OrganizationKey": {
          "$ref": "#/$defs/componentKey"
        },
        "EnvironmentKey": {
          "$ref": "#/$defs/componentKey"
        },
        "TenantId": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "powerBI": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "componentKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    }
  }
}
