{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workplacecloudhub.com/schemas/SmartWorkplaceCMDB.schema.json",
  "title": "SmartWorkplaceCMDB Schema",
  "type": "object",
  "required": [
    "entities",
    "relationships",
    "powerBI"
  ],
  "properties": {
    "entities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "powerBI": {
      "type": "object",
      "properties": {
        "tables": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
