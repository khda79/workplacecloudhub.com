# Offline country attribution from explicit tenant rules, never from DNS prefixes.
Set-StrictMode -Version Latest
Import-Module (Join-Path $PSScriptRoot 'CountryEvidence.psm1') -Force -ErrorAction Stop
function Get-AdCountrySetting($Configuration,[string]$Name) {
    if ($null -eq $Configuration) { return $null }
    if ($Configuration -is [Collections.IDictionary]) { return $Configuration[$Name] }
    if ($Configuration.PSObject.Properties[$Name]) { return $Configuration.$Name }
    return $null
}
function New-AdCountryRules {
    [CmdletBinding()]
    param($Configuration,[string]$ExpectedTenantKey)
    $tenant=[string](Get-AdCountrySetting $Configuration 'TenantKey')
    if ($ExpectedTenantKey -and $tenant -cne $ExpectedTenantKey) { throw 'AD country configuration tenant differs from source tenant.' }
    $names=Get-DirectoryCountryNames
    $maps=@{}
    foreach($setting in @('AdDomainCountryMappings','AdComputerNameCountryPrefixes')){
        $map=@{};$inputMap=Get-AdCountrySetting $Configuration $setting
        if($null -ne $inputMap){
            if($inputMap -is [Collections.IDictionary]){$entries=@($inputMap.Keys|ForEach-Object{[pscustomobject]@{Key=$_;Value=$inputMap[$_]}})}
            elseif($inputMap -is [pscustomobject]){$entries=@($inputMap.PSObject.Properties|ForEach-Object{[pscustomobject]@{Key=$_.Name;Value=$_.Value}})}
            else{throw "$setting must be a JSON object."}
            foreach($entry in $entries){
                $key=([string]$entry.Key).Trim();$country=([string]$entry.Value).Trim()
                if($setting -eq 'AdDomainCountryMappings'){
                    $key=$key.TrimEnd('.').ToLowerInvariant()
                    if($key.Length -gt 253 -or $key -notmatch '^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$'){throw 'Invalid exact DNS domain in AD country configuration.'}
                }else{$key=$key.ToUpperInvariant();if($key -cnotmatch '^[A-Z]{2}$'){throw 'AD computer country prefixes must contain exactly two letters.'}}
                if($map.ContainsKey($key)){throw "Duplicate normalized key in $setting."}
                $resolved=Resolve-DirectoryCountry $country
                if(-not $resolved.Code){throw "Unrecognized country in $setting; use an ISO alpha-2 code or Country Reference name."}
                $map[$key]=$resolved.Code
            }
        }
        $maps[$setting]=$map
    }
    [pscustomobject]@{TenantKey=$tenant;Domains=$maps.AdDomainCountryMappings;Prefixes=$maps.AdComputerNameCountryPrefixes;Names=$names}
}
function Read-AdCountryRules {
    [CmdletBinding()]
    param([string]$Path,[Parameter(Mandatory)][string]$ExpectedTenantKey)
    if(-not $Path){return New-AdCountryRules -Configuration @{TenantKey=$ExpectedTenantKey} -ExpectedTenantKey $ExpectedTenantKey}
    # This file is a minimal private snapshot supplied by the preparation pipeline, not a tenant-profile loader.
    $hash=(Get-FileHash -LiteralPath $Path).Hash
    $configuration=Get-Content -LiteralPath $Path -Raw|ConvertFrom-Json
    $rules=New-AdCountryRules -Configuration $configuration -ExpectedTenantKey $ExpectedTenantKey
    if((Get-FileHash -LiteralPath $Path).Hash -cne $hash){throw 'AD country configuration changed during read.'}
    $rules|Add-Member SourceSHA256 $hash
    return $rules
}
function Resolve-AdComputerCountry {
    [CmdletBinding()]
    param([string]$Domain,[string]$ComputerName,[Parameter(Mandatory)]$Rules)
    $domainKey=$Domain.Trim().TrimEnd('.').ToLowerInvariant();$name=$ComputerName.Trim()
    $prefix=if($name.Length -ge 2){$name.Substring(0,2).ToUpperInvariant()}else{''}
    $domainCode=if($Rules.Domains.ContainsKey($domainKey)){$Rules.Domains[$domainKey]}else{''}
    $prefixCode=if($Rules.Prefixes.ContainsKey($prefix)){$Rules.Prefixes[$prefix]}else{''}
    $code='';$basis='Not observed; no configured AD country rule'
    if($domainCode -and $prefixCode -and $domainCode -cne $prefixCode){$basis='Conflict: configured AD domain and computer-name prefix disagree'}
    elseif($domainCode){$code=$domainCode;$basis='Configured AD domain; not verified physical location'}
    elseif($prefixCode){$code=$prefixCode;$basis='Configured computer-name prefix; not verified physical location'}
    [pscustomobject]@{Country=$(if($code){$Rules.Names[$code]}else{'Unknown'});Basis=$basis;Conflict=($basis.StartsWith('Conflict:'))}
}
Export-ModuleMember -Function New-AdCountryRules,Read-AdCountryRules,Resolve-AdComputerCountry

