# Version 1.1.0
Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Get-NativeEvidenceSourceItems {
    param([Parameter(Mandatory)][string]$DataRoot)
    $contract = Get-Content -LiteralPath (Join-Path $PSScriptRoot '../config/native-evidence-contract.json.txt') -Raw | ConvertFrom-Json
    $registry = Get-Content -LiteralPath (Join-Path $PSScriptRoot '../../SmartM365/Modules/SmartM365.Core/SmartM365-CmdbSources.json.txt') -Raw | ConvertFrom-Json
    foreach ($source in $contract.sources) {
        # Acquisition freshness is checked against receipts, not transport mtime.
        @{ Relative = "DATA-LAST/$($source.file)"; Kind = 'NativeCurrent' }
    }
    foreach ($producer in $registry.Producers) {
        if ([IO.Path]::GetFileName($producer.Receipt) -cne $producer.Receipt) { throw 'Unsafe native receipt path.' }
        if($producer.PSObject.Properties['SemanticFiles']){
            $receiptPath=Join-Path $DataRoot "DATA-LAST/$($producer.Receipt)"
            if(Test-Path -LiteralPath $receiptPath -PathType Leaf){
                $proof=Get-Content -LiteralPath $receiptPath -Raw | ConvertFrom-Json
                foreach($file in $producer.SemanticFiles.Files){
                    if($proof.PSObject.Properties['RequiredFiles'] -and $file -in $proof.RequiredFiles){
                        if([IO.Path]::GetFileName($file) -cne $file){throw 'Unsafe native semantic artifact path.'}
                        @{Relative="DATA-LAST/$file";Kind='NativeCurrent'}
                    }
                }
            }
        }
        @{ Relative = "DATA-LAST/$($producer.Receipt)"; Kind = 'Receipt' }
        $runName = $producer.Receipt.Replace('.current.json.txt','.run.json.txt')
        if (Test-Path -LiteralPath (Join-Path $DataRoot "DATA-LAST/$runName") -PathType Leaf) {
            @{ Relative = "DATA-LAST/$runName"; Kind = 'Receipt' }
        }
    }
}

function Invoke-NativeEvidenceStage {
    param([Parameter(Mandatory)][string]$LastRoot, [Parameter(Mandatory)][string]$TenantKey,
        [Parameter(Mandatory)][string]$AuditPath, [string]$OutputRoot, [string]$IdentityPath,
        [string]$PythonCommand = 'python')
    $python = Get-Command $PythonCommand -CommandType Application -ErrorAction Stop | Select-Object -First 1
    $version = & $python.Source -B -c 'import sys; print(".".join(map(str,sys.version_info[:3])))'
    if ($LASTEXITCODE -ne 0 -or [version]$version -lt [version]'3.10') { throw 'Python 3.10+ is required for native Workplace evidence.' }
    $arguments = @('-B',(Join-Path $PSScriptRoot 'workplace_native_build.py'),'--source',$LastRoot,'--tenant',$TenantKey,'--audit',$AuditPath)
    if ($OutputRoot) { $arguments += @('--output',$OutputRoot) }
    if ($IdentityPath) { $arguments += @('--identity',$IdentityPath) }
    & $python.Source @arguments | Write-Host
    if ($LASTEXITCODE -ne 0) { throw 'Native Workplace evidence validation failed. Nothing was published.' }
}

function Merge-NativeEvidenceContract {
    param([Parameter(Mandatory)]$BaseContract)
    $extension = Get-Content -LiteralPath (Join-Path $PSScriptRoot '../config/native-output-contract.json.txt') -Raw | ConvertFrom-Json
    $result = $BaseContract | ConvertTo-Json -Depth 30 | ConvertFrom-Json
    foreach ($table in $extension.tables) {
        if ($table.file -in $result.tables.file -or $table.table -in $result.tables.table) { throw 'Duplicate native evidence contract table.' }
    }
    $result.tables = @($result.tables) + @($extension.tables)
    $result
}

