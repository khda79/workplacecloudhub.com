# Qualified positive console activity only. No collection, identity inference or publication.
Set-StrictMode -Version Latest
function Get-ConsoleText {
    param($Row,[string]$Name)
    if($null -eq $Row){return ''}
    $property=$Row.PSObject.Properties[$Name]
    if($null -eq $property -or $null -eq $property.Value){return ''}
    ([string]$property.Value).Trim()
}
function Convert-ConsoleUtc {
    param([string]$Value)
    if($Value -notmatch '(Z|[+-][0-9]{2}:[0-9]{2})$'){return $null}
    $parsed=[datetimeoffset]::MinValue
    if([datetimeoffset]::TryParse($Value,[Globalization.CultureInfo]::InvariantCulture,[Globalization.DateTimeStyles]::None,[ref]$parsed)) {return $parsed.ToUniversalTime()}
    return $null
}
function New-ConsoleActivityIndex {
    [CmdletBinding()]
    param([AllowEmptyCollection()][object[]]$SystemRows=@(),[AllowEmptyCollection()][object[]]$AdRows=@(),
        [datetimeoffset]$AsOfUtc=[datetimeoffset]::UtcNow)
    $adBySid=@{}; $systemByDevice=@{}; $result=@{}; $reasons=@{}
    foreach($ad in $AdRows) {
        $tenant=Get-ConsoleText $ad 'TenantKey'; $sid=Get-ConsoleText $ad 'ObjectSID'
        if(-not $tenant -or $sid -notmatch '^S-1-5-21-[0-9]+-[0-9]+-[0-9]+-[0-9]+$'){continue}
        $key=$tenant.ToLowerInvariant()+'|'+$sid.ToUpperInvariant()
        if(-not $adBySid.ContainsKey($key)){$adBySid[$key]=[Collections.Generic.List[object]]::new()}
        $adBySid[$key].Add($ad)
    }
    foreach($row in $SystemRows) {
        $tenant=Get-ConsoleText $row 'TenantKey'; $device=Get-ConsoleText $row 'Device Source ID'
        if(-not $tenant -or -not $device){$reasons['Missing device identity']=1+([int]$reasons['Missing device identity']);continue}
        $key=$tenant.ToLowerInvariant()+'|'+$device.ToLowerInvariant()
        if(-not $systemByDevice.ContainsKey($key)){$systemByDevice[$key]=[Collections.Generic.List[object]]::new()}
        $systemByDevice[$key].Add($row)
    }
    foreach($deviceKey in $systemByDevice.Keys) {
        $rows=$systemByDevice[$deviceKey]; $reason=''
        if($rows.Count -ne 1){$reason='Ambiguous device evidence'}
        else {
            $row=$rows[0]
            $sid=Get-ConsoleText $row 'Last Console Logon SID'
            $tenant=Get-ConsoleText $row 'TenantKey'
            $key=$tenant.ToLowerInvariant()+'|'+$sid.ToUpperInvariant()
            $observation=Convert-ConsoleUtc (Get-ConsoleText $row 'Observation UTC')
            $console=Convert-ConsoleUtc (Get-ConsoleText $row 'Last Console Logon UTC')
            if((Get-ConsoleText $row 'Local Data Source') -ne 'IntuneRemediation' -or (Get-ConsoleText $row 'Local Data Freshness') -ne 'Fresh'){$reason='Local collection not current'}
            elseif((Get-ConsoleText $row 'Freshness') -notin @('Within policy','Policy not configured')){$reason='Observation not qualified'}
            elseif((Get-ConsoleText $row 'Inventory Match') -ne 'Matched' -or (Get-ConsoleText $row 'Prepared Inventory Match') -ne 'Matched'){$reason='Device identity not qualified'}
            elseif((Get-ConsoleText $row 'Last Console Logon Status') -ne 'Observed' -or -not (Get-ConsoleText $row 'Last Console Logon User')){$reason='Console event not observed'}
            elseif($null -eq $observation -or $null -eq $console -or $observation -gt $AsOfUtc -or $console -gt $observation -or $console -gt $AsOfUtc){$reason='Console timestamp not qualified'}
            elseif($sid -notmatch '^S-1-5-21-[0-9]+-[0-9]+-[0-9]+-[0-9]+$'){$reason='AD user SID unavailable'}
            elseif(-not $adBySid.ContainsKey($key)){$reason='AD user SID unmatched'}
            elseif($adBySid[$key].Count -ne 1){$reason='AD user SID ambiguous'}
            else {
                if(-not $result.ContainsKey($key)) {
                    $result[$key]=[pscustomobject]@{Utc=$console;DeviceCount=0;MatchMethod='SID';EvidenceState='Observed';Devices=[Collections.Generic.HashSet[string]]::new([StringComparer]::OrdinalIgnoreCase)}
                }
                if($console -gt $result[$key].Utc){$result[$key].Utc=$console}
                [void]$result[$key].Devices.Add($deviceKey)
                $result[$key].DeviceCount=$result[$key].Devices.Count
            }
        }
        if($reason){$reasons[$reason]=1+([int]$reasons[$reason])}
    }
    [pscustomobject]@{ByAdSid=$result;Audit=[pscustomobject]@{InputRows=$SystemRows.Count;QualifiedUsers=$result.Count;RejectedDeviceReasons=$reasons}}
}
function Get-ConsoleActivityForAdUser {
    param($Index,$AdRow)
    $tenant=Get-ConsoleText $AdRow 'TenantKey'; $sid=Get-ConsoleText $AdRow 'ObjectSID'
    $key=$tenant.ToLowerInvariant()+'|'+$sid.ToUpperInvariant()
    if($null -ne $Index -and $Index.ByAdSid.ContainsKey($key)){return $Index.ByAdSid[$key]}
    return $null
}
Export-ModuleMember -Function New-ConsoleActivityIndex,Get-ConsoleActivityForAdUser

