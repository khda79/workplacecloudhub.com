Set-StrictMode -Version Latest
$ErrorActionPreference = 'Stop'

function Invoke-PreparedSimpleRetention {
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)][string]$OutputRoot,
        [Parameter(Mandatory)][string]$TenantKey,
        [Parameter(Mandatory)]$Transport,
        [Parameter(Mandatory)][string]$ExpectedPublishedBatchId,
        [Parameter(Mandatory)][string]$ExpectedPointerSHA256,
        [switch]$Preview
    )
    $root = [IO.Path]::GetFullPath($OutputRoot).TrimEnd('\','/')
    if ((Split-Path $root -Leaf) -cne 'DATA-POWERBI') { throw 'Retention requires DATA-POWERBI.' }
    $idPattern = '^\d{8}T\d{9}Z-[a-f0-9]{8}$'
    if ($ExpectedPublishedBatchId -cnotmatch $idPattern -or $ExpectedPointerSHA256 -notmatch '^[a-fA-F0-9]{64}$') { throw 'A verified publication receipt is required.' }
    $batchesRoot = Join-Path $root 'batches'
    foreach ($path in @($root,$batchesRoot)) {
        $item = Get-Item -LiteralPath $path -Force
        if (-not $item.PSIsContainer -or ($item.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Retention root must be a native directory.' }
    }
    $lock = [IO.File]::Open((Join-Path $root '.publication.lock'), 'OpenOrCreate', 'ReadWrite', 'None')
    $scratch = Join-Path ([IO.Path]::GetTempPath()) ('prepared-pointer-' + [guid]::NewGuid().ToString('N'))
    try {
        Write-Host 'Retention: reading current pointers and batch folders.'
        $target = & $Transport.DescribeSimple
        $children = @(& $Transport.List $target.RootId)
        $remotePointer = @($children | Where-Object { $_.Name -ceq 'current.json.txt' -and $_.Kind -ceq 'File' -and -not $_.Linked })
        $remoteRoot = @($children | Where-Object { $_.Name -ceq 'batches' -and $_.Kind -ceq 'Folder' -and -not $_.Linked -and $_.Id -ceq $target.BatchesId })
        if ($remotePointer.Count -ne 1 -or $remoteRoot.Count -ne 1) { throw 'SharePoint pointer or batches folder is missing or ambiguous.' }
        $localPath = Join-Path $root 'current.json.txt'
        if ((Get-FileHash -LiteralPath $localPath).Hash -ine $ExpectedPointerSHA256) { throw 'Local pointer differs from the verified publication.' }
        if ((& $Transport.Download $remotePointer[0].Id $scratch) -ne $true -or (Get-FileHash -LiteralPath $scratch).Hash -ine $ExpectedPointerSHA256) { throw 'SharePoint pointer differs from the verified publication.' }
        $pointer = Get-Content -LiteralPath $localPath -Raw | ConvertFrom-Json
        if ($pointer.SchemaVersion -ne 1 -or $pointer.TenantKey -cne $TenantKey -or $pointer.BatchId -cne $ExpectedPublishedBatchId) { throw 'Invalid publication pointer.' }
        $previous = [string]$pointer.PreviousBatchId
        if ($previous -and $previous -cnotmatch $idPattern) { throw 'Invalid previous batch ID.' }
        $remote = @(& $Transport.List $target.BatchesId | Where-Object { $_.Kind -ceq 'Folder' -and -not $_.Linked -and $_.Name -cmatch $idPattern })
        $local = @(Get-ChildItem -LiteralPath $batchesRoot -Directory -Force | Where-Object { $_.Name -cmatch $idPattern -and -not ($_.Attributes -band [IO.FileAttributes]::ReparsePoint) })
        foreach ($id in @($pointer.BatchId,$previous) | Where-Object { $_ }) {
            if (@($remote | Where-Object Name -CEQ $id).Count -ne 1 -or @($local | Where-Object Name -CEQ $id).Count -ne 1) { throw "Protected batch missing or ambiguous: $id" }
        }
        $protected = @($pointer.BatchId,$previous) + @($remote | Sort-Object Name -Descending | Select-Object -First 2 -ExpandProperty Name) + @($local | Sort-Object Name -Descending | Select-Object -First 2 -ExpandProperty Name)
        $removed = [Collections.Generic.List[string]]::new()
        foreach ($item in @($remote | Sort-Object Name | Where-Object { $_.Name -cnotin $protected })) {
            if ($Preview) { $removed.Add('SharePoint candidate: ' + $item.Name); continue }
            if ((Get-FileHash -LiteralPath $localPath).Hash -ine $ExpectedPointerSHA256) { throw 'Local pointer changed during retention.' }
            if ((& $Transport.Download $remotePointer[0].Id $scratch) -ne $true -or (Get-FileHash -LiteralPath $scratch).Hash -ine $ExpectedPointerSHA256) { throw 'SharePoint pointer changed during retention.' }
            $result = & $Transport.Recycle (& $Transport.PrepareRecycle $item.Id $item.ETag)
            if ($result.Outcome -cne 'Recycled') { throw "SharePoint recycle not confirmed for $($item.Name): $($result.Outcome)" }
            $removed.Add('SharePoint recycled: ' + $item.Name)
            Write-Host ("Retention: SharePoint recycled {0}" -f $item.Name)
        }
        foreach ($item in @($local | Sort-Object Name | Where-Object { $_.Name -cnotin $protected })) {
            if ($Preview) { $removed.Add('Server candidate: ' + $item.Name); continue }
            if ((Get-FileHash -LiteralPath $localPath).Hash -ine $ExpectedPointerSHA256) { throw 'Local pointer changed during retention.' }
            if ((& $Transport.Download $remotePointer[0].Id $scratch) -ne $true -or (Get-FileHash -LiteralPath $scratch).Hash -ine $ExpectedPointerSHA256) { throw 'SharePoint pointer changed during retention.' }
            $current = Get-Item -LiteralPath $item.FullName -Force
            if (-not $current.PSIsContainer -or ($current.Attributes -band [IO.FileAttributes]::ReparsePoint)) { throw 'Batch path changed.' }
            if (@(Get-ChildItem -LiteralPath $current.FullName -Recurse -Force | Where-Object { $_.Attributes -band [IO.FileAttributes]::ReparsePoint }).Count) { throw 'Batch contains a linked item.' }
            Remove-Item -LiteralPath $current.FullName -Recurse -Force -ErrorAction Stop
            $removed.Add('Server removed: ' + $item.Name)
            Write-Host ("Retention: server removed {0}" -f $item.Name)
        }
        [pscustomobject]@{ Status = $(if ($Preview) { 'Preview' } else { 'Completed' }); Protected = @($protected | Where-Object { $_ } | Select-Object -Unique); Actions = $removed.ToArray() }
    } finally {
        $lock.Dispose()
        if (Test-Path -LiteralPath $scratch) { Remove-Item -LiteralPath $scratch -Force }
    }
}
Export-ModuleMember -Function Invoke-PreparedSimpleRetention

