/// Business-facing semantic model backed by governed SmartM365 domain evidence and observed histories. Generic CMDB projections and synthetic demonstration tables are retired. Offline validation does not imply production or Desktop qualification.
model SmartWorkplaceIntelligence
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	maxParallelismPerRefresh: 1
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Date","Tenant","Environment","Organization","Geography","Report Metadata","Executive KPI Trends","Device Inventory Evidence","User Inventory Evidence","Mailbox Evidence","Security Control Evidence","Enterprise Operational Signals","DataRoot","Device Risk Evidence Summary","User Activity History Evidence","Workforce Trend Evidence","Identity Reconciliation Evidence","Workforce Operational Signals","Windows Lifecycle Trend Evidence","Endpoint Experience Trend Evidence","Application Inventory Evidence","Application Trend Evidence","Application Operational Signals","Collaboration Adoption Evidence","Collaboration Object Evidence","Collaboration Trend Evidence","Collaboration Operational Signals","Content Storage Evidence","Content Storage Trend Evidence","Content Storage Operational Signals","Backup Mailbox Evidence","Backup Operational Signals","Data Trust Evidence","Data Trust Operational Signals","Device Directory Summary","SharePointSiteUrl","SharePointLibraryName","SharePointDataFolder","GetSmartInventoryFolder","GetSmartInventoryFile","License Report Summary","License Report Candidates","License Report Gaps","License Report Sources","PreparedSourceMode","PreparedEvidenceRoot","PreparedSharePointFolder","GetPreparedEvidenceFile","PreparedBatchId","GetLicenseReportSnapshot","GetLicenseReportCsv","License Report Assignment Issues","License SKU Capacity","License SKU Candidates","License Report Qualification"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation __PBI_TimeIntelligenceEnabled = 1

