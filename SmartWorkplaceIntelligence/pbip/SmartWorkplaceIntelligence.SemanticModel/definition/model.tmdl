/// Business-facing semantic model backed by current private SmartM365 evidence and observed DATA-ALL histories. Legacy synthetic tables remain temporarily for compatibility but are not used by report pages.
model SmartWorkplaceIntelligence
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	maxParallelismPerRefresh: 1
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["Date","Tenant","Environment","Organization","Geography","User","Device","Application","License Product","Service","Group","Team","Site","Mailbox","Data Source","Finding Type","Report Metadata","User Snapshots","User Activities","Identity Matches","User License Assignments","License Capacity","Device Snapshots","Device Compliance Snapshots","Device Matches","Windows Lifecycle Assessments","Endpoint Experience Measurements","Application Installations","Collaboration Usage","Content Usage","Mailbox Snapshots","Mailbox Matches","Backup Coverage","Security Posture Observations","Source Runs","Source Coverage","Data Quality Results","Findings","User Device Relationships","User Group Memberships","Team Memberships","Mailbox Permissions","Service Relationships","Executive KPI Trends","User Directory Observations","Identity Security Status","Conditional Access Coverage","Endpoint Security Status","Device Inventory Evidence","User Inventory Evidence","License Evidence","Mailbox Evidence","Security Control Evidence","Enterprise Operational Signals","DataRoot","Device Risk Evidence Summary","User Activity History Evidence","Workforce Trend Evidence","Identity Reconciliation Evidence","Workforce Operational Signals","Windows Lifecycle Trend Evidence","Endpoint Experience Trend Evidence","Application Inventory Evidence","Application Trend Evidence","Application Operational Signals","Collaboration Adoption Evidence","Collaboration Object Evidence","Collaboration Trend Evidence","Collaboration Operational Signals","Content Storage Evidence","Content Storage Trend Evidence","Content Storage Operational Signals","Backup Mailbox Evidence","Backup Operational Signals","Data Trust Evidence","Data Trust Operational Signals","License Optimization Evidence","Device Directory Summary","SharePointSiteUrl","SharePointLibraryName","SharePointDataFolder","GetSmartInventoryFolder","GetSmartInventoryFile"]

annotation __PBI_TimeIntelligenceEnabled = 1

