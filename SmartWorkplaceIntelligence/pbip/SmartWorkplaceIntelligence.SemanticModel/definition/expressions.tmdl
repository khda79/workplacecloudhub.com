expression PreparedExpectedTenantKey = "" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: fd94c8fb-7f6c-48b7-ac89-42afd49db4fe

/// Read from one selected batch with existing schema and identity checks. Latest verifies pointer stability per read; loaded provenance detects cross-table mixtures.
expression GetSharePointMigrationEvidence = (FileName as text, Schema as list) as table => CreatePreparedReaders()[GetSharePointMigrationEvidence](FileName, Schema)
	lineageTag: bb3c6976-2636-49d6-8cd5-2c7646e6be4a

/// Prepared storage navigation. Private Service deployment must use its SharePoint-only adapter.
expression PreparedReadFolder =
		// Internal transport; callers validate path segments. phase distinguishes selection and verification in synthetic tests.
		(segments as list, optional phase as nullable text) as table =>
		        if PreparedSourceMode = "Local" then
		            Folder.Contents(Text.TrimEnd(PreparedEvidenceRoot, {"\", "/"}) & (if List.IsEmpty(segments) then "" else "\" & Text.Combine(segments, "\")))
		        else if PreparedSourceMode = "SharePoint" and List.IsEmpty(segments) then
		            let
		                // A fresh HTTP read is required: connector navigation can reuse cached content.
		                Library = Json.Document(Web.Contents(SharePointSiteUrl, [
		                    RelativePath="_api/web/lists/GetByTitle('" & Uri.EscapeDataString(Text.Replace(SharePointLibraryName, "'", "''")) & "')/RootFolder",
		                    Query=[#"$select"="ServerRelativeUrl"], Headers=[Accept="application/json;odata=nometadata"], IsRetry=true])),
		                RootPath = Library[ServerRelativeUrl] & "/" & Text.Trim(SharePointDataFolder & "/" & PreparedSharePointFolder, "/"),
		                Fetch = (name as text) as nullable binary =>
		                    let
		                        Response = Web.Contents(SharePointSiteUrl, [
		                            RelativePath="_api/web/GetFileByServerRelativeUrl('" & Uri.EscapeDataString(Text.Replace(RootPath & "/" & name, "'", "''")) & "')/$value",
		                            ManualStatusHandling={404}, IsRetry=true]),
		                        Status = Record.FieldOrDefault(Value.Metadata(Response), "Response.Status", 200)
		                    in if Status = 404 then null else Binary.Buffer(Response),
		                Preferred = Fetch("current.json.txt"),
		                Name = if Preferred = null then "current.json" else "current.json.txt",
		                Content = if Preferred = null then Fetch("current.json") else Preferred
		            in if Content = null then #table({"Name", "Content"}, {}) else #table({"Name", "Content"}, {{Name, Content}})
		        else if PreparedSourceMode = "SharePoint" then
		            let
		                Root = SharePoint.Contents(SharePointSiteUrl, [ApiVersion=15]),
		                Path = {SharePointLibraryName} & List.Select(Text.Split(SharePointDataFolder & "/" & PreparedSharePointFolder, "/"), each _ <> "") & segments,
		                Content = List.Accumulate(Path, Root, (parent, segment) =>
		                    let found = Table.SelectRows(parent, each [Name] = segment)
		                    in if Table.RowCount(found) = 1 then found{0}[Content] else error Error.Record("Prepared evidence", "Missing or ambiguous folder; wait for a complete batch", segment))
		            in Content
		        else error "PreparedSourceMode must be Local or SharePoint"
	lineageTag: f5c05c66-b6fd-4970-9b0b-d75385f88127

/// One batch context per evaluated query. Latest follows the validated published pointer; per-read stability is not a cross-table transaction.
expression CreatePreparedReaders =
		(optional FolderReader as nullable function) as record =>
		let
		    SafeSegment = (s as text) as text =>
		        if s = "" or Text.Contains(s, "/") or Text.Contains(s, "\") or Text.Contains(s, "..")
		        then error "Invalid prepared path segment" else s,
		    Folder = if FolderReader = null then PreparedReadFolder else FolderReader,
		    ReadMetadata = (segments as list, name as text, phase as text) as binary =>
		        let
		            Parent = Folder(segments, phase),
		            Preferred = Table.SelectRows(Parent, each [Name] = name & ".json.txt"),
		            Legacy = Table.SelectRows(Parent, each [Name] = name & ".json"),
		            Selected = if Table.RowCount(Preferred) = 0 then Legacy else Preferred
		        in if Table.RowCount(Selected) = 1 then Binary.Buffer(Selected{0}[Content])
		           else error "Missing or ambiguous prepared metadata",
		    Pin = if Text.Trim(PreparedBatchId) = "" then error "PreparedBatchId is required: Latest or an explicit batch ID" else PreparedBatchId,
		    IsLatest = Pin = "Latest",
		    ExpectedTenant = if Text.Trim(PreparedExpectedTenantKey) = "" then error "PreparedExpectedTenantKey is required" else PreparedExpectedTenantKey,
		    PointerBytes = ReadMetadata({}, "current", "select"),
		    Pointer = Json.Document(PointerBytes),
		    PointerValid = Pointer[SchemaVersion] = 1 and Pointer[TenantKey] = ExpectedTenant,
		    BatchId = if not PointerValid then error "Invalid prepared pointer identity"
		              else SafeSegment(if IsLatest then Pointer[BatchId] else Pin),
		    Manifest = Json.Document(ReadMetadata({"batches", BatchId}, "batch", "manifest")),
		    ManifestValid = Manifest[SchemaVersion] = 1 and Manifest[BatchId] = BatchId and Manifest[TenantKey] = ExpectedTenant,
		    ManifestEntries = List.Buffer(Manifest[Files] & Record.FieldOrDefault(Manifest, "Artifacts", {})),
		    CheckStable = (phase as text) as logical =>
		        if not IsLatest then true
		        else if Binary.ToText(PointerBytes, BinaryEncoding.Base64) =
		                Binary.ToText(ReadMetadata({}, "current", phase), BinaryEncoding.Base64)
		             then true else error "Prepared batch changed during read; retry at the next scheduled refresh",
		    GetPreparedBatchManifest = () as record =>
		        if not ManifestValid then error "Invalid prepared batch manifest"
		        else if CheckStable("verify-manifest") then Manifest else error "Unstable prepared pointer",
		    GetPreparedEvidenceFile = (fileName as text) as binary =>
		        let
		            CheckedManifest = GetPreparedBatchManifest(),
		            Name = SafeSegment(fileName),
		            Entries = if CheckedManifest[BatchId] = BatchId then List.Select(ManifestEntries, each [File] = Name) else error "Prepared batch identity mismatch",
		            Entry = if List.Count(Entries) = 1 then Entries{0} else error "Invalid prepared batch file membership",
		            Files = Folder({"batches", BatchId}, "payload"),
		            Found = Table.SelectRows(Files, each [Name] = Name),
		            Content = if Table.RowCount(Found) = 1 then Found{0}[Content] else error "Missing or ambiguous prepared file",
		            // Force the size check before the end-of-read pointer check. Do not buffer large payloads.
		            Checked = if Binary.Length(Content) <> Entry[Bytes] then error "Prepared evidence transfer incomplete"
		                      else if CheckStable("verify-payload") then Content else error "Unstable prepared pointer"
		        in Checked,
		    CreateMailboxMigrationReader = () as function => GetPreparedEvidenceFile,
		    GetLicenseReportQualification = () as record =>
		let
		    Manifest = GetPreparedBatchManifest(),
		    Names = List.Transform(Manifest[Files] & Record.FieldOrDefault(Manifest, "Artifacts", {}), each [File]),
		    ReportFiles = {"M365_Licenses_ReportSummary.csv", "M365_Licenses_ReportCandidates.csv", "M365_Licenses_ReportGaps.csv", "M365_Licenses_ReportSources.csv", "M365_Licenses_ReportAssignmentIssues.csv"},
		    DecisionFiles = {"M365_Licenses_ReportSkuCandidates.csv", "M365_Licenses_ReportSkuCapacity.csv"},
		    Raw = Record.FieldOrDefault(Manifest, "LicenseReportQualification", null),
		    Legacy = List.Transform(ReportFiles & DecisionFiles, (name) =>
		        let present = List.Contains(Names, "Source-" & name)
		        in [File = name, Kind = if List.Contains(DecisionFiles, name) then "Decision" else "Report",
		            State = if present then "Not verified" else "Absent",
		            Reason = if present then "Batch predates license report qualification" else "Not part of this batch"]),
		    Valid = Raw <> null and Record.FieldOrDefault(Raw, "Version", null) = 1 and
		        List.Contains({"Qualified", "Not qualified"}, Record.FieldOrDefault(Raw, "State", null)) and Value.Is(Record.FieldOrDefault(Raw, "Files", null), type list),
		    Result = if Raw = null then [State = "Not verified", Reason = "Batch predates license report qualification", SnapshotId = null, ReceiptRunId = null, Files = Legacy]
		        else if not Valid then error Error.Record("License report qualification", "Invalid license report qualification in the batch manifest")
		        else [State = Raw[State], Reason = Raw[Reason], SnapshotId = Raw[SnapshotId], ReceiptRunId = Raw[ReceiptRunId], Files = Raw[Files]]
		in
		    Result,
		    LicenseReportFileUsable = (fileName as text) as logical =>
		let
		    Found = List.Select(GetLicenseReportQualification()[Files], each [File] = fileName),
		    State = if List.Count(Found) = 1 then Found{0}[State] else "Absent"
		in
		    List.Contains({"Qualified", "Not verified"}, State),
		    GetLicenseReportSnapshot = () as record =>
		let
		    FileName = "M365_Licenses_ReportSnapshot.json.txt",
		    Content = GetPreparedEvidenceFile("Source-" & FileName),
		    Snapshot = Json.Document(Binary.Buffer(Content)),
		    SchemaVersion = Record.FieldOrDefault(Snapshot, "SchemaVersion", null),
		    SupportedVersion = List.Contains({1, 2}, SchemaVersion),
		    BaseValid = try
		        Text.Length(Text.From(Snapshot[SnapshotId])) = 32 and
		        Text.Length(Text.Trim(Text.From(Snapshot[TenantKey]))) > 0 and
		        Value.Is(Snapshot[Products], type list) and List.Count(Snapshot[Products]) = 4 and
		        Value.Is(Snapshot[OtherProducts], type list) and List.Count(Snapshot[OtherProducts]) = 3
		        otherwise false,
		    AssignmentValid = if SchemaVersion = 1 then true else try
		        Value.Is(Snapshot[AssignmentIssues], type record) and
		        Value.Is(Snapshot[AssignmentIssues][Available], type logical) and
		        Value.Is(Snapshot[AssignmentIssues][Rows], type list) and
		        (if Snapshot[AssignmentIssues][Available]
		            then Value.Is(Snapshot[AssignmentIssues][Counts], type record)
		            else List.IsEmpty(Snapshot[AssignmentIssues][Rows]))
		        otherwise false,
		    Checked = if not SupportedVersion then
		        error Error.Record("License report snapshot", "Unsupported SmartInventory license report snapshot schema version", [Actual=SchemaVersion, Supported={1, 2}])
		        else if BaseValid <> true or AssignmentValid <> true then
		        error Error.Record("License report snapshot", "Invalid SmartInventory license report snapshot structure", [SchemaVersion=SchemaVersion])
		        else Snapshot
		in
		    Checked,
		    GetLicenseReportCsv = (fileName as text, expectedColumns as list) as table =>
		let
		    Allowed = {"M365_Licenses_ReportSummary.csv", "M365_Licenses_ReportCandidates.csv", "M365_Licenses_ReportGaps.csv", "M365_Licenses_ReportSources.csv", "M365_Licenses_ReportAssignmentIssues.csv", "M365_Licenses_ReportSkuCandidates.csv", "M365_Licenses_ReportSkuCapacity.csv"},
		    // Not qualified or absent files are never read: the table is empty, not an older value.
		    Usable = if not List.Contains(Allowed, fileName) then error "Unexpected license report CSV" else LicenseReportFileUsable(fileName),
		    Content = GetPreparedEvidenceFile("Source-" & fileName),
		    // Accept only the legacy summary and its exact assignment-status extension.
		    Buffered = Binary.Buffer(Content),
		    Raw = Csv.Document(Buffered, [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
		    Header = if Table.IsEmpty(Raw) then error "License report CSV is empty" else Record.FieldValues(Raw{0}),
		    ExtendedColumns = if fileName = "M365_Licenses_ReportSummary.csv" and List.Count(expectedColumns) = 40
		        and expectedColumns{10} = "AssignedUsers"
		        then List.InsertRange(expectedColumns, 11, {"AssignmentCapacityWait", "AssignmentOtherErrors", "AssignmentEvidenceStatus"})
		        else expectedColumns,
		    // Licences 1.49 published the SKU capacity without ReportProduct.
		    LegacyCapacityColumns = List.RemoveItems(expectedColumns, {"ReportProduct"}),
		    AcceptedColumns = if Header = expectedColumns then expectedColumns
		        else if fileName = "M365_Licenses_ReportSummary.csv" and Header = ExtendedColumns then ExtendedColumns
		        else if fileName = "M365_Licenses_ReportSkuCapacity.csv" and Header = LegacyCapacityColumns then LegacyCapacityColumns
		        else error "License report CSV schema differs from the SmartM365 contract",
		    StrictRows = Csv.Document(Buffered, [Delimiter=",", Columns=List.Count(AcceptedColumns), Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]),
		    Rows = Table.PromoteHeaders(StrictRows, [PromoteAllScalars=true]),
		    HeadersChecked = if fileName = "M365_Licenses_ReportSummary.csv" then
		        if Header = ExtendedColumns and List.Count(Header) = 43 then Rows
		        else Table.AddColumn(Table.AddColumn(Table.AddColumn(Rows, "AssignmentCapacityWait", each null, Int64.Type), "AssignmentOtherErrors", each null, Int64.Type), "AssignmentEvidenceStatus", each "Unknown", type text)
		        else if fileName = "M365_Licenses_ReportSkuCapacity.csv" and AcceptedColumns = LegacyCapacityColumns then Table.ReorderColumns(Table.AddColumn(Rows, "ReportProduct", each ""), expectedColumns)
		        else Table.SelectColumns(Rows, expectedColumns),
		    Snapshot = GetLicenseReportSnapshot(),
		    IdentityChecked = if Table.RowCount(HeadersChecked) = 0 or
		        (List.Distinct(HeadersChecked[SnapshotId]) = {Snapshot[SnapshotId]} and List.Distinct(HeadersChecked[TenantKey]) = {Snapshot[TenantKey]})
		        then HeadersChecked else error "License report CSV and email snapshot identities differ",
		    EmptyColumns = if fileName = "M365_Licenses_ReportSummary.csv" and List.Count(expectedColumns) = 40 and expectedColumns{10} = "AssignedUsers" then ExtendedColumns else expectedColumns,
		    Result = if Usable then IdentityChecked else #table(EmptyColumns, {})
		in
		    Result,
		    ReadMigrationCsv = (content as binary, required as list) as table =>
		let
		    Buffered = Binary.Buffer(content),
		    HeaderLine = Text.BeforeDelimiter(Text.FromBinary(Buffered, TextEncoding.Utf8) & "#(lf)", "#(lf)"),
		    Separator = if Text.Contains(HeaderLine, ";") then ";" else ",",
		    Raw = Csv.Document(Buffered, [Delimiter=Separator, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    Headers = if Table.IsEmpty(Raw) then error "Migration source is empty; a schema header is required" else Record.FieldValues(Raw{0}),
		    UniqueHeaders = if List.Count(Headers) = List.Count(List.Distinct(Headers)) and not List.Contains(Headers, null) and not List.Contains(Headers, "") then Raw else error "Duplicate or empty migration CSV headers",
		    Promoted = Table.PromoteHeaders(UniqueHeaders, [PromoteAllScalars=true]),
		    Missing = List.Difference(required, Table.ColumnNames(Promoted)),
		    Checked = if List.IsEmpty(Missing) then Promoted else error Error.Record("Migration source schema", "Required columns are missing", Missing)
		in
		    Checked,
		    ReadMailboxMigrationCsv = (content as binary, required as list, optionalColumns as list) as table =>
		let
		    Buffered = Binary.Buffer(content),
		    HeaderLine = List.First(Lines.FromBinary(Buffered, QuoteStyle.None, false, 65001), ""),
		    Separator = if Text.Contains(HeaderLine, ";") then ";" else ",",
		    Raw = Csv.Document(Buffered, [Delimiter=Separator, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    Headers = if Table.IsEmpty(Raw) then error "Migration source is empty; a schema header is required" else Record.FieldValues(Raw{0}),
		    UniqueHeaders = if List.Count(Headers) = List.Count(List.Distinct(Headers)) and not List.Contains(Headers, null) and not List.Contains(Headers, "") then Raw else error "Duplicate or empty migration CSV headers",
		    Promoted = Table.PromoteHeaders(UniqueHeaders, [PromoteAllScalars=true]),
		    Missing = List.Difference(required, Table.ColumnNames(Promoted)),
		    Checked = if List.IsEmpty(Missing) then Promoted else error Error.Record("Migration source schema", "Required columns are missing", Missing),
		    Columns = List.Distinct(required & List.Intersect({optionalColumns, Table.ColumnNames(Checked)})),
		    Projected = Table.SelectColumns(Checked, Columns, MissingField.Error)
		in
		    Table.Buffer(Projected),
		    ReadMigrationWeeklyHistory = (kind as text, fileName as text, required as list, tenant as text) as list =>
		let
		    Scope = if kind = "Mailbox" and fileName = "Exchange_OnPrem_Mailboxes_AllDomains.csv" then kind
		        else if kind = "Windows" and fileName = "Intune_Devices_Inventory.csv" then kind
		        else error "Unsupported migration history scope",
		    Index = Json.Document(GetPreparedEvidenceFile("PreparedHistoryIndex.json.txt")),
		    Entries = if Index[SchemaVersion] = 1 and Index[TenantKey] = tenant then Index[Entries] else error "Invalid prepared history identity",
		    Weeks = List.Select(Entries, each [Kind] = Scope and [SourceFile] = fileName),
		    ReadWeek = (week as record) as record =>
		        let
		            Name = week[Week],
		            Year = Number.FromText(Text.Start(Name, 4), "en-US"),
		            Number = Number.FromText(Text.End(Name, 2), "en-US"),
		            Monday = Date.AddWeeks(Date.StartOfWeek(#date(Year, 1, 4), Day.Monday), Number - 1),
		            CheckedWeek = if Number >= 1 and Number <= 53 then Monday else error "Invalid ISO history week",
		            Manifest = Json.Document(GetPreparedEvidenceFile(week[Manifest])),
		            ManifestWeek = Record.FieldOrDefault(Manifest, "Week", Name),
		            CheckedManifest = if ManifestWeek = Name then Manifest else error "History manifest week differs from folder",
		            Stamps = Record.FieldOrDefault(CheckedManifest, "FileSnapshotCreatedAtUtc", []),
		            Stamp = Record.FieldOrDefault(Stamps, fileName, Record.FieldOrDefault(CheckedManifest, "SnapshotCreatedAtUtc", null)),
		            Date = if Stamp <> null and Text.Trim(Text.From(Stamp)) <> "" then Date.FromText(Text.Start(Text.From(Stamp), 10), [Culture="en-US"]) else CheckedWeek,
		            Source = ReadMigrationCsv(GetPreparedEvidenceFile(week[File]), required),
		            HasTenant = Table.HasColumns(Source, {"TenantKey"}),
		            AllScoped = HasTenant and List.AllTrue(List.Transform(Table.Column(Source, "TenantKey"), each _ = tenant)),
		            Rows = if HasTenant then Table.SelectRows(Source, each [TenantKey] = tenant or [TenantKey] = "" or [TenantKey] = null) else Source,
		            Issues = if kind <> "Mailbox" or week[Issues] = null then null else ReadMigrationCsv(GetPreparedEvidenceFile(week[Issues]), {}),
		            NoCollectionIssues = Issues <> null and Table.IsEmpty(Issues)
		        in
		            [Week=Name, Date=Date, HasRecordedDate=Stamp <> null and Text.Trim(Text.From(Stamp)) <> "", AllTenantScoped=AllScoped, Rows=Rows, NoCollectionIssues=NoCollectionIssues, ExcludedOtherTenantRows=Table.RowCount(Source)-Table.RowCount(Rows)],
		    Result = List.Transform(Weeks, ReadWeek)
		in
		    Result,
		    GetSharePointOnPremCsv = (FileName as text, RequiredColumns as list, OptionalColumns as list) as table =>
		let
		    Allowed = {"SharePoint_OnPrem_Farms.csv", "SharePoint_OnPrem_Servers.csv", "SharePoint_OnPrem_ServiceApplications.csv", "SharePoint_OnPrem_WebApplications.csv", "SharePoint_OnPrem_WebApplicationZones.csv", "SharePoint_OnPrem_ContentDatabases.csv", "SharePoint_OnPrem_SiteCollections.csv", "SharePoint_OnPrem_SiteAdministrators.csv", "SharePoint_OnPrem_Webs.csv", "SharePoint_OnPrem_CollectionCoverage.csv"},
		    NameChecked = if List.Contains(Allowed, FileName) then FileName else error Error.Record("SharePoint on-prem source", "Unexpected CSV name", FileName),
		    Content = GetPreparedEvidenceFile("Source-" & NameChecked),
		    Parsed = Csv.Document(Binary.Buffer(Content), [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    Headers = Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
		    Missing = List.Difference(RequiredColumns, Table.ColumnNames(Headers)),
		    Checked = if List.IsEmpty(Missing) then Headers else error Error.Record("SharePoint on-prem schema", "Required CSV columns are missing", [File=FileName, Columns=Missing]),
		    OptionalReady = Table.HasColumns(Checked, OptionalColumns),
		    Selected = Table.SelectColumns(Checked, RequiredColumns & OptionalColumns, MissingField.UseNull),
		    WithSchema = Table.AddColumn(Selected, "Optional Schema Ready", each OptionalReady, type logical)
		in
		    WithSchema,
		    GetSharePointMigrationEvidence = (FileName as text, Schema as list) as table =>
		let
		    Expected = {"SharePointMigrationPlanEvidence.csv", "SharePointMigrationWebEvidence.csv", "SharePointMigrationCollectionEvidence.csv", "SharePointMigrationLegacyWebEvidence.csv", "SharePointMigrationLegacyCollectionEvidence.csv", "SharePointMigrationScopeEvidence.csv", "SharePointMigrationFindingEvidence.csv", "SharePointMigrationHistoryEvidence.csv", "SharePointMigrationSourceSummary.csv"},
		    Manifest = GetPreparedBatchManifest(),
		    Entries = List.Select(Manifest[Files], each List.Contains(Expected, [File])),
		    Names = List.Transform(Entries, each [File]),
		    GroupReady = if List.IsEmpty(Entries) then false else
		        if List.Count(Names) = List.Count(Expected) and List.Count(List.Distinct(Names)) = List.Count(Expected)
		        then true else error "Incomplete migration evidence group in selected batch",
		    Allowed = if List.Contains(Expected, FileName) then FileName else error "Unexpected migration table",
		    Empty = #table(List.Transform(Schema, each _{0}), {}),
		    Parsed = if GroupReady then Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile(Allowed),
		        [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]) else Empty,
		    HeaderChecked = if Table.ColumnNames(Parsed) = List.Transform(Schema, each _{0}) then Parsed
		        else error "Migration evidence schema mismatch",
		    TenantChecked = if List.AnyTrue(List.Transform(Table.Column(HeaderChecked, "TenantKey"),
		        each _ <> PreparedExpectedTenantKey)) then error "Foreign migration tenant" else HeaderChecked,
		    Nulls = Table.ReplaceValue(TenantChecked, "", null, Replacer.ReplaceValue, Table.ColumnNames(TenantChecked)),
		    Conversions = List.Transform(Schema, (s) => {s{0}, (v) => if v = null then null else
		        if s{1} = type date then Date.FromText(v, [Culture="en-US"])
		        else if s{1} = type datetime then DateTimeZone.RemoveZone(DateTimeZone.ToUtc(DateTimeZone.FromText(v)))
		        else if s{1} = type logical then Logical.FromText(v)
		        else if s{1} = Int64.Type then Int64.From(v, "en-US")
		        else if s{1} = Currency.Type then Currency.From(v, "en-US") else v, s{1}}),
		    Typed = Table.TransformColumns(Nulls, Conversions),
		    Compatible = if not GroupReady and Allowed = "SharePointMigrationSourceSummary.csv" then
		        Table.FromRecords({[TenantKey=PreparedExpectedTenantKey, Source="Migration workbook",
		            Qualification="Not available in selected batch", #"Coverage State"="Not available in selected batch"]},
		            Value.Type(Typed), MissingField.UseNull) else Typed
		in Compatible,
		    GetExchangeOnPremInfrastructure = () as table =>
		let
		    Schema = type table [Dataset=text, #"Source File"=text, #"Source Row Key"=text,
		        #"Server Name"=text, Category=text, Attribute=text, Value=text,
		        #"Numeric Value"=nullable number, #"Collection Status"=text,
		        #"Source Available"=logical, #"Loaded Batch ID"=text],
		    Sources = {
		        [Dataset="Servers", File="Exchange_OnPrem_Servers_Inventory.csv", Server="Name", Required={"TenantKey","Name","AdminDisplayVersion","ServerRole"}],
		        [Dataset="Compute", File="Exchange_OnPrem_Servers_Compute.csv", Server="ExchangeServerName", Required={"TenantKey","ExchangeServerName","CollectionStatus"}],
		        [Dataset="Logical disks", File="Exchange_OnPrem_Servers_LogicalDisks.csv", Server="ExchangeServerName", Required={"TenantKey","ExchangeServerName","DeviceId","CollectionStatus"}],
		        [Dataset="Physical disks", File="Exchange_OnPrem_Servers_DiskDrives.csv", Server="ExchangeServerName", Required={"TenantKey","ExchangeServerName","DeviceId","CollectionStatus"}],
		        [Dataset="Remote access", File="Exchange_OnPrem_Servers_RemoteAccess.csv", Server="ExchangeServerName", Required={"TenantKey","ExchangeServerName","PingOk","WmiDcomOk"}],
		        [Dataset="Per-server summary", File="Exchange_OnPrem_Infrastructure_PerServerSummary.csv", Server="ExchangeServerName", Required={"TenantKey","ExchangeServerName","ComputeCollectionStatus","DiskDriveCollectionStatus","LogicalDiskCollectionStatus"}],
		        [Dataset="Readiness", File="Exchange_OnPrem_MigrationReadiness_Config.csv", Server=null, Required={"TenantKey","Category","ObjectName","Setting","Value","CollectionStatus"}],
		        [Dataset="Inventory summary", File="Exchange_OnPrem_Servers_Inventory_Summary.csv", Server=null, Required={"TenantKey","RunId","ExchangeServersCount"}],
		        [Dataset="Service health", File="Exchange_OnPrem_Servers_ServiceHealth.csv", Server="ServerName", Required={"TenantKey","ServerName","ServicesRunning","ServicesNotRunning","CollectionStatus"}],
		        [Dataset="Database paths", File="Exchange_OnPrem_MailboxDatabases_Paths.csv", Server="ServerName", Required={"TenantKey","ServerName","DatabaseName","EdbFilePath","LogFolderPath","ErrorMessage"}],
		        [Dataset="Health Checker summary", File="Exchange_OnPrem_HealthChecker_Summary.csv", Server="ServerName", Required={"TenantKey","ServerName","RunStatus","SecurityUpdateStatus","VulnerabilityCount","ErrorCount","WarningCount"}],
		        // Findings exist only for completed runs; their Status column is the health result, not a collection status.
		        [Dataset="Health Checker findings", File="Exchange_OnPrem_HealthChecker_Findings.csv", Server="ServerName", Required={"TenantKey","ServerName","Category","Check","Status","Value"}, Collected="OK"]
		    },
		    SelectedManifest = GetPreparedBatchManifest(),
		    Declared = SelectedManifest[Files] & Record.FieldOrDefault(SelectedManifest, "Artifacts", {}),
		    TextValue = (value as any) as text => if value = null then "" else Text.From(value, "en-US"),
		    Status = (row as record) as text =>
		        let Recorded = TextValue(Record.FieldOrDefault(row, "CollectionStatus", null)),
		            ErrorMessage = TextValue(Record.FieldOrDefault(row, "ErrorMessage", null)),
		            RunStatus = TextValue(Record.FieldOrDefault(row, "RunStatus", null)),
		            Components = List.Transform({"ComputeCollectionStatus","DiskDriveCollectionStatus","LogicalDiskCollectionStatus"},
		                each TextValue(Record.FieldOrDefault(row, _, null)))
		        in if Recorded <> "" then Recorded else if ErrorMessage <> "" then "ERROR"
		           // A Health Checker server that did not complete is unmeasured, never healthy.
		           else if RunStatus <> "" then (if RunStatus = "Completed" then "OK" else "WARNING")
		           else if List.Contains(Components, "ERROR") then "ERROR"
		           else if List.Contains(Components, "WARNING") then "WARNING"
		           else if List.AllTrue(List.Transform(Components, each _ = "OK")) then "OK"
		           else "Observed - status not recorded",
		    Placeholder = (spec as record, available as logical, state as text) as list =>
		        {[Dataset=spec[Dataset], #"Source File"=spec[File], #"Source Row Key"=spec[File] & ":availability",
		          #"Server Name"="", Category=spec[Dataset], Attribute="Source availability", Value=state,
		          #"Numeric Value"=null, #"Collection Status"=state, #"Source Available"=available, #"Loaded Batch ID"=BatchId]},
		    ReadSource = (spec as record) as list =>
		        let Name = "Source-" & spec[File],
		            Membership = List.Select(Declared, each [File] = Name),
		            Present = if List.Count(Membership) = 0 then false
		                else if List.Count(Membership) <> 1 then error "Duplicate Exchange infrastructure declaration"
		                else if List.Count(List.Select(Record.FieldOrDefault(SelectedManifest, "Artifacts", {}), each [File] = Name)) <> 1
		                     then error "Invalid Exchange infrastructure artifact membership" else true,
		            Parsed = if not Present then null else Csv.Document(GetPreparedEvidenceFile(Name),
		                [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		            Header = if not Present then {} else if Table.IsEmpty(Parsed) then error "Empty Exchange infrastructure CSV"
		                else List.Transform(Record.FieldValues(Parsed{0}), each TextValue(_)),
		            HeaderValid = not List.Contains(Header, "") and List.Count(List.Distinct(Header, Comparer.OrdinalIgnoreCase)) = List.Count(Header),
		            Promoted = if not Present then null else if not HeaderValid then error "Invalid Exchange infrastructure CSV header"
		                else Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
		            ColumnsChecked = if not Present then null else if Table.HasColumns(Promoted, spec[Required]) then Promoted
		                else error "Missing Exchange infrastructure columns",
		            Scoped = if not Present then null else if List.AllTrue(List.Transform(Table.Column(ColumnsChecked, "TenantKey"),
		                each _ = ExpectedTenant)) then ColumnsChecked else error "Foreign Exchange infrastructure tenant",
		            SourceRows = if not Present then {} else Table.ToRecords(Scoped),
		            LongRows = if not Present then Placeholder(spec, false, "Not captured in selected batch")
		                else if List.IsEmpty(SourceRows) then Placeholder(spec, true, "Captured - no rows")
		                else List.Combine(List.Transform(List.Positions(SourceRows), (index) =>
		                    let Row = SourceRows{index}, RowKey = spec[File] & ":" & Text.From(index+1, "en-US"),
		                        ServerName = if spec[Server] = null then "" else TextValue(Record.Field(Row, spec[Server])),
		                        Category = TextValue(Record.FieldOrDefault(Row, "Category", spec[Dataset])),
		                        CollectionState = Record.FieldOrDefault(spec, "Collected", Status(Row))
		                    in List.Transform(Record.FieldNames(Row), (attribute) =>
		                        let Value = TextValue(Record.Field(Row, attribute)),
		                            Candidate = Text.Trim(Value),
		                            // Do not reinterpret localized or unit-bearing text as an invariant number.
		                            Number = if Candidate = "" or Text.Select(Candidate, {"0".."9", "+", "-", ".", "e", "E"}) <> Candidate then null
		                                else try Number.FromText(Candidate, "en-US") otherwise null
		                        in [Dataset=spec[Dataset], #"Source File"=spec[File], #"Source Row Key"=RowKey,
		                            #"Server Name"=ServerName, Category=Category, Attribute=attribute, Value=Value,
		                            #"Numeric Value"=Number, #"Collection Status"=CollectionState,
		                            #"Source Available"=true, #"Loaded Batch ID"=BatchId])))
		        in LongRows,
		    Result = Table.Buffer(Table.FromRecords(List.Combine(List.Transform(Sources, ReadSource)), Schema, MissingField.Error)),
		    ForcedRows = Table.RowCount(Result)
		in
		    if ForcedRows >= 0 and CheckStable("verify-infrastructure") then Result else error "Unstable Exchange infrastructure batch",
		    // Exchange hybrid free/busy results (CSS-Exchange FreeBusyChecker): same source checks as the infrastructure reader, wide rows.
		    GetExchangeHybridFreeBusy = (kind as text) as table =>
		let
		    Spec = if kind = "Summary" then [File="Exchange_Hybrid_FreeBusy_Summary.csv",
		            Required={"TenantKey","ServerName","Side","Auth","RunStatus","SideStatus","OkCount","WarningCount","ErrorCount","NotAuthorizedCount"}]
		        else if kind = "Findings" then [File="Exchange_Hybrid_FreeBusy_Findings.csv",
		            Required={"TenantKey","ServerName","Side","Auth","Category","Item","Status","Value"}]
		        else error "Unknown Exchange hybrid free/busy dataset",
		    Name = "Source-" & Spec[File],
		    SelectedManifest = GetPreparedBatchManifest(),
		    Declared = SelectedManifest[Files] & Record.FieldOrDefault(SelectedManifest, "Artifacts", {}),
		    Membership = List.Select(Declared, each [File] = Name),
		    Present = if List.Count(Membership) = 0 then false
		        else if List.Count(Membership) <> 1 then error "Duplicate Exchange hybrid free/busy declaration"
		        else if List.Count(List.Select(Record.FieldOrDefault(SelectedManifest, "Artifacts", {}), each [File] = Name)) <> 1
		             then error "Invalid Exchange hybrid free/busy artifact membership" else true,
		    TextValue = (value as any) as text => if value = null then "" else Text.From(value, "en-US"),
		    Parsed = if not Present then null else Csv.Document(GetPreparedEvidenceFile(Name),
		        [Delimiter=";", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
		    Header = if not Present then {} else if Table.IsEmpty(Parsed) then error "Empty Exchange hybrid free/busy CSV"
		        else List.Transform(Record.FieldValues(Parsed{0}), each TextValue(_)),
		    HeaderValid = not List.Contains(Header, "") and List.Count(List.Distinct(Header, Comparer.OrdinalIgnoreCase)) = List.Count(Header),
		    Promoted = if not Present then null else if not HeaderValid then error "Invalid Exchange hybrid free/busy CSV header"
		        else Table.PromoteHeaders(Parsed, [PromoteAllScalars=true]),
		    Checked = if not Present then null else if Table.HasColumns(Promoted, Spec[Required]) then Promoted
		        else error "Missing Exchange hybrid free/busy columns",
		    Scoped = if not Present then null else if List.AllTrue(List.Transform(Table.Column(Checked, "TenantKey"),
		        each _ = ExpectedTenant)) then Checked else error "Foreign Exchange hybrid free/busy tenant",
		    SourceRows = if not Present then {} else Table.ToRecords(Scoped),
		    Field = (row as record, column as text) as text => Text.Trim(TextValue(Record.FieldOrDefault(row, column, null))),
		    // Counts are plain non-negative integers; anything else stays unknown.
		    Count = (row as record, column as text) as nullable number =>
		        let Candidate = Field(row, column)
		        in if Candidate = "" or Text.Select(Candidate, {"0".."9"}) <> Candidate then null else Number.FromText(Candidate, "en-US"),
		    State = if not Present then "Not captured in selected batch" else "Captured - no rows",
		    SummarySchema = type table [#"Server Name"=text, Side=text, Auth=text, #"Run Status"=text, #"Side Status"=text,
		        #"Run Message"=text, #"Not Authorized Cmdlets"=text, #"Missing Roles"=text, #"Duration Seconds"=nullable Int64.Type,
		        #"Free Busy Checker Version"=text, #"Generation Time"=text, #"OK Count"=nullable Int64.Type,
		        #"Warning Count"=nullable Int64.Type, #"Error Count"=nullable Int64.Type, #"Info Count"=nullable Int64.Type,
		        #"Not Authorized Count"=nullable Int64.Type, #"Is Result"=logical, #"Source Available"=logical],
		    SummaryRow = (row as record) as record =>
		        [#"Server Name"=Field(row, "ServerName"), Side=Field(row, "Side"), Auth=Field(row, "Auth"),
		         #"Run Status"=Field(row, "RunStatus"), #"Side Status"=Field(row, "SideStatus"), #"Run Message"=Field(row, "RunMessage"),
		         #"Not Authorized Cmdlets"=Field(row, "NotAuthorizedCmdlets"), #"Missing Roles"=Field(row, "MissingRoles"),
		         #"Duration Seconds"=Count(row, "DurationSeconds"), #"Free Busy Checker Version"=Field(row, "FreeBusyCheckerVersion"),
		         #"Generation Time"=Field(row, "GenerationTime"), #"OK Count"=Count(row, "OkCount"),
		         #"Warning Count"=Count(row, "WarningCount"), #"Error Count"=Count(row, "ErrorCount"), #"Info Count"=Count(row, "InfoCount"),
		         #"Not Authorized Count"=Count(row, "NotAuthorizedCount"), #"Is Result"=true, #"Source Available"=true],
		    // Absent or empty capture stays an explicit unknown marker, never a healthy zero.
		    Marker = [#"Server Name"="Not recorded", Side="Not recorded", Auth="", #"Run Status"=State, #"Side Status"="Unknown",
		        #"Run Message"="Free/busy summary " & Text.Lower(State), #"Not Authorized Cmdlets"="", #"Missing Roles"="",
		        #"Duration Seconds"=null, #"Free Busy Checker Version"="", #"Generation Time"="", #"OK Count"=null,
		        #"Warning Count"=null, #"Error Count"=null, #"Info Count"=null, #"Not Authorized Count"=null,
		        #"Is Result"=false, #"Source Available"=Present],
		    FindingsSchema = type table [#"Server Name"=text, Side=text, Auth=text, Category=text, #"Row Number"=nullable Int64.Type,
		        Item=text, Status=text, Value=text, #"Value Masked"=logical, #"Free Busy Checker Version"=text, #"Generation Time"=text],
		    FindingRow = (row as record) as record =>
		        [#"Server Name"=Field(row, "ServerName"), Side=Field(row, "Side"), Auth=Field(row, "Auth"), Category=Field(row, "Category"),
		         #"Row Number"=Count(row, "RowNumber"), Item=Field(row, "Item"), Status=Field(row, "Status"), Value=Field(row, "Value"),
		         #"Value Masked"=Text.Lower(Field(row, "ValueMasked")) = "true",
		         #"Free Busy Checker Version"=Field(row, "FreeBusyCheckerVersion"), #"Generation Time"=Field(row, "GenerationTime")],
		    Result = if kind = "Summary" then Table.FromRecords(if List.IsEmpty(SourceRows) then {Marker} else List.Transform(SourceRows, SummaryRow), SummarySchema, MissingField.Error)
		        else Table.Sort(Table.FromRecords(List.Transform(SourceRows, FindingRow), FindingsSchema, MissingField.Error),
		            {{"Server Name", Order.Ascending}, {"Side", Order.Ascending}, {"Row Number", Order.Ascending}}),
		    Buffered = Table.Buffer(Result),
		    ForcedRows = Table.RowCount(Buffered)
		in
		    if ForcedRows >= 0 and CheckStable("verify-freebusy") then Buffered else error "Unstable Exchange hybrid free/busy batch",
		    Finish = (Rows as table) as table =>
		        if GetPreparedBatchManifest()[BatchId] <> BatchId then error "Prepared batch identity mismatch"
		        else Table.AddColumn(Rows, "Loaded Batch ID", each BatchId, type text)
		in
		    [BatchId=BatchId, Finish=Finish, GetExchangeOnPremInfrastructure=GetExchangeOnPremInfrastructure, GetExchangeHybridFreeBusy=GetExchangeHybridFreeBusy, GetPreparedEvidenceFile=GetPreparedEvidenceFile, GetPreparedBatchManifest=GetPreparedBatchManifest, GetLicenseReportQualification=GetLicenseReportQualification, LicenseReportFileUsable=LicenseReportFileUsable, GetLicenseReportSnapshot=GetLicenseReportSnapshot, GetLicenseReportCsv=GetLicenseReportCsv, ReadMigrationCsv=ReadMigrationCsv, CreateMailboxMigrationReader=CreateMailboxMigrationReader, ReadMailboxMigrationCsv=ReadMailboxMigrationCsv, ReadMigrationWeeklyHistory=ReadMigrationWeeklyHistory, GetSharePointOnPremCsv=GetSharePointOnPremCsv, GetSharePointMigrationEvidence=GetSharePointMigrationEvidence]
	lineageTag: 26f34f0c-24ee-421f-94a6-123ea48fb2ec

/// Every governed AD account type, including disabled/non-human accounts. Historical missing classification remains unknown. Prepared without materializing a new imported facet.
expression ReadPreparedADAccountClassification =
		() as table =>
		let
		    Readers = CreatePreparedReaders(),
		    Source = Readers[ReadMailboxMigrationCsv](Readers[GetPreparedEvidenceFile]("ADUserSource.csv"),
		        {"TenantKey", "ObjectGUID", "TenantADUserKey"}, {"AccountType"}),
		    TenantChecked = if List.AllTrue(List.Transform(Source[TenantKey], each _ = PreparedExpectedTenantKey))
		        then Source else error "AD account classification tenant mismatch",
		    Keyed = Table.TransformColumns(TenantChecked,
		        {{"ObjectGUID", each if _ = null then "" else Text.Lower(Text.Trim(_)), type text},
		         {"TenantADUserKey", each if _ = null then "" else Text.Trim(_), type text}}),
		    Objects = List.Buffer(Keyed[ObjectGUID]),
		    AccountKeys = List.Buffer(Keyed[TenantADUserKey]),
		    Checked = if not List.Contains(Objects, "") and not List.Contains(AccountKeys, "") and
		        List.Count(Objects) = List.Count(List.Distinct(Objects)) and
		        List.Count(AccountKeys) = List.Count(List.Distinct(AccountKeys))
		        then Keyed else error "Missing or duplicate native AD account classification identity",
		    Projected = Table.RenameColumns(Table.SelectColumns(Checked,
		        {"ObjectGUID", "TenantADUserKey", "AccountType"}, MissingField.UseNull),
		        {{"ObjectGUID", "Object GUID"}, {"TenantADUserKey", "AD Account Key"}, {"AccountType", "Account Type"}}),
		    Normalized = Table.TransformColumns(Projected,
		        {{"Account Type", each if _ = null or Text.Trim(_) = "" then "Not captured" else Text.Trim(_), type text}}),
		    Service = Table.AddColumn(Normalized, "Service Classification", each
		        if [Account Type] = "Not captured" then "Not captured"
		        else if List.Contains({"service", "service account"}, Text.Lower([Account Type])) then "Service"
		        else if List.Contains({"named account", "ext account", "generic account", "admin account", "system account", "resource account"},
		            Text.Lower([Account Type])) then "Other classified account"
		        else "Unknown classification", type text)
		in
		    Readers[Finish](Service)
