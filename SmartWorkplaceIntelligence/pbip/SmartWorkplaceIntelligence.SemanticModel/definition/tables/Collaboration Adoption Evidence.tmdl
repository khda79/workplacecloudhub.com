		sourceColumn: Usage Refresh Date

		variation Variation
			isDefault
			relationship: 1ed3a234-0fd6-44c0-a312-d960ad470074
			defaultHierarchy: LocalDateTable_092d7bca-578d-4359-9d57-7785e5c19297.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column 'Evidence Age Days'
		dataType: int64
		formatString: #,0
		lineageTag: 29002b71-91fc-48c6-8354-116c390da480
		summarizeBy: sum
		sourceColumn: Evidence Age Days

		annotation SummarizationSetBy = Automatic

	column 'Freshness State'
		dataType: string
		lineageTag: 9a0836ef-1375-4cc2-9f61-8dfe0f637d77
		summarizeBy: none
		sourceColumn: Freshness State

		annotation SummarizationSetBy = Automatic

	column 'Evidence Status'
		dataType: string
		lineageTag: f5b92dfc-2f74-4041-9a7d-46b3b5578dd7
		summarizeBy: none
		sourceColumn: Evidence Status

		annotation SummarizationSetBy = Automatic

	partition 'Collaboration Adoption Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("CollaborationAdoptionEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Service", "Eligible Users", "Active Users 30D", "Active User Rate (%)", "Service Objects", "Active Objects 30D", "Inactive Objects", "Orphaned Objects", "Objects with External Access", "Storage Used GB", "Usage Refresh Date", "Evidence Age Days", "Freshness State", "Evidence Status"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Eligible Users", "Active Users 30D", "Active User Rate (%)", "Service Objects", "Active Objects 30D", "Inactive Objects", "Orphaned Objects", "Objects with External Access", "Storage Used GB", "Usage Refresh Date", "Evidence Age Days"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Service", type text}, {"Eligible Users", Int64.Type}, {"Active Users 30D", Int64.Type}, {"Active User Rate (%)", type number}, {"Service Objects", Int64.Type}, {"Active Objects 30D", Int64.Type}, {"Inactive Objects", Int64.Type}, {"Orphaned Objects", Int64.Type}, {"Objects with External Access", Int64.Type}, {"Storage Used GB", type number}, {"Usage Refresh Date", type datetime}, {"Evidence Age Days", Int64.Type}, {"Freshness State", type text}, {"Evidence Status", type text}}, "en-US")
				in
				    Typed

