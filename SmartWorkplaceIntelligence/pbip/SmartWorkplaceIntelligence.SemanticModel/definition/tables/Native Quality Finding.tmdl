	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: dcee3689-0954-49ea-b1f4-9f9e8d4c3430
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'Native Quality Finding' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("FactDataQuality.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantFindingKey", dataType="String"], [name="FindingId", dataType="String"], [name="Severity", dataType="String"], [name="EntityType", dataType="String"], [name="FindingType", dataType="String"], [name="DetectedDateTime", dataType="DateTime"], [name="SourceSystem", dataType="String"], [name="Description", dataType="String"], [name="RecommendedAction", dataType="String"], [name="SeverityLabel", dataType="String"], [name="FindingTypeLabel", dataType="String"], [name="DescriptionLabel", dataType="String"], [name="RecommendedActionLabel", dataType="String"]}))
				in
				    Readers[Finish](BusinessRows)
