/// Governed IntuneConfigurationSettingEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Configuration Setting Evidence'
	lineageTag: 5c3f542e-d530-46fa-8e17-68bfc6ca53ba

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Settings' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Configuration Setting Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 689847ee-17e9-42cd-90dc-aaf71542e872

	/// Prepared IntuneConfigurationSettingEvidence.csv: TenantKey. Reported source scope only; not whole-tenant coverage or endpoint health.
	column 'Tenant Key'
		dataType: string
		isHidden
		lineageTag: 75ab4835-087c-42d3-b2c0-c6cf0f9d7b73
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared IntuneConfigurationSettingEvidence.csv: EvidenceKey. Reported source scope only; not whole-tenant coverage or endpoint health.
