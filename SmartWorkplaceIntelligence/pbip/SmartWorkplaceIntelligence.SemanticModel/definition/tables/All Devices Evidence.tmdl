		isHidden
		lineageTag: c01e4b19-3dc7-4612-932d-f9b9c5793706
		summarizeBy: none
		sourceColumn: Device Key

	column 'Inventory Source'
		dataType: string
		lineageTag: fbec4e75-bf85-4983-afc5-4e2e3b05865b
		summarizeBy: none
		sourceColumn: Inventory Source

	column Platform
