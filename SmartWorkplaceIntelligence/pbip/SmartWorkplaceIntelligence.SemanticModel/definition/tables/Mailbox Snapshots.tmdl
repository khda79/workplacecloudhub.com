/// One synthetic mailbox per reporting snapshot.
table 'Mailbox Snapshots'
	lineageTag: 3c7b81ad-062e-4506-9fa8-e84a2d986c2e

	/// Distinct mailboxes with an accepted synthetic snapshot.
	measure '# Mailboxes' = DISTINCTCOUNT('Mailbox Snapshots'[Mailbox Key])
		formatString: #,0
		displayFolder: Hosting
		lineageTag: 03ffd067-44dc-4122-8332-023a58ff304c

	/// Exchange Online mailboxes divided by mailboxes with an explicit Exchange Online or on-premises hosting location.
	measure 'Exchange Online Adoption (%)' = DIVIDE([# Exchange Online Mailboxes], [# Exchange Online Mailboxes] + [# On-premises Mailboxes])
		formatString: 0.0%
		displayFolder: Hosting
		lineageTag: beed85ec-ddf3-461c-b83a-10cfcdf8ab4e

	/// Distinct mailboxes explicitly observed as hosted in Exchange Online.
	measure '# Exchange Online Mailboxes' = CALCULATE([# Mailboxes], KEEPFILTERS('Mailbox Snapshots'[Hosting Location] = "Exchange Online"))
		formatString: #,0
		displayFolder: Hosting
		lineageTag: 441ffeaf-ff01-4e3e-89e2-dda9907e8b25

	/// Distinct mailboxes explicitly observed as hosted on-premises, including Exchange Server 2016, 2019, and Subscription Edition.
	measure '# On-premises Mailboxes' = CALCULATE([# Mailboxes], KEEPFILTERS('Mailbox Snapshots'[Hosting Location] = "On-premises"))
		formatString: #,0
		displayFolder: Hosting
		lineageTag: 927a63fb-ba34-47e1-b751-a879c42c78c7

	/// Distinct mailboxes with an enabled archive in the accepted snapshot.
	measure '# Mailboxes with Archive' = CALCULATE([# Mailboxes], KEEPFILTERS('Mailbox Snapshots'[Archive State] = "Enabled"))
		formatString: #,0
		displayFolder: Archive and Delegation
		lineageTag: 82ce4ba5-bd24-4e10-aee6-abb213047416

	/// Distinct mailboxes with at least one accepted Full Access, Send As, or Send on Behalf delegation.
	measure '# Mailboxes with Delegations' = CALCULATE([# Mailboxes], KEEPFILTERS('Mailbox Snapshots'[Delegation Count] > 0))
		formatString: #,0
		displayFolder: Archive and Delegation
		lineageTag: 34c2b1e7-a713-492c-b7bb-abfd5a8464e7

