		sourceColumn: Delegation Types

	partition 'Mailbox Snapshots Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Date Key" = Int64.Type, #"Tenant Key" = Int64.Type, #"Environment Key" = Int64.Type, #"Organization Key" = Int64.Type, #"Geography Key" = Int64.Type, #"Mailbox Key" = Int64.Type, #"Hosting Location" = nullable text, #"Exchange Version" = nullable text, #"Mailbox Size GB" = nullable number, #"Archive State" = nullable text, #"Archive Size GB" = nullable number, #"Delegation Count" = Int64.Type, #"Delegation Types" = nullable text, #"Migration State" = nullable text, #"Quota Raw" = nullable text, #"Quota GB" = nullable number, #"Quota Parse Status" = nullable text], {
				        {20260915, 1, 1, 1, 1, 1, "Exchange Online", "Exchange Online", 32.4, "Enabled", 8.6, 0, "None", "Completed", "50 GB", 50, "Parsed"},
				        {20260915, 1, 1, 2, 1, 2, "On-premises", "Exchange Server 2019", 68.2, "Enabled", 12.5, 2, "Full Access; Send As", "Planned", "Unlimited", null, "Sentinel"},
				        {20260915, 1, 1, 3, 2, 3, "On-premises", "Exchange Server 2016", 23.8, "Disabled", 0, 0, "None", "Blocked", "25 GB", 25, "Parsed"},
				        {20260915, 1, 1, 5, 3, 4, "On-premises", "Exchange Server SE", 14.6, "Enabled", 4.2, 1, "Send on Behalf", "NotStarted", "Error", null, "SourceError"}
				    })
				in
