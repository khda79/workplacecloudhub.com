/// Synthetic governed current issues and evidence-backed risk signals.
table Findings
	lineageTag: b1b8e433-dcb5-47da-8646-095d446f2569

	/// Open findings with qualified evidence and actionable severity.
	measure '# Actionable Findings' = CALCULATE(COUNTROWS('Findings'), KEEPFILTERS('Findings'[Finding Status] = "Open"), KEEPFILTERS('Findings'[Evidence Status] = "Observed"), KEEPFILTERS('Findings'[Severity Label] IN {"Critical", "High", "Medium"}))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 6ce3dd84-bf6d-434d-b320-77da18e48f1b

	/// Distinct entity-type-aware keys affected by visible findings.
	measure '# Affected Entities' = DISTINCTCOUNT('Findings'[Affected Entity Key])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 5232b6e0-d786-40c8-8a24-1e3929b1b493

	/// Distinct devices affected by visible findings.
	measure '# Affected Devices' = CALCULATE(DISTINCTCOUNT('Findings'[Affected Entity Key]), KEEPFILTERS('Findings'[Affected Entity Type] = "Device"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 8dcce063-2273-429b-996c-58525e851769

	/// Open qualified critical findings.
	measure '# Critical Findings' = CALCULATE(COUNTROWS('Findings'), KEEPFILTERS('Findings'[Finding Status] = "Open"), KEEPFILTERS('Findings'[Evidence Status] = "Observed"), KEEPFILTERS('Findings'[Severity Label] = "Critical"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 8b99cc2c-68a8-4ffb-8d23-2f7b5dfc4973

	/// Open qualified high findings.
	measure '# High Findings' = CALCULATE(COUNTROWS('Findings'), KEEPFILTERS('Findings'[Finding Status] = "Open"), KEEPFILTERS('Findings'[Evidence Status] = "Observed"), KEEPFILTERS('Findings'[Severity Label] = "High"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 3886b5f2-99f2-46e7-8aef-5e2f6af728ed

	/// Open qualified medium findings.
	measure '# Medium Findings' = CALCULATE(COUNTROWS('Findings'), KEEPFILTERS('Findings'[Finding Status] = "Open"), KEEPFILTERS('Findings'[Evidence Status] = "Observed"), KEEPFILTERS('Findings'[Severity Label] = "Medium"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 9608d8af-7fd4-4bc2-b9ff-f428f7475036

	/// Findings blocked by unavailable or invalid evidence.
	measure '# Evidence-Blocked Findings' = CALCULATE(COUNTROWS('Findings'), KEEPFILTERS('Findings'[Evidence Status] IN {"Not Collected", "Source Error", "Unknown"}))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 8bdf8912-a6f3-48c9-9660-4bc5bdc2f6ca

	/// Days between reporting date and latest qualified finding evidence.
	measure 'Evidence Age Days' = VAR _evidenceDate = MAX('Findings'[Evidence Date]) VAR _reportingDate = MAX('Date'[Date]) RETURN IF(ISBLANK(_evidenceDate), BLANK(), DATEDIFF(_evidenceDate, _reportingDate, DAY))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 9698a351-12e8-4241-9b92-829f21a0c3be

	/// Overall evidence status for visible findings.
	measure 'Finding Evidence Status' = VAR _blocked = [# Evidence-Blocked Findings] RETURN IF(_blocked > 0, "Evidence Blocked", "Evidence Qualified")
		formatString: @
		displayFolder: Measures
		lineageTag: 36526777-a459-4d91-bb34-8b8eb6cca959

	/// Open evidence-backed current issues and risk signals affecting users.
	measure '# User Risk Signals' = CALCULATE([# Actionable Findings], KEEPFILTERS('Findings'[Affected Entity Type] = "User"))
		formatString: #,0
		displayFolder: Risk Signals
		lineageTag: 172d5716-8813-4848-95d3-baf0c9a052c8

	/// Compact summary used when a page has no or few evidence-backed risk and incident signals.
	measure 'Risk and Incident Summary' =
			VAR _count = COALESCE([# Actionable Findings], 0)
			RETURN IF(_count = 0, "No open evidence-backed signals", FORMAT(_count, "#,0") & " actionable evidence-backed signals")
		formatString: @
		displayFolder: Measures
		lineageTag: dfb29626-de06-45f9-8ebf-631234426a4d

	/// Business attribute Date Key.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 9abec1dc-0c68-4f2b-8aa8-18d28c83c7d8
		summarizeBy: none
		sourceColumn: Date Key

