				        {20260915, 1, 1, 1, 1, 2, "High", "Identity Hygiene", "Observed", "User", "USR-SYNTH-002", "Review account need and ownership", "DirectoryUsers/1.0.0", "Open", #datetime(2026, 9, 15, 0, 0, 0)},
