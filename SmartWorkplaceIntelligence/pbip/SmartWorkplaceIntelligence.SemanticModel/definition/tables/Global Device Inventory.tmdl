	/// Qualified platform/form factor class. Windows/macOS computers PC; Android/iOS/iPadOS mobile; servers separate; no OS invention for unknown identities.
	column 'Device Class' = VAR _os=LOWER(COALESCE([Operating System Family],"")) VAR _cat=[Device Category] RETURN SWITCH(TRUE(),CONTAINSSTRING(_os,"server")||_cat="Server","Server",CONTAINSSTRING(_os,"android")||_os IN {"ios","ipados","iphone","ipad"},"Mobile",CONTAINSSTRING(_os,"windows")||CONTAINSSTRING(_os,"mac")||_cat IN {"PC","PC Windows"},"PC","Unclassified")
		dataType: string
		lineageTag: e4ff6c62-e5dd-4e41-805a-51d1e3e847ca

	column 'OS Family' = VAR _os=LOWER(COALESCE([Operating System Family],"")) RETURN SWITCH(TRUE(),CONTAINSSTRING(_os,"windows"),"Windows",CONTAINSSTRING(_os,"mac"),"macOS",CONTAINSSTRING(_os,"android"),"Android",_os="ipados","iPadOS",_os IN {"ios","iphone","ipad"},"iOS",CONTAINSSTRING(_os,"linux"),"Linux","Unknown")
		dataType: string
		lineageTag: ccb04ba9-16e3-40aa-b993-5e28f8c8415a

	column 'Autopilot link status' = VAR _k=[Canonical Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID] VAR _ap=FILTER('Autopilot Identity Audit',[TenantKey]=_t && [Loaded Batch ID]=_b && ([Equipment key]=_k || [Entra identity key]=_k)) RETURN SWITCH(TRUE(),COUNTROWS(_ap)=0,"Not observed in Autopilot",COUNTROWS(FILTER(_ap,[Reconciliation]="Unique Autopilot equipment link" || [Reconciliation]="Same enrolled identity"))>0,"Enrolled · explicit Intune match",COUNTROWS(FILTER(_ap,[Reconciliation]="No observed Intune match"))=COUNTROWS(_ap),"Registered · no observed Intune match","Unresolved / conflicting identifiers")
		dataType: string
		lineageTag: e8788591-e10c-4ac4-98fd-70696394fb05

	column 'Autopilot serial numbers' = VAR _k=[Canonical Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID] RETURN CONCATENATEX(FILTER('Autopilot Identity Audit',[TenantKey]=_t && [Loaded Batch ID]=_b && ([Equipment key]=_k || [Entra identity key]=_k)),[Serial number],", ",[Serial number],ASC)
		dataType: string
		lineageTag: 4086f0e8-b839-4f9e-b105-1ee57cee883c

	/// Latest observed AD/Entra/Intune activity timestamp linked to the canonical native identity, UTC. Missing evidence remains blank.
