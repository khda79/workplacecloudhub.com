/// Equipment grain from cached source identities. Only explicit unique tenant/batch-scoped Autopilot aliases consolidate. All source identities retained in Device Identity Inventory and Autopilot Identity Audit. PC category normalized independently of enrollment.
table 'Global Device Inventory'
	lineageTag: fe302389-53ae-4be1-9744-31482267fa99

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Global Device Count' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((
			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _presence=VALUES('Intune Presence Selection'[Intune presence])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _pf=ISFILTERED('Intune Presence Selection')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[SourceUserId]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _allLicensed=ALL('Native User License'[SourceUserId])
			VAR _knownUsers=ALL('Native User Evidence'[SourceUserId])
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _risk=ISFILTERED('Device Deployment Risk'[Enrollment Risk]) || ISFILTERED('Device Deployment Risk'[Windows 11 Deployment Risk])
			VAR _riskKeys=VALUES('Device Deployment Risk'[Inventory Key])
			VAR _rows=FILTER('Global Device Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _pf || [Intune presence] IN _presence) &&
			 (NOT _lf || [Primary User Source ID] IN _withLicense || (_none && NOT ISBLANK([Primary User Source ID]) && [Primary User Source ID] IN _knownUsers && NOT ([Primary User Source ID] IN _allLicensed)) || (_unknown && (ISBLANK([Primary User Source ID]) || NOT ([Primary User Source ID] IN _knownUsers)))) &&
			 (NOT _risk || VAR _id=[Device Source ID] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID] VAR _ad=[AD Computer Key]
			 VAR _legacy=IF(NOT ISBLANK(_id),LOOKUPVALUE('Device Exploration Inventory'[Inventory Key],'Device Exploration Inventory'[Device Source ID],_id,'Device Exploration Inventory'[TenantKey],_t,'Device Exploration Inventory'[Loaded Batch ID],_b),IF(NOT ISBLANK(_ad),"ad:"&_ad))
			 RETURN _legacy IN _riskKeys))
			RETURN COALESCE(COUNTROWS(_rows),0)),KEEPFILTERS(TREATAS(_pu,'Global Device Inventory'[Primary User (report)]))),(
			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _presence=VALUES('Intune Presence Selection'[Intune presence])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _pf=ISFILTERED('Intune Presence Selection')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[SourceUserId]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _allLicensed=ALL('Native User License'[SourceUserId])
			VAR _knownUsers=ALL('Native User Evidence'[SourceUserId])
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _risk=ISFILTERED('Device Deployment Risk'[Enrollment Risk]) || ISFILTERED('Device Deployment Risk'[Windows 11 Deployment Risk])
			VAR _riskKeys=VALUES('Device Deployment Risk'[Inventory Key])
			VAR _rows=FILTER('Global Device Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _pf || [Intune presence] IN _presence) &&
			 (NOT _lf || [Primary User Source ID] IN _withLicense || (_none && NOT ISBLANK([Primary User Source ID]) && [Primary User Source ID] IN _knownUsers && NOT ([Primary User Source ID] IN _allLicensed)) || (_unknown && (ISBLANK([Primary User Source ID]) || NOT ([Primary User Source ID] IN _knownUsers)))) &&
			 (NOT _risk || VAR _id=[Device Source ID] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID] VAR _ad=[AD Computer Key]
			 VAR _legacy=IF(NOT ISBLANK(_id),LOOKUPVALUE('Device Exploration Inventory'[Inventory Key],'Device Exploration Inventory'[Device Source ID],_id,'Device Exploration Inventory'[TenantKey],_t,'Device Exploration Inventory'[Loaded Batch ID],_b),IF(NOT ISBLANK(_ad),"ad:"&_ad))
			 RETURN _legacy IN _riskKeys))
			RETURN COALESCE(COUNTROWS(_rows),0)))
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: 1f892cf7-3451-4a53-9baa-2cb7a026f519

