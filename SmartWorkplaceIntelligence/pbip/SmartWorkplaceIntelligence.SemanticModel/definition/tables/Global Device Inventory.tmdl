	/// Equipment grain. Device class and native filters retained; Country/AD Domain/licences use Global Device Count. Unknown evidence never inferred healthy.
	measure 'Equipment Encryption Rate (%)' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((DIVIDE(CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Intune presence]="In Intune"),KEEPFILTERS('Global Device Inventory'[Intune Encryption State] IN {"Encrypted","True","Yes","Healthy","Protected"})),[Equipment Managed Devices])),KEEPFILTERS(TREATAS(_pu,'Global Device Inventory'[Primary User (report)]))),(DIVIDE(CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Intune presence]="In Intune"),KEEPFILTERS('Global Device Inventory'[Intune Encryption State] IN {"Encrypted","True","Yes","Healthy","Protected"})),[Equipment Managed Devices])))
		formatString: 0.0%
		displayFolder: Private PC and Mobile equipment
		lineageTag: 70e0c548-af57-4476-b987-bdbe19b578ed

	/// Read-only report utility applying the disconnected primary-user selector to source-qualified device rows.
	measure 'Primary user row match · Global Device Inventory' = VAR PresentRows = IF(ISFILTERED('Primary User Selection'[Primary user]), CALCULATE(COUNTROWS('Global Device Inventory'), KEEPFILTERS(TREATAS(VALUES('Primary User Selection'[Primary user]), 'Global Device Inventory'[Primary User (report)]))), COUNTROWS('Global Device Inventory')) RETURN IF(PresentRows>0,1,BLANK())
		formatString: 0
		isHidden
		lineageTag: 4558f80d-5b71-4640-85e3-570382d85bcf

	/// Windows/macOS; observed AD-domain membership establishes Corporate, otherwise Intune Corporate. Explicit enabled state only; unknown/conflicting states and servers excluded. Inherits shared Country/AD Domain/Primary user filters.
	measure 'Enabled corporate PC devices' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="PC"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Corporate"),KEEPFILTERS('Global Device Inventory'[Enabled state (report)]="Enabled"))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: 85654a11-966e-4b29-a6f5-069a65e57fbc

	/// Confirmed enabled Corporate Android/iOS/iPadOS only. Numeric observed count; use Corporate mobile KPI value for a coverage-aware card.
	measure 'Enabled corporate mobile devices' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Corporate"),KEEPFILTERS('Global Device Inventory'[Enabled state (report)]="Enabled"))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: 5af246bd-578b-433e-916b-e3b6804def25

	/// Confirmed enabled Personal Android/iOS/iPadOS only. Missing Entra AccountEnabled is Unknown, never Disabled.
	measure 'Enabled personal mobile devices' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Personal"),KEEPFILTERS('Global Device Inventory'[Enabled state (report)]="Enabled"))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: e86d5762-9dce-4f28-9a63-1305d60adac1

	measure 'Corporate mobile coverage gaps' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS(FILTER('Global Device Inventory',[Ownership (report)]="Unknown" || ([Ownership (report)]="Corporate" && [Enabled state (report)] IN {"Unknown","Conflicting"}))))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: f3deed16-6f62-489c-ae01-29c5d071c1f1

	measure 'Personal mobile coverage gaps' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Personal"),KEEPFILTERS('Global Device Inventory'[Enabled state (report)] IN {"Unknown","Conflicting"}))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: 1f1af2c3-630c-4683-af0d-c44d56af4a9f

	/// Android/iOS/iPadOS with qualified Corporate ownership, regardless of enabled/disabled/unknown account state. Unknown ownership excluded, retained in inventory. Country, AD Domain and other existing shared filters preserved.
	measure 'Corporate mobile KPI value' = FORMAT(CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Corporate")),"#,0")
		displayFolder: Corporate device reporting
		lineageTag: 35687f83-b63c-495e-9a8a-bd2c51eecfdb

	/// Android/iOS/iPadOS with qualified Personal ownership, regardless of enabled/disabled/unknown account state. Unknown ownership excluded, retained in inventory. Country, AD Domain and other existing shared filters preserved.
	measure 'Personal mobile KPI value' = FORMAT(CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Personal")),"#,0")
		displayFolder: Corporate device reporting
		lineageTag: f9cfc3e6-24f0-48bd-882f-aa5522be45ac

	measure 'Mobile unknown account states' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Enabled state (report)] IN {"Unknown","Conflicting"}))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: 53ec8c5a-7a08-4de0-9f08-461129d5185f

	measure 'Mobile unknown ownership' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Unknown"))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: 9183a137-e6c0-4709-8dae-46dbb4b8e1da

	measure 'Managed personal mobile devices' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Personal"),KEEPFILTERS('Global Device Inventory'[Intune presence]="In Intune"))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: e8b253ff-5027-421c-8c3d-5f0712bf2364

	measure 'Corporate devices with unknown platform' = CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Unknown"),KEEPFILTERS('Global Device Inventory'[Ownership (report)]="Corporate"),KEEPFILTERS('Global Device Inventory'[Enabled state (report)]="Enabled"))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: 10c95217-80d1-4800-8156-cddbc870dbee

	measure 'Device ownership conflicts' = CALCULATE([Global Device Count],KEEPFILTERS(FILTER('Global Device Inventory',CONTAINSSTRING([Ownership qualification (report)],"conflict"))))
		formatString: #,0
		displayFolder: Corporate device reporting
		lineageTag: 0ad67094-b61a-43fe-9b47-29b608c0b9dd

	measure 'Mobile enabled state coverage (%)' = DIVIDE(CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile"),KEEPFILTERS('Global Device Inventory'[Enabled state (report)] IN {"Enabled","Disabled"})),CALCULATE([Global Device Count],KEEPFILTERS('Global Device Inventory'[Device type (report)]="Mobile")))
		formatString: 0.0%
		displayFolder: Corporate device reporting
		lineageTag: 1eaa2646-09a5-4779-8e44-2947f83592ee

	measure 'Device qualification context' = "Corporate = observed AD domain; otherwise Intune ownership. Platform = Intune/native OS, then exact AD OS. Unknown platform (enabled corporate): "&FORMAT([Corporate devices with unknown platform],"#,0")&". Mobile account-state gaps: "&FORMAT([Mobile unknown account states],"#,0")&"; mobile unknown ownership: "&FORMAT([Mobile unknown ownership],"#,0")&". Personal mobile managed by Intune: "&FORMAT([Managed personal mobile devices],"#,0")&". Unknown is not disabled. Cached mobile AccountEnabled is absent; no enabled-state inference from management or recent sync."
		displayFolder: Corporate device reporting
		lineageTag: 074e9a21-8eb1-4d12-919c-427e230959e1

