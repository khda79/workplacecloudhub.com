	/// Observed primary user, exact source ID and tenant/batch matching only; used by the report search.
	column 'Primary User (report)' =
			VAR _t='Global Device Inventory'[TenantKey]
			VAR _b='Global Device Inventory'[Loaded Batch ID]
			VAR _gkey='Global Device Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Global Device Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Global Device Inventory'[Device Source ID]))
			VAR _upn=COALESCE('Global Device Inventory'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			RETURN IF(ISBLANK(_upn)||TRIM(_upn)="","Not resolved",_upn)
		dataType: string
		displayFolder: Report identity context
		lineageTag: 6cdb688d-993f-4ef4-b729-2b9ec1e6cde8

	/// Qualified SAM of the primary user; never inferred from UPN text.
	column 'Primary User SAM (report)' =
			VAR _t='Global Device Inventory'[TenantKey]
			VAR _b='Global Device Inventory'[Loaded Batch ID]
			VAR _gkey='Global Device Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Global Device Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Global Device Inventory'[Device Source ID]))
			VAR _upn=COALESCE('Global Device Inventory'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			VAR _sam=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User SAM],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_sam,IF(NOT ISBLANK(_upn),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[UserPrincipalName],_upn,'Native User Evidence'[TenantKey],_t,'Native User Evidence'[Loaded Batch ID],_b,BLANK())),"Not resolved")
		dataType: string
		displayFolder: Report identity context
		lineageTag: f3a8ff16-65ed-4e34-84f8-84a4ee34d107

	/// Last Windows console user observed at collection. Does not mean current user or last RDP session.
	column 'Last Console User (report)' =
			VAR _t='Global Device Inventory'[TenantKey]
			VAR _b='Global Device Inventory'[Loaded Batch ID]
			VAR _gkey='Global Device Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Global Device Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Global Device Inventory'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(_status="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon User],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())),"Not observed")
		dataType: string
		displayFolder: Report identity context
		lineageTag: 7e8b9c6d-4b7a-45f1-8e19-13ed8e30ceb3

	/// Source-qualified time of last observed console logon; unknown remains blank.
	column 'Last Console Logon UTC (report)' =
			VAR _t='Global Device Inventory'[TenantKey]
			VAR _b='Global Device Inventory'[Loaded Batch ID]
			VAR _gkey='Global Device Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Global Device Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Global Device Inventory'[Device Source ID]))
			RETURN IF(IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon UTC],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		displayFolder: Report identity context
		lineageTag: 1e7a16e3-1c36-4789-8bd2-ac90d79cabea

	/// Preserves source status and timestamp qualification, including stale/missing/error evidence.
	column 'Console Logon Qualification (report)' =
			VAR _t='Global Device Inventory'[TenantKey]
			VAR _b='Global Device Inventory'[Loaded Batch ID]
			VAR _gkey='Global Device Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Global Device Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Global Device Inventory'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _quality=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Quality],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(ISBLANK(_status),"No matched system observation",_status&" · "&_quality)
		dataType: string
		displayFolder: Report identity context
		lineageTag: 0e5842dc-96fe-4edb-a57e-0035c594ed38

	column 'Report Estate Device Key' =
			VAR _canonical=[Canonical Device Key] VAR _id=[Device Source ID]
			RETURN IF(LEFT(_canonical,3)="ad:",_canonical,IF(NOT ISBLANK(_id)&&_id<>"","intune:"&LOWER(_id)))
		dataType: string
		isHidden
		displayFolder: Device qualification
		lineageTag: 37d699a8-6ee2-4f4c-9304-6d3a6baec7e8
		summarizeBy: none

	/// Intune/native platform with exact estate AD OS fallback. Missing evidence stays Unknown.
	column 'Platform (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Platform (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _os=LOWER(TRIM(COALESCE([Operating System Family],[Platform],"")))
			VAR _fallback=SWITCH(TRUE(),CONTAINSSTRING(_os,"windows")&&CONTAINSSTRING(_os,"server"),"Windows Server",CONTAINSSTRING(_os,"windows"),"Windows",CONTAINSSTRING(_os,"mac")||_os IN {"os x","osx","darwin"},"macOS",CONTAINSSTRING(_os,"android"),"Android",_os IN {"ipados","ipad"},"iPadOS",_os IN {"ios","iphone"},"iOS",CONTAINSSTRING(_os,"linux"),"Linux",_os IN {"","unknown","unclassified","not observed","other / unknown"},"Unknown","Other")
			RETURN IF(NOT ISBLANK(_estate)&&_estate<>"Unknown",_estate,_fallback)
		dataType: string
		displayFolder: Device qualification
		lineageTag: 9fb78454-6940-4c17-b6ae-2d0afe79cea9
		summarizeBy: none

	column 'Platform evidence (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			RETURN COALESCE(IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Platform evidence (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK())),IF([Platform (report)]="Unknown","Not observed","Native device operating system"))
		dataType: string
		displayFolder: Device qualification
		lineageTag: 6aaaed93-a8fe-4d92-9952-b0d44557a5f9
		summarizeBy: none

	column 'Device type (report)' = SWITCH(TRUE(),[Platform (report)] IN {"Windows","macOS"},"PC",[Platform (report)] IN {"Android","iOS","iPadOS"},"Mobile",[Platform (report)]="Windows Server","Server",[Platform (report)]="Unknown","Unknown","Other")
		dataType: string
		displayFolder: Device qualification
		lineageTag: cb415851-84a3-47d3-a38f-3c4d5e4ed15c
		summarizeBy: none

	column 'Ownership (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Ownership (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _ad=NOT ISBLANK([AD Computer Key])&&NOT(TRIM(COALESCE([AD Domain],"Unknown")) IN {"","Unknown","Not resolved"})
			RETURN COALESCE(_estate,IF(_ad,"Corporate",SWITCH(LOWER([Ownership]),"corporate","Corporate","company","Corporate","personal","Personal","Unknown")))
		dataType: string
		displayFolder: Device qualification
		lineageTag: 731bcd4b-227e-40c7-bb28-349801af9ff4
		summarizeBy: none

	column 'Ownership qualification (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Ownership qualification (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_estate,SWITCH([Ownership (report)],"Corporate","Corporate: native device evidence","Personal","Personal: native device evidence","Ownership not observed"))
		dataType: string
		displayFolder: Device qualification
		lineageTag: eec1ad34-a763-42b3-91cf-13f4534c3c75
		summarizeBy: none

	column 'Entra state (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Entra state (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _raw=IF(_estate IN {"Enabled","Disabled","Conflicting"},_estate,[Entra Account State])
			RETURN SWITCH(_raw,"Enabled","Enabled","Disabled","Disabled","Conflicting","Conflicting","Unknown")
		dataType: string
		displayFolder: Device qualification
		lineageTag: 218ca427-e6a9-471e-8b84-d813ce34c404
		summarizeBy: none

	column 'Enabled state (report)' =
			VAR _ad=[AD Enabled] VAR _e=[Entra state (report)]
			RETURN SWITCH(TRUE(),_e="Conflicting"||(_ad="Yes"&&_e="Disabled")||(_ad="No"&&_e="Enabled"),"Conflicting",_ad="Yes"||_e="Enabled","Enabled",_ad="No"||_e="Disabled","Disabled","Unknown")
		dataType: string
		displayFolder: Device qualification
		lineageTag: f6df8619-4a19-4e99-9525-4e70257c7edc
		summarizeBy: none

	column 'Account state evidence (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Account state evidence (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_estate,IF([Entra state (report)] IN {"Enabled","Disabled"},"Entra AccountEnabled observed","Entra AccountEnabled absent from cached native evidence"))
		dataType: string
		displayFolder: Device qualification
		lineageTag: 02a511e8-e4a2-426b-ba04-7c52dd8f570a
		summarizeBy: none

	partition 'Global Device Inventory' = calculated
		mode: import
		source =
				VAR _aliases=FILTER('Autopilot Identity Audit',[Reconciliation]="Unique Autopilot equipment link")
				VAR _equipment=FILTER('Device Identity Inventory',NOT CONTAINS(_aliases,'Autopilot Identity Audit'[TenantKey],[TenantKey],'Autopilot Identity Audit'[Loaded Batch ID],[Loaded Batch ID],'Autopilot Identity Audit'[Entra identity key],[Canonical Device Key]))
				RETURN SELECTCOLUMNS(_equipment,
				"Device Source ID",[Device Source ID],
				"Device Name",[Device Name],
				"Primary User UPN",[Primary User UPN],
				"Country",[Country],
				"Platform",[Platform],
				"Device Category",VAR _os=LOWER(COALESCE([Operating System Family],"")) VAR _cat=[Device Category] RETURN SWITCH(TRUE(),CONTAINSSTRING(_os,"server"),"Server",CONTAINSSTRING(_os,"android")||_os IN {"ios","ipados","iphone","ipad"},"Mobile",CONTAINSSTRING(_os,"windows")||CONTAINSSTRING(_os,"mac")||_cat IN {"PC","PC Windows"},"PC",_cat IN {"Unknown","Unclassified"},"Unclassified",_cat),
				"Ownership",[Ownership],
				"Management State",[Management State],
				"Compliance State",[Compliance State],
				"Manufacturer",[Manufacturer],
				"Model",[Model],
				"Operating System Family",[Operating System Family],
				"Operating System Version",[Operating System Version],
				"Windows Release",[Windows Release],
				"Disk Space State",[Disk Space State],
				"AD to Intune Match",[AD to Intune Match],
				"Entra Match",[Entra Match],
				"Tenure Confidence",[Tenure Confidence],
				"Windows Generation",[Windows Generation],
				"Windows 11 Upgrade Eligibility",[Windows 11 Upgrade Eligibility],
				"Windows 11 Blocking Reasons",[Windows 11 Blocking Reasons],
				"Windows Update State",[Windows Update State],
				"Windows Update Risk",[Windows Update Risk],
				"Windows Update Action Code",[Windows Update Action Code],
				"Secure Boot State",[Secure Boot State],
				"Endpoint Analytics State",[Endpoint Analytics State],
				"Stop Error State",[Stop Error State],
				"Entra Hardware ID Conflict",[Entra Hardware ID Conflict],
				"Removal Candidate",[Removal Candidate],
				"Windows 11 Release State",[Windows 11 Release State],
				"Entra Account State",[Entra Account State],
				"Intune Encryption State",COALESCE([Intune Encryption State],LOOKUPVALUE('Native Device Evidence'[EncryptionState],'Native Device Evidence'[TenantDeviceKey],[Native Device Key],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID])),
				"System Drive Capacity (GB)",[System Drive Capacity (GB)],
				"Free Disk Space (GB)",[Free Disk Space (GB)],
				"Free Disk Space (%)",[Free Disk Space (%)],
				"Managed Tenure (Years)",[Managed Tenure (Years)],
				"Endpoint Analytics Score",[Endpoint Analytics Score],
				"Stop Error Count",[Stop Error Count],
				"Last Sync DateTime",COALESCE([Last Sync DateTime],LOOKUPVALUE('Native Device Evidence'[SyncUtcDateTime],'Native Device Evidence'[TenantDeviceKey],[Native Device Key],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID])),
				"Observed Since",[Observed Since],
				"Inventory Key",[Inventory Key],
				"Intune presence",[Intune presence],
				"AD Enabled",[AD Enabled],
				"AD Domain",[AD Domain],
				"AD Match Qualification",[AD Match Qualification],
				"AD Created (source)",[AD Created (source)],
				"AD Creation Qualification",[AD Creation Qualification],
				"AD Modified (source)",[AD Modified (source)],
				"AD Modification Qualification",[AD Modification Qualification],
				"AD Password Expiry Status",[AD Password Expiry Status],
				"Inventory Source",[Inventory Source],
				"Expected AV Name",[Expected AV Name],
				"Expected AV State",[Expected AV State],
				"Third Party AV Products",[Third Party AV Products],
				"Windows Update Reboot Required",[Windows Update Reboot Required],
				"BitLocker OS Protection",[BitLocker OS Protection],
				"BitLocker OS Conversion",[BitLocker OS Conversion],
				"Encryption Comparison",[Encryption Comparison],
				"System Data Quality Issues",[System Data Quality Issues],
				"System Freshness",[System Freshness],
				"System Observation (source)",[System Observation (source)],
				"Loaded Batch ID",[Loaded Batch ID],
				"TenantKey",[TenantKey],
				"AD Source Collected UTC",[AD Source Collected UTC],
				"Country Name",VAR _raw=[Country Name] RETURN COALESCE(LOOKUPVALUE('Country Selection'[Country],'Country Selection'[Source Country],_raw),_raw,"Unknown / unassigned"),
				"AD Windows PC",[AD Windows PC],
				"Entra Created (source)",[Entra Created (source)],
				"Entra Creation Qualification",[Entra Creation Qualification],
				"Entra Modified (source)",[Entra Modified (source)],
				"Entra Modification Qualification",[Entra Modification Qualification],
				"AD Password Expired",[AD Password Expired],
				"Canonical Device Key",[Canonical Device Key],
				"Native Device Key",[Native Device Key],
				"AD Computer Key",[AD Computer Key],
				"Primary User Source ID",[Primary User Source ID],
				"Primary User SAM",[Primary User SAM])
