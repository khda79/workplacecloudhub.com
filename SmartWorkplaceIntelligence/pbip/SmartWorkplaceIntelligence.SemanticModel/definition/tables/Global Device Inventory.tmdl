	/// Confirmed minimum when any linked directory state is absent from the loaded evidence.
	measure 'Disabled Devices AD/Entra Display' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF([Device State Evidence Missing]>0,"≥ ","") & FORMAT([Disabled Devices AD/Entra],"#,0","fr-FR")),KEEPFILTERS(TREATAS(_pu,'Global Device Inventory'[Primary User (report)]))),(IF([Device State Evidence Missing]>0,"≥ ","") & FORMAT([Disabled Devices AD/Entra],"#,0","fr-FR")))
		displayFolder: Private account and device explorer
		lineageTag: d30ee0ef-8bc3-4ccf-929e-d0acb9e77f04

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Disabled Devices AD/Entra Evidence' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE(("Disabled in AD or Entra; canonical identity counted once. " & FORMAT([Device State Evidence Missing],"#,0") & " identities have incomplete directory-state evidence. A ≥ value is a confirmed minimum, not an exhaustive disabled total."),KEEPFILTERS(TREATAS(_pu,'Global Device Inventory'[Primary User (report)]))),("Disabled in AD or Entra; canonical identity counted once. " & FORMAT([Device State Evidence Missing],"#,0") & " identities have incomplete directory-state evidence. A ≥ value is a confirmed minimum, not an exhaustive disabled total."))
		displayFolder: Private account and device explorer
		lineageTag: 192c9301-a8bc-4e51-9d5b-cef0c136eb6a

