/// Native source facet migrated from FactRelationshipOverview; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native Relationship Summary'
	lineageTag: aa1cfb73-e489-4903-a8f7-7759fd7f2f7e

	/// Exact observed relationship edges by supported source type. Migrated without changing the source calculation.
	measure 'Native Relationship edges' = (SUM('Native Relationship Summary'[RelationshipCount]))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 48b8b69e-d02c-48e5-ab0b-2f84ac537e89

	/// Share of exact observed edges by relationship type. Migrated without changing the source calculation.
	measure 'Native Relationship type rate' = (DIVIDE([Native Relationship edges], CALCULATE([Native Relationship edges], REMOVEFILTERS('Native Relationship Summary'[RelationshipType]))))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: 01ec8bd4-ae43-4233-9bd8-ab35952cb877

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Native Relationship Summary' = (COUNTROWS('Native Relationship Summary'))
		formatString: #,0
		isHidden
		lineageTag: ed20c42d-bdfe-4675-b868-bfd49a410ad8

	/// Native FactRelationshipOverview attribute; source qualification is retained.
	column RelationshipType
		dataType: string
		lineageTag: 179acdc7-825a-4eee-89b9-bf9288629b79
		summarizeBy: none
		sourceColumn: RelationshipType

	/// Native FactRelationshipOverview attribute; source qualification is retained.
	column RelationshipCount
		dataType: int64
		lineageTag: 74d3af5b-189d-4452-82ec-a6d66ac1a526
		summarizeBy: none
		sourceColumn: RelationshipCount

	/// Native FactRelationshipOverview attribute; source qualification is retained.
	column EvidenceSource
		dataType: string
		lineageTag: a8c60ffa-7b97-4361-9091-0cb753bea05a
		summarizeBy: none
		sourceColumn: EvidenceSource

	column TenantKey
		dataType: string
		lineageTag: cb7ecc33-338b-4b0c-ae6e-2e244e2a9a43
		summarizeBy: none
		sourceColumn: TenantKey

		annotation SummarizationSetBy = Automatic

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 61171486-2cdf-4553-aabc-a6665e5f3af3
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'Native Relationship Summary' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("FactRelationshipOverview.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="RelationshipType", dataType="String"], [name="RelationshipCount", dataType="Int64"], [name="EvidenceSource", dataType="String"]}))
				in
				    Readers[Finish](BusinessRows)
