	/// Explains qualification of AD activity for section 07 using the same imported license snapshot and its source receipt.
	measure 'License Report AD Activity Qualification' =
			VAR _ready = CALCULATE(SELECTEDVALUE('License Report Sources'[Ready]), REMOVEFILTERS('License Report Sources'), 'License Report Sources'[Name] = "AD_Users_AllDomains.csv")
			VAR _reason = CALCULATE(SELECTEDVALUE('License Report Sources'[Reason]), REMOVEFILTERS('License Report Sources'), 'License Report Sources'[Name] = "AD_Users_AllDomains.csv")
			VAR _provisional = CALCULATE(SELECTEDVALUE('License Report Sources'[Provisional]), REMOVEFILTERS('License Report Sources'), 'License Report Sources'[Name] = "AD_Users_AllDomains.csv")
			VAR _members = [License Report Gap AdGapActivity Members]
			RETURN SWITCH(TRUE(),
			    [License Report Snapshot Consistent] <> 1, "Unknown - license snapshot mismatch",
			    ISBLANK(_members) && _ready <> "True", "Unknown - AD source not qualified" & IF(NOT ISBLANK(_reason), ": " & _reason, ""),
			    ISBLANK(_members), "Unknown - section 07 AD activity evidence unavailable",
			    _provisional = "True", "Provisional - AD source requires review",
			    "Qualified - AD activity evidence available")
		displayFolder: Licensing | Mail parity | Display
		lineageTag: db991674-c147-4f29-bc51-9dae5c8775db

	/// Displays a single section/metric evidence value without aggregating distinct indicators; blanks remain Unknown.
	measure 'License Report Gap Value Label' =
			VAR _value = SELECTEDVALUE('License Report Gaps'[Value])
			RETURN IF([License Report Snapshot Consistent] <> 1 || ISBLANK(_value), "Unknown", FORMAT(_value, "#,0"))
		displayFolder: Licensing | Mail parity | Display
		lineageTag: 5d258296-46ee-41ba-a5f4-15c7b1de6120

	/// English presentation of existing evidence qualification. The original CSV evidence status remains unchanged.
	measure 'License Report Gap Evidence Label' =
			VAR _status = SELECTEDVALUE('License Report Gaps'[Evidence Status])
			RETURN IF([License Report Snapshot Consistent] <> 1 || ISBLANK(_status) || _status = "N/D", "Unknown", _status)
		displayFolder: Licensing | Mail parity | Display
		lineageTag: 44fa32e5-ce88-482d-aaf8-1cf9f4f7ef15

