/// Mailbox and AD gap counts from the daily SmartInventory email; missing evidence remains blank.
table 'License Report Gaps'
	lineageTag: 897d635b-1235-42f6-ab04-e21f019a4ddb

	measure 'License Report User Mailboxes Without Suite' = IF([License Report Snapshot Consistent] = 1, CALCULATE(SUM('License Report Gaps'[Value]), 'License Report Gaps'[Section] = "UserMailboxes", 'License Report Gaps'[Metric] = "Total"))
		formatString: #,0
