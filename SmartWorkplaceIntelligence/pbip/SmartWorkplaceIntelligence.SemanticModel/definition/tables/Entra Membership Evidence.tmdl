/// Native source facet migrated from EntraGroupMembership; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Entra Membership Evidence'
	lineageTag: eafd43ab-b38c-4c61-a93b-8b9d67c33a2e

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Entra Membership Evidence' =
			VAR InventoryUsers = CALCULATETABLE(VALUES('Native User Evidence'[TenantUserKey]), REMOVEFILTERS('Native User Evidence'), TREATAS(VALUES('User Inventory Evidence'[User Source ID]), 'Native User Evidence'[SourceUserId]))
			VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('User Inventory Evidence'), CALCULATE((COUNTROWS('Entra Membership Evidence')), KEEPFILTERS(TREATAS(InventoryUsers, 'Entra Membership Evidence'[TenantUserKey]))),
			ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((COUNTROWS('Entra Membership Evidence')), KEEPFILTERS(TREATAS(InventoryDevices, 'Entra Membership Evidence'[TenantDeviceKey]))), (COUNTROWS('Entra Membership Evidence')))
		formatString: #,0
		isHidden
		lineageTag: f5a847fc-545a-4af1-8033-5a9eb5d128b3

