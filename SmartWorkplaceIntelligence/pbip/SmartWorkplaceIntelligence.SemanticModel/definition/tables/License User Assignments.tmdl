		sourceColumn: Loaded Batch ID

	column 'Country Name' =
			VAR _country = 'License User Assignments'[Country]
			RETURN COALESCE(LOOKUPVALUE('Country Selection'[Country],'Country Selection'[Source Country],_country),IF(ISBLANK(_country)||LEN(TRIM(_country))=2,"Unknown",_country))
		dataType: string
		lineageTag: c4b49a25-5447-4d23-b6fa-8dfa49ae3f14
		dataCategory: Country
		summarizeBy: none

	column 'M365 Scope' = IF(LEFT('License User Assignments'[License Product],14)="Microsoft 365 ","Yes","No")
		dataType: string
		isHidden
		lineageTag: 55a6622a-6ebb-4782-9e81-423224e13c3d
		summarizeBy: none

	partition 'License User Assignments' = m
		mode: import
		source =
				let
				    L = #"Native User License",
				    U = #"Native User Evidence",
				    S = Table.RenameColumns(#"License SKU Capacity", {{"TenantKey","Tenant Key"},{"SkuId","SKU ID"},{"ReportProduct","Report Product"}}),
				    A = #"AD User Evidence",
				    Qualify=(t as table,keys as list,fields as list) as table=>let
				        thin=Table.Buffer(Table.SelectColumns(t,keys&fields,MissingField.Ignore)),
				        g=Table.Group(thin,keys,{{"Count",each Table.RowCount(_),Int64.Type},{"First",each let n=Table.RowCount(_) in if n=1 then Record.SelectFields(Table.First(_),fields,MissingField.UseNull) else Record.FromList(List.Repeat({null},List.Count(fields)),fields),type record}})
				        in Table.Buffer(Table.ExpandRecordColumn(g,"First",fields,fields)),
				    JoinFlat=(left as table,leftKeys as list,right as table,rightKeys as list,prefix as text) as table=>let
				        columns=Table.ColumnNames(right),renamed=Table.RenameColumns(right,List.Transform(columns,each {_,prefix&_}))
				        in Table.Join(left,leftKeys,renamed,List.Transform(rightKeys,each prefix&_),JoinKind.LeftOuter),
				    UThin=Qualify(U,{"TenantKey","TenantUserKey","Loaded Batch ID"},{"SourceUserId","UserPrincipalName","CountryCode"}),
				    SThin=Qualify(S,{"Tenant Key","SKU ID","Loaded Batch ID"},{"License Product","Report Product"}),
				    AThin=Qualify(Table.SelectRows(A,each [CloudMatchStatus]="Unique native SID"),{"TenantKey","TenantUserKey","Loaded Batch ID"},{"DomainName"}),
				    Batches = List.Distinct(List.Combine(List.Transform({L,U,S,A}, each Table.Column(_,"Loaded Batch ID")))),
				    Safe = List.Count(Batches)=1 and Batches{0}<>null and Text.Trim(Batches{0})<>"",
				    Assignments = Table.Buffer(Table.Distinct(Table.SelectColumns(L,{"TenantKey","TenantUserKey","TenantSkuKey","SkuId","Loaded Batch ID"}))),
				    Users = JoinFlat(Assignments,{"TenantKey","TenantUserKey","Loaded Batch ID"},UThin,{"TenantKey","TenantUserKey","Loaded Batch ID"},"U."),
				    Skus = JoinFlat(Users,{"TenantKey","SkuId","Loaded Batch ID"},SThin,{"Tenant Key","SKU ID","Loaded Batch ID"},"S."),
				    ReferencedSkus=Table.Distinct(Table.SelectColumns(Assignments,{"TenantKey","SkuId","Loaded Batch ID"})),
				    AmbiguousSkus=Table.SelectRows(SThin,each [Count]>1),
				    UsedAmbiguousSkus=Table.Join(ReferencedSkus,{"TenantKey","SkuId","Loaded Batch ID"},Table.RenameColumns(AmbiguousSkus,{{"Loaded Batch ID","__skuBatch"}}),{"Tenant Key","SKU ID","__skuBatch"},JoinKind.Inner),
				    SkuSafe=Table.IsEmpty(UsedAmbiguousSkus),
				    Directory = Table.Buffer(JoinFlat(Skus,{"TenantKey","TenantUserKey","Loaded Batch ID"},AThin,{"TenantKey","TenantUserKey","Loaded Batch ID"},"A.")),
				    Records = List.Transform(Table.ToRecords(Directory),each let
				        row=_,user=if row[#"U.Count"]=1 then [SourceUserId=row[#"U.SourceUserId"],UserPrincipalName=row[#"U.UserPrincipalName"],CountryCode=row[#"U.CountryCode"]] else [],
				        sku=if row[#"S.Count"]=1 then [#"License Product"=row[#"S.License Product"],#"Report Product"=row[#"S.Report Product"]] else if row[#"S.Count"]<>null and row[#"S.Count"]>1 then error "Ambiguous license SKU identity" else [],
				        key=(parts as list) as text=>Text.Combine(List.Transform(parts,each Text.From(Text.Length(_)) & ":" & _),"|"),
				        country=Record.FieldOrDefault(user,"CountryCode",null),
				        domain=if Record.FieldCount(user)>0 and row[#"A.Count"]=1 then row[#"A.DomainName"] else null
				    in [TenantKey=row[TenantKey],#"User Key"=key({row[TenantKey],row[TenantUserKey]}),
				        #"Assignment Key"=key({row[TenantKey],row[TenantUserKey],row[TenantSkuKey]}),
				        #"User ID"=Record.FieldOrDefault(user,"SourceUserId",null),
				        #"User Principal Name"=Record.FieldOrDefault(user,"UserPrincipalName",null),
				        #"SKU ID"=row[SkuId],#"License Product"=Record.FieldOrDefault(sku,"License Product","Unknown SKU"),
				        #"Report Product"=Record.FieldOrDefault(sku,"Report Product",null),
				        Country=if country=null or Text.Trim(country)="" then "Unknown" else country,
				        #"AD Domain"=domain,#"Identity Qualification"=if Record.FieldCount(user)=0 then "Unresolved native user" else if row[#"A.Count"]=1 then "Unique native SID" else "AD domain unavailable",
				        #"Loaded Batch ID"=row[#"Loaded Batch ID"]]),
				    Output = if not Safe then error "License scope inputs require one common loaded batch" else if not SkuSafe then error "Ambiguous license SKU identity" else Table.FromRecords(Records,type table [TenantKey=text,#"User Key"=text,#"Assignment Key"=text,#"User ID"=nullable text,#"User Principal Name"=nullable text,#"SKU ID"=text,#"License Product"=text,#"Report Product"=nullable text,Country=text,#"AD Domain"=nullable text,#"Identity Qualification"=text,#"Loaded Batch ID"=text])
				in Output
