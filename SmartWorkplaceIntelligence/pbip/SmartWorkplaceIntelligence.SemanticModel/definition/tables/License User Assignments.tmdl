/// One observed native user x SKU assignment within one tenant and prepared batch. Country and AD domain are attributed only from exact native identity. No tenant capacity allocation.
table 'License User Assignments'
	lineageTag: 46b049ab-8e1c-465c-827e-c2cfba5bce89

	measure 'Selected License Assignments' =
			VAR _skus = VALUES('License SKU Capacity'[SKU ID])
			VAR _products = VALUES('License Report Summary'[Product])
			RETURN COALESCE(CALCULATE(DISTINCTCOUNT('License User Assignments'[Assignment Key]), KEEPFILTERS(TREATAS(_skus,'License User Assignments'[SKU ID])), KEEPFILTERS(TREATAS(_products,'License User Assignments'[Report Product]))),0)
		formatString: #,0
		lineageTag: d0b60972-509c-4048-93ec-e0dbcf29b42f

	measure 'Selected Licensed Users' =
			VAR _skus = VALUES('License SKU Capacity'[SKU ID])
			VAR _products = VALUES('License Report Summary'[Product])
			RETURN COALESCE(CALCULATE(DISTINCTCOUNT('License User Assignments'[User Key]), KEEPFILTERS(TREATAS(_skus,'License User Assignments'[SKU ID])), KEEPFILTERS(TREATAS(_products,'License User Assignments'[Report Product]))),0)
		formatString: #,0
		lineageTag: 6725b781-818c-4b41-8bb9-edd159f71714

	measure 'License Geographic Scope Active' = IF(ISFILTERED('Country Selection') || ISFILTERED('Daily Domain'),1,0)
		formatString: 0
		lineageTag: 45eebe11-9182-40ba-87fb-2c7221ae3117

	measure 'License Scope Explanation' = IF([License Geographic Scope Active]=1, "Country / AD Domain filter observed user assignments and candidates. Enabled / Available / assignment rate remain tenant-wide; no purchased capacity allocation by geography.", "All countries and AD domains. Observed user assignments; enabled / available units and capacity rates are tenant-wide.")
		lineageTag: 6b42fa1b-44c8-43a3-836f-483cf14d20ab

	measure 'Selected Assignment Count Label' = IF([License Report Snapshot Consistent]<>1,"Unavailable",IF([License Report Inventory Selection Included]<>1,"Not selected",IF([License Geographic Scope Active]=1,FORMAT([Selected License Assignments],"#,0") & " assigned",[License Overview Family Assignment Rate Label])))
		lineageTag: 30db7eca-52ed-41f9-bef1-03aeb57ec63d

	measure 'Selected Family Assigned Units' = IF([License Report Snapshot Consistent]=1 && [License Report Inventory Selection Included]=1,IF([License Geographic Scope Active]=1,[Selected License Assignments],[License Report Consumed Units]))
		formatString: #,0
		lineageTag: 61bfe990-167d-4766-ba4e-95c534b89d56

	measure 'Selected Recovery Candidates Label' =
			VAR _products = FILTER(ALL('License Report Summary'[Product]),CALCULATE([License Report Inventory Selection Included])=1)
			VAR _rows = CALCULATE(COUNTROWS('License Report Candidates'),KEEPFILTERS(TREATAS(_products,'License Report Candidates'[Product])),KEEPFILTERS('License Report Candidates'[Candidate Type]="Recovery"))
			RETURN IF([License Report Snapshot Consistent]<>1,"Unknown",FORMAT(COALESCE(_rows,0),"#,0"))
		lineageTag: 714df8e3-e396-4607-9db2-df033fc6b90f

	measure 'Selected E3 Review Candidates Label' =
			VAR _rows = CALCULATE(COUNTROWS('License Report Candidates'),KEEPFILTERS('License Report Candidates'[Candidate Type]="E3 to F3 review"),KEEPFILTERS('License Report Candidates'[Product]="Microsoft 365 E3"))
			RETURN IF([License Report Snapshot Consistent]<>1,"Unknown",FORMAT(COALESCE(_rows,0),"#,0"))
		lineageTag: 72c5d340-39ab-4502-b610-011a6372b303

	measure 'Scoped Country M365 Assignments' =
			VAR _skus=VALUES('License SKU Capacity'[SKU ID])
			RETURN COALESCE(CALCULATE(DISTINCTCOUNT('License User Assignments'[Assignment Key]),KEEPFILTERS(TREATAS(_skus,'License User Assignments'[SKU ID])),KEEPFILTERS(FILTER(VALUES('License User Assignments'[License Product]),LEFT('License User Assignments'[License Product],14)="Microsoft 365 "))),0)
		formatString: #,0
		lineageTag: 90bd4d4f-bd68-485a-a69f-56de9f0142ba

	measure 'Scoped Country M365 Licensed Users' =
			VAR _skus=VALUES('License SKU Capacity'[SKU ID])
			RETURN COALESCE(CALCULATE(DISTINCTCOUNT('License User Assignments'[User Key]),KEEPFILTERS(TREATAS(_skus,'License User Assignments'[SKU ID])),KEEPFILTERS(FILTER(VALUES('License User Assignments'[License Product]),LEFT('License User Assignments'[License Product],14)="Microsoft 365 "))),0)
		formatString: #,0
		lineageTag: 747a56d9-6fff-471e-96b7-160b270a4eb7

	column TenantKey
		dataType: string
		isHidden
		lineageTag: 8d3fe413-e36f-4ecb-ade3-c0e2205b0ef0
