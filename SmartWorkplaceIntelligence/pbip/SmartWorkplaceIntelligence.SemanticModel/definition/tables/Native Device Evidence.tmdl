	/// Executive device grouping inferred from OperatingSystem: Windows is PC; Android and iOS families are Mobile; all other or missing values are Unclassified.
	column 'Device form factor' =
			VAR _os = COALESCE ( 'Native Device Evidence'[OperatingSystem], "" )
			RETURN
			    SWITCH (
			        TRUE (),
			        _os = "Windows", "PC",
			        _os IN { "Android", "AndroidEnterprise", "AndroidForWork", "iOS" }, "Mobile",
			        "Unclassified"
			    )
		dataType: string
		lineageTag: 01525336-ad97-465d-b92b-be157d4817fe
		summarizeBy: none

	/// Windows adoption grouping inferred from OperatingSystemVersion. Build 22000 or later is Windows 11; older recognized Windows builds are Other Windows; missing or unparseable versions remain Unknown version. Non-Windows rows are blank.
	column 'Windows version group' =
			VAR _os = COALESCE ( 'Native Device Evidence'[OperatingSystem], "" )
			VAR _version = COALESCE ( 'Native Device Evidence'[OperatingSystemVersion], "" )
			VAR _isNumericVersion = LEFT ( _version, 5 ) = "10.0."
			VAR _build =
			    IF (
			        _isNumericVersion,
			        IFERROR (
			            VALUE ( PATHITEM ( SUBSTITUTE ( _version, ".", "|" ), 3, INTEGER ) ),
			            BLANK ()
			        )
			    )
			RETURN
			    SWITCH (
			        TRUE (),
			        _os <> "Windows", BLANK (),
			        _version = "Windows 11" || _build >= 22000, "Windows 11",
			        _version = "Windows 10" || _build > 0, "Other Windows",
			        "Unknown version"
			    )
		dataType: string
		lineageTag: 63bf5416-a28b-4708-80c2-e58282cc7fd7
		summarizeBy: none

	/// Executive ownership grouping: Corporate and Personal remain distinct; missing, Not provided, and Unknown values are retained as Unknown / missing.
	column 'Device ownership group' =
			VAR _ownership = COALESCE ( 'Native Device Evidence'[Ownership], "" )
			RETURN
			    SWITCH (
			        TRUE (),
			        _ownership = "Corporate", "Corporate",
			        _ownership = "Personal", "Personal",
			        "Unknown / missing"
			    )
		dataType: string
		lineageTag: cfc4ed29-6954-4e85-8547-8db90f204758
		summarizeBy: none

