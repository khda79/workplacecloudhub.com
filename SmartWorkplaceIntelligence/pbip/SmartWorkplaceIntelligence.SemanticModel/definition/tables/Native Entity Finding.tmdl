	partition 'Native Entity Finding' = m
		mode: import
		source = NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("EntityFinding.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantFindingKey", dataType="String"], [name="TenantUserKey", dataType="String"], [name="TenantDeviceKey", dataType="String"], [name="TenantGroupKey", dataType="String"], [name="EntityType", dataType="String"], [name="EntityId", dataType="String"], [name="Severity", dataType="String"], [name="FindingType", dataType="String"], [name="Description", dataType="String"], [name="RecommendedAction", dataType="String"], [name="DetectedDateTime", dataType="DateTime"], [name="LinkStatus", dataType="String"]})

