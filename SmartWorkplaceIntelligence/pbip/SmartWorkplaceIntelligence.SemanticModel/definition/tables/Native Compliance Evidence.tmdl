/// Native source facet migrated from FactDeviceCompliance; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native Compliance Evidence'
	lineageTag: 7e9adcd3-61ec-4376-af82-a8dcab53eb30

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Native Compliance Evidence' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((COUNTROWS('Native Compliance Evidence')), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Compliance Evidence'[TenantDeviceKey]))), (COUNTROWS('Native Compliance Evidence')))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		isHidden
		lineageTag: b571d1d1-8ba2-4416-922c-f426bbcb25ce

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: a37735e9-ce6b-414e-b438-0f0de0894957
		summarizeBy: none
		sourceColumn: TenantKey

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column OrganizationKey
		dataType: string
		isHidden
		lineageTag: 008755c9-29a5-48e3-bb75-cbde9c891c48
		summarizeBy: none
		sourceColumn: OrganizationKey

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column EnvironmentKey
		dataType: string
		isHidden
		lineageTag: c9b924d1-045f-43fc-b9b6-30a8789060e0
		summarizeBy: none
		sourceColumn: EnvironmentKey

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column TenantId
		dataType: string
		isHidden
		lineageTag: 28467a15-c07d-44cc-aae1-3d1c3c77f930
		summarizeBy: none
		sourceColumn: TenantId

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column TenantDeviceKey
		dataType: string
		isHidden
		lineageTag: a78514f8-e321-49fb-91de-d36d0fcae7b6
		summarizeBy: none
		sourceColumn: TenantDeviceKey

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column CmdbDeviceId
		dataType: string
		isHidden
		lineageTag: 26e358c9-71d8-48f7-8de8-2ae145836e70
		summarizeBy: none
		sourceColumn: CmdbDeviceId

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column ComplianceState
		dataType: string
		lineageTag: a6b3881a-aced-43d5-884b-d7a7af0ab1b4
		summarizeBy: none
		sourceColumn: ComplianceState

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column LastSyncDateTime
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm:ss
		lineageTag: ecee828b-de11-43ba-af46-381d4e7df60b
		summarizeBy: none
		sourceColumn: LastSyncDateTime

	/// Native FactDeviceCompliance attribute; source qualification is retained.
	column SourceSystem
		dataType: string
		lineageTag: 9f2f22bb-3263-4606-847e-5472da86b297
		summarizeBy: none
		sourceColumn: SourceSystem

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 05595f49-0294-4ebd-81f7-da262a8551ec
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'Native Compliance Evidence' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("FactDeviceCompliance.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantDeviceKey", dataType="String"], [name="CmdbDeviceId", dataType="String"], [name="ComplianceState", dataType="String"], [name="LastSyncDateTime", dataType="DateTime"], [name="SourceSystem", dataType="String"]}))
				in
				    Readers[Finish](BusinessRows)
