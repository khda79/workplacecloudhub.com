		sourceColumn: Coverage State

		annotation SummarizationSetBy = Automatic

	column 'Covered Entities'
		dataType: int64
		formatString: #,0
		lineageTag: 48f38c30-2e87-4f89-83a0-f5ed3f5d254c
		summarizeBy: sum
		sourceColumn: Covered Entities

	column 'Healthy Entities'
		dataType: int64
		formatString: #,0
		lineageTag: ad21b5ab-4751-4175-9c9b-27d005a363b1
		summarizeBy: sum
		sourceColumn: Healthy Entities

	column 'Affected Entities'
		dataType: int64
		formatString: #,0
		lineageTag: 49685a63-28e1-432d-9b43-bfb1872fac2b
		summarizeBy: sum
		sourceColumn: Affected Entities

	column 'Health Rate'
		dataType: double
		formatString: 0.0%
		lineageTag: 7caf2dcd-62e0-4644-beb7-95d0e76b380e
		summarizeBy: sum
		sourceColumn: Health Rate

		annotation SummarizationSetBy = Automatic

	column 'Gap State'
		dataType: string
		lineageTag: e4096298-3a66-4503-96db-27c1915b4d24
