		variation Variation
			isDefault
			relationship: 81e59377-f0f1-4fa5-b2bf-d01399d45ce5
			defaultHierarchy: LocalDateTable_7351d1a0-1eb4-4aea-9827-af128eb26629.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	/// Unit used by the control counts (Devices, Users, Policies, Checks, Connectors, or Score). Do not sum affected values across different units.
	column 'Metric Unit'
		dataType: string
		lineageTag: 5ecfeffa-e91d-47ee-aa38-ae4b7619e333
		summarizeBy: none
		sourceColumn: Metric Unit

	partition 'Security Control Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("SecurityControlEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Control Sort", "Security Domain", "Control Name", "Severity Label", "Evidence Status", "Coverage State", "Covered Entities", "Healthy Entities", "Affected Entities", "Health Rate", "Gap State", "Evidence Source", "Recommended Action", "Snapshot Date", "Metric Unit"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Control Sort", "Covered Entities", "Healthy Entities", "Affected Entities", "Health Rate", "Snapshot Date"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Control Sort", Int64.Type}, {"Security Domain", type text}, {"Control Name", type text}, {"Severity Label", type text}, {"Evidence Status", type text}, {"Coverage State", type text}, {"Covered Entities", Int64.Type}, {"Healthy Entities", Int64.Type}, {"Affected Entities", Int64.Type}, {"Health Rate", type number}, {"Gap State", type text}, {"Evidence Source", type text}, {"Recommended Action", type text}, {"Snapshot Date", type datetime}, {"Metric Unit", type text}}, "en-US")
				in
				    Typed

