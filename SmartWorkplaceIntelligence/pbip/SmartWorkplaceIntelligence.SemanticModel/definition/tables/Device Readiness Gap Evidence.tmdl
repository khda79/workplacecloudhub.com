	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Third KPI Caption' = IF(SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")="Daily operations","No reboot >= 30 days | all rows","RAM < 8 GB excluding Already upgraded | AD GUID")
