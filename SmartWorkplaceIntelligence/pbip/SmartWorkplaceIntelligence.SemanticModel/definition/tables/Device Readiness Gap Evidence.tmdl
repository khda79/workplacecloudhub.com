	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Device Unit Text' = IF(SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")="Daily operations","Daily operations | all device rows | no Windows 10 or eligibility filter","Windows 11 migration | reference counts use distinct AD GUID")
		formatString: @
		displayFolder: Remediation Backlog
