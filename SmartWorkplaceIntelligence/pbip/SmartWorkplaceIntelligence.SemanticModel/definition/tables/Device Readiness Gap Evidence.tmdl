			RETURN IF(CONTAINSSTRING(_basis,"+/-1"),"Prepared reboot age; +/-1 day according to source basis","Prepared reboot age; do not recalculate")
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 57cf9d87-91f5-5d65-9e46-2b9d281242fa

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Device Coverage Text' =
			IF(NOT(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Device Readiness Gap Evidence",'Readiness Source Status'[Source Available]=TRUE())=1),"Device evidence unavailable",
			FORMAT([Backlog Device Unattributable Rows],"#,##0")&" rows not attributable to active scope - select Unassigned evidence. AD computer only: missing RAM/reboot/firmware telemetry remains Indeterminate; Entra uses its own evidence. Unknown/Error are Indeterminate in Daily operations.")
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 398beabf-10c8-5d3b-b817-634715b6205c

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Reboot Overlap Text' =
			VAR _daily=SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")="Daily operations"
			RETURN IF(_daily,"Daily >=30 days is included in >=10 days. Never add thresholds or firmware conditions.","Migration >=10 and >=30 days overlap but their applicability differs. Never add conditions.")
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 5b8799be-d8c3-553a-95de-1014932d9beb

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog PC Condition Count' =
			VAR _devices=SELECTCOLUMNS('Device Exploration Inventory',
			"__ID",LOWER(TRIM('Device Exploration Inventory'[Device Source ID])),
			"__I",LOWER(TRIM('Device Exploration Inventory'[Inventory Key])),
			"__T",'Device Exploration Inventory'[TenantKey]&"",
			"__B",'Device Exploration Inventory'[Loaded Batch ID]&"")
			VAR _ad=SELECTCOLUMNS(ALL('AD Computer Evidence'),
			"__N",LOWER(TRIM('AD Computer Evidence'[TenantADComputerKey])),
			"__G",LOWER(TRIM('AD Computer Evidence'[ObjectGUID])),
			"__T",'AD Computer Evidence'[TenantKey]&"",
			"__B",'AD Computer Evidence'[Loaded Batch ID]&"")
			VAR _unique=FILTER(GROUPBY(_ad,[__N],[__T],[__B],
			"__Count",COUNTX(CURRENTGROUP(),1),"__G",MAXX(CURRENTGROUP(),[__G])),[__Count]=1 && LEN([__N])>0)
			VAR _adDevices=SELECTCOLUMNS(FILTER(_devices,LEN([__ID])=0 && LEFT([__I],3)="ad:"),
			"__N",MID([__I],4,500),"__T",[__T],"__B",[__B])
			VAR _keys=UNION(
			SELECTCOLUMNS(FILTER(_devices,LEN([__ID])>0),"K","intune:"&[__ID],"T",[__T],"B",[__B]),
			SELECTCOLUMNS(NATURALINNERJOIN(_adDevices,_unique),"K","ad:"&[__G],"T",[__T],"B",[__B]))
			RETURN IF(COUNTROWS(_keys)=0,BLANK(),CALCULATE([Backlog Condition Count],KEEPFILTERS(TREATAS(_keys,'Device Readiness Gap Evidence'[Backlog Device Key],'Device Readiness Gap Evidence'[TenantKey],'Device Readiness Gap Evidence'[Loaded Batch ID])),REMOVEFILTERS('Readiness Reading'),TREATAS({"Daily operations" },'Readiness Reading'[Reading])))
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: c060776d-a167-5345-bf46-783d96aadb33

