	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Device RAM Note' =
			VAR _daily=SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")="Daily operations"
			VAR _up=IF(_daily,[Backlog Daily RAM Already upgraded],[Backlog Migration RAM Already upgraded])
			VAR _na=IF(_daily,[Backlog Daily RAM Not assessed],[Backlog Migration RAM Not assessed])
			RETURN FORMAT(_up,"#,##0")&" Already upgraded included | "&FORMAT(_na,"#,##0")&" Not assessed | eligibility is contextual; missing evidence remains visible"
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 1c42174e-936a-5132-9fa0-08f7b9e289d5

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Device Condition State' =
			VAR _code=SELECTEDVALUE('Readiness Condition'[Condition Code],"018")
			RETURN IF(SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")="Daily operations",SWITCH(_code,"032",SELECTEDVALUE('Device Readiness Gap Evidence'[Daily 032 State]),
			"018",SELECTEDVALUE('Device Readiness Gap Evidence'[Daily 018 State]),
			"054",SELECTEDVALUE('Device Readiness Gap Evidence'[Daily 054 State]),
			"055",SELECTEDVALUE('Device Readiness Gap Evidence'[Daily 055 State]),
			"Firmware",SELECTEDVALUE('Device Readiness Gap Evidence'[Daily Firmware State]),
			"Disabled",SELECTEDVALUE('Device Readiness Gap Evidence'[Daily Disabled State]),BLANK()),SWITCH(_code,"032",SELECTEDVALUE('Device Readiness Gap Evidence'[ISSUE-032 State]),
			"018",SELECTEDVALUE('Device Readiness Gap Evidence'[ISSUE-018 State]),
			"054",SELECTEDVALUE('Device Readiness Gap Evidence'[ISSUE-054 State]),
			"055",SELECTEDVALUE('Device Readiness Gap Evidence'[ISSUE-055 State]),
			"Firmware",SELECTEDVALUE('Device Readiness Gap Evidence'[Migration Firmware State]),BLANK()))
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 7bdb5f48-8a32-5b49-b202-0ed7c531ca5f

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Condition Count' =
			VAR _reading=SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")
			VAR _code=SELECTEDVALUE('Readiness Condition'[Condition Code])
			VAR _state=SELECTEDVALUE('Readiness Matrix Metric'[State])
			RETURN IF(ISBLANK(_code)||ISBLANK(_state)||(_reading="Windows 11 migration"&&_code="Disabled")||(_reading="Daily operations"&&_state="Not applicable"),BLANK(),
			(VAR _pf=ISFILTERED('Primary User Selection')
			VAR _users=VALUES('Primary User Selection'[Primary user])
			VAR _pk=FILTER(VALUES('Device Readiness Gap Evidence'[Backlog Primary user]),NOT _pf || 'Device Readiness Gap Evidence'[Backlog Primary user] IN _users)
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _countries=VALUES('Country Selection'[Source Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _ck=FILTER(VALUES('Device Readiness Gap Evidence'[Backlog Country]),NOT _cf || 'Device Readiness Gap Evidence'[Backlog Country] IN _countries)
			VAR _dk=FILTER(VALUES('Device Readiness Gap Evidence'[Backlog AD Domain]),NOT _df || 'Device Readiness Gap Evidence'[Backlog AD Domain] IN _domains)
			VAR _missing=FILTER('Device Readiness Gap Evidence',(_cf && (ISBLANK('Device Readiness Gap Evidence'[Backlog Country]) || 'Device Readiness Gap Evidence'[Backlog Country]="Unknown")) || (_df && (ISBLANK('Device Readiness Gap Evidence'[Backlog AD Domain]) || 'Device Readiness Gap Evidence'[Backlog AD Domain]="Unknown")) || (_pf && (ISBLANK('Device Readiness Gap Evidence'[Backlog Primary user]) || 'Device Readiness Gap Evidence'[Backlog Primary user]="Not resolved")))
			RETURN IF(SELECTEDVALUE('Backlog Attribution Selection'[Mode],"In scope")="Unassigned evidence",CALCULATE((IF(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Device Readiness Gap Evidence",'Readiness Source Status'[Source Available]=TRUE())=1,COALESCE((VAR _reading=SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")
			VAR _code=SELECTEDVALUE('Readiness Condition'[Condition Code])
			VAR _state=SELECTEDVALUE('Readiness Matrix Metric'[State])
			VAR _grain=SELECTEDVALUE('Readiness Matrix Metric'[Grain])
			VAR _rows=FILTER('Device Readiness Gap Evidence',[Backlog Device Condition State]=_state)
			RETURN IF(ISBLANK(_code)||ISBLANK(_state)||(_reading="Windows 11 migration" && _code="Disabled")||(_reading="Daily operations" && _state="Not applicable"),BLANK(),
			IF(_grain="AD GUID",CALCULATE(DISTINCTCOUNT('Device Readiness Gap Evidence'[AD Object GUID]),KEEPFILTERS(_rows),KEEPFILTERS('Device Readiness Gap Evidence'[AD Object GUID]<>BLANK())),COUNTROWS(_rows)))),0),BLANK())),KEEPFILTERS(_missing)),CALCULATE((IF(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Device Readiness Gap Evidence",'Readiness Source Status'[Source Available]=TRUE())=1,COALESCE((VAR _reading=SELECTEDVALUE('Readiness Reading'[Reading],"Daily operations")
			VAR _code=SELECTEDVALUE('Readiness Condition'[Condition Code])
			VAR _state=SELECTEDVALUE('Readiness Matrix Metric'[State])
			VAR _grain=SELECTEDVALUE('Readiness Matrix Metric'[Grain])
			VAR _rows=FILTER('Device Readiness Gap Evidence',[Backlog Device Condition State]=_state)
			RETURN IF(ISBLANK(_code)||ISBLANK(_state)||(_reading="Windows 11 migration" && _code="Disabled")||(_reading="Daily operations" && _state="Not applicable"),BLANK(),
			IF(_grain="AD GUID",CALCULATE(DISTINCTCOUNT('Device Readiness Gap Evidence'[AD Object GUID]),KEEPFILTERS(_rows),KEEPFILTERS('Device Readiness Gap Evidence'[AD Object GUID]<>BLANK())),COUNTROWS(_rows)))),0),BLANK())),KEEPFILTERS(TREATAS(_ck,'Device Readiness Gap Evidence'[Backlog Country])),KEEPFILTERS(TREATAS(_dk,'Device Readiness Gap Evidence'[Backlog AD Domain])),KEEPFILTERS(TREATAS(_pk,'Device Readiness Gap Evidence'[Backlog Primary user]))))))
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: 6a8b0d4f-3a43-5829-a253-863d6106c68b

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Device Row In Scope' =
			VAR _selectedState=SELECTEDVALUE('Readiness Matrix Metric'[State],"Triggered")
			VAR _actual=[Backlog Device Condition State]
			RETURN IF([Backlog Device Scope Row]=1 && _actual=_selectedState,1,0)
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: ae98308f-10fb-52c6-a142-bc8ef5b9f63b

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Device Action' =
			VAR _s=[Backlog Device Condition State]
			VAR _c=SELECTEDVALUE('Readiness Condition'[Condition Code],"018")
			RETURN SWITCH(TRUE(),_s="Indeterminate","Qualify missing or unusable evidence",_s="Not applicable","Review applicability conditions",_s="Not triggered","No condition observed",
			SWITCH(_c,"032","Review Entra registration","018","Review RAM capacity and operational needs","054","Plan restart according to operational context","055","Plan restart according to operational context","Firmware","Review firmware and Secure Boot support","Disabled","Review disabled Secure Boot; no automatic change","Review evidence"))
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 643d090c-b4be-50f8-889e-fc3c8ad6040b

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Reboot Basis Note' =
