	/// Exact native device ID, tenant and batch lookup of existing Primary User (report); never a UPN/name join.
	column 'Backlog Primary user' =
			VAR _id='Device Readiness Gap Evidence'[Device Source ID]
			VAR _t='Device Readiness Gap Evidence'[TenantKey]
			VAR _b='Device Readiness Gap Evidence'[Loaded Batch ID]
			VAR _matches=FILTER(ALL('Device Inventory Evidence'),'Device Inventory Evidence'[Device Source ID]=_id && 'Device Inventory Evidence'[TenantKey]=_t && 'Device Inventory Evidence'[Loaded Batch ID]=_b)
			RETURN IF(NOT ISBLANK(_id) && COUNTROWS(_matches)=1,COALESCE(MAXX(_matches,'Device Inventory Evidence'[Primary User (report)]),"Not resolved"),"Not resolved")
		dataType: string
		lineageTag: 2be7f2f8-7d4c-5366-9aeb-5f872797f39b

	partition 'Device Readiness Gap Evidence' = m
		mode: import
		source =
				let
				 Base=(let
				    R=CreatePreparedReaders(),
				    S=R[GetReadinessSource]("DeviceReadinessGapEvidence.csv"),
				    Key=(v as any) as text => if v=null then "" else Text.Lower(Text.Trim(Text.From(v))),
				    Known=(v as any) as logical => v<>null and Text.Trim(Text.From(v))<>"",
				    Columns={"TenantKey","Device Source ID","Windows 11 Upgrade Eligibility","Windows Generation"},
				    InventoryRaw=if S[Available] then R[ReadMailboxMigrationCsv](R[GetPreparedEvidenceFile]("DeviceInventoryEvidence.csv"),Columns,{}) else #table(Columns,{}),
				    Inventory=if List.AllTrue(List.Transform(InventoryRaw[TenantKey], each _=R[GetPreparedBatchManifest]()[TenantKey])) then InventoryRaw else error "Foreign inventory tenant",
				    Indexed=Table.AddColumn(Inventory,"__join",each Key([TenantKey]) & "|" & Key([Device Source ID]),type text),
				    Nonblank=Table.SelectRows(Indexed,each Key([Device Source ID])<>""),
				    Groups=Table.Group(Nonblank,{"__join"},{{"Matches",each Table.RowCount(_),Int64.Type},{"Rows",each Table.ToRecords(_),type list}}),
				    Lookup=Record.FromList(Table.ToRecords(Groups),Groups[__join]),
				    Enrich=(r as record) as record =>
				      let
				        G=if not Known(r[Device Source ID]) then null else Record.FieldOrDefault(Lookup,Key(r[TenantKey]) & "|" & Key(r[Device Source ID]),null),
				        I=if G<>null and G[Matches]=1 then G[Rows]{0} else null,
				        E=if I=null then null else I[Windows 11 Upgrade Eligibility],
				        W=if I=null then null else I[Windows Generation],
				        M=r[#"Physical Memory (GB)"], D=r[Days Since Last Reboot], F=r[#"Firmware Type (source)"], B=r[#"Secure Boot Status (source)"],
				        State=(required as list,na as logical,trigger as logical) as text => if not List.AllTrue(List.Transform(required,Known)) then "Indeterminate" else if na then "Not applicable" else if trigger then "Triggered" else "Not triggered",
				        NoCap=Key(E)="not capable", NotW10=Key(W)<>"windows 10"
				      in [
				        #"Inventory Match State"=if G=null then "No match" else if G[Matches]<>1 then "Ambiguous" else "Matched",
				        #"Windows 11 Upgrade Eligibility"=E, #"Windows Generation"=W,
				        #"ISSUE-032 State"=State({r[Entra Registration Pending]},false,r[Entra Registration Pending]=true),
				        #"ISSUE-018 State"=State({E,M},NoCap,if M=null then false else M<8),
				        #"ISSUE-054 State"=State({E,W,D},NoCap or NotW10,if D=null then false else D>=10),
				        #"ISSUE-055 State"=State({E,D},NoCap,if D=null then false else D>=30),
				        #"ISSUE-070 State"=State({E,W,F,B},NoCap or NotW10,Key(F)="bios"),
				        #"ISSUE-070B State"=State({E,W,B},NoCap or NotW10,Key(B)="notsupported")
				      ],
				    Added=Table.AddColumn(S[Rows],"__assessment",Enrich,type record),
				    Expanded=Table.ExpandRecordColumn(Added,"__assessment",{"Inventory Match State","Windows 11 Upgrade Eligibility","Windows Generation","ISSUE-032 State","ISSUE-018 State","ISSUE-054 State","ISSUE-055 State","ISSUE-070 State","ISSUE-070B State"})
				in R[Finish](Expanded)),
				 K=CreateBacklogTools(CreatePreparedReaders()),
				 A=K[Index](K[Read]("ADComputerSource.csv",{"TenantKey","ObjectGUID","DomainName"}),"ObjectGUID"),
				 C=K[Index](K[Read]("AllDevicesEvidence.csv",{"TenantKey","Device Key","Country"}),"Device Key"),
				 I=K[Index](K[Read]("DeviceInventoryEvidence.csv",{"TenantKey","Device Source ID","Country"}),"Device Source ID"),
				 DailyAdded=Table.AddColumn(Base,"__daily",each AssessDailyReadiness(_),type record),
				 Daily=Table.ExpandRecordColumn(DailyAdded,"__daily",{"Daily 032 State","Daily 018 State","Daily 054 State","Daily 055 State","Daily BIOS State","Daily NotSupported State","Daily Firmware State","Daily Disabled State"}),
				 Added=Table.AddColumn(Daily,"__context",each
				  let AD=K[Match](A,[TenantKey],[AD Object GUID],[Loaded Batch ID]), Co=K[Match](C,[TenantKey],"ad:"&K[Key]([AD Object GUID]),[Loaded Batch ID]),
				      Inv=K[Match](I,[TenantKey],[Device Source ID],[Loaded Batch ID]), IsAD=[Inventory Scope]="AD computer only"
				  in [#"Backlog Country"=if IsAD then K[Field](Co,"Country") else K[Field](Inv,"Country"),
				      #"Backlog AD Domain"=K[Field](AD,"DomainName"),#"Country Match State"=if IsAD then Co[State] else Inv[State],#"Domain Match State"=AD[State],
				      #"Backlog Device Key"=if K[Key]([Device Source ID])<>"" then "intune:"&K[Key]([Device Source ID]) else if K[Key]([AD Object GUID])<>"" then "ad:"&K[Key]([AD Object GUID]) else "unresolved",
				      #"Migration Firmware State"=K[OrState]([#"ISSUE-070 State"],[#"ISSUE-070B State"])],type record),
				 Expanded=Table.ExpandRecordColumn(Added,"__context",{"Backlog Country","Backlog AD Domain","Country Match State","Domain Match State","Backlog Device Key","Migration Firmware State"})
				in Expanded
