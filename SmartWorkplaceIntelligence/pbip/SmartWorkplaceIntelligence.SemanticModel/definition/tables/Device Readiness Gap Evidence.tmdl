	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog PC Evidence Note' =
			VAR _devices=SELECTCOLUMNS('Device Exploration Inventory',
			"__ID",LOWER(TRIM('Device Exploration Inventory'[Device Source ID])),
			"__I",LOWER(TRIM('Device Exploration Inventory'[Inventory Key])),
			"__T",'Device Exploration Inventory'[TenantKey]&"",
			"__B",'Device Exploration Inventory'[Loaded Batch ID]&"")
			VAR _ad=SELECTCOLUMNS(ALL('AD Computer Evidence'),
			"__N",LOWER(TRIM('AD Computer Evidence'[TenantADComputerKey])),
			"__G",LOWER(TRIM('AD Computer Evidence'[ObjectGUID])),
			"__T",'AD Computer Evidence'[TenantKey]&"",
			"__B",'AD Computer Evidence'[Loaded Batch ID]&"")
			VAR _unique=FILTER(GROUPBY(_ad,[__N],[__T],[__B],
			"__Count",COUNTX(CURRENTGROUP(),1),"__G",MAXX(CURRENTGROUP(),[__G])),[__Count]=1 && LEN([__N])>0)
			VAR _adDevices=SELECTCOLUMNS(FILTER(_devices,LEN([__ID])=0 && LEFT([__I],3)="ad:"),
			"__N",MID([__I],4,500),"__T",[__T],"__B",[__B])
			VAR _keys=UNION(
			SELECTCOLUMNS(FILTER(_devices,LEN([__ID])>0),"K","intune:"&[__ID],"T",[__T],"B",[__B]),
			SELECTCOLUMNS(NATURALINNERJOIN(_adDevices,_unique),"K","ad:"&[__G],"T",[__T],"B",[__B]))
			VAR _matched=CALCULATE(COUNTROWS('Device Readiness Gap Evidence'),TREATAS(_keys,'Device Readiness Gap Evidence'[Backlog Device Key],'Device Readiness Gap Evidence'[TenantKey],'Device Readiness Gap Evidence'[Loaded Batch ID]))
			RETURN IF(NOT(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Device Readiness Gap Evidence",'Readiness Source Status'[Source Available]=TRUE())=1),"Device evidence unavailable",IF(_matched=0,"Native device link unresolved or no readiness evidence; no healthy-state claim","Daily operations | native device context | prepared reboot days"))
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: c0a9f724-843c-5115-9b4d-519428088d02

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Windows Condition Count' =
			VAR _keys=SELECTCOLUMNS('Windows Migration Evidence',"K",'Windows Migration Evidence'[Device Source ID],"B",'Windows Migration Evidence'[Loaded Batch ID])
			RETURN IF(COUNTROWS(_keys)=0,BLANK(),CALCULATE([Backlog Condition Count],KEEPFILTERS(TREATAS(_keys,'Device Readiness Gap Evidence'[Device Source ID],'Device Readiness Gap Evidence'[Loaded Batch ID])),REMOVEFILTERS('Readiness Reading'),TREATAS({"Windows 11 migration" },'Readiness Reading'[Reading])))
		formatString: #,##0
