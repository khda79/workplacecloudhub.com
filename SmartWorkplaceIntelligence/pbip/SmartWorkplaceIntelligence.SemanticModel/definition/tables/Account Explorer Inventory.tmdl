				"AD Created UTC",LOOKUPVALUE('User Inventory Evidence'[AD Created UTC], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Modified (source)",COALESCE(LOOKUPVALUE('User Inventory Evidence'[AD Modified (source)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[ModificationRaw], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
