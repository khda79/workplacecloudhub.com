	measure 'User 360 Local mailbox count' = VAR _AD=[User 360 AD key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_AD),CALCULATE(DISTINCTCOUNT('Exchange Mailbox Reconciliation'[Mailbox GUID]),TREATAS({_AD},'Exchange Mailbox Reconciliation'[AD Account Key]),TREATAS({_B},'Exchange Mailbox Reconciliation'[Loaded Batch ID]),'Exchange Mailbox Reconciliation'[Account Link] IN {"Unique AD GUID + native SID","AD only; cloud unresolved"},'Exchange Mailbox Reconciliation'[Report Has Database]="Yes",'Exchange Mailbox Reconciliation'[Mailbox GUID]<>BLANK()))
		isHidden
		displayFolder: User 360
		lineageTag: 9d45d9e6-6b5e-4904-9af2-ee2ccbc63616

	measure 'User 360 Mailbox hosting' = SWITCH(TRUE(),[User 360 Cloud mailbox count]+[User 360 Local mailbox count]>1,"Multiple linked mailboxes",[User 360 Cloud mailbox count]=1,"Exchange Online",[User 360 Local mailbox count]=1,"On-premises")
		isHidden
		displayFolder: User 360
