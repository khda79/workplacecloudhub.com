				"Entra Created (source)",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Entra Created (source)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[CreationRaw], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
