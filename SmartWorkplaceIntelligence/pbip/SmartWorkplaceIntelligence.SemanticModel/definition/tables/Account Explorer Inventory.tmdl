	measure 'User 360 License headline' =
			VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID])
			RETURN IF(NOT ISBLANK(_U),VAR _Scoped=CALCULATETABLE(VALUES('Native User License'[TenantSkuKey]),TREATAS({_U},'Native User License'[TenantUserKey]),TREATAS({_T},'Native User License'[TenantKey]),TREATAS({_B},'Native User License'[Loaded Batch ID]),'Native User License'[UserLinkStatus]="Resolved",'Native User License'[AssignmentStateLabel]="Active",'Native User License'[TenantSkuKey]<>BLANK())
			VAR _Sku=CALCULATETABLE(VALUES('Native License SKU'[SkuPartNumber]),TREATAS({_T},'Native License SKU'[TenantKey]),TREATAS({_B},'Native License SKU'[Loaded Batch ID]),TREATAS(_Scoped,'Native License SKU'[TenantSkuKey]))
			VAR _Offers=FILTER(DATATABLE("Code",STRING,"Offer",STRING,{{"SPE_E3","Microsoft 365 E3"},{"SPE_E5","Microsoft 365 E5"},{"SPE_F1","Microsoft 365 F3"}}),[Code] IN _Sku)
			RETURN SWITCH(TRUE(),COUNTROWS(_Offers)>0,CONCATENATEX(_Offers,[Offer]," · ",[Offer],ASC),COUNTROWS(_Sku)>0,"Other license observed"))
		isHidden
		displayFolder: User 360
		lineageTag: 237a6c9a-1bf1-49b1-b357-7a357b016fb3

