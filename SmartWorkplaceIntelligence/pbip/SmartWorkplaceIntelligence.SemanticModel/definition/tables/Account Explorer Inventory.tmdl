	measure 'User 360 AD group membership' = VAR _O=[User 360 AD object key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_O)&&CALCULATE(COUNTROWS('AD Membership Evidence'),TREATAS({_O},'AD Membership Evidence'[TenantADObjectKey]),TREATAS({_T},'AD Membership Evidence'[TenantKey]),TREATAS({_B},'AD Membership Evidence'[Loaded Batch ID]),'AD Membership Evidence'[ResolutionStatus]="Resolved",'AD Membership Evidence'[TenantADGroupKey]<>BLANK())>0,"AD")
		displayFolder: User 360
