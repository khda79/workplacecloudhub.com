				"Account Kind",[Account Kind],
				"AD/Entra State Conflict",IF([AD State] IN {"Enabled","Disabled"} && [Entra State] IN {"Enabled","Disabled"} && [AD State]<>[Entra State],"Yes","No"),
				"License Count",VAR _key=[__NativeUserKey] VAR _tenant=[TenantKey] VAR _batch=[Loaded Batch ID] RETURN IF(NOT ISBLANK(_key),COUNTROWS(FILTER('Native User License',[TenantUserKey]=_key && [TenantKey]=_tenant && [Loaded Batch ID]=_batch))),
				"License Products",VAR _key=[__NativeUserKey] VAR _tenant=[TenantKey] VAR _batch=[Loaded Batch ID]
				 VAR _skus=SELECTCOLUMNS(FILTER('Native User License',[TenantUserKey]=_key && [TenantKey]=_tenant && [Loaded Batch ID]=_batch),"K",[TenantSkuKey])
				 RETURN IF(NOT ISBLANK(_key),CONCATENATEX(FILTER('Native License SKU',[TenantKey]=_tenant && [TenantSkuKey] IN _skus),[SkuPartNumberLabel],", ",[SkuPartNumberLabel],ASC))
				)
