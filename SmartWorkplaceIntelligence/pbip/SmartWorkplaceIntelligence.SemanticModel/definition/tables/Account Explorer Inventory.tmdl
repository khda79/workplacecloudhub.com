	measure 'User 360 Device link' = IF([User 360 Device count]>0,"Primary user")
		displayFolder: User 360
		lineageTag: 31b7bca9-4bde-4977-93a4-dfb494feb7de

	measure 'User 360 Entra group membership' = VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_U)&&CALCULATE(COUNTROWS('Entra Membership Evidence'),TREATAS({_U},'Entra Membership Evidence'[TenantUserKey]),TREATAS({_T},'Entra Membership Evidence'[TenantKey]),TREATAS({_B},'Entra Membership Evidence'[Loaded Batch ID]),'Entra Membership Evidence'[LinkStatus]="Resolved",'Entra Membership Evidence'[TenantGroupKey]<>BLANK())>0,"Entra")
		displayFolder: User 360
