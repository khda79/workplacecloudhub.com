	measure 'User 360 Profile artwork' =
			IF(NOT ISBLANK([User 360 Account key]),
			 VAR _Name=COALESCE(SELECTEDVALUE('Account Explorer Inventory'[Display Name]),SELECTEDVALUE('Account Explorer Inventory'[User Principal Name]),"Unknown user")
			 VAR _UPN=COALESCE(SELECTEDVALUE('Account Explorer Inventory'[User Principal Name]),"Not observed")
			 VAR _Country=SELECTEDVALUE('Account Explorer Inventory'[Country Name])
			 VAR _Domain=SELECTEDVALUE('Account Explorer Inventory'[AD Domain])
			 VAR _Place=IF(NOT ISBLANK(_Country),_Country,"Unknown / unassigned") & IF(NOT ISBLANK(_Domain)&&_Domain<>"Unknown"," · "&_Domain,"")
			 VAR _Svg="<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1840 109' font-family='Segoe UI, sans-serif'><rect x='1' y='1' width='1838' height='107' rx='12' fill='#FFFFFF' stroke='#D7E1EC' stroke-width='2'/>" & "<text x='20' y='51' font-size='35' font-weight='650' fill='#14253E'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(LEN(_Name)>65,LEFT(_Name,64)&"…",_Name),"&","&amp;"),"<","&lt;"),">","&gt;") &
			 "</text><text x='20' y='83' font-size='19' fill='#526276'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Place,"&","&amp;"),"<","&lt;"),">","&gt;") &
			 "</text><line x1='1250' y1='23' x2='1250' y2='86' stroke='#D7E1EC'/><text x='1270' y='40' font-size='15' fill='#526276'>User principal name</text><text x='1270' y='69' font-size='19' font-weight='600' fill='#14253E'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(LEN(_UPN)>51,LEFT(_UPN,50)&"…",_UPN),"&","&amp;"),"<","&lt;"),">","&gt;") & "</text></svg>"
			 RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg,"%","%25"),"#","%23"),
			 "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE("<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1840 109' font-family='Segoe UI, sans-serif'><rect x='1' y='1' width='1838' height='107' rx='12' fill='#E7F0FB'/><text x='22' y='64' font-size='23' fill='#2E4E82'>Search and select a user.</text></svg>","%","%25"),"#","%23"))
		displayFolder: User 360 · Presentation
		lineageTag: 69fa2b1a-9855-4fb7-82db-82f6615c13c7
		dataCategory: ImageUrl

	measure 'User 360 Status artwork' =
			VAR _Has=NOT ISBLANK([User 360 Account key])
			VAR _V0=IF(_Has,COALESCE(SELECTEDVALUE('Account Explorer Inventory'[AD Account State]),"Not observed"),"—")
			VAR _Bg0=SWITCH(TRUE(),_V0="—","#FFFFFF",_V0="Disabled","#FCE4E7",_V0 IN {"Enabled","Active ≤30 days"},"#E0F3E9",_V0 IN {"Unknown","Last activity >30 days"},"#FDF0D6",_V0="Not observed","#EBEFF3","#E7EFFB")
			VAR _Fg0=SWITCH(_Bg0,"#FFFFFF","#64748B","#FCE4E7","#9A2434","#E0F3E9","#126147","#FDF0D6","#74440B","#EBEFF3","#596676","#2E4E82")
			VAR _V1=IF(_Has,COALESCE(SELECTEDVALUE('Account Explorer Inventory'[Entra Account State]),"Not observed"),"—")
			VAR _Bg1=SWITCH(TRUE(),_V1="—","#FFFFFF",_V1="Disabled","#FCE4E7",_V1 IN {"Enabled","Active ≤30 days"},"#E0F3E9",_V1 IN {"Unknown","Last activity >30 days"},"#FDF0D6",_V1="Not observed","#EBEFF3","#E7EFFB")
			VAR _Fg1=SWITCH(_Bg1,"#FFFFFF","#64748B","#FCE4E7","#9A2434","#E0F3E9","#126147","#FDF0D6","#74440B","#EBEFF3","#596676","#2E4E82")
			VAR _V2=IF(_Has,COALESCE([User 360 License headline],"Not observed"),"—")
			VAR _Bg2=SWITCH(TRUE(),_V2="—","#FFFFFF",_V2="Disabled","#FCE4E7",_V2 IN {"Enabled","Active ≤30 days"},"#E0F3E9",_V2 IN {"Unknown","Last activity >30 days"},"#FDF0D6",_V2="Not observed","#EBEFF3","#E7EFFB")
			VAR _Fg2=SWITCH(_Bg2,"#FFFFFF","#64748B","#FCE4E7","#9A2434","#E0F3E9","#126147","#FDF0D6","#74440B","#EBEFF3","#596676","#2E4E82")
			VAR _V3=IF(_Has,COALESCE([User 360 Activity headline],"Not observed"),"—")
			VAR _ReportDate = [User 360 M365 report date]
			VAR _DateLabel = IF ( _Has, "M365 report date · " & IF ( ISBLANK ( _ReportDate ), "Not observed", FORMAT ( _ReportDate, "dd MMM yyyy", "en-US" ) ) )
			VAR _Bg3=SWITCH(TRUE(),_V3="—","#FFFFFF",_V3="Disabled","#FCE4E7",_V3 IN {"Enabled","Active ≤30 days"},"#E0F3E9",_V3 IN {"Unknown","Last activity >30 days"},"#FDF0D6",_V3="Not observed","#EBEFF3","#E7EFFB")
			VAR _Fg3=SWITCH(_Bg3,"#FFFFFF","#64748B","#FCE4E7","#9A2434","#E0F3E9","#126147","#FDF0D6","#74440B","#EBEFF3","#596676","#2E4E82")
			VAR _Svg="<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1840 77' font-family='Segoe UI, sans-serif'>" & "<rect x='1' y='1' width='449' height='75' rx='11' fill='" & _Bg0 & "' stroke='" & IF(_Has,_Bg0,"#D7E1EC") & "'/><text x='17' y='28' font-size='15' fill='#526276'>AD account</text><text x='17' y='56' font-size='21' font-weight='600' fill='" & _Fg0 & "'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(LEN(_V0)>41,LEFT(_V0,40)&"…",_V0),"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" &
			"<rect x='464' y='1' width='449' height='75' rx='11' fill='" & _Bg1 & "' stroke='" & IF(_Has,_Bg1,"#D7E1EC") & "'/><text x='480' y='28' font-size='15' fill='#526276'>Entra account</text><text x='480' y='56' font-size='21' font-weight='600' fill='" & _Fg1 & "'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(LEN(_V1)>41,LEFT(_V1,40)&"…",_V1),"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" &
			"<rect x='927' y='1' width='449' height='75' rx='11' fill='" & _Bg2 & "' stroke='" & IF(_Has,_Bg2,"#D7E1EC") & "'/><text x='943' y='28' font-size='15' fill='#526276'>Microsoft 365 license</text><text x='943' y='56' font-size='21' font-weight='600' fill='" & _Fg2 & "'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(LEN(_V2)>41,LEFT(_V2,40)&"…",_V2),"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" &
			"<rect x='1390' y='1' width='449' height='75' rx='11' fill='" & _Bg3 & "' stroke='" & IF(_Has,_Bg3,"#D7E1EC") & "'/><text x='1406' y='22' font-size='15' fill='#526276'>M365 activity</text><text x='1406' y='46' font-size='21' font-weight='600' fill='" & _Fg3 & "'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(LEN(_V3)>41,LEFT(_V3,40)&"…",_V3),"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" & IF ( _Has, "<text x='1406' y='66' font-size='13' fill='#526276'>" & _DateLabel & "</text>", "" ) & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg,"%","%25"),"#","%23")
		displayFolder: User 360 · Presentation
		lineageTag: 0335f713-103c-4389-a1d4-79e3331b5a04
		dataCategory: ImageUrl

	measure 'User 360 Coverage artwork' =
			IF(NOT ISBLANK([User 360 Account key]),
			 VAR _Source=SELECTEDVALUE('Account Explorer Inventory'[Inventory Source])
			 VAR _Complete=_Source="AD + Entra" && NOT ISBLANK([User 360 Native key]) && NOT ISBLANK([User 360 AD key])
			 VAR _Line=SWITCH(TRUE(),_Complete,"AD and Entra accounts matched by technical identity.",_Source="Entra only","Known in Entra only. Active Directory details are unavailable for this account.",_Source="AD only","Known in Active Directory only. Entra details are unavailable for this account.","One or more directory identities could not be qualified for this account.")
			 VAR _Svg="<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1840 54' font-family='Segoe UI, sans-serif'>" & "<rect x='1' y='1' width='1838' height='52' rx='11' fill='" & IF(_Complete,"#E7F0FB","#FDF0D6") &
			 "'/><text x='20' y='34' font-size='19' fill='" & IF(_Complete,"#2E4E82","#74440B") & "'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_Line,"&","&amp;"),"<","&lt;"),">","&gt;") & "</text></svg>"
			 RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg,"%","%25"),"#","%23"),"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1' font-family='Segoe UI, sans-serif'></svg>")
		displayFolder: User 360 · Presentation
		lineageTag: 42c79c63-de0a-4b45-a3e4-7b07178c453c
		dataCategory: ImageUrl

	/// Microsoft 365 usage report refresh date, for the exact qualified user and dataset batch.
	measure 'User 360 M365 report date' =
			VAR _User = [User 360 Native key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			RETURN IF ( NOT ISBLANK ( _User ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Native Workload Activity'[ReportRefreshDate] ),
			        TREATAS ( { _Tenant }, 'Native Workload Activity'[TenantKey] ),
			        TREATAS ( { _Batch }, 'Native Workload Activity'[Loaded Batch ID] ),
			        TREATAS ( { _User }, 'Native Workload Activity'[TenantUserKey] ),
			        'Native Workload Activity'[MatchStatus] = "Resolved UPN"
			    )
			)
		formatString: yyyy-MM-dd
		isHidden
		displayFolder: User 360
		lineageTag: c4348ab4-5490-4627-b14a-c942b7921296

	/// Source export collection timestamp in UTC.
	measure 'User 360 M365 collected at' =
			VAR _User = [User 360 Native key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			RETURN IF ( NOT ISBLANK ( _User ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Native Workload Activity'[SourceCollectedDateTime] ),
			        TREATAS ( { _Tenant }, 'Native Workload Activity'[TenantKey] ),
			        TREATAS ( { _Batch }, 'Native Workload Activity'[Loaded Batch ID] ),
			        TREATAS ( { _User }, 'Native Workload Activity'[TenantUserKey] ),
			        'Native Workload Activity'[MatchStatus] = "Resolved UPN"
			    )
			)
		formatString: yyyy-MM-dd HH:mm
		isHidden
		displayFolder: User 360
		lineageTag: 1dbbec09-e0ce-4ba8-95bf-b44845b7cada

	measure 'User 360 Mailbox permission row' =
			VAR _Account = [User 360 Account key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			VAR _OwnMailbox = [User 360 delegation mailbox key]
			RETURN IF ( NOT ISBLANK ( _Account ),
			    CALCULATE (
			        SELECTEDVALUE ( 'User 360 Mailbox Permissions'[Permissions] ),
			        KEEPFILTERS ( TREATAS ( { _Account }, 'User 360 Mailbox Permissions'[Account Key] ) ),
			        KEEPFILTERS ( 'User 360 Mailbox Permissions'[Mailbox Key] <> _OwnMailbox ),
			        KEEPFILTERS ( TREATAS ( { _Tenant }, 'User 360 Mailbox Permissions'[Tenant Key] ) ),
			        KEEPFILTERS ( TREATAS ( { _Batch }, 'User 360 Mailbox Permissions'[Batch ID] ) )
			    )
			)
		isHidden
		displayFolder: User 360
		lineageTag: 6762c407-e65c-4118-bdd6-f4d2c8b5f182

	measure 'User 360 Team role' =
			VAR _User = [User 360 Native key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			VAR _Teams = VALUES ( 'Native Team'[TenantTeamKey] )
			RETURN IF ( NOT ISBLANK ( _User ),
			    VAR _Roles =
			        CALCULATETABLE ( VALUES ( 'Native Team Membership'[Role] ),
			            TREATAS ( { _Tenant }, 'Native Team Membership'[TenantKey] ),
			        TREATAS ( { _Batch }, 'Native Team Membership'[Loaded Batch ID] ),
			            TREATAS ( { _User }, 'Native Team Membership'[TenantUserKey] ),
			            KEEPFILTERS ( TREATAS ( _Teams, 'Native Team Membership'[TenantTeamKey] ) )
			        )
			    RETURN IF ( NOT ISEMPTY ( _Roles ), CONCATENATEX ( _Roles, 'Native Team Membership'[Role], ", ", 'Native Team Membership'[Role], ASC ) )
			)
		isHidden
		displayFolder: User 360
		lineageTag: be827c17-93d8-49dc-8f03-48b1191504de

	/// Observed site owner or collected Team-root association. Team membership is not evidence of effective SharePoint permissions.
	measure 'User 360 SharePoint association' =
			VAR _User = [User 360 Native key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			VAR _Site =
			    CALCULATE ( SELECTEDVALUE ( 'Native SharePoint Site'[SiteId] ),
			        TREATAS ( { _Tenant }, 'Native SharePoint Site'[TenantKey] ),
			        TREATAS ( { _Batch }, 'Native SharePoint Site'[Loaded Batch ID] ),
			        'Native SharePoint Site'[IsDeleted] = FALSE ()
			    )
			VAR _Upn = SELECTEDVALUE ( 'Account Explorer Inventory'[User Principal Name] )
			RETURN IF ( NOT ISBLANK ( _User ) && NOT ISBLANK ( _Site ) && ISINSCOPE ( 'Native SharePoint Site'[User 360 Site link] ),
			    VAR _Owner =
			        CALCULATE ( SELECTEDVALUE ( 'Native SharePoint Site'[OwnerPrincipalName] ),
			            TREATAS ( { _Tenant }, 'Native SharePoint Site'[TenantKey] ),
			        TREATAS ( { _Batch }, 'Native SharePoint Site'[Loaded Batch ID] ),
			            'Native SharePoint Site'[IsDeleted] = FALSE ()
			        )
			    VAR _OwnerKey =
			        IF ( NOT ISBLANK ( _Upn ) && _Owner = _Upn,
			            LOOKUPVALUE ( 'Native User Evidence'[TenantUserKey],
			                'Native User Evidence'[UserPrincipalName], _Upn,
			                'Native User Evidence'[TenantKey], _Tenant,
			                'Native User Evidence'[Loaded Batch ID], _Batch,
			                BLANK ()
			            )
			        )
			    VAR _TeamIds =
			        CALCULATETABLE ( VALUES ( 'Native Team Membership'[TeamId] ),
			            REMOVEFILTERS ( 'Native Team' ),
			            TREATAS ( { _Tenant }, 'Native Team Membership'[TenantKey] ),
			        TREATAS ( { _Batch }, 'Native Team Membership'[Loaded Batch ID] ),
			            TREATAS ( { _User }, 'Native Team Membership'[TenantUserKey] ),
			            'Native Team Membership'[TeamId] <> BLANK ()
			        )
			    VAR _Linked =
			        CALCULATE ( COUNTROWS ( 'Teams Site Links' ),
			            TREATAS ( { _Tenant }, 'Teams Site Links'[TenantKey] ),
			        TREATAS ( { _Batch }, 'Teams Site Links'[Loaded Batch ID] ),
			            TREATAS ( _TeamIds, 'Teams Site Links'[Team ID] ),
			            TREATAS ( { _Site }, 'Teams Site Links'[Site ID] ),
			            'Teams Site Links'[Link Type] = "Team root",
			            'Teams Site Links'[Link Status] = "Collected"
			        ) > 0
			    VAR _Declared = _OwnerKey = _User
			    RETURN SWITCH ( TRUE (),
			        _Declared && _Linked, "Declared owner · Linked to a team",
			        _Declared, "Declared owner",
			        _Linked, "Linked to a team"
			    )
			)
		isHidden
		displayFolder: User 360
		lineageTag: 5cc53b59-c38f-44b9-800a-394be32f0953

	/// Formats the status and size for the one technically linked mailbox after resolving the mailbox once.
	measure 'User 360 Archive display' =
			VAR _Account = [User 360 Account key]
			VAR _Native = [User 360 Native key]
			VAR _AD = [User 360 AD key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			RETURN IF ( NOT ISBLANK ( _Account ),
			    VAR _Cloud =
			        CALCULATETABLE (
			            SUMMARIZE ( 'Native EXO Mailbox', 'Native EXO Mailbox'[TenantMailboxKey], 'Native EXO Mailbox'[ArchiveStatus] ),
			            'Native EXO Mailbox'[TenantKey] = _Tenant,
			            'Native EXO Mailbox'[Loaded Batch ID] = _Batch,
			            'Native EXO Mailbox'[TenantUserKey] = _Native && NOT ISBLANK ( 'Native EXO Mailbox'[TenantUserKey] ),
			            'Native EXO Mailbox'[LinkStatusLabel] = "Resolved",
			            'Native EXO Mailbox'[TenantMailboxKey] <> BLANK ()
			        )
			    VAR _Local =
			        CALCULATETABLE (
			            SUMMARIZE ( 'Exchange Mailbox Reconciliation', 'Exchange Mailbox Reconciliation'[Mailbox GUID], 'Exchange Mailbox Reconciliation'[Object GUID] ),
			            'Exchange Mailbox Reconciliation'[Loaded Batch ID] = _Batch,
			            'Exchange Mailbox Reconciliation'[AD Account Key] = _AD && NOT ISBLANK ( 'Exchange Mailbox Reconciliation'[AD Account Key] ),
			            'Exchange Mailbox Reconciliation'[Mailbox GUID] <> BLANK (),
			            'Exchange Mailbox Reconciliation'[Report Has Database] = "Yes",
			            'Exchange Mailbox Reconciliation'[Account Link] IN { "Unique AD GUID + native SID", "AD only; cloud unresolved" }
			        )
			    VAR _OneMailbox = COUNTROWS ( _Cloud ) + COUNTROWS ( _Local ) = 1
			    VAR _IsCloud = NOT ISEMPTY ( _Cloud )
			    VAR _Kind = IF ( _IsCloud, "native", "ad" )
			    VAR _IdentityKey = LOWER ( TRIM ( IF ( _IsCloud, MAXX ( _Cloud, 'Native EXO Mailbox'[TenantMailboxKey] ), MAXX ( _Local, 'Exchange Mailbox Reconciliation'[Object GUID] ) ) ) )
			    VAR _NormalizedTenant = LOWER ( TRIM ( _Tenant ) )
			    VAR _Identity = LEN ( _NormalizedTenant ) & ":" & _NormalizedTenant & "|" & LEN ( _Kind ) & ":" & _Kind & "|" & LEN ( _IdentityKey ) & ":" & _IdentityKey
			    VAR _Hosting = IF ( _IsCloud, "Exchange Online", "On-premises" )
			    VAR _Evidence =
			        CALCULATETABLE (
			            'Mailbox Exploration Inventory',
			            'Mailbox Exploration Inventory'[TenantKey] = _Tenant,
			            'Mailbox Exploration Inventory'[Loaded Batch ID] = _Batch,
			            'Mailbox Exploration Inventory'[Mailbox Identity] = _Identity,
			            'Mailbox Exploration Inventory'[Hosting Location] = _Hosting
			        )
			    VAR _Size = IF ( COUNTROWS ( _Evidence ) = 1, MAXX ( _Evidence, 'Mailbox Exploration Inventory'[Archive Size GB] ) )
			    VAR _State = MAXX ( _Cloud, 'Native EXO Mailbox'[ArchiveStatus] )
			    VAR _PreparedEnabled = COUNTROWS ( _Evidence ) = 1 && MAXX ( _Evidence, 'Mailbox Exploration Inventory'[Archive State] ) = "Enabled"
			    VAR _ObservedSize = IF ( NOT ISBLANK ( _Size ) && _Size >= 0 && ( _Size > 0 || _PreparedEnabled ), _Size )
			    VAR _Status =
			        SWITCH ( TRUE (),
			            _State IN { "Active", "Enabled" } || NOT ISBLANK ( _ObservedSize ), "Enabled",
			            _State IN { "None", "Disabled" }, "Disabled",
			            "Not observed"
			        )
			    RETURN IF ( _OneMailbox, _Status & "|" & IF ( ISBLANK ( _ObservedSize ), "Not observed", FORMAT ( _ObservedSize, "0.0", "en-US" ) ) )
			)
		isHidden
		displayFolder: User 360 · Presentation
		lineageTag: f2118421-5e9c-4bb6-8df9-f39b24d094fe

	/// Mailbox evidence key for the single technically linked mailbox in the current tenant and batch.
	measure 'User 360 delegation mailbox key' =
			VAR _Account = [User 360 Account key]
			VAR _Native = [User 360 Native key]
			VAR _AD = [User 360 AD key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			RETURN IF ( NOT ISBLANK ( _Account ),
			    VAR _Cloud =
			        CALCULATETABLE (
			            SUMMARIZE ( 'Native EXO Mailbox', 'Native EXO Mailbox'[TenantMailboxKey], 'Native EXO Mailbox'[ArchiveStatus] ),
			            'Native EXO Mailbox'[TenantKey] = _Tenant,
			            'Native EXO Mailbox'[Loaded Batch ID] = _Batch,
			            'Native EXO Mailbox'[TenantUserKey] = _Native && NOT ISBLANK ( 'Native EXO Mailbox'[TenantUserKey] ),
			            'Native EXO Mailbox'[LinkStatusLabel] = "Resolved",
			            'Native EXO Mailbox'[TenantMailboxKey] <> BLANK ()
			        )
			    VAR _Local =
			        CALCULATETABLE (
			            SUMMARIZE ( 'Exchange Mailbox Reconciliation', 'Exchange Mailbox Reconciliation'[Mailbox GUID], 'Exchange Mailbox Reconciliation'[Object GUID] ),
			            'Exchange Mailbox Reconciliation'[Loaded Batch ID] = _Batch,
			            'Exchange Mailbox Reconciliation'[AD Account Key] = _AD && NOT ISBLANK ( 'Exchange Mailbox Reconciliation'[AD Account Key] ),
			            'Exchange Mailbox Reconciliation'[Mailbox GUID] <> BLANK (),
			            'Exchange Mailbox Reconciliation'[Report Has Database] = "Yes",
			            'Exchange Mailbox Reconciliation'[Account Link] IN { "Unique AD GUID + native SID", "AD only; cloud unresolved" }
			        )
			    VAR _OneMailbox = COUNTROWS ( _Cloud ) + COUNTROWS ( _Local ) = 1
			    VAR _IsCloud = NOT ISEMPTY ( _Cloud )
			    VAR _Kind = IF ( _IsCloud, "native", "ad" )
			    VAR _IdentityKey = LOWER ( TRIM ( IF ( _IsCloud, MAXX ( _Cloud, 'Native EXO Mailbox'[TenantMailboxKey] ), MAXX ( _Local, 'Exchange Mailbox Reconciliation'[Object GUID] ) ) ) )
			    VAR _NormalizedTenant = LOWER ( TRIM ( _Tenant ) )
			    VAR _Identity = LEN ( _NormalizedTenant ) & ":" & _NormalizedTenant & "|" & LEN ( _Kind ) & ":" & _Kind & "|" & LEN ( _IdentityKey ) & ":" & _IdentityKey
			    VAR _Hosting = IF ( _IsCloud, "Exchange Online", "On-premises" )
			    VAR _Evidence =
			        CALCULATETABLE (
			            'Mailbox Exploration Inventory',
			            'Mailbox Exploration Inventory'[TenantKey] = _Tenant,
			            'Mailbox Exploration Inventory'[Loaded Batch ID] = _Batch,
			            'Mailbox Exploration Inventory'[Mailbox Identity] = _Identity,
			            'Mailbox Exploration Inventory'[Hosting Location] = _Hosting
			        )
			    VAR _LocalGuid =
			        IF ( NOT _IsCloud,
			            LOWER ( SUBSTITUTE ( SUBSTITUTE ( TRIM ( MAXX ( _Local, 'Exchange Mailbox Reconciliation'[Mailbox GUID] ) ), "{", "" ), "}", "" ) )
			        )
			    VAR _GuidEvidence =
			        CALCULATETABLE (
			            VALUES ( 'Mailbox Exploration Inventory'[Mailbox Key] ),
			            'Mailbox Exploration Inventory'[TenantKey] = _Tenant,
			            'Mailbox Exploration Inventory'[Loaded Batch ID] = _Batch,
			            'Mailbox Exploration Inventory'[Hosting Location] = _Hosting,
			            NOT ISBLANK ( 'Mailbox Exploration Inventory'[Report Mailbox GUID] )
			                && 'Mailbox Exploration Inventory'[Report Mailbox GUID] = _LocalGuid
			        )
			    VAR _Keys =
			        DISTINCT ( UNION (
			            SELECTCOLUMNS ( _Evidence, "Mailbox key", 'Mailbox Exploration Inventory'[Mailbox Key] ),
			            SELECTCOLUMNS ( _GuidEvidence, "Mailbox key", 'Mailbox Exploration Inventory'[Mailbox Key] )
			        ) )
			    RETURN IF ( _OneMailbox && COUNTROWS ( _Keys ) = 1, MAXX ( _Keys, [Mailbox key] ) )
			)
		isHidden
		displayFolder: User 360
		lineageTag: ec84deb1-dc6c-4cb6-bfb1-46ba71bcf232

	/// Direct rights reported by Exchange on the selected mailbox. Unresolved delegate tokens are shown as reported.
	measure 'User 360 permission on this mailbox' =
			VAR _Mailbox = [User 360 delegation mailbox key]
			VAR _Tenant = SELECTEDVALUE ( 'Account Explorer Inventory'[TenantKey] )
			VAR _Batch = SELECTEDVALUE ( 'Account Explorer Inventory'[Loaded Batch ID] )
			RETURN IF ( NOT ISBLANK ( _Mailbox ) && ISINSCOPE ( 'Mailbox Delegation Detail'[Delegate (reported)] ),
			    VAR _Rows =
			        CALCULATETABLE ( 'Mailbox Delegation Detail',
			            KEEPFILTERS ( 'Mailbox Delegation Detail'[Mailbox Key] = _Mailbox ),
			            KEEPFILTERS ( 'Mailbox Delegation Detail'[TenantKey] = _Tenant ),
			            KEEPFILTERS ( 'Mailbox Delegation Detail'[Loaded Batch ID] = _Batch )
			        )
			    RETURN IF ( NOT ISEMPTY ( _Rows ),
			        VAR _Full = COUNTROWS ( FILTER ( _Rows, 'Mailbox Delegation Detail'[FullAccess] = "Yes" ) ) > 0
			        VAR _Send = COUNTROWS ( FILTER ( _Rows, 'Mailbox Delegation Detail'[SendAs] = "Yes" ) ) > 0
			        VAR _Behalf = COUNTROWS ( FILTER ( _Rows, 'Mailbox Delegation Detail'[GrantSendOnBehalfTo] = "Yes" ) ) > 0
			        VAR _Labels = FILTER ( { IF ( _Full, "Full Access" ), IF ( _Send, "Send As" ), IF ( _Behalf, "Send on Behalf" ) }, NOT ISBLANK ( [Value] ) )
			        VAR _NativeAD = COUNTROWS ( _Rows ) = 1 && MAXX ( _Rows, 'Mailbox Delegation Detail'[Delegate Qualification] ) = "Exact unique reported principal"
			        VAR _Token = MAXX ( _Rows, 'Mailbox Delegation Detail'[Delegate key] )
			        VAR _NativeEntra =
			            IF ( NOT _NativeAD && COUNTROWS ( _Rows ) = 1 && CONTAINSSTRING ( _Token, "@" ) && LEFT ( _Token, 3 ) <> "cn=",
			                CALCULATE ( COUNTROWS ( 'Native User Evidence' ),
			                    'Native User Evidence'[TenantKey] = _Tenant,
			                    'Native User Evidence'[Loaded Batch ID] = _Batch,
			                    'Native User Evidence'[UserPrincipalName] = _Token
			                ) = 1
			            )
			        RETURN IF ( NOT ISEMPTY ( _Labels ),
			            CONCATENATEX ( _Labels, [Value], ", ", [Value], ASC )
			                & IF ( NOT ( _NativeAD || _NativeEntra ), " · Delegate unresolved" )
			        )
			    )
			)
		isHidden
		displayFolder: User 360
		lineageTag: 91899f44-1e47-4202-b0d8-aa5c2be256bd

