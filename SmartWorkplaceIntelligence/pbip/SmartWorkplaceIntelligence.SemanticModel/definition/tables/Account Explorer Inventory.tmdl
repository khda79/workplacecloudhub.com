	measure 'User 360 Cloud mailbox count' = VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_U),CALCULATE(DISTINCTCOUNT('Native EXO Mailbox'[TenantMailboxKey]),TREATAS({_U},'Native EXO Mailbox'[TenantUserKey]),TREATAS({_T},'Native EXO Mailbox'[TenantKey]),TREATAS({_B},'Native EXO Mailbox'[Loaded Batch ID]),'Native EXO Mailbox'[LinkStatusLabel]="Resolved",'Native EXO Mailbox'[TenantMailboxKey]<>BLANK()))
		isHidden
