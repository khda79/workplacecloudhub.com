	partition 'Account Explorer Inventory' = calculated
		mode: import
		source =
				VAR _base = ADDCOLUMNS('All Accounts Evidence',
				 "__ADGuid", IF(LEFT([Account Key],3)="ad:",MID([Account Key],4,500)),
				 "__EntraGuid",IF(LEFT([Account Key],6)="entra:",MID([Account Key],7,500)))
				VAR _links = ADDCOLUMNS(_base,
				 "__NativeUserKey",IF(LEFT([Account Key],3)="ad:",LOOKUPVALUE('AD User Evidence'[TenantUserKey], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				 LOOKUPVALUE('Native User Evidence'[TenantUserKey],'Native User Evidence'[SourceUserId],[__EntraGuid],'Native User Evidence'[TenantKey],[TenantKey],'Native User Evidence'[Loaded Batch ID],[Loaded Batch ID])))
				VAR _users=ADDCOLUMNS(_links,
				 "__SourceID",LOOKUPVALUE('Native User Evidence'[SourceUserId], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				 "__Domain",COALESCE(LOOKUPVALUE('AD User Evidence'[DomainName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[AD Domain], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"))
				RETURN SELECTCOLUMNS(_users,
				"User Source ID",COALESCE([__SourceID],[Account Key]),
				"User Principal Name",COALESCE(LOOKUPVALUE('Native User Evidence'[UserPrincipalName], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[UserPrincipalName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"Display Name",COALESCE(LOOKUPVALUE('Native User Evidence'[DisplayName], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[DisplayName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),[Account Kind]),
				"Country",[Country],
				"Department",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Department], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[Department], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[Department], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Department Evidence State",LOOKUPVALUE('User Inventory Evidence'[Department Evidence State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Manager",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Manager], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[ManagerDistinguishedName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Manager Evidence State",LOOKUPVALUE('User Inventory Evidence'[Manager Evidence State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Account State",SWITCH(TRUE(),[AD State]="Disabled" || [Entra State]="Disabled","Disabled",[AD State]="Enabled" || [Entra State]="Enabled","Enabled","Unknown"),
				"User Type",IF([Inventory Source]="AD only","AD only / not applicable",COALESCE([Entra User Type],"Unknown")),
				"Workforce Status",LOOKUPVALUE('User Inventory Evidence'[Workforce Status], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Activity State",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Activity State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[ActivityState], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Activity Evidence Status",LOOKUPVALUE('User Inventory Evidence'[Activity Evidence Status], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Days Since Last Activity",LOOKUPVALUE('User Inventory Evidence'[Days Since Last Activity], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Last Activity Date",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Last Activity Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[LastSuccessfulSignInDateTime], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[LastLogonUtcDateTime], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"Last Activity Workload",LOOKUPVALUE('User Inventory Evidence'[Last Activity Workload], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Identity Match Status",LOOKUPVALUE('User Inventory Evidence'[Identity Match Status], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Identity Match Method",LOOKUPVALUE('User Inventory Evidence'[Identity Match Method], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"M365 License Count",LOOKUPVALUE('User Inventory Evidence'[M365 License Count], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Has M365 License",LOOKUPVALUE('User Inventory Evidence'[Has M365 License], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Duplicate UPN State",LOOKUPVALUE('User Inventory Evidence'[Duplicate UPN State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Attention Priority",LOOKUPVALUE('User Inventory Evidence'[Attention Priority], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Evidence Date",LOOKUPVALUE('User Inventory Evidence'[Evidence Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Account Type",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Account Type], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[AccountType], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unclassified Account"),
				"Account Population",LOOKUPVALUE('User Inventory Evidence'[Account Population], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Account Classification Rule Version",LOOKUPVALUE('User Inventory Evidence'[Account Classification Rule Version], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Job Title",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Job Title], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[JobTitle], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[Title], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Job Title Evidence State",LOOKUPVALUE('User Inventory Evidence'[Job Title Evidence State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Last Activity Date",COALESCE(LOOKUPVALUE('User Inventory Evidence'[AD Last Activity Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[LastLogonUtcDateTime], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"M365 Last Activity Date",LOOKUPVALUE('User Inventory Evidence'[M365 Last Activity Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Activity Source",LOOKUPVALUE('User Inventory Evidence'[Activity Source], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Workforce Persona",LOOKUPVALUE('User Inventory Evidence'[Workforce Persona], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
