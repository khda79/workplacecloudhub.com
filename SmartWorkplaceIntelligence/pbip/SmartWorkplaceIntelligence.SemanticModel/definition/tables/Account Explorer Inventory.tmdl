	measure 'User 360 Local mailbox key' = VAR _AD=[User 360 AD key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF([User 360 Mailbox hosting]="On-premises",CALCULATE(SELECTEDVALUE('Exchange Mailbox Reconciliation'[Mailbox GUID]),TREATAS({_AD},'Exchange Mailbox Reconciliation'[AD Account Key]),TREATAS({_B},'Exchange Mailbox Reconciliation'[Loaded Batch ID]),'Exchange Mailbox Reconciliation'[Account Link] IN {"Unique AD GUID + native SID","AD only; cloud unresolved"},'Exchange Mailbox Reconciliation'[Report Has Database]="Yes",'Exchange Mailbox Reconciliation'[Mailbox GUID]<>BLANK()))
		isHidden
		displayFolder: User 360
		lineageTag: a54b6595-2ae2-48ee-8ab7-13a70ba74eb3

	measure 'User 360 Mailbox recipient type' =
			VAR _Cloud=[User 360 Cloud mailbox key] VAR _Local=[User 360 Local mailbox key] VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) VAR _AD=[User 360 AD key]
			RETURN SWITCH(TRUE(),NOT ISBLANK(_Cloud),CALCULATE(SELECTEDVALUE('Native EXO Mailbox'[RecipientTypeDetailsLabel]),TREATAS({_U},'Native EXO Mailbox'[TenantUserKey]),TREATAS({_T},'Native EXO Mailbox'[TenantKey]),TREATAS({_B},'Native EXO Mailbox'[Loaded Batch ID]),'Native EXO Mailbox'[LinkStatusLabel]="Resolved",'Native EXO Mailbox'[TenantMailboxKey]<>BLANK(),TREATAS({_Cloud},'Native EXO Mailbox'[TenantMailboxKey])),NOT ISBLANK(_Local),CALCULATE(SELECTEDVALUE('Exchange Mailbox Reconciliation'[Mailbox Type]),TREATAS({_AD},'Exchange Mailbox Reconciliation'[AD Account Key]),TREATAS({_B},'Exchange Mailbox Reconciliation'[Loaded Batch ID]),'Exchange Mailbox Reconciliation'[Account Link] IN {"Unique AD GUID + native SID","AD only; cloud unresolved"},'Exchange Mailbox Reconciliation'[Report Has Database]="Yes",'Exchange Mailbox Reconciliation'[Mailbox GUID]<>BLANK(),TREATAS({_Local},'Exchange Mailbox Reconciliation'[Mailbox GUID])))
		isHidden
		displayFolder: User 360
		lineageTag: 5cc416dc-81e7-4af5-a9b3-37f8b48ab350

	measure 'User 360 Mailbox primary SMTP' =
			VAR _Cloud=[User 360 Cloud mailbox key] VAR _Local=[User 360 Local mailbox key] VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) VAR _AD=[User 360 AD key]
			RETURN SWITCH(TRUE(),NOT ISBLANK(_Cloud),CALCULATE(SELECTEDVALUE('Native EXO Mailbox'[PrimarySmtpAddress]),TREATAS({_U},'Native EXO Mailbox'[TenantUserKey]),TREATAS({_T},'Native EXO Mailbox'[TenantKey]),TREATAS({_B},'Native EXO Mailbox'[Loaded Batch ID]),'Native EXO Mailbox'[LinkStatusLabel]="Resolved",'Native EXO Mailbox'[TenantMailboxKey]<>BLANK(),TREATAS({_Cloud},'Native EXO Mailbox'[TenantMailboxKey])),NOT ISBLANK(_Local),CALCULATE(SELECTEDVALUE('Exchange Mailbox Reconciliation'[Primary SMTP Address]),TREATAS({_AD},'Exchange Mailbox Reconciliation'[AD Account Key]),TREATAS({_B},'Exchange Mailbox Reconciliation'[Loaded Batch ID]),'Exchange Mailbox Reconciliation'[Account Link] IN {"Unique AD GUID + native SID","AD only; cloud unresolved"},'Exchange Mailbox Reconciliation'[Report Has Database]="Yes",'Exchange Mailbox Reconciliation'[Mailbox GUID]<>BLANK(),TREATAS({_Local},'Exchange Mailbox Reconciliation'[Mailbox GUID])))
		isHidden
		displayFolder: User 360
		lineageTag: 04f3bb93-f7a3-4918-b2fa-e7a8a41397cd

	measure 'User 360 Mailbox Size GB' =
			VAR _Cloud=[User 360 Cloud mailbox key] VAR _Local=[User 360 Local mailbox key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) VAR _AD=[User 360 AD key]
			RETURN SWITCH(TRUE(),
			 NOT ISBLANK(_Cloud),VAR _Tenant=LOWER(TRIM(_T)) VAR _Key=LOWER(TRIM(_Cloud))
			 VAR _Identity=LEN(_Tenant)&":"&_Tenant&"|6:native|"&LEN(_Key)&":"&_Key
			 VAR _Rows=CALCULATETABLE('Mailbox Exploration Inventory',TREATAS({_T},'Mailbox Exploration Inventory'[TenantKey]),TREATAS({_B},'Mailbox Exploration Inventory'[Loaded Batch ID]),TREATAS({_Identity},'Mailbox Exploration Inventory'[Mailbox Identity]),'Mailbox Exploration Inventory'[Hosting Location]="Exchange Online")
			 VAR _Size=IF(COUNTROWS(_Rows)=1,MAXX(_Rows,'Mailbox Exploration Inventory'[Mailbox Size GB]))
			 RETURN IF(NOT ISBLANK(_Size)&&_Size>=0,_Size),
			 NOT ISBLANK(_Local),VAR _Rows=CALCULATETABLE('Exchange Mailbox Reconciliation',TREATAS({_AD},'Exchange Mailbox Reconciliation'[AD Account Key]),TREATAS({_B},'Exchange Mailbox Reconciliation'[Loaded Batch ID]),'Exchange Mailbox Reconciliation'[Account Link] IN {"Unique AD GUID + native SID","AD only; cloud unresolved"},'Exchange Mailbox Reconciliation'[Report Has Database]="Yes",'Exchange Mailbox Reconciliation'[Mailbox GUID]<>BLANK(),TREATAS({_Local},'Exchange Mailbox Reconciliation'[Mailbox GUID]))
			 VAR _Size=IF(COUNTROWS(_Rows)=1,MAXX(_Rows,'Exchange Mailbox Reconciliation'[Mailbox Size GB]))
			 RETURN IF(NOT ISBLANK(_Size)&&_Size>=0,_Size))
		formatString: 0.0
		displayFolder: User 360
		lineageTag: 5fc522bd-111f-4628-9df0-8f47ed00ae50

	measure 'User 360 License assignment' =
			VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID])
			RETURN IF(NOT ISBLANK(_U),VAR _States=CALCULATETABLE(VALUES('Native User License'[AssignmentStateLabel]),TREATAS({_U},'Native User License'[TenantUserKey]),TREATAS({_T},'Native User License'[TenantKey]),TREATAS({_B},'Native User License'[Loaded Batch ID]),'Native User License'[UserLinkStatus]="Resolved",TREATAS({_T},'Native License SKU'[TenantKey]),TREATAS({_B},'Native License SKU'[Loaded Batch ID]),'Native User License'[TenantSkuKey]<>BLANK()) RETURN IF(COUNTROWS(_States)>0,CONCATENATEX(_States,'Native User License'[AssignmentStateLabel],", ",'Native User License'[AssignmentStateLabel],ASC)))
