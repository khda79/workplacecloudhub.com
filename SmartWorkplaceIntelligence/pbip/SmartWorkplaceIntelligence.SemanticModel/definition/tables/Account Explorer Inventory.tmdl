		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: 823ec95b-2b82-4ace-a014-a5196cdb9a66

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Stale >90D' =

			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[TenantUserKey]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _rows=FILTER('Account Explorer Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _lf || [Native User Key] IN _withLicense || (_none && NOT ISBLANK([Native User Key]) && [License Count]=0) || (_unknown && ISBLANK([Native User Key]))))
			RETURN COALESCE(COUNTROWS(FILTER(_rows,[Activity State]="Stale >90D")),0)
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: fceea578-f1bb-4da6-bdcb-b53143e0f7ce

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Missing Activity' =

			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[TenantUserKey]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _rows=FILTER('Account Explorer Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _lf || [Native User Key] IN _withLicense || (_none && NOT ISBLANK([Native User Key]) && [License Count]=0) || (_unknown && ISBLANK([Native User Key]))))
			RETURN COALESCE(COUNTROWS(FILTER(_rows,ISBLANK([Last Activity Date]))),0)
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: 38eaae9e-9f4d-4b65-beb3-7aa5a31f2666

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Activity Coverage (%)' = DIVIDE([Account Inventory Accounts]-[Account Inventory Missing Activity],[Account Inventory Accounts])
		formatString: 0.0%
		displayFolder: Private account and device explorer
		lineageTag: bf7d737b-c168-4074-92da-0fb6ab5115fa

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Missing Manager' =

			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[TenantUserKey]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _rows=FILTER('Account Explorer Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _lf || [Native User Key] IN _withLicense || (_none && NOT ISBLANK([Native User Key]) && [License Count]=0) || (_unknown && ISBLANK([Native User Key]))))
			RETURN COALESCE(COUNTROWS(FILTER(_rows,ISBLANK([Manager]) || [Manager]="Unknown")),0)
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: 1b02ec59-4e90-442e-9cca-d1301f57ace6

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Department Completeness (%)' =

			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[TenantUserKey]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _rows=FILTER('Account Explorer Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _lf || [Native User Key] IN _withLicense || (_none && NOT ISBLANK([Native User Key]) && [License Count]=0) || (_unknown && ISBLANK([Native User Key]))))
			RETURN DIVIDE(COUNTROWS(FILTER(_rows,NOT ISBLANK([Department]) && [Department]<>"Unknown")),COUNTROWS(_rows))
		formatString: 0.0%
		displayFolder: Private account and device explorer
		lineageTag: 97190c12-a8cb-4ab6-84b1-eef6c3e6d8f2

	/// Top five job titles in current external selection, compared by country. Full job-title distribution remains in matrix.
	measure 'Job Title Country Top 5 Accounts' =
			VAR _ranked=TOPN(5,ADDCOLUMNS(ALLSELECTED('Account Explorer Inventory'[Job Title]),"__count",CALCULATE([Account Inventory Accounts],ALLSELECTED('Account Explorer Inventory'[Country Name]))),[__count],DESC,'Account Explorer Inventory'[Job Title],ASC)
			RETURN IF(SELECTEDVALUE('Account Explorer Inventory'[Job Title]) IN SELECTCOLUMNS(_ranked,"Title",'Account Explorer Inventory'[Job Title]),[Account Inventory Accounts])
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: ab5c234d-0bf8-421d-8e3a-b0830f0f0f65

	/// Positive stale counts are red; zero is blue only with an observed scoped population and no missing activity; otherwise gray.
	measure 'Account Stale Findings Color' = VAR _n=[Account Inventory Stale >90D] VAR _scope=[Account Inventory Accounts] VAR _missing=[Account Inventory Missing Activity] RETURN SWITCH(TRUE(), _n>0,"#B73F4A", ISBLANK(_n) || ISBLANK(_scope) || _scope<=0,"#6B7280", ISBLANK(_missing) || _missing>0,"#6B7280", _n=0,"#1764AB", "#6B7280")
		isHidden
		lineageTag: 6e974761-2fc2-40ae-a375-c59ba255540d

	measure 'User 360 Account key' = IF(ISFILTERED('Account Explorer Inventory'[User 360 Selection]) && HASONEVALUE('Account Explorer Inventory'[User 360 Selection]) && COUNTROWS('Account Explorer Inventory')=1 && NOT ISBLANK(SELECTEDVALUE('Account Explorer Inventory'[TenantKey])) && NOT ISBLANK(SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID])),SELECTEDVALUE('Account Explorer Inventory'[Account Key]))
		isHidden
		displayFolder: User 360
		lineageTag: bbcf50a1-2a83-431c-9fda-62b8ba6642df

	measure 'User 360 Native key' = IF(NOT ISBLANK([User 360 Account key]),SELECTEDVALUE('Account Explorer Inventory'[Native User Key]))
		isHidden
		displayFolder: User 360
		lineageTag: 8d3e8bde-a15e-4de8-ad56-ba3149be8169

	measure 'User 360 AD key' =
			VAR _K=[User 360 Account key] VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) VAR _GUID=IF(LEFT(_K,3)="ad:",MID(_K,4,100))
			RETURN IF(NOT ISBLANK(_K),VAR _Rows=CALCULATETABLE(FILTER('AD User Evidence',(NOT ISBLANK(_GUID)&&'AD User Evidence'[ObjectGUID]=_GUID)||(ISBLANK(_GUID)&&NOT ISBLANK(_U)&&'AD User Evidence'[TenantUserKey]=_U&&'AD User Evidence'[CloudMatchStatus]="Unique native SID")),TREATAS({_T},'AD User Evidence'[TenantKey]),TREATAS({_B},'AD User Evidence'[Loaded Batch ID])) RETURN IF(COUNTROWS(_Rows)=1,MAXX(_Rows,'AD User Evidence'[TenantADUserKey])))
		isHidden
		displayFolder: User 360
		lineageTag: a6845860-e092-466b-a89f-4e31c07ab944

	measure 'User 360 AD object key' = VAR _AD=[User 360 AD key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_AD),VAR _GUID=CALCULATE(SELECTEDVALUE('AD User Evidence'[ObjectGUID]),TREATAS({_AD},'AD User Evidence'[TenantADUserKey]),TREATAS({_T},'AD User Evidence'[TenantKey]),TREATAS({_B},'AD User Evidence'[Loaded Batch ID])) VAR _Rows=CALCULATETABLE('AD Object Evidence',TREATAS({_GUID},'AD Object Evidence'[ObjectGUID]),TREATAS({_T},'AD Object Evidence'[TenantKey]),TREATAS({_B},'AD Object Evidence'[Loaded Batch ID])) RETURN IF(NOT ISBLANK(_GUID)&&COUNTROWS(_Rows)=1,MAXX(_Rows,'AD Object Evidence'[TenantADObjectKey])))
		isHidden
		displayFolder: User 360
		lineageTag: a2d7eb21-110e-4087-8d30-23dd76775f63

	measure 'User 360 AD last logon' = VAR _AD=[User 360 AD key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_AD),CALCULATE(SELECTEDVALUE('AD User Evidence'[LastLogonUtcDateTime]),TREATAS({_AD},'AD User Evidence'[TenantADUserKey]),TREATAS({_T},'AD User Evidence'[TenantKey]),TREATAS({_B},'AD User Evidence'[Loaded Batch ID])))
		isHidden
		displayFolder: User 360
		lineageTag: 854b0061-0ea5-4553-8e1c-416074a6d7c3

	measure 'User 360 Entra last successful sign-in' = VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_U),CALCULATE(SELECTEDVALUE('Native User Evidence'[LastSuccessfulSignInDateTime]),TREATAS({_U},'Native User Evidence'[TenantUserKey]),TREATAS({_T},'Native User Evidence'[TenantKey]),TREATAS({_B},'Native User Evidence'[Loaded Batch ID])))
		isHidden
		displayFolder: User 360
		lineageTag: f5a7690e-d228-46c9-8d58-02320f9f0155

	measure 'User 360 Device count' = VAR _U=[User 360 Native key] VAR _T=SELECTEDVALUE('Account Explorer Inventory'[TenantKey]) VAR _B=SELECTEDVALUE('Account Explorer Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_U),CALCULATE(DISTINCTCOUNTNOBLANK('Native User Device Link'[TenantDeviceKey]),TREATAS({_U},'Native User Device Link'[TenantUserKey]),TREATAS({_T},'Native User Device Link'[TenantKey]),TREATAS({_B},'Native User Device Link'[Loaded Batch ID]),TREATAS({_T},'Native Device Evidence'[TenantKey]),TREATAS({_B},'Native Device Evidence'[Loaded Batch ID]),'Native User Device Link'[RelationshipType]="PrimaryUser"))
		isHidden
