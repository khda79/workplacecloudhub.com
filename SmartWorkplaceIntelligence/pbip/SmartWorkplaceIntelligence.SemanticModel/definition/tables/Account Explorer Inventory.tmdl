	column 'User 360 Label Base' = VAR _Name=TRIM('Account Explorer Inventory'[Display Name]) VAR _UPN=TRIM('Account Explorer Inventory'[User Principal Name]) RETURN IF(_Name=""||_Name=_UPN,IF(_UPN="","Unknown user",_UPN),_Name & IF(_UPN="",""," · "&_UPN))
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 67727f52-e700-4a80-b58d-2c1de1dd9666

	column 'User 360 Selection' = VAR _Base='Account Explorer Inventory'[User 360 Label Base] VAR _Rows=CALCULATE(COUNTROWS('Account Explorer Inventory'),ALLEXCEPT('Account Explorer Inventory','Account Explorer Inventory'[User 360 Label Base])) RETURN _Base & IF(_Rows>1," · "&'Account Explorer Inventory'[TenantKey]&" · "&'Account Explorer Inventory'[Account Key]&IF(CALCULATE(COUNTROWS('Account Explorer Inventory'),ALLEXCEPT('Account Explorer Inventory','Account Explorer Inventory'[User 360 Label Base],'Account Explorer Inventory'[TenantKey],'Account Explorer Inventory'[Account Key]))>1," · "&'Account Explorer Inventory'[Loaded Batch ID],""),"")
		dataType: string
		isAvailableInMdx: false
		lineageTag: 5a342648-13b8-45bd-8d7a-f1ad6b8498bb

	partition 'Account Explorer Inventory' = calculated
		mode: import
		source =
				VAR _base = ADDCOLUMNS('All Accounts Evidence',
				 "__ADGuid", IF(LEFT([Account Key],3)="ad:",MID([Account Key],4,500)),
				 "__EntraGuid",IF(LEFT([Account Key],6)="entra:",MID([Account Key],7,500)))
				VAR _links = ADDCOLUMNS(_base,
				 "__NativeUserKey",IF(LEFT([Account Key],3)="ad:",LOOKUPVALUE('AD User Evidence'[TenantUserKey], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				 LOOKUPVALUE('Native User Evidence'[TenantUserKey],'Native User Evidence'[SourceUserId],[__EntraGuid],'Native User Evidence'[TenantKey],[TenantKey],'Native User Evidence'[Loaded Batch ID],[Loaded Batch ID])))
				VAR _users=ADDCOLUMNS(_links,
				 "__SourceID",LOOKUPVALUE('Native User Evidence'[SourceUserId], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				 "__Domain",COALESCE(LOOKUPVALUE('AD User Evidence'[DomainName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[AD Domain], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"))
				RETURN SELECTCOLUMNS(_users,
				"User Source ID",COALESCE([__SourceID],[Account Key]),
				"User Principal Name",COALESCE(LOOKUPVALUE('Native User Evidence'[UserPrincipalName], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[UserPrincipalName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"Display Name",COALESCE(LOOKUPVALUE('Native User Evidence'[DisplayName], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[DisplayName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),[Account Kind]),
				"Country",[Country],
				"Department",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Department], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[Department], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[Department], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Department Evidence State",LOOKUPVALUE('User Inventory Evidence'[Department Evidence State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Manager",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Manager], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[ManagerDistinguishedName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Manager Evidence State",LOOKUPVALUE('User Inventory Evidence'[Manager Evidence State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Account State",SWITCH(TRUE(),[AD State]="Disabled" || [Entra State]="Disabled","Disabled",[AD State]="Enabled" || [Entra State]="Enabled","Enabled","Unknown"),
				"User Type",IF([Inventory Source]="AD only","AD only / not applicable",COALESCE([Entra User Type],"Unknown")),
				"Workforce Status",LOOKUPVALUE('User Inventory Evidence'[Workforce Status], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Activity State",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Activity State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[ActivityState], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Activity Evidence Status",LOOKUPVALUE('User Inventory Evidence'[Activity Evidence Status], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Days Since Last Activity",LOOKUPVALUE('User Inventory Evidence'[Days Since Last Activity], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Last Activity Date",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Last Activity Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[LastSuccessfulSignInDateTime], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[LastLogonUtcDateTime], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"Last Activity Workload",LOOKUPVALUE('User Inventory Evidence'[Last Activity Workload], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Identity Match Status",LOOKUPVALUE('User Inventory Evidence'[Identity Match Status], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Identity Match Method",LOOKUPVALUE('User Inventory Evidence'[Identity Match Method], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"M365 License Count",LOOKUPVALUE('User Inventory Evidence'[M365 License Count], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Has M365 License",LOOKUPVALUE('User Inventory Evidence'[Has M365 License], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Duplicate UPN State",LOOKUPVALUE('User Inventory Evidence'[Duplicate UPN State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Attention Priority",LOOKUPVALUE('User Inventory Evidence'[Attention Priority], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Evidence Date",LOOKUPVALUE('User Inventory Evidence'[Evidence Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Account Type",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Account Type], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[AccountType], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unclassified Account"),
				"Account Population",LOOKUPVALUE('User Inventory Evidence'[Account Population], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Account Classification Rule Version",LOOKUPVALUE('User Inventory Evidence'[Account Classification Rule Version], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Job Title",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Job Title], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[JobTitle], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[Title], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID]),"Unknown"),
				"Job Title Evidence State",LOOKUPVALUE('User Inventory Evidence'[Job Title Evidence State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Last Activity Date",COALESCE(LOOKUPVALUE('User Inventory Evidence'[AD Last Activity Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[LastLogonUtcDateTime], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"M365 Last Activity Date",LOOKUPVALUE('User Inventory Evidence'[M365 Last Activity Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Activity Source",LOOKUPVALUE('User Inventory Evidence'[Activity Source], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Workforce Persona",LOOKUPVALUE('User Inventory Evidence'[Workforce Persona], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Persona Match State",LOOKUPVALUE('User Inventory Evidence'[Persona Match State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Persona Matched Keywords",LOOKUPVALUE('User Inventory Evidence'[Persona Matched Keywords], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"MFA Registration State",LOOKUPVALUE('User Inventory Evidence'[MFA Registration State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Has Microsoft 365 F3",LOOKUPVALUE('User Inventory Evidence'[Has Microsoft 365 F3], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Has Microsoft 365 E3",LOOKUPVALUE('User Inventory Evidence'[Has Microsoft 365 E3], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Has Microsoft 365 E5",LOOKUPVALUE('User Inventory Evidence'[Has Microsoft 365 E5], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Exchange Usage State (30D)",LOOKUPVALUE('User Inventory Evidence'[Exchange Usage State (30D)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Teams Usage State (30D)",LOOKUPVALUE('User Inventory Evidence'[Teams Usage State (30D)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"SharePoint Usage State (30D)",LOOKUPVALUE('User Inventory Evidence'[SharePoint Usage State (30D)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"OneDrive Usage State (30D)",LOOKUPVALUE('User Inventory Evidence'[OneDrive Usage State (30D)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"M365 Usage Report Date",LOOKUPVALUE('User Inventory Evidence'[M365 Usage Report Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Office Desktop Activation State (30D)",LOOKUPVALUE('User Inventory Evidence'[Office Desktop Activation State (30D)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Office Desktop Usage State (30D)",LOOKUPVALUE('User Inventory Evidence'[Office Desktop Usage State (30D)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Office Desktop Usage Report Date",LOOKUPVALUE('User Inventory Evidence'[Office Desktop Usage Report Date], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Directory Site Code",LOOKUPVALUE('User Inventory Evidence'[Directory Site Code], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Site Type",LOOKUPVALUE('User Inventory Evidence'[Site Type], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Site Match State",LOOKUPVALUE('User Inventory Evidence'[Site Match State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Persona Classification Source",LOOKUPVALUE('User Inventory Evidence'[Persona Classification Source], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Console Last Activity UTC",LOOKUPVALUE('User Inventory Evidence'[Console Last Activity UTC], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Console Activity Evidence State",LOOKUPVALUE('User Inventory Evidence'[Console Activity Evidence State], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Console Activity Device Count",LOOKUPVALUE('User Inventory Evidence'[Console Activity Device Count], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Console Activity Match Method",LOOKUPVALUE('User Inventory Evidence'[Console Activity Match Method], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Loaded Batch ID",[Loaded Batch ID],
				"AD Created (source)",COALESCE(LOOKUPVALUE('User Inventory Evidence'[AD Created (source)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[CreationRaw], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"AD Creation Qualification",LOOKUPVALUE('User Inventory Evidence'[AD Creation Qualification], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Created UTC",LOOKUPVALUE('User Inventory Evidence'[AD Created UTC], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Modified (source)",COALESCE(LOOKUPVALUE('User Inventory Evidence'[AD Modified (source)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[ModificationRaw], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"AD Modification Qualification",LOOKUPVALUE('User Inventory Evidence'[AD Modification Qualification], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Modified UTC",LOOKUPVALUE('User Inventory Evidence'[AD Modified UTC], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Entra Created (source)",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Entra Created (source)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[CreationRaw], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"Entra Creation Qualification",LOOKUPVALUE('User Inventory Evidence'[Entra Creation Qualification], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Entra Created UTC",LOOKUPVALUE('User Inventory Evidence'[Entra Created UTC], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Entra Modified (source)",COALESCE(LOOKUPVALUE('User Inventory Evidence'[Entra Modified (source)], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('Native User Evidence'[ModificationRaw], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"Entra Modification Qualification",LOOKUPVALUE('User Inventory Evidence'[Entra Modification Qualification], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"Entra Modified UTC",LOOKUPVALUE('User Inventory Evidence'[Entra Modified UTC], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Password Expired",LOOKUPVALUE('User Inventory Evidence'[AD Password Expired], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Password Expiry Status",LOOKUPVALUE('User Inventory Evidence'[AD Password Expiry Status], 'User Inventory Evidence'[User Source ID], [__SourceID], 'User Inventory Evidence'[TenantKey], [TenantKey], 'User Inventory Evidence'[Loaded Batch ID], [Loaded Batch ID]),
				"AD Domain",[__Domain],
				"TenantKey",[TenantKey],
				"Country Name",[Country Name],
				"Account Key",[Account Key],
				"Native User Key",[__NativeUserKey],
				"SAM Account Name",COALESCE(LOOKUPVALUE('Native User Evidence'[SAM Account Name], 'Native User Evidence'[TenantUserKey], [__NativeUserKey], 'Native User Evidence'[TenantKey], [TenantKey], 'Native User Evidence'[Loaded Batch ID], [Loaded Batch ID]),LOOKUPVALUE('AD User Evidence'[SamAccountName], 'AD User Evidence'[ObjectGUID], [__ADGuid], 'AD User Evidence'[TenantKey], [TenantKey], 'AD User Evidence'[Loaded Batch ID], [Loaded Batch ID])),
				"AD Account State",[AD State],
				"Entra Account State",[Entra State],
				"Inventory Source",[Inventory Source],
				"Account Kind",[Account Kind],
				"AD/Entra State Conflict",IF([AD State] IN {"Enabled","Disabled"} && [Entra State] IN {"Enabled","Disabled"} && [AD State]<>[Entra State],"Yes","No"),
				"License Count",VAR _key=[__NativeUserKey] VAR _tenant=[TenantKey] VAR _batch=[Loaded Batch ID] RETURN IF(NOT ISBLANK(_key),COUNTROWS(FILTER('Native User License',[TenantUserKey]=_key && [TenantKey]=_tenant && [Loaded Batch ID]=_batch))),
				"License Products",VAR _key=[__NativeUserKey] VAR _tenant=[TenantKey] VAR _batch=[Loaded Batch ID]
				 VAR _skus=SELECTCOLUMNS(FILTER('Native User License',[TenantUserKey]=_key && [TenantKey]=_tenant && [Loaded Batch ID]=_batch),"K",[TenantSkuKey])
				 RETURN IF(NOT ISBLANK(_key),CONCATENATEX(FILTER('Native License SKU',[TenantKey]=_tenant && [TenantSkuKey] IN _skus),[SkuPartNumberLabel],", ",[SkuPartNumberLabel],ASC))
				)
