		lineageTag: fceea578-f1bb-4da6-bdcb-b53143e0f7ce

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Missing Activity' =

			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[TenantUserKey]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _rows=FILTER('Account Explorer Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _lf || [Native User Key] IN _withLicense || (_none && NOT ISBLANK([Native User Key]) && [License Count]=0) || (_unknown && ISBLANK([Native User Key]))))
			RETURN COALESCE(COUNTROWS(FILTER(_rows,ISBLANK([Last Activity Date]))),0)
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: 38eaae9e-9f4d-4b65-beb3-7aa5a31f2666

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Activity Coverage (%)' = DIVIDE([Account Inventory Accounts]-[Account Inventory Missing Activity],[Account Inventory Accounts])
		formatString: 0.0%
		displayFolder: Private account and device explorer
		lineageTag: bf7d737b-c168-4074-92da-0fb6ab5115fa

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Missing Manager' =

			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[TenantUserKey]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _rows=FILTER('Account Explorer Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _lf || [Native User Key] IN _withLicense || (_none && NOT ISBLANK([Native User Key]) && [License Count]=0) || (_unknown && ISBLANK([Native User Key]))))
			RETURN COALESCE(COUNTROWS(FILTER(_rows,ISBLANK([Manager]) || [Manager]="Unknown")),0)
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: 1b02ec59-4e90-442e-9cca-d1301f57ace6

	/// Private approved account/device lot; existing loaded batch only.
	measure 'Account Inventory Department Completeness (%)' =

			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _lf=ISFILTERED('Account License Selection')
			VAR _sku=SELECTCOLUMNS(FILTER('Account License Selection',[Selection Kind]="Product"),"K",[Tenant SKU Key])
			VAR _withLicense=CALCULATETABLE(VALUES('Native User License'[TenantUserKey]),TREATAS(_sku,'Native User License'[TenantSkuKey]))
			VAR _none=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"None")
			VAR _unknown=CONTAINS('Account License Selection','Account License Selection'[Selection Kind],"Unknown")
			VAR _rows=FILTER('Account Explorer Inventory',
			 (NOT _cf || [Country Name] IN _countries) && (NOT _df || [AD Domain] IN _domains) &&
			 (NOT _lf || [Native User Key] IN _withLicense || (_none && NOT ISBLANK([Native User Key]) && [License Count]=0) || (_unknown && ISBLANK([Native User Key]))))
			RETURN DIVIDE(COUNTROWS(FILTER(_rows,NOT ISBLANK([Department]) && [Department]<>"Unknown")),COUNTROWS(_rows))
		formatString: 0.0%
		displayFolder: Private account and device explorer
		lineageTag: 97190c12-a8cb-4ab6-84b1-eef6c3e6d8f2

	/// Top five job titles in current external selection, compared by country. Full job-title distribution remains in matrix.
	measure 'Job Title Country Top 5 Accounts' =
			VAR _ranked=TOPN(5,ADDCOLUMNS(ALLSELECTED('Account Explorer Inventory'[Job Title]),"__count",CALCULATE([Account Inventory Accounts],ALLSELECTED('Account Explorer Inventory'[Country Name]))),[__count],DESC,'Account Explorer Inventory'[Job Title],ASC)
			RETURN IF(SELECTEDVALUE('Account Explorer Inventory'[Job Title]) IN SELECTCOLUMNS(_ranked,"Title",'Account Explorer Inventory'[Job Title]),[Account Inventory Accounts])
		formatString: #,0
		displayFolder: Private account and device explorer
		lineageTag: ab5c234d-0bf8-421d-8e3a-b0830f0f0f65

