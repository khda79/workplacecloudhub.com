	partition 'Site Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Site Key" = Int64.Type, #"Site Surrogate Key" = nullable text, #"Site Type" = nullable text, #"Workload" = nullable text, #"Activity State" = nullable text], {
				        {1, "Site 001", "TeamSite", "SharePoint", "Active"},
				        {2, "Site 002", "CommunicationSite", "SharePoint", "Inactive"},
				        {3, "Site 003", "PersonalSite", "OneDrive", "Active"}
