	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: b1cc053f-9536-4f1b-8426-f14d5329a09c
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'Intune Enrollment Failure Evidence' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Raw = ReadMigrationCsv(GetPreparedEvidenceFile("IntuneEnrollmentFailureEvidence.csv"), {"TenantKey", "EvidenceKey", "ReceiptRunId", "BusinessRunId", "SourceFile", "SourceSHA256", "SourceRecord", "CollectionUTC", "EventId", "EventDateTime", "CorrelationId", "ManagedDeviceIdentifier", "HasManagedDeviceIdentifier", "DeviceId", "UserId", "EnrollmentType", "FailureCategory", "FailureReason", "OperatingSystem", "OSVersion", "SourceStatusUTC", "SourceStatusTimeBasis", "InventoryMatch"}),
				    Selected = Table.SelectColumns(Raw, {"TenantKey", "EvidenceKey", "ReceiptRunId", "BusinessRunId", "SourceFile", "SourceSHA256", "SourceRecord", "CollectionUTC", "EventId", "EventDateTime", "CorrelationId", "ManagedDeviceIdentifier", "HasManagedDeviceIdentifier", "DeviceId", "UserId", "EnrollmentType", "FailureCategory", "FailureReason", "OperatingSystem", "OSVersion", "SourceStatusUTC", "SourceStatusTimeBasis", "InventoryMatch"}),
				    Tenants = List.Distinct(Selected[TenantKey]),
				    Validated = if List.Count(Tenants) > 1 or List.Contains(Tenants, null) or List.Contains(Tenants, "") then error "Intune evidence tenant identity is invalid" else Selected,
				    ParseUtc = (raw as nullable text) as nullable datetime => if raw = null or Text.Trim(raw) = "" then null else if not Text.EndsWith(raw, "Z") then error "Intune prepared time requires explicit UTC Z" else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(raw, [Culture="en-US"]), 0)),
				    Key = (values as list) as nullable text => if List.AnyTrue(List.Transform(values, each _ = null or Text.Trim(Text.From(_)) = "")) then null else Text.Combine(List.Transform(values, each Text.From(Text.Length(Text.From(_))) & ":" & Text.From(_)), "|"),
				    Typed = Table.TransformColumns(Validated, {{"TenantKey", each _, type nullable text}, {"EvidenceKey", each _, type nullable text}, {"ReceiptRunId", each _, type nullable text}, {"BusinessRunId", each _, type nullable text}, {"SourceFile", each _, type nullable text}, {"SourceSHA256", each _, type nullable text}, {"SourceRecord", each if _ = null or Text.Trim(_) = "" then null else Int64.From(Number.FromText(_, "en-US")), type nullable number}, {"CollectionUTC", ParseUtc, type nullable datetime}, {"EventId", each _, type nullable text}, {"EventDateTime", each _, type nullable text}, {"CorrelationId", each _, type nullable text}, {"ManagedDeviceIdentifier", each _, type nullable text}, {"HasManagedDeviceIdentifier", each _, type nullable text}, {"DeviceId", each _, type nullable text}, {"UserId", each _, type nullable text}, {"EnrollmentType", each _, type nullable text}, {"FailureCategory", each _, type nullable text}, {"FailureReason", each _, type nullable text}, {"OperatingSystem", each _, type nullable text}, {"OSVersion", each _, type nullable text}, {"SourceStatusUTC", ParseUtc, type nullable datetime}, {"SourceStatusTimeBasis", each _, type nullable text}, {"InventoryMatch", each _, type nullable text}}),
				    WithDeviceKey = Table.AddColumn(Typed, "Device Key", each if [HasManagedDeviceIdentifier] = "True" and [ManagedDeviceIdentifier] <> "00000000-0000-0000-0000-000000000000" then Key({[TenantKey], [ManagedDeviceIdentifier]}) else null, type nullable text)
				in
				    WithDeviceKey)
				in
				    Readers[Finish](BusinessRows)
