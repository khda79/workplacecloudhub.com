/// Governed IntuneEnrollmentFailureEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Enrollment Failure Evidence'
	lineageTag: b9b1164c-807b-4e9f-b3b0-a95d2664d4a7

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Enrollment Failure Events' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "EnrollmentFailures", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Enrollment Failure Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: e09182e4-e3c1-435b-8947-083298de4802

	/// Distinct tenant-aware identities among the specified reported observations, not verified physical endpoints or full tenant coverage.
	measure 'Intune Enrollment Identified Devices' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "EnrollmentFailures", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(DISTINCTCOUNT('Intune Enrollment Failure Evidence'[Device Key]), KEEPFILTERS('Intune Enrollment Failure Evidence'[Device Key] <> BLANK())), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: b7758a0a-83c9-4e83-bb50-6aeed7677676

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Enrollment Unmatched Events' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "EnrollmentFailures", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Enrollment Failure Evidence'), KEEPFILTERS('Intune Enrollment Failure Evidence'[Inventory Match] <> "Matched technical identifier")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 96be52a0-526a-4a85-9e9f-bc3dbf85adbf

