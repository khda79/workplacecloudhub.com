/// Native source facet migrated from ADDirectoryObject; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'AD Object Evidence'
	lineageTag: cc3b294f-5102-4a87-8518-abb4f3297f18

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · AD Object Evidence' = (COUNTROWS('AD Object Evidence'))
		formatString: #,0
		isHidden
		lineageTag: c8c1b3f3-f879-4a90-9c44-2428329d3a4a

