/// SPO means SharePoint Online. Grain: History Key; source: one selected immutable prepared batch.
table 'SPO Migration History'
	lineageTag: d7cdebec-bcd9-4b14-8bae-e13cd5d11596

	/// Historical Migrate Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Historical Migrate Operations' =
			VAR _day=CALCULATE(MAX('SPO Migration History'[Snapshot Date]), REMOVEFILTERS('SPO Migration Business Unit'), REMOVEFILTERS('SPO Migration Phase'), REMOVEFILTERS('SPO Migration Source Type'), REMOVEFILTERS('SPO Migration Operation'))
			RETURN CALCULATE(DISTINCTCOUNT('SPO Migration History'[Operation Key]), KEEPFILTERS('SPO Migration History'[Snapshot Date]=_day), KEEPFILTERS('SPO Migration History'[Is Latest Daily Snapshot]=TRUE()), KEEPFILTERS('SPO Migration History'[Present In Register]=TRUE()), KEEPFILTERS('SPO Migration History'[Disposition]="MIGRATE"))
		formatString: #,##0
		displayFolder: Migration\History
		lineageTag: d49b0f06-f106-49a2-8f78-b25daf896490

	/// Historical Reported Done. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Historical Reported Done' = VAR _n=[SPO Historical Migrate Operations] RETURN IF(_n>0, COALESCE(CALCULATE([SPO Historical Migrate Operations], KEEPFILTERS('SPO Migration History'[Execution Status]="DONE")),0))
		formatString: #,##0
		displayFolder: Migration\History
		lineageTag: 3caaa2a7-c134-4dee-b2c5-6e928a8510b6

	/// Historical Validated Done. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Historical Validated Done' = VAR _n=[SPO Historical Migrate Operations] RETURN IF(_n>0, COALESCE(CALCULATE([SPO Historical Reported Done], KEEPFILTERS('SPO Migration History'[Is Validated]=TRUE())),0))
		formatString: #,##0
		displayFolder: Migration\History
		lineageTag: cccd69b0-1fa7-4c57-9723-3d431bba82f9

	/// Historical Completion. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Historical Completion' = DIVIDE([SPO Historical Reported Done], [SPO Historical Migrate Operations])
		formatString: 0.0%
		displayFolder: Migration\History
		lineageTag: 71fcf770-d32e-4e50-8805-85428f5f6870

	/// Historical Removed Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Historical Removed Operations' = CALCULATE(DISTINCTCOUNT('SPO Migration History'[Operation Key]), KEEPFILTERS('SPO Migration History'[Is Latest Daily Snapshot]=TRUE()), KEEPFILTERS('SPO Migration History'[Present In Register]=FALSE()))
		formatString: #,##0
		displayFolder: Migration\History
		lineageTag: 2ca3317a-c162-4f1a-8837-72a7064cce51

