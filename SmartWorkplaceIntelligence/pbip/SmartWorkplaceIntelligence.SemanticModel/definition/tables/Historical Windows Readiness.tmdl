	column 'Loaded Batch ID'
		dataType: string
		isHidden
		lineageTag: 9ed6f679-64bf-4715-82c0-11694a319935
		sourceColumn: Loaded Batch ID

	partition 'Historical Windows Readiness' = m
		mode: import
		source =
				let
				 Readers = CreatePreparedReaders(),
				 Manifest = Readers[GetPreparedBatchManifest](),
				 Entries = List.Select(Manifest[Files], each [File] = "HistoricalWindowsReadiness.csv"),
				 Raw = if List.Count(Entries) = 0 then #table({"TenantKey","ObservationKey","Device Name","Observation UTC","Historical Result","Storage Check","Memory Check","TPM Check","Processor Check","Secure Boot Check","Manufacturer","Model","Source Files","Source SHA256","Duplicate Count","Observation Status","Match Status","Candidate Device Source ID"}, {}) else if List.Count(Entries) = 1 then Table.PromoteHeaders(Csv.Document(Readers[GetPreparedEvidenceFile]("HistoricalWindowsReadiness.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]) else error "Ambiguous historical readiness batch membership",
				 Checked = Table.SelectColumns(Raw, {"TenantKey","ObservationKey","Device Name","Observation UTC","Historical Result","Storage Check","Memory Check","TPM Check","Processor Check","Secure Boot Check","Manufacturer","Model","Source Files","Source SHA256","Duplicate Count","Observation Status","Match Status","Candidate Device Source ID"}),
				 Result = Readers[Finish](Checked)
				in Result

