/// Latest historical script observation for Windows 10 records without an exploitable Intune result; unqualified name/model matches cannot contribute to KPIs.
table 'Historical Windows Readiness'
	lineageTag: 14b32115-8fdf-4420-a613-4b73b3a6a12d

	column TenantKey
		dataType: string
		isHidden
		lineageTag: c93ba965-c945-4389-b8f7-6ad3163d53bd
