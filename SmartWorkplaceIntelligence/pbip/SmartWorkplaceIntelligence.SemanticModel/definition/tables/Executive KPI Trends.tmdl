	/// Business attribute Evidence Status.
	column 'Evidence Status'
		dataType: string
		lineageTag: b35f83bf-60f3-491a-b916-88f71e7fa117
		sourceColumn: Evidence Status

	partition 'Executive KPI Trends Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("ExecutiveKPITrends.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Date Key", "Tenant Key", "Environment Key", "Metric Name", "Metric Value", "Evidence Status"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Date Key", "Tenant Key", "Environment Key", "Metric Value"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Date Key", Int64.Type}, {"Tenant Key", Int64.Type}, {"Environment Key", Int64.Type}, {"Metric Name", type text}, {"Metric Value", type number}, {"Evidence Status", type text}}, "en-US")
				in
				    Typed

