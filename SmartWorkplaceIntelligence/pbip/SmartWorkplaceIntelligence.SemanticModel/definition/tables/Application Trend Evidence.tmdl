		formatString: #,0
		lineageTag: bcc14224-8bbb-4c74-9590-39ad24250f61
		summarizeBy: sum
		sourceColumn: Highly Fragmented Applications

		annotation SummarizationSetBy = Automatic

	column 'Installations Outside Dominant Version'
