/// History disabled in current-state-only mode. Empty compatibility schema retained for existing model dependencies.
table 'Application Trend Evidence'
	lineageTag: 3ab5c146-ffaa-4c55-88b7-3389d51b811f

	/// Weekly summed device-count observations across discovered application versions.
	measure 'Trend Application Install Observations' = SUM('Application Trend Evidence'[Application Install Observations])
		formatString: #,0
		displayFolder: Applications | Trend
		lineageTag: f7ec9cf7-8650-4e82-94e9-0996171918c0

	/// Weekly count of applications with more than one observed version.
	measure 'Trend Fragmented Applications' = SUM('Application Trend Evidence'[Fragmented Applications])
		formatString: #,0
		displayFolder: Applications | Trend
		lineageTag: 46a01163-4d9c-477b-a331-1cacaaae96ec

	/// Weekly share of application observations on each product dominant version.
	measure 'Trend Dominant Version Coverage (%)' = MAX('Application Trend Evidence'[Dominant Version Coverage (%)])
		formatString: 0.0%
		displayFolder: Applications | Trend
		lineageTag: ed8d4912-fe5d-4a48-8597-6c5169f4a806

	/// Percentage-point change in dominant-version coverage across the observed weekly history.
	measure 'Dominant Version Coverage Period Change' = VAR _FirstObservedDate = MINX(ALLSELECTED('Application Trend Evidence'[Snapshot Date]), 'Application Trend Evidence'[Snapshot Date]) VAR _LastObservedDate = MAXX(ALLSELECTED('Application Trend Evidence'[Snapshot Date]), 'Application Trend Evidence'[Snapshot Date]) VAR _FirstObservedValue = CALCULATE([Trend Dominant Version Coverage (%)], 'Application Trend Evidence'[Snapshot Date] = _FirstObservedDate) VAR _LastObservedValue = CALCULATE([Trend Dominant Version Coverage (%)], 'Application Trend Evidence'[Snapshot Date] = _LastObservedDate) RETURN IF(ISBLANK(_FirstObservedValue) || ISBLANK(_LastObservedValue), "--", FORMAT((_LastObservedValue - _FirstObservedValue) * 100, "+0.0;-0.0;0.0") & " pp")
		formatString: @
		displayFolder: Applications | Trend
		lineageTag: 1273ad15-1459-497b-97eb-aec6ff46ac1c

	column 'Snapshot Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 048dfe06-9afc-4c59-ab9d-52bcab18d9cf
		summarizeBy: none
		sourceColumn: Snapshot Date

		variation Variation
			isDefault
			relationship: 0f2508f5-3317-4474-97d9-1287acfc99a0
			defaultHierarchy: LocalDateTable_fff5b984-93b9-400c-b9b1-816638dc659b.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: 7d59a96a-736b-414d-bca5-a437a5c05f73
		summarizeBy: none
		sourceColumn: Date Key

	column 'Snapshot Week'
		dataType: string
		lineageTag: 4941edd0-f120-4911-920a-02cf0e622025
		summarizeBy: none
		sourceColumn: Snapshot Week

	column Applications
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: f7ce61fa-7cc1-44c4-8a09-d22c39c250c6
		summarizeBy: sum
		sourceColumn: Applications

		annotation SummarizationSetBy = Automatic

	column 'Application Versions'
