		summarizeBy: none
		sourceColumn: Evidence Status

	partition 'Application Trend Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("ApplicationTrendEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Snapshot Date", "Date Key", "Snapshot Week", "Applications", "Application Versions", "Publishers", "Application Install Observations", "Fragmented Applications", "Highly Fragmented Applications", "Installations Outside Dominant Version", "Long Tail Versions", "Unknown Publisher Versions", "Standardization Opportunity Rate (%)", "Dominant Version Coverage (%)", "Evidence Status"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Snapshot Date", "Date Key", "Applications", "Application Versions", "Publishers", "Application Install Observations", "Fragmented Applications", "Highly Fragmented Applications", "Installations Outside Dominant Version", "Long Tail Versions", "Unknown Publisher Versions", "Standardization Opportunity Rate (%)", "Dominant Version Coverage (%)"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Snapshot Date", type datetime}, {"Date Key", Int64.Type}, {"Snapshot Week", type text}, {"Applications", Int64.Type}, {"Application Versions", Int64.Type}, {"Publishers", Int64.Type}, {"Application Install Observations", Int64.Type}, {"Fragmented Applications", Int64.Type}, {"Highly Fragmented Applications", Int64.Type}, {"Installations Outside Dominant Version", Int64.Type}, {"Long Tail Versions", Int64.Type}, {"Unknown Publisher Versions", Int64.Type}, {"Standardization Opportunity Rate (%)", type number}, {"Dominant Version Coverage (%)", type number}, {"Evidence Status", type text}}, "en-US")
				in
				    Typed

