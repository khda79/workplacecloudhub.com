	partition 'Backup Mailbox Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("BackupMailboxEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Backup Entity Key", "Display Name", "Primary Address", "Entity Type", "Mailbox Type", "Account State", "Expected Scope State", "Protection State", "Reconciliation State", "Protection Status", "Policy Scope Group", "Protection Policy", "Error State", "Error Code", "Risk Priority", "Risk Signal", "Recommended Action", "Protection Snapshot Date", "Policy Snapshot Date", "Protection Evidence Age Days", "Policy Evidence Age Days", "Evidence Age Days", "Freshness State", "Evidence Status"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Protection Snapshot Date", "Policy Snapshot Date", "Protection Evidence Age Days", "Policy Evidence Age Days", "Evidence Age Days"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Backup Entity Key", type text}, {"Display Name", type text}, {"Primary Address", type text}, {"Entity Type", type text}, {"Mailbox Type", type text}, {"Account State", type text}, {"Expected Scope State", type text}, {"Protection State", type text}, {"Reconciliation State", type text}, {"Protection Status", type text}, {"Policy Scope Group", type text}, {"Protection Policy", type text}, {"Error State", type text}, {"Error Code", type text}, {"Risk Priority", type text}, {"Risk Signal", type text}, {"Recommended Action", type text}, {"Protection Snapshot Date", type datetime}, {"Policy Snapshot Date", type datetime}, {"Protection Evidence Age Days", Int64.Type}, {"Policy Evidence Age Days", Int64.Type}, {"Evidence Age Days", Int64.Type}, {"Freshness State", type text}, {"Evidence Status", type text}}, "en-US")
				in
				    Typed

