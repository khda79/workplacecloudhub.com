/// Private current mailbox protection and expected policy-scope reconciliation evidence. SharePoint and OneDrive protection units are observed, but their eligible policy scopes are unavailable for coverage assessment.
table 'Backup Mailbox Evidence'
	lineageTag: d4c72786-c27c-488b-8519-157ea9664749

	/// Directory members in the expected mailbox backup policy scope.
	measure 'Expected Policy Scope Members' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Expected Scope State] = "In expected scope"))
		formatString: #,0
		displayFolder: Backup | Scope
		lineageTag: 8f409a2c-0ee6-43a9-a312-620641eab591

	/// Mailbox and policy-scope reconciliation records in current private backup evidence.
	measure 'Backup Evidence Records' = COUNTROWS('Backup Mailbox Evidence')
		formatString: #,0
		displayFolder: Backup | Current
		lineageTag: d0804c1d-df37-436c-885a-a23d36f695c5

	/// Expected policy-scope members reconciled to mailbox inventory.
	measure 'Expected Mailboxes' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Expected Scope State] = "In expected scope"), KEEPFILTERS('Backup Mailbox Evidence'[Reconciliation State] <> "Scope member without mailbox"))
		formatString: #,0
		displayFolder: Backup | Scope
		lineageTag: f11c677a-4119-488a-9917-9f4de96a9175

	/// Expected mailboxes present in protected-mailbox evidence.
	measure 'Protected Expected Mailboxes' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Reconciliation State] = "Expected and protected"))
		formatString: #,0
		displayFolder: Backup | Protection
		lineageTag: a3d7ce08-9e23-405e-94f8-3fbd982f6110

	/// Expected mailboxes protected according to reconciled protection-unit evidence.
	measure 'Expected Mailboxes Protected (%)' = DIVIDE([Protected Expected Mailboxes], [Expected Mailboxes])
		formatString: 0.0%
		displayFolder: Backup | Protection
		lineageTag: 5b4b6680-876b-4556-85fb-1f8eccd4306d

	/// Expected mailboxes absent from protected-mailbox evidence.
	measure 'Expected Mailboxes Not Protected' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Reconciliation State] = "Expected not protected"))
		formatString: #,0
		displayFolder: Backup | Risk
		lineageTag: c4171ea3-3905-46ee-8d7d-3854ff397467

	/// Protected mailboxes in current private protection evidence.
	measure 'Protected Mailboxes' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Protection State] = "Protected"))
		formatString: #,0
		displayFolder: Backup | Protection
		lineageTag: ba82f794-e59b-4b44-a50f-5aabfe779e05

	/// Protected mailboxes not represented in the expected policy scope.
	measure 'Protected Outside Expected Scope' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Reconciliation State] = "Protected outside expected scope"))
		formatString: #,0
		displayFolder: Backup | Risk
		lineageTag: 5e142f04-4221-4bcc-a557-8bd8e36bef25

	/// Expected policy-scope members without a matching mailbox inventory record.
	measure 'Scope Members Without Mailbox' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Reconciliation State] = "Scope member without mailbox"))
		formatString: #,0
		displayFolder: Backup | Risk
		lineageTag: df2ff548-9f5d-4712-a2ea-b0742c0f108c

	/// Disabled directory accounts retained in the expected mailbox protection scope.
	measure 'Disabled Scope Members' = CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Expected Scope State] = "In expected scope"), KEEPFILTERS('Backup Mailbox Evidence'[Account State] = "Disabled"))
		formatString: #,0
		displayFolder: Backup | Risk
		lineageTag: ede6ae77-83c4-49fc-81c5-0b7fa2c06728

	/// Observed mailbox protection units with an error code or message.
	measure 'Protection Units With Errors' = COALESCE(CALCULATE(COUNTROWS('Backup Mailbox Evidence'), KEEPFILTERS('Backup Mailbox Evidence'[Error State] = "Error")), 0)
		formatString: #,0
		displayFolder: Backup | Health
		lineageTag: 98a9daed-d33d-494d-9840-428e4a8e66f6

	/// Mailbox protection and expected policy-scope reconciliation anomalies.
	measure 'Backup Policy Scope Anomalies' = [Expected Mailboxes Not Protected] + [Protected Outside Expected Scope] + [Scope Members Without Mailbox]
		formatString: #,0
		displayFolder: Backup | Risk
		lineageTag: 4ab0b014-36b8-43b0-bb19-b6c1c2b4f071

	/// Mailbox backup evidence sources older than 30 days.
	measure 'Stale Backup Sources' = IF(MAX('Backup Mailbox Evidence'[Protection Evidence Age Days]) > 30, 1, 0) + IF(MAX('Backup Mailbox Evidence'[Policy Evidence Age Days]) > 30, 1, 0)
		formatString: #,0
		displayFolder: Backup | Evidence
		lineageTag: 7648c732-3934-4c70-8ec3-6c649f513e91

	/// Backup workloads whose eligible policy scope is unavailable for coverage assessment: SharePoint and OneDrive.
	measure 'Backup Workload Evidence Gaps' = 2
		formatString: #,0
		displayFolder: Backup | Evidence
		lineageTag: c7c2581e-4564-4cb7-984f-d72685077cde

	/// Compact disclosure of assessed mailbox coverage, unavailable workload scopes, and evidence freshness.
	measure 'Backup Evidence Ribbon Text' = "Mailbox coverage assessed · " & FORMAT([Backup Workload Evidence Gaps], "0") & " workload scope gaps · oldest " & FORMAT(MAX('Backup Mailbox Evidence'[Evidence Age Days]), "0") & "d"
		formatString: @
		displayFolder: Backup | Evidence
		lineageTag: 02ef5bc5-a64d-4f7a-8502-c373cd15542b

	/// Backup workloads whose eligible policy scope is unavailable for coverage assessment.
	measure 'Backup Scope Assessment Gaps' = [Backup Workload Evidence Gaps]
		formatString: #,0
		displayFolder: Backup | Evidence
		lineageTag: 442ca619-7d66-46ca-943b-eb8953da73d7

