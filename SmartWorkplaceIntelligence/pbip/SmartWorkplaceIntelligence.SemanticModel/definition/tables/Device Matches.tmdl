/// One device reconciliation candidate per synthetic run.
table 'Device Matches'
	lineageTag: 9e7228c8-6a27-49c6-922d-197676ef5012

	/// Unambiguous device matches divided by eligible candidates.
	measure 'Device Reconciliation (%)' = DIVIDE(CALCULATE(COUNTROWS('Device Matches'), KEEPFILTERS('Device Matches'[Match Status] = "Matched")), COUNTROWS('Device Matches'))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 519ebbc1-53e3-42f1-a59c-e47d5aa751a6

	/// Directory device candidates matched unambiguously to device-management records divided by eligible directory device candidates.
	measure 'AD to Intune Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Device Matches'), KEEPFILTERS('Device Matches'[Match Status] = "Matched")), COUNTROWS('Device Matches'))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 2f8be0fc-e1ba-4868-b3ac-fc9f2447bfac

	/// Business attribute Date Key.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 5ce8f969-a62b-4ade-9429-ed1f395299dd
		summarizeBy: none
		sourceColumn: Date Key

	/// Business attribute Tenant Key.
	column 'Tenant Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: e542f5e5-cc75-4e09-90a8-29af083d9635
		summarizeBy: none
		sourceColumn: Tenant Key

	/// Business attribute Environment Key.
	column 'Environment Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 4e8473cf-3b16-484f-9c60-c1efbef69bc2
		summarizeBy: none
		sourceColumn: Environment Key

	/// Business attribute Device Key.
	column 'Device Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 213dfb8e-ff19-4f16-ade4-ca304db1030d
		summarizeBy: none
		sourceColumn: Device Key

	/// Business attribute Match Status.
	column 'Match Status'
		dataType: string
		lineageTag: 5857f6f0-0b60-4f76-ac36-fd98ef0a30c3
		sourceColumn: Match Status

	/// Business attribute Match Method.
	column 'Match Method'
		dataType: string
		lineageTag: cc0afe7d-3c78-4095-8b2e-052cfcb81dd5
		sourceColumn: Match Method

	/// Business attribute Candidate Count.
	column 'Candidate Count'
		dataType: int64
		lineageTag: 48a56945-9595-4e1c-b6ec-bf7258205fc3
		summarizeBy: none
		sourceColumn: Candidate Count

	/// Business attribute Evidence Status.
	column 'Evidence Status'
		dataType: string
		lineageTag: 5082439b-646e-4521-bf6a-358ed52284e6
		sourceColumn: Evidence Status

	partition 'Device Matches Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Date Key" = Int64.Type, #"Tenant Key" = Int64.Type, #"Environment Key" = Int64.Type, #"Device Key" = Int64.Type, #"Match Status" = nullable text, #"Match Method" = nullable text, #"Candidate Count" = Int64.Type, #"Evidence Status" = nullable text], {
				        {20260915, 1, 1, 1, "Matched", "DeviceId", 1, "Observed"},
				        {20260915, 1, 1, 2, "Matched", "DeviceId", 1, "Observed"},
				        {20260915, 1, 1, 3, "Unmatched", "None", 0, "Observed"},
				        {20260915, 1, 1, 4, "Conflict", "SerialAndDeviceId", 2, "Observed"}
				    })
				in
				    Source

