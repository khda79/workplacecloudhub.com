/// History disabled in current-state-only mode. Empty compatibility schema retained for existing model dependencies.
table 'Workforce Trend Evidence'
	lineageTag: d4c58804-4124-4eec-b703-2081088d13cc

	measure 'Trend Enabled Workforce Accounts' = SUM ( 'Workforce Trend Evidence'[Enabled Workforce Accounts] )
		formatString: #,0
		displayFolder: Workforce | Trend
		lineageTag: 88b698e7-9601-4c78-8515-64616cb7192b

	measure 'Trend Active Workforce' = SUM ( 'Workforce Trend Evidence'[Active Workforce] )
		formatString: #,0
		displayFolder: Workforce | Trend
		lineageTag: fa225d16-f9ff-4b39-b077-e48d6db5c691

	measure 'Trend Accounts Without Activity >30D' = SUM ( 'Workforce Trend Evidence'[Accounts Without Activity >30D] )
		formatString: #,0
		displayFolder: Workforce | Trend
		lineageTag: 1a73a5db-0110-47ab-bfa6-609bdb9371fb

	measure 'Trend Activity Evidence Coverage' = MAX ( 'Workforce Trend Evidence'[Activity Evidence Coverage] )
		formatString: 0.0%
		displayFolder: Workforce | Trend
		lineageTag: 6feb8d6d-22c0-42f1-8ca5-41b6222b6f8d

	measure 'Active Workforce Period Change' =
			VAR _FirstObservedDate = MINX ( ALLSELECTED ( 'Workforce Trend Evidence'[Snapshot Date] ), 'Workforce Trend Evidence'[Snapshot Date] )
			VAR _LastObservedDate = MAXX ( ALLSELECTED ( 'Workforce Trend Evidence'[Snapshot Date] ), 'Workforce Trend Evidence'[Snapshot Date] )
			VAR _FirstObservedValue = CALCULATE ( [Trend Active Workforce], 'Workforce Trend Evidence'[Snapshot Date] = _FirstObservedDate )
			VAR _LastObservedValue = CALCULATE ( [Trend Active Workforce], 'Workforce Trend Evidence'[Snapshot Date] = _LastObservedDate )
			RETURN DIVIDE ( _LastObservedValue - _FirstObservedValue, _FirstObservedValue )
		formatString: +0.0%;-0.0%;--
		displayFolder: Workforce | Trend
		lineageTag: 0c757835-59fd-41cf-89da-45d35afa46b3

	measure 'Trend Confirmed Human Users' = SUM ( 'Workforce Trend Evidence'[Confirmed Human Users] )
		formatString: #,0
		displayFolder: Workforce | Trend
		lineageTag: e74d4d2d-6b3c-4152-a369-e4d55cdbef45

