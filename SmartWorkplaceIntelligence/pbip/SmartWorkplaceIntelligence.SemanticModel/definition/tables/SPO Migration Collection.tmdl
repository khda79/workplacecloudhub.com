		isHidden
		lineageTag: 663dcd0d-6066-425a-b58b-9f3aa129ffde
		summarizeBy: none
		sourceColumn: Collection Key

	/// Prepared, tenant-qualified migration evidence: Source URL.
	column 'Source URL'
		dataType: string
		lineageTag: ca8798e2-f632-4a06-934d-6466c50cb4c3
		summarizeBy: none
		sourceColumn: Source URL

	/// Prepared, tenant-qualified migration evidence: Storage Bytes.
	column 'Storage Bytes'
		dataType: int64
		isHidden
		lineageTag: ccc698f1-feb5-4775-b881-9a5ff108c94b
		summarizeBy: none
		sourceColumn: Storage Bytes

	/// Prepared, tenant-qualified migration evidence: Is Fully Covered.
	column 'Is Fully Covered'
		dataType: boolean
		lineageTag: 0130edc4-1781-46aa-8bc4-7e3291d37e1e
		summarizeBy: none
		sourceColumn: Is Fully Covered

	/// Prepared, tenant-qualified migration evidence: Is Fully Migrating.
	column 'Is Fully Migrating'
		dataType: boolean
		lineageTag: 710bcf9a-f128-4609-8ea2-b7206c5d8ddf
		summarizeBy: none
		sourceColumn: Is Fully Migrating

	/// Prepared, tenant-qualified migration evidence: Captured UTC.
	column 'Captured UTC'
		dataType: dateTime
		isHidden
		formatString: yyyy-MM-dd HH:mm
		lineageTag: 09696770-e8d0-4637-bae8-df77b93aa504
		summarizeBy: none
		sourceColumn: Captured UTC

	/// Prepared, tenant-qualified migration evidence: Run ID.
	column 'Run ID'
		dataType: string
		isHidden
		lineageTag: e91103e5-dd48-4c4d-a419-c5c14e059550
		summarizeBy: none
		sourceColumn: Run ID

	column 'Project Identity'
		dataType: string
		isHidden
		lineageTag: a092839c-8b14-4cf5-9cf8-b99b88eae676
		sourceColumn: Project Identity

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 137dd5bd-b4ea-420e-9b9a-729e983cce45
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'SPO Migration Collection' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Source = GetSharePointMigrationEvidence("SharePointMigrationCollectionEvidence.csv", {{"TenantKey", type text}, {"Project Key", type text}, {"Snapshot ID", type text}, {"Snapshot Date", type date}, {"Collection Key", type text}, {"Source URL", type text}, {"Storage Bytes", Int64.Type}, {"Is Fully Covered", type logical}, {"Is Fully Migrating", type logical}, {"Captured UTC", type datetime}, {"Run ID", type text}}),
				    Identity = Table.AddColumn(Source, "Project Identity", each Binary.ToText(Json.FromValue({[TenantKey], [Project Key]}), BinaryEncoding.Base64), type text),
				    Categories = Table.TransformColumns(Identity, List.Transform(List.Intersect({{"Business Unit", "Phase"}, Table.ColumnNames(Identity)}), (c) => {c, each if _ = null then "(Unspecified)" else _, type text}))
				in Categories)
				in
				    Readers[Finish](BusinessRows)
