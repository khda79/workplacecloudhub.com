/// SPO means SharePoint Online. Grain: Collection Key; source: one selected immutable prepared batch.
table 'SPO Migration Collection'
	lineageTag: e6b29884-347b-46ce-a546-e7e900e228b2

	/// Current Collection Storage GiB. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Current Collection Storage GiB' =
			VAR _keys=VALUES('SPO Migration Scope'[Collection Key])
			RETURN IF(SELECTEDVALUE('SPO Migration Source Type'[Source Type])<>"Shared folders",
			DIVIDE(CALCULATE(SUM('SPO Migration Collection'[Storage Bytes]), TREATAS(_keys, 'SPO Migration Collection'[Collection Key])),POWER(1024,3)))
		formatString: 0.0
		displayFolder: Migration\Volumes
		lineageTag: a0d51b14-ceda-4aa3-bdfe-c718b64a7b47

	/// Fully Qualified Migrating GiB. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Fully Qualified Migrating GiB' =
			VAR _collections=VALUES('SPO Migration Scope'[Collection Key])
			VAR _eligible=CALCULATE(COUNTROWS('SPO Migration Collection'), KEEPFILTERS('SPO Migration Collection'[Is Fully Migrating]=TRUE()), TREATAS(_collections, 'SPO Migration Collection'[Collection Key]))
			RETURN IF(_eligible>0 && SELECTEDVALUE('SPO Migration Source Type'[Source Type])<>"Shared folders",
			DIVIDE(CALCULATE(SUM('SPO Migration Collection'[Storage Bytes]), KEEPFILTERS('SPO Migration Collection'[Is Fully Migrating]=TRUE()),TREATAS(_collections,'SPO Migration Collection'[Collection Key])),POWER(1024,3)))
		formatString: 0.0
		displayFolder: Migration\Volumes
		lineageTag: b85df497-6622-42cc-a14f-c3a732edc3d0

	/// Volume Context. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Volume Context' = IF(ISBLANK([SPO Fully Qualified Migrating GiB]),"Not measurable: complete migration scope is not qualified", "Current source storage in fully qualified scope; not transferred bytes")
		formatString: General
		displayFolder: Migration\Volumes
		lineageTag: 758ee064-d55a-4610-bdfb-e59bee4a9f38

	/// Prepared, tenant-qualified migration evidence: TenantKey.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: 22be40f8-a80a-4729-af91-bcacebef7888
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared, tenant-qualified migration evidence: Project Key.
	column 'Project Key'
		dataType: string
		isHidden
		lineageTag: f8ff7637-1ffb-4de6-90f1-5ae6d6f28e2b
		summarizeBy: none
		sourceColumn: Project Key

	/// Prepared, tenant-qualified migration evidence: Snapshot ID.
	column 'Snapshot ID'
		dataType: string
		isHidden
		lineageTag: d1ca278d-6fa9-4c18-87bd-19763b3fc331
		summarizeBy: none
		sourceColumn: Snapshot ID

	/// Prepared, tenant-qualified migration evidence: Snapshot Date.
	column 'Snapshot Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: ea2e217c-2c27-428d-a0f4-dd745c0d9aa4
		summarizeBy: none
		sourceColumn: Snapshot Date

	/// Prepared, tenant-qualified migration evidence: Collection Key.
	column 'Collection Key'
