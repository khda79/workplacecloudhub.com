/// Current private tenant license capacity and assignment evidence. Capacity KPIs exclude non-finite, free, trial, viral, and tenant-wide placeholder entitlements.
table 'License Evidence'
	lineageTag: 0e6b7ab3-2bd8-4c0e-b0c3-898abfa29bb1

	measure 'License Products' = COUNTROWS('License Evidence')
		formatString: #,0
		displayFolder: Licensing | Inventory
		lineageTag: 9f42d3b4-15a8-4d5f-9d8e-f8b8b9a2d0c1

	measure 'Governed License Products' = CALCULATE([License Products], KEEPFILTERS('License Evidence'[Capacity Class] = "Governed capacity"))
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 2d97f474-1d41-48de-868e-7232cdb71df4

	measure 'Enabled License Units' = CALCULATE(SUM('License Evidence'[Enabled Units]), KEEPFILTERS('License Evidence'[Capacity Class] = "Governed capacity"))
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 6b417ad3-18c2-460f-8a78-2ed4c342eebf

	measure 'Consumed License Units' = CALCULATE(SUM('License Evidence'[Consumed Units]), KEEPFILTERS('License Evidence'[Capacity Class] = "Governed capacity"))
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 88188bf9-f058-4181-a05d-0da79aa7b18e

	measure 'Available License Units' = CALCULATE(SUM('License Evidence'[Available Units]), KEEPFILTERS('License Evidence'[Capacity Class] = "Governed capacity"))
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 66847c47-61cc-4a7b-850d-18817be7e756

	measure 'Observed License Capacity Utilization (%)' = DIVIDE([Consumed License Units], [Enabled License Units])
		formatString: 0.0%
		displayFolder: Licensing | Capacity
		lineageTag: 3a34d8d2-c7b8-455f-a8d9-79ea4608c67d

	measure 'Observed Potentially Reclaimable Assignments' = SUM('License Evidence'[Potentially Reclaimable Assignments])
		formatString: #,0
		displayFolder: Licensing | Optimization
		lineageTag: c63d9d98-46cf-42d2-a7bc-119688956a6d

	measure 'Observed Dormant 31-90D Assignments' = SUM('License Evidence'[Dormant 31-90D Assignments])
		formatString: #,0
		displayFolder: Licensing | Optimization
		lineageTag: 9a24b2f7-bdec-4c3f-ae5a-58e2d00baf8a

	measure 'Underused Governed License Products' = CALCULATE([License Products], KEEPFILTERS('License Evidence'[Capacity Class] = "Governed capacity"), KEEPFILTERS('License Evidence'[Capacity Utilization] < 0.5))
		formatString: #,0
		displayFolder: Licensing | Optimization
		lineageTag: 90ac5acb-10d2-444e-b9ef-c0c1fdb0a5c9

	measure 'License Evidence Ribbon Text' = FORMAT([Governed License Products], "0") & " governed products · " & FORMAT([Observed License Capacity Utilization (%)], "0.0%") & " used · " & FORMAT([Observed Potentially Reclaimable Assignments], "#,0") & " reclaim candidates"
		formatString: @
		displayFolder: Licensing | Evidence
		lineageTag: 5cc9d953-acbb-48a8-8b10-4d89b40d489c

	measure 'Microsoft 365 Enabled Units' = CALCULATE ( SUM ( 'License Evidence'[Enabled Units] ), 'License Evidence'[Microsoft 365 Plan] IN { "F3", "E3", "E5" } )
		formatString: #,0
		displayFolder: Licensing | Microsoft 365
		lineageTag: ab61b7ea-fd17-44be-ae46-1146b1873f37

	measure 'Microsoft 365 Consumed Units' = CALCULATE ( SUM ( 'License Evidence'[Consumed Units] ), 'License Evidence'[Microsoft 365 Plan] IN { "F3", "E3", "E5" } )
		formatString: #,0
		displayFolder: Licensing | Microsoft 365
		lineageTag: 6d8a72ff-af96-41b2-919a-6ac54186e1bf

	measure 'Microsoft 365 Utilization (%)' = DIVIDE ( [Microsoft 365 Consumed Units], [Microsoft 365 Enabled Units] )
		formatString: 0.0%
		displayFolder: Licensing | Microsoft 365
		lineageTag: b0f195fe-ac36-448f-829b-a771e63b659b

	measure 'F3 Reclaimable Assignments' = COALESCE ( CALCULATE ( SUM ( 'License Evidence'[Potentially Reclaimable Assignments] ), 'License Evidence'[Microsoft 365 Plan] = "F3" ), 0 )
		formatString: #,0
		displayFolder: Licensing | Microsoft 365
		lineageTag: fa70c748-4552-4812-9db4-1f3121f9d86a

	measure 'E3 Reclaimable Assignments' = COALESCE ( CALCULATE ( SUM ( 'License Evidence'[Potentially Reclaimable Assignments] ), 'License Evidence'[Microsoft 365 Plan] = "E3" ), 0 )
		formatString: #,0
		displayFolder: Licensing | Microsoft 365
		lineageTag: b4e25a48-7dbf-4f6e-99b6-0c500e5872ba

	measure 'E5 Reclaimable Assignments' = COALESCE ( CALCULATE ( SUM ( 'License Evidence'[Potentially Reclaimable Assignments] ), 'License Evidence'[Microsoft 365 Plan] = "E5" ), 0 )
		formatString: #,0
		displayFolder: Licensing | Microsoft 365
		lineageTag: 539b6d11-7c27-4596-95fe-e14926d88bdb

	measure 'E3 to F3 Review Candidates' = SUM ( 'License Evidence'[E3 to F3 Review Candidate Assignments] )
		formatString: #,0
		displayFolder: Licensing | Optimization
		lineageTag: 326209b1-71ea-4ff6-bdcb-6887d8a4a9df

	measure 'Immediate Reclaimable Assignments' = SUM ( 'License Evidence'[Potentially Reclaimable Assignments] )
		formatString: #,0
		displayFolder: Licensing | Optimization
		lineageTag: 6f5d6136-4e81-46df-b2e8-c7a4d3c07ec6

	measure 'Dormant 31-90D Review Assignments' = SUM ( 'License Evidence'[Dormant 31-90D Assignments] )
		formatString: #,0
		displayFolder: Licensing | Optimization
		lineageTag: 08b1ab40-08c0-4939-a551-c52424a0c7cd

