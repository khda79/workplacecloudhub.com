	partition 'License Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("LicenseEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"License Product", "SKU Part Number", "Capacity Class", "Enabled Units", "Consumed Units", "Available Units", "Capacity Utilization", "Assigned Users", "Direct Assignments", "Group Assignments", "Direct and Group Assignments", "Potentially Reclaimable Assignments", "Dormant 31-90D Assignments", "Risk Priority", "Risk Signal", "Recommended Action", "Snapshot Date", "Evidence Status", "Microsoft 365 Plan", "Disabled Reclaimable Assignments", "E3 to F3 Review Candidates"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Enabled Units", "Consumed Units", "Available Units", "Capacity Utilization", "Assigned Users", "Direct Assignments", "Group Assignments", "Direct and Group Assignments", "Potentially Reclaimable Assignments", "Dormant 31-90D Assignments", "Snapshot Date", "Disabled Reclaimable Assignments", "E3 to F3 Review Candidates"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"License Product", type text}, {"SKU Part Number", type text}, {"Capacity Class", type text}, {"Enabled Units", Int64.Type}, {"Consumed Units", Int64.Type}, {"Available Units", Int64.Type}, {"Capacity Utilization", type number}, {"Assigned Users", Int64.Type}, {"Direct Assignments", Int64.Type}, {"Group Assignments", Int64.Type}, {"Direct and Group Assignments", Int64.Type}, {"Potentially Reclaimable Assignments", Int64.Type}, {"Dormant 31-90D Assignments", Int64.Type}, {"Risk Priority", type text}, {"Risk Signal", type text}, {"Recommended Action", type text}, {"Snapshot Date", type datetime}, {"Evidence Status", type text}, {"Microsoft 365 Plan", type text}, {"Disabled Reclaimable Assignments", Int64.Type}, {"E3 to F3 Review Candidates", Int64.Type}}, "en-US")
				in
				    Typed

