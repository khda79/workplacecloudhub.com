/// Accepted user activity observations.
table 'User Activities'
	lineageTag: a96dafaf-12c0-4fe7-aec8-f15e8d6b0582

	/// Users with accepted activity evidence divided by qualified users.
	measure 'Activity Evidence Coverage (%)' = DIVIDE(DISTINCTCOUNT('User Activities'[User Key]), [# Users])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 464da633-082a-4a7e-bab5-fb6f8f32af54

	/// Accepted user activity observations.
	measure '# User Activity Signals' = COUNTROWS('User Activities')
		formatString: #,0
		displayFolder: Measures
		lineageTag: 719e9bea-4a9a-4178-a162-37e0e6f3588c

	/// Distinct enabled active-workforce users assigned an eligible Microsoft 365 F1, F3, E3, E5, or E7 license at the latest accepted activity date.
	measure '# M365 Eligible Active Workforce' = VAR _asOf = CALCULATE(MAX('User Activities'[Activity Date UTC]), KEEPFILTERS('User Activities'[Activity Signal] = "ActiveUse"), KEEPFILTERS('User Activities'[Evidence Status] = "Observed"), KEEPFILTERS('Service'[Service Name] IN {"Teams", "Meetings", "Mailbox", "SharePoint", "OneDrive"})) VAR _asOfKey = IF(ISBLANK(_asOf), BLANK(), YEAR(_asOf) * 10000 + MONTH(_asOf) * 100 + DAY(_asOf)) VAR _userSnapshotKey = CALCULATE(MAX('User Snapshots'[Date Key]), REMOVEFILTERS('Date'), 'User Snapshots'[Date Key] <= _asOfKey) VAR _licenseSnapshotKey = CALCULATE(MAX('User License Assignments'[Date Key]), REMOVEFILTERS('Date'), 'User License Assignments'[Date Key] <= _asOfKey) VAR _licensedUsers = CALCULATETABLE(VALUES('User License Assignments'[User Key]), REMOVEFILTERS('Date'), TREATAS({_licenseSnapshotKey}, 'User License Assignments'[Date Key]), KEEPFILTERS('User License Assignments'[Assignment State] = "Assigned"), KEEPFILTERS('User License Assignments'[Approved Exclusion] = FALSE()), KEEPFILTERS('License Product'[License Family] IN {"Workplace Suite", "Frontline Suite", "Microsoft 365"}), KEEPFILTERS(RIGHT('License Product'[License Product], 2) IN {"F1", "F3", "E3", "E5", "E7"})) RETURN IF(ISBLANK(_asOf), BLANK(), CALCULATE(DISTINCTCOUNT('User Snapshots'[User Key]), REMOVEFILTERS('Date'), TREATAS({_userSnapshotKey}, 'User Snapshots'[Date Key]), KEEPFILTERS('User Snapshots'[Account State] = "Enabled"), KEEPFILTERS('User Snapshots'[Workforce Status] = "Active"), KEEPFILTERS('User Snapshots'[Activity Evidence Status] = "Observed"), TREATAS(_licensedUsers, 'User Snapshots'[User Key])))
		formatString: #,0
		displayFolder: Measures
		lineageTag: b3f33710-c961-4ba0-a792-878580fc79f9

	/// Distinct eligible active-workforce users with at least one qualified Microsoft 365 ActiveUse signal in the trailing 30 days, counted once.
	measure '# M365 Active Users (30D)' = VAR _asOf = CALCULATE(MAX('User Activities'[Activity Date UTC]), KEEPFILTERS('User Activities'[Activity Signal] = "ActiveUse"), KEEPFILTERS('User Activities'[Evidence Status] = "Observed"), KEEPFILTERS('Service'[Service Name] IN {"Teams", "Meetings", "Mailbox", "SharePoint", "OneDrive"})) VAR _asOfKey = IF(ISBLANK(_asOf), BLANK(), YEAR(_asOf) * 10000 + MONTH(_asOf) * 100 + DAY(_asOf)) VAR _userSnapshotKey = CALCULATE(MAX('User Snapshots'[Date Key]), REMOVEFILTERS('Date'), 'User Snapshots'[Date Key] <= _asOfKey) VAR _licenseSnapshotKey = CALCULATE(MAX('User License Assignments'[Date Key]), REMOVEFILTERS('Date'), 'User License Assignments'[Date Key] <= _asOfKey) VAR _licensedUsers = CALCULATETABLE(VALUES('User License Assignments'[User Key]), REMOVEFILTERS('Date'), TREATAS({_licenseSnapshotKey}, 'User License Assignments'[Date Key]), KEEPFILTERS('User License Assignments'[Assignment State] = "Assigned"), KEEPFILTERS('User License Assignments'[Approved Exclusion] = FALSE()), KEEPFILTERS('License Product'[License Family] IN {"Workplace Suite", "Frontline Suite", "Microsoft 365"}), KEEPFILTERS(RIGHT('License Product'[License Product], 2) IN {"F1", "F3", "E3", "E5", "E7"})) VAR _eligibleUsers = CALCULATETABLE(VALUES('User Snapshots'[User Key]), REMOVEFILTERS('Date'), TREATAS({_userSnapshotKey}, 'User Snapshots'[Date Key]), KEEPFILTERS('User Snapshots'[Account State] = "Enabled"), KEEPFILTERS('User Snapshots'[Workforce Status] = "Active"), KEEPFILTERS('User Snapshots'[Activity Evidence Status] = "Observed"), TREATAS(_licensedUsers, 'User Snapshots'[User Key])) RETURN IF(ISBLANK(_asOf), BLANK(), CALCULATE(DISTINCTCOUNT('User Activities'[User Key]), REMOVEFILTERS('Date'), KEEPFILTERS('User Activities'[Activity Date UTC] > _asOf - 30), KEEPFILTERS('User Activities'[Activity Date UTC] <= _asOf), KEEPFILTERS('User Activities'[Activity Signal] = "ActiveUse"), KEEPFILTERS('User Activities'[Evidence Status] = "Observed"), KEEPFILTERS('Service'[Service Name] IN {"Teams", "Meetings", "Mailbox", "SharePoint", "OneDrive"}), TREATAS(_eligibleUsers, 'User Activities'[User Key])))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 39eff002-b292-4274-a178-b67134a41486

	/// Distinct eligible active-workforce users with qualified Teams, Exchange Online, SharePoint Online, or OneDrive for Business use in the trailing 30 days divided by the eligible active workforce; Meetings is folded into Teams.
	measure 'M365 Active Use (30D) (%)' = DIVIDE([# M365 Active Users (30D)], [# M365 Eligible Active Workforce])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: d4ce99b2-f3f4-4e0a-b156-f916806aff8e

	/// Evidence status for the 30-day Microsoft 365 active-use KPI.
	measure 'M365 Active Use Evidence Status' = VAR _eligible = [# M365 Eligible Active Workforce] VAR _active = [# M365 Active Users (30D)] RETURN IF(ISBLANK(_eligible), "Not Collected", IF(ISBLANK(_active), "Partial", "Observed"))
		formatString: @
		displayFolder: Measures
		lineageTag: b9ae739e-ff69-4017-8876-fe8c42f7f287

