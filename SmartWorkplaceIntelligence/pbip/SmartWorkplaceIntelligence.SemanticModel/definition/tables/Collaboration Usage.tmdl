/// Synthetic collaboration service usage.
table 'Collaboration Usage'
	lineageTag: ad1b3e85-f817-43ec-9e6b-baa9a515a900

	/// Qualified active users divided by eligible users for the selected service.
	measure 'Service Active User (%)' = DIVIDE(SUM('Collaboration Usage'[Active User Count]), SUM('Collaboration Usage'[Eligible User Count]))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 92cc48d8-17ef-485f-b12a-8e693a8f9e15

	/// Governed collaboration objects in scope.
	measure '# Service Objects' = SUM('Collaboration Usage'[Object Count])
		formatString: #,0
		displayFolder: Measures
		lineageTag: dc9fda69-0574-4025-8140-f0da0d0b49bb

	/// Qualified active Teams users divided by eligible Teams users.
	measure 'Teams Active User (%)' = CALCULATE([Service Active User (%)], KEEPFILTERS('Service'[Service Name] = "Teams"))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 71e68ee0-b86e-4812-bd4c-1c0cac78c591

	/// Latest accepted usage period in the visible collaboration scope.
	measure 'Latest Usage Period' = FORMAT(MAXX('Collaboration Usage', RELATED('Date'[Date])), "yyyy-MM")
		formatString: @
		displayFolder: Measures
		lineageTag: fba375e9-cc96-4d8b-89ef-6d0650946ba8

	/// Business attribute Date Key.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: 18d51d8c-2072-4a6a-9ec8-781d1f3dd501
		summarizeBy: none
		sourceColumn: Date Key

