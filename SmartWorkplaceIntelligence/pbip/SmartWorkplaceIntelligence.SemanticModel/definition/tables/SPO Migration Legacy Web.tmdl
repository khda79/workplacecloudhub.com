		sourceColumn: Legacy Collection Key

	/// Prepared, tenant-qualified migration evidence: Source URL.
	column 'Source URL'
		dataType: string
		lineageTag: 83c672bb-788b-4c28-b722-1c4391aa6906
		summarizeBy: none
		sourceColumn: Source URL

	/// Prepared, tenant-qualified migration evidence: Source Name.
	column 'Source Name'
		dataType: string
		lineageTag: 1c4fbea3-be3a-4e95-873b-47f976f5099c
		summarizeBy: none
		sourceColumn: Source Name

	column 'Project Identity'
		dataType: string
		isHidden
		lineageTag: 136af0fd-e322-47f4-804d-8839a23e583c
		summarizeBy: none
		sourceColumn: Project Identity

		annotation SummarizationSetBy = Automatic

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 9168cee1-79bf-43d1-bfb5-f0b79caaed47
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'SPO Migration Legacy Web' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Source = GetSharePointMigrationEvidence("SharePointMigrationLegacyWebEvidence.csv", {{"TenantKey", type text}, {"Project Key", type text}, {"Snapshot ID", type text}, {"Snapshot Date", type date}, {"Legacy Key", type text}, {"Legacy ID", type text}, {"Legacy Collection Key", type text}, {"Source URL", type text}, {"Source Name", type text}}),
				    Identity = Table.AddColumn(Source, "Project Identity", each Binary.ToText(Json.FromValue({[TenantKey], [Project Key]}), BinaryEncoding.Base64), type text),
				    Categories = Table.TransformColumns(Identity, List.Transform(List.Intersect({{"Business Unit", "Phase"}, Table.ColumnNames(Identity)}), (c) => {c, each if _ = null then "(Unspecified)" else _, type text}))
				in Categories)
				in
				    Readers[Finish](BusinessRows)
