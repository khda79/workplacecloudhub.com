/// SPO means SharePoint Online. Grain: Legacy Key; source: one selected immutable prepared batch.
table 'SPO Migration Legacy Web'
	isHidden
	lineageTag: 928eef13-1ee6-4042-8ffd-35d48f395faa

	/// Prepared, tenant-qualified migration evidence: TenantKey.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: ba752859-327c-4f25-9eec-f7f195a0bf6e
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared, tenant-qualified migration evidence: Project Key.
	column 'Project Key'
		dataType: string
		isHidden
		lineageTag: 451c565b-3b90-4783-8fe7-b10757e6042f
		summarizeBy: none
		sourceColumn: Project Key

	/// Prepared, tenant-qualified migration evidence: Snapshot ID.
	column 'Snapshot ID'
		dataType: string
		isHidden
		lineageTag: ed9b32b7-c2a8-43cd-84c3-daa2bcd49923
		summarizeBy: none
		sourceColumn: Snapshot ID

	/// Prepared, tenant-qualified migration evidence: Snapshot Date.
	column 'Snapshot Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: e6a8cb15-9958-462d-95f2-def86c7c84a3
		summarizeBy: none
		sourceColumn: Snapshot Date

		variation Variation
			isDefault
			relationship: 632dd022-5b8a-415c-be33-6192a9a8ef6c
			defaultHierarchy: LocalDateTable_d2e80d94-adc2-414c-8fa9-39bef439df3d.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	/// Prepared, tenant-qualified migration evidence: Legacy Key.
	column 'Legacy Key'
		dataType: string
		isHidden
		lineageTag: 7ac3d177-fae0-4184-945b-939e86e1fb70
		summarizeBy: none
		sourceColumn: Legacy Key

	/// Prepared, tenant-qualified migration evidence: Legacy ID.
	column 'Legacy ID'
		dataType: string
		lineageTag: 8d10771e-1f88-40fd-823e-9188b2425675
		summarizeBy: none
		sourceColumn: Legacy ID

	/// Prepared, tenant-qualified migration evidence: Legacy Collection Key.
	column 'Legacy Collection Key'
