/// History disabled in current-state-only mode. Empty compatibility schema retained for existing model dependencies.
table 'Collaboration Trend Evidence'
	lineageTag: c9714337-06cf-4d24-8d91-d4499d9ad95a

	/// Weekly share of objects active in the last 30 days.
	measure 'Trend Active Object Rate (%)' = DIVIDE(SUM('Collaboration Trend Evidence'[Active Objects 30D]), SUM('Collaboration Trend Evidence'[Total Objects]))
		formatString: 0.0%
		displayFolder: Collaboration | Trend
		lineageTag: 15952f36-b27b-421c-a86f-146bfc6cef17

	/// Weekly thirty-day active-user rate where user history exists.
	measure 'Trend Adoption Rate (%)' = DIVIDE(SUM('Collaboration Trend Evidence'[Active Users 30D]), SUM('Collaboration Trend Evidence'[Eligible Users]))
		formatString: 0.0%
		displayFolder: Collaboration | Trend
		lineageTag: fcf3f4ed-1c7d-4bd5-92a2-41427afe3a1c

	/// Weekly collaboration-object count.
	measure 'Trend Collaboration Objects' = SUM('Collaboration Trend Evidence'[Total Objects])
		formatString: #,0
		displayFolder: Collaboration | Trend
		lineageTag: 022f6dae-a013-4635-beb7-a3e3cd4c3c94

	/// Percentage-point change in the consolidated active-object rate between the first and last selected observed weeks.
	measure 'Active Object Rate Period Change' = VAR _FirstWeek = MINX(ALLSELECTED('Collaboration Trend Evidence'[Snapshot Week]), 'Collaboration Trend Evidence'[Snapshot Week]) VAR _LastWeek = MAXX(ALLSELECTED('Collaboration Trend Evidence'[Snapshot Week]), 'Collaboration Trend Evidence'[Snapshot Week]) VAR _First = CALCULATE([Trend Active Object Rate (%)], REMOVEFILTERS('Collaboration Trend Evidence'[Snapshot Week]), 'Collaboration Trend Evidence'[Snapshot Week] = _FirstWeek) VAR _Last = CALCULATE([Trend Active Object Rate (%)], REMOVEFILTERS('Collaboration Trend Evidence'[Snapshot Week]), 'Collaboration Trend Evidence'[Snapshot Week] = _LastWeek) RETURN IF(ISBLANK(_First) || ISBLANK(_Last), "--", FORMAT((_Last - _First) * 100, "+0.0;-0.0;0.0") & " pp")
		formatString: @
		displayFolder: Collaboration | Trend
		lineageTag: 694d582c-ca1d-4973-8bbf-7175a8c363f8

	column 'Snapshot Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 2dfe1dbf-149b-461f-b632-fd68a2420de1
		summarizeBy: none
		sourceColumn: Snapshot Date

		variation Variation
			isDefault
			relationship: 0741e885-869b-471d-916d-7ca9dc4e235b
			defaultHierarchy: LocalDateTable_23ebdc86-a087-40cc-9e59-977a41aaba93.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	column 'Date Key'
