	partition 'Collaboration Trend Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("CollaborationTrendEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Snapshot Date", "Date Key", "Snapshot Week", "Service", "Total Objects", "Active Objects 30D", "Inactive Objects", "Orphaned Objects", "Eligible Users", "Active Users 30D", "Adoption Rate (%)", "Evidence Status"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Snapshot Date", "Date Key", "Total Objects", "Active Objects 30D", "Inactive Objects", "Orphaned Objects", "Eligible Users", "Active Users 30D", "Adoption Rate (%)"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Snapshot Date", type datetime}, {"Date Key", Int64.Type}, {"Snapshot Week", type text}, {"Service", type text}, {"Total Objects", Int64.Type}, {"Active Objects 30D", Int64.Type}, {"Inactive Objects", Int64.Type}, {"Orphaned Objects", Int64.Type}, {"Eligible Users", Int64.Type}, {"Active Users 30D", Int64.Type}, {"Adoption Rate (%)", type number}, {"Evidence Status", type text}}, "en-US")
				in
				    Typed

