/// History disabled in current-state-only mode. Empty compatibility schema retained for existing model dependencies.
table 'User Activity History Evidence'
	lineageTag: c16b5f47-d55c-4328-ad87-f4602ccded60

	measure 'Historical Enabled Workforce Accounts' = DISTINCTCOUNT ( 'User Activity History Evidence'[User Source ID] )
		formatString: #,0
		displayFolder: Workforce | History
		lineageTag: 93e5e0bb-1bf0-4023-97d7-4869add55f1c

	measure 'Historical Active Workforce' = CALCULATE ( [Historical Enabled Workforce Accounts], 'User Activity History Evidence'[Activity State] = "Active <=30D" )
		formatString: #,0
		displayFolder: Workforce | History
		lineageTag: 0dd11786-5a8d-4ac0-9d90-6fc425b5c4c6

	measure 'Historical Activity Covered Users' = CALCULATE ( [Historical Enabled Workforce Accounts], 'User Activity History Evidence'[Activity Evidence Status] = "Observed" )
		formatString: #,0
		displayFolder: Workforce | History
		lineageTag: 83e88106-722b-4caa-88b4-f620ded7103a

	measure 'Historical Activity Evidence Coverage' = DIVIDE ( [Historical Activity Covered Users], [Historical Enabled Workforce Accounts] )
		formatString: 0.0%
		displayFolder: Workforce | History
		lineageTag: 470d3327-0785-42f2-842a-39a0ee7e491b

	measure 'Historical Accounts Without Activity >30D' = CALCULATE ( [Historical Enabled Workforce Accounts], 'User Activity History Evidence'[Activity State] IN { "Dormant 31-90D", "Stale >90D", "Observed never used" } )
		formatString: #,0
		displayFolder: Workforce | History
		lineageTag: c9743bb0-5906-4745-af0a-90185ce54e61

	measure 'Days Since Last Workforce Activity' = MAX ( 'User Activity History Evidence'[Days Since Last Activity] )
		formatString: #,0
		displayFolder: Workforce | History
		lineageTag: 9e606637-804b-42fa-ae12-114ab5eb9127

	/// Change in selected-scope active workforce between the first and last observed weekly activity snapshots.
	measure 'Historical Active Workforce Period Change' =
			VAR _FirstObservedDate = MINX ( ALLSELECTED ( 'User Activity History Evidence'[Snapshot Date] ), 'User Activity History Evidence'[Snapshot Date] )
			VAR _LastObservedDate = MAXX ( ALLSELECTED ( 'User Activity History Evidence'[Snapshot Date] ), 'User Activity History Evidence'[Snapshot Date] )
			VAR _FirstObservedValue = CALCULATE ( [Historical Active Workforce], 'User Activity History Evidence'[Snapshot Date] = _FirstObservedDate )
			VAR _LastObservedValue = CALCULATE ( [Historical Active Workforce], 'User Activity History Evidence'[Snapshot Date] = _LastObservedDate )
			RETURN DIVIDE ( _LastObservedValue - _FirstObservedValue, _FirstObservedValue )
		formatString: +0.0%;-0.0%;--
		displayFolder: Workforce | History
		lineageTag: 54bb2625-6169-4da0-a714-dbc86af15e92

	column 'Snapshot Date'
		dataType: dateTime
