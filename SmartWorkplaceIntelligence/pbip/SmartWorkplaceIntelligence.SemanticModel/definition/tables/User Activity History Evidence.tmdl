	partition 'User Activity History Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("UserActivityHistoryEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Snapshot Date", "Date Key", "Week Label", "User Source ID", "Activity State", "Activity Evidence Status", "Days Since Last Activity", "Last Activity Date", "AD Last Activity Date", "M365 Last Activity Date", "Activity Source", "User Principal Name", "Confirmed Human"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Snapshot Date", "Date Key", "Days Since Last Activity", "Last Activity Date", "AD Last Activity Date", "M365 Last Activity Date", "Confirmed Human"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Snapshot Date", type datetime}, {"Date Key", Int64.Type}, {"Week Label", type text}, {"User Source ID", type text}, {"Activity State", type text}, {"Activity Evidence Status", type text}, {"Days Since Last Activity", Int64.Type}, {"Last Activity Date", type datetime}, {"AD Last Activity Date", type datetime}, {"M365 Last Activity Date", type datetime}, {"Activity Source", type text}, {"User Principal Name", type text}, {"Confirmed Human", type logical}}, "en-US")
				in
				    Typed

