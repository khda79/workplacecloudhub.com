/// One row per Exchange server in the selected batch's Health Checker summary, or one explicit unknown marker when the summary was not captured. Selected immutable batch only. Health Checker results describe the servers it processed; a server that did not complete is unmeasured, never healthy. Values that can reveal host names, addresses, certificates or domains are masked at collection. Disconnected: geographical and attribute filters do not apply.
table 'Exchange Health Checker Servers'
	lineageTag: 4e5a5e6f-06bd-5c1b-9d89-e17d930161a5

	/// Selected immutable batch only. Health Checker results describe the servers it processed; a server that did not complete is unmeasured, never healthy. Values that can reveal host names, addresses, certificates or domains are masked at collection.
	measure 'Exchange Health Checker Servers Total' = VAR _n=CALCULATE(COUNTROWS('Exchange Health Checker Servers'),KEEPFILTERS('Exchange Health Checker Servers'[Is Server]=TRUE())) RETURN IF(_n>0,_n)
		formatString: #,0
		displayFolder: Health Checker

	/// Selected immutable batch only. Health Checker results describe the servers it processed; a server that did not complete is unmeasured, never healthy. Values that can reveal host names, addresses, certificates or domains are masked at collection.
	measure 'Exchange Health Checker Servers Processed' = IF(NOT ISBLANK([Exchange Health Checker Servers Total]),COALESCE(CALCULATE(COUNTROWS('Exchange Health Checker Servers'),KEEPFILTERS('Exchange Health Checker Servers'[Is Server]=TRUE()),KEEPFILTERS('Exchange Health Checker Servers'[Run Status]="Completed")),0))
		formatString: #,0
		displayFolder: Health Checker

	/// Selected immutable batch only. Health Checker results describe the servers it processed; a server that did not complete is unmeasured, never healthy. Values that can reveal host names, addresses, certificates or domains are masked at collection.
	measure 'Exchange Health Checker Vulnerabilities' = IF([Exchange Health Checker Servers Processed]>0,CALCULATE(SUM('Exchange Health Checker Servers'[Vulnerability Count]),KEEPFILTERS('Exchange Health Checker Servers'[Is Server]=TRUE()),KEEPFILTERS('Exchange Health Checker Servers'[Run Status]="Completed")))
		formatString: #,0
		displayFolder: Health Checker

	/// Selected immutable batch only. Health Checker results describe the servers it processed; a server that did not complete is unmeasured, never healthy. Values that can reveal host names, addresses, certificates or domains are masked at collection.
	measure 'Exchange Health Checker Errors' = IF([Exchange Health Checker Servers Processed]>0,CALCULATE(SUM('Exchange Health Checker Servers'[Error Count]),KEEPFILTERS('Exchange Health Checker Servers'[Is Server]=TRUE()),KEEPFILTERS('Exchange Health Checker Servers'[Run Status]="Completed")))
		formatString: #,0
		displayFolder: Health Checker

	/// Selected immutable batch only. Health Checker results describe the servers it processed; a server that did not complete is unmeasured, never healthy. Values that can reveal host names, addresses, certificates or domains are masked at collection.
	measure 'Exchange Health Checker Warnings' = IF([Exchange Health Checker Servers Processed]>0,CALCULATE(SUM('Exchange Health Checker Servers'[Warning Count]),KEEPFILTERS('Exchange Health Checker Servers'[Is Server]=TRUE()),KEEPFILTERS('Exchange Health Checker Servers'[Run Status]="Completed")))
		formatString: #,0
		displayFolder: Health Checker

	/// Selected immutable batch only. Health Checker results describe the servers it processed; a server that did not complete is unmeasured, never healthy. Values that can reveal host names, addresses, certificates or domains are masked at collection.
	measure 'Exchange Health Checker Status' = VAR _total=[Exchange Health Checker Servers Total] VAR _done=[Exchange Health Checker Servers Processed] RETURN IF(ISBLANK(_total),"Not captured in selected batch | Health Checker results require a run with -IncludeHealthChecker; unknown is not healthy.",FORMAT(_done,"0") & "/" & FORMAT(_total,"0") & " servers processed | Unprocessed servers are unmeasured, not healthy.")
		formatString: @
		displayFolder: Health Checker

