	partition 'Exchange Health Checker Servers' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    Infrastructure = Readers[GetExchangeOnPremInfrastructure](),
				    Long = Table.SelectRows(Infrastructure, each [Dataset] = "Health Checker summary"),
				    Availability = Table.SelectRows(Long, each [Attribute] = "Source availability"),
				    Data = Table.SelectRows(Long, each [Attribute] <> "Source availability"),
				    // Infrastructure is long-form: rebuild one source row per Source Row Key.
				    Groups = Table.Group(Data, {"Source Row Key"}, {{"Rows", each _, type table}}),
				    Field = (rows as table, attribute as text) as text =>
				        let Values = List.Distinct(Table.Column(Table.SelectRows(rows, each [Attribute] = attribute), "Value"))
				        in if List.Count(Values) = 1 then Values{0} else if List.IsEmpty(Values) then "" else error "Conflicting Health Checker values",
				    Number = (rows as table, attribute as text) as nullable number =>
				        let Values = List.Distinct(Table.Column(Table.SelectRows(rows, each [Attribute] = attribute), "Numeric Value"))
				        in if List.Count(Values) = 1 then Values{0} else if List.IsEmpty(Values) then null else error "Conflicting Health Checker values",
				    RowFor = (rows as table) as record =>
				        [#"Server Name"=Field(rows, "ServerName"), #"Run Status"=Field(rows, "RunStatus"), #"Run Message"=Field(rows, "RunMessage"),
				         #"Exchange Version"=Field(rows, "ExchangeVersion"), #"Build Number"=Field(rows, "BuildNumber"),
				         #"Cumulative Update"=Field(rows, "CumulativeUpdate"), #"Security Update"=Field(rows, "SecurityUpdate"),
				         #"Security Update Status"=Field(rows, "SecurityUpdateStatus"), #"Cumulative Update Days Old"=Number(rows, "CumulativeUpdateDaysOld"),
				         #"Vulnerability Count"=Number(rows, "VulnerabilityCount"), Vulnerabilities=Field(rows, "Vulnerabilities"),
				         #"Error Count"=Number(rows, "ErrorCount"), #"Warning Count"=Number(rows, "WarningCount"),
				         #"Health Checker Version"=Field(rows, "HealthCheckerVersion"), #"Generation Time"=Field(rows, "GenerationTime"),
				         #"Is Server"=true, #"Source Available"=true],
				    State = if Table.IsEmpty(Availability) then "Not captured in selected batch" else Availability{0}[Value],
				    // Absent or empty capture stays an explicit unknown marker, never zero findings.
				    Marker = [#"Server Name"="Not recorded", #"Run Status"=State, #"Run Message"="Health Checker summary " & Text.Lower(State),
				        #"Exchange Version"="", #"Build Number"="", #"Cumulative Update"="", #"Security Update"="", #"Security Update Status"="Unknown",
				        #"Cumulative Update Days Old"=null, #"Vulnerability Count"=null, Vulnerabilities="", #"Error Count"=null, #"Warning Count"=null,
				        #"Health Checker Version"="", #"Generation Time"="", #"Is Server"=false,
				        #"Source Available"=not Table.IsEmpty(Availability) and List.AllTrue(Availability[Source Available])],
				    Records = if Table.IsEmpty(Groups) then {Marker} else List.Transform(Groups[Rows], RowFor),
				    Schema = type table [#"Server Name"=text, #"Run Status"=text, #"Run Message"=text, #"Exchange Version"=text,
				        #"Build Number"=text, #"Cumulative Update"=text, #"Security Update"=text, #"Security Update Status"=text,
				        #"Cumulative Update Days Old"=nullable Int64.Type, #"Vulnerability Count"=nullable Int64.Type, Vulnerabilities=text,
				        #"Error Count"=nullable Int64.Type, #"Warning Count"=nullable Int64.Type, #"Health Checker Version"=text,
				        #"Generation Time"=text, #"Is Server"=logical, #"Source Available"=logical],
				    BusinessRows = Table.Buffer(Table.FromRecords(Records, Schema, MissingField.Error)),
				    Forced = Table.RowCount(BusinessRows)
				in
				    if Forced >= 0 then Readers[Finish](BusinessRows) else error "Health Checker server observations unavailable"
