/// Unified current private Exchange Online and on-premises mailbox evidence with observed size, archive, delegation, hosting, version, activity, and forwarding state.
table 'Mailbox Evidence'
	lineageTag: b52a10cc-35d2-4d9d-b246-011c49231393

	measure Mailboxes = COUNTROWS('Mailbox Evidence')
		formatString: #,0
		displayFolder: Messaging | Estate
		lineageTag: 7fae2a8a-d346-45d6-91a8-2b0db5a72389

	measure 'Exchange Online Mailboxes' = CALCULATE([Mailboxes], KEEPFILTERS('Mailbox Evidence'[Hosting Location] = "Exchange Online"))
		formatString: #,0
		displayFolder: Messaging | Estate
		lineageTag: 3fa86411-1a7e-416f-9dc5-963fb61744e2

	measure 'On-premises Mailboxes' = CALCULATE([Mailboxes], KEEPFILTERS('Mailbox Evidence'[Hosting Location] = "On-premises"))
		formatString: #,0
		displayFolder: Messaging | Estate
		lineageTag: 9d4c0825-e0f0-4fe3-80b0-91b1c39de5ca

	measure 'Observed Exchange Online Adoption (%)' = DIVIDE([Exchange Online Mailboxes], [Mailboxes])
		formatString: 0.0%
		displayFolder: Messaging | Estate
		lineageTag: 9d5c5fdc-5011-40e6-baa5-c983f82d0f82

	measure 'Mailboxes with Archive' = CALCULATE([Mailboxes], KEEPFILTERS('Mailbox Evidence'[Archive State] = "Enabled"))
		formatString: #,0
		displayFolder: Messaging | Archive
		lineageTag: 07c5d219-60ba-4df4-bb15-8829694d5763

	measure 'Mailboxes with Delegations' = CALCULATE([Mailboxes], KEEPFILTERS('Mailbox Evidence'[Delegation Count] > 0))
		formatString: #,0
		displayFolder: Messaging | Delegation
		lineageTag: c48bc21f-4392-4592-9a65-7d1aa3919249

	measure 'Total Mailbox Size (TB)' = DIVIDE(SUM('Mailbox Evidence'[Mailbox Size GB]), 1024)
		formatString: #,0.0
		displayFolder: Messaging | Capacity
		lineageTag: f01c409d-bba7-46ba-a2ca-d12ab5a85425

	measure 'Total Archive Size (TB)' = DIVIDE(SUM('Mailbox Evidence'[Archive Size GB]), 1024)
		formatString: #,0.0
		displayFolder: Messaging | Capacity
		lineageTag: 8b70969c-09af-439d-b7d5-3df825db58fe

	measure 'Large Mailboxes Without Archive' = CALCULATE([Mailboxes], KEEPFILTERS('Mailbox Evidence'[Mailbox Size GB] >= 45), KEEPFILTERS('Mailbox Evidence'[Archive State] <> "Enabled"))
		formatString: #,0
		displayFolder: Messaging | Attention
		lineageTag: b2e7b129-6cc1-4bed-9741-68167ec5d11f

	measure 'Mailboxes With Extensive Delegation' = CALCULATE([Mailboxes], KEEPFILTERS('Mailbox Evidence'[Delegation Count] >= 10))
		formatString: #,0
		displayFolder: Messaging | Attention
		lineageTag: aa912aea-6455-463d-82e5-74c188f4f23f

	measure 'Mailboxes Inactive 180D+' = CALCULATE([Mailboxes], KEEPFILTERS(NOT ISBLANK('Mailbox Evidence'[Last Activity Date]) && 'Mailbox Evidence'[Last Activity Date] < TODAY() - 180))
		formatString: #,0
		displayFolder: Messaging | Attention
		lineageTag: d4b2b9d4-1378-4882-ae43-ea238dca3891

	measure 'Mailboxes With Forwarding' = CALCULATE([Mailboxes], KEEPFILTERS('Mailbox Evidence'[Forwarding State] = "Configured"))
		formatString: #,0
		displayFolder: Messaging | Attention
		lineageTag: 2efae0d3-acde-4fd9-9671-cd066dc09f08

	measure 'Mailbox Evidence Ribbon Text' = FORMAT([Mailboxes], "#,0") & " observed · " & FORMAT([Observed Exchange Online Adoption (%)], "0.0%") & " online · " & FORMAT([Mailboxes with Archive], "#,0") & " archived"
		formatString: @
		displayFolder: Messaging | Evidence
		lineageTag: 0dcb1021-38c6-422e-a274-93ac381e1090

	/// Primary mailbox plus archive storage.
	measure 'Total Mailbox Storage (TB)' = DIVIDE ( SUM ( 'Mailbox Evidence'[Total Storage GB] ), 1024 )
		formatString: #,0.0
		displayFolder: Messaging | Capacity
		lineageTag: 1a508650-f2d5-4736-87f8-54ca5a2d918c

	measure 'Mailboxes >=45 GB Without Archive' = CALCULATE ( [Mailboxes], KEEPFILTERS ( 'Mailbox Evidence'[Mailbox Size GB] >= 45 ), KEEPFILTERS ( 'Mailbox Evidence'[Archive State] <> "Enabled" ) )
		formatString: #,0
		displayFolder: Messaging | Risk
		lineageTag: 9aca1b27-baff-4123-9fa8-8c93c4967ff5

	column 'Mailbox Key'
