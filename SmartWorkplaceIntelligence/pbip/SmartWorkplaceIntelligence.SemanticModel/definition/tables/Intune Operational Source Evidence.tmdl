/// Governed IntuneOperationalSourceEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Operational Source Evidence'
	lineageTag: bb89210d-4c1d-489b-b406-698daa2092b0

	/// Source groups with verified receipts/files. This is not full-inventory or analytical qualification.
	measure 'Intune Source Groups Supplied' = CALCULATE(COUNTROWS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified")
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 11adc2d2-7380-4366-b341-e4867ddad12d

	/// Source availability and limits. Country does not apply to this tenant-level qualification utility.
	measure 'Intune Source Scope Message' = IF([Intune Source Groups Supplied] > 0, "Reported Intune scope only; assignment and reported status are not on-device proof. Full tenant coverage and endpoint health are not qualified.", "Intune operational evidence not supplied; not measured.")
		formatString: @
		displayFolder: Intune | Reported scope
		lineageTag: 05700124-ca0e-4f87-93a2-0f6a846e3a40

	/// Prepared IntuneOperationalSourceEvidence.csv: TenantKey. Reported source scope only; not whole-tenant coverage or endpoint health.
	column 'Tenant Key'
		dataType: string
		isHidden
		lineageTag: 04177beb-c4d2-423a-b4be-815aa565966d
		summarizeBy: none
		sourceColumn: TenantKey

