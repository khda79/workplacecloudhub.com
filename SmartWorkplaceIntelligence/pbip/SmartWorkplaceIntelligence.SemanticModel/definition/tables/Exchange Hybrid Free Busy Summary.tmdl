/// One row per FreeBusyChecker side and authentication method (on-premises / Exchange Online, DAuth / OAuth), or one explicit unknown marker when the summary was not captured. Selected immutable batch only. Microsoft CSS-Exchange FreeBusyChecker results for the on-premises and Exchange Online sides, DAuth and OAuth. A side that was not connected, not authorized or not run is unmeasured, never healthy. Values that can reveal host names, addresses, certificates, domains or identifiers are masked at collection. Disconnected: geographical and attribute filters do not apply.
table 'Exchange Hybrid Free Busy Summary'
	lineageTag: f5386d3c-f7e8-54fe-9231-4cc89e5cbc01

	/// Selected immutable batch only. Microsoft CSS-Exchange FreeBusyChecker results for the on-premises and Exchange Online sides, DAuth and OAuth. A side that was not connected, not authorized or not run is unmeasured, never healthy. Values that can reveal host names, addresses, certificates, domains or identifiers are masked at collection.
	measure 'Exchange Free Busy Checks Total' = VAR _all=CALCULATE(COUNTROWS('Exchange Hybrid Free Busy Summary'),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE())) VAR _applicable=CALCULATE(COUNTROWS('Exchange Hybrid Free Busy Summary'),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE()),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Side Status]<>"NotApplicable")) RETURN IF(_all>0,_applicable)
		formatString: #,0
		displayFolder: Free/Busy

	/// Selected immutable batch only. Microsoft CSS-Exchange FreeBusyChecker results for the on-premises and Exchange Online sides, DAuth and OAuth. A side that was not connected, not authorized or not run is unmeasured, never healthy. Values that can reveal host names, addresses, certificates, domains or identifiers are masked at collection.
	measure 'Exchange Free Busy Checks Completed' = IF(NOT ISBLANK([Exchange Free Busy Checks Total]),COALESCE(CALCULATE(COUNTROWS('Exchange Hybrid Free Busy Summary'),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE()),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Side Status]="Completed")),0))
		formatString: #,0
		displayFolder: Free/Busy

	/// Selected immutable batch only. Microsoft CSS-Exchange FreeBusyChecker results for the on-premises and Exchange Online sides, DAuth and OAuth. A side that was not connected, not authorized or not run is unmeasured, never healthy. Values that can reveal host names, addresses, certificates, domains or identifiers are masked at collection.
	measure 'Exchange Free Busy Errors' = IF(NOT ISBLANK([Exchange Free Busy Checks Total]),CALCULATE(SUM('Exchange Hybrid Free Busy Summary'[Error Count]),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE())))
		formatString: #,0
		displayFolder: Free/Busy

	/// Selected immutable batch only. Microsoft CSS-Exchange FreeBusyChecker results for the on-premises and Exchange Online sides, DAuth and OAuth. A side that was not connected, not authorized or not run is unmeasured, never healthy. Values that can reveal host names, addresses, certificates, domains or identifiers are masked at collection.
	measure 'Exchange Free Busy Warnings' = IF(NOT ISBLANK([Exchange Free Busy Checks Total]),CALCULATE(SUM('Exchange Hybrid Free Busy Summary'[Warning Count]),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE())))
		formatString: #,0
		displayFolder: Free/Busy

	/// Selected immutable batch only. Microsoft CSS-Exchange FreeBusyChecker results for the on-premises and Exchange Online sides, DAuth and OAuth. A side that was not connected, not authorized or not run is unmeasured, never healthy. Values that can reveal host names, addresses, certificates, domains or identifiers are masked at collection.
	measure 'Exchange Free Busy Not Authorized Checks' = IF(NOT ISBLANK([Exchange Free Busy Checks Total]),CALCULATE(SUM('Exchange Hybrid Free Busy Summary'[Not Authorized Count]),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE())))
		formatString: #,0
		displayFolder: Free/Busy

	/// Selected immutable batch only. Microsoft CSS-Exchange FreeBusyChecker results for the on-premises and Exchange Online sides, DAuth and OAuth. A side that was not connected, not authorized or not run is unmeasured, never healthy. Values that can reveal host names, addresses, certificates, domains or identifiers are masked at collection.
	measure 'Exchange Free Busy Status' = VAR _total=[Exchange Free Busy Checks Total] VAR _done=[Exchange Free Busy Checks Completed] VAR _run=CALCULATE(MAX('Exchange Hybrid Free Busy Summary'[Run Status]),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE())) VAR _na=CALCULATE(COUNTROWS('Exchange Hybrid Free Busy Summary'),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Is Result]=TRUE()),KEEPFILTERS('Exchange Hybrid Free Busy Summary'[Side Status]="NotApplicable")) RETURN IF(ISBLANK(_total),"Not captured in selected batch | Free/busy results require the weekly Exchange2016-FreeBusy-Check job; unknown is not healthy.",FORMAT(_done,"0") & "/" & FORMAT(_total,"0") & " side checks completed | Run status: " & _run & IF(_na>0," | " & FORMAT(_na,"0") & " DAuth side check(s) not applicable: Intra Organization Connector enabled, free/busy uses OAuth","") & " | Not connected, not authorized or not run checks are unmeasured, not healthy.")
		formatString: @
		displayFolder: Free/Busy

