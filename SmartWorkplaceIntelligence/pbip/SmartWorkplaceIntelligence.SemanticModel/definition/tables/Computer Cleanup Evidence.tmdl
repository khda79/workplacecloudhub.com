	partition 'Computer Cleanup Evidence' = m
		mode: import
		source =
				let
				 Readers = CreatePreparedReaders(),
				 Raw = Table.PromoteHeaders(Csv.Document(Readers[GetPreparedEvidenceFile]("ComputerCleanupEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]), [PromoteAllScalars=true]),
				 Selected = Table.SelectColumns(Raw, {"TenantKey", "Computer Cleanup Key", "AD Object GUID", "Entra Device ID", "Intune Device ID", "AD Domain", "Computer Name", "Enabled", "Operating System", "Scope State", "In Disabled OU", "When Created", "Password Last Set", "Country", "Country Basis", "Account Type", "Account Population", "Workforce Persona", "Entra Match Status", "Intune Match Status", "AD Last Logon", "AD Last Logon Quality", "Entra Last Sign-In", "Entra Last Sign-In Quality", "Intune Last Sync", "Intune Last Sync Quality", "Last Activity Date", "Last Activity Source", "Days Since Last Activity", "Inactivity Bucket", "Bucket Sort", "Cleanup State", "State Sort", "Decision Reason", "Secondary Reasons", "Recommended Action", "AD Source Status", "AD Collected UTC", "Entra Source Status", "Entra Collected UTC", "Intune Source Status", "Intune Collected UTC", "Reference UTC", "Evidence Date", "Evidence Status"}),
				 Scoped = if List.AllTrue(List.Transform(Table.Column(Selected, "TenantKey"), each _ = PreparedExpectedTenantKey)) then Selected else error "Foreign or missing tenant",
				 Nulls = Table.ReplaceValue(Scoped, "", null, Replacer.ReplaceValue, {"Days Since Last Activity", "Bucket Sort", "State Sort"}),
				 Typed = Table.TransformColumnTypes(Nulls, {{"TenantKey", type text}, {"Computer Cleanup Key", type text}, {"AD Object GUID", type text}, {"Entra Device ID", type text}, {"Intune Device ID", type text}, {"AD Domain", type text}, {"Computer Name", type text}, {"Enabled", type text}, {"Operating System", type text}, {"Scope State", type text}, {"In Disabled OU", type text}, {"When Created", type text}, {"Password Last Set", type text}, {"Country", type text}, {"Country Basis", type text}, {"Account Type", type text}, {"Account Population", type text}, {"Workforce Persona", type text}, {"Entra Match Status", type text}, {"Intune Match Status", type text}, {"AD Last Logon", type text}, {"AD Last Logon Quality", type text}, {"Entra Last Sign-In", type text}, {"Entra Last Sign-In Quality", type text}, {"Intune Last Sync", type text}, {"Intune Last Sync Quality", type text}, {"Last Activity Date", type text}, {"Last Activity Source", type text}, {"Days Since Last Activity", Int64.Type}, {"Inactivity Bucket", type text}, {"Bucket Sort", Int64.Type}, {"Cleanup State", type text}, {"State Sort", Int64.Type}, {"Decision Reason", type text}, {"Secondary Reasons", type text}, {"Recommended Action", type text}, {"AD Source Status", type text}, {"AD Collected UTC", type text}, {"Entra Source Status", type text}, {"Entra Collected UTC", type text}, {"Intune Source Status", type text}, {"Intune Collected UTC", type text}, {"Reference UTC", type text}, {"Evidence Date", type text}, {"Evidence Status", type text}}, "en-US"),
				 Dates = Table.TransformColumns(Typed, {{"When Created", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Password Last Set", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"AD Last Logon", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Entra Last Sign-In", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Intune Last Sync", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Last Activity Date", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"AD Collected UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Entra Collected UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Intune Collected UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Reference UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Evidence Date", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}}),
				 QualifiedCountry = Table.AddColumn(Dates, "__Qualified Country", each if Text.StartsWith(if [Country Basis] = null then "" else [Country Basis], "Configured AD domain") or Text.StartsWith(if [Country Basis] = null then "" else [Country Basis], "Configured computer-name prefix") or [Country] = null or Text.Trim([Country]) = "" then "Unknown" else [Country], type text),
				 CountryRemoved = Table.RemoveColumns(QualifiedCountry, {"Country"}),
				 CountryRenamed = Table.RenameColumns(CountryRemoved, {{"__Qualified Country", "Country"}})
				in
				 Readers[Finish](CountryRenamed)
