/// Prepared Directory Cleanup evidence; country provenance is preserved.
table 'Computer Cleanup Evidence'
	lineageTag: d158f706-8f59-4f6e-a8ef-e2a5f225ea2f

	measure 'Computer Cleanup Total' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Computer Cleanup Evidence')), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: 4092e365-3cbe-4613-9b5d-fc5dcacac203

	measure 'Computer Cleanup Candidates' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Computer Cleanup Evidence'), KEEPFILTERS('Computer Cleanup Evidence'[Cleanup State] = "Candidate")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: fba94cc3-003d-46ea-a302-e9d36cb2fc20

	measure 'Computer Cleanup Review' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Computer Cleanup Evidence'), KEEPFILTERS('Computer Cleanup Evidence'[Cleanup State] = "Review")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: 9639a92e-bfde-4d1e-aef8-dfd79048879a

	measure 'Computer Cleanup Active' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Computer Cleanup Evidence'), KEEPFILTERS('Computer Cleanup Evidence'[Cleanup State] = "Active")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: 4f6e99a6-904e-49d6-bc40-8c6326636d72

