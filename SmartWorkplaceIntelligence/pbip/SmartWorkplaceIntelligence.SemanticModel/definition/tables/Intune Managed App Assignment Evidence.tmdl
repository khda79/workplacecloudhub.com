/// Governed IntuneManagedAppAssignmentEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Managed App Assignment Evidence'
	lineageTag: d4697576-2256-4476-869e-51018d87d6ee

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Managed App Assignments' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Managed App Assignment Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: dbee2734-c0cb-4923-85d5-7a105dc00f37

	/// Prepared IntuneManagedAppAssignmentEvidence.csv: TenantKey. Reported source scope only; not whole-tenant coverage or endpoint health.
	column 'Tenant Key'
		dataType: string
		isHidden
		lineageTag: 669ad387-e6f7-429c-b19e-c9ed957f91cf
		summarizeBy: none
		sourceColumn: TenantKey

