/// One synthetic directory-presence and activity observation per user, source, and reporting date.
table 'User Directory Observations'
	lineageTag: 9fb00228-bed6-4977-951d-6e56ff0d8b0a

	/// Observed workforce accounts present in AD and absent from Entra in the same reporting scope.
	measure '# AD Accounts Missing in Entra' = VAR _adUsers = CALCULATETABLE(VALUES('User Directory Observations'[User Key]), KEEPFILTERS('User Directory Observations'[Directory Source] = "AD"), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed"), KEEPFILTERS('User'[Identity Scope] = "Workforce")) VAR _entraUsers = CALCULATETABLE(VALUES('User Directory Observations'[User Key]), KEEPFILTERS('User Directory Observations'[Directory Source] = "Entra"), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed"), KEEPFILTERS('User'[Identity Scope] = "Workforce")) RETURN COUNTROWS(EXCEPT(_adUsers, _entraUsers))
		formatString: #,0
		displayFolder: Identity Health
		lineageTag: 1583a65f-622e-4a45-9f1b-c073d5ef99f3

	/// Enabled workforce accounts with complete observed directory evidence and no AD or Entra activity timestamp.
	measure '# Never Used Accounts' = COUNTROWS(FILTER(VALUES('User'[User Key]), VAR _accountState = CALCULATE(SELECTEDVALUE('User'[Account State])) VAR _identityScope = CALCULATE(SELECTEDVALUE('User'[Identity Scope])) VAR _presentSources = CALCULATE(DISTINCTCOUNT('User Directory Observations'[Directory Source]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present")) VAR _observedSources = CALCULATE(DISTINCTCOUNT('User Directory Observations'[Directory Source]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed")) VAR _lastActivity = CALCULATE(MAX('User Directory Observations'[Last Activity UTC]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed")) RETURN _accountState = "Enabled" && _identityScope = "Workforce" && _presentSources > 0 && _presentSources = _observedSources && ISBLANK(_lastActivity)))
		formatString: #,0
		displayFolder: Identity Health
		lineageTag: 93bed1d9-4251-422c-826d-b6218a32b16b

	/// Enabled workforce accounts with complete observed directory evidence and no AD or Entra activity during the trailing 30 days; never-used accounts are included. The window anchors to the latest accepted directory observation in filter context.
	measure '# Accounts Without Activity in 30D' = VAR _asOfKey = MAX('User Directory Observations'[Date Key]) VAR _asOf = IF(ISBLANK(_asOfKey), BLANK(), DATE(QUOTIENT(_asOfKey, 10000), QUOTIENT(MOD(_asOfKey, 10000), 100), MOD(_asOfKey, 100))) RETURN IF(ISBLANK(_asOf), BLANK(), COUNTROWS(FILTER(VALUES('User'[User Key]), VAR _accountState = CALCULATE(SELECTEDVALUE('User'[Account State])) VAR _identityScope = CALCULATE(SELECTEDVALUE('User'[Identity Scope])) VAR _presentSources = CALCULATE(DISTINCTCOUNT('User Directory Observations'[Directory Source]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present")) VAR _observedSources = CALCULATE(DISTINCTCOUNT('User Directory Observations'[Directory Source]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed")) VAR _lastActivity = CALCULATE(MAX('User Directory Observations'[Last Activity UTC]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed")) RETURN _accountState = "Enabled" && _identityScope = "Workforce" && _presentSources > 0 && _presentSources = _observedSources && (ISBLANK(_lastActivity) || _lastActivity <= _asOf - 30))))
		formatString: #,0
		displayFolder: Identity Health
		lineageTag: b61e96b8-c8fa-4dae-88a3-f449bd21ab93

	/// Enabled workforce accounts with complete observed directory evidence and no AD or Entra activity during the trailing 90 days; never-used accounts are included. The window anchors to the latest accepted directory observation in filter context.
	measure '# Accounts Without Activity in 90D' = VAR _asOfKey = MAX('User Directory Observations'[Date Key]) VAR _asOf = IF(ISBLANK(_asOfKey), BLANK(), DATE(QUOTIENT(_asOfKey, 10000), QUOTIENT(MOD(_asOfKey, 10000), 100), MOD(_asOfKey, 100))) RETURN IF(ISBLANK(_asOf), BLANK(), COUNTROWS(FILTER(VALUES('User'[User Key]), VAR _accountState = CALCULATE(SELECTEDVALUE('User'[Account State])) VAR _identityScope = CALCULATE(SELECTEDVALUE('User'[Identity Scope])) VAR _presentSources = CALCULATE(DISTINCTCOUNT('User Directory Observations'[Directory Source]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present")) VAR _observedSources = CALCULATE(DISTINCTCOUNT('User Directory Observations'[Directory Source]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed")) VAR _lastActivity = CALCULATE(MAX('User Directory Observations'[Last Activity UTC]), KEEPFILTERS('User Directory Observations'[Presence State] = "Present"), KEEPFILTERS('User Directory Observations'[Activity Evidence Status] = "Observed")) RETURN _accountState = "Enabled" && _identityScope = "Workforce" && _presentSources > 0 && _presentSources = _observedSources && (ISBLANK(_lastActivity) || _lastActivity <= _asOf - 90))))
		formatString: #,0
		displayFolder: Identity Health
		lineageTag: a82dc571-9e42-4b1b-b0b6-86373ae10b3d

