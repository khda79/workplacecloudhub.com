				    Source = #table(type table [#"Date Key" = Int64.Type, #"Tenant Key" = Int64.Type, #"Environment Key" = Int64.Type, #"User Key" = Int64.Type, #"Directory Source" = nullable text, #"Presence State" = nullable text, #"Account State" = nullable text, #"Last Activity UTC" = nullable datetime, #"Activity Evidence Status" = nullable text], {
				        {20260915, 1, 1, 1, "AD", "Present", "Enabled", #datetime(2026, 9, 14, 8, 0, 0), "Observed"},
				        {20260915, 1, 1, 1, "Entra", "Present", "Enabled", #datetime(2026, 9, 14, 12, 0, 0), "Observed"},
				        {20260915, 1, 1, 2, "AD", "Present", "Enabled", #datetime(2026, 6, 1, 8, 0, 0), "Observed"},
				        {20260915, 1, 1, 2, "Entra", "Present", "Enabled", #datetime(2026, 6, 1, 10, 0, 0), "Observed"},
				        {20260915, 1, 1, 3, "AD", "Present", "Disabled", #datetime(2026, 1, 10, 9, 0, 0), "Observed"},
				        {20260915, 1, 1, 3, "Entra", "Absent", "Disabled", null, "Observed"},
				        {20260915, 1, 1, 4, "AD", "Absent", "Enabled", null, "Observed"},
