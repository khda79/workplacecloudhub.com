		formatString: #,0.0
		lineageTag: d5af654d-9f01-4b10-b530-273b8ae6d8dd
		summarizeBy: sum
		sourceColumn: SharePoint Storage Allocated GB

		annotation SummarizationSetBy = Automatic

	column 'SharePoint Storage Utilization (%)'
		dataType: double
		formatString: 0.0
		lineageTag: 421987df-3e29-4ee5-8255-44fb339d18d9
		summarizeBy: sum
		sourceColumn: SharePoint Storage Utilization (%)

		annotation SummarizationSetBy = Automatic

	column 'Inactive SharePoint Sites'
		dataType: int64
		formatString: #,0
		lineageTag: 01c842c1-73c1-4d0c-a4e6-4016d7a13941
		summarizeBy: sum
		sourceColumn: Inactive SharePoint Sites

		annotation SummarizationSetBy = Automatic

	column 'Orphaned SharePoint Sites'
		dataType: int64
		formatString: #,0
		lineageTag: 07e5b1cb-aa13-46e9-b627-dbc9c6d71201
		summarizeBy: sum
		sourceColumn: Orphaned SharePoint Sites

