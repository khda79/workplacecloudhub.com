/// Native source facet migrated from SourceHealth; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native Source Health'
	lineageTag: 281de526-d87b-42e0-8dd3-f41d75aef28f

	/// Configured source feeds represented in SourceHealth for the frozen snapshot. Migrated without changing the source calculation.
	measure 'Native Source feeds' = (COALESCE(COUNTROWS('Native Source Health'), 0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 357aa941-a508-477f-b23e-815c6ae5274f

	/// Source feeds collected by their producer: Health State OK or Warning (Success or SuccessWithWarnings). Collected is not tenant certification.
	measure 'Native Collected source feeds' = ([Native OK source feeds] + [Native Warning source feeds])
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 21999a0e-0974-4acb-90bc-20d2c53fa4b1

	/// Source feeds not collected in the frozen snapshot: Failed or Unknown health state.
	measure 'Native Missing source feeds' = (MAX(0, [Native Source feeds] - [Native Collected source feeds]))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 2cdc2862-f82f-4d5e-a905-4a225c1b1139

	/// Collected (OK or Warning) source feeds divided by represented source feeds. This is collection coverage, not a composite CMDB quality score.
	measure 'Native Source collection coverage' = (DIVIDE([Native Collected source feeds], [Native Source feeds]))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: a4d11cc5-35c3-457a-91c5-c7cdbb98ae70

	/// Source feeds whose native status is Success (Health State OK).
	measure 'Native OK source feeds' = (COALESCE(CALCULATE(COUNTROWS('Native Source Health'), KEEPFILTERS('Native Source Health'[Health State] == "OK")), 0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: f9cbbf92-a7e1-4bd9-89de-c984a6e785c5

	/// Source feeds collected with qualifications: native status SuccessWithWarnings (Health State Warning).
	measure 'Native Warning source feeds' = (COALESCE(CALCULATE(COUNTROWS('Native Source Health'), KEEPFILTERS('Native Source Health'[Health State] == "Warning")), 0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 2cf259b2-128c-403d-96dc-e2a060fdc241

	/// Source feeds whose native status is Failed or Cancelled (Health State Failed).
	measure 'Native Failed source feeds' = (COALESCE(CALCULATE(COUNTROWS('Native Source Health'), KEEPFILTERS('Native Source Health'[Health State] == "Failed")), 0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 52697217-d897-4fd4-b8be-31e79d3b0f90

	/// Source feeds whose native status is blank or outside the mapped vocabulary (Health State Unknown); never counted as collected.
	measure 'Native Unknown-status source feeds' = (COALESCE(CALCULATE(COUNTROWS('Native Source Health'), KEEPFILTERS('Native Source Health'[Health State] == "Unknown")), 0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 19898157-ceac-4bff-941b-6a7590fcd8f4

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Native Source Health' = (COUNTROWS('Native Source Health'))
		formatString: #,0
		isHidden
		lineageTag: 13c62cae-81f2-41c1-8b01-d06836c9719d

	/// Native SourceHealth attribute; source qualification is retained.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: 4b6cd335-15f4-4a98-a008-efce8b4ed257
		summarizeBy: none
		sourceColumn: TenantKey

	/// Native SourceHealth attribute; source qualification is retained.
	column OrganizationKey
		dataType: string
		isHidden
		lineageTag: 35ce9c00-53c8-4957-886e-b172bb9979bf
		summarizeBy: none
		sourceColumn: OrganizationKey

	/// Native SourceHealth attribute; source qualification is retained.
	column EnvironmentKey
		dataType: string
		isHidden
		lineageTag: 87534197-f673-48d3-b1ac-4ac970989f4e
		summarizeBy: none
		sourceColumn: EnvironmentKey

	/// Native SourceHealth attribute; source qualification is retained.
	column TenantId
		dataType: string
		isHidden
		lineageTag: 78afdf0b-6ccb-4b3f-af46-38a2ba762be9
		summarizeBy: none
		sourceColumn: TenantId

	/// Native SourceHealth attribute; source qualification is retained.
	column SourceName
		dataType: string
		lineageTag: 13000168-6736-4832-bcc2-b6821ccb9b30
		summarizeBy: none
		sourceColumn: SourceName

	/// Native SourceHealth attribute; source qualification is retained.
	column Status
		dataType: string
		lineageTag: ab58798c-34cc-446b-b862-754881d4fa19
		summarizeBy: none
		sourceColumn: Status

	/// Status mapped by NativeSourceHealthState: OK, Warning, Failed or Unknown. Unmapped values stay Unknown, never OK.
	column 'Health State'
		dataType: string
		lineageTag: 2c5a1d95-b34b-4bcc-a3b0-8d2304c64997
		summarizeBy: none
		sourceColumn: Health State

	/// Native SourceHealth attribute; source qualification is retained.
	column Coverage
