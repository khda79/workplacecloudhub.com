		lineageTag: 9b6dd0a6-e70e-4470-8956-97eab7885825
		summarizeBy: none
		sourceColumn: Coverage

	/// Native SourceHealth attribute; source qualification is retained.
	column SourceRows
		dataType: int64
		lineageTag: 59aedf2f-62ae-4dd4-86a8-ee2ecca3f5f6
		summarizeBy: none
		sourceColumn: SourceRows

	/// Native SourceHealth attribute; source qualification is retained.
	column MaxItems
		dataType: int64
		lineageTag: 34545f7e-df04-4495-aac2-386d163496b0
		summarizeBy: none
		sourceColumn: MaxItems

	/// Native SourceHealth attribute; source qualification is retained.
	column StartedDateTime
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm:ss
		lineageTag: 4d55a180-1713-46fa-8c96-4bb7e5ab2f12
		summarizeBy: none
