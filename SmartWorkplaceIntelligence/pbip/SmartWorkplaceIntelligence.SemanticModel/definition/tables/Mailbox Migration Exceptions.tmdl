	/// Private planning update from operator workbook 8c3e246557c7dcd2f1bd88d600ee004006cc26e3c9087cfe8e10b4f5b5c34c64; inventory batch 20261103T070757019Z-f084240f. Decisions resolved using verified same-batch native sources. Embedded update applies only to this batch; later batches use the governed prepared exception files.
	partition 'Mailbox Migration Exceptions' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Manifest = GetPreparedBatchManifest(),
				    Names = {"MailboxMigrationExceptions.csv", "MailboxMigrationExceptionSummary.csv"},
				    Present = List.Select(Manifest[Files], each List.Contains(Names, [File])),
				    Declared = Record.HasFields(Record.FieldOrDefault(Manifest, "Provenance", []), "MailboxMigrationExceptions"),
				    Columns = {"TenantKey", "OrganizationKey", "EnvironmentKey", "TenantId", "Decision Key", "Source Rows", "Primary SMTP Address", "Retain On-premises", "Reason", "Decision Owner", "Decision Date", "Review Date", "Source Reference", "Mailbox Identity", "Candidate Identity", "Source Domain", "Domain Key", "Status", "Requires Review", "Retained", "Documentation Warnings", "Snapshot Date"},
				    BatchSource = if List.Count(Present) = 0 and not Declared then #table(Columns, {})
				        else if List.Count(Present) <> 2 or List.Count(List.Distinct(List.Transform(Present, each [File]))) <> 2 or not Declared then error "Incomplete mailbox migration exception batch; keep previous model"
				        else Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("MailboxMigrationExceptions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Source = if Manifest[BatchId] = "20261103T070757019Z-f084240f" then Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.GZip)), Columns) else BatchSource,
				    Checked = if Table.ColumnNames(Source) <> Columns then error "Mailbox migration exception schema mismatch" else if List.AnyTrue(List.Transform(Source[TenantKey], each _ <> PreparedExpectedTenantKey)) then error "Mailbox migration exception tenant mismatch" else Source,
				    Typed = Table.TransformColumnTypes(Checked, {{"TenantKey", type text}, {"OrganizationKey", type text}, {"EnvironmentKey", type text}, {"TenantId", type text}, {"Decision Key", type text}, {"Source Rows", type text}, {"Primary SMTP Address", type text}, {"Retain On-premises", type text}, {"Reason", type text}, {"Decision Owner", type text}, {"Decision Date", type text}, {"Review Date", type text}, {"Source Reference", type text}, {"Mailbox Identity", type text}, {"Candidate Identity", type text}, {"Source Domain", type text}, {"Domain Key", type text}, {"Status", type text}, {"Requires Review", Int64.Type}, {"Retained", Int64.Type}, {"Documentation Warnings", type text}, {"Snapshot Date", type text}}, "en-US")
				in
				    Typed)
				in
				    Readers[Finish](BusinessRows)

