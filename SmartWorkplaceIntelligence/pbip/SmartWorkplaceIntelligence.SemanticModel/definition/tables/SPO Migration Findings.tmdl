/// SPO means SharePoint Online. Grain: Finding Key; source: one selected immutable prepared batch.
table 'SPO Migration Findings'
	lineageTag: 6184ce9c-c645-4bc2-aa75-2fe61eb16ddb

	/// Business Review Findings. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Business Review Findings' =
			VAR _keys=FILTER(VALUES('SPO Migration Plan'[Operation Key]), [SPO Operations]>0) RETURN CALCULATE(DISTINCTCOUNT('SPO Migration Findings'[Operation Key]), TREATAS(_keys, 'SPO Migration Findings'[Operation Key]),
			KEEPFILTERS('SPO Migration Findings'[Finding Rule] IN {"Decision pending","Missing planned date","Done without actual date","Imported date needs clarification","Target approval pending","Migration validation not documented","Inconsistent validation"}))
		formatString: #,##0
		displayFolder: Migration\Quality
		lineageTag: c174dedf-aeea-43ff-beec-de0d74eeda16

	/// Finding Count. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Finding Count' = VAR _keys=FILTER(VALUES('SPO Migration Plan'[Operation Key]), [SPO Operations]>0) RETURN CALCULATE(COUNTROWS('SPO Migration Findings'), TREATAS(_keys,'SPO Migration Findings'[Operation Key]))
		formatString: #,##0
		displayFolder: Migration\Quality
		lineageTag: 1005a680-42fc-4a1b-acfc-c3857141fb5f

	/// Global Findings. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Global Findings' = CALCULATE(COUNTROWS('SPO Migration Findings'), KEEPFILTERS(ISBLANK('SPO Migration Findings'[Operation Key])))
		formatString: #,##0
		displayFolder: Migration\Quality
		lineageTag: d081678b-5c25-47df-9690-bcba132bbdc6

	/// Visible Finding. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Visible Finding' =
			VAR _key=SELECTEDVALUE('SPO Migration Findings'[Operation Key]) VAR _keys=FILTER(VALUES('SPO Migration Plan'[Operation Key]), [SPO Operations]>0)
			RETURN IF(ISBLANK(_key) || CONTAINS(_keys, 'SPO Migration Plan'[Operation Key], _key), 1)
		formatString: #,##0
		isHidden
		displayFolder: Migration\Quality
		lineageTag: cc843132-6e75-49d8-844e-613ad90bc4ff

	/// Global Quality Context. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Global Quality Context' =
			VAR _available=COUNTROWS(FILTER('SPO Migration Source Summary', 'SPO Migration Source Summary'[Qualification]="Configured"))>0
			RETURN IF(_available,"Source/global findings: " & FORMAT(COALESCE([SPO Global Findings],0),"#,##0") & ". Source-level findings are not attributable to a business unit or operation. Rule categories overlap.", [SPO Source Qualification Context])
		formatString: General
		displayFolder: Migration\Quality
		lineageTag: 6fddcdf7-b03c-45b0-bf3d-4c1bce13a6cc

	/// Prepared, tenant-qualified migration evidence: TenantKey.
