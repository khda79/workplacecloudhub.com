	/// Observed Boolean display with an explicit Unknown state. Technical Boolean alone must not be interpreted without source observation status.
	column 'Password Expired (display)' = IF('AD Computer Evidence'[PasswordExpiryStatus]="Observed",IF('AD Computer Evidence'[PasswordExpired],"true","false"),"Unknown")
		dataType: string
