/// Prepared current evidence with qualified source and immutable batch identity.
table 'Group Activity Evidence'
	lineageTag: 4c5127a0-322e-4ba9-9b07-5e883ed420e4

	/// Prepared source evidence; missing or unqualified source remains blank.
	measure 'Qualified M365 Groups' = VAR _s = CALCULATETABLE('Data Trust Evidence', REMOVEFILTERS('Data Trust Evidence'), 'Data Trust Evidence'[File Name] = "M365_Groups_Activity.csv") VAR _ready = COUNTROWS(_s) = 1 && COUNTROWS(FILTER(_s, 'Data Trust Evidence'[Evidence Status] = "Observed" && 'Data Trust Evidence'[Schema State] = "Qualified" && 'Data Trust Evidence'[Decision Readiness] = "Ready")) = 1  RETURN IF(_ready, COALESCE(CALCULATE(COUNTROWS('Group Activity Evidence'), 'Group Activity Evidence'[Evidence Status] = "Observed"), 0))
		formatString: #,0
		displayFolder: Collaboration | Usage signals
		lineageTag: 87bcac37-8152-4218-8774-b96ec8ce3d54

	/// Prepared source evidence; missing or unqualified source remains blank.
	measure 'M365 Groups Without Owners' = CALCULATE([Qualified M365 Groups], 'Group Activity Evidence'[Owner State] = "No owner")
		formatString: #,0
		displayFolder: Collaboration | Usage signals
		lineageTag: ce8a8c78-c372-4dc1-b302-1652e1e52c62

	/// Prepared source evidence; missing or unqualified source remains blank.
	measure 'M365 Groups Inactive' = CALCULATE([Qualified M365 Groups], 'Group Activity Evidence'[Activity State] = "Inactive 180D+")
		formatString: #,0
		displayFolder: Collaboration | Usage signals
		lineageTag: 1339989a-f9bd-4900-835a-0867186520a2

	/// Prepared source evidence; missing or unqualified source remains blank.
	measure 'M365 Groups With External Members' = CALCULATE([Qualified M365 Groups], 'Group Activity Evidence'[External Access State] = "External members present")
		formatString: #,0
		displayFolder: Collaboration | Usage signals
		lineageTag: 05edffc8-91c6-4ea9-964a-0b66d52ba44e

	/// Prepared source evidence; missing or unqualified source remains blank.
	measure 'M365 Groups Owner Or Activity Review' = CALCULATE([Qualified M365 Groups], FILTER('Group Activity Evidence', 'Group Activity Evidence'[Owner State] = "No owner" || 'Group Activity Evidence'[Activity State] IN {"Inactive 180D+", "No activity evidence"}))
		formatString: #,0
		displayFolder: Collaboration | Usage signals
		lineageTag: 3ae4bcc7-0c6c-43f1-8b3c-8fe80c2a7f97

	/// Prepared source evidence; missing or unqualified source remains blank.
	measure 'M365 Groups Teams Enabled' = CALCULATE([Qualified M365 Groups], 'Group Activity Evidence'[Teams State] = "Teams-enabled")
		formatString: #,0
		displayFolder: Collaboration | Usage signals
		lineageTag: 11a2ba48-8692-47fe-893c-ecf631a47fcd

	measure 'Group source display status' =
			VAR _rows = CALCULATETABLE('Data Trust Evidence', REMOVEFILTERS('Data Trust Evidence'), 'Data Trust Evidence'[File Name] = "M365_Groups_Activity.csv")
			VAR _status = MAXX(_rows, 'Data Trust Evidence'[Evidence Status])
			VAR _schema = MAXX(_rows, 'Data Trust Evidence'[Schema State])
			VAR _ready = MAXX(_rows, 'Data Trust Evidence'[Decision Readiness])
			RETURN IF(COUNTROWS(_rows) <> 1, "Source status unavailable", IF(_status = "Observed" && _ready = "Ready" && _schema = "Qualified", "Observed", COALESCE(_status, "Not collected") & " · " & COALESCE(_ready, "Not qualified")))
		displayFolder: Collaboration | Usage signals
		lineageTag: 20ab2846-e7aa-45dc-ac44-1b7cb38b97bc

	column TenantKey
		dataType: string
		isHidden
		lineageTag: d6fdb5aa-7f7a-43c5-817c-13edcc246398
		summarizeBy: none
		sourceColumn: TenantKey

	column 'Group ID'
		dataType: string
		lineageTag: f1bc0c38-59bc-44ae-8448-6e27ed0e8b7a
