	column 'Loaded Batch ID'
		dataType: string
		isHidden
		lineageTag: c3be806a-0c3c-499f-b805-35cf41029aba
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'Group Activity Evidence' = m
		mode: import
		source =
				let
				 Readers = CreatePreparedReaders(),
				 Raw = Table.PromoteHeaders(Csv.Document(Readers[GetPreparedEvidenceFile]("GroupActivityEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]), [PromoteAllScalars=true]),
				 Selected = Table.SelectColumns(Raw, {"TenantKey", "Group ID", "Group Name", "Group Type", "Teams State", "Activity State", "Days Since Last Activity", "Last Activity Date", "Owner State", "Member Count", "External Member Count", "External Access State", "Received Email Count", "SharePoint Active File Count", "Viva Engage Posted Message Count", "Storage Used GB", "Risk Priority", "Risk Signal", "Recommended Action", "Snapshot Date", "Evidence Status"}),
				 Scoped = if List.AllTrue(List.Transform(Table.Column(Selected, "TenantKey"), each _ = PreparedExpectedTenantKey)) then Selected else error "Foreign or missing tenant",
				 Nulls = Table.ReplaceValue(Scoped, "", null, Replacer.ReplaceValue, {"Days Since Last Activity", "Last Activity Date", "Member Count", "External Member Count", "Received Email Count", "SharePoint Active File Count", "Viva Engage Posted Message Count", "Storage Used GB", "Snapshot Date"}),
				 Typed = Table.TransformColumnTypes(Nulls, {{"TenantKey", type text}, {"Group ID", type text}, {"Group Name", type text}, {"Group Type", type text}, {"Teams State", type text}, {"Activity State", type text}, {"Days Since Last Activity", Int64.Type}, {"Last Activity Date", type datetime}, {"Owner State", type text}, {"Member Count", Int64.Type}, {"External Member Count", Int64.Type}, {"External Access State", type text}, {"Received Email Count", Int64.Type}, {"SharePoint Active File Count", Int64.Type}, {"Viva Engage Posted Message Count", Int64.Type}, {"Storage Used GB", type number}, {"Risk Priority", type text}, {"Risk Signal", type text}, {"Recommended Action", type text}, {"Snapshot Date", type datetime}, {"Evidence Status", type text}}, "en-US")
				in
				 Readers[Finish](Typed)
