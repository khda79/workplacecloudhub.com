/// One synthetic user security capability and privileged-access protection observation per reporting date.
table 'Identity Security Status'
	lineageTag: 7e03211b-05b6-493a-8e47-e3e009d5ec98

	/// Enabled human users recorded as MFA capable divided by the observed MFA-eligible enabled human population.
	measure 'MFA-capable users (%)' = VAR _capableUsers = CALCULATE(DISTINCTCOUNT('Identity Security Status'[User Key]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('Identity Security Status'[MFA Capable] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) VAR _eligibleUsers = CALCULATE(DISTINCTCOUNT('Identity Security Status'[User Key]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) RETURN DIVIDE(_capableUsers, _eligibleUsers)
		formatString: 0.0%
		displayFolder: Security Coverage
		lineageTag: 65733388-7d9d-4ee8-b520-1696b61d634e

	/// Observed privileged enabled human accounts protected by both MFA capability and PIM divided by the governed privileged population.
	measure 'Privileged accounts protected (%)' = VAR _protectedAccounts = CALCULATE(DISTINCTCOUNT('Identity Security Status'[User Key]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('Identity Security Status'[Privileged Account] = TRUE()), KEEPFILTERS('Identity Security Status'[MFA Capable] = TRUE()), KEEPFILTERS('Identity Security Status'[PIM Protected] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) VAR _privilegedAccounts = CALCULATE(DISTINCTCOUNT('Identity Security Status'[User Key]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('Identity Security Status'[Privileged Account] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) RETURN DIVIDE(_protectedAccounts, _privilegedAccounts)
		formatString: 0.0%
		displayFolder: Security Coverage
		lineageTag: 8083ced7-57df-44f7-ac3a-2d330ac53b47

	/// Enabled human users recorded as passwordless capable divided by the observed MFA-eligible enabled human population.
	measure 'Passwordless-capable users (%)' = VAR _capableUsers = CALCULATE(DISTINCTCOUNT('Identity Security Status'[User Key]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('Identity Security Status'[Passwordless Capable] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) VAR _eligibleUsers = CALCULATE(DISTINCTCOUNT('Identity Security Status'[User Key]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) RETURN DIVIDE(_capableUsers, _eligibleUsers)
		formatString: 0.0%
		displayFolder: Secondary Security Indicators
		lineageTag: 750e8dc5-684f-41a3-902d-f21582863b2a

	/// Successful MFA challenges divided by observed MFA challenges for the eligible enabled human population.
	measure 'MFA challenge success rate (%)' = VAR _successfulChallenges = CALCULATE(SUM('Identity Security Status'[MFA Successful Challenge Count]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) VAR _challengeCount = CALCULATE(SUM('Identity Security Status'[MFA Challenge Count]), KEEPFILTERS('Identity Security Status'[Evidence Status] = "Observed"), KEEPFILTERS('Identity Security Status'[Security Population] = "Human"), KEEPFILTERS('Identity Security Status'[MFA Eligible] = TRUE()), KEEPFILTERS('User'[Account State] = "Enabled")) RETURN DIVIDE(_successfulChallenges, _challengeCount)
		formatString: 0.0%
		displayFolder: Secondary Security Indicators
		lineageTag: 4a1ebcd9-0269-4967-8264-a71b6d041cf2

	/// Reporting-date key for the observation.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: a4809ade-820b-4e62-b72a-201fcf3781fe
		summarizeBy: none
		sourceColumn: Date Key

	/// Synthetic tenant key.
	column 'Tenant Key'
		dataType: int64
		isHidden
