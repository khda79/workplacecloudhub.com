		summarizeBy: none
		sourceColumn: MFA Challenge Count

	/// Successful observed MFA challenges for the reporting period.
	column 'MFA Successful Challenge Count'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: c8700184-c812-44c8-9db5-1980277b5aa8
		summarizeBy: none
		sourceColumn: MFA Successful Challenge Count

	/// Qualification state for the security observation.
	column 'Evidence Status'
		dataType: string
		lineageTag: 2e092ea3-a187-4bb0-ab72-10be7fdfe3fb
		sourceColumn: Evidence Status

	partition 'Identity Security Status Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Date Key" = Int64.Type, #"Tenant Key" = Int64.Type, #"Environment Key" = Int64.Type, #"User Key" = Int64.Type, #"Security Population" = nullable text, #"MFA Eligible" = nullable logical, #"MFA Capable" = nullable logical, #"Passwordless Capable" = nullable logical, #"Privileged Account" = nullable logical, #"PIM Protected" = nullable logical, #"MFA Challenge Count" = Int64.Type, #"MFA Successful Challenge Count" = Int64.Type, #"Evidence Status" = nullable text], {
				        {20260915, 1, 1, 1, "Human", true, true, true, true, true, 12, 12, "Observed"},
				        {20260915, 1, 1, 2, "Human", true, true, false, false, false, 6, 5, "Observed"},
				        {20260915, 1, 1, 3, "Human", false, false, false, false, false, 0, 0, "Observed"},
				        {20260915, 1, 1, 4, "External", true, true, true, false, false, 10, 10, "Observed"},
				        {20260915, 1, 1, 5, "Human", true, false, false, true, false, 2, 1, "Observed"},
				        {20260915, 1, 1, 6, "Human", true, true, false, false, false, 8, 8, "Observed"}
				    })
				in
				    Source

