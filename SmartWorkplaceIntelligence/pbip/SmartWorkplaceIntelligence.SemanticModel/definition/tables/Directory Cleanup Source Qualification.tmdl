	partition 'Directory Cleanup Source Qualification' = m
		mode: import
		source =
				let
				 Readers = CreatePreparedReaders(),
				 Raw = Table.PromoteHeaders(Csv.Document(Readers[GetPreparedEvidenceFile]("DirectoryCleanupSourceQualification.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]), [PromoteAllScalars=true]),
				 Selected = Table.SelectColumns(Raw, {"TenantKey", "Source", "File", "Producer", "Status", "Reason", "Rows", "Collected UTC", "Report Refresh Date", "Out Of Scope Rows", "Unkeyable Rows", "Reference UTC", "Evidence Date"}),
				 Scoped = if List.AllTrue(List.Transform(Table.Column(Selected, "TenantKey"), each _ = PreparedExpectedTenantKey)) then Selected else error "Foreign or missing tenant",
				 Nulls = Table.ReplaceValue(Scoped, "", null, Replacer.ReplaceValue, {"Rows", "Out Of Scope Rows", "Unkeyable Rows"}),
				 Typed = Table.TransformColumnTypes(Nulls, {{"TenantKey", type text}, {"Source", type text}, {"File", type text}, {"Producer", type text}, {"Status", type text}, {"Reason", type text}, {"Rows", Int64.Type}, {"Collected UTC", type text}, {"Report Refresh Date", type text}, {"Out Of Scope Rows", Int64.Type}, {"Unkeyable Rows", Int64.Type}, {"Reference UTC", type text}, {"Evidence Date", type text}}, "en-US"),
				 Dates = Table.TransformColumns(Typed, {{"Collected UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Report Refresh Date", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Reference UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Evidence Date", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}})
				in
				 Readers[Finish](Dates)
