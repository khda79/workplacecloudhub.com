/// SPO means SharePoint Online. Grain: Scope Key; source: one selected immutable prepared batch.
table 'SPO Migration Scope'
	isHidden
	lineageTag: f0f0617f-63db-4f95-9d5f-3294c3220d9f

	/// Prepared, tenant-qualified migration evidence: TenantKey.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: b7a194ab-4cc9-4c18-9e57-3e59a00c43cc
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared, tenant-qualified migration evidence: Project Key.
