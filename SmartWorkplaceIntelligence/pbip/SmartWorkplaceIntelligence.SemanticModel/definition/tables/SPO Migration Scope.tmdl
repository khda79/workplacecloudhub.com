			relationship: 34b20d78-9e75-458a-be34-8a3b2c6a9608
			defaultHierarchy: LocalDateTable_a0cc9fe0-d3b1-4526-8fee-f1c3ed7fdc06.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	/// Prepared, tenant-qualified migration evidence: Scope Key.
