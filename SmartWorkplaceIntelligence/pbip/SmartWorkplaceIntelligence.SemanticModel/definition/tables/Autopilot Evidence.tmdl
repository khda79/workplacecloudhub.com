/// Native source facet migrated from FactAutopilotDevice; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Autopilot Evidence'
	lineageTag: 6e96eae8-29a5-49e8-adf6-ad4f62bd7144

	/// Windows Autopilot device identities observed in the frozen collection. Migrated without changing the source calculation.
	measure 'Native Autopilot devices' = (COALESCE(COUNTROWS('Autopilot Evidence'),0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: edb4b3c2-79bc-458c-9c2f-28f504ff060a

	/// Autopilot rows explicitly reported with enrollment state enrolled. Migrated without changing the source calculation.
	measure 'Native Autopilot enrolled devices' = (CALCULATE([Native Autopilot devices],KEEPFILTERS('Autopilot Evidence'[EnrollmentState] = "enrolled")))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 71463cc1-a650-4b74-b4b5-5d30e6a1aa6e

	/// Share of each Autopilot enrollment state within exact matched Intune devices. Migrated without changing the source calculation.
	measure 'Native Autopilot enrollment rate' = (DIVIDE([Native Selected Autopilot devices], CALCULATE([Native Selected Autopilot devices], REMOVEFILTERS('Autopilot Evidence'[EnrollmentState]))))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: 123cf284-0cc2-4824-b162-96d79fecc153

	/// Autopilot records linked by exact Intune managed-device identifier to the filtered device population. Migrated without changing the source calculation.
	measure 'Native Selected Autopilot devices' = (VAR _deviceKeys = VALUES('Native Device Evidence'[TenantDeviceKey]) VAR _intuneIds = CALCULATETABLE(VALUES('Device Source Evidence'[SourceObjectId]), TREATAS(_deviceKeys, 'Device Source Evidence'[TenantDeviceKey]), KEEPFILTERS('Device Source Evidence'[SourceSystem] = "Intune")) RETURN CALCULATE(DISTINCTCOUNT('Autopilot Evidence'[ManagedDeviceId]), TREATAS(_intuneIds, 'Autopilot Evidence'[ManagedDeviceId])))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 44b6eb48-7f19-4b95-9956-34c578e1c55d

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Autopilot Evidence' = (COUNTROWS('Autopilot Evidence'))
		formatString: #,0
		isHidden
		lineageTag: 93a4c33c-f65f-4c1d-a220-73e9f4d6c352

