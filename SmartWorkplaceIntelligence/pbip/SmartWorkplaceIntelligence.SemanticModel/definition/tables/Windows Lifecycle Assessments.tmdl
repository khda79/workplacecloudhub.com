/// Synthetic Windows adoption, readiness, and lifecycle assessments.
table 'Windows Lifecycle Assessments'
	lineageTag: fdafd7ae-43ca-449a-bdf9-6ea1de895cdb

	/// Active Windows devices with qualified lifecycle evidence.
	measure '# Active Windows Devices' = CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[Operating System Family] IN {"Windows 10", "Windows 11"}), KEEPFILTERS('Windows Lifecycle Assessments'[Evidence Status] = "Observed"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 1428ab39-eeda-4145-8a24-9cde06590204

	/// Windows 11 devices divided by assessed Windows 10 and Windows 11 devices.
	measure 'Windows 11 Adoption (%)' = DIVIDE(CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[Operating System Family] = "Windows 11")), CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[Operating System Family] IN {"Windows 10", "Windows 11"})))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 0dbc9a4e-1b44-48fe-90cb-af483d393839

	/// Ready Windows 10 devices divided by assessed Windows 10 devices with a known result.
	measure 'Windows 11 Readiness (%)' = DIVIDE(CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[Operating System Family] = "Windows 10"), KEEPFILTERS('Windows Lifecycle Assessments'[Readiness State] = "Ready")), CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[Operating System Family] = "Windows 10"), KEEPFILTERS('Windows Lifecycle Assessments'[Readiness State] IN {"Ready", "Blocked"})))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 3f6f41eb-7e8b-40fe-ba0f-c3cc49fa453a

	/// Devices at or within one year of end of support in the selected scope.
	measure '# End-of-Support Devices' = VAR _warningDate = MAX('Date'[Date]) + 365 RETURN CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[End Of Support Date] <= _warningDate))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 188f8292-02e8-4b8b-a48f-7b8f4b67fcd2

	/// Devices with a qualified readiness assessment.
	measure '# Assessed Devices' = CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[Readiness State] IN {"Ready", "Blocked"}))
		formatString: #,0
		displayFolder: Measures
		lineageTag: cc1b3273-e4db-493c-b037-05718e4dbd9a

	/// Observed Windows 10 devices remaining in the assessed Windows estate.
	measure '# Windows 10 Remaining' = CALCULATE(DISTINCTCOUNT('Windows Lifecycle Assessments'[Device Key]), KEEPFILTERS('Windows Lifecycle Assessments'[Operating System Family] = "Windows 10"), KEEPFILTERS('Windows Lifecycle Assessments'[Evidence Status] = "Observed"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 5fb84c3e-6020-48e0-8e1a-7d2000ca0af0

	/// Business attribute Date Key.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
