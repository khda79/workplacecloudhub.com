	partition 'Windows Lifecycle Assessments Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Date Key" = Int64.Type, #"Tenant Key" = Int64.Type, #"Environment Key" = Int64.Type, #"Geography Key" = Int64.Type, #"Device Key" = Int64.Type, #"Operating System Family" = nullable text, #"Readiness State" = nullable text, #"Blocker Category" = nullable text, #"End Of Support Date" = nullable datetime, #"Evidence Status" = nullable text], {
				        {20260915, 1, 1, 1, 1, "Windows 11", "Adopted", "None", #datetime(2027, 11, 9, 0, 0, 0), "Observed"},
				        {20260915, 1, 1, 1, 2, "Windows 10", "Ready", "None", #datetime(2025, 10, 14, 0, 0, 0), "Observed"},
