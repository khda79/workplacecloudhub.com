			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg,"%","%25"),"#","%23"),"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 908 210' font-family='Segoe UI, sans-serif'><rect x='1' y='1' width='906' height='208' rx='12' fill='%23FFFFFF' stroke='%23D7E1EC' stroke-width='2'/><text x='20' y='39' font-size='23' fill='%2314253E' font-weight='600'>Updates</text><line x1='20' y1='59' x2='888' y2='59' stroke='%23DEE6EE'/><text x='20' y='85' font-size='18' fill='%23526276' >Windows Update</text><text x='345' y='85' font-size='18' fill='%23717D8D'>—</text><line x1='20' y1='102' x2='888' y2='102' stroke='%23DEE6EE'/><text x='20' y='128' font-size='18' fill='%23526276' >Reboot required</text><text x='345' y='128' font-size='18' fill='%23717D8D'>—</text><line x1='20' y1='145' x2='888' y2='145' stroke='%23DEE6EE'/><text x='20' y='171' font-size='18' fill='%23526276' >System evidence age</text><text x='345' y='171' font-size='18' fill='%23717D8D'>—</text></svg>")
