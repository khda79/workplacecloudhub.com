/// Disconnected presentation rows for Device 360.
table 'Device 360 Properties'
	isHidden
	lineageTag: 5f21d57a-fc69-49de-be0b-58376f931284

	measure 'Device 360 Property Value' =
			IF([Device 360 Single Selection]=1, VAR V = SWITCH(SELECTEDVALUE('Device 360 Properties'[Property]),
			"Primary user", FORMAT(SELECTEDVALUE('Global Device Inventory'[Primary User (report)]),""),
			"Last console user", FORMAT(SELECTEDVALUE('Global Device Inventory'[Last Console User (report)]),""),
			"Last console logon (UTC)", FORMAT(SELECTEDVALUE('Global Device Inventory'[Last Console Logon UTC (report)]),"yyyy-MM-dd HH:mm"),
			"Country", FORMAT(SELECTEDVALUE('Global Device Inventory'[Country Name]),""),
			"AD domain", FORMAT(SELECTEDVALUE('Global Device Inventory'[AD Domain]),""),
			"Manufacturer", FORMAT(SELECTEDVALUE('Global Device Inventory'[Manufacturer]),""),
			"Model", FORMAT(SELECTEDVALUE('Global Device Inventory'[Model]),""),
			"Platform", FORMAT(SELECTEDVALUE('Global Device Inventory'[Platform (report)]),""),
			"OS version", FORMAT(SELECTEDVALUE('Global Device Inventory'[Operating System Version]),""),
			"Windows release", FORMAT(SELECTEDVALUE('Global Device Inventory'[Windows Release]),""),
			"AD account enabled", FORMAT(SELECTEDVALUE('Global Device Inventory'[AD Enabled]),""),
			"Entra account state", FORMAT(SELECTEDVALUE('Global Device Inventory'[Entra state (report)]),""),
			"Ownership", FORMAT(SELECTEDVALUE('Global Device Inventory'[Ownership (report)]),""),
			"Secure Boot", FORMAT(SELECTEDVALUE('Global Device Inventory'[Secure Boot State]),""),
			"Intune encryption", FORMAT(SELECTEDVALUE('Global Device Inventory'[Intune Encryption State]),""),
			"BitLocker OS protection", FORMAT(SELECTEDVALUE('Global Device Inventory'[BitLocker OS Protection]),""),
			"BitLocker conversion", FORMAT(SELECTEDVALUE('Global Device Inventory'[BitLocker OS Conversion]),""),
			"Windows Update", FORMAT(SELECTEDVALUE('Global Device Inventory'[Windows Update State]),""),
			"System evidence freshness", FORMAT(SELECTEDVALUE('Global Device Inventory'[System Freshness]),""),
			"Windows 11 eligibility", FORMAT(SELECTEDVALUE('Global Device Inventory'[Windows 11 Upgrade Eligibility]),""),
			"Deployment risk", FORMAT(SELECTEDVALUE('Global Device Inventory'[Cached Inventory Windows 11 Deployment Risk]),""),
			"Blocking reasons", FORMAT(SELECTEDVALUE('Global Device Inventory'[Windows 11 Blocking Reasons]),""),
			"Intune enrollment risk", FORMAT(SELECTEDVALUE('Global Device Inventory'[Cached Inventory Enrollment Risk]),""),
			"Assessment scope", FORMAT(SELECTEDVALUE('Global Device Inventory'[Cached Inventory Enrollment Risk Reasons]),""),
			"Recommended action", FORMAT(SELECTEDVALUE('Global Device Inventory'[Cached Inventory Enrollment Action]),""),
			"Canonical device ID", FORMAT(SELECTEDVALUE('Global Device Inventory'[Canonical Device Key]),""),
			"Tenant", FORMAT(SELECTEDVALUE('Global Device Inventory'[TenantKey]),""),
			"Autopilot serial numbers", FORMAT(SELECTEDVALUE('Global Device Inventory'[Autopilot serial numbers]),""))
			RETURN IF(LEN(V)=0, "Not observed", SWITCH(V, "FullyEncrypted","Fully encrypted", V)))
		displayFolder: Device 360
		lineageTag: 6c063ab1-eb2b-4e92-bf56-21cb33a7ffef

	measure 'Device 360 Missing Value' = VAR V=[Device 360 Property Value] RETURN IF(NOT ISBLANK(V), LEFT(V,7)="Unknown" || V IN {"Not observed","Not resolved","Not assessed","Not applicable"})
		displayFolder: Device 360
		lineageTag: da0fc055-2b34-4742-865b-851397502605

	measure 'Device 360 Property Color' = VAR V=[Device 360 Property Value] VAR P=SELECTEDVALUE('Device 360 Properties'[Property]) RETURN SWITCH(TRUE(), [Device 360 Missing Value], "#596676", P IN {"Secure Boot","Intune encryption","BitLocker OS protection","BitLocker conversion"} && V IN {"Enabled","Encrypted","On","Fully encrypted"}, "#126147", P IN {"Secure Boot","Intune encryption","BitLocker OS protection","BitLocker conversion"} && V IN {"Disabled","Not encrypted","Off"}, "#901F30", "#14253E")
		displayFolder: Device 360
		lineageTag: 89ff8b58-7863-49ee-9eb2-0c70f7a314cd

	measure 'Device 360 Coverage' = IF([Device 360 Single Selection]=1, VAR Total=COUNTROWS('Device 360 Properties') VAR Obs=COUNTROWS(FILTER('Device 360 Properties',NOT CALCULATE([Device 360 Missing Value]))) RETURN COALESCE(Obs,0)&"/"&Total&" observed")
		displayFolder: Device 360
		lineageTag: 7d6eceb8-5946-48f2-a689-9158536c7fe6

	measure 'Device 360 Hero' = IF([Device 360 Single Selection]=1, VAR Maker=SELECTEDVALUE('Global Device Inventory'[Manufacturer]) VAR ModelName=SELECTEDVALUE('Global Device Inventory'[Model]) VAR OS=COALESCE(SELECTEDVALUE('Global Device Inventory'[Windows Release]),SELECTEDVALUE('Global Device Inventory'[Platform (report)])) VAR Country=SELECTEDVALUE('Global Device Inventory'[Country Name]) RETURN CONCATENATEX(FILTER({TRIM(Maker&" "&ModelName),OS,IF(LEFT(Country,7)<>"Unknown",Country)},LEN([Value])>0),[Value]," · "))
		displayFolder: Device 360
		lineageTag: 9b76697b-08cb-4861-8839-864232554da5

	measure 'Device 360 Source Coverage' = IF([Device 360 Single Selection]=1, VAR S=SELECTEDVALUE('Global Device Inventory'[Inventory Source]) VAR A=SELECTEDVALUE('Global Device Inventory'[Autopilot link status]) RETURN SWITCH(TRUE(),S="Entra only","Known in Entra only. AD, Intune and Autopilot details are unavailable for this device.",S="AD + Entra + Intune" && A="Not observed in Autopilot","Known in AD, Entra and Intune. Autopilot details were not observed for this device.",NOT ISBLANK(S),"Inventory source: "&S&" · Autopilot: "&COALESCE(A,"Not observed"),"Source coverage not observed"))
		displayFolder: Device 360
		lineageTag: f8349bfd-e50f-47e2-9639-ed6d5ce4defe

	measure 'Device 360 Last Sync Display' = IF([Device 360 Single Selection]=1, VAR D=SELECTEDVALUE('Global Device Inventory'[Last Sync DateTime]) RETURN IF(ISBLANK(D),"Not observed",FORMAT(D,"yyyy-MM-dd HH:mm")&" UTC"))
		displayFolder: Device 360
		lineageTag: 699ef613-afcf-432b-b0c5-fef81ddaf000

	measure 'Device 360 Disk Used' = IF([Device 360 Single Selection]=1, VAR F=SELECTEDVALUE('Global Device Inventory'[Free Disk Space (%)]) VAR C=SELECTEDVALUE('Global Device Inventory'[System Drive Capacity (GB)]) RETURN IF(C>0 && NOT ISBLANK(F) && F>=0 && F<=100,1-DIVIDE(F,100)))
		formatString: 0.0%
		displayFolder: Device 360
		lineageTag: 79f7e6c5-e3e7-4c26-8b1f-90e863ffe902

	measure 'Device 360 Disk Display' = IF([Device 360 Single Selection]=1, VAR U=[Device 360 Disk Used] VAR F=SELECTEDVALUE('Global Device Inventory'[Free Disk Space (GB)]) VAR C=SELECTEDVALUE('Global Device Inventory'[System Drive Capacity (GB)]) RETURN IF(ISBLANK(U),"Not observed",FORMAT(U,"0.0%")&" used"&IF(NOT ISBLANK(F)," · "&FORMAT(F,"0.0")&" GB free / "&FORMAT(C,"0.0")&" GB")))
		displayFolder: Device 360
		lineageTag: 9e7678ab-1cb6-4bc2-8da8-27dddde73457

	measure 'Device 360 Identity AD' = IF([Device 360 Single Selection]=1, IF(NOT ISBLANK(SELECTEDVALUE('Global Device Inventory'[AD Computer Key])),"Matched","Not observed"))
		displayFolder: Device 360
		lineageTag: 765938f2-26fc-4c78-abfd-6bdf65a6f3d0

	measure 'Device 360 Identity Entra' = IF([Device 360 Single Selection]=1, VAR E=SELECTEDVALUE('Global Device Inventory'[Entra Match]) RETURN IF(SELECTEDVALUE('Global Device Inventory'[Inventory Source])="Entra only","Observed",COALESCE(E,"Not observed")))
		displayFolder: Device 360
		lineageTag: 66a7bbe2-8975-44f4-96de-f48e02187797

	measure 'Device 360 Identity Intune' = IF([Device 360 Single Selection]=1, VAR I=SELECTEDVALUE('Global Device Inventory'[Intune presence]) RETURN SWITCH(I,"In Intune","Matched","Not found in Intune","Not found",COALESCE(I,"Not observed")))
		displayFolder: Device 360
		lineageTag: ed37b410-2030-4f31-b967-c9e9fabf65a6

	measure 'Device 360 Identity Autopilot' = IF([Device 360 Single Selection]=1, VAR A=SELECTEDVALUE('Global Device Inventory'[Autopilot link status]) RETURN IF(A="Not observed in Autopilot","Not observed",COALESCE(A,"Not observed")))
		displayFolder: Device 360
		lineageTag: 4409d20a-86d3-4bdc-8d10-a9018fab1c2f

	measure 'Device 360 Batch Footer' = "Data as of batch "&COALESCE(SELECTEDVALUE('Global Device Inventory'[Loaded Batch ID]),"not observed")
