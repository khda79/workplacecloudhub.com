	measure 'Device 360 App Coverage Note' = IF([Device 360 Single Selection]=1, VAR Partial=CALCULATE(COUNTROWS(FILTER(SUMMARIZE('Native Discovered Application','Native Discovered Application'[TenantApplicationKey]),[Device 360 Detected App Rows]>0)),KEEPFILTERS('Native Discovered Application'[RelationshipCoverageStatus]<>"Complete")) RETURN IF(Partial>0,FORMAT(Partial,"0")&" detected app entries have partial device-link coverage at catalog level. The links shown are resolved for this PC.","Detected applications with a resolved link to this PC."))
