	partition 'Device 360 Properties' = calculated
		mode: import
		source =
				DATATABLE("Section", STRING, "Property", STRING, "SortOrder", INTEGER, {
				{ "Identity & user", "Primary user", 1 },
				{ "Identity & user", "Last console user", 2 },
				{ "Identity & user", "Last console logon (UTC)", 3 },
				{ "Identity & user", "Country", 4 },
				{ "Identity & user", "AD domain", 5 },
				{ "Hardware & operating system", "Manufacturer", 6 },
				{ "Hardware & operating system", "Model", 7 },
