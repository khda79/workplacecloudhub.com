			 & "<line x1='20' y1='102' x2='888' y2='102' stroke='#DEE6EE'/>" & "<text x='20' y='128' font-size='18' fill='#526276' >Reboot required</text>" & "<text x='345' y='128' font-size='18' " & Style1 & ">" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(LEN(Value1)>51,LEFT(Value1,50)&"…",Value1),"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>"
