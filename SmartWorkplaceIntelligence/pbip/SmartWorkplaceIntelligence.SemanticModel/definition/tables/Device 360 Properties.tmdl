	measure 'Device 360 Native Intune ID' = IF([Device 360 Single Selection]=1, VAR K=SELECTEDVALUE('Global Device Inventory'[Native Device Key]) VAR T=SELECTEDVALUE('Global Device Inventory'[TenantKey]) VAR B=SELECTEDVALUE('Global Device Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(K) && NOT ISBLANK(T) && NOT ISBLANK(B),CALCULATE(SELECTEDVALUE('Native Managed Device Evidence'[ManagedDeviceId]),TREATAS({K},'Native Managed Device Evidence'[TenantDeviceKey]),TREATAS({T},'Native Managed Device Evidence'[TenantKey]),TREATAS({B},'Native Managed Device Evidence'[Loaded Batch ID]))))
