	measure 'Device 360 Panel System drive' =
			IF([Device 360 Single Selection]=1, VAR U=[Device 360 Disk Used] VAR _DriveCaption=[Device 360 Disk Display]
			VAR _Shade=SWITCH(TRUE(),ISBLANK(U),"#64748B",U>=0.90,"#C63643",U>=0.80,"#CD830E","#188661")
			VAR _BarWidth=IF(ISBLANK(U),0,ROUND(860*U,0))
			VAR _Svg="<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 908 123' font-family='Segoe UI, sans-serif'><rect x='1' y='1' width='906' height='121' rx='12' fill='#FFFFFF' stroke='#D7E1EC' stroke-width='2'/><text x='20' y='35' font-size='23' font-weight='600' fill='#14253E'>System drive</text><text x='20' y='68' font-size='19' " & IF(_DriveCaption="Not observed","font-style='italic' fill='#596676'","fill='#14253E'") & ">" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(_DriveCaption,"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" & IF(NOT ISBLANK(U),"<rect x='20' y='88' width='860' height='12' rx='6' fill='#E4ECF4'/><rect x='20' y='88' width='" & FORMAT(_BarWidth,"0") & "' height='12' rx='6' fill='" & _Shade & "'/>") & "</svg>"
			RETURN "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_Svg,"%","%25"),"#","%23"),"data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 908 123' font-family='Segoe UI, sans-serif'><rect x='1' y='1' width='906' height='121' rx='12' fill='%23FFFFFF' stroke='%23D7E1EC' stroke-width='2'/><text x='20' y='35' font-size='23' font-weight='600' fill='%2314253E'>System drive</text><text x='20' y='68' font-size='19' fill='%23717D8D'>—</text></svg>")
