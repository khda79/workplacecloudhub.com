		lineageTag: 28e919a8-c101-491c-bd8b-4162cceee308

	measure 'Device 360 Intune Color' = VAR S=LOWER([Device 360 · Intune presence]) RETURN SWITCH(TRUE(),S IN {"in intune","compliant","encrypted","matched","observed","linked","enabled","on","fully encrypted"},"#126147",CONTAINSSTRING(S,"not found") || S IN {"failed","noncompliant","not compliant","not encrypted","unencrypted","disabled","off","error"},"#901F30",CONTAINSSTRING(S,"unknown") || CONTAINSSTRING(S,"ambiguous") || S IN {"not assessed","conflict","in grace period"},"#754600", S="not observed"||ISBLANK(S),"#596676","#2E4E82")
