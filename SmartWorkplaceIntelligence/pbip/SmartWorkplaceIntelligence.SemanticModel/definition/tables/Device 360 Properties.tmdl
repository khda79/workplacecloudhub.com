			VAR Style0 = SWITCH(Chip0,"#E0F3E9","fill='#126147'","#FCE4E7","fill='#9A2434'","#FDF0D6","fill='#74440B'",IF(LEFT(Value0,7)="Unknown" || Value0 IN {"Not observed","Not resolved","Not assessed","Not applicable"},"font-style='italic' fill='#596676'","fill='#14253E'"))
