	measure 'Device 360 Policy Display' = IF([Device 360 Policy Rows]>0,SWITCH(SELECTEDVALUE('Intune Configuration Device Evidence'[Reported Application State]),"ReportedApplied","Applied","ReportedIssue","Issue reported","Pending","Pending","NotApplicable","Not applicable","Unknown","Unknown","Not observed"))
		displayFolder: Device 360 · Presentation
		lineageTag: 95e04140-5ddc-4a7d-b871-e366eeeed605

	measure 'Device 360 Deployment Sort Display' = IF([Device 360 Managed App Rows]>0,SWITCH(SELECTEDVALUE('Intune Managed App Deployment Evidence'[Device 360 Install Status]),"Failed",1,"Installed",2,"Not applicable",3,"Pending",4,"Not installed",5,6))
		displayFolder: Device 360 · Presentation
		lineageTag: cdde9b31-2b00-46c2-b88a-20c4c869732b

	measure 'Device 360 Panel Identity & user' =
			IF([Device 360 Single Selection]=1, VAR R0 = CALCULATE([Device 360 Property Value],REMOVEFILTERS('Device 360 Properties'),'Device 360 Properties'[Property]="Primary user")
			VAR Value0 = IF(LEN(R0)=0,"Not observed", R0)
			VAR Style0 = IF(LEFT(Value0,7)="Unknown" || Value0 IN {"Not observed","Not resolved","Not assessed","Not applicable"},"font-style='italic' fill='#596676'",IF(Value0 IN {"Enabled","Encrypted","On","Fully encrypted","Success","Detected","No","Already upgraded"},"fill='#126147'","fill='#14253E'"))
			VAR R1 = CALCULATE([Device 360 Property Value],REMOVEFILTERS('Device 360 Properties'),'Device 360 Properties'[Property]="Last console user")
			VAR Value1 = IF(LEN(R1)=0,"Not observed", R1)
			VAR Style1 = IF(LEFT(Value1,7)="Unknown" || Value1 IN {"Not observed","Not resolved","Not assessed","Not applicable"},"font-style='italic' fill='#596676'",IF(Value1 IN {"Enabled","Encrypted","On","Fully encrypted","Success","Detected","No","Already upgraded"},"fill='#126147'","fill='#14253E'"))
			VAR R2 = CALCULATE([Device 360 Property Value],REMOVEFILTERS('Device 360 Properties'),'Device 360 Properties'[Property]="Last console logon (UTC)")
			VAR Value2 = IF(LEN(R2)=0,"Not observed", R2)
			VAR Style2 = IF(LEFT(Value2,7)="Unknown" || Value2 IN {"Not observed","Not resolved","Not assessed","Not applicable"},"font-style='italic' fill='#596676'",IF(Value2 IN {"Enabled","Encrypted","On","Fully encrypted","Success","Detected","No","Already upgraded"},"fill='#126147'","fill='#14253E'"))
			VAR R3 = CALCULATE([Device 360 Property Value],REMOVEFILTERS('Device 360 Properties'),'Device 360 Properties'[Property]="Country")
			VAR Value3 = IF(LEN(R3)=0,"Not observed", R3)
