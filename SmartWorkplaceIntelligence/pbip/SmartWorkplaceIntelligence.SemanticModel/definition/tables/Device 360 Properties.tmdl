			 & "<rect x='927' y='1' width='449' height='75' rx='11' fill='" & "#FFFFFF" & "' stroke='none' stroke-width='1.4'/>" & "<text x='943' y='28' font-size='16' font-weight='400' fill='" & "#526276" & "'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Managed apps installed","&","&amp;"),"<","&lt;"),">","&gt;") & "</text>" & "<text x='943' y='56' font-size='21' " & IF(ISBLANK([Device 360 Distinct Installed]),"font-weight='400' font-style='italic' fill='#596676'","font-weight='600' fill='#14253E'") & ">" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(COALESCE(IF(ISBLANK([Device 360 Distinct Installed]),"Not observed",FORMAT([Device 360 Distinct Installed],"#,0")),"Not observed"),"&","&amp;"),"<","&lt;"),">","&gt;") & "</text>"
