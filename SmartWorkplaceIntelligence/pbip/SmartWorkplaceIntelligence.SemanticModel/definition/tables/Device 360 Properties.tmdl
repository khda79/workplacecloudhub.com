	measure 'Device 360 Distinct Applied' = VAR I=[Device 360 Native Intune ID] VAR T=SELECTEDVALUE('Global Device Inventory'[TenantKey]) VAR B=SELECTEDVALUE('Global Device Inventory'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(I) && NOT ISBLANK([Device 360 Policies Applied]),COALESCE(CALCULATE(DISTINCTCOUNTNOBLANK('Intune Configuration Device Evidence'[Policy Key]),KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State]="ReportedApplied"),TREATAS({I},'Device Inventory Evidence'[Device Source ID]),TREATAS({T},'Device Inventory Evidence'[TenantKey]),TREATAS({B},'Device Inventory Evidence'[Loaded Batch ID])),0))
