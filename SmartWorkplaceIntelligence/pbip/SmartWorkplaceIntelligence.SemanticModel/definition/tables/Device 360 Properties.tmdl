	measure 'Device 360 Scoped Publisher' = IF([Device 360 Detected App Rows]>0,VAR _Publishers=FILTER(VALUES('Native Discovered Application'[Publisher]),[Device 360 Detected App Rows]>0) VAR _Raw=CONCATENATEX(_Publishers,'Native Discovered Application'[Publisher]," · ",'Native Discovered Application'[Publisher],ASC) VAR _Comma=FIND(",",_Raw,1,0) VAR _Friendly=IF(LEFT(_Raw,3)="CN=",IF(_Comma>3,MID(_Raw,4,_Comma-4),MID(_Raw,4,LEN(_Raw))),_Raw) RETURN IF(LEN(_Friendly)=0,"Not observed",IF(LEN(_Friendly)>42,LEFT(_Friendly,41)&"…",_Friendly)))
		displayFolder: Device 360 · Presentation
		lineageTag: 4bd355db-627a-495f-8d0a-a9588247f207

	measure 'Device 360 Scoped Policy State' = IF([Device 360 Policy Rows]>0,VAR I=[Device 360 Native Intune ID] VAR T=SELECTEDVALUE('Global Device Inventory'[TenantKey]) VAR B=SELECTEDVALUE('Global Device Inventory'[Loaded Batch ID]) RETURN CALCULATE(CONCATENATEX(VALUES('Intune Configuration Device Evidence'[Device 360 View Policy State]),'Intune Configuration Device Evidence'[Device 360 View Policy State]," · ",'Intune Configuration Device Evidence'[Device 360 View Policy State],ASC),TREATAS({I},'Device Inventory Evidence'[Device Source ID]),TREATAS({T},'Device Inventory Evidence'[TenantKey]),TREATAS({B},'Device Inventory Evidence'[Loaded Batch ID])))
		displayFolder: Device 360 · Presentation
		lineageTag: 5d4dc5df-5d1d-426c-84d0-bc6b29810dad

