	measure 'Device 360 Panel System protection' =
			IF([Device 360 Single Selection]=1, VAR R0 = CALCULATE([Device 360 Property Value],REMOVEFILTERS('Device 360 Properties'),'Device 360 Properties'[Property]="Secure Boot")
