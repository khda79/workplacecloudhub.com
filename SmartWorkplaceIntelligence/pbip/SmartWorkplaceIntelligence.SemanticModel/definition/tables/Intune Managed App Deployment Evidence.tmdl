/// Governed IntuneManagedAppDeploymentEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Managed App Deployment Evidence'
	lineageTag: 84ef94b5-0e13-42e1-b837-6340e2a647ec

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune App Deployment Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Managed App Deployment Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 00c29c8a-11ac-4e74-8995-b722b9e5654a

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Reported Installed Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Managed App Deployment Evidence'), KEEPFILTERS('Intune Managed App Deployment Evidence'[Reported Deployment State] = "ReportedInstalled")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: c51e692f-7c20-499c-bbd9-5f6f7639a32f

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Reported Failure Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Managed App Deployment Evidence'), KEEPFILTERS('Intune Managed App Deployment Evidence'[Reported Deployment State] = "ReportedFailure")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 2bb8445b-2259-4136-b6f7-e99329422d7f

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Reported Not Installed Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Managed App Deployment Evidence'), KEEPFILTERS('Intune Managed App Deployment Evidence'[Reported Deployment State] = "ReportedNotInstalled")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 1a0d8ca6-b671-4ab7-89c6-5c77c2885128

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune App Pending Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Managed App Deployment Evidence'), KEEPFILTERS('Intune Managed App Deployment Evidence'[Reported Deployment State] = "Pending")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 516df178-c987-4656-a5de-da711623168c

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune App Unknown Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Managed App Deployment Evidence'), KEEPFILTERS('Intune Managed App Deployment Evidence'[Reported Deployment State] = "Unknown")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 60bcd4b2-5988-4d0c-b3c0-7c68bfb350d2

	/// Distinct tenant-aware identities among the specified reported observations, not verified physical endpoints or full tenant coverage.
	measure 'Intune Managed Apps With Reported Failures' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(DISTINCTCOUNT('Intune Managed App Deployment Evidence'[Application Key]), KEEPFILTERS('Intune Managed App Deployment Evidence'[Application Key] <> BLANK()), KEEPFILTERS('Intune Managed App Deployment Evidence'[Reported Deployment State] = "ReportedFailure")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 7f747a84-a8df-47f6-9e9d-44821c742b4e

	/// Distinct tenant-aware identities among the specified reported observations, not verified physical endpoints or full tenant coverage.
	measure 'Intune App Identified Devices With Failures' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(DISTINCTCOUNT('Intune Managed App Deployment Evidence'[Device Key]), KEEPFILTERS('Intune Managed App Deployment Evidence'[Device Key] <> BLANK()), KEEPFILTERS('Intune Managed App Deployment Evidence'[Reported Deployment State] = "ReportedFailure")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: f1092249-fa9a-43d0-b24b-09cb4e153ee0

