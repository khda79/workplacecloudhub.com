/// One local mailbox per row; native AD/cloud/Workforce license coverage. Not consumed by Exchange migration status.
table 'Mailbox Account License Coverage'
	lineageTag: 6509d17c-850d-5a66-9b11-40b953892d40

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Mailbox Account License Review' =
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _countries=VALUES('Country Selection'[Source Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _ck=FILTER(VALUES('Mailbox Account License Coverage'[Backlog Country]),NOT _cf || 'Mailbox Account License Coverage'[Backlog Country] IN _countries)
			VAR _dk=FILTER(VALUES('Mailbox Account License Coverage'[Backlog AD Domain]),NOT _df || 'Mailbox Account License Coverage'[Backlog AD Domain] IN _domains)
			VAR _missing=FILTER('Mailbox Account License Coverage',(_cf && (ISBLANK('Mailbox Account License Coverage'[Backlog Country]) || 'Mailbox Account License Coverage'[Backlog Country]="Unknown")) || (_df && (ISBLANK('Mailbox Account License Coverage'[Backlog AD Domain]) || 'Mailbox Account License Coverage'[Backlog AD Domain]="Unknown")))
			RETURN IF(SELECTEDVALUE('Backlog Attribution Selection'[Mode],"In scope")="Unassigned evidence",CALCULATE((COALESCE(CALCULATE(DISTINCTCOUNT('Mailbox Account License Coverage'[AD Object GUID]),KEEPFILTERS('Mailbox Account License Coverage'[Coverage State]="License review")),0)),KEEPFILTERS(_missing)),CALCULATE((COALESCE(CALCULATE(DISTINCTCOUNT('Mailbox Account License Coverage'[AD Object GUID]),KEEPFILTERS('Mailbox Account License Coverage'[Coverage State]="License review")),0)),KEEPFILTERS(TREATAS(_ck,'Mailbox Account License Coverage'[Backlog Country])),KEEPFILTERS(TREATAS(_dk,'Mailbox Account License Coverage'[Backlog AD Domain]))))
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: fe5ef56a-46bb-5339-b47e-c7160df142d0

