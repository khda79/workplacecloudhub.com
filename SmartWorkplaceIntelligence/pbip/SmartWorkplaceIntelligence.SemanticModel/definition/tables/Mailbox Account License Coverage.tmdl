		sourceColumn: Loaded Batch ID

	partition 'Mailbox Account License Coverage' = m
		mode: import
		source =
				let
				 R=CreatePreparedReaders(), K=CreateBacklogTools(R),
				 Mail=K[Read]("Source-Exchange_OnPrem_Mailboxes_AllDomains.csv",{"TenantKey","ObjectGUID","ExchangeGuid","DisplayName","UserPrincipalName","RecipientType"}),
				 Local=Table.SelectRows(Mail,each not Text.StartsWith(K[Key]([RecipientType]),"remote")),
				 A=K[Index](K[Read]("ADUserSource.csv",{"TenantKey","ObjectGUID","CloudMatchStatus","TenantUserKey","Enabled","DomainName"}),"ObjectGUID"),
				 U=K[Index](K[Read]("DimUser.csv",{"TenantKey","TenantUserKey","SourceUserId"}),"TenantUserKey"),
				 W=K[Index](K[Read]("UserInventoryEvidence.csv",{"TenantKey","User Source ID","Account State","Identity Match Status","Has M365 License","M365 License Count"}),"User Source ID"),
				 C=K[Index](K[Read]("AllAccountsEvidence.csv",{"TenantKey","Account Key","Country"}),"Account Key"),
				 Project=(r as record) as record =>
				  let AD=K[Match](A,r[TenantKey],r[ObjectGUID],K[Batch]), Native=AD[State]="Matched" and K[Field](AD,"CloudMatchStatus")="Unique native SID",
				      DU=K[Match](U,r[TenantKey],if Native then K[Field](AD,"TenantUserKey") else null,K[Batch]),
				      WF=K[Match](W,r[TenantKey],if DU[State]="Matched" then K[Field](DU,"SourceUserId") else null,K[Batch]),
				      Link=Native and DU[State]="Matched" and K[Key](K[Field](DU,"SourceUserId"))<>"",
				      Count=try Number.FromText(K[Field](WF,"M365 License Count"),"en-US") otherwise null,
				      Review=Link and WF[State]="Matched" and K[Key](K[Field](AD,"Enabled"))="true" and K[Field](WF,"Account State")="Enabled" and K[Field](WF,"Identity Match Status")="Matched" and K[Field](WF,"Has M365 License")="No" and Count=0,
				      State=if not Link then "No usable native link" else if WF[State]<>"Matched" then "No Workforce row" else if Review then "License review" else "Observed assignment or other state",
				      Co=K[Match](C,r[TenantKey],"ad:"&K[Key](r[ObjectGUID]),K[Batch])
				  in [TenantKey=r[TenantKey],#"Mailbox GUID"=r[ExchangeGuid],#"AD Object GUID"=r[ObjectGUID],#"Account UPN"=r[UserPrincipalName],#"Display Name"=r[DisplayName],
				      #"Coverage State"=State,#"Native Link State"=if Native then DU[State] else AD[State]&" / "&(if K[Field](AD,"CloudMatchStatus")=null then "Unqualified" else K[Field](AD,"CloudMatchStatus")),
				      #"Workforce Match State"=WF[State],#"Account State"=K[Field](WF,"Account State"),#"Identity Match Status"=K[Field](WF,"Identity Match Status"),
				      #"Has M365 License"=K[Field](WF,"Has M365 License"),#"M365 License Count"=Count,#"Backlog Country"=K[Field](Co,"Country"),#"Backlog AD Domain"=K[Field](AD,"DomainName"),
				      #"Review Action"=if Review then "Review observed license assignments" else if not Link then "Qualify native AD/cloud link" else if WF[State]<>"Matched" then "Qualify Workforce coverage: "&WF[State] else "Review assignment suitability; no Exchange entitlement inferred"],
				 Columns={"TenantKey","Mailbox GUID","AD Object GUID","Account UPN","Display Name","Coverage State","Native Link State","Workforce Match State","Account State","Identity Match Status","Has M365 License","M365 License Count","Backlog Country","Backlog AD Domain","Review Action"},
				 Rows=Table.FromRecords(List.Transform(Table.ToRecords(Local),Project),Columns,MissingField.UseNull)
				in R[Finish](Table.TransformColumnTypes(Rows, {{"M365 License Count", Int64.Type}}))
