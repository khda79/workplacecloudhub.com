	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Mailbox Account License Unattributable Rows' =
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _countries=VALUES('Country Selection'[Source Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _ck=FILTER(VALUES('Mailbox Account License Coverage'[Backlog Country]),NOT _cf || 'Mailbox Account License Coverage'[Backlog Country] IN _countries)
			VAR _dk=FILTER(VALUES('Mailbox Account License Coverage'[Backlog AD Domain]),NOT _df || 'Mailbox Account License Coverage'[Backlog AD Domain] IN _domains)
			VAR _missing=FILTER('Mailbox Account License Coverage',(_cf && (ISBLANK('Mailbox Account License Coverage'[Backlog Country]) || 'Mailbox Account License Coverage'[Backlog Country]="Unknown")) || (_df && (ISBLANK('Mailbox Account License Coverage'[Backlog AD Domain]) || 'Mailbox Account License Coverage'[Backlog AD Domain]="Unknown")))
			RETURN COALESCE(CALCULATE((COUNTROWS('Mailbox Account License Coverage')),KEEPFILTERS(_missing)),0)
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: 9cde0347-23a5-5918-80df-135c458840ba

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Mailbox Account Coverage Note' = FORMAT([Mailbox Account Workforce Covered],"#,##0")&" Workforce rows covered | "&FORMAT([Mailbox Account Workforce Coverage (%)],"0.0%")&" | "&FORMAT([Mailbox Account License Unattributable Rows],"#,##0")&" not attributable. Assignment observed is not proof of Exchange entitlement."
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: ea23971b-87e3-54e8-a684-4f44ffb90186

