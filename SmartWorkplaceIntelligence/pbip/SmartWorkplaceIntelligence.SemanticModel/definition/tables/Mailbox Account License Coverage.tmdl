	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Mailbox Account Workforce Coverage (%)' = DIVIDE([Mailbox Account Workforce Covered],[Mailbox Account Coverage Denominator])
		formatString: 0.0%
		displayFolder: Remediation Backlog
		lineageTag: 862842f1-e084-5569-94c8-db75dee3d10f

