			VAR _dk=FILTER(VALUES('Mailbox Account License Coverage'[Backlog AD Domain]),NOT _df || 'Mailbox Account License Coverage'[Backlog AD Domain] IN _domains)
			VAR _missing=FILTER('Mailbox Account License Coverage',(_cf && (ISBLANK('Mailbox Account License Coverage'[Backlog Country]) || 'Mailbox Account License Coverage'[Backlog Country]="Unknown")) || (_df && (ISBLANK('Mailbox Account License Coverage'[Backlog AD Domain]) || 'Mailbox Account License Coverage'[Backlog AD Domain]="Unknown")))
			RETURN IF(SELECTEDVALUE('Backlog Attribution Selection'[Mode],"In scope")="Unassigned evidence",CALCULATE((CALCULATE(COUNTROWS('Mailbox Account License Coverage'),REMOVEFILTERS('Mailbox Account License Coverage'[Coverage State]))),KEEPFILTERS(_missing)),CALCULATE((CALCULATE(COUNTROWS('Mailbox Account License Coverage'),REMOVEFILTERS('Mailbox Account License Coverage'[Coverage State]))),KEEPFILTERS(TREATAS(_ck,'Mailbox Account License Coverage'[Backlog Country])),KEEPFILTERS(TREATAS(_dk,'Mailbox Account License Coverage'[Backlog AD Domain]))))
