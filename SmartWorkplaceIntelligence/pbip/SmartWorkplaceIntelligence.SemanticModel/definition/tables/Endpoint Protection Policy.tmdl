/// Governed tenant protection requirements by policy scope and role. Utility configuration table; not measured protection health.
table 'Endpoint Protection Policy'
	lineageTag: 71ce5ddb-8b49-4bcd-85b4-ca0df2cd6a7c

	/// Prepared TenantKey. Retains source qualification.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: b2e6f324-f64d-4b3f-bc8b-b01ae949730c
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared Policy Key. Retains source qualification.
	column 'Policy Key'
		dataType: string
		isHidden
		lineageTag: 401b4364-aa7d-4128-9643-fc2e65c8e742
		summarizeBy: none
		sourceColumn: Policy Key

	/// Prepared Policy Version. Retains source qualification.
	column 'Policy Version'
