/// Prepared Directory Cleanup evidence; country provenance is preserved.
table 'Mailbox Cleanup Evidence'
	lineageTag: 690ee9a3-0947-4c83-837e-4d8609cb2ae6

	measure 'Mailbox Cleanup Total' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Cleanup Evidence')), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: f077b36a-7a89-4d70-9729-b0c172edb4fc

	measure 'Mailbox Cleanup Candidates' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Cleanup Evidence'), KEEPFILTERS('Mailbox Cleanup Evidence'[Cleanup State] = "Candidate")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: 9e55928d-856f-43b3-84bd-8e10ea21f93c

	measure 'Mailbox Cleanup Review' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Cleanup Evidence'), KEEPFILTERS('Mailbox Cleanup Evidence'[Cleanup State] = "Review")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: e8169c9d-492a-4d01-904f-ef201438010e

	measure 'Mailbox Cleanup Active' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Cleanup Evidence'), KEEPFILTERS('Mailbox Cleanup Evidence'[Cleanup State] = "Active")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: 37352ca8-561d-4dc7-953a-42375bf2c331

