/// Licences per-user, per-SKU decisions of the qualified report snapshot (M365_Licenses_ReportSkuCandidates.csv). Referenced rows are already counted in License Report Candidates. Empty when the batch does not qualify the file.
table 'License SKU Candidates'
	lineageTag: c2f7667a-b3f0-4764-adee-bf593a4ed1a2

	measure 'License SKU Candidate Rows' = COUNTROWS ( 'License SKU Candidates' )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: 2d36da98-f4f7-488c-8b10-d88b147d1277

	measure 'License SKU Recommended Rows' = CALCULATE ( [License SKU Candidate Rows], KEEPFILTERS ( 'License SKU Candidates'[Recommendation] = "Recommended" ) )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: aafbce99-6d92-4668-ab9e-3d9c8a6af235

	measure 'License SKU Review Rows' = CALCULATE ( [License SKU Candidate Rows], KEEPFILTERS ( 'License SKU Candidates'[Recommendation] = "Review" ) )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: c640604f-1cfd-4a08-9dfa-ff362b8da4a3

	measure 'License SKU Blocked Rows' = CALCULATE ( [License SKU Candidate Rows], KEEPFILTERS ( 'License SKU Candidates'[Recommendation] = "Blocked by dependency" ) )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: a67847c9-01fe-4069-af2a-d957799e28a1

