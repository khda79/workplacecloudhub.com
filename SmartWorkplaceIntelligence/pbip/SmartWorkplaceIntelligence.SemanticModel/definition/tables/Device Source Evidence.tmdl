		mode: import
		source = NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("DeviceSource.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantDeviceKey", dataType="String"], [name="SourceRecordKey", dataType="String"], [name="SourceSystem", dataType="String"], [name="SourceObjectId", dataType="String"], [name="SourceDeviceId", dataType="String"], [name="DeviceName", dataType="String"], [name="ManagementAgent", dataType="String"], [name="EnrollmentRaw", dataType="String"], [name="EnrollmentUtcDateTime", dataType="DateTime"], [name="EnrollmentStatus", dataType="String"], [name="EnrollmentType", dataType="String"], [name="ActivityKind", dataType="String"], [name="ActivityRaw", dataType="String"], [name="ActivityUtcDateTime", dataType="DateTime"], [name="ActivityStatus", dataType="String"], [name="SourceCollectedDateTime", dataType="DateTime"], [name="SelectionStatus", dataType="String"], [name="SelectionReason", dataType="String"]})

