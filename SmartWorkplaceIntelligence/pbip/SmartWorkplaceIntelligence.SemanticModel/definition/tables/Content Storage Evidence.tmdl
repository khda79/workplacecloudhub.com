/// Private current SharePoint and OneDrive object-level storage, activity, ownership, capacity, freshness, risk, and recommended-action evidence.
table 'Content Storage Evidence'
	lineageTag: cab6aba2-0edc-44ee-a0be-a78901981abd

	/// Current SharePoint sites and OneDrive accounts in scope.
	measure 'Content Containers' = COUNTROWS('Content Storage Evidence')
		formatString: #,0
		displayFolder: Content | Current
		lineageTag: 14efbcb0-cef1-4ad9-a745-6d7a7854ae9b

	/// Current SharePoint sites in scope.
	measure 'SharePoint Sites' = CALCULATE([Content Containers], KEEPFILTERS('Content Storage Evidence'[Service] = "SharePoint"))
		formatString: #,0
		displayFolder: Content | Current
		lineageTag: e190e9ab-0547-4a73-90bc-4faff8b66fdc

	/// Current OneDrive accounts in scope.
	measure 'OneDrive Accounts' = CALCULATE([Content Containers], KEEPFILTERS('Content Storage Evidence'[Service] = "OneDrive"))
		formatString: #,0
		displayFolder: Content | Current
		lineageTag: 353154f7-65fb-4ade-bebb-07056008f46c

	/// Observed SharePoint and OneDrive storage used in gigabytes.
	measure 'Content Storage Used (GB)' = SUM('Content Storage Evidence'[Storage Used GB])
		formatString: #,0.0
		displayFolder: Content | Storage
		lineageTag: 6fb7a3c0-4271-4a0a-8297-333880c8424d

	/// Observed SharePoint and OneDrive storage used in tebibytes.
	measure 'Content Storage Used (TB)' = DIVIDE([Content Storage Used (GB)], 1024)
		formatString: #,0.00
		displayFolder: Content | Storage
		lineageTag: ed221052-a78f-4c8e-897f-be26669a8894

	/// Storage used by content inactive for more than 180 days.
	measure 'Inactive Content Storage (TB)' = DIVIDE(CALCULATE([Content Storage Used (GB)], KEEPFILTERS('Content Storage Evidence'[Activity State] = "Inactive 180D+")), 1024)
		formatString: #,0.00
		displayFolder: Content | Risk
		lineageTag: 6c97a57b-a560-49f4-8170-833de50c7755

	/// Observed used storage divided by observed allocated storage.
	measure 'Content Storage Utilization (%)' = DIVIDE(SUM('Content Storage Evidence'[Storage Used GB]), SUM('Content Storage Evidence'[Storage Allocated GB]))
		formatString: 0.0%
		displayFolder: Content | Storage
		lineageTag: 1ba19a54-b106-49a5-8431-054c4d210d3d

	/// Content containers using at least 80 percent of their observed quota.
	measure 'Containers at 80%+ Quota' = CALCULATE([Content Containers], KEEPFILTERS('Content Storage Evidence'[Storage Pressure] IN {"Critical 90%+", "High 80-90%"}))
		formatString: #,0
		displayFolder: Content | Risk
		lineageTag: 2730347b-3dba-4dfd-87a0-74a8747eebb4

	/// Content containers inactive for more than 180 days.
	measure 'Inactive Content Containers' = CALCULATE([Content Containers], KEEPFILTERS('Content Storage Evidence'[Activity State] = "Inactive 180D+"))
		formatString: #,0
		displayFolder: Content | Risk
		lineageTag: cf118cba-5f04-4f7c-b85e-5eb8415995a8

	/// SharePoint sites without observed owner evidence.
	measure 'Orphaned SharePoint Sites' = CALCULATE([Content Containers], KEEPFILTERS('Content Storage Evidence'[Service] = "SharePoint"), KEEPFILTERS('Content Storage Evidence'[Owner State] = "Missing"))
		formatString: #,0
		displayFolder: Content | Risk
		lineageTag: 76436d60-d96d-464b-b489-e9e29540bde3

	/// OneDrive accounts whose usage export has no last activity date.
	measure 'OneDrive Accounts Without Activity Evidence' = CALCULATE([Content Containers], KEEPFILTERS('Content Storage Evidence'[Service] = "OneDrive"), KEEPFILTERS('Content Storage Evidence'[Activity State] = "No activity evidence"))
		formatString: #,0
		displayFolder: Content | Evidence
		lineageTag: ccbca12a-5fde-49a9-a5a7-1b646945d84d

	/// Content services whose current usage evidence is stale.
	measure 'Stale Content Sources' = CALCULATE(DISTINCTCOUNT('Content Storage Evidence'[Service]), KEEPFILTERS('Content Storage Evidence'[Freshness State] = "Stale"))
		formatString: #,0
		displayFolder: Content | Evidence
		lineageTag: a54f3f10-268f-465b-afa3-db5888c303d6

	/// Content services represented by current evidence.
	measure 'Content Services' = DISTINCTCOUNT('Content Storage Evidence'[Service])
		formatString: #,0
		displayFolder: Content | Evidence
		lineageTag: 6a51337c-654f-4fb0-9cb3-6b141dba658e

	/// Compact disclosure of current content evidence coverage and freshness.
	measure 'Content Evidence Ribbon Text' = "Observed · " & FORMAT([Content Services], "0") & " services · " & FORMAT([Stale Content Sources], "0") & " stale · oldest " & FORMAT(MAX('Content Storage Evidence'[Evidence Age Days]), "0") & "d"
		formatString: @
		displayFolder: Content | Evidence
		lineageTag: 2a1f2dc8-20ab-4a60-adc2-0ed437d51537

	measure 'Messaging and Collaboration Storage (TB)' = [Total Mailbox Storage (TB)] + [Content Storage Used (TB)]
		formatString: #,0.0
		displayFolder: Content | Executive
		lineageTag: 0a31c5c5-b9a6-4d5e-a7d8-ffc2fd2a5072

	measure 'Messaging and Collaboration Storage per Workforce Account (GB)' = DIVIDE ( [Total Mailbox Storage (TB)] * 1024 + [Content Storage Used (GB)], [Enabled Workforce Accounts] )
		formatString: #,0.0
		displayFolder: Content | Executive
		lineageTag: 2576b30b-04e8-4588-802c-a0a1531d1bd0

	column 'Content Object Key'
		dataType: string
		isHidden
		lineageTag: 7c567917-ffcf-4fc8-9c56-d96d51d4109d
		summarizeBy: none
		sourceColumn: Content Object Key

		annotation SummarizationSetBy = Automatic

	column 'Content Object Name'
		dataType: string
		lineageTag: f740568a-4393-4c7b-99ab-51208973ec62
		summarizeBy: none
		sourceColumn: Content Object Name

		annotation SummarizationSetBy = Automatic

	column Service
		dataType: string
		lineageTag: b5538880-1c73-4852-8851-be2580da72cb
