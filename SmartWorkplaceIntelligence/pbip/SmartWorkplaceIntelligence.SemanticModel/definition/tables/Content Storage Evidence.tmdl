		annotation SummarizationSetBy = Automatic

	column 'Last Activity Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 93869493-b2cc-44b1-96ef-6ed075e45761
		summarizeBy: none
		sourceColumn: Last Activity Date

		variation Variation
			isDefault
			relationship: 3b2bd393-27ba-4570-8069-2b721ee98199
			defaultHierarchy: LocalDateTable_b62f6adb-63eb-4a4b-ad79-834b3e451455.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column 'Days Since Last Activity'
		dataType: int64
		formatString: #,0
		lineageTag: 8cb29248-5ba8-4909-8602-d87d22241a25
		summarizeBy: sum
		sourceColumn: Days Since Last Activity

		annotation SummarizationSetBy = Automatic

	column 'Storage Used GB'
		dataType: double
		formatString: #,0.0
		lineageTag: 6f806352-64f3-4dd4-8121-6012974b22d3
		summarizeBy: sum
		sourceColumn: Storage Used GB

		annotation SummarizationSetBy = Automatic

	column 'Storage Allocated GB'
		dataType: double
		formatString: #,0.0
		lineageTag: 70d3c123-64eb-48f3-aecb-9a45ec94c754
		summarizeBy: sum
		sourceColumn: Storage Allocated GB

		annotation SummarizationSetBy = Automatic

	column 'Storage Utilization (%)'
		dataType: double
		formatString: 0.0
		lineageTag: 8d380ff2-74a4-4fea-94a8-6e4bbb956d20
		summarizeBy: sum
		sourceColumn: Storage Utilization (%)

