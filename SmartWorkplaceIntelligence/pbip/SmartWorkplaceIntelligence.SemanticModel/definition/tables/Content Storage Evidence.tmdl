	partition 'Content Storage Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("ContentStorageEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Content Object Key", "Content Object Name", "Service", "Object Type", "Owner", "Owner State", "Activity State", "Last Activity Date", "Days Since Last Activity", "Storage Used GB", "Storage Allocated GB", "Storage Utilization (%)", "Storage Pressure", "File Count", "Active File Count", "Deleted State", "Risk Priority", "Risk Signal", "Recommended Action", "Snapshot Date", "Evidence Age Days", "Freshness State", "Evidence Status"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Last Activity Date", "Days Since Last Activity", "Storage Used GB", "Storage Allocated GB", "Storage Utilization (%)", "File Count", "Active File Count", "Snapshot Date", "Evidence Age Days"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Content Object Key", type text}, {"Content Object Name", type text}, {"Service", type text}, {"Object Type", type text}, {"Owner", type text}, {"Owner State", type text}, {"Activity State", type text}, {"Last Activity Date", type datetime}, {"Days Since Last Activity", Int64.Type}, {"Storage Used GB", type number}, {"Storage Allocated GB", type number}, {"Storage Utilization (%)", type number}, {"Storage Pressure", type text}, {"File Count", Int64.Type}, {"Active File Count", Int64.Type}, {"Deleted State", type text}, {"Risk Priority", type text}, {"Risk Signal", type text}, {"Recommended Action", type text}, {"Snapshot Date", type datetime}, {"Evidence Age Days", Int64.Type}, {"Freshness State", type text}, {"Evidence Status", type text}}, "en-US")
				in
				    Typed

