	/// Business attribute Department.
	column Department
		dataType: string
		lineageTag: 02377cb6-6a11-4437-9360-afd66ac0e2fb
		sourceColumn: Department

	/// Business attribute Manager.
	column Manager
		dataType: string
		lineageTag: 262e54c1-2b8d-4d3c-a2ba-f58ff36753f6
		sourceColumn: Manager

	/// Business attribute Country.
	column Country
		dataType: string
		lineageTag: 66c56a48-1c95-4048-b1f3-74e0ae33c3d7
		dataCategory: Country
		sourceColumn: Country

	/// Business attribute Activity Age Bucket.
	column 'Activity Age Bucket'
		dataType: string
		lineageTag: 880d99fd-1405-4ab6-ba10-0ddd65f3d656
		sourceColumn: Activity Age Bucket

	partition 'User Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"User Key" = Int64.Type, #"User Surrogate Key" = nullable text, #"User ID" = nullable text, #"User Mail" = nullable text, #"User Search" = nullable text, #"User Type" = nullable text, #"Account State" = nullable text, #"Workforce Status" = nullable text, #"Identity Scope" = nullable text, #"Department" = nullable text, #"Manager" = nullable text, #"Country" = nullable text, #"Activity Age Bucket" = nullable text, #"User Source ID" = nullable text], {
				        {1, "User 001", "USR-SYNTH-001", "user001@example.invalid", "user001@example.invalid | USR-SYNTH-001", "Member", "Enabled", "Active", "Workforce", "Engineering", "Manager 001", "France", "Active <=30D", "USR-SYNTH-001"},
				        {2, "User 002", "USR-SYNTH-002", "user002@example.invalid", "user002@example.invalid | USR-SYNTH-002", "Member", "Enabled", "Inactive", "Workforce", "Finance", "Manager 001", "France", "Dormant >90D", "USR-SYNTH-002"},
				        {3, "User 003", "USR-SYNTH-003", "user003@example.invalid", "user003@example.invalid | USR-SYNTH-003", "Member", "Disabled", "Inactive", "Workforce", "Operations", "Manager 002", "Germany", "Dormant >90D", "USR-SYNTH-003"},
				        {4, "User 004", "USR-SYNTH-004", "guest004@example.invalid", "guest004@example.invalid | USR-SYNTH-004", "Guest", "Enabled", "Active", "External", "External", "External Manager", "Germany", "Active <=30D", "USR-SYNTH-004"},
				        {5, "User 005", "USR-SYNTH-005", "user005@example.invalid", "user005@example.invalid | USR-SYNTH-005", "Member", "Enabled", "Unknown", "Workforce", "Sales", null, "Spain", "Never Used", "USR-SYNTH-005"},
				        {6, "User 006", "USR-SYNTH-006", "user006@example.invalid", "user006@example.invalid | USR-SYNTH-006", "Member", "Enabled", "Active", "Workforce", "Engineering", "Manager 003", "Spain", "Active <=30D", "USR-SYNTH-006"}
				    })
