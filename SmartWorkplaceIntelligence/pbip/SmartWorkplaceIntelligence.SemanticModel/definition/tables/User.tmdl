		dataType: string
		lineageTag: 178fa85a-5aee-480e-b399-3748ee952164
		sourceColumn: Identity Scope

	/// Business attribute User Source ID.
	column 'User Source ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 8a5a218e-b80e-46a1-b802-8e39a2127fbd
		sourceColumn: User Source ID

	/// Business attribute User ID.
	column 'User ID'
		dataType: string
		lineageTag: 4a1468cf-208d-43d9-b912-ca3491fde348
		sourceColumn: User ID

	/// Business attribute User Mail.
	column 'User Mail'
