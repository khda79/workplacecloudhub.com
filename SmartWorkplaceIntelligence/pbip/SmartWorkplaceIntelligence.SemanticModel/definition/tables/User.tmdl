/// One row per anonymized synthetic account identity with private-workflow search and ownership attributes.
table User
	lineageTag: e9f7a367-7445-423b-bfa5-8af2ce0c79db

	/// Enabled workforce users without a qualified manager value.
	measure '# Users Without Manager' = CALCULATE(DISTINCTCOUNT('User'[User Key]), KEEPFILTERS('User'[Account State] = "Enabled"), KEEPFILTERS('User'[Identity Scope] = "Workforce"), KEEPFILTERS(ISBLANK('User'[Manager])))
		formatString: #,0
		displayFolder: Identity Health
		lineageTag: 38bee270-33ae-4294-9361-eec3e2cffd04

	/// Business attribute User Key.
	column 'User Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: cf9b08fe-3b38-46ea-b3a4-08ed108f0299
		summarizeBy: none
		sourceColumn: User Key

	/// Business attribute User Surrogate Key.
	column 'User Surrogate Key'
		dataType: string
		lineageTag: a3e87c55-a01b-4938-9ec5-f47735ad4b7d
		sourceColumn: User Surrogate Key

	/// Business attribute User Type.
	column 'User Type'
		dataType: string
		lineageTag: 8fe8125b-c599-4023-a99a-03919bd514f7
		sourceColumn: User Type

	/// Business attribute Account State.
	column 'Account State'
		dataType: string
		lineageTag: a2cef685-7ac1-4fb0-ab70-ffe5b7366dc2
		sourceColumn: Account State

	/// Business attribute Workforce Status.
	column 'Workforce Status'
