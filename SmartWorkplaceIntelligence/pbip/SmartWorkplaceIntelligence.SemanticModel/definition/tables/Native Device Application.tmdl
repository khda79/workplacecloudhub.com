	/// Exact lookup of the native managed-device ID within its tenant to the prepared bridge key. Unresolved weekly relations remain blank without a fabricated parent.
	column 'Tenant Intune device key' = LOOKUPVALUE ( 'Native Managed Device Evidence'[TenantIntuneDeviceKey], 'Native Managed Device Evidence'[ManagedDeviceId], 'Native Device Application'[ManagedDeviceId], 'Native Managed Device Evidence'[TenantKey], 'Native Device Application'[TenantKey] )
