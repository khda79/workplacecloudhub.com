	/// Exact lookup of the native managed-device ID within its tenant to the prepared bridge key. Unresolved weekly relations remain blank without a fabricated parent.
	column 'Tenant Intune device key' = LOOKUPVALUE ( 'Native Managed Device Evidence'[TenantIntuneDeviceKey], 'Native Managed Device Evidence'[ManagedDeviceId], 'Native Device Application'[ManagedDeviceId], 'Native Managed Device Evidence'[TenantKey], 'Native Device Application'[TenantKey] )
		dataType: string
		lineageTag: 0961eb28-6d22-4185-8c68-5cd5bbe040bb
		summarizeBy: none

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 0d47d919-00c1-456d-bbc5-af466aa4f34a
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'Native Device Application' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("FactDeviceApplication.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantDeviceApplicationKey", dataType="String"], [name="TenantApplicationKey", dataType="String"], [name="ManagedDeviceId", dataType="String"], [name="AppId", dataType="String"], [name="ApplicationLinkStatus", dataType="String"], [name="DeviceLinkStatus", dataType="String"], [name="SourceCollectedDateTime", dataType="DateTime"]}))
				in
				    Readers[Finish](BusinessRows)
