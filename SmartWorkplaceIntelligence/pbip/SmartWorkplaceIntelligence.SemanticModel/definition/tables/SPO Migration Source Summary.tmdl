		summarizeBy: none
		sourceColumn: Snapshot ID

	/// Prepared, tenant-qualified migration evidence: Snapshot Date.
	column 'Snapshot Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 7ac06a7b-b289-4f90-a40e-255770e088cc
		summarizeBy: none
		sourceColumn: Snapshot Date

		variation Variation
			isDefault
			relationship: 1b886297-16e3-468a-ab89-405b13280c23
			defaultHierarchy: LocalDateTable_2a1736ef-f358-4c1d-a66f-352e2a360979.'Date Hierarchy'

		annotation UnderlyingDateTimeDataType = Date

	/// Prepared, tenant-qualified migration evidence: Source.
	column Source
