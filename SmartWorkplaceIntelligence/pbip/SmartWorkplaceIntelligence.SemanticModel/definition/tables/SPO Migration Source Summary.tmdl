		isHidden
		lineageTag: eaedfdfc-0aeb-4540-bdf6-9e09b634bba0
		summarizeBy: none
		sourceColumn: Binding SHA256

	/// Prepared, tenant-qualified migration evidence: Captured UTC.
	column 'Captured UTC'
		dataType: dateTime
		isHidden
		formatString: yyyy-MM-dd HH:mm
		lineageTag: 725ce75f-efe9-4219-ab74-8a167398da44
		summarizeBy: none
		sourceColumn: Captured UTC

	/// Prepared, tenant-qualified migration evidence: Age Hours.
	column 'Age Hours'
