/// SPO means SharePoint Online. Grain: TenantKey, Project Key, Snapshot ID, Source; source: one selected immutable prepared batch.
table 'SPO Migration Source Summary'
	lineageTag: 95183e7b-19b2-413c-9b4c-f475719c8e46

	/// Source Qualification Context. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Source Qualification Context' = CONCATENATEX(VALUES('SPO Migration Source Summary'[Qualification]), 'SPO Migration Source Summary'[Qualification], ", ")
		formatString: General
		displayFolder: Migration\Quality
		lineageTag: 88638422-e955-4faf-a3af-b2f74c0074db

	/// Source Age Hours. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Source Age Hours' = MAX('SPO Migration Source Summary'[Age Hours])
		formatString: 0.0
		displayFolder: Migration\Quality
		lineageTag: 12db985f-aea8-4845-be1b-6f80606991cb

	/// Prepared, tenant-qualified migration evidence: TenantKey.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: 90f33ea1-578f-4674-b1a8-86e72a671374
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared, tenant-qualified migration evidence: Project Key.
