/// SPO means SharePoint Online. Grain: Operation Key; source: one selected immutable prepared batch.
table 'SPO Migration Plan'
	lineageTag: 9715e299-6cc5-438e-bc3f-b00ec30a3be4

	/// Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Operations' =
			VAR _technical = ISCROSSFILTERED('SharePoint On-prem Web Applications') || ISFILTERED('SPO Migration Web'[Collection Key]) || ISFILTERED('SPO Migration Collection'[Source URL]) || ISFILTERED('SPO Migration Web'[Source URL]) || ISFILTERED('SPO Migration Web'[Coverage Kind])
			VAR _scope = VALUES('SPO Migration Scope'[Operation Key])
			VAR _sp = CALCULATE(DISTINCTCOUNT('SPO Migration Plan'[Operation Key]), KEEPFILTERS('SPO Migration Plan'[Source Type]="SharePoint on-prem"), KEEPFILTERS(TREATAS(_scope, 'SPO Migration Plan'[Operation Key])))
			VAR _shared = CALCULATE(DISTINCTCOUNT('SPO Migration Plan'[Operation Key]), KEEPFILTERS('SPO Migration Plan'[Source Type]="Shared folders"))
			RETURN IF(_technical, IF(NOT ISBLANK(_sp) || NOT ISBLANK(_shared), COALESCE(_sp,0)+COALESCE(_shared,0)), DISTINCTCOUNT('SPO Migration Plan'[Operation Key]))
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: 4c9963cb-e312-40f2-9dac-03aa8cbb78bd

	/// Migrate Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Migrate Operations' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition]="MIGRATE"))
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: 2c12a6b5-f644-4a77-ab15-e36eaee05aad

	/// Shared denominator for reported and validated progress: every MIGRATE operation in the selected source/project/business unit/phase and technical context, including cancellations. Execution and validation selections do not shrink the denominator.
	measure 'SPO Migrate Population' = CALCULATE([SPO Migrate Operations], REMOVEFILTERS('SPO Migration Plan'[Execution Status]), REMOVEFILTERS('SPO Migration Plan'[Validation Status]), REMOVEFILTERS('SPO Migration Plan'[Is Validated]))
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: f174d198-03ee-4af7-a194-07bfa9fa6905

	/// Reported Done. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Reported Done' = VAR _n=[SPO Migrate Population] RETURN IF(_n>0, COALESCE(CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]="DONE")),0))
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: a0becba4-54c4-4a24-888e-d6deb9ce7f73

	/// Validated Done. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Validated Done' = VAR _n=[SPO Migrate Population] RETURN IF(_n>0, COALESCE(CALCULATE([SPO Reported Done], KEEPFILTERS('SPO Migration Plan'[Is Validated]=TRUE())),0))
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: 55bc0ff5-95bc-4b46-92b8-d34fa5c4b638

	/// Reported Completion. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Reported Completion' = DIVIDE([SPO Reported Done], [SPO Migrate Population])
		formatString: 0.0%
		displayFolder: Migration\Progress
		lineageTag: 3f9f59c6-eb8e-4f66-8498-de85af16515a

	/// Validated Completion. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Validated Completion' = DIVIDE([SPO Validated Done], [SPO Migrate Population])
		formatString: 0.0%
		displayFolder: Migration\Progress
		lineageTag: 7e702395-ee21-47ad-beab-65f3801f25e4

	/// Reported Progress. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Reported Progress' = VAR _n=[SPO Migrate Population] RETURN IF(_n>0, FORMAT([SPO Reported Done],"#,##0") & " / " & FORMAT(_n,"#,##0") & " (" & FORMAT(DIVIDE([SPO Reported Done],_n),"0.0%") & ")", "n/a")
		formatString: General
		displayFolder: Migration\Progress
		lineageTag: 6de83d33-9c84-40a2-b0e3-17af25ceb0f2

	/// Validated Progress. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Validated Progress' = VAR _n=[SPO Migrate Population] RETURN IF(_n>0, FORMAT([SPO Validated Done],"#,##0") & " / " & FORMAT(_n,"#,##0") & " (" & FORMAT(DIVIDE([SPO Validated Done],_n),"0.0%") & ")", "n/a")
		formatString: General
		displayFolder: Migration\Progress
		lineageTag: e638c75e-e672-4574-a47b-90ab57ad9229

	/// Remaining to Execute. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Remaining to Execute' = VAR _n=[SPO Migrate Operations] RETURN IF(_n>0, COALESCE(CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"DONE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"CANCELLED")),0))
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: da2dd71b-05b5-4634-bcb5-8db55c4a58e4

	/// Remaining to Close. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Remaining to Close' = IF([SPO Migrate Population]>0, [SPO Migrate Population]-[SPO Validated Done])
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: 759c8b0f-6374-4692-8a19-c1b27ab4ed96

	/// Cancelled Migrations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Cancelled Migrations' = CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]="CANCELLED"))
		formatString: #,##0
		displayFolder: Migration\Progress
		lineageTag: ac0837f3-4f36-4e13-b0f0-5973aa0d1a08

	/// Reference Date. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Reference Date' = CALCULATE(MAX('SPO Migration Source Summary'[Snapshot Date]), REMOVEFILTERS('SPO Migration Source Summary'[Source]))
		formatString: yyyy-MM-dd
		displayFolder: Migration\Progress
		lineageTag: 46b00540-8a7d-4aaa-89d6-f8b3b1da6f22

	/// Page Context. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Page Context' =
			VAR _date=[SPO Reference Date]
			VAR _states=CONCATENATEX(VALUES('SPO Migration Source Summary'[Qualification]), 'SPO Migration Source Summary'[Qualification], ", ")
			RETURN "Batch " & IF(ISBLANK(_date),"not available",FORMAT(_date,"yyyy-MM-dd")) & " | " & COALESCE(_states,"No migration evidence") & " | " &
			IF(ISCROSSFILTERED('SharePoint On-prem Web Applications') || ISFILTERED('SPO Migration Web'[Collection Key]) || ISFILTERED('SPO Migration Collection'[Source URL]) || ISFILTERED('SPO Migration Web'[Source URL]) || ISFILTERED('SPO Migration Web'[Coverage Kind]), "On-prem filter; shared folders not applicable", "Declared progress; validation is separate")
		formatString: General
		displayFolder: Migration\Progress
		lineageTag: 8a005cbf-446e-481f-b9d2-4c2984224b88

	/// Archive Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Archive Operations' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition]="ARCHIVE"))
		formatString: #,##0
		displayFolder: Migration\Decisions
		lineageTag: 62248258-7c66-4aaa-8a96-fcec1c514a50

	/// Delete Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Delete Operations' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition]="DELETE"))
		formatString: #,##0
		displayFolder: Migration\Decisions
		lineageTag: 945477c8-76d1-4922-86e6-50276826324c

	/// Keep Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Keep Operations' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition]="KEEP"))
		formatString: #,##0
		displayFolder: Migration\Decisions
		lineageTag: 85a96643-eaac-48c7-aa4b-d6a3e5e152c3

	/// Tbd Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Tbd Operations' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition]="TBD"))
		formatString: #,##0
		displayFolder: Migration\Decisions
		lineageTag: cb065b79-e341-4f11-af00-9fb9b83dea33

	/// Notinplan Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Notinplan Operations' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition]="NOTINPLAN"))
		formatString: #,##0
		displayFolder: Migration\Decisions
		lineageTag: f8881eb0-def6-4097-8af9-b7c9a1ed8ec2

	/// Other Actions Done. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Other Actions Done' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition]<>"MIGRATE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]="DONE"))
		formatString: #,##0
		displayFolder: Migration\Decisions
		lineageTag: 4e41dbda-6ada-4b2a-87c5-960625c1d468

	/// Overdue. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Overdue' = VAR _ref=[SPO Reference Date] RETURN IF(NOT ISBLANK(_ref) && [SPO Migrate Operations]>0, COALESCE(CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"DONE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"CANCELLED"), KEEPFILTERS(NOT ISBLANK('SPO Migration Plan'[Planned Date])), KEEPFILTERS('SPO Migration Plan'[Planned Date]<_ref)),0))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: aa2018d8-15e4-472a-8a74-9bbda239a625

	/// Due Today. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Due Today' = VAR _ref=[SPO Reference Date] RETURN IF(NOT ISBLANK(_ref) && [SPO Migrate Operations]>0, COALESCE(CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"DONE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"CANCELLED"), KEEPFILTERS(NOT ISBLANK('SPO Migration Plan'[Planned Date])), KEEPFILTERS('SPO Migration Plan'[Planned Date]=_ref)),0))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: b135216d-52ca-4157-be50-91dce1d4fe58

	/// Due Next 7 Days. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Due Next 7 Days' = VAR _ref=[SPO Reference Date] RETURN IF(NOT ISBLANK(_ref) && [SPO Migrate Operations]>0, COALESCE(CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"DONE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"CANCELLED"), KEEPFILTERS(NOT ISBLANK('SPO Migration Plan'[Planned Date])), KEEPFILTERS('SPO Migration Plan'[Planned Date]>_ref && 'SPO Migration Plan'[Planned Date]<=_ref+7)),0))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: ab7eb340-001f-4adf-a684-172f8ef99495

	/// Due Days 8 to 14. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Due Days 8 to 14' = VAR _ref=[SPO Reference Date] RETURN IF(NOT ISBLANK(_ref) && [SPO Migrate Operations]>0, COALESCE(CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"DONE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"CANCELLED"), KEEPFILTERS(NOT ISBLANK('SPO Migration Plan'[Planned Date])), KEEPFILTERS('SPO Migration Plan'[Planned Date]>_ref+7 && 'SPO Migration Plan'[Planned Date]<=_ref+14)),0))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: aa1a3f77-920a-45cd-b621-b119bf29a57f

	/// Due Within 14 Days. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Due Within 14 Days' = VAR _ref=[SPO Reference Date] RETURN IF(NOT ISBLANK(_ref) && [SPO Migrate Operations]>0, COALESCE(CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"DONE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"CANCELLED"), KEEPFILTERS(NOT ISBLANK('SPO Migration Plan'[Planned Date])), KEEPFILTERS('SPO Migration Plan'[Planned Date]>=_ref && 'SPO Migration Plan'[Planned Date]<=_ref+14)),0))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: e3fd826f-f286-43f5-b298-9a235971f921

	/// Missing Planned Date. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Missing Planned Date' = CALCULATE([SPO Migrate Operations], KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"DONE"), KEEPFILTERS('SPO Migration Plan'[Execution Status]<>"CANCELLED"), KEEPFILTERS(ISBLANK('SPO Migration Plan'[Planned Date])))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: 4121af56-26fa-45d7-9b59-0c0af4cdbbd0

	/// Done Missing Actual Date. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Done Missing Actual Date' = CALCULATE([SPO Reported Done], KEEPFILTERS(ISBLANK('SPO Migration Plan'[Actual Date])))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: f649774c-8b59-43ac-8113-333d62afe986

	/// Planned Calendar Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Planned Calendar Operations' = CALCULATE([SPO Migrate Operations], USERELATIONSHIP('SPO Migration Plan'[Planned Date],'Date'[Date]))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: 298f790f-c97d-44e4-968b-953f8a904055

	/// Actual Calendar Completions. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Actual Calendar Completions' = CALCULATE([SPO Reported Done], USERELATIONSHIP('SPO Migration Plan'[Actual Date],'Date'[Date]))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: 84afdf1b-c4f0-4088-af93-2923659cedb9

	/// Validation Calendar Completions. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Validation Calendar Completions' = CALCULATE([SPO Validated Done], USERELATIONSHIP('SPO Migration Plan'[Validation Date],'Date'[Date]))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: 243d4ebe-f70f-4ed5-a93b-aa1939f16f24

	/// Cumulative Declared Completions. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Cumulative Declared Completions' =
			VAR _day=MAX('Date'[Date]) VAR _reference=[SPO Reference Date]
			RETURN IF(_day<=_reference, CALCULATE([SPO Actual Calendar Completions], FILTER(ALLSELECTED('Date'), 'Date'[Date]<=_day)))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: fa04dba5-a308-44b0-9cc1-182989da0a71

	/// Variance Eligible Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Variance Eligible Operations' = COUNTROWS(FILTER('SPO Migration Plan', 'SPO Migration Plan'[Disposition]="MIGRATE" && 'SPO Migration Plan'[Execution Status]="DONE" && NOT ISBLANK('SPO Migration Plan'[Planned Date]) && NOT ISBLANK('SPO Migration Plan'[Actual Date]) && [SPO Operations]>0))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: 6b19b33a-6304-4d3f-91bb-e903ea991fbd

	/// Mean Schedule Variance Days. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Mean Schedule Variance Days' = AVERAGEX(FILTER('SPO Migration Plan', 'SPO Migration Plan'[Disposition]="MIGRATE" && 'SPO Migration Plan'[Execution Status]="DONE" && NOT ISBLANK('SPO Migration Plan'[Planned Date]) && NOT ISBLANK('SPO Migration Plan'[Actual Date]) && [SPO Operations]>0), DATEDIFF('SPO Migration Plan'[Planned Date], 'SPO Migration Plan'[Actual Date], DAY))
		formatString: 0.0
		displayFolder: Migration\Schedule
		lineageTag: 6edb7c72-56ef-4d3d-87a7-738d88cb0778

	/// Variance Excluded Operations. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Variance Excluded Operations' = IF([SPO Reported Done]>0, [SPO Reported Done]-COALESCE([SPO Variance Eligible Operations],0))
		formatString: #,##0
		displayFolder: Migration\Schedule
		lineageTag: d5cf59e6-1760-414a-b2a4-c9976bbe280a

	/// Source Identity Review. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Source Identity Review' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Source Type]="SharePoint on-prem"), KEEPFILTERS('SPO Migration Plan'[Source Qualification]<>"Direct native match"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 6a5b0b7f-4ab3-4203-a938-7bb63d1a8fb3

	/// Target Review. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Target Review' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition] IN {"MIGRATE","ARCHIVE"}), KEEPFILTERS('SPO Migration Plan'[Target Approval Evidence]="Not recorded"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: f92cd7ca-6df8-4cb4-9f99-abe1d823cf85

	/// Required Targets Missing. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Required Targets Missing' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition] IN {"MIGRATE","ARCHIVE"}), KEEPFILTERS(ISBLANK('SPO Migration Plan'[Resolved Target URL])))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 40071b06-aa07-4b5a-bd8d-c17132db5163

	/// Targets Observed. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Targets Observed' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition] IN {"MIGRATE","ARCHIVE"}), KEEPFILTERS('SPO Migration Plan'[Target Observation]="Site observed"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 981f3023-66c7-421e-b66c-8351a2c635ab

	/// Targets Not Observed. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Targets Not Observed' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition] IN {"MIGRATE","ARCHIVE"}), KEEPFILTERS('SPO Migration Plan'[Target Observation]="Not observed"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: af85086b-ad76-4f50-b5cf-9e52afea2298

	/// Targets Not Verifiable. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Targets Not Verifiable' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Disposition] IN {"MIGRATE","ARCHIVE"}), KEEPFILTERS('SPO Migration Plan'[Target Observation]="Not verifiable"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 15cded9e-4157-4754-baf4-2aec9c503050

	/// Operations With Findings. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Operations With Findings' = CALCULATE([SPO Operations], KEEPFILTERS('SPO Migration Plan'[Requires Review]=TRUE()))
		formatString: #,##0
		displayFolder: Migration\Quality
		lineageTag: 3b146ccf-6353-47f2-bb62-78d99544a5ef

	/// Permission Evidence Context. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Permission Evidence Context' = "Permission strategy is declared; effective ACL equivalence is not measured"
		formatString: General
		displayFolder: Migration\Quality
		lineageTag: 5da66818-002f-4cb5-a0e7-93974bf36fcc

