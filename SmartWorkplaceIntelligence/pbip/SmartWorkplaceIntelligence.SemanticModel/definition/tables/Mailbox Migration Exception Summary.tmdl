/// Current immutable planning snapshot; disconnected from Date/Period intentionally. Domain scope is applied explicitly by measures. Historical daily observations are never rewritten.
table 'Mailbox Migration Exception Summary'
	lineageTag: 5c000c9d-e280-41e7-8be0-59dd6b01a63a

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Exception Source Status' = IF(COUNTROWS(ALL('Mailbox Migration Exception Summary')) = 0, "Not configured", CONCATENATEX(DISTINCT('Mailbox Migration Exception Summary'[Source Status]), 'Mailbox Migration Exception Summary'[Source Status], ", "))
		displayFolder: Mailbox retention planning
		lineageTag: 145d51da-82bc-4b78-892e-94d458762729

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Planning Inventory' =
			VAR _selected = ISFILTERED('Daily Domain'[Domain]) || ISFILTERED('Daily Domain'[Domain Key])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _scope = FILTER(ALL('Mailbox Migration Exception Summary'), IF(_selected, 'Mailbox Migration Exception Summary'[Domain Key] <> "__all__" && 'Mailbox Migration Exception Summary'[Source Domain] IN _domains, 'Mailbox Migration Exception Summary'[Domain Key] = "__all__"))
			RETURN IF([Mailbox Exception Source Status] <> "Qualified", BLANK(), COALESCE(SUMX(_scope, 'Mailbox Migration Exception Summary'[Inventory Count]), 0))
		isHidden
		displayFolder: Mailbox retention planning
		lineageTag: 6a2e0eba-1caa-4d0a-a128-7606aa13baf2

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Planning Retained' =
			VAR _selected = ISFILTERED('Daily Domain'[Domain]) || ISFILTERED('Daily Domain'[Domain Key])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _scope = FILTER(ALL('Mailbox Migration Exception Summary'), IF(_selected, 'Mailbox Migration Exception Summary'[Domain Key] <> "__all__" && 'Mailbox Migration Exception Summary'[Source Domain] IN _domains, 'Mailbox Migration Exception Summary'[Domain Key] = "__all__"))
			RETURN IF([Mailbox Exception Source Status] <> "Qualified", BLANK(), COALESCE(SUMX(_scope, 'Mailbox Migration Exception Summary'[Retained Count]), 0))
		isHidden
		displayFolder: Mailbox retention planning
		lineageTag: fe986838-d572-46bd-9f27-73db3cdf6883

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Planning Review' =
			VAR _selected = ISFILTERED('Daily Domain'[Domain]) || ISFILTERED('Daily Domain'[Domain Key])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _scope = FILTER(ALL('Mailbox Migration Exception Summary'), IF(_selected, 'Mailbox Migration Exception Summary'[Domain Key] <> "__all__" && 'Mailbox Migration Exception Summary'[Source Domain] IN _domains, 'Mailbox Migration Exception Summary'[Domain Key] = "__all__"))
			RETURN IF([Mailbox Exception Source Status] <> "Qualified", BLANK(), COALESCE(SUMX(_scope, 'Mailbox Migration Exception Summary'[Review Count]), 0) + IF(_selected, CALCULATE(MAX('Mailbox Migration Exception Summary'[Global Review Count]), ALL('Mailbox Migration Exception Summary')), 0))
		isHidden
		displayFolder: Mailbox retention planning
		lineageTag: de5d87fb-588d-42a4-9192-afc5b7442857

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Planning Documentation' =
			VAR _selected = ISFILTERED('Daily Domain'[Domain]) || ISFILTERED('Daily Domain'[Domain Key])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _scope = FILTER(ALL('Mailbox Migration Exception Summary'), IF(_selected, 'Mailbox Migration Exception Summary'[Domain Key] <> "__all__" && 'Mailbox Migration Exception Summary'[Source Domain] IN _domains, 'Mailbox Migration Exception Summary'[Domain Key] = "__all__"))
			RETURN IF([Mailbox Exception Source Status] <> "Qualified", BLANK(), COALESCE(SUMX(_scope, 'Mailbox Migration Exception Summary'[Documentation Warning Count]), 0))
		isHidden
		displayFolder: Mailbox retention planning
		lineageTag: 9eec3a9f-bffa-4bed-a0fa-ba183c40e759

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Retained Text' = IF([Mailbox Exception Source Status] <> "Qualified", "Not measured", FORMAT([Mailbox Planning Retained], "#,0") & IF([Mailbox Planning Review] > 0, " | Matched decisions only", ""))
		displayFolder: Mailbox retention planning
		lineageTag: 0c9d50f0-d4e0-4a0e-903c-7ec5f2dfbc38

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Exceptions Review Text' = IF([Mailbox Exception Source Status] <> "Qualified", "Not measured", FORMAT([Mailbox Planning Review], "#,0"))
		displayFolder: Mailbox retention planning
		lineageTag: 66afd8a8-3832-4564-8ffc-ccc202639a16

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Remaining Scope Text' = VAR _n = [Mailbox Planning Inventory] VAR _e = [Mailbox Planning Retained] RETURN IF([Mailbox Exception Source Status] <> "Qualified", "Not measured", IF([Mailbox Planning Review] > 0, "Pending review", IF(_e > _n, "Reconciliation error", FORMAT(_n - _e, "#,0"))))
		displayFolder: Mailbox retention planning
		lineageTag: 500a358b-497c-4cbe-b5fb-5955eac8ccad

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Planning Context' = IF([Mailbox Exception Source Status] <> "Qualified", "Planning snapshot | " & [Mailbox Exception Source Status] & " | Activate and prepare the reviewed exception register", "Planning snapshot: " & MAX('Mailbox Migration Exception Summary'[Snapshot Date]) & " | Local planning inventory N: " & FORMAT([Mailbox Planning Inventory], "#,0") & " | Documentation warnings: " & FORMAT([Mailbox Planning Documentation], "#,0") & " | Period and date range apply to history only")
		displayFolder: Mailbox retention planning
		lineageTag: f57ae5f6-ca24-4407-9638-084f6d1941b6

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Exceptions Provenance' = [Mailbox Planning Context] & UNICHAR(10) & "Source: SmartWorkplaceIntelligence-MailboxMigrationExceptions.xlsx" & UNICHAR(10) & "Workbook SHA256: " & MAX('Mailbox Migration Exception Summary'[Workbook SHA256]) & UNICHAR(10) & "Workbook modified UTC: " & MAX('Mailbox Migration Exception Summary'[Workbook Modified UTC]) & UNICHAR(10) & "Captured UTC: " & MAX('Mailbox Migration Exception Summary'[Captured UTC]) & UNICHAR(10) & "Confirmed bindings SHA256: " & MAX('Mailbox Migration Exception Summary'[Binding SHA256]) & UNICHAR(10) & "Missing reasons/owners and overdue reviews do not cancel a uniquely matched Yes. Review count concerns unresolved identity, decision and scope."
		displayFolder: Mailbox retention planning
		lineageTag: f7d34c82-5c13-4bc5-9cee-395c2b0c3dff

	/// Planning snapshot from a verified register and the same qualified detailed local inventory; independent of historical Period/Date. Domain is applied explicitly; unknown-domain reviews block all scopes.
	measure 'Mailbox Exception Visible' = VAR _selected = ISFILTERED('Daily Domain'[Domain]) || ISFILTERED('Daily Domain'[Domain Key]) VAR _domains = VALUES('Daily Domain'[Domain]) VAR _domain = SELECTEDVALUE('Mailbox Migration Exceptions'[Source Domain]) VAR _unknown = SELECTEDVALUE('Mailbox Migration Exceptions'[Domain Key]) = "__unknown__" RETURN IF(NOT _selected || _unknown || _domain IN _domains, 1, 0)
		isHidden
		displayFolder: Mailbox retention planning
		lineageTag: f0f6e92f-47e7-40cf-9d1a-ca376af9dee6

