	/// License-review prioritization from exact Office 365 workload activity evidence and account status. It is evidence for review, not proof that a license is unused.
	column 'License review band' = VAR _activityMatch = LOOKUPVALUE('Native Workload Activity'[MatchStatus], 'Native Workload Activity'[TenantUserKey], 'Native User Evidence'[TenantUserKey]) VAR _workloadLast = LOOKUPVALUE('Native Workload Activity'[LastActivityDate], 'Native Workload Activity'[TenantUserKey], 'Native User Evidence'[TenantUserKey]) VAR _days = IF(NOT ISBLANK(_workloadLast), DATEDIFF(_workloadLast, TODAY(), DAY)) RETURN SWITCH(TRUE(), 'Native User Evidence'[AccountEnabled] = FALSE(), "Priority · disabled account", _activityMatch <> "ExactUPN", "Coverage gap · no exact workload row", ISBLANK(_workloadLast), "Priority · no M365 activity in D180", _days > 90, "Priority · workload over 90 days", _days > 30, "Watch · workload 31–90 days", "Recent M365 workload activity")
		dataType: string
		lineageTag: 0b9d8f5c-d36a-40c1-9a01-20ed16768571
		summarizeBy: none

