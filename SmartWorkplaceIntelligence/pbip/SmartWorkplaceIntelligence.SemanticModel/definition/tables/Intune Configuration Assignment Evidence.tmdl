/// Governed IntuneConfigurationAssignmentEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Configuration Assignment Evidence'
	lineageTag: 1198c432-84ca-4c99-8925-37e23e192ca9

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Assignments' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Configuration Assignment Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 701d48e9-f162-462a-9f05-13043a4301bd

	/// Prepared IntuneConfigurationAssignmentEvidence.csv: TenantKey. Reported source scope only; not whole-tenant coverage or endpoint health.
