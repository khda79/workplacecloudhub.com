	/// Site URL associated with a coverage outcome when the source provides one.
	column 'Coverage URL'
		dataType: string
		lineageTag: 907a9ee2-b8b7-428d-ba63-1137428f9157
		sourceColumn: Coverage URL

	/// Collector-provided detail for a coverage issue; blank for successful or intentionally excluded rows.
	column 'Error Message'
		dataType: string
		lineageTag: 21dc9d03-8645-4428-a2a8-01ef142e8b14
		sourceColumn: Error Message

	column 'Optional Schema Ready'
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 1d317aa2-fad6-4180-adfa-234f83b912fe
		summarizeBy: none
		sourceColumn: Optional Schema Ready

		annotation SummarizationSetBy = Automatic

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 9dbe304d-5a5f-4838-82b5-9fc477fe5fab
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'SharePoint On-prem Collection Coverage' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Raw = GetSharePointOnPremCsv("SharePoint_OnPrem_CollectionCoverage.csv", {"TenantKey", "FarmId", "RunId", "WebApplicationId", "ContentDatabaseId", "SiteCollectionId", "Status", "ErrorStage"}, {"Url", "ErrorMessage"}),
				    Nulls = Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, {}),
				    Typed = Table.TransformColumnTypes(Nulls, {}, "en-US"),
				    FarmKey = Table.AddColumn(Typed, "Farm Key", each [TenantKey] & "|" & [FarmId], type text),
				    WebKey = Table.AddColumn(FarmKey, "Web Application Key", each [TenantKey] & "|" & [FarmId] & "|" & [WebApplicationId], type text),
				    DbKey = Table.AddColumn(WebKey, "Content Database Key", each [TenantKey] & "|" & [FarmId] & "|" & [ContentDatabaseId], type text),
				    Renamed = Table.RenameColumns(DbKey, {{"TenantKey", "Tenant Key"}, {"FarmId", "Farm ID"}, {"RunId", "Run ID"}, {"WebApplicationId", "Web Application ID"}, {"ContentDatabaseId", "Content Database ID"}, {"SiteCollectionId", "Site Collection ID"}, {"Status", "Coverage Status"}, {"ErrorStage", "Error Stage"}, {"Url", "Coverage URL"}, {"ErrorMessage", "Error Message"}})
				in
				    Renamed)
				in
				    Readers[Finish](BusinessRows)
