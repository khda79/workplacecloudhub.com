/// One coverage result per attempted site collection or content database failure. ExcludedPersonal is intentional; other statuses indicate partial coverage.
table 'SharePoint On-prem Collection Coverage'
	lineageTag: 6d2550a8-9561-42e9-a66a-fa4ae5e199d4

	/// Coverage attempts and database-level exceptions in the current Content CSV.
	measure 'Coverage Rows' = COUNTROWS('SharePoint On-prem Collection Coverage')
		formatString: #,##0
		lineageTag: 7d343a40-e3db-44e3-a5b1-cb6f9573e71d

	/// Coverage rows other than Collected or intentionally ExcludedPersonal; a nonzero value makes the Content run Partial.
	measure 'Coverage Issues' = CALCULATE(COUNTROWS('SharePoint On-prem Collection Coverage'), KEEPFILTERS('SharePoint On-prem Collection Coverage'[Coverage Status] <> "Collected"), KEEPFILTERS('SharePoint On-prem Collection Coverage'[Coverage Status] <> "ExcludedPersonal"))
		formatString: #,##0
		lineageTag: dbd4ff94-9e4b-4030-b153-af6002a7c389

	/// Personal site collections intentionally omitted from detailed Content CSVs but retained in coverage.
	measure 'Excluded Personal Collections' = CALCULATE(COUNTROWS('SharePoint On-prem Collection Coverage'), KEEPFILTERS('SharePoint On-prem Collection Coverage'[Coverage Status] = "ExcludedPersonal"))
		formatString: #,##0
		lineageTag: 43f06896-7bbf-4d7d-814b-3f0db5622ba0

	/// Reports Partial for coverage anomalies; validates optional Content schema and run alignment. Receipt hashes and live farm qualification are separate checks.
	measure 'Content Coverage Health' = VAR _coverageRows = COUNTROWS('SharePoint On-prem Collection Coverage') VAR _issues = [Coverage Issues] VAR _schemaMissing = CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Optional Schema Ready] <> TRUE())) VAR _siteRun = SELECTEDVALUE('SharePoint On-prem Site Collections'[Run ID]) VAR _coverageRun = SELECTEDVALUE('SharePoint On-prem Collection Coverage'[Run ID]) VAR _collected = CALCULATE(COUNTROWS('SharePoint On-prem Collection Coverage'), KEEPFILTERS('SharePoint On-prem Collection Coverage'[Coverage Status] = "Collected")) VAR _siteRows = COUNTROWS('SharePoint On-prem Site Collections') RETURN SWITCH(TRUE(), _coverageRows = 0, "Unavailable", _schemaMissing > 0, "Schema pending", _issues > 0, "Partial", ISBLANK(_coverageRun) || _siteRun <> _coverageRun, "Run mismatch", _siteRows <> _collected, "Count mismatch", "Coverage complete")
		formatString: @
		lineageTag: da6d5e95-1f63-482f-85fb-4ac0314b8db5

	/// Visual filter flag for rows representing coverage anomalies; intentionally excluded personal sites are not issues.
	measure 'Coverage Issue Row' = VAR _status = SELECTEDVALUE('SharePoint On-prem Collection Coverage'[Coverage Status]) RETURN IF(_status IN {"Collected", "ExcludedPersonal"}, 0, 1)
		formatString: 0
		isHidden
		lineageTag: bf22e299-be5d-4047-8389-11f7e4da965a

	column 'Tenant Key'
		dataType: string
		isHidden
		lineageTag: b32278f9-b846-45bf-a734-db4f12a23c40
		sourceColumn: Tenant Key

	column 'Farm ID'
