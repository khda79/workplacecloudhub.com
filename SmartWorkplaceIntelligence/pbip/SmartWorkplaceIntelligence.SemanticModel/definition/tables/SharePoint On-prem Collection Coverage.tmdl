		sourceColumn: Site Collection ID

	column 'Coverage Status'
		dataType: string
		lineageTag: 2e2e6839-667d-4705-b2a6-e5e129cce8ea
		sourceColumn: Coverage Status

	column 'Error Stage'
		dataType: string
		lineageTag: 0726a842-ab59-4436-bd78-0d36d6ce8f35
		sourceColumn: Error Stage

	column 'Farm Key'
		dataType: string
		isHidden
		lineageTag: 3e9f7f23-b333-4b06-bf1f-2e0541644eab
		sourceColumn: Farm Key

	column 'Web Application Key'
		dataType: string
		isHidden
		lineageTag: 03acdb6a-1f6d-4437-b4a5-3aaebac35efe
