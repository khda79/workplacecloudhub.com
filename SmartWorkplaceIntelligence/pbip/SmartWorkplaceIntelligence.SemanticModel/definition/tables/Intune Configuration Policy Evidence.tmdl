/// Governed IntuneConfigurationPolicyEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Configuration Policy Evidence'
	lineageTag: 3e8964b6-d2db-4765-b621-623d1b34a088

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Policies (Catalog)' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Configuration Policy Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: fc9a25c2-cb3a-4e9a-a07b-fc9d82d1806c

	/// Prepared IntuneConfigurationPolicyEvidence.csv: TenantKey. Reported source scope only; not whole-tenant coverage or endpoint health.
	column 'Tenant Key'
		dataType: string
		isHidden
		lineageTag: 49a1e40e-ed55-46c3-81be-5f43fdb58554
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared IntuneConfigurationPolicyEvidence.csv: EvidenceKey. Reported source scope only; not whole-tenant coverage or endpoint health.
