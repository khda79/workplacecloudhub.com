/// Synthetic policy eligibility and protection evidence.
table 'Backup Coverage'
	lineageTag: 8af38ee8-f60d-48b5-85f3-bf296a98433e

	/// Protected eligible mailboxes divided by eligible mailboxes.
	measure 'Mailbox Backup Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Entity Type] = "Mailbox"), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible"), KEEPFILTERS('Backup Coverage'[Coverage State] = "Protected")), CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Entity Type] = "Mailbox"), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible")))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 15e220a2-20ea-43ff-834f-0d8c852667fe

	/// Protected eligible objects divided by eligible objects.
	measure 'Backup Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible"), KEEPFILTERS('Backup Coverage'[Coverage State] = "Protected")), CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible")))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: fade985c-4cab-4d35-bcd3-9b3315879c0c

	/// Protected in-scope objects divided by the governed eligible population.
	measure 'Backup Policy Scope Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible"), KEEPFILTERS('Backup Coverage'[Coverage State] = "Protected"), KEEPFILTERS('Backup Coverage'[Policy Scope] = "InScope")), CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible")))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 57f75405-13b9-4620-8563-0578ceb09b4b

	/// Protected eligible user accounts divided by eligible user accounts.
	measure 'Protected Account Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Entity Type] = "UserAccount"), KEEPFILTERS('Backup Coverage'[Coverage State] = "Protected")), CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Entity Type] = "UserAccount"), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible")))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: c1565807-c412-4a83-aaa8-4aa45b0b8764

	/// Protected eligible sites divided by eligible sites.
	measure 'Site Backup Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Entity Type] = "Site"), KEEPFILTERS('Backup Coverage'[Coverage State] = "Protected")), CALCULATE(COUNTROWS('Backup Coverage'), KEEPFILTERS('Backup Coverage'[Entity Type] = "Site"), KEEPFILTERS('Backup Coverage'[Eligibility State] = "Eligible")))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: e477bfd4-149c-4cf8-8336-4b3f2d70b570

	/// Distinct protected entities in scope.
	measure '# Protected Entities' = CALCULATE(DISTINCTCOUNT('Backup Coverage'[Entity Surrogate Key]), KEEPFILTERS('Backup Coverage'[Coverage State] = "Protected"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: ae21cfc5-7e69-4484-942d-e17fbeab3f4f

