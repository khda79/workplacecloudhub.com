		annotation SummarizationSetBy = Automatic

	partition 'AD User Evidence' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("ADUserSource.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantADUserKey", dataType="String"], [name="ObjectGUID", dataType="String"], [name="ObjectSID", dataType="String"], [name="DomainName", dataType="String"], [name="DistinguishedName", dataType="String"], [name="SamAccountName", dataType="String"], [name="UserPrincipalName", dataType="String"], [name="DisplayName", dataType="String"], [name="Enabled", dataType="Boolean"], [name="Department", dataType="String"], [name="Title", dataType="String"], [name="Country", dataType="String"], [name="ManagerDistinguishedName", dataType="String"], [name="ManagerADObjectKey", dataType="String"], [name="TenantUserKey", dataType="String"], [name="CloudMatchStatus", dataType="String"], [name="LastLogonTimestampRaw", dataType="String"], [name="LastLogonUtcDateTime", dataType="DateTime"], [name="LastLogonStatus", dataType="String"], [name="CreationRaw", dataType="String"], [name="CreationUtcDateTime", dataType="DateTime"], [name="CreationStatus", dataType="String"], [name="SourceCollectedDateTime", dataType="DateTime"], [name="ModificationRaw", dataType="String", allowHistoricalMissing=true], [name="ModificationUtcDateTime", dataType="DateTime", allowHistoricalMissing=true], [name="ModificationStatus", dataType="String", allowHistoricalMissing=true], [name="PasswordExpired", dataType="Boolean", allowHistoricalMissing=true], [name="PasswordExpiryStatus", dataType="String", allowHistoricalMissing=true]}))
				in
				    Readers[Finish](BusinessRows)

	annotation PBI_ResultType = Exception
