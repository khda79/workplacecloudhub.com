/// Native source facet migrated from ADUserSource; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'AD User Evidence'
	lineageTag: 1e115a2f-b2e1-483c-ae44-df45b0b0b0f8

	/// Native AD records explicitly linked to one selected cloud user identity. Migrated without changing the source calculation.
	measure 'Native Selected user AD objects' =
			VAR InventoryUsers = CALCULATETABLE(VALUES('Native User Evidence'[TenantUserKey]), REMOVEFILTERS('Native User Evidence'), TREATAS(VALUES('User Inventory Evidence'[User Source ID]), 'Native User Evidence'[SourceUserId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('User Inventory Evidence'), CALCULATE((IF ( HASONEVALUE ( 'Native User Evidence'[TenantUserKey] ), CALCULATE ( COUNTROWS ( 'AD User Evidence' ), TREATAS ( VALUES ( 'Native User Evidence'[TenantUserKey] ), 'AD User Evidence'[TenantUserKey] ) ) )), KEEPFILTERS(TREATAS(InventoryUsers, 'AD User Evidence'[TenantUserKey]))), (IF ( HASONEVALUE ( 'Native User Evidence'[TenantUserKey] ), CALCULATE ( COUNTROWS ( 'AD User Evidence' ), TREATAS ( VALUES ( 'Native User Evidence'[TenantUserKey] ), 'AD User Evidence'[TenantUserKey] ) ) )))
		formatString: #,##0
		displayFolder: Native evidence
		lineageTag: 795ef77c-e02f-4a78-bee3-1c91b8ec8050

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · AD User Evidence' =
			VAR InventoryUsers = CALCULATETABLE(VALUES('Native User Evidence'[TenantUserKey]), REMOVEFILTERS('Native User Evidence'), TREATAS(VALUES('User Inventory Evidence'[User Source ID]), 'Native User Evidence'[SourceUserId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('User Inventory Evidence'), CALCULATE((COUNTROWS('AD User Evidence')), KEEPFILTERS(TREATAS(InventoryUsers, 'AD User Evidence'[TenantUserKey]))), (COUNTROWS('AD User Evidence')))
		formatString: #,0
		isHidden
		lineageTag: 602a6ddb-cf39-45a2-8006-b8e18737f42f

