	/// Last content modification timestamp reported by the source; it is not proof of user inactivity.
	column 'Last Content Modified UTC'
		dataType: dateTime
		lineageTag: 8cdb2620-7398-41cb-840c-2527b7811b0a
		sourceColumn: Last Content Modified UTC

	/// Sort order for snapshot-relative last modification age bands.
	column 'Last Modification Age Order'
		dataType: int64
