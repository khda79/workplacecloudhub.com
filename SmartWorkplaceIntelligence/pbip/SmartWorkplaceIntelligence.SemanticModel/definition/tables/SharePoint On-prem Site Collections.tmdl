		sourceColumn: Last Modification Age Order

	/// Source lock issue with punctuation-only values suppressed for display.
	column 'Lock Issue Display'
		dataType: string
		lineageTag: 4b41fc3a-5b8a-4998-ad68-4e61b36f1bba
		sourceColumn: Lock Issue Display

	/// Age of last observed content modification relative to this row's collection timestamp; not a user inactivity signal.
	column 'Last Modification Age Band'
		dataType: string
		lineageTag: fa7d59a1-9aec-44f8-9888-2478fdf25031
		sourceColumn: Last Modification Age Band
		sortByColumn: 'Last Modification Age Order'

	/// Friendly site category label for report tables; raw source category is preserved.
	column 'Site Category Display'
