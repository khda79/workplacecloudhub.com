/// One observed SharePoint Server site collection per row. Partial runs and excluded personal collections are qualified by Collection Coverage; no visit or activity inference.
table 'SharePoint On-prem Site Collections'
	lineageTag: e350a85a-fd42-42ac-8a4f-abc952ff1b90

	/// Site collections with collected metadata in the current Content snapshot; this count is observed scope and may be partial.
	measure 'Collected Site Collections' = CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Collection Status] = "Collected"))
		formatString: #,##0
		lineageTag: 0d98f8be-4037-4923-8cbf-5f1f1a10d55d

	/// Observed site collection rows whose collection status is incomplete.
	measure 'Site Rows With Missing Metadata' = CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Collection Status] <> "Collected"))
		formatString: #,##0
		lineageTag: 8fc2c4f4-b828-471c-ba53-392676d1b671

	/// Site collection lock observations missing or conflicting; boolean properties do not substitute for Lock State.
	measure 'Unverified Lock Observations' = CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Lock Status] <> "Observed"))
		formatString: #,##0
		lineageTag: 9511f94e-bba5-4e4b-aa50-9534ff48035e

	/// Observed site collections with a restrictive lock state. Excludes unverified locks.
	measure 'Restricted Site Collections' = CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Lock Status] = "Observed"), KEEPFILTERS('SharePoint On-prem Site Collections'[Lock State] IN {"NoAdditions","ReadOnly","NoAccess"}))
		formatString: #,##0
		lineageTag: b6d21d23-639d-47b3-a38f-526d5b824799

	/// Observed site collection rows without a resolved Site Category; inspect Site Category Status, including HostListUnconfigured.
	measure 'Site Categories Unresolved' = CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS(ISBLANK('SharePoint On-prem Site Collections'[Site Category]) || 'SharePoint On-prem Site Collections'[Site Category] = ""))
		formatString: #,##0
		lineageTag: ea0eb472-5fb2-4bd9-891a-503ed4ce175d

	/// Observed site rows with a positive quota and a calculated Quota Usage Percent.
	measure 'Sites With Measured Quota' = CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Quota Usage Status] = "Observed"))
		formatString: #,##0
		lineageTag: 995150ed-6425-4e27-af9b-4b245af2d41b

	/// Storage in GB across observed site rows only. Partial Content runs are not farm-wide storage totals.
	measure 'Observed Site Storage (GB)' = DIVIDE(SUM('SharePoint On-prem Site Collections'[Storage Bytes]), 1000000000)
		formatString: #,##0.0
		lineageTag: 060ef29f-03aa-49a3-b055-36e74420d679

	/// Terabytes of storage summed only across observed site collection rows; partial Content coverage and excluded personal sites prevent a farm-wide total.
	measure 'Observed Site Storage (TB)' = DIVIDE([Observed Site Storage (GB)], 1000)
		formatString: #,##0.00
		lineageTag: b314786d-b49d-483b-b490-1ee55dd1b6e0

	/// Rows preserved in the current Content site collection CSV, including incomplete metadata; this is not a complete farm inventory.
	measure 'Observed Site Collection Rows' = COALESCE(COUNTROWS('SharePoint On-prem Site Collections'), 0)
		formatString: #,##0
		lineageTag: 2ee89fda-45fa-4296-9653-7609d553a2a9

	/// Observed site collection rows with no secondary owner login in the source.
	measure 'Sites Without Secondary Owner' = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS(ISBLANK('SharePoint On-prem Site Collections'[Secondary Owner]) || 'SharePoint On-prem Site Collections'[Secondary Owner] = "")), 0)
		formatString: #,##0
		lineageTag: 5ee98875-3bb8-483e-b729-a77f7c41a8a1

	/// Observed site collection rows with neither a primary nor a secondary owner login reported.
	measure 'Sites Without Any Owner' = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS(ISBLANK('SharePoint On-prem Site Collections'[Primary Owner]) || 'SharePoint On-prem Site Collections'[Primary Owner] = ""), KEEPFILTERS(ISBLANK('SharePoint On-prem Site Collections'[Secondary Owner]) || 'SharePoint On-prem Site Collections'[Secondary Owner] = "")), 0)
		formatString: #,##0
		lineageTag: ad7669bb-06b1-4af5-ae2e-a1a4eedd6a50

	/// Observed site collection rows where the source reports NoQuota; this is distinct from unavailable quota evidence.
	measure 'Sites Without Quota' = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Quota Usage Status] = "NoQuota")), 0)
		formatString: #,##0
		lineageTag: 42ceea30-33e6-41c7-be44-5c277d53a91e

	/// Observed site collection rows whose category host list is unconfigured in the source.
	measure 'Host List Unconfigured Sites' = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Site Category Status] = "HostListUnconfigured")), 0)
		formatString: #,##0
		lineageTag: 3dddb6e3-5f32-40ca-8196-b44ce295f0ad

	/// Filter-aware category-status and quota context for observed site rows; adapts to source qualification state.
	measure 'Category And Quota Context' =
			VAR Total = [Observed Site Collection Rows]
			VAR Unconfigured = [Host List Unconfigured Sites]
			VAR CategoryObserved = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Site Category Status] = "Observed")), 0)
			VAR MyHost = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Site Category] = "OtherOnMyHost")), 0)
			VAR OtherCategory = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Site Collections'), KEEPFILTERS('SharePoint On-prem Site Collections'[Site Category] = "Other")), 0)
			VAR RemainingCategories = CategoryObserved - MyHost - OtherCategory
			VAR CategoryText = IF(Unconfigured > 0, FORMAT(Unconfigured, "#,##0") & "/" & FORMAT(Total, "#,##0") & " category host list unconfigured", IF(CategoryObserved = Total, FORMAT(Total, "#,##0") & "/" & FORMAT(Total, "#,##0") & " classified: " & FORMAT(MyHost, "#,##0") & " MySites host sites, " & FORMAT(OtherCategory, "#,##0") & " other sites" & IF(RemainingCategories > 0, ", " & FORMAT(RemainingCategories, "#,##0") & " other categories", ""), "Site category status requires review"))
			RETURN IF(Total = 0, "Site category and quota evidence unavailable", CategoryText & "; " & FORMAT([Sites Without Quota], "#,##0") & "/" & FORMAT(Total, "#,##0") & " without quota")
		formatString: @
		lineageTag: 443a96b7-71fc-4859-8c64-e8b319b09359

	/// Observed distinct site collections with exact ReadOnly lock state; excludes NoAdditions and unknown.
	measure 'Read-only site collections' = CALCULATE(DISTINCTCOUNT('SharePoint On-prem Site Collections'[Site Collection ID]),KEEPFILTERS('SharePoint On-prem Site Collections'[Lock State]="ReadOnly"))
		formatString: #,0
		lineageTag: fe9aecdc-0533-463f-8627-b0246f9022a2

