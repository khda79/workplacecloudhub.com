		sourceColumn: Primary Owner Display

	/// Identity claim prefix removed for display; missing values are grouped first as (none).
	column 'Secondary Owner Display'
		dataType: string
		lineageTag: 3085d223-c973-41c9-892d-70615cb41983
		sourceColumn: Secondary Owner Display

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 4a731f21-172f-4bfe-8b77-e1eb26c42522
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'SharePoint On-prem Site Collections' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Raw = GetSharePointOnPremCsv("SharePoint_OnPrem_SiteCollections.csv", {"TenantKey", "FarmId", "RunId", "WebApplicationId", "ContentDatabaseId", "SiteCollectionId", "Url", "StorageBytes", "QuotaLimitBytes", "LockState", "LockStatus", "CollectionStatus"}, {"QuotaUsagePercent", "QuotaUsageStatus", "SiteCategory", "SiteCategoryStatus", "CollectedAtUtc", "OwnerLogin", "SecondaryOwnerLogin", "LastContentModifiedUtc", "LockIssue"}),
				    Nulls = Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, {"StorageBytes", "QuotaLimitBytes", "QuotaUsagePercent", "CollectedAtUtc", "LastContentModifiedUtc"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"StorageBytes", Int64.Type}, {"QuotaLimitBytes", Int64.Type}, {"QuotaUsagePercent", type number}, {"CollectedAtUtc", type datetime}, {"LastContentModifiedUtc", type datetime}}, "en-US"),
				    Aged = Table.AddColumn(Typed, "Last Modification Age Band", each let delta = try Duration.Days([CollectedAtUtc] - [LastContentModifiedUtc]) otherwise null in if delta = null then "Unknown" else if delta <= 30 then "0-30 days" else if delta <= 180 then "31-180 days" else if delta <= 365 then "181-365 days" else "365+ days", type text),
				    AgeOrder = Table.AddColumn(Aged, "Last Modification Age Order", each if [Last Modification Age Band] = "0-30 days" then 1 else if [Last Modification Age Band] = "31-180 days" then 2 else if [Last Modification Age Band] = "181-365 days" then 3 else if [Last Modification Age Band] = "365+ days" then 4 else 5, Int64.Type),
				    CleanIssue = Table.AddColumn(AgeOrder, "Lock Issue Display", each let v = if [LockIssue] = null then "" else Text.Trim(Text.From([LockIssue])), letters = Text.Select(v, {"A".."Z", "a".."z", "0".."9"}) in if letters = "" then null else v, type text),
				    WithoutRawIssue = Table.RemoveColumns(CleanIssue, {"LockIssue"}),
				    FarmKey = Table.AddColumn(WithoutRawIssue, "Farm Key", each [TenantKey] & "|" & [FarmId], type text),
				    WebKey = Table.AddColumn(FarmKey, "Web Application Key", each [TenantKey] & "|" & [FarmId] & "|" & [WebApplicationId], type text),
				    DbKey = Table.AddColumn(WebKey, "Content Database Key", each [TenantKey] & "|" & [FarmId] & "|" & [ContentDatabaseId], type text),
				    Renamed = Table.RenameColumns(DbKey, {{"TenantKey", "Tenant Key"}, {"FarmId", "Farm ID"}, {"RunId", "Run ID"}, {"CollectedAtUtc", "Collected At UTC"}, {"OwnerLogin", "Primary Owner"}, {"SecondaryOwnerLogin", "Secondary Owner"}, {"LastContentModifiedUtc", "Last Content Modified UTC"}, {"WebApplicationId", "Web Application ID"}, {"ContentDatabaseId", "Content Database ID"}, {"SiteCollectionId", "Site Collection ID"}, {"Url", "Site URL"}, {"StorageBytes", "Storage Bytes"}, {"QuotaLimitBytes", "Quota Limit Bytes"}, {"QuotaUsagePercent", "Quota Usage Percent"}, {"QuotaUsageStatus", "Quota Usage Status"}, {"SiteCategory", "Site Category"}, {"SiteCategoryStatus", "Site Category Status"}, {"LockState", "Lock State"}, {"LockStatus", "Lock Status"}, {"CollectionStatus", "Collection Status"}}),
				    CategoryDisplay = Table.AddColumn(Renamed, "Site Category Display", each if [Site Category] = "OtherOnMyHost" then "MySites host sites" else if [Site Category] = "Other" then "Other sites" else [Site Category], type text),
				    PrimaryDisplay = Table.AddColumn(CategoryDisplay, "Primary Owner Display", each let v = try Text.Trim(Text.From([Primary Owner])) otherwise "" in if v = null or v = "" then "(not reported)" else List.Last(Text.Split(v, "|")), type text),
				    SecondaryDisplay = Table.AddColumn(PrimaryDisplay, "Secondary Owner Display", each let v = try Text.Trim(Text.From([Secondary Owner])) otherwise "" in if v = null or v = "" then "(none)" else List.Last(Text.Split(v, "|")), type text)
				in
				    SecondaryDisplay)
				in
				    Readers[Finish](BusinessRows)
