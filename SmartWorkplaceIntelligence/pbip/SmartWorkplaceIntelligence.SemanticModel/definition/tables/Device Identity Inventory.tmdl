				"Stop Error State",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Stop Error State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Entra Hardware ID Conflict",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Entra Hardware ID Conflict],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Removal Candidate",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Removal Candidate],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows 11 Release State",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows 11 Release State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Entra Account State",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Entra Account State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),"Unknown"),
				"Intune Encryption State",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Intune Encryption State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"System Drive Capacity (GB)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[System Drive Capacity (GB)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Free Disk Space (GB)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Free Disk Space (GB)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
