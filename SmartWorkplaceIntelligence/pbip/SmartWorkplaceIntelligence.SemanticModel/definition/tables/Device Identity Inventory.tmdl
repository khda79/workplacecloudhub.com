/// Source identity grain retained for audit. Cached AD/Entra/Intune only; consolidation uses explicit unambiguous Autopilot IDs. Disconnected audit utility.
table 'Device Identity Inventory'
	lineageTag: f9125591-2067-4ac1-a027-066fc2410a3b

	/// Source-grain audit, outside PC equipment totals. Observed device Country/AD Domain only.
	measure 'Source Identity Row In Scope' = VAR _c=VALUES('Country Selection'[Country]) VAR _d=VALUES('Daily Domain'[Domain]) VAR _cf=ISFILTERED('Country Selection') VAR _df=ISFILTERED('Daily Domain') VAR _rows=FILTER('Device Identity Inventory',(NOT _cf || COALESCE(LOOKUPVALUE('Country Selection'[Country],'Country Selection'[Source Country],[Country Name]),[Country Name]) IN _c) && (NOT _df || [AD Domain] IN _d)) RETURN IF(COUNTROWS(_rows)>0,1,0)
		formatString: 0
		lineageTag: efa6cc38-5776-4eee-a1c4-4137c45fe918

	/// Read-only report utility applying the disconnected primary-user selector to source-qualified device rows.
	measure 'Primary user row match · Device Identity Inventory' = VAR PresentRows = IF(ISFILTERED('Primary User Selection'[Primary user]), CALCULATE(COUNTROWS('Device Identity Inventory'), KEEPFILTERS(TREATAS(VALUES('Primary User Selection'[Primary user]), 'Device Identity Inventory'[Primary User (report)]))), COUNTROWS('Device Identity Inventory')) RETURN IF(PresentRows>0,1,BLANK())
		formatString: 0
		isHidden
		lineageTag: 943ff70d-fd69-4989-b61a-52eb13e81022

