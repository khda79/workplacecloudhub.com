				"AD Domain",COALESCE(LOOKUPVALUE('AD Computer Evidence'[DomainName],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),LOOKUPVALUE('Native Device Evidence'[AD Domain],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Unknown"),
