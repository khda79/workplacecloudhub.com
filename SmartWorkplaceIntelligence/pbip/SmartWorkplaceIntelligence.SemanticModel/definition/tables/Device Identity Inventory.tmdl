	column 'Primary User SAM'
		lineageTag: 6f3bd43e-8d6a-402f-96fd-fa9b72c4cc51
		isNameInferred
		sourceColumn: [Primary User SAM]

	/// Qualified platform/form factor class. Windows/macOS computers PC; Android/iOS/iPadOS mobile; servers separate; no OS invention for unknown identities.
	column 'Device Class' = VAR _os=LOWER(COALESCE([Operating System Family],"")) VAR _cat=[Device Category] RETURN SWITCH(TRUE(),CONTAINSSTRING(_os,"server")||_cat="Server","Server",CONTAINSSTRING(_os,"android")||_os IN {"ios","ipados","iphone","ipad"},"Mobile",CONTAINSSTRING(_os,"windows")||CONTAINSSTRING(_os,"mac")||_cat IN {"PC","PC Windows"},"PC","Unclassified")
		dataType: string
		lineageTag: ed963620-2b80-45b1-a509-9e802a918e5b

	column 'OS Family' = VAR _os=LOWER(COALESCE([Operating System Family],"")) RETURN SWITCH(TRUE(),CONTAINSSTRING(_os,"windows"),"Windows",CONTAINSSTRING(_os,"mac"),"macOS",CONTAINSSTRING(_os,"android"),"Android",_os="ipados","iPadOS",_os IN {"ios","iphone","ipad"},"iOS",CONTAINSSTRING(_os,"linux"),"Linux","Unknown")
		dataType: string
		lineageTag: 187a1a8d-84f6-4714-ab23-5aa39e668acf

	/// Observed primary user, exact source ID and tenant/batch matching only; used by the report search.
	column 'Primary User (report)' =
			VAR _t='Device Identity Inventory'[TenantKey]
			VAR _b='Device Identity Inventory'[Loaded Batch ID]
			VAR _gkey='Device Identity Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Identity Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Identity Inventory'[Device Source ID]))
			VAR _upn=COALESCE('Device Identity Inventory'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			RETURN IF(ISBLANK(_upn)||TRIM(_upn)="","Not resolved",_upn)
		dataType: string
		displayFolder: Report identity context
		lineageTag: b02ac8c6-5cfc-4148-9533-1ccca958da9f

	/// Qualified SAM of the primary user; never inferred from UPN text.
	column 'Primary User SAM (report)' =
			VAR _t='Device Identity Inventory'[TenantKey]
			VAR _b='Device Identity Inventory'[Loaded Batch ID]
			VAR _gkey='Device Identity Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Identity Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Identity Inventory'[Device Source ID]))
			VAR _upn=COALESCE('Device Identity Inventory'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			VAR _sam=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User SAM],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_sam,IF(NOT ISBLANK(_upn),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[UserPrincipalName],_upn,'Native User Evidence'[TenantKey],_t,'Native User Evidence'[Loaded Batch ID],_b,BLANK())),"Not resolved")
		dataType: string
		displayFolder: Report identity context
		lineageTag: ba4e22ed-8bfc-41c5-b817-8ff7c623fffe

	/// Last Windows console user observed at collection. Does not mean current user or last RDP session.
	column 'Last Console User (report)' =
			VAR _t='Device Identity Inventory'[TenantKey]
			VAR _b='Device Identity Inventory'[Loaded Batch ID]
			VAR _gkey='Device Identity Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Identity Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Identity Inventory'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(_status="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon User],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())),"Not observed")
		dataType: string
		displayFolder: Report identity context
		lineageTag: 658d72b4-7946-4371-b77f-672dc126e108

	/// Source-qualified time of last observed console logon; unknown remains blank.
	column 'Last Console Logon UTC (report)' =
			VAR _t='Device Identity Inventory'[TenantKey]
			VAR _b='Device Identity Inventory'[Loaded Batch ID]
			VAR _gkey='Device Identity Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Identity Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Identity Inventory'[Device Source ID]))
			RETURN IF(IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon UTC],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		displayFolder: Report identity context
		lineageTag: 93be6d1a-a5df-4792-8f05-bac4d01efb91

	/// Preserves source status and timestamp qualification, including stale/missing/error evidence.
	column 'Console Logon Qualification (report)' =
			VAR _t='Device Identity Inventory'[TenantKey]
			VAR _b='Device Identity Inventory'[Loaded Batch ID]
			VAR _gkey='Device Identity Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Identity Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Identity Inventory'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _quality=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Quality],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(ISBLANK(_status),"No matched system observation",_status&" · "&_quality)
		dataType: string
		displayFolder: Report identity context
		lineageTag: da48919b-b2f0-467b-8a48-fba4519c561b

	column 'Report Estate Device Key' =
			VAR _canonical=[Canonical Device Key] VAR _id=[Device Source ID]
			RETURN IF(LEFT(_canonical,3)="ad:",_canonical,IF(NOT ISBLANK(_id)&&_id<>"","intune:"&LOWER(_id)))
		dataType: string
		isHidden
		displayFolder: Device qualification
		lineageTag: e6adf116-4035-45f7-91cd-ef8f522a0c30
		summarizeBy: none

	/// Intune/native platform with exact estate AD OS fallback. Missing evidence stays Unknown.
	column 'Platform (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Platform (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _os=LOWER(TRIM(COALESCE([Operating System Family],[Platform],"")))
			VAR _fallback=SWITCH(TRUE(),CONTAINSSTRING(_os,"windows")&&CONTAINSSTRING(_os,"server"),"Windows Server",CONTAINSSTRING(_os,"windows"),"Windows",CONTAINSSTRING(_os,"mac")||_os IN {"os x","osx","darwin"},"macOS",CONTAINSSTRING(_os,"android"),"Android",_os IN {"ipados","ipad"},"iPadOS",_os IN {"ios","iphone"},"iOS",CONTAINSSTRING(_os,"linux"),"Linux",_os IN {"","unknown","unclassified","not observed","other / unknown"},"Unknown","Other")
			RETURN IF(NOT ISBLANK(_estate)&&_estate<>"Unknown",_estate,_fallback)
		dataType: string
		displayFolder: Device qualification
		lineageTag: 1f7c1b2a-ef96-42b6-85a3-3f457baa5ee2
		summarizeBy: none

	column 'Platform evidence (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			RETURN COALESCE(IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Platform evidence (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK())),IF([Platform (report)]="Unknown","Not observed","Native device operating system"))
		dataType: string
		displayFolder: Device qualification
		lineageTag: 7b271227-209f-4094-a41b-32ab132c23d4
		summarizeBy: none

	column 'Device type (report)' = SWITCH(TRUE(),[Platform (report)] IN {"Windows","macOS"},"PC",[Platform (report)] IN {"Android","iOS","iPadOS"},"Mobile",[Platform (report)]="Windows Server","Server",[Platform (report)]="Unknown","Unknown","Other")
		dataType: string
		displayFolder: Device qualification
		lineageTag: 7404224e-fb4f-4553-bda9-a2e6b9b9ee3d
		summarizeBy: none

	column 'Ownership (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Ownership (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _ad=NOT ISBLANK([AD Computer Key])&&NOT(TRIM(COALESCE([AD Domain],"Unknown")) IN {"","Unknown","Not resolved"})
			RETURN COALESCE(_estate,IF(_ad,"Corporate",SWITCH(LOWER([Ownership]),"corporate","Corporate","company","Corporate","personal","Personal","Unknown")))
		dataType: string
		displayFolder: Device qualification
		lineageTag: 7021af9a-4407-4fae-ab3d-f11f17c2c16f
		summarizeBy: none

	column 'Ownership qualification (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Ownership qualification (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_estate,SWITCH([Ownership (report)],"Corporate","Corporate: native device evidence","Personal","Personal: native device evidence","Ownership not observed"))
		dataType: string
		displayFolder: Device qualification
		lineageTag: 54de2902-f2bf-4291-b836-06d91b10c78c
		summarizeBy: none

	column 'Entra state (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Entra state (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _raw=IF(_estate IN {"Enabled","Disabled","Conflicting"},_estate,[Entra Account State])
			RETURN SWITCH(_raw,"Enabled","Enabled","Disabled","Disabled","Conflicting","Conflicting","Unknown")
		dataType: string
		displayFolder: Device qualification
		lineageTag: 9d00bfef-4cfe-4bcd-a718-ca36cd5408f0
		summarizeBy: none

	column 'Enabled state (report)' =
			VAR _ad=[AD Enabled] VAR _e=[Entra state (report)]
			RETURN SWITCH(TRUE(),_e="Conflicting"||(_ad="Yes"&&_e="Disabled")||(_ad="No"&&_e="Enabled"),"Conflicting",_ad="Yes"||_e="Enabled","Enabled",_ad="No"||_e="Disabled","Disabled","Unknown")
		dataType: string
		displayFolder: Device qualification
		lineageTag: 4995e786-a323-4a4d-9764-fe69bbf1068e
		summarizeBy: none

	column 'Account state evidence (report)' =
			VAR _k=[Report Estate Device Key] VAR _t=[TenantKey] VAR _b=[Loaded Batch ID]
			VAR _estate=IF(NOT ISBLANK(_k),LOOKUPVALUE('All Devices Evidence'[Account state evidence (report)],'All Devices Evidence'[Device Key],_k,'All Devices Evidence'[TenantKey],_t,'All Devices Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_estate,IF([Entra state (report)] IN {"Enabled","Disabled"},"Entra AccountEnabled observed","Entra AccountEnabled absent from cached native evidence"))
		dataType: string
		displayFolder: Device qualification
		lineageTag: 9e540bef-b562-4d8d-be72-179cc05d23c3
		summarizeBy: none

	partition 'Device Identity Inventory' = calculated
		mode: import
		source =
				VAR _ad0=SELECTCOLUMNS(FILTER('All Devices Evidence',LEFT([Device Key],3)="ad:"),
				 "TenantKey",[TenantKey],"Loaded Batch ID",[Loaded Batch ID],"__Canonical",[Device Key],"__ADGuid",MID([Device Key],4,500),"__EstateCountry",[Country],"__EstateCountryName",[Country Name])
				VAR _ad1=ADDCOLUMNS(_ad0,"__RawNativeKey",IF(LOOKUPVALUE('AD Computer Evidence'[CloudMatchStatus],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID])="Unique native SID",LOOKUPVALUE('AD Computer Evidence'[TenantDeviceKey],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID])))
				VAR _ad=ADDCOLUMNS(_ad1,"__NativeKey",VAR _k=[__RawNativeKey] VAR _t=[TenantKey] RETURN IF(NOT ISBLANK(_k) && COUNTROWS(FILTER(_ad1,[TenantKey]=_t && [__RawNativeKey]=_k))=1,_k))
				VAR _cloud=SELECTCOLUMNS(FILTER('Native Device Evidence',
				 VAR _k=[TenantDeviceKey] VAR _t=[TenantKey] RETURN COUNTROWS(FILTER(_ad,[TenantKey]=_t && [__NativeKey]=_k))=0),
				 "TenantKey",[TenantKey],"Loaded Batch ID",[Loaded Batch ID],"__Canonical","entra:" & [SourceDeviceId],"__ADGuid",BLANK(),"__EstateCountry",[CountryCode],"__EstateCountryName",[CountryLabel],"__NativeKey",[TenantDeviceKey])
				VAR _adRows=SELECTCOLUMNS(_ad,"TenantKey",[TenantKey],"Loaded Batch ID",[Loaded Batch ID],"__Canonical",[__Canonical],"__ADGuid",[__ADGuid],"__EstateCountry",[__EstateCountry],"__EstateCountryName",[__EstateCountryName],"__NativeKey",[__NativeKey])
				VAR _estateIntune=FILTER('All Devices Evidence',LEFT([Device Key],7)="intune:")
				VAR _orphan=SELECTCOLUMNS(FILTER(_estateIntune,
				 VAR _id=MID([Device Key],8,500) VAR _t=[TenantKey]
				 VAR _nk=LOOKUPVALUE('Native Managed Device Evidence'[TenantDeviceKey],'Native Managed Device Evidence'[ManagedDeviceId],_id,'Native Managed Device Evidence'[TenantKey],_t)
				 RETURN ISBLANK(_nk) || NOT CONTAINS('Native Device Evidence','Native Device Evidence'[TenantDeviceKey],_nk)),
				 "TenantKey",[TenantKey],"Loaded Batch ID",[Loaded Batch ID],"__Canonical",[Device Key],"__ADGuid",BLANK(),"__EstateCountry",[Country],"__EstateCountryName",[Country Name],"__NativeKey",BLANK())
				VAR _base=UNION(_adRows,_cloud,_orphan)
				VAR _linked=ADDCOLUMNS(_base,
				 "__ManagedId",IF(LEFT([__Canonical],7)="intune:",MID([__Canonical],8,500),IF(NOT ISBLANK([__NativeKey]),LOOKUPVALUE('Native Managed Device Evidence'[ManagedDeviceId],'Native Managed Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Managed Device Evidence'[TenantKey],[TenantKey],'Native Managed Device Evidence'[Loaded Batch ID],[Loaded Batch ID]))),
				 "__ADNativeKey",LOOKUPVALUE('AD Computer Evidence'[TenantADComputerKey],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),
				 "__PrimaryUserId",LOOKUPVALUE('Native Device Evidence'[PrimaryUserSourceId],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]))
				RETURN SELECTCOLUMNS(_linked,
				"Device Source ID",[__ManagedId],
				"Device Name",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Device Name],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[DeviceName],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),LOOKUPVALUE('AD Computer Evidence'[Name],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Identity detail unavailable"),
				"Primary User UPN",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Primary User UPN],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[AssociatedAccount],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID])),
				"Country",COALESCE([__EstateCountry],"Unknown"),
				"Platform",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Platform],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[OperatingSystem],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),IF(CONTAINSSTRING(LOOKUPVALUE('AD Computer Evidence'[OperatingSystem],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Windows"),"Windows"),"Unknown"),
				"Device Category",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Device Category],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),IF(CONTAINSSTRING(LOOKUPVALUE('AD Computer Evidence'[OperatingSystem],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Server"),"Server"),LOOKUPVALUE('Native Device Evidence'[Device form factor],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Unknown"),
				"Ownership",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Ownership],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[Ownership],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Unknown"),
				"Management State",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Management State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[ManagementState],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Unknown"),
				"Compliance State",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Compliance State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[ComplianceState],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Not assessed"),
				"Manufacturer",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Manufacturer],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Model",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Model],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Operating System Family",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Operating System Family],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[OperatingSystem],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),LOOKUPVALUE('AD Computer Evidence'[OperatingSystem],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Unknown"),
				"Operating System Version",COALESCE(IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Operating System Version],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),LOOKUPVALUE('Native Device Evidence'[OperatingSystemVersion],'Native Device Evidence'[TenantDeviceKey],[__NativeKey],'Native Device Evidence'[TenantKey],[TenantKey],'Native Device Evidence'[Loaded Batch ID],[Loaded Batch ID]),LOOKUPVALUE('AD Computer Evidence'[OperatingSystemVersion],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows Release",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows Release],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Disk Space State",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Disk Space State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"AD to Intune Match",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD to Intune Match],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Entra Match",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Entra Match],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Tenure Confidence",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Tenure Confidence],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows Generation",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows Generation],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows 11 Upgrade Eligibility",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows 11 Upgrade Eligibility],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows 11 Blocking Reasons",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows 11 Blocking Reasons],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows Update State",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows Update State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows Update Risk",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows Update Risk],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows Update Action Code",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows Update Action Code],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Secure Boot State",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Secure Boot State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
