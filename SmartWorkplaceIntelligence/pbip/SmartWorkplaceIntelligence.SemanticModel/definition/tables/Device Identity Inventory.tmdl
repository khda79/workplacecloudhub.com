				"Managed Tenure (Years)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Managed Tenure (Years)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Endpoint Analytics Score",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Endpoint Analytics Score],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Stop Error Count",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Stop Error Count],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Last Sync DateTime",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Last Sync DateTime],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Observed Since",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Observed Since],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Inventory Key",[__Canonical],
