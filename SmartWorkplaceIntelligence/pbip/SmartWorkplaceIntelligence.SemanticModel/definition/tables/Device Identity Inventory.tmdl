				"AD Created (source)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD Created (source)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"AD Creation Qualification",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD Creation Qualification],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"AD Modified (source)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD Modified (source)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"AD Modification Qualification",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD Modification Qualification],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"AD Password Expiry Status",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD Password Expiry Status],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Inventory Source",SWITCH(TRUE(),NOT ISBLANK([__ADGuid]) && NOT ISBLANK([__NativeKey]),IF(NOT ISBLANK([__ManagedId]),"AD + Entra + Intune","AD + Entra"),NOT ISBLANK([__ADGuid]),"AD only",NOT ISBLANK([__NativeKey]),IF(NOT ISBLANK([__ManagedId]),"Entra + Intune","Entra only"),"Intune only"),
				"Expected AV Name",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Expected AV Name],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Expected AV State",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Expected AV State],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Third Party AV Products",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Third Party AV Products],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Windows Update Reboot Required",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Windows Update Reboot Required],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"BitLocker OS Protection",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[BitLocker OS Protection],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"BitLocker OS Conversion",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[BitLocker OS Conversion],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Encryption Comparison",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Encryption Comparison],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"System Data Quality Issues",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[System Data Quality Issues],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"System Freshness",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[System Freshness],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"System Observation (source)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[System Observation (source)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Loaded Batch ID",[Loaded Batch ID],
				"TenantKey",[TenantKey],
				"AD Source Collected UTC",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD Source Collected UTC],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Country Name",COALESCE([__EstateCountryName],"Unknown"),
				"AD Windows PC",IF(CONTAINSSTRING(LOOKUPVALUE('AD Computer Evidence'[OperatingSystem],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Windows") && NOT CONTAINSSTRING(LOOKUPVALUE('AD Computer Evidence'[OperatingSystem],'AD Computer Evidence'[ObjectGUID],[__ADGuid],'AD Computer Evidence'[TenantKey],[TenantKey],'AD Computer Evidence'[Loaded Batch ID],[Loaded Batch ID]),"Server"),"Yes","No"),
				"Entra Created (source)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Entra Created (source)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Entra Creation Qualification",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Entra Creation Qualification],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Entra Modified (source)",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Entra Modified (source)],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Entra Modification Qualification",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[Entra Modification Qualification],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"AD Password Expired",IF(NOT ISBLANK([__ManagedId]),LOOKUPVALUE('Device Exploration Inventory'[AD Password Expired],'Device Exploration Inventory'[Device Source ID],[__ManagedId],'Device Exploration Inventory'[TenantKey],[TenantKey],'Device Exploration Inventory'[Loaded Batch ID],[Loaded Batch ID])),
				"Canonical Device Key",[__Canonical],
				"Native Device Key",[__NativeKey],
				"AD Computer Key",[__ADNativeKey],
				"Primary User Source ID",[__PrimaryUserId],
				"Primary User SAM",IF(NOT ISBLANK([__PrimaryUserId]),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[SourceUserId],[__PrimaryUserId],'Native User Evidence'[TenantKey],[TenantKey],'Native User Evidence'[Loaded Batch ID],[Loaded Batch ID])))
