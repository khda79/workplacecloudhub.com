/// One synthetic user per reporting snapshot.
table 'User Snapshots'
	lineageTag: a0c0daf2-1d04-4be9-8411-0482f1a9a844

	/// Distinct qualified synthetic users in scope.
	measure '# Users' = DISTINCTCOUNT('User Snapshots'[User Key])
		formatString: #,0
		displayFolder: Measures
		lineageTag: a2abc5fc-5c4a-46f4-b08f-c5b9492bcb78

	/// Enabled workforce users with qualified activity evidence in the approved window.
	measure '# Active Workforce' = CALCULATE(DISTINCTCOUNT('User Snapshots'[User Key]), KEEPFILTERS('User Snapshots'[Account State] = "Enabled"), KEEPFILTERS('User Snapshots'[Workforce Status] = "Active"), KEEPFILTERS('User Snapshots'[Activity Evidence Status] = "Observed"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 1d8cbb3a-4dca-4f38-8f14-83f99746489c

	/// Enabled workforce accounts with qualified inactivity evidence.
	measure '# Enabled Inactive Accounts' = CALCULATE(DISTINCTCOUNT('User Snapshots'[User Key]), KEEPFILTERS('User Snapshots'[Account State] = "Enabled"), KEEPFILTERS('User Snapshots'[Workforce Status] = "Inactive"), KEEPFILTERS('User Snapshots'[Activity Evidence Status] = "Observed"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: dd12bd1c-7359-4a0c-bb83-2f1e9a67426b

	/// Days from the latest qualified user activity to the selected reporting date.
	measure 'Last Activity Age Days' = VAR _lastActivity = MAX('User Snapshots'[Last Activity UTC]) VAR _reportingDate = MAX('Date'[Date]) RETURN IF(ISBLANK(_lastActivity), BLANK(), DATEDIFF(_lastActivity, _reportingDate, DAY))
		formatString: #,0
		displayFolder: Measures
		lineageTag: b4e3a5d6-ffe7-4b8a-ae0f-780131fbe0ca

