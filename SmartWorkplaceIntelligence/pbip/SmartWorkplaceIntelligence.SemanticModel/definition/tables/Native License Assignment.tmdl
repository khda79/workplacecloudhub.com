			RETURN SWITCH(TRUE(), ISCROSSFILTERED('User Inventory Evidence'), CALCULATE((IF(COUNTROWS(ALLSELECTED('Native User Evidence')) = 1, COUNTROWS('Native License Assignment'))), KEEPFILTERS(TREATAS(InventoryUsers, 'Native License Assignment'[TenantUserKey]))), (IF(COUNTROWS(ALLSELECTED('Native User Evidence')) = 1, COUNTROWS('Native License Assignment'))))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
