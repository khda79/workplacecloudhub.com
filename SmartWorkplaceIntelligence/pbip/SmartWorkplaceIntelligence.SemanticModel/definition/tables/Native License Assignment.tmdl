/// Native source facet migrated from LicenseAssignmentPath; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native License Assignment'
	lineageTag: b6bfd696-a3a3-4650-87b3-a07d16073448

	/// Individual direct/group assignment paths, not distinct user/SKU pairs. Migrated without changing the source calculation.
	measure 'Native Assignment paths' =
			VAR _privateDomainScope = FILTER(ALL('Native User Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native User Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native User Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native User Evidence'[CountryCode]) || TRIM('Native User Evidence'[CountryCode])="", "Unknown", 'Native User Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryUsers = CALCULATETABLE(VALUES('Native User Evidence'[TenantUserKey]), REMOVEFILTERS('Native User Evidence'), TREATAS(VALUES('User Inventory Evidence'[User Source ID]), 'Native User Evidence'[SourceUserId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('User Inventory Evidence'), CALCULATE((COALESCE(COUNTROWS('Native License Assignment'),0)), KEEPFILTERS(TREATAS(InventoryUsers, 'Native License Assignment'[TenantUserKey]))), (COALESCE(COUNTROWS('Native License Assignment'),0)))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: b19b98e2-fde9-4edb-885d-22adc6cb7106

	/// Observed group-based paths, not membership or effective access. Migrated without changing the source calculation.
	measure 'Native Group assignment paths' =
			VAR _privateDomainScope = FILTER(ALL('Native User Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native User Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native User Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native User Evidence'[CountryCode]) || TRIM('Native User Evidence'[CountryCode])="", "Unknown", 'Native User Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryUsers = CALCULATETABLE(VALUES('Native User Evidence'[TenantUserKey]), REMOVEFILTERS('Native User Evidence'), TREATAS(VALUES('User Inventory Evidence'[User Source ID]), 'Native User Evidence'[SourceUserId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('User Inventory Evidence'), CALCULATE((CALCULATE([Native Assignment paths], KEEPFILTERS('Native License Assignment'[AssignmentRoute] == "Group"))), KEEPFILTERS(TREATAS(InventoryUsers, 'Native License Assignment'[TenantUserKey]))), (CALCULATE([Native Assignment paths], KEEPFILTERS('Native License Assignment'[AssignmentRoute] == "Group"))))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
