			RETURN SWITCH(TRUE(), ISCROSSFILTERED('User Inventory Evidence'), CALCULATE((DIVIDE([Native Assignment paths with errors], [Native Assignment paths])), KEEPFILTERS(TREATAS(InventoryUsers, 'Native License Assignment'[TenantUserKey]))), (DIVIDE([Native Assignment paths with errors], [Native Assignment paths])))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: 0.000%
		displayFolder: Native evidence
		lineageTag: cd76d30b-6f47-4b0f-9c30-a6fe76216929

	/// Detail rows only when exactly one user is selected outside visual row grouping. Blank otherwise. Migrated without changing the source calculation.
	measure 'Native User assignment details' =
