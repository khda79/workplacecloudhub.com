	partition 'Native Mailbox Hosting' = m
		mode: import
		source = NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("FactMailboxHosting.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="MailboxHostingKey", dataType="String"], [name="CountryLabel", dataType="String"], [name="HostingLocation", dataType="String"], [name="RecipientTypeDetails", dataType="String"], [name="MailboxTypeGroup", dataType="String"], [name="EvidenceSource", dataType="String"]})

