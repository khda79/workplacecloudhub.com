/// Native source facet migrated from FactMailboxHosting; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native Mailbox Hosting'
	lineageTag: cac9bb82-11de-49a9-ab40-822dfb410155

	/// Distinct mailbox addresses after reconciliation of Exchange Online, RemoteMailbox and local Mailbox evidence. Migrated without changing the source calculation.
	measure 'Native Hosted mailboxes' = (COALESCE(COUNTROWS('Native Mailbox Hosting'), 0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 00d6b9d3-10b8-4455-8bf1-4cac3aeb9747

	/// Mailboxes observed in Exchange Online or as RemoteMailbox; duplicate addresses are counted once. Migrated without changing the source calculation.
	measure 'Native Exchange Online mailboxes' = (CALCULATE([Native Hosted mailboxes], KEEPFILTERS('Native Mailbox Hosting'[HostingLocation] == "Exchange Online")))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 4d039333-fec6-40a9-8450-391c3df7462b

	/// Local Mailbox recipients not already observed as Exchange Online or RemoteMailbox; duplicate addresses are counted once. Migrated without changing the source calculation.
	measure 'Native Exchange On-premises mailboxes' = (CALCULATE([Native Hosted mailboxes], KEEPFILTERS('Native Mailbox Hosting'[HostingLocation] == "Exchange On-premises")))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: c505adec-f2c9-4e2e-8102-4cd2a453709a

	/// Exchange Online mailboxes divided by the reconciled mailbox footprint. Migrated without changing the source calculation.
	measure 'Native Exchange Online share' = (DIVIDE([Native Exchange Online mailboxes], [Native Hosted mailboxes]))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: 3b19e76c-7e29-47ca-a628-55e5ebbdb7d2

	/// Exchange On-premises mailboxes divided by the reconciled mailbox footprint. Migrated without changing the source calculation.
	measure 'Native Exchange On-premises share' = (DIVIDE([Native Exchange On-premises mailboxes], [Native Hosted mailboxes]))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: 3e6814b8-957e-483e-b785-eb19fc400bf5

	/// UserMailbox and RemoteUserMailbox recipients after mailbox-hosting reconciliation. Migrated without changing the source calculation.
	measure 'Native User mailboxes' = (CALCULATE([Native Hosted mailboxes], KEEPFILTERS('Native Mailbox Hosting'[MailboxTypeGroup] == "User mailbox")))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 6268162c-d29e-424d-834f-0125cc7823df

	/// SharedMailbox and RemoteSharedMailbox recipients after mailbox-hosting reconciliation. Migrated without changing the source calculation.
	measure 'Native Shared mailboxes' = (CALCULATE([Native Hosted mailboxes], KEEPFILTERS('Native Mailbox Hosting'[MailboxTypeGroup] == "Shared mailbox")))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 3bb98cf8-2e0f-4de2-a934-eaeb07ef1ee1

	/// Room, scheduling, discovery and other recipient types after mailbox-hosting reconciliation. Migrated without changing the source calculation.
	measure 'Native Other mailbox types' = (CALCULATE([Native Hosted mailboxes], KEEPFILTERS('Native Mailbox Hosting'[MailboxTypeGroup] == "Other mailbox types")))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 2555ee26-4261-41ca-a68b-7aa1a0d2af6c

	/// User mailbox family divided by all reconciled mailboxes. Migrated without changing the source calculation.
	measure 'Native User mailbox share' = (DIVIDE([Native User mailboxes], [Native Hosted mailboxes]))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: 8b9f0720-7aef-41ac-81f6-9cf683000e15

	/// Shared mailbox family divided by all reconciled mailboxes. Migrated without changing the source calculation.
	measure 'Native Shared mailbox share' = (DIVIDE([Native Shared mailboxes], [Native Hosted mailboxes]))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: cf32af72-b776-4586-918f-72e80f157893

	/// Other mailbox types divided by all reconciled mailboxes. Migrated without changing the source calculation.
	measure 'Native Other mailbox type share' = (DIVIDE([Native Other mailbox types], [Native Hosted mailboxes]))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: 579eea35-52ad-4295-a14a-9d6cbb239180

	/// Share of the current mailbox-type category within the filtered reconciled mailbox population. Migrated without changing the source calculation.
	measure 'Native Mailbox type share' = (DIVIDE([Native Hosted mailboxes], CALCULATE([Native Hosted mailboxes], REMOVEFILTERS('Native Mailbox Hosting'[MailboxTypeGroup]))))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: 93635aca-d39f-45e1-b0e2-06976ccfd012

	/// Share of each mailbox-hosting location within the filtered reconciled mailbox population. Migrated without changing the source calculation.
	measure 'Native Mailbox hosting rate' = (DIVIDE([Native Hosted mailboxes], CALCULATE([Native Hosted mailboxes], REMOVEFILTERS('Native Mailbox Hosting'[HostingLocation]))))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: e3e667f0-836a-4a3e-b3c7-5b6b0081a6de

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Native Mailbox Hosting' = (COUNTROWS('Native Mailbox Hosting'))
		formatString: #,0
		isHidden
		lineageTag: 03a3bbbd-d0d3-420f-b8e8-42288a2114b6

