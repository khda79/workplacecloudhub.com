/// Receipt-qualified observed Teams / SharePoint scope. Single reviewed tenant batch; no inference of full tenant coverage.
table 'Teams Site Links'
	lineageTag: e9ac5c50-310e-4141-b64c-467d1dd78b6c

	/// Preserved observed links absent from captured SPO scope; not invalid links.
	measure 'Teams Links Outside SPO Scope' = CALCULATE(COUNTROWS('Teams Site Links'), KEEPFILTERS('Teams Site Links'[Resolution] = "Outside observed SPO scope"))
		formatString: #,0
		displayFolder: Teams & SharePoint | Observed scope
