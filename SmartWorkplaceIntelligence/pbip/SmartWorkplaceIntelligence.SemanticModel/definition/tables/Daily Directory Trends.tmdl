		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: c9455c80-bb4f-4f71-a350-eebe58805b98

	measure 'Windows 11 Share Daily' = DIVIDE([Windows 11 Enabled Daily], [Enabled AD Computer Accounts Daily])
		formatString: 0.0%
		displayFolder: Daily Trends
		lineageTag: 617de2f2-e6db-441d-b538-c3d131250385

	measure 'Windows 10 Share Daily' = DIVIDE([Windows 10 Enabled Daily], [Enabled AD Computer Accounts Daily])
		formatString: 0.0%
		displayFolder: Daily Trends
		lineageTag: b1856602-5f6d-46d1-9e2c-3de379bb0ff0

	measure 'Windows 10 Chart Daily' = IF(SELECTEDVALUE('Daily View'[View], "Count") = "Share", [Windows 10 Share Daily], [Windows 10 Enabled Daily])
		displayFolder: Daily Trends
		lineageTag: 3df3869a-5dfc-4a47-9960-ce338d12f952

		formatStringDefinition = IF(SELECTEDVALUE('Daily View'[View], "Count") = "Share", "0.0%", "#,0")

	measure 'Windows 11 Chart Daily' = IF(SELECTEDVALUE('Daily View'[View], "Count") = "Share", [Windows 11 Share Daily], [Windows 11 Enabled Daily])
		displayFolder: Daily Trends
		lineageTag: 11332aec-8800-45d5-8e53-c2c552bc5846

		formatStringDefinition = IF(SELECTEDVALUE('Daily View'[View], "Count") = "Share", "0.0%", "#,0")

	measure 'Enabled Users Card' = VAR _first = MINX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Enabled Users Daily])), 'Date'[Date]) VAR _last = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Enabled Users Daily])), 'Date'[Date]) VAR _a = CALCULATE([Enabled Users Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([Enabled Users Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b), "Not measured", FORMAT(_b, "#,0") & "  |  " & FORMAT(_b-_a, "+#,0;-#,0;0"))
		formatString: @
		displayFolder: Daily Trends
		lineageTag: a1cd078e-0f29-4e13-911e-b3e574b6d145

	measure 'Disabled Users Card' = VAR _first = MINX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Disabled Users Daily])), 'Date'[Date]) VAR _last = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Disabled Users Daily])), 'Date'[Date]) VAR _a = CALCULATE([Disabled Users Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([Disabled Users Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b), "Not measured", FORMAT(_b, "#,0") & "  |  " & FORMAT(_b-_a, "+#,0;-#,0;0"))
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 4dbe7a87-32eb-4481-ab31-0a56cc03a468

	measure 'Windows 11 Share Card' = VAR _first = MINX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Windows 11 Share Daily])), 'Date'[Date]) VAR _last = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Windows 11 Share Daily])), 'Date'[Date]) VAR _a = CALCULATE([Windows 11 Share Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([Windows 11 Share Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b), "Not measured", FORMAT(_b, "0.0%") & "  |  " & FORMAT((_b-_a)*100, "+0.0;-0.0;0.0") & " pp")
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 84206765-bfe3-48c3-9787-c1c26cd704bf

	measure 'Windows 10 Remaining Card' = VAR _first = MINX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Windows 10 Enabled Daily])), 'Date'[Date]) VAR _last = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Windows 10 Enabled Daily])), 'Date'[Date]) VAR _a = CALCULATE([Windows 10 Enabled Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([Windows 10 Enabled Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b), "Not measured", FORMAT(_b, "#,0") & "  |  " & FORMAT(_b-_a, "+#,0;-#,0;0"))
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 50441f20-7b85-443d-a959-65eb402bcacb

	measure 'Last Qualified AD Users Day' = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total AD Users Daily]) && NOT ISBLANK([Enabled Users Daily]) && NOT ISBLANK([Disabled Users Daily])), 'Date'[Date])
		formatString: yyyy-MM-dd
		displayFolder: Daily Trends
		lineageTag: 184b4331-3354-486f-bcea-676c098d83d8

	measure 'Last Fully Measured AD Users Day' = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total AD Users Daily]) && NOT ISBLANK([Enabled Users Daily]) && NOT ISBLANK([Disabled Users Daily]) && NOT ISBLANK([Inactive 90 Days Users Daily])), 'Date'[Date])
		formatString: yyyy-MM-dd
		displayFolder: Daily Trends
		lineageTag: 3ead0014-62c1-412c-a4f5-b21c9f74a263

	measure 'Last Qualified AD Computers Day' = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total AD Computers Daily]) && NOT ISBLANK([Enabled AD Computer Accounts Daily]) && NOT ISBLANK([Disabled AD Computer Accounts Daily]) && NOT ISBLANK([Windows 7 Enabled Daily]) && NOT ISBLANK([Windows 7 Disabled Daily]) && NOT ISBLANK([Windows 8 Enabled Daily]) && NOT ISBLANK([Windows 8 Disabled Daily]) && NOT ISBLANK([Windows 10 Enabled Daily]) && NOT ISBLANK([Windows 10 Disabled Daily]) && NOT ISBLANK([Windows 11 Enabled Daily]) && NOT ISBLANK([Windows 11 Disabled Daily])), 'Date'[Date])
		formatString: yyyy-MM-dd
		displayFolder: Daily Trends
		lineageTag: f5f0b6ab-ed84-4eb1-beae-0f4fcb5b89c2

	measure 'Last Fully Measured AD Computers Day' = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total AD Computers Daily]) && NOT ISBLANK([Enabled AD Computer Accounts Daily]) && NOT ISBLANK([Disabled AD Computer Accounts Daily]) && NOT ISBLANK([Windows 7 Enabled Daily]) && NOT ISBLANK([Windows 7 Disabled Daily]) && NOT ISBLANK([Windows 8 Enabled Daily]) && NOT ISBLANK([Windows 8 Disabled Daily]) && NOT ISBLANK([Windows 10 Enabled Daily]) && NOT ISBLANK([Windows 10 Disabled Daily]) && NOT ISBLANK([Windows 11 Enabled Daily]) && NOT ISBLANK([Windows 11 Disabled Daily])), 'Date'[Date])
		formatString: yyyy-MM-dd
		displayFolder: Daily Trends
		lineageTag: 0ed3371f-f194-4f2e-a7bc-03bdc0c50bfb

	measure 'AD Users Partial Days' = CALCULATE(DISTINCTCOUNT('Daily Directory Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Source Name] = "AD Users", 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Source Day Status] = "Partial capture")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: d55cb0cc-248b-4a8f-b1c7-ee6d52af108d

	measure 'AD Users Incomplete Days' = CALCULATE(DISTINCTCOUNT('Daily Directory Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Source Name] = "AD Users", 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Metric Status] = "Not measured")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: b9096532-48a1-4c1d-8a59-fc264e25f3ec

	measure 'AD Computers Partial Days' = CALCULATE(DISTINCTCOUNT('Daily Directory Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Source Name] = "AD Computers", 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Source Day Status] = "Partial capture")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 3a6b4e79-c9c5-408b-a7eb-365c2d8a074a

	measure 'AD Computers Incomplete Days' = CALCULATE(DISTINCTCOUNT('Daily Directory Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Source Name] = "AD Computers", 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Metric Status] = "Not measured")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 9cae0542-22ac-4bcd-a90a-d53bf3ada825

	measure 'Directory Quality Text' = "AD Users: core " & FORMAT([Last Qualified AD Users Day], "dd MMM yyyy") & ", full " & FORMAT([Last Fully Measured AD Users Day], "dd MMM yyyy") & UNICHAR(10) & "AD Computers: core " & FORMAT([Last Qualified AD Computers Day], "dd MMM yyyy") & ", full " & FORMAT([Last Fully Measured AD Computers Day], "dd MMM yyyy")
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 1c5aaab8-52e4-4069-be6a-6f586a0e6952

	measure 'Windows 11 Overtakes Windows 10 Day' = MINX(FILTER(ALL('Date'[Date]), VAR _w11 = CALCULATE([Windows 11 Enabled Daily], REMOVEFILTERS('Daily Period')) VAR _w10 = CALCULATE([Windows 10 Enabled Daily], REMOVEFILTERS('Daily Period')) RETURN NOT ISBLANK(_w11) && NOT ISBLANK(_w10) && _w11 > _w10), 'Date'[Date])
		formatString: yyyy-MM-dd
		displayFolder: Daily Trends
		lineageTag: 1ffe20ff-568c-422f-8ef1-79c94eef8792

	measure 'Persistent Domain Events' = CALCULATE(DISTINCTCOUNT('Daily Directory Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Quality Event] = "Domain absent (persistent)")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 3f994c6e-abbe-4c64-b18c-cb8f16b89740

	measure 'Daily Domain Trust Text' = "Persistent domain absence events: Directory " & FORMAT([Persistent Domain Events], "0") & "  |  Mailbox " & FORMAT([Persistent Mailbox Domain Events], "0") & ". Retired domains leave the capture baseline after the configured consecutive-observation threshold."
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 3c4ad3c8-1e63-455b-8a75-4a17a2ba479b

	measure 'Persistent Domain Absence Events' = [Persistent Domain Events] + [Persistent Mailbox Domain Events]
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 836a627e-c15d-4b59-b3ac-89a8ebd87588

	measure 'Windows 7 Disabled Daily' = VAR _days = SELECTEDVALUE('Daily Period'[Days], 0) VAR _latest = MIN(CALCULATE(MAX('Daily Directory Trends'[Date]), REMOVEFILTERS('Date')), MAXX(ALLSELECTED('Date'[Date]), 'Date'[Date])) VAR _date = MAX('Date'[Date]) VAR _domainSelected = ISFILTERED('Daily Domain'[Domain]) VAR _rows = CALCULATETABLE('Daily Directory Trends', KEEPFILTERS('Daily Directory Trends'[Source Name] = "AD Computers"), KEEPFILTERS('Daily Directory Trends'[Metric Name] = "Windows 7 Disabled"), KEEPFILTERS('Daily Directory Trends'[Source Day Status] = "Complete"), FILTER(ALL('Daily Directory Trends'[Domain Key]), IF(_domainSelected, 'Daily Directory Trends'[Domain Key] <> "__all__", 'Daily Directory Trends'[Domain Key] = "__all__"))) RETURN IF(_days > 0 && _date < _latest - _days + 1, BLANK(), IF(COUNTROWS(FILTER(_rows, 'Daily Directory Trends'[Metric Status] = "Not measured")) > 0, BLANK(), SUMX(_rows, 'Daily Directory Trends'[Metric Value])))
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 88e26208-a4ce-4f56-bea4-b8a3194ef8e9

	measure 'Windows 8 Disabled Daily' = VAR _days = SELECTEDVALUE('Daily Period'[Days], 0) VAR _latest = MIN(CALCULATE(MAX('Daily Directory Trends'[Date]), REMOVEFILTERS('Date')), MAXX(ALLSELECTED('Date'[Date]), 'Date'[Date])) VAR _date = MAX('Date'[Date]) VAR _domainSelected = ISFILTERED('Daily Domain'[Domain]) VAR _rows = CALCULATETABLE('Daily Directory Trends', KEEPFILTERS('Daily Directory Trends'[Source Name] = "AD Computers"), KEEPFILTERS('Daily Directory Trends'[Metric Name] = "Windows 8 Disabled"), KEEPFILTERS('Daily Directory Trends'[Source Day Status] = "Complete"), FILTER(ALL('Daily Directory Trends'[Domain Key]), IF(_domainSelected, 'Daily Directory Trends'[Domain Key] <> "__all__", 'Daily Directory Trends'[Domain Key] = "__all__"))) RETURN IF(_days > 0 && _date < _latest - _days + 1, BLANK(), IF(COUNTROWS(FILTER(_rows, 'Daily Directory Trends'[Metric Status] = "Not measured")) > 0, BLANK(), SUMX(_rows, 'Daily Directory Trends'[Metric Value])))
		formatString: #,0
