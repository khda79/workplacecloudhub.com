	/// Qualified immutable-batch daily evidence. Enabled and disabled states are included; missing observations are not zero.
	measure 'Windows 11 Overtakes Windows 10 All AD Accounts Day' = MINX(FILTER(ALL('Date'[Date]), VAR _w11 = CALCULATE([Windows 11 All AD Accounts Daily], REMOVEFILTERS('Daily Period')) VAR _w10 = CALCULATE([Windows 10 All AD Accounts Daily], REMOVEFILTERS('Daily Period')) RETURN NOT ISBLANK(_w11) && NOT ISBLANK(_w10) && _w11 > _w10), 'Date'[Date])
