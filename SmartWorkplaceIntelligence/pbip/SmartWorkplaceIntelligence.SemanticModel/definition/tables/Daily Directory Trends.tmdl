	measure 'Last Qualified All AD Computer Accounts Day' = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total AD Computers Daily]) && NOT ISBLANK([Enabled AD Computer Accounts Daily]) && NOT ISBLANK([Disabled AD Computer Accounts Daily])), 'Date'[Date])
