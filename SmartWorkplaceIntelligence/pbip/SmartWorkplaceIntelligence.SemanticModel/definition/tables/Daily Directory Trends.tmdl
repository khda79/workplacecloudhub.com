/// Governed daily source and domain evidence; blank metrics are not measured, not zero.
table 'Daily Directory Trends'
	lineageTag: bb3dc628-a146-4a2e-ad99-3b1b933f5ee6

	measure 'AD User Accounts Scope Tooltip' = "All AD user account types, including service, shared and technical accounts. Executive Overview reports the qualified workforce population. These populations are not directly comparable."
		lineageTag: 0c209587-e75e-4073-b725-fe482809b96b

	measure 'AD Computer Accounts Scope Tooltip' = "Enabled computer accounts in Active Directory, including computers outside Intune management. Executive Overview reports managed Intune devices. These populations are not directly comparable."
		lineageTag: 31b9de54-a813-4a9f-ae6d-8240f573addc

	measure 'Total AD Users Daily' = VAR _days = SELECTEDVALUE('Daily Period'[Days], 0) VAR _latest = MIN(CALCULATE(MAX('Daily Directory Trends'[Date]), REMOVEFILTERS('Date')), MAXX(ALLSELECTED('Date'[Date]), 'Date'[Date])) VAR _date = MAX('Date'[Date]) VAR _domainSelected = ISFILTERED('Daily Domain'[Domain]) VAR _rows = CALCULATETABLE('Daily Directory Trends', KEEPFILTERS('Daily Directory Trends'[Source Name] = "AD Users"), KEEPFILTERS('Daily Directory Trends'[Metric Name] = "TotalUsers"), KEEPFILTERS('Daily Directory Trends'[Source Day Status] = "Complete"), FILTER(ALL('Daily Directory Trends'[Domain Key]), IF(_domainSelected, 'Daily Directory Trends'[Domain Key] <> "__all__", 'Daily Directory Trends'[Domain Key] = "__all__"))) RETURN IF(_days > 0 && _date < _latest - _days + 1, BLANK(), IF(COUNTROWS(FILTER(_rows, 'Daily Directory Trends'[Metric Status] = "Not measured")) > 0, BLANK(), SUMX(_rows, 'Daily Directory Trends'[Metric Value])))
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 4068d25b-60be-4b76-82f0-bd96e3484f2c

	measure 'Enabled Users Daily' = VAR _days = SELECTEDVALUE('Daily Period'[Days], 0) VAR _latest = MIN(CALCULATE(MAX('Daily Directory Trends'[Date]), REMOVEFILTERS('Date')), MAXX(ALLSELECTED('Date'[Date]), 'Date'[Date])) VAR _date = MAX('Date'[Date]) VAR _domainSelected = ISFILTERED('Daily Domain'[Domain]) VAR _rows = CALCULATETABLE('Daily Directory Trends', KEEPFILTERS('Daily Directory Trends'[Source Name] = "AD Users"), KEEPFILTERS('Daily Directory Trends'[Metric Name] = "EnabledUsers"), KEEPFILTERS('Daily Directory Trends'[Source Day Status] = "Complete"), FILTER(ALL('Daily Directory Trends'[Domain Key]), IF(_domainSelected, 'Daily Directory Trends'[Domain Key] <> "__all__", 'Daily Directory Trends'[Domain Key] = "__all__"))) RETURN IF(_days > 0 && _date < _latest - _days + 1, BLANK(), IF(COUNTROWS(FILTER(_rows, 'Daily Directory Trends'[Metric Status] = "Not measured")) > 0, BLANK(), SUMX(_rows, 'Daily Directory Trends'[Metric Value])))
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 8c175c69-2c37-4590-b98a-81b7315c566f

	measure 'Disabled Users Daily' = VAR _days = SELECTEDVALUE('Daily Period'[Days], 0) VAR _latest = MIN(CALCULATE(MAX('Daily Directory Trends'[Date]), REMOVEFILTERS('Date')), MAXX(ALLSELECTED('Date'[Date]), 'Date'[Date])) VAR _date = MAX('Date'[Date]) VAR _domainSelected = ISFILTERED('Daily Domain'[Domain]) VAR _rows = CALCULATETABLE('Daily Directory Trends', KEEPFILTERS('Daily Directory Trends'[Source Name] = "AD Users"), KEEPFILTERS('Daily Directory Trends'[Metric Name] = "DisabledUsers"), KEEPFILTERS('Daily Directory Trends'[Source Day Status] = "Complete"), FILTER(ALL('Daily Directory Trends'[Domain Key]), IF(_domainSelected, 'Daily Directory Trends'[Domain Key] <> "__all__", 'Daily Directory Trends'[Domain Key] = "__all__"))) RETURN IF(_days > 0 && _date < _latest - _days + 1, BLANK(), IF(COUNTROWS(FILTER(_rows, 'Daily Directory Trends'[Metric Status] = "Not measured")) > 0, BLANK(), SUMX(_rows, 'Daily Directory Trends'[Metric Value])))
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 8cab43d3-8f25-4e4e-b183-d2f72b3d2931

