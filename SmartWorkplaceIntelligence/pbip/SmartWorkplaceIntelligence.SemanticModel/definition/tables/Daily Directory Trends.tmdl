	/// Qualified immutable-batch daily evidence. Enabled and disabled states are included; missing observations are not zero.
	measure 'Windows 11 All AD Accounts Share Card' = VAR _dates = FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total AD Computers Daily]) && NOT ISBLANK([Windows 10 All AD Accounts Daily]) && NOT ISBLANK([Windows 11 All AD Accounts Daily])) VAR _first = MINX(_dates, 'Date'[Date]) VAR _last = MAXX(_dates, 'Date'[Date]) VAR _a = CALCULATE([Windows 11 All AD Accounts Share Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([Windows 11 All AD Accounts Share Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b), "Not measured", FORMAT(_b, "0.0%") & " | " & FORMAT((_b-_a)*100, "+0.0;-0.0;0.0") & " pp")
