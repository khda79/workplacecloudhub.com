	measure 'Windows 11 All AD Accounts Share and Count Change Card' = VAR _dates = FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total AD Computers Daily]) && NOT ISBLANK([Windows 10 All AD Accounts Daily]) && NOT ISBLANK([Windows 11 All AD Accounts Daily])) VAR _first = MINX(_dates, 'Date'[Date]) VAR _last = MAXX(_dates, 'Date'[Date]) VAR _a = CALCULATE([Windows 11 All AD Accounts Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([Windows 11 All AD Accounts Daily], 'Date'[Date] = _last) VAR _share = CALCULATE([Windows 11 All AD Accounts Share Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b) || ISBLANK(_share), "Not measured", FORMAT(_share, "0.0%") & " | " & FORMAT(_b-_a, "+#,0;-#,0;0") & " accounts")
