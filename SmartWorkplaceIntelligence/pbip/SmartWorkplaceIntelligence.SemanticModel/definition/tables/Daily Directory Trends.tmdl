	measure 'All AD Computer Accounts Quality Text' = VAR _day = [Last Qualified All AD Computer Accounts Day] RETURN "All OS; enabled + disabled. Last complete reading: " & IF(ISBLANK(_day), "Not measured", FORMAT(_day, "dd MMM yyyy")) & ". Missing or partial observations remain gaps."
