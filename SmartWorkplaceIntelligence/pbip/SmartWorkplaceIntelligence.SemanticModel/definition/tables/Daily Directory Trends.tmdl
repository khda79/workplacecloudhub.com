	measure 'AD Users Quality Days Tooltip' = VAR _partial = CALCULATETABLE(VALUES('Daily Directory Trends'[Date]), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Source Name] = "AD Users", 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Source Day Status] = "Partial capture") VAR _incomplete = CALCULATETABLE(VALUES('Daily Directory Trends'[Date]), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Source Name] = "AD Users", 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Metric Status] = "Not measured") VAR _retired = CALCULATETABLE(VALUES('Daily Directory Trends'[Date]), REMOVEFILTERS('Daily Domain'), 'Daily Directory Trends'[Source Name] = "AD Users", 'Daily Directory Trends'[Domain Key] = "__all__", 'Daily Directory Trends'[Quality Event] = "Domain absent (persistent)") RETURN "Partial capture days: " & IF(COUNTROWS(_partial)=0, "None", CONCATENATEX(_partial, FORMAT('Daily Directory Trends'[Date], "yyyy-MM-dd"), ", ", 'Daily Directory Trends'[Date], ASC)) & UNICHAR(10) & "Incomplete days: " & IF(COUNTROWS(_incomplete)=0, "None", CONCATENATEX(_incomplete, FORMAT('Daily Directory Trends'[Date], "yyyy-MM-dd"), ", ", 'Daily Directory Trends'[Date], ASC)) & UNICHAR(10) & "Persistent domain event days: " & IF(COUNTROWS(_retired)=0, "None", CONCATENATEX(_retired, FORMAT('Daily Directory Trends'[Date], "yyyy-MM-dd"), ", ", 'Daily Directory Trends'[Date], ASC))
