	/// Latest qualified Windows 11 share with absolute change in enabled Windows 11 AD computer accounts over the selected qualified period. It is not a count of completed migrations.
	measure 'Windows 11 Share and Count Change Card' =
			VAR _dates = FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Windows 11 Share Daily]) && NOT ISBLANK([Windows 11 Enabled Daily]))
			VAR _first = MINX(_dates, 'Date'[Date])
			VAR _last = MAXX(_dates, 'Date'[Date])
			VAR _a = CALCULATE([Windows 11 Enabled Daily], 'Date'[Date] = _first)
			VAR _b = CALCULATE([Windows 11 Enabled Daily], 'Date'[Date] = _last)
			VAR _share = CALCULATE([Windows 11 Share Daily], 'Date'[Date] = _last)
			RETURN IF(ISBLANK(_b) || ISBLANK(_share), "Not measured", FORMAT(_share, "0.0%") & " | " & FORMAT(_b - _a, "+#,0;-#,0;0") & " accounts")
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 00c68cd6-4455-4584-bc02-d15958200e1b

