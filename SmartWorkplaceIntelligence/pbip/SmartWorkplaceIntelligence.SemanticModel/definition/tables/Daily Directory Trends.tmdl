	measure 'Windows 10 Disabled Daily' = VAR _days = SELECTEDVALUE('Daily Period'[Days], 0) VAR _latest = MIN(CALCULATE(MAX('Daily Directory Trends'[Date]), REMOVEFILTERS('Date')), MAXX(ALLSELECTED('Date'[Date]), 'Date'[Date])) VAR _date = MAX('Date'[Date]) VAR _domainSelected = ISFILTERED('Daily Domain'[Domain]) VAR _rows = CALCULATETABLE('Daily Directory Trends', KEEPFILTERS('Daily Directory Trends'[Source Name] = "AD Computers"), KEEPFILTERS('Daily Directory Trends'[Metric Name] = "Windows 10 Disabled"), KEEPFILTERS('Daily Directory Trends'[Source Day Status] = "Complete"), FILTER(ALL('Daily Directory Trends'[Domain Key]), IF(_domainSelected, 'Daily Directory Trends'[Domain Key] <> "__all__", 'Daily Directory Trends'[Domain Key] = "__all__"))) RETURN IF(_days > 0 && _date < _latest - _days + 1, BLANK(), IF(COUNTROWS(FILTER(_rows, 'Daily Directory Trends'[Metric Status] = "Not measured")) > 0, BLANK(), SUMX(_rows, 'Daily Directory Trends'[Metric Value])))
