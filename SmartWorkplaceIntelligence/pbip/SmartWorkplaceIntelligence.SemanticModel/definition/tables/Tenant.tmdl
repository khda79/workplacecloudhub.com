	partition 'Tenant Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Tenant Key" = Int64.Type, #"Tenant Name" = nullable text, #"Tenant Status" = nullable text], {
				        {1, "Synthetic Tenant", "Active"}
				    })
				in
