/// Native source facet migrated from DimDetectedApplication; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native Discovered Application'
	lineageTag: 32414e8d-f72e-4152-891f-6e1722217a8b

	/// Distinct detected-application rows in the Intune export; versions can create separate rows. Migrated without changing the source calculation.
	measure 'Native Detected applications' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimDetectedApplication"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((COALESCE(COUNTROWS('Native Discovered Application'),0)), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Discovered Application'[TenantApplicationKey]))), BLANK()), BLANK()), (COALESCE(COUNTROWS('Native Discovered Application'),0)))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: def829a7-f6a8-4344-a494-0998215f2a83

	/// Source-reported application-device occurrences. Exact device-level reporting uses FactDeviceApplication instead. Migrated without changing the source calculation.
	measure 'Native Reported application-device occurrences' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimDetectedApplication"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((SUM('Native Discovered Application'[ReportedDeviceCount])), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Discovered Application'[TenantApplicationKey]))), BLANK()), BLANK()), (SUM('Native Discovered Application'[ReportedDeviceCount])))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: bc79bf15-9e28-49bf-a422-6a68dadb8415

	/// Distinct normalized application name, publisher and platform products; versions are not products. Migrated without changing the source calculation.
	measure 'Native Application products' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimDetectedApplication"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((DISTINCTCOUNT ( 'Native Discovered Application'[Application product key] )), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Discovered Application'[TenantApplicationKey]))), BLANK()), BLANK()), (DISTINCTCOUNT ( 'Native Discovered Application'[Application product key] )))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 9831b24e-0e80-47a6-a6bb-497c20036f7c

	/// Source-reported application product-version rows. Migrated without changing the source calculation.
	measure 'Native Application version rows' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimDetectedApplication"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((COUNTROWS('Native Discovered Application')), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Discovered Application'[TenantApplicationKey]))), BLANK()), BLANK()), (COUNTROWS('Native Discovered Application')))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 3b60aadc-34e6-4294-8dd8-174cda288dbd

	/// Share of source-reported application-device occurrences for each product; occurrences are not distinct devices. Migrated without changing the source calculation.
	measure 'Native Application occurrence rate' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimDetectedApplication"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((DIVIDE ( [Native Reported application-device occurrences], CALCULATE ( [Native Reported application-device occurrences], REMOVEFILTERS ( 'Native Discovered Application' ) ) )), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Discovered Application'[TenantApplicationKey]))), BLANK()), BLANK()), (DIVIDE ( [Native Reported application-device occurrences], CALCULATE ( [Native Reported application-device occurrences], REMOVEFILTERS ( 'Native Discovered Application' ) ) )))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: a74d7cd2-94ff-445a-a292-4587a01f17d6

	/// Deterministic Top 5 normalized products by distinct native reporting devices in the selected fleet; product-key tie breaker. Migrated without changing the source calculation.
	measure 'Native Application Top 5' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimDetectedApplication"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((VAR _current = SELECTEDVALUE ( 'Native Discovered Application'[Application product key] )
			VAR _scored = CALCULATETABLE (
			    SUMMARIZECOLUMNS ( 'Native Discovered Application'[Application product key], "DeviceCount", [Native Devices reporting applications] ),
			    ALLSELECTED ( 'Native Discovered Application' )
			)
			VAR _top = TOPN ( 5, FILTER ( _scored, [DeviceCount] > 0 ), [DeviceCount], DESC, 'Native Discovered Application'[Application product key], ASC )
			RETURN IF ( NOT ISBLANK ( _current ), INT ( CONTAINS ( _top, 'Native Discovered Application'[Application product key], _current ) ) )), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Discovered Application'[TenantApplicationKey]))), BLANK()), BLANK()), (VAR _current = SELECTEDVALUE ( 'Native Discovered Application'[Application product key] )
			VAR _scored = CALCULATETABLE (
			    SUMMARIZECOLUMNS ( 'Native Discovered Application'[Application product key], "DeviceCount", [Native Devices reporting applications] ),
			    ALLSELECTED ( 'Native Discovered Application' )
			)
			VAR _top = TOPN ( 5, FILTER ( _scored, [DeviceCount] > 0 ), [DeviceCount], DESC, 'Native Discovered Application'[Application product key], ASC )
			RETURN IF ( NOT ISBLANK ( _current ), INT ( CONTAINS ( _top, 'Native Discovered Application'[Application product key], _current ) ) )))
		formatString: 0
		displayFolder: Native evidence
		lineageTag: 9811cda0-f317-4fca-830c-e11f4ebd8e8b

	/// Exact native-key entity context or existing inventory context. No name matching or inferred transitive membership. Unrelated entity selections return blank.
	measure 'Native Context Rows · Native Discovered Application' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimDetectedApplication"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((COUNTROWS('Native Discovered Application')), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Discovered Application'[TenantApplicationKey]))), BLANK()), BLANK()), (COUNTROWS('Native Discovered Application')))
		formatString: #,0
		isHidden
		lineageTag: e0301fbf-c00d-48fd-baf8-781704e221de

