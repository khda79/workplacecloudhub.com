	/// Readable product label grouped by the authoritative normalized product key; similar labels never merge different products.
	column 'Application product' = LOWER ( TRIM ( COALESCE ( 'Native Discovered Application'[DisplayName], "Unknown application" ) ) ) & " · " & LOWER ( TRIM ( COALESCE ( 'Native Discovered Application'[Publisher], "Unknown publisher" ) ) ) & " · " & LOWER ( TRIM ( COALESCE ( 'Native Discovered Application'[Platform], "Unknown platform" ) ) )
		dataType: string
		lineageTag: 1f135a10-b4b2-4a04-ab08-88f879bcb3bc
		summarizeBy: none

	partition 'Native Discovered Application' = m
		mode: import
		source = NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("DimDetectedApplication.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantApplicationKey", dataType="String"], [name="AppId", dataType="String"], [name="SourceApplicationKey", dataType="String"], [name="DisplayName", dataType="String"], [name="Version", dataType="String"], [name="Publisher", dataType="String"], [name="DeviceCount", dataType="Int64"], [name="ReportedDeviceCount", dataType="Int64"], [name="ExactRelatedDeviceCount", dataType="Int64"], [name="ResolvedDeviceCount", dataType="Int64"], [name="UnresolvedDeviceCount", dataType="Int64"], [name="RelationshipCoverageStatus", dataType="String"], [name="Platform", dataType="String"], [name="SourceCollectedDateTime", dataType="DateTime"], [name="Application product key", dataType="String"]})

