	partition 'AD Membership Evidence' = m
		mode: import
		source = NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("ADMembership.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantADMembershipKey", dataType="String"], [name="TenantADGroupKey", dataType="String"], [name="TenantGroupKey", dataType="String"], [name="TenantADObjectKey", dataType="String"], [name="TenantUserKey", dataType="String"], [name="TenantDeviceKey", dataType="String"], [name="GroupObjectGUID", dataType="String"], [name="GroupSID", dataType="String"], [name="MemberDistinguishedName", dataType="String"], [name="MemberObjectGUID", dataType="String"], [name="MemberSID", dataType="String"], [name="MemberObjectClass", dataType="String"], [name="MembershipKind", dataType="String"], [name="ResolutionStatus", dataType="String"], [name="CloudMatchStatus", dataType="String"], [name="SourceCollectedDateTime", dataType="DateTime"]})

