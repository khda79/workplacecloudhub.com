/// Synthetic endpoint experience measurements.
table 'Endpoint Experience Measurements'
	lineageTag: ffb67e36-61ed-499f-afa7-1b79ff5a9e56

	/// Eligible managed devices with a qualified endpoint measurement.
	measure 'Endpoint Analytics Coverage (%)' = DIVIDE(DISTINCTCOUNT('Endpoint Experience Measurements'[Device Key]), [# Devices])
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 84ca62a0-09e0-472b-89a6-8de00cc0be8f

	/// Average observed Endpoint Analytics score for the governed metric only; blank when that metric is not collected.
	measure 'Endpoint Analytics Score' = CALCULATE(AVERAGE('Endpoint Experience Measurements'[Metric Value]), KEEPFILTERS('Endpoint Experience Measurements'[Metric Name] = "EndpointAnalyticsScore"), KEEPFILTERS('Endpoint Experience Measurements'[Evidence Status] = "Observed"))
		formatString: 0.0
		displayFolder: Measures
		lineageTag: d1488adc-e8f0-455f-9922-2025d4ccff33

	/// Accepted measurements with valid timestamps.
	measure 'Endpoint Timestamp Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Endpoint Experience Measurements'), KEEPFILTERS(NOT ISBLANK('Endpoint Experience Measurements'[Measurement Date UTC]))), COUNTROWS('Endpoint Experience Measurements'))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: d48c41ba-2820-4c0f-8506-978d4b7c7090

	/// Business attribute Date Key.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: a5b1cb97-dd51-4ad0-a42b-1e6292ce2ac6
