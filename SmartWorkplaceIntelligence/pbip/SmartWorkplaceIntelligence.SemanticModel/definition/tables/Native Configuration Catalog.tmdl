	lineageTag: d76a3ae1-2d9e-4753-911a-5bcc74f0f8e5

	/// Configuration policies observed in the frozen Intune collection. Migrated without changing the source calculation.
	measure 'Native Intune configuration policies' = (COALESCE(COUNTROWS('Native Configuration Catalog'),0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 9f7c2e4a-da32-4e36-825a-f608a3c53589

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Native Configuration Catalog' = (COUNTROWS('Native Configuration Catalog'))
