	column 'M365 Licenses' =
			VAR _tenant='Native EXO Mailbox'[TenantKey]
			VAR _batch='Native EXO Mailbox'[Loaded Batch ID]
			VAR _smtp='Native EXO Mailbox'[PrimarySmtpAddress]
			VAR _rows=FILTER(ALL('Mailbox Exploration Inventory'),'Mailbox Exploration Inventory'[TenantKey]==_tenant && 'Mailbox Exploration Inventory'[Loaded Batch ID]==_batch && 'Mailbox Exploration Inventory'[Primary SMTP Address]==_smtp && 'Mailbox Exploration Inventory'[Hosting Location]="Exchange Online")
			RETURN IF(NOT ISBLANK(_smtp) && COUNTROWS(_rows)=1,MAXX(_rows,'Mailbox Exploration Inventory'[M365 Licenses]),"Unavailable / ambiguous")
		dataType: string
		lineageTag: a1d85a62-41dc-41c2-a7c1-fff1417c587c
		summarizeBy: none

	partition 'Native EXO Mailbox' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("FactMailbox.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantMailboxKey", dataType="String"], [name="TenantUserKey", dataType="String"], [name="CmdbMailboxId", dataType="String"], [name="CmdbUserId", dataType="String"], [name="RecipientTypeDetails", dataType="String"], [name="ArchiveStatus", dataType="String"], [name="SourceSystem", dataType="String"], [name="DisplayName", dataType="String"], [name="PrimarySmtpAddress", dataType="String"], [name="LinkStatusLabel", dataType="String"], [name="DisplayNameLabel", dataType="String"], [name="PrimarySmtpAddressLabel", dataType="String"], [name="RecipientTypeDetailsLabel", dataType="String"], [name="ArchiveStatusLabel", dataType="String"]}))
				in
				    Readers[Finish](BusinessRows)

	annotation PBI_ResultType = Exception
