/// One assessment per observed device inventory key. Enrollment and Windows 11 feature deployment are separate. LTSC quality servicing is not conflated with feature upgrade availability. Unknown evidence is retained; rules evaluated at the recorded assessment UTC.
table 'Device Deployment Risk'
	lineageTag: d1605000-f69b-45e1-8206-d59ee8c1bd83

	measure 'Intune Enrollment At Risk PCs' = COALESCE(CALCULATE(COUNTROWS('Device Deployment Risk'),KEEPFILTERS('Device Deployment Risk'[Enrollment At Risk]=TRUE())),0)
		formatString: #,0
		lineageTag: 9de2471b-ea57-408e-b522-6f55736a4031

	measure 'Windows 11 Deployment At Risk PCs' = COALESCE(CALCULATE(COUNTROWS('Device Deployment Risk'),KEEPFILTERS('Device Deployment Risk'[Windows 11 At Risk]=TRUE())),0)
		formatString: #,0
		lineageTag: 50927b80-779d-40b2-828d-aa13a28832ba

	measure 'Intune Enrollment Unknown Evidence PCs' = COALESCE(CALCULATE(COUNTROWS('Device Deployment Risk'),KEEPFILTERS('Device Deployment Risk'[Enrollment Unknown Evidence]=TRUE())),0)
		formatString: #,0
		lineageTag: fc824b7b-6998-452e-9b14-321b9afca8a1

	measure 'Windows 11 Unknown Evidence PCs' = COALESCE(CALCULATE(COUNTROWS('Device Deployment Risk'),KEEPFILTERS('Device Deployment Risk'[Windows 11 Unknown Evidence]=TRUE())),0)
		formatString: #,0
		lineageTag: f7c67d59-1435-498e-ab3e-1488460fec5d

	measure 'Device Deployment Risk Scope' = "One current inventory key per KPI. Enrollment: enabled AD Windows PCs not already in Intune. Windows 11: Windows 10 upgrade route to existing target; no policy changes. Blocked / Review count as risk; missing, ambiguous or stale readiness is unknown, not healthy. LTSC feature upgrades need an alternate route; supported LTSC quality updates are separate. 20 GB free disk and 28-day readiness age are local assessment guardrails. Licensing, join state, patch level, services and per-device targeting are not certified."
		lineageTag: c472292d-8747-49c8-8d04-5c1eed8aabe6

	column 'Inventory Key'
		dataType: string
		lineageTag: 2f19f98b-3059-463a-878d-84e0146d3353
