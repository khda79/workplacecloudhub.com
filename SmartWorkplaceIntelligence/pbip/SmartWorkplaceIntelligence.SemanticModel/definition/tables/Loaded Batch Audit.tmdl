/// One row per prepared query, derived from imported columns only. Empty tables cannot expose their batch.
table 'Loaded Batch Audit'
	isHidden
	lineageTag: a3225076-67ea-4ab0-ad56-548f7628b8b2

	column 'Table Name'
		dataType: string
		isHidden
		lineageTag: f8c31ba1-c38f-499e-8ad7-0a24e6095b94
		summarizeBy: none
		sourceColumn: [Table Name]

	column 'Loaded Batch ID'
		dataType: string
		isHidden
		lineageTag: 2c45886c-9084-4924-9fe9-3bb52fb15400
		summarizeBy: none
		sourceColumn: [Loaded Batch ID]

	column 'Loaded Rows'
		dataType: int64
		isHidden
		lineageTag: 5c3e377d-63f3-4390-93fd-c28c30328db1
		summarizeBy: none
		sourceColumn: [Loaded Rows]

	column 'Source Availability' = VAR _table = 'Loaded Batch Audit'[Table Name] RETURN IF(_table IN {"Hybrid Identity Findings","Device Readiness Gap Evidence"}, LOOKUPVALUE('Readiness Source Status'[Availability], 'Readiness Source Status'[Table Name], _table), IF('Loaded Batch Audit'[Loaded Rows] > 0, "Loaded", "Unobserved"))
		dataType: string
		lineageTag: 636e372c-c7a2-4a6c-9aa9-099f815d3227
		summarizeBy: none

	column 'Evidence Date' = VAR _table = 'Loaded Batch Audit'[Table Name] RETURN LOOKUPVALUE('Readiness Source Status'[Evidence Date], 'Readiness Source Status'[Table Name], _table)
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 314b7cca-8b39-4d39-9ba3-2000d7b2809e
		summarizeBy: none

	partition 'Loaded Batch Audit' = calculated
		mode: import
		source =
