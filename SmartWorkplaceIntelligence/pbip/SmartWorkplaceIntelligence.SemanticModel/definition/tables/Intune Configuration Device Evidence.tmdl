/// Governed IntuneConfigurationDeviceEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Configuration Device Evidence'
	lineageTag: 30282925-2fcd-4995-8440-90653cc3e50a

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Configuration Device Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: d6edac3d-585b-4996-826e-49c1f76c565a

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Reported Issues' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Configuration Device Evidence'), KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State] = "ReportedIssue")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: f0096dd1-a7ba-4de4-9d4f-775ed0064b4b

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Applied Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Configuration Device Evidence'), KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State] = "ReportedApplied")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: b3ec49c4-7234-48ac-b5d4-1f075451fc3c

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Pending Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Configuration Device Evidence'), KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State] = "Pending")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: ba2a33f6-4b74-4c70-995c-0380266da16d

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Unknown Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Configuration Device Evidence'), KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State] = "Unknown")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 70fa7056-2dba-4eb0-a36c-81693f1a1b30

	/// Distinct tenant-aware identities among the specified reported observations, not verified physical endpoints or full tenant coverage.
	measure 'Intune Configuration Policies With Issues' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(DISTINCTCOUNT('Intune Configuration Device Evidence'[Policy Key]), KEEPFILTERS('Intune Configuration Device Evidence'[Policy Key] <> BLANK()), KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State] = "ReportedIssue")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 11743b8f-a8d4-4445-a4d7-89f99313558a

	/// Distinct tenant-aware identities among the specified reported observations, not verified physical endpoints or full tenant coverage.
	measure 'Intune Configuration Devices With Issues' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(DISTINCTCOUNT('Intune Configuration Device Evidence'[Device Key]), KEEPFILTERS('Intune Configuration Device Evidence'[Device Key] <> BLANK()), KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State] = "ReportedIssue")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 67244eda-20e4-4b38-b9e9-b307426ec65a

	/// Read-only report utility applying the disconnected primary-user selector to source-qualified device rows.
	measure 'Primary user row match · Intune Configuration Device Evidence' = VAR PresentRows = IF(ISFILTERED('Primary User Selection'[Primary user]), CALCULATE(COUNTROWS('Intune Configuration Device Evidence'), KEEPFILTERS(TREATAS(VALUES('Primary User Selection'[Primary user]), 'Intune Configuration Device Evidence'[Primary User (report)]))), COUNTROWS('Intune Configuration Device Evidence')) RETURN IF(PresentRows>0,1,BLANK())
		formatString: 0
		isHidden
		lineageTag: 76baf8de-520f-41ad-bbc2-42ca82e8465c

