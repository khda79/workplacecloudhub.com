	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Configuration Unknown Observations' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "Configurations", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Configuration Device Evidence'), KEEPFILTERS('Intune Configuration Device Evidence'[Reported Application State] = "Unknown")), 0), BLANK())
		formatString: #,##0
