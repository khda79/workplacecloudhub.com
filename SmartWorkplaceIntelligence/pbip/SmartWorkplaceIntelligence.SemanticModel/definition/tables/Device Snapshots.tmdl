/// One synthetic device per reporting snapshot.
table 'Device Snapshots'
	lineageTag: d54d7bc3-460b-4bdc-ab4b-a16ae3e774cd

	/// Distinct reconciled synthetic devices in scope.
	measure '# Devices' = DISTINCTCOUNT('Device Snapshots'[Device Key])
		formatString: #,0
		displayFolder: Measures
		lineageTag: 85838fd6-0cfb-4d87-9254-4c277c777baa

	/// Days from latest qualified device activity to the reporting date.
	measure 'Device Activity Age Days' = VAR _lastActivity = MAX('Device Snapshots'[Last Activity UTC]) VAR _reportingDate = MAX('Date'[Date]) RETURN IF(ISBLANK(_lastActivity), BLANK(), DATEDIFF(_lastActivity, _reportingDate, DAY))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 661b1684-804c-49be-ab0c-5c3f2b519ac8

	/// Accepted device health observations.
	measure '# Device Health Signals' = COUNTROWS('Device Snapshots')
		formatString: #,0
		displayFolder: Measures
		lineageTag: 5969f04f-090e-4933-bd78-f796ba3b27b7

