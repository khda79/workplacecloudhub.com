/// Prepared Directory Cleanup evidence; country provenance is preserved.
table 'User Cleanup Evidence'
	lineageTag: 8e4dd96a-a01c-4f27-ab65-52ecb0b7c29f

	measure 'User Cleanup Total' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('User Cleanup Evidence')), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: c8f27c06-e10d-47ac-a152-0b669642057a

	measure 'User Cleanup Candidates' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('User Cleanup Evidence'), KEEPFILTERS('User Cleanup Evidence'[Cleanup State] = "Candidate")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: d32ccfe7-d7b9-4b0c-8002-d1bb9074c9a3

	measure 'User Cleanup Review' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('User Cleanup Evidence'), KEEPFILTERS('User Cleanup Evidence'[Cleanup State] = "Review")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: b726204b-25fb-4189-8b00-308efe9c322e

	measure 'User Cleanup Active' =
			VAR _q = CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('User Cleanup Evidence'), KEEPFILTERS('User Cleanup Evidence'[Cleanup State] = "Active")), 0), BLANK())
		formatString: #,0
		displayFolder: Directory Cleanup
		lineageTag: 961af13b-fea0-4926-83f8-855fbea68403

