			VAR _missing=FILTER('Hybrid Identity Findings',(_cf && (ISBLANK('Hybrid Identity Findings'[Backlog Country]) || 'Hybrid Identity Findings'[Backlog Country]="Unknown")) || (_df && (ISBLANK('Hybrid Identity Findings'[Backlog AD Domain]) || 'Hybrid Identity Findings'[Backlog AD Domain]="Unknown")))
			RETURN IF(SELECTEDVALUE('Backlog Attribution Selection'[Mode],"In scope")="Unassigned evidence",CALCULATE((IF(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Hybrid Identity Findings",'Readiness Source Status'[Source Available]=TRUE())=1,COALESCE((COUNTROWS('Hybrid Identity Findings')),0),BLANK())),KEEPFILTERS(_missing)),CALCULATE((IF(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Hybrid Identity Findings",'Readiness Source Status'[Source Available]=TRUE())=1,COALESCE((COUNTROWS('Hybrid Identity Findings')),0),BLANK())),KEEPFILTERS(TREATAS(_ck,'Hybrid Identity Findings'[Backlog Country])),KEEPFILTERS(TREATAS(_dk,'Hybrid Identity Findings'[Backlog AD Domain]))))
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: adcd8dfd-1c6e-557c-9681-82c7c05857bc

