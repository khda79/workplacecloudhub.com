	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Exchange Evidence Note' =
			VAR _keys=SELECTCOLUMNS('Mailbox Migration Inventory',"GUID",'Mailbox Migration Inventory'[Object GUID],"Batch",'Mailbox Migration Inventory'[Loaded Batch ID])
			RETURN IF(NOT(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Hybrid Identity Findings",'Readiness Source Status'[Source Available]=TRUE())=1),"Identity evidence unavailable",IF(COUNTROWS(_keys)=0,"Native account link unresolved; no absence-of-findings claim","Selected native account context | no findings means no observation in the available source"))
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 559d1fc8-0b67-5517-b8ac-7c424457d38a

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Exchange Unavailable Mailboxes' = COALESCE(COUNTROWS(FILTER('Mailbox Migration Inventory',CONTAINSSTRING('Mailbox Migration Inventory'[Risk Reasons],"Identity evidence unavailable"))),0)
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: 8eb94d39-da55-5831-8e36-0db0a63ec5b7

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Identity Scope Text' = "Scope: "&IF(ISFILTERED('Country Selection'),CONCATENATEX(VALUES('Country Selection'[Country]),'Country Selection'[Country],", "),"All countries")&" | "&IF(ISFILTERED('Daily Domain'),CONCATENATEX(VALUES('Daily Domain'[Domain]),'Daily Domain'[Domain],", "),"All domains")&" | "&SELECTEDVALUE('Backlog Attribution Selection'[Mode],"In scope")
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 0f2e6144-29e2-55b3-b829-3162df617e97

	measure 'Backlog Exchange Identity Evidence Tooltip' = "Identity evidence unavailable is a non-blocking risk reason when HybridIdentityFindings.csv is unavailable. It requires evidence review and never creates a migration blocker. License coverage is separate and never changes Exchange migration status."
