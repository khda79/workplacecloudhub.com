		annotation SummarizationSetBy = Automatic

	partition 'Hybrid Identity Findings' = m
		mode: import
		source =
				let
				 Base=(let
				    R=CreatePreparedReaders(),
				    S=R[GetReadinessSource]("HybridIdentityFindings.csv"),
				    Labels=Table.AddColumn(S[Rows],"Account Population Label", each if [Account Population]=null or Text.Trim([Account Population])="" then "Not classified" else [Account Population],type text)
				in R[Finish](Labels)),
				 K=CreateBacklogTools(CreatePreparedReaders()),
				 A=K[Index](K[Read]("ADUserSource.csv",{"TenantKey","ObjectGUID","DomainName"}),"ObjectGUID"),
				 C=K[Index](K[Read]("AllAccountsEvidence.csv",{"TenantKey","Account Key","Country"}),"Account Key"),
				 Added=Table.AddColumn(Base,"__context",each
				  let AD=K[Match](A,[TenantKey],[AD Object GUID],[Loaded Batch ID]), Co=K[Match](C,[TenantKey],"ad:"&K[Key]([AD Object GUID]),[Loaded Batch ID]),
				      SeverityOrder=List.PositionOf({"Blocker","High","Medium","Review","Info"},[Severity])
				  in [#"Backlog Country"=K[Field](Co,"Country"),#"Backlog AD Domain"=K[Field](AD,"DomainName"),#"Country Match State"=Co[State],#"Domain Match State"=AD[State],
				      #"Rule Observation"=[Rule ID]&" - "&(if [Observed Value]=null then "" else [Observed Value]),#"Severity Sort"=if SeverityOrder<0 then 9 else SeverityOrder],type record),
				 Expanded=Table.ExpandRecordColumn(Added,"__context",{"Backlog Country","Backlog AD Domain","Country Match State","Domain Match State","Rule Observation","Severity Sort"})
				in Table.TransformColumnTypes(Expanded, {{"Severity Sort", Int64.Type}})
