	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog User Evidence Note' =
			VAR _accounts=SELECTCOLUMNS('Account Explorer Inventory',
			"__A",LOWER(TRIM('Account Explorer Inventory'[Account Key])),
			"__N",LOWER(TRIM('Account Explorer Inventory'[Native User Key])),
			"__B",'Account Explorer Inventory'[Loaded Batch ID]&"",
			"__T",'Account Explorer Inventory'[TenantKey]&"")
			VAR _ad=SELECTCOLUMNS(ALL('AD User Evidence'),
			"__G",LOWER(TRIM('AD User Evidence'[ObjectGUID])),
			"__N",LOWER(TRIM('AD User Evidence'[TenantUserKey])),
			"__B",'AD User Evidence'[Loaded Batch ID]&"",
			"__T",'AD User Evidence'[TenantKey]&"",
			"__S",'AD User Evidence'[CloudMatchStatus]&"")
			VAR _byGuid=FILTER(GROUPBY(_ad,[__G],[__B],[__T],"__Count",COUNTX(CURRENTGROUP(),1)),[__Count]=1)
			VAR _byNative=FILTER(GROUPBY(FILTER(_ad,[__S]="Unique native SID"),[__N],[__B],[__T],
			"__Count",COUNTX(CURRENTGROUP(),1),"__G",MAXX(CURRENTGROUP(),[__G])),[__Count]=1 && LEN([__N])>0)
			VAR _direct=SELECTCOLUMNS(FILTER(_accounts,LEFT([__A],3)="ad:"),"__G",MID([__A],4,500),"__B",[__B],"__T",[__T])
			VAR _cloud=SELECTCOLUMNS(FILTER(_accounts,LEFT([__A],3)<>"ad:" && LEN([__N])>0),"__N",[__N],"__B",[__B],"__T",[__T])
			VAR _keys=UNION(
			SELECTCOLUMNS(FILTER(NATURALINNERJOIN(_direct,_byGuid),NOT ISBLANK([__G])),"GUID",[__G],"Batch",[__B],"Tenant",[__T]),
			SELECTCOLUMNS(FILTER(NATURALINNERJOIN(_cloud,_byNative),NOT ISBLANK([__G])),"GUID",[__G],"Batch",[__B],"Tenant",[__T]))
			VAR _resolved=COALESCE(COUNTROWS(_keys),0)
			VAR _selected=COALESCE(COUNTROWS('Account Explorer Inventory'),0)
			RETURN IF(NOT(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Hybrid Identity Findings",'Readiness Source Status'[Source Available]=TRUE())=1),
			"Identity evidence unavailable",FORMAT(_resolved,"#,##0")&" resolved native account rows | "&FORMAT(_selected-_resolved,"#,##0")&" unresolved rows | no findings is meaningful only for a resolved account")
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: c7680ef0-c86d-57d8-9571-2ad35d406159

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Exchange Findings' =
			VAR _keys=SELECTCOLUMNS('Mailbox Migration Inventory',"GUID",'Mailbox Migration Inventory'[Object GUID],"Batch",'Mailbox Migration Inventory'[Loaded Batch ID])
			RETURN IF(COUNTROWS(_keys)=0,BLANK(),CALCULATE([Backlog Identity Findings],KEEPFILTERS(TREATAS(_keys,'Hybrid Identity Findings'[AD Object GUID],'Hybrid Identity Findings'[Loaded Batch ID]))))
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: 92e43641-39d0-5fe8-b4f0-4597f258c336

