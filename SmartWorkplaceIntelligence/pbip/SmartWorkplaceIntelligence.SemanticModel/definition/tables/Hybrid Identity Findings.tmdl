	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Blocker Definition' = "Blocker denotes a migration blocker according to the rule specification; it is not a daily incident priority."
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: 2ad08dc8-44bf-50dc-a6ab-274e6b3de130

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Identity Coverage Text' = IF(NOT(CALCULATE(COUNTROWS('Readiness Source Status'),REMOVEFILTERS('Readiness Source Status'),'Readiness Source Status'[Table Name]="Hybrid Identity Findings",'Readiness Source Status'[Source Available]=TRUE())=1),"Identity evidence unavailable",FORMAT([Backlog Identity Findings],"#,##0")&" findings | "&FORMAT([Backlog Identity Accounts],"#,##0")&" distinct AD accounts | "&FORMAT([Backlog Identity Non-Blocker Findings],"#,##0")&" non-Blocker findings | "&FORMAT(CALCULATE([Backlog Identity Findings],KEEPFILTERS('Hybrid Identity Findings'[Backlog Country] IN {BLANK(),"Unknown",""})),"#,##0")&" without Country | "&FORMAT([Backlog Identity Unattributable Findings],"#,##0")&" not attributable to active scope - select Unassigned evidence")
		formatString: @
		displayFolder: Remediation Backlog
		lineageTag: d21ba01d-c438-5a5e-8cbe-a43e31350cb6

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog User Findings' =
			VAR _accounts=SELECTCOLUMNS('Account Explorer Inventory',
			"__A",LOWER(TRIM('Account Explorer Inventory'[Account Key])),
			"__N",LOWER(TRIM('Account Explorer Inventory'[Native User Key])),
			"__B",'Account Explorer Inventory'[Loaded Batch ID]&"",
			"__T",'Account Explorer Inventory'[TenantKey]&"")
			VAR _ad=SELECTCOLUMNS(ALL('AD User Evidence'),
			"__G",LOWER(TRIM('AD User Evidence'[ObjectGUID])),
			"__N",LOWER(TRIM('AD User Evidence'[TenantUserKey])),
			"__B",'AD User Evidence'[Loaded Batch ID]&"",
			"__T",'AD User Evidence'[TenantKey]&"",
			"__S",'AD User Evidence'[CloudMatchStatus]&"")
			VAR _byGuid=FILTER(GROUPBY(_ad,[__G],[__B],[__T],"__Count",COUNTX(CURRENTGROUP(),1)),[__Count]=1)
			VAR _byNative=FILTER(GROUPBY(FILTER(_ad,[__S]="Unique native SID"),[__N],[__B],[__T],
			"__Count",COUNTX(CURRENTGROUP(),1),"__G",MAXX(CURRENTGROUP(),[__G])),[__Count]=1 && LEN([__N])>0)
			VAR _direct=SELECTCOLUMNS(FILTER(_accounts,LEFT([__A],3)="ad:"),"__G",MID([__A],4,500),"__B",[__B],"__T",[__T])
			VAR _cloud=SELECTCOLUMNS(FILTER(_accounts,LEFT([__A],3)<>"ad:" && LEN([__N])>0),"__N",[__N],"__B",[__B],"__T",[__T])
			VAR _keys=UNION(
			SELECTCOLUMNS(FILTER(NATURALINNERJOIN(_direct,_byGuid),NOT ISBLANK([__G])),"GUID",[__G],"Batch",[__B],"Tenant",[__T]),
			SELECTCOLUMNS(FILTER(NATURALINNERJOIN(_cloud,_byNative),NOT ISBLANK([__G])),"GUID",[__G],"Batch",[__B],"Tenant",[__T]))
			RETURN IF(COUNTROWS(_keys)=0,BLANK(),CALCULATE([Backlog Identity Findings],KEEPFILTERS(TREATAS(_keys,'Hybrid Identity Findings'[AD Object GUID],'Hybrid Identity Findings'[Loaded Batch ID],'Hybrid Identity Findings'[TenantKey]))))
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: 017fc6f1-6925-5084-9d9b-22ac180b34e6

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
