			RETURN IF(COUNTROWS(_keys)=0,BLANK(),CALCULATE([Backlog Identity Row In Scope],KEEPFILTERS(TREATAS(_keys,'Hybrid Identity Findings'[AD Object GUID],'Hybrid Identity Findings'[Loaded Batch ID]))))
