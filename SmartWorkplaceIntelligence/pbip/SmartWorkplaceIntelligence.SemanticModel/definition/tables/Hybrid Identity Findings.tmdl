/// Observed findings at tenant and Finding Key grain. Disconnected audit fact; includes all account populations. Blank population is explicitly Not classified. Severity Blocker alone feeds migration blocking.
table 'Hybrid Identity Findings'
	lineageTag: 96e4d461-34ff-4863-be3d-62281948b01b

	/// Findings, not distinct accounts. Unavailable source is BLANK; valid empty is zero.
	measure 'Hybrid Identity Findings Count' = IF(CALCULATE(COUNTROWS('Readiness Source Status'), REMOVEFILTERS('Readiness Source Status'), 'Readiness Source Status'[Table Name] = "Hybrid Identity Findings", 'Readiness Source Status'[Source Available] = TRUE()) = 1,COALESCE(COUNTROWS('Hybrid Identity Findings'),0),BLANK())
		formatString: #,0
		displayFolder: Readiness | Validation
		lineageTag: 5f70fe54-f78f-4762-936b-b95d8cd8cf39

	/// Distinct nonblank AD account GUIDs. Unavailable source is BLANK; valid empty is zero.
	measure 'Hybrid Identity Accounts' = IF(CALCULATE(COUNTROWS('Readiness Source Status'), REMOVEFILTERS('Readiness Source Status'), 'Readiness Source Status'[Table Name] = "Hybrid Identity Findings", 'Readiness Source Status'[Source Available] = TRUE()) = 1,COALESCE(CALCULATE(DISTINCTCOUNT('Hybrid Identity Findings'[AD Object GUID]), KEEPFILTERS('Hybrid Identity Findings'[AD Object GUID] <> BLANK())),0),BLANK())
		formatString: #,0
		displayFolder: Readiness | Validation
		lineageTag: 04a313c4-216d-425b-bb4d-55506489146a

	/// Blocker findings, not accounts. Unavailable source is BLANK; valid empty is zero.
	measure 'Hybrid Identity Blocker Findings' = IF(CALCULATE(COUNTROWS('Readiness Source Status'), REMOVEFILTERS('Readiness Source Status'), 'Readiness Source Status'[Table Name] = "Hybrid Identity Findings", 'Readiness Source Status'[Source Available] = TRUE()) = 1,COALESCE(CALCULATE(COUNTROWS('Hybrid Identity Findings'), KEEPFILTERS('Hybrid Identity Findings'[Severity] = "Blocker")),0),BLANK())
		formatString: #,0
		displayFolder: Readiness | Validation
		lineageTag: 6c170e31-7dec-473e-bcb2-8d393082c285

	/// Findings for HYB-021. Unavailable source is BLANK; valid empty is zero.
	measure 'Hybrid Identity HYB-021' = IF(CALCULATE(COUNTROWS('Readiness Source Status'), REMOVEFILTERS('Readiness Source Status'), 'Readiness Source Status'[Table Name] = "Hybrid Identity Findings", 'Readiness Source Status'[Source Available] = TRUE()) = 1,COALESCE(CALCULATE(COUNTROWS('Hybrid Identity Findings'), KEEPFILTERS('Hybrid Identity Findings'[Rule ID] = "HYB-021")),0),BLANK())
		formatString: #,0
		displayFolder: Readiness | Validation
		lineageTag: 2ce34d0d-912e-4a9c-bd07-a97eba713bee

	/// Scoped lot 1b evidence measure. Counts retain unavailable-source semantics and explicit attribution gaps.
	measure 'Backlog Identity Row In Scope' =
			VAR _cf=ISFILTERED('Country Selection')
			VAR _df=ISFILTERED('Daily Domain')
			VAR _countries=VALUES('Country Selection'[Source Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _ck=FILTER(VALUES('Hybrid Identity Findings'[Backlog Country]),NOT _cf || 'Hybrid Identity Findings'[Backlog Country] IN _countries)
			VAR _dk=FILTER(VALUES('Hybrid Identity Findings'[Backlog AD Domain]),NOT _df || 'Hybrid Identity Findings'[Backlog AD Domain] IN _domains)
			VAR _missing=FILTER('Hybrid Identity Findings',(_cf && (ISBLANK('Hybrid Identity Findings'[Backlog Country]) || 'Hybrid Identity Findings'[Backlog Country]="Unknown")) || (_df && (ISBLANK('Hybrid Identity Findings'[Backlog AD Domain]) || 'Hybrid Identity Findings'[Backlog AD Domain]="Unknown")))
			RETURN IF(SELECTEDVALUE('Backlog Attribution Selection'[Mode],"In scope")="Unassigned evidence",CALCULATE((IF(COUNTROWS('Hybrid Identity Findings')>0,1,0)),KEEPFILTERS(_missing)),CALCULATE((IF(COUNTROWS('Hybrid Identity Findings')>0,1,0)),KEEPFILTERS(TREATAS(_ck,'Hybrid Identity Findings'[Backlog Country])),KEEPFILTERS(TREATAS(_dk,'Hybrid Identity Findings'[Backlog AD Domain]))))
		formatString: #,##0
		displayFolder: Remediation Backlog
		lineageTag: d79a12ab-e7d7-5cdf-896e-bbdb50ff2184

