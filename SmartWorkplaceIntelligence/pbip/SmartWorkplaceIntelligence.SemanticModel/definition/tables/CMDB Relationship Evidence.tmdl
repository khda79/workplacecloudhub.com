	column 'Source Row Key'
		dataType: string
		isHidden
		lineageTag: 52f681ae-e6fa-4e47-936c-23bf8797e004
		summarizeBy: none
		sourceColumn: Source Row Key

	column 'Acquired UTC'
		dataType: string
		lineageTag: d30ecc13-1323-4089-9429-f6e8db4830bd
		summarizeBy: none
		sourceColumn: Acquired UTC

	partition 'CMDB Relationship Evidence' = m
		mode: import
		source =
				let
				    Source = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("CMDBRelationshipEvidence.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),[PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Source,{{"TenantKey", type text},{"Link Key", type text},{"From Entity Key", type text},{"To Entity Key", type text},{"From Name", type text},{"To Name", type text},{"Relationship Type", type text},{"Source System", type text},{"Resolution", type text},{"Qualification", type text},{"Source Table", type text},{"Source Row Key", type text},{"Acquired UTC", type text}},"en-US")
				in Typed

