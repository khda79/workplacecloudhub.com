/// Tenant-scoped observed native entities/links. No physical-asset, effective-access or transitive-impact inference.
table 'CMDB Relationship Evidence'
	lineageTag: aae144d2-7fd5-49c4-8064-9806183115d3

	/// Explicit endpoint projection of observed incoming and outgoing links. No bidirectional relationship.
	measure 'CMDB Observed Relationships' =
			VAR Scoped = ISCROSSFILTERED('CMDB Entity Evidence')
			VAR Links = VALUES('CMDB Relationship Endpoint'[Link Key])
			RETURN IF(Scoped, CALCULATE(COUNTROWS('CMDB Relationship Evidence'), KEEPFILTERS(TREATAS(Links, 'CMDB Relationship Evidence'[Link Key]))), COUNTROWS('CMDB Relationship Evidence'))
		formatString: #,0
		lineageTag: c87cc582-a572-430f-9f53-507b53be23a2

	/// Observed links with at least one endpoint absent from the captured catalogs. Unknown is not zero.
	measure 'CMDB Unresolved Relationships' = CALCULATE([CMDB Observed Relationships], KEEPFILTERS('CMDB Relationship Evidence'[Resolution] <> "Resolved"))
		formatString: #,0
		lineageTag: 511c89f1-5384-4825-9300-dc85288bf6f4

	/// Visual filter for observed links incident on the selected native entity; unresolved links remain visible when no entity is selected.
	measure 'CMDB Link In Context' = IF([CMDB Observed Relationships] > 0, 1, BLANK())
		formatString: 0
		isHidden
		lineageTag: 2fac0336-06c0-4ad4-8a2d-b92e339bdde7

	column TenantKey
		dataType: string
		isHidden
		lineageTag: 548e7f7e-fed1-4fe4-8639-d856d1c4995f
		summarizeBy: none
		sourceColumn: TenantKey

	column 'Link Key'
		dataType: string
		isHidden
		lineageTag: 8ee36e97-819a-4808-83dc-4f12a87f5c0d
		summarizeBy: none
		sourceColumn: Link Key

	column 'From Entity Key'
		dataType: string
		isHidden
		lineageTag: 6d4e92fd-b54d-4659-aeed-247271668fc2
		summarizeBy: none
		sourceColumn: From Entity Key

	column 'To Entity Key'
		dataType: string
		isHidden
		lineageTag: 39c2507e-3675-46c5-807a-22af555934f7
		summarizeBy: none
		sourceColumn: To Entity Key

	column 'From Name'
		dataType: string
		lineageTag: 0cd793db-f603-4cde-a6d2-665db68af8c7
		summarizeBy: none
		sourceColumn: From Name

	column 'To Name'
		dataType: string
		lineageTag: 22f11e37-25bc-4006-8165-5ebf42cc954b
		summarizeBy: none
		sourceColumn: To Name

	column 'Relationship Type'
		dataType: string
		lineageTag: 08ba320e-d7ad-491a-bb61-b2a1ff89b78f
		summarizeBy: none
		sourceColumn: Relationship Type

	column 'Source System'
		dataType: string
		lineageTag: 9bece86f-0a26-4187-a82f-15f833ff02f9
		summarizeBy: none
		sourceColumn: Source System

	column Resolution
		dataType: string
		lineageTag: 5bfbf88b-c682-4885-8394-618e61be84ad
		summarizeBy: none
		sourceColumn: Resolution

	column Qualification
		dataType: string
		lineageTag: 96a94647-0a1a-4671-b833-7b6796a80e23
