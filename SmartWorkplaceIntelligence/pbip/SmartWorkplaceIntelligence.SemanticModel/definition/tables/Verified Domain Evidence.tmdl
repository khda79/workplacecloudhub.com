/// Native source facet migrated from DimVerifiedDomain; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Verified Domain Evidence'
	lineageTag: d3e90a80-b310-4f81-9697-98f7154a4a06

	/// Verified Entra domains present in the frozen collection; a domain row does not prove DNS or authentication health. Migrated without changing the source calculation.
	measure 'Native Verified domains' = (COALESCE(COUNTROWS('Verified Domain Evidence'),0))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: b178e0e5-e1c8-4ec1-bd3f-ac5785dbecb9

	/// Existing qualified workforce/device scope via exact native IDs; otherwise the domain selection. No name matching or inferred transitive membership.
	measure 'Native Context Rows · Verified Domain Evidence' = (COUNTROWS('Verified Domain Evidence'))
		formatString: #,0
		isHidden
		lineageTag: 7f4c854e-cfce-4a98-9e77-b0c716140294

