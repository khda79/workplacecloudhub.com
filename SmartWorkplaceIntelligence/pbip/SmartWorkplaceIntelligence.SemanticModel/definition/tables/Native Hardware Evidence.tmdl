			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((CALCULATE([Native Hardware records], KEEPFILTERS('Native Hardware Evidence'[SerialNumber] = "Not provided"))), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (CALCULATE([Native Hardware records], KEEPFILTERS('Native Hardware Evidence'[SerialNumber] = "Not provided"))))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
