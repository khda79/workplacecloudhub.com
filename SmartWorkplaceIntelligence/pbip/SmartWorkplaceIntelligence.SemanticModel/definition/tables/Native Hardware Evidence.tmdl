/// Native source facet migrated from DeviceHardware; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native Hardware Evidence'
	lineageTag: 1e441dfa-fdcc-45b1-8030-4ab0bac9f09d

	/// Native hardware inventory rows/device identities in the selected fleet and Country. Missing attributes do not become zero. Migrated without changing the source calculation.
	measure 'Native Hardware records' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((VAR _countries = VALUES ( 'Native Country Evidence'[CountryLabel] )
			RETURN IF ( ISCROSSFILTERED ( 'Native Country Evidence' ), CALCULATE ( COALESCE ( COUNTROWS ( 'Native Hardware Evidence' ), 0 ), KEEPFILTERS ( TREATAS ( _countries, 'Native Device Evidence'[CountryLabel] ) ) ), COALESCE ( COUNTROWS ( 'Native Hardware Evidence' ), 0 ) )), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (VAR _countries = VALUES ( 'Native Country Evidence'[CountryLabel] )
			RETURN IF ( ISCROSSFILTERED ( 'Native Country Evidence' ), CALCULATE ( COALESCE ( COUNTROWS ( 'Native Hardware Evidence' ), 0 ), KEEPFILTERS ( TREATAS ( _countries, 'Native Device Evidence'[CountryLabel] ) ) ), COALESCE ( COUNTROWS ( 'Native Hardware Evidence' ), 0 ) )))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 8aacaa85-3e20-4452-9948-d97e536877f4

	/// Native hardware inventory rows/device identities in the selected fleet and Country. Missing attributes do not become zero. Migrated without changing the source calculation.
	measure 'Native Devices with hardware' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((VAR _countries = VALUES ( 'Native Country Evidence'[CountryLabel] )
			RETURN IF ( ISCROSSFILTERED ( 'Native Country Evidence' ), CALCULATE ( COALESCE ( DISTINCTCOUNT ( 'Native Hardware Evidence'[TenantDeviceKey] ), 0 ), KEEPFILTERS ( TREATAS ( _countries, 'Native Device Evidence'[CountryLabel] ) ) ), COALESCE ( DISTINCTCOUNT ( 'Native Hardware Evidence'[TenantDeviceKey] ), 0 ) )), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (VAR _countries = VALUES ( 'Native Country Evidence'[CountryLabel] )
			RETURN IF ( ISCROSSFILTERED ( 'Native Country Evidence' ), CALCULATE ( COALESCE ( DISTINCTCOUNT ( 'Native Hardware Evidence'[TenantDeviceKey] ), 0 ), KEEPFILTERS ( TREATAS ( _countries, 'Native Device Evidence'[CountryLabel] ) ) ), COALESCE ( DISTINCTCOUNT ( 'Native Hardware Evidence'[TenantDeviceKey] ), 0 ) )))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: ab888e8e-350b-4226-b719-70e90a00a2bb

	/// Imported scoped devices with no hardware row; distinguishes row coverage from attribute completeness. Migrated without changing the source calculation.
	measure 'Native Devices without hardware' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((MAX ( 0, [Native Devices] - [Native Devices with hardware] )), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (MAX ( 0, [Native Devices] - [Native Devices with hardware] )))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: c93da65e-08f8-43dd-bd23-cf40e9d8d598

	/// Current device filter; separate native records are retained. Coverage does not prove hardware freshness. Migrated without changing the source calculation.
	measure 'Native Hardware detail rows' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((IF(COUNTROWS(ALLSELECTED('Native Device Evidence')) = 1, COUNTROWS('Native Hardware Evidence'))), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (IF(COUNTROWS(ALLSELECTED('Native Device Evidence')) = 1, COUNTROWS('Native Hardware Evidence'))))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 681e770e-a18a-46ac-b1dd-627c632ca1c9

	/// Current device filter; separate native records are retained. Coverage does not prove hardware freshness. Migrated without changing the source calculation.
	measure 'Native Hardware source message' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((VAR _status = SELECTEDVALUE('Hardware Coverage Evidence'[Status], "NotProvided") RETURN IF(_status = "NotProvided", "Hardware source not supplied. Existing inventory is retained; hardware attributes are unavailable.", IF(COUNTROWS(ALLSELECTED('Native Device Evidence')) <> 1, "Select one device to inspect its hardware. Coverage: " & SELECTEDVALUE('Hardware Coverage Evidence'[Coverage]) & ".", IF([Native Hardware records] = 0, "No hardware record for this device in the supplied snapshot.", "Source-reported hardware. Missing values remain unknown; each source retains its own collection date.")))), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (VAR _status = SELECTEDVALUE('Hardware Coverage Evidence'[Status], "NotProvided") RETURN IF(_status = "NotProvided", "Hardware source not supplied. Existing inventory is retained; hardware attributes are unavailable.", IF(COUNTROWS(ALLSELECTED('Native Device Evidence')) <> 1, "Select one device to inspect its hardware. Coverage: " & SELECTEDVALUE('Hardware Coverage Evidence'[Coverage]) & ".", IF([Native Hardware records] = 0, "No hardware record for this device in the supplied snapshot.", "Source-reported hardware. Missing values remain unknown; each source retains its own collection date.")))))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: @
		displayFolder: Native evidence
		lineageTag: 4755cbf8-556a-45e0-aa42-9fcb70d6d5b1

	/// Distinct devices with a hardware record in the current DimDevice scope. Hardware-attribute selections are excluded from this coverage numerator. Migrated without changing the source calculation.
	measure 'Native Hardware covered devices' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((CALCULATE([Native Devices with hardware], REMOVEFILTERS('Native Hardware Evidence'[Manufacturer]), REMOVEFILTERS('Native Hardware Evidence'[Model]), REMOVEFILTERS('Native Hardware Evidence'[SerialNumber]), REMOVEFILTERS('Native Hardware Evidence'[Storage]))), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (CALCULATE([Native Devices with hardware], REMOVEFILTERS('Native Hardware Evidence'[Manufacturer]), REMOVEFILTERS('Native Hardware Evidence'[Model]), REMOVEFILTERS('Native Hardware Evidence'[SerialNumber]), REMOVEFILTERS('Native Hardware Evidence'[Storage]))))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 7ec49fe5-4753-4ae8-b24c-5a2e057f84ee

	/// Devices in the current DimDevice scope minus covered devices. The denominator is the filtered device inventory, not hardware records. Migrated without changing the source calculation.
	measure 'Native Hardware uncovered devices' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((MAX(0, [Native Devices] - [Native Hardware covered devices])), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (MAX(0, [Native Devices] - [Native Hardware covered devices])))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 08c024c6-09b2-4a8f-a1af-33a4aad2ad3b

	/// Covered devices divided by devices in the current DimDevice scope. Hardware-attribute selections do not change the coverage numerator. Migrated without changing the source calculation.
	measure 'Native Hardware coverage rate' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
			RETURN CALCULATE((VAR InventoryDevices = CALCULATETABLE(VALUES('Native Managed Device Evidence'[TenantDeviceKey]), REMOVEFILTERS('Native Managed Device Evidence'), TREATAS(VALUES('Device Inventory Evidence'[Device Source ID]), 'Native Managed Device Evidence'[ManagedDeviceId]))
			RETURN SWITCH(TRUE(), ISCROSSFILTERED('Device Inventory Evidence'), CALCULATE((DIVIDE([Native Hardware covered devices], [Native Devices])), KEEPFILTERS(TREATAS(InventoryDevices, 'Native Hardware Evidence'[TenantDeviceKey]))), (DIVIDE([Native Hardware covered devices], [Native Devices])))),KEEPFILTERS(_privateDomainScope),KEEPFILTERS(_privateCountryScope))
		formatString: 0.0%
		displayFolder: Native evidence
		lineageTag: e1b0c1de-d0c6-4111-8be4-21728961c7c6

	/// Hardware records whose source serial status was Missing. This is distinct from a reported value and never defines identity or ownership. Migrated without changing the source calculation.
	measure 'Native Missing serial records' =
			VAR _privateDomainScope = FILTER(ALL('Native Device Evidence'[AD Domain]), NOT ISFILTERED('Daily Domain') || 'Native Device Evidence'[AD Domain] IN VALUES('Daily Domain'[Domain]))
			VAR _privateCountryScope = FILTER(ALL('Native Device Evidence'[CountryCode]), NOT ISFILTERED('Country Selection') || IF(ISBLANK('Native Device Evidence'[CountryCode]) || TRIM('Native Device Evidence'[CountryCode])="", "Unknown", 'Native Device Evidence'[CountryCode]) IN VALUES('Country Selection'[Source Country]))
