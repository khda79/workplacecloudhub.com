	partition 'Native Workload Activity' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("FactUserActivity.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantUserActivityKey", dataType="String"], [name="TenantUserKey", dataType="String"], [name="UserPrincipalName", dataType="String"], [name="MatchStatus", dataType="String"], [name="ReportRefreshDate", dataType="DateOnly"], [name="IsDeleted", dataType="String"], [name="ExchangeLastActivityDate", dataType="DateOnly"], [name="OneDriveLastActivityDate", dataType="DateOnly"], [name="SharePointLastActivityDate", dataType="DateOnly"], [name="TeamsLastActivityDate", dataType="DateOnly"], [name="LastActivityDate", dataType="DateOnly"], [name="LastActivityWorkload", dataType="String"], [name="HasAnyM365Activity", dataType="Boolean"], [name="AssignedProducts", dataType="String"], [name="SourceCollectedDateTime", dataType="DateTime"]}))
				in
				    Readers[Finish](BusinessRows)
