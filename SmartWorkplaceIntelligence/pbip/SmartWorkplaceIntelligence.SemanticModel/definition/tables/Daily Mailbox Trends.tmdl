	measure 'Exchange Online Share Daily' = DIVIDE([Exchange Online Remote Daily], [Total Mailboxes Daily])
		formatString: 0.0%
		displayFolder: Daily Trends
		lineageTag: 89286378-d80b-4a09-8497-bd704ac91cd1

	measure 'Exchange Online Share Card' = VAR _first = MINX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Exchange Online Share Daily])), 'Date'[Date]) VAR _last = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Exchange Online Share Daily])), 'Date'[Date]) VAR _a = CALCULATE([Exchange Online Share Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([Exchange Online Share Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b), "Not measured", FORMAT(_b, "0.0%") & "  |  " & FORMAT((_b-_a)*100, "+0.0;-0.0;0.0") & " pp")
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 993b7121-ea56-4cce-b580-7dce566285ca

	measure 'On-premises Remaining Card' = VAR _first = MINX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([On-premises Mailboxes Daily])), 'Date'[Date]) VAR _last = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([On-premises Mailboxes Daily])), 'Date'[Date]) VAR _a = CALCULATE([On-premises Mailboxes Daily], 'Date'[Date] = _first) VAR _b = CALCULATE([On-premises Mailboxes Daily], 'Date'[Date] = _last) RETURN IF(ISBLANK(_b), "Not measured", FORMAT(_b, "#,0") & "  |  " & FORMAT(_b-_a, "+#,0;-#,0;0"))
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 73cf969a-4a2a-4179-9918-a71726e39a28

	measure 'Last Qualified Mailbox Core Day' = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total Mailboxes Daily]) && NOT ISBLANK([On-premises Mailboxes Daily]) && NOT ISBLANK([Exchange Online Remote Daily]) && NOT ISBLANK([Enabled Mailbox Accounts Daily]) && NOT ISBLANK([Disabled Mailbox Accounts Daily])), 'Date'[Date])
		formatString: yyyy-MM-dd
		displayFolder: Daily Trends
		lineageTag: 1dc02e40-0795-4ffe-9d35-f6b02a363e65

	measure 'Last Fully Measured Mailbox Day' = MAXX(FILTER(ALLSELECTED('Date'[Date]), NOT ISBLANK([Total Mailboxes Daily]) && NOT ISBLANK([On-premises Mailboxes Daily]) && NOT ISBLANK([Exchange Online Remote Daily]) && NOT ISBLANK([Enabled Mailbox Accounts Daily]) && NOT ISBLANK([Disabled Mailbox Accounts Daily]) && NOT ISBLANK([Local Mailbox Size GB Daily]) && NOT ISBLANK([Equipment Mailboxes Daily]) && NOT ISBLANK([Remote Shared Mailboxes Daily]) && NOT ISBLANK([Remote User Mailboxes Daily]) && NOT ISBLANK([Room Mailboxes Daily]) && NOT ISBLANK([Shared Mailboxes Daily]) && NOT ISBLANK([User Mailboxes Daily])), 'Date'[Date])
		formatString: yyyy-MM-dd
		displayFolder: Daily Trends
		lineageTag: cad7f1a3-cee8-4c67-b8df-f361ddf0dc83

	measure 'Mailbox Partial Days' = CALCULATE(DISTINCTCOUNT('Daily Mailbox Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), 'Daily Mailbox Trends'[Source Name] = "Exchange On-premises", 'Daily Mailbox Trends'[Domain Key] = "__all__", 'Daily Mailbox Trends'[Source Day Status] = "Partial capture")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: dfe3f228-c2f6-4ec5-ab6a-984afb958699

	measure 'Mailbox Incomplete Days' = CALCULATE(DISTINCTCOUNT('Daily Mailbox Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), 'Daily Mailbox Trends'[Source Name] = "Exchange On-premises", 'Daily Mailbox Trends'[Domain Key] = "__all__", 'Daily Mailbox Trends'[Metric Status] = "Not measured")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: de411e40-51dc-4c89-838f-c45e6b171721

	measure 'Mailbox Quality Text' = "Last qualified day (core): " & FORMAT([Last Qualified Mailbox Core Day], "dd MMM yyyy") & UNICHAR(10) & "Last fully measured day: " & FORMAT([Last Fully Measured Mailbox Day], "dd MMM yyyy")
		formatString: @
		displayFolder: Daily Trends
		lineageTag: 9a487489-bae5-4f8e-93c7-8b6b50802735

	measure 'Persistent Mailbox Domain Events' = CALCULATE(DISTINCTCOUNT('Daily Mailbox Trends'[Date Key]), REMOVEFILTERS('Daily Domain'), 'Daily Mailbox Trends'[Domain Key] = "__all__", 'Daily Mailbox Trends'[Quality Event] = "Domain absent (persistent)")
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: 4db753e5-10f1-404b-8efd-8462ac15c771

	measure 'Mailbox Quality Days Tooltip' = VAR _partial = CALCULATETABLE(VALUES('Daily Mailbox Trends'[Date]), REMOVEFILTERS('Daily Domain'), 'Daily Mailbox Trends'[Source Name] = "Exchange On-premises", 'Daily Mailbox Trends'[Domain Key] = "__all__", 'Daily Mailbox Trends'[Source Day Status] = "Partial capture") VAR _incomplete = CALCULATETABLE(VALUES('Daily Mailbox Trends'[Date]), REMOVEFILTERS('Daily Domain'), 'Daily Mailbox Trends'[Source Name] = "Exchange On-premises", 'Daily Mailbox Trends'[Domain Key] = "__all__", 'Daily Mailbox Trends'[Metric Status] = "Not measured") VAR _retired = CALCULATETABLE(VALUES('Daily Mailbox Trends'[Date]), REMOVEFILTERS('Daily Domain'), 'Daily Mailbox Trends'[Source Name] = "Exchange On-premises", 'Daily Mailbox Trends'[Domain Key] = "__all__", 'Daily Mailbox Trends'[Quality Event] = "Domain absent (persistent)") RETURN "Partial capture days: " & IF(COUNTROWS(_partial)=0, "None", CONCATENATEX(_partial, FORMAT('Daily Mailbox Trends'[Date], "yyyy-MM-dd"), ", ", 'Daily Mailbox Trends'[Date], ASC)) & UNICHAR(10) & "Incomplete days: " & IF(COUNTROWS(_incomplete)=0, "None", CONCATENATEX(_incomplete, FORMAT('Daily Mailbox Trends'[Date], "yyyy-MM-dd"), ", ", 'Daily Mailbox Trends'[Date], ASC)) & UNICHAR(10) & "Persistent domain event days: " & IF(COUNTROWS(_retired)=0, "None", CONCATENATEX(_retired, FORMAT('Daily Mailbox Trends'[Date], "yyyy-MM-dd"), ", ", 'Daily Mailbox Trends'[Date], ASC))
		formatString: @
		displayFolder: Daily Trends
		lineageTag: c34a2701-72a4-43c5-9d20-94fb7327e346

	/// Display-only value extracted from [On-premises Remaining Card]; all qualification and period calculations remain in the existing card measure.
	measure 'On-premises Remaining Value Text' = VAR _text = [On-premises Remaining Card] VAR _separator = SEARCH("|", _text, 1, 0) RETURN IF(_separator = 0, _text, TRIM(LEFT(_text, _separator - 1)))
		isHidden
		displayFolder: Daily trends presentation
		lineageTag: 251981b7-b5ac-4c03-86ee-90df81c79964

	/// Display-only change extracted from [On-premises Remaining Card]; all qualification and period calculations remain in the existing card measure.
	measure 'On-premises Remaining Change Text' = VAR _text = [On-premises Remaining Card] VAR _separator = SEARCH("|", _text, 1, 0) RETURN IF(_separator = 0, BLANK(), TRIM(MID(_text, _separator + 1, LEN(_text))))
		isHidden
		displayFolder: Daily trends presentation
		lineageTag: b72d5230-63fc-41b1-816a-981fe05b515b

	/// Display-only value extracted from [Exchange Online Share Card]; all qualification and period calculations remain in the existing card measure.
	measure 'Exchange Online Share Value Text' = VAR _text = [Exchange Online Share Card] VAR _separator = SEARCH("|", _text, 1, 0) RETURN IF(_separator = 0, _text, TRIM(LEFT(_text, _separator - 1)))
		isHidden
		displayFolder: Daily trends presentation
		lineageTag: 2d5114d9-138b-468f-8532-20e9e9933a93

	/// Display-only change extracted from [Exchange Online Share Card]; all qualification and period calculations remain in the existing card measure.
	measure 'Exchange Online Share Change Text' = VAR _text = [Exchange Online Share Card] VAR _separator = SEARCH("|", _text, 1, 0) RETURN IF(_separator = 0, BLANK(), TRIM(MID(_text, _separator + 1, LEN(_text))))
		isHidden
		displayFolder: Daily trends presentation
		lineageTag: 869a5985-b7a5-4767-ae85-359d666f154a

