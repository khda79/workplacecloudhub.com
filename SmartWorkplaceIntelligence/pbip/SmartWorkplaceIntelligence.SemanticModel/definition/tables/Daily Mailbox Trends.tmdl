/// Governed daily source and domain evidence; blank metrics are not measured, not zero.
table 'Daily Mailbox Trends'
	lineageTag: 3fbe1bd6-94d9-43b2-ba27-7212a3038df4

	measure 'Total Mailboxes Daily' = VAR _days = SELECTEDVALUE('Daily Period'[Days], 0) VAR _latest = MIN(CALCULATE(MAX('Daily Mailbox Trends'[Date]), REMOVEFILTERS('Date')), MAXX(ALLSELECTED('Date'[Date]), 'Date'[Date])) VAR _date = MAX('Date'[Date]) VAR _domainSelected = ISFILTERED('Daily Domain'[Domain]) VAR _rows = CALCULATETABLE('Daily Mailbox Trends', KEEPFILTERS('Daily Mailbox Trends'[Source Name] = "Exchange On-premises"), KEEPFILTERS('Daily Mailbox Trends'[Metric Name] = "TotalMailboxCount"), KEEPFILTERS('Daily Mailbox Trends'[Source Day Status] = "Complete"), FILTER(ALL('Daily Mailbox Trends'[Domain Key]), IF(_domainSelected, 'Daily Mailbox Trends'[Domain Key] <> "__all__", 'Daily Mailbox Trends'[Domain Key] = "__all__"))) RETURN IF(_days > 0 && _date < _latest - _days + 1, BLANK(), IF(COUNTROWS(FILTER(_rows, 'Daily Mailbox Trends'[Metric Status] = "Not measured")) > 0, BLANK(), SUMX(_rows, 'Daily Mailbox Trends'[Metric Value])))
		formatString: #,0
		displayFolder: Daily Trends
		lineageTag: bca38462-3cab-48d5-9102-4097d9b1784a

