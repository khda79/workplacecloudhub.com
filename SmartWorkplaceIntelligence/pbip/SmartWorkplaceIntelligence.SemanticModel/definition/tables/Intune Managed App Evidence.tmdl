/// Governed IntuneManagedAppEvidence.csv. EvidenceKey row identity; configured reported scope only. Missing evidence is not success. Retains outside-catalog and unmatched observations.
table 'Intune Managed App Evidence'
	lineageTag: f4b7df29-0f16-4150-bc24-3f74c02bc3d4

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Managed Apps (Catalog)' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(COUNTROWS('Intune Managed App Evidence'), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: f7fa0680-3101-4fad-8fb3-20f176d880cd

	/// Count of reported observations in the collected scope only. Blank when the source group is not supplied; zero is not proof of complete coverage.
	measure 'Intune Managed Apps Not Measured' = IF(CALCULATE(COUNTROWS('Intune Operational Source Evidence'), REMOVEFILTERS('Intune Operational Source Evidence'), 'Intune Operational Source Evidence'[Source Group] = "ManagedApps", 'Intune Operational Source Evidence'[Availability] = "Receipt and files verified") > 0, COALESCE(CALCULATE(COUNTROWS('Intune Managed App Evidence'), KEEPFILTERS('Intune Managed App Evidence'[Measurement State] = "Not measured")), 0), BLANK())
		formatString: #,##0
		displayFolder: Intune | Reported scope
		lineageTag: 34874e9e-2ad4-4432-a33a-789046f2e47e

