	/// Year of the qualified BIOS date from the imported LocalSystem observation. Missing or erroneous dates stay Unknown. BIOS date is not device purchase age or a security-health assessment.
	column 'BIOS Year' =
			VAR _raw = TRIM('Device System Evidence'[BIOS Date])
			VAR _year = IFERROR(VALUE(LEFT(_raw, 4)), BLANK())
			RETURN IF('Device System Evidence'[BIOS Date Quality] = "Observed date; not a health verdict" && LEN(_raw) = 10 && MID(_raw, 5, 1) = "-" && MID(_raw, 8, 1) = "-" && NOT ISBLANK(_year), FORMAT(_year, "0000"), "Unknown")
		dataType: string
		lineageTag: c01ab4a8-408b-455d-91da-9eb4cd671a6d
		summarizeBy: none

	/// System evidence belongs to the observed managed-device population.
	column 'Intune presence' = "In Intune"
		dataType: string
		lineageTag: 01588739-cf47-49a2-a372-86a36d09656b
		summarizeBy: none

	/// Private report scope. Exact unique native identity and one loaded batch; no UPN suffix or display-name inference. Blank when missing or ambiguous.
	column 'AD Domain' =
			VAR _batch = 'Device System Evidence'[Loaded Batch ID]
			VAR _tenant = 'Device System Evidence'[TenantKey]
			VAR _id = 'Device System Evidence'[Device Source ID]
			VAR _rows = FILTER(ALL('Device Exploration Inventory'), 'Device Exploration Inventory'[TenantKey] == _tenant && 'Device Exploration Inventory'[Device Source ID] == _id && 'Device Exploration Inventory'[Loaded Batch ID] == _batch)
			RETURN IF(NOT ISBLANK(_batch) && NOT ISBLANK(_id) && COUNTROWS(_rows) = 1, MAXX(_rows, 'Device Exploration Inventory'[AD Domain]))
		dataType: string
		displayFolder: Report scope
		lineageTag: 5842745d-1bca-40ac-bef1-32f2b5b63df3
		summarizeBy: none

	/// Observed primary user, exact source ID and tenant/batch matching only; used by the report search.
	column 'Primary User (report)' =
			VAR _t='Device System Evidence'[TenantKey]
			VAR _b='Device System Evidence'[Loaded Batch ID]
			VAR _gkey='Device System Evidence'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device System Evidence'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device System Evidence'[Device Source ID]))
			VAR _upn=COALESCE('Device System Evidence'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			RETURN IF(ISBLANK(_upn)||TRIM(_upn)="","Not resolved",_upn)
		dataType: string
		displayFolder: Report identity context
		lineageTag: 944a9bcd-c200-46be-a151-ead1bddfd37f

	/// Qualified SAM of the primary user; never inferred from UPN text.
	column 'Primary User SAM (report)' =
			VAR _t='Device System Evidence'[TenantKey]
			VAR _b='Device System Evidence'[Loaded Batch ID]
			VAR _gkey='Device System Evidence'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device System Evidence'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device System Evidence'[Device Source ID]))
			VAR _upn=COALESCE('Device System Evidence'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			VAR _sam=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User SAM],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_sam,IF(NOT ISBLANK(_upn),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[UserPrincipalName],_upn,'Native User Evidence'[TenantKey],_t,'Native User Evidence'[Loaded Batch ID],_b,BLANK())),"Not resolved")
		dataType: string
		displayFolder: Report identity context
		lineageTag: 8c4dd99e-e39f-44c8-8792-942abd12b2dc

	partition 'Device System Evidence' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Source = ReadMigrationCsv(GetPreparedEvidenceFile("DeviceSystemEvidence.csv"), {"TenantKey", "Device System Key", "Device Source ID", "Device Name", "Azure AD Device ID", "Primary User UPN", "Country", "Country Basis", "Inventory Match", "Prepared Inventory Match", "Observation Raw", "Observation UTC", "Observation Time Basis", "Observation Age Hours", "Freshness", "Freshness Max Age Hours", "Prepared UTC", "Secure Boot State", "Secure Boot Raw", "BIOS Version", "BIOS Date", "BIOS Date Quality", "Firmware Type", "Firmware Raw", "Last Boot Time", "Last Boot Quality", "Local Encryption State", "Inventory Encryption State", "Encryption Comparison", "VBS State", "VBS Raw", "VBS Hardware Requirements", "VBS Hardware Raw", "Credential Guard State", "Credential Guard Raw", "Management State", "Management Raw", "Compliance State", "Compliance Raw", "Inventory Compliance State", "Compliance Comparison", "Last Sync Raw", "Last Sync UTC", "Last Sync Time Basis", "Third Party AV State", "Third Party AV Raw", "Third Party AV Products", "Expected AV Name", "Expected AV State", "Expected AV Raw", "AV Qualification", "AV Comparison", "Windows Update Reboot Required", "Windows Update Reboot Raw", "BitLocker OS Protection", "BitLocker OS Protection Raw", "BitLocker OS Conversion", "BitLocker OS Conversion Raw", "Data Quality Issues"}),
				    OptionalNames = {"Local Data Source", "Local Data Freshness", "Last Console Logon Status", "Last Console Logon User", "Last Console Logon UTC", "Last Console Logon Quality", "Last Console Logon SID"},
				    Compatible = List.Accumulate(OptionalNames, Source, (t, n) => if Table.HasColumns(t, n) then t else Table.AddColumn(t, n, each if n = "Local Data Source" then "LegacyPlatformScript" else if n = "Local Data Freshness" then "Not reported" else if n = "Last Console Logon Status" then "NotCollected" else null, type nullable text)),
				    Selected = Table.SelectColumns(Compatible, {"TenantKey", "Device System Key", "Device Source ID", "Device Name", "Azure AD Device ID", "Primary User UPN", "Country", "Country Basis", "Inventory Match", "Prepared Inventory Match", "Observation Raw", "Observation UTC", "Observation Time Basis", "Observation Age Hours", "Freshness", "Freshness Max Age Hours", "Prepared UTC", "Secure Boot State", "Secure Boot Raw", "BIOS Version", "BIOS Date", "BIOS Date Quality", "Firmware Type", "Firmware Raw", "Last Boot Time", "Last Boot Quality", "Local Encryption State", "Inventory Encryption State", "Encryption Comparison", "VBS State", "VBS Raw", "VBS Hardware Requirements", "VBS Hardware Raw", "Credential Guard State", "Credential Guard Raw", "Management State", "Management Raw", "Compliance State", "Compliance Raw", "Inventory Compliance State", "Compliance Comparison", "Last Sync Raw", "Last Sync UTC", "Last Sync Time Basis", "Third Party AV State", "Third Party AV Raw", "Third Party AV Products", "Expected AV Name", "Expected AV State", "Expected AV Raw", "AV Qualification", "AV Comparison", "Windows Update Reboot Required", "Windows Update Reboot Raw", "BitLocker OS Protection", "BitLocker OS Protection Raw", "BitLocker OS Conversion", "BitLocker OS Conversion Raw", "Data Quality Issues", "Local Data Source", "Local Data Freshness", "Last Console Logon Status", "Last Console Logon User", "Last Console Logon UTC", "Last Console Logon Quality", "Last Console Logon SID"}),
				    ParseUtc = (raw as nullable text) as nullable datetime => if raw = null or Text.Trim(raw) = "" then null else if not Text.EndsWith(raw, "Z") then error "Prepared Device System UTC timestamp must have an explicit Z suffix" else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(raw, [Culture="en-US"]), 0)),
				    TypedDates = Table.TransformColumns(Selected, {{"Observation UTC", ParseUtc, type nullable datetime}, {"Prepared UTC", ParseUtc, type nullable datetime}, {"Last Sync UTC", ParseUtc, type nullable datetime}, {"Last Console Logon UTC", ParseUtc, type nullable datetime}}),
				    TypedNumbers = Table.TransformColumns(TypedDates, {{"Observation Age Hours", each if _ = null or Text.Trim(_) = "" then null else Number.FromText(_, "en-US"), type nullable number}, {"Freshness Max Age Hours", each if _ = null or Text.Trim(_) = "" then null else Number.FromText(_, "en-US"), type nullable number}}),
				    Typed = Table.TransformColumnTypes(TypedNumbers, {{"TenantKey", type text}, {"Device System Key", type text}, {"Device Source ID", type text}, {"Device Name", type text}, {"Azure AD Device ID", type text}, {"Primary User UPN", type text}, {"Country", type text}, {"Country Basis", type text}, {"Inventory Match", type text}, {"Prepared Inventory Match", type text}, {"Observation Raw", type text}, {"Observation Time Basis", type text}, {"Freshness", type text}, {"Secure Boot State", type text}, {"Secure Boot Raw", type text}, {"BIOS Version", type text}, {"BIOS Date", type text}, {"BIOS Date Quality", type text}, {"Firmware Type", type text}, {"Firmware Raw", type text}, {"Last Boot Time", type text}, {"Last Boot Quality", type text}, {"Local Encryption State", type text}, {"Inventory Encryption State", type text}, {"Encryption Comparison", type text}, {"VBS State", type text}, {"VBS Raw", type text}, {"VBS Hardware Requirements", type text}, {"VBS Hardware Raw", type text}, {"Credential Guard State", type text}, {"Credential Guard Raw", type text}, {"Management State", type text}, {"Management Raw", type text}, {"Compliance State", type text}, {"Compliance Raw", type text}, {"Inventory Compliance State", type text}, {"Compliance Comparison", type text}, {"Last Sync Raw", type text}, {"Last Sync Time Basis", type text}, {"Third Party AV State", type text}, {"Third Party AV Raw", type text}, {"Third Party AV Products", type text}, {"Expected AV Name", type text}, {"Expected AV State", type text}, {"Expected AV Raw", type text}, {"AV Qualification", type text}, {"AV Comparison", type text}, {"Windows Update Reboot Required", type text}, {"Windows Update Reboot Raw", type text}, {"BitLocker OS Protection", type text}, {"BitLocker OS Protection Raw", type text}, {"BitLocker OS Conversion", type text}, {"BitLocker OS Conversion Raw", type text}, {"Data Quality Issues", type text}, {"Local Data Source", type text}, {"Local Data Freshness", type text}, {"Last Console Logon Status", type text}, {"Last Console Logon User", type text}, {"Last Console Logon Quality", type text}, {"Last Console Logon SID", type text}})
				in Typed)
				in
				    Readers[Finish](BusinessRows)

	annotation PBI_ResultType = Exception
