/// Prepared tenant-aware Windows Device System observations at one tenant/device identity per snapshot. Country derives from the unique primary-user CountryOrRegion. Includes unmatched observations. PlatformScriptLastUpdate freshness, missingness and contradictory states are explicit; Windows registration does not prove EDR health or BitLocker key escrow.
table 'Device System Evidence'
	lineageTag: a284d322-eda3-4fad-bdaa-615f03c2f099

	/// Unique tenant/device identities in the prepared LocalSystem source, including 12 observations unmatched to the older prepared inventory at the audited checkpoint. Not the full AD + Intune estate.
	measure 'Device System Observations' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((COALESCE(DISTINCTCOUNT('Device System Evidence'[Device System Key]), 0)),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(COALESCE(DISTINCTCOUNT('Device System Evidence'[Device System Key]), 0)))
		formatString: #,##0
		displayFolder: Device System
		lineageTag: 15bec58d-37a8-4dce-b738-79c3bec25fb1

	/// Reported Windows registration state for the configured antivirus product. Does not prove EDR presence, health, or current coverage. Missing, unknown and error states are separate.
	measure 'Expected AV Detected' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Expected AV State] = "Detected"))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Expected AV State] = "Detected"))))
		formatString: #,##0
		displayFolder: Device System\Antivirus
		lineageTag: 0f719ced-5dfd-4dfe-a639-1475aa96b4c1

	/// Reported Windows registration state for the configured antivirus product. Does not prove EDR presence, health, or current coverage. Missing, unknown and error states are separate.
	measure 'Expected AV NotDetected' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Expected AV State] = "NotDetected"))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Expected AV State] = "NotDetected"))))
		formatString: #,##0
		displayFolder: Device System\Antivirus
		lineageTag: c1f47424-a318-4709-a96d-67d13ed20d1f

	/// Reported Windows registration state for the configured antivirus product. Does not prove EDR presence, health, or current coverage. Missing, unknown and error states are separate.
	measure 'Expected AV NotCollected' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Expected AV State] = "NotCollected"))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Expected AV State] = "NotCollected"))))
		formatString: #,##0
		displayFolder: Device System\Antivirus
		lineageTag: 310cd960-ad58-4115-9907-19fb5e70f28a

	/// Configured product and a comparable Detected/NotDetected registration state without conflicting evidence. Observation freshness is qualified separately.
	measure 'Expected AV Evaluable Observations' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[AV Qualification] = "Evaluable registration observation"))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[AV Qualification] = "Evaluable registration observation"))))
		formatString: #,##0
		displayFolder: Device System\Antivirus
		lineageTag: ae583d03-c6b0-4757-8e0d-1c930e9879c3

	/// Evaluable Windows registration observations divided by all LocalSystem observations in the same filters. Never a detected-EDR coverage percentage for the whole AD + Intune estate.
	measure 'Expected AV Evaluable Share (%)' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((DIVIDE([Expected AV Evaluable Observations], [Device System Observations])),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(DIVIDE([Expected AV Evaluable Observations], [Device System Observations])))
		formatString: 0.0%
		displayFolder: Device System\Antivirus
		lineageTag: 80c27012-8aba-4b45-a123-0fae13acab08

	/// Product label derived only from prepared Expected AV Name; no tenant-specific product is hardcoded.
	measure 'Expected Antivirus Product' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _names = FILTER(VALUES('Device System Evidence'[Expected AV Name]), NOT ISBLANK('Device System Evidence'[Expected AV Name]) && 'Device System Evidence'[Expected AV Name] <> "")
			RETURN IF(COUNTROWS(_names) = 0, "Not configured", IF(COUNTROWS(_names) = 1, MAXX(_names, 'Device System Evidence'[Expected AV Name]), "Multiple configured products"))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(VAR _names = FILTER(VALUES('Device System Evidence'[Expected AV Name]), NOT ISBLANK('Device System Evidence'[Expected AV Name]) && 'Device System Evidence'[Expected AV Name] <> "")
			RETURN IF(COUNTROWS(_names) = 0, "Not configured", IF(COUNTROWS(_names) = 1, MAXX(_names, 'Device System Evidence'[Expected AV Name]), "Multiple configured products"))))
		displayFolder: Device System\Antivirus
		lineageTag: a37184a0-5041-4815-81fc-adcb841f9588

	/// PlatformScriptLastUpdate parsed using an explicit offset or verified configured timezone and age no greater than the configured limit, evaluated at query UTC. Unknown timezone or absent policy never counts as fresh.
	measure 'Device System Fresh Observations' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _now = UTCNOW()
			RETURN COALESCE(COUNTROWS(FILTER('Device System Evidence', NOT ISBLANK('Device System Evidence'[Observation UTC]) && NOT ISBLANK('Device System Evidence'[Freshness Max Age Hours]) && 'Device System Evidence'[Freshness Max Age Hours] > 0 && 'Device System Evidence'[Observation UTC] <= _now && (_now - 'Device System Evidence'[Observation UTC]) * 24 <= 'Device System Evidence'[Freshness Max Age Hours])), 0)),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(VAR _now = UTCNOW()
			RETURN COALESCE(COUNTROWS(FILTER('Device System Evidence', NOT ISBLANK('Device System Evidence'[Observation UTC]) && NOT ISBLANK('Device System Evidence'[Freshness Max Age Hours]) && 'Device System Evidence'[Freshness Max Age Hours] > 0 && 'Device System Evidence'[Observation UTC] <= _now && (_now - 'Device System Evidence'[Observation UTC]) * 24 <= 'Device System Evidence'[Freshness Max Age Hours])), 0)))
		formatString: #,##0
		displayFolder: Device System
		lineageTag: 07e740e7-7c9a-4c53-9312-002d5dd7bb6f

	/// Missing, invalid or offsetless unqualified observation time. Not an adverse device state.
	measure 'Device System Unqualified Time Observations' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Device System Observations], KEEPFILTERS(ISBLANK('Device System Evidence'[Observation UTC])))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(CALCULATE([Device System Observations], KEEPFILTERS(ISBLANK('Device System Evidence'[Observation UTC])))))
		formatString: #,##0
		displayFolder: Device System\Data quality
		lineageTag: 759de4a8-1766-4788-84f6-d6db4b268945

	/// Contradictory local, Intune inventory, or OS BitLocker conversion observations. Does not prove an unencrypted device and does not modify the existing Intune encryption KPI.
	measure 'Device System Encryption Conflicts' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Encryption Comparison] = "Conflict"))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Encryption Comparison] = "Conflict"))))
		formatString: #,##0
		displayFolder: Device System\Data quality
		lineageTag: c10cfb11-0c7a-4567-b9a5-41dcb1b85e90

	/// LocalSystem device identities absent from the older prepared Device Inventory export; retained in this source, not silently dropped.
	measure 'Device System Prepared Inventory Unmatched' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Prepared Inventory Match] = "Unmatched"))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(CALCULATE([Device System Observations], KEEPFILTERS('Device System Evidence'[Prepared Inventory Match] = "Unmatched"))))
		formatString: #,##0
		displayFolder: Device System\Data quality
		lineageTag: c464c17d-4a98-46a1-bce6-f433b17dfbd2

	/// Scope and freshness tooltip shared by the new Device System views.
	measure 'Device System Evidence Scope' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE(("Windows registration observations; no proof of EDR health or BitLocker recovery-key escrow. Freshness uses PlatformScriptLastUpdate, not preparation time. " & FORMAT([Device System Fresh Observations], "#,##0") & " observations meet configured age/time qualification; " & FORMAT([Device System Unqualified Time Observations], "#,##0") & " have no qualified UTC observation time. Graph inventory fields do not prove per-field measurement time. Last boot aliases are consolidated into one value."),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),("Windows registration observations; no proof of EDR health or BitLocker recovery-key escrow. Freshness uses PlatformScriptLastUpdate, not preparation time. " & FORMAT([Device System Fresh Observations], "#,##0") & " observations meet configured age/time qualification; " & FORMAT([Device System Unqualified Time Observations], "#,##0") & " have no qualified UTC observation time. Graph inventory fields do not prove per-field measurement time. Last boot aliases are consolidated into one value."))
		displayFolder: Device System\Evidence scope
		lineageTag: e7c0b61c-4274-4824-9b3f-03ceef200926

	/// Prepared BIOS Version, exposed only for one unique Intune source ID in the existing inventory and a single tenant. No name matching; missing and ambiguous joins are explicit. Reported states retain their source qualification; freshness is separate.
	measure 'Device System BIOS Version' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _id = SELECTEDVALUE('Device Inventory Evidence'[Device Source ID])
			VAR _tenants = CALCULATE(DISTINCTCOUNT('Device System Evidence'[TenantKey]), REMOVEFILTERS('Device System Evidence'), REMOVEFILTERS('Country Selection'))
			VAR _matches = CALCULATE(COUNTROWS('Device System Evidence'), REMOVEFILTERS('Device System Evidence'), REMOVEFILTERS('Country Selection'), TREATAS({_id}, 'Device System Evidence'[Device Source ID]))
			VAR _value = CALCULATE(SELECTEDVALUE('Device System Evidence'[BIOS Version]), REMOVEFILTERS('Device System Evidence'), REMOVEFILTERS('Country Selection'), TREATAS({_id}, 'Device System Evidence'[Device Source ID]))
			RETURN IF(ISBLANK(_id), BLANK(), SWITCH(TRUE(), _tenants <> 1, "Ambiguous tenant scope", _matches = 0, "Missing observation", _matches <> 1, "Ambiguous device identity", ISBLANK(_value) || _value = "", "Missing", _value))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(VAR _id = SELECTEDVALUE('Device Inventory Evidence'[Device Source ID])
			VAR _tenants = CALCULATE(DISTINCTCOUNT('Device System Evidence'[TenantKey]), REMOVEFILTERS('Device System Evidence'), REMOVEFILTERS('Country Selection'))
			VAR _matches = CALCULATE(COUNTROWS('Device System Evidence'), REMOVEFILTERS('Device System Evidence'), REMOVEFILTERS('Country Selection'), TREATAS({_id}, 'Device System Evidence'[Device Source ID]))
			VAR _value = CALCULATE(SELECTEDVALUE('Device System Evidence'[BIOS Version]), REMOVEFILTERS('Device System Evidence'), REMOVEFILTERS('Country Selection'), TREATAS({_id}, 'Device System Evidence'[Device Source ID]))
			RETURN IF(ISBLANK(_id), BLANK(), SWITCH(TRUE(), _tenants <> 1, "Ambiguous tenant scope", _matches = 0, "Missing observation", _matches <> 1, "Ambiguous device identity", ISBLANK(_value) || _value = "", "Missing", _value))))
		displayFolder: Device System\Matched device detail
		lineageTag: cbe9f44d-f194-4ac1-8736-809d5853013b

