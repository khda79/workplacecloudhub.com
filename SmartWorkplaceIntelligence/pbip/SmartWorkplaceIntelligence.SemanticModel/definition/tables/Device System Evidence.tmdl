	/// Distinct currently loaded device observation keys; Country and AD Domain scope retained. Registration observations do not prove active protection.
	measure 'Security AV Observed Devices' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _countries=VALUES('Country Selection'[Source Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _hasDomain=ISFILTERED('Daily Domain')
			RETURN CALCULATE(DISTINCTCOUNT('Device System Evidence'[Device System Key]),
			KEEPFILTERS(TREATAS(_countries,'Device System Evidence'[Country])),
			FILTER(VALUES('Device System Evidence'[AD Domain]),NOT _hasDomain || 'Device System Evidence'[AD Domain] IN _domains))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(VAR _countries=VALUES('Country Selection'[Source Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _hasDomain=ISFILTERED('Daily Domain')
			RETURN CALCULATE(DISTINCTCOUNT('Device System Evidence'[Device System Key]),
			KEEPFILTERS(TREATAS(_countries,'Device System Evidence'[Country])),
			FILTER(VALUES('Device System Evidence'[AD Domain]),NOT _hasDomain || 'Device System Evidence'[AD Domain] IN _domains))))
