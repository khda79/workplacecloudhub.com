	/// SAM display resolved by qualified native identity, same tenant and loaded batch. Empty text when no qualified SAM; preserves unresolved source rows in table projections.
	measure 'SAM · Device System Evidence' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _display = (VAR _id=SELECTEDVALUE('Device System Evidence'[Device Source ID]) VAR _tenant=SELECTEDVALUE('Device System Evidence'[TenantKey]) VAR _batch=SELECTEDVALUE('Device System Evidence'[Loaded Batch ID])
			 VAR _dk=IF(NOT ISBLANK(_id),LOOKUPVALUE('Native Managed Device Evidence'[TenantDeviceKey],'Native Managed Device Evidence'[ManagedDeviceId],_id,'Native Managed Device Evidence'[TenantKey],_tenant,'Native Managed Device Evidence'[Loaded Batch ID],_batch))
			 VAR _uid=IF(NOT ISBLANK(_dk),LOOKUPVALUE('Native Device Evidence'[PrimaryUserSourceId],'Native Device Evidence'[TenantDeviceKey],_dk,'Native Device Evidence'[TenantKey],_tenant,'Native Device Evidence'[Loaded Batch ID],_batch))
			 VAR _upn=IF(NOT ISBLANK(_uid),LOOKUPVALUE('Native User Evidence'[UserPrincipalName],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))
			 RETURN IF(NOT ISBLANK(_uid) && _upn=SELECTEDVALUE('Device System Evidence'[Primary User UPN]),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))) RETURN IF(COUNTROWS('Device System Evidence') > 0, COALESCE(_display, ""))),KEEPFILTERS(TREATAS(_pu,'Device System Evidence'[Primary User (report)]))),(VAR _display = (VAR _id=SELECTEDVALUE('Device System Evidence'[Device Source ID]) VAR _tenant=SELECTEDVALUE('Device System Evidence'[TenantKey]) VAR _batch=SELECTEDVALUE('Device System Evidence'[Loaded Batch ID])
			 VAR _dk=IF(NOT ISBLANK(_id),LOOKUPVALUE('Native Managed Device Evidence'[TenantDeviceKey],'Native Managed Device Evidence'[ManagedDeviceId],_id,'Native Managed Device Evidence'[TenantKey],_tenant,'Native Managed Device Evidence'[Loaded Batch ID],_batch))
			 VAR _uid=IF(NOT ISBLANK(_dk),LOOKUPVALUE('Native Device Evidence'[PrimaryUserSourceId],'Native Device Evidence'[TenantDeviceKey],_dk,'Native Device Evidence'[TenantKey],_tenant,'Native Device Evidence'[Loaded Batch ID],_batch))
			 VAR _upn=IF(NOT ISBLANK(_uid),LOOKUPVALUE('Native User Evidence'[UserPrincipalName],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))
			 RETURN IF(NOT ISBLANK(_uid) && _upn=SELECTEDVALUE('Device System Evidence'[Primary User UPN]),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))) RETURN IF(COUNTROWS('Device System Evidence') > 0, COALESCE(_display, ""))))
		displayFolder: Private identity display
		lineageTag: ebebcc3d-5b07-423a-84a7-6727b504acf1

