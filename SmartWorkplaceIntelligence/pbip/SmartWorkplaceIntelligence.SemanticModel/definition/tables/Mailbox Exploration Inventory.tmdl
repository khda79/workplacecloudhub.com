/// Observed EXO and local mailboxes enriched only from same prepared batch and unique native identities. Remote AD recipient stubs excluded. Missing optional artifacts remain Not collected; explicit stats timestamp only.
table 'Mailbox Exploration Inventory'
	lineageTag: e8cccd72-e29d-42a1-ab4e-fe5ca953649e

	/// Distinct observed native mailbox identities (EXO + local on-prem), all recipient types. Remote AD recipient stubs excluded; filters apply. Unresolved native identities retain their distinct source inventory key and are qualified.
	measure 'All Mailboxes' = [Mailboxes]
		formatString: #,0
		lineageTag: 910e6df2-aa8b-48cf-b989-e7c9636f2c1d

	measure 'Mailbox Selection For Delegates' = IF(HASONEVALUE('Mailbox Exploration Inventory'[Mailbox Key]),1,0)
		formatString: 0
		lineageTag: 3b39c0cb-67c9-4f40-aeb2-ce356c74b7b6

	measure 'Mailbox Scope Explanation' = "Observed EXO + local mailbox inventory. Remote recipient stubs are excluded. Country and AD Domain use native identities in one prepared batch; missing or ambiguous identity remains unattributed. Stats collection time is shown only if explicitly supplied; export time is separate. Select one mailbox for readable delegation rows."
		lineageTag: 925e9279-975c-4d99-9025-0b45db065144

	measure 'Selected Mailbox Statistics Collection' = IF(NOT HASONEVALUE('Mailbox Exploration Inventory'[Mailbox Key]),"Select one mailbox to read delegation details and statistics provenance", "Statistics collection UTC: " & COALESCE(SELECTEDVALUE('Mailbox Exploration Inventory'[Stats Collected UTC]),"Not supplied by source") & UNICHAR(10) & "Source: " & COALESCE(SELECTEDVALUE('Mailbox Exploration Inventory'[Stats Source]),"Unknown") & " | Export UTC (separate): " & COALESCE(SELECTEDVALUE('Mailbox Exploration Inventory'[Export Collected UTC]),"Not supplied"))
		lineageTag: aec5ce55-3e70-4a5f-b926-16fc8506d93a

