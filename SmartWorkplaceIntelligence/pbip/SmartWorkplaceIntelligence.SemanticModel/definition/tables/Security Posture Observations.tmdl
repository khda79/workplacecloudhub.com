	partition 'Security Posture Observations Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Date Key" = Int64.Type, #"Tenant Key" = Int64.Type, #"Environment Key" = Int64.Type, #"Service Key" = Int64.Type, #"Control Name" = nullable text, #"Security Domain" = nullable text, #"Severity Label" = nullable text, #"Evidence Status" = nullable text, #"Observed Score" = nullable number, #"Maximum Score" = nullable number, #"Gap State" = nullable text], {
				        {20260915, 1, 1, 1, "Multifactor Authentication Coverage", "Identity", "Critical", "Observed", 18, 20, "Gap"},
				        {20260915, 1, 1, 3, "Device Compliance Enforcement", "DeviceManagement", "High", "Observed", 14, 20, "Gap"},
				        {20260915, 1, 1, 12, "External Sharing Governance", "Collaboration", "Medium", "Observed", 17, 20, "Compliant"},
