/// Synthetic governed security control observations.
table 'Security Posture Observations'
	lineageTag: 77b5eb03-12b8-4444-987d-2b21eaa3f294

	/// Observed secure score divided by the qualified maximum score.
	measure 'Secure Score (%)' = DIVIDE(CALCULATE(SUM('Security Posture Observations'[Observed Score]), KEEPFILTERS('Security Posture Observations'[Evidence Status] = "Observed")), CALCULATE(SUM('Security Posture Observations'[Maximum Score]), KEEPFILTERS('Security Posture Observations'[Evidence Status] = "Observed")))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: 17dfc0f1-4319-4699-a226-b3ebf59e3685

	/// Governed controls with qualified observations.
	measure 'Security Evidence Coverage (%)' = DIVIDE(CALCULATE(COUNTROWS('Security Posture Observations'), KEEPFILTERS('Security Posture Observations'[Evidence Status] = "Observed")), COUNTROWS('Security Posture Observations'))
		formatString: 0.0%
		displayFolder: Measures
		lineageTag: fba97d27-e0af-4eb2-a968-df1aea68695d

	/// Governed controls with an actionable qualified gap.
	measure '# Security Gaps' = CALCULATE(COUNTROWS('Security Posture Observations'), KEEPFILTERS('Security Posture Observations'[Evidence Status] = "Observed"), KEEPFILTERS('Security Posture Observations'[Gap State] = "Gap"))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 091a2603-6664-4cb8-8eba-c09d2fecac23

	/// Total governed security controls in the current filter context.
	measure '# Security Controls' = COUNTROWS ( 'Security Posture Observations' )
		formatString: #,##0
		displayFolder: Security Coverage
		lineageTag: 0f28dbf5-5b3e-4705-97ca-8ec15842582a

	/// Governed security controls with observed and decision-qualified evidence.
	measure '# Observed Security Controls' = CALCULATE ( [# Security Controls], KEEPFILTERS ( 'Security Posture Observations'[Evidence Status] = "Observed" ) )
		formatString: #,##0
		displayFolder: Security Coverage
		lineageTag: cf610322-03eb-4616-a576-a0fedc8e2646

	/// Governed security controls whose evidence is missing, unavailable, or not collected.
	measure '# Security Controls Without Evidence' = CALCULATE ( [# Security Controls], KEEPFILTERS ( 'Security Posture Observations'[Evidence Status] IN { "Not Collected", "Source Error", "Unknown" } ) )
		formatString: #,##0
		displayFolder: Security Coverage
		lineageTag: 015b7598-10bb-4abb-984c-d7d826608e5b

	/// Business attribute Date Key.
	column 'Date Key'
