	/// Preserves existing Intune-row lifecycle evidence through one tenant-aware same-batch source identity; AD-only Entra evidence stays blank.
	column 'AD Password Expired' =
			VAR _tenant = 'Device Exploration Inventory'[TenantKey]
			VAR _source = 'Device Exploration Inventory'[Device Source ID]
			VAR _batch = 'Device Exploration Inventory'[Loaded Batch ID]
			VAR _rows = FILTER(ALLNOBLANKROW('Device Inventory Evidence'), 'Device Inventory Evidence'[TenantKey] == _tenant && 'Device Inventory Evidence'[Device Source ID] == _source && 'Device Inventory Evidence'[Loaded Batch ID] == _batch)
			RETURN IF(NOT ISBLANK(_source) && _source <> "" && COUNTROWS(_rows)=1, MAXX(_rows, 'Device Inventory Evidence'[AD Password Expired]))
		dataType: string
