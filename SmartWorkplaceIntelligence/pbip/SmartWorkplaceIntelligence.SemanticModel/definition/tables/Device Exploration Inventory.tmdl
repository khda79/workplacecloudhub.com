/// One row per Intune identity plus unmatched AD Windows workstation identity, same prepared batch. Native identity joins only; ambiguous/missing identities stay explicit. Does not change the existing Intune inventory population.
table 'Device Exploration Inventory'
	lineageTag: a1585ffe-803f-4a64-9a0d-03e86c5999e5

	/// Private device exploration. Same-batch native identities only; unknown/ambiguous matches are excluded from the confirmed not-found numerator.
	measure 'Exploration Enabled AD Windows PCs' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _countries = VALUES('Country Selection'[Source Country])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _hasDomain = ISFILTERED('Daily Domain')
			RETURN CALCULATE(COUNTROWS('Device Exploration Inventory'),
			    'Device Exploration Inventory'[AD Enabled] = "Yes",
			    'Device Exploration Inventory'[AD Windows PC] = "Yes",
			    KEEPFILTERS(TREATAS(_countries, 'Device Exploration Inventory'[Country])),
			    FILTER(VALUES('Device Exploration Inventory'[AD Domain]), NOT _hasDomain || 'Device Exploration Inventory'[AD Domain] IN _domains))),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _countries = VALUES('Country Selection'[Source Country])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _hasDomain = ISFILTERED('Daily Domain')
			RETURN CALCULATE(COUNTROWS('Device Exploration Inventory'),
			    'Device Exploration Inventory'[AD Enabled] = "Yes",
			    'Device Exploration Inventory'[AD Windows PC] = "Yes",
			    KEEPFILTERS(TREATAS(_countries, 'Device Exploration Inventory'[Country])),
			    FILTER(VALUES('Device Exploration Inventory'[AD Domain]), NOT _hasDomain || 'Device Exploration Inventory'[AD Domain] IN _domains))))
		formatString: #,0
		displayFolder: Private exploration
		lineageTag: 28165976-85fc-4dd8-8c51-8f58e1fc70de

	/// Private device exploration. Same-batch native identities only; unknown/ambiguous matches are excluded from the confirmed not-found numerator.
	measure 'Enabled AD Windows PCs Not Found in Intune' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Exploration Enabled AD Windows PCs], KEEPFILTERS('Device Exploration Inventory'[Intune presence] = "Not found in Intune"))),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(CALCULATE([Exploration Enabled AD Windows PCs], KEEPFILTERS('Device Exploration Inventory'[Intune presence] = "Not found in Intune"))))
		formatString: #,0
		displayFolder: Private exploration
		lineageTag: 6c2e4d76-5f0d-4a42-a09c-1c028ff8127c

	/// Private device exploration. Same-batch native identities only; unknown/ambiguous matches are excluded from the confirmed not-found numerator.
	measure 'Exploration AD Coverage Denominator' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Exploration Enabled AD Windows PCs], REMOVEFILTERS('Intune Presence Selection'))),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(CALCULATE([Exploration Enabled AD Windows PCs], REMOVEFILTERS('Intune Presence Selection'))))
		formatString: #,0
		displayFolder: Private exploration
		lineageTag: 829dda08-2351-4ebd-aa02-8a7128dd034e

	/// Private device exploration. Same-batch native identities only; unknown/ambiguous matches are excluded from the confirmed not-found numerator.
	measure 'Exploration Unresolved AD Windows PCs' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Exploration Enabled AD Windows PCs], 'Device Exploration Inventory'[Intune presence] = "Unknown / ambiguous")),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(CALCULATE([Exploration Enabled AD Windows PCs], 'Device Exploration Inventory'[Intune presence] = "Unknown / ambiguous")))
		formatString: #,0
		displayFolder: Private exploration
		lineageTag: 5b7e9819-11c1-4dd7-a38c-c2d20eee1daf

	/// Private device exploration. Same-batch native identities only; unknown/ambiguous matches are excluded from the confirmed not-found numerator.
	measure 'Device Exploration Scope' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE(("Country and AD Domain filter attributable current inventory rows and AD PC coverage. Native identity and same prepared batch only; no name merges. Unknown AD / Intune identity is not unmanaged. Security Healthy percentages are tenant-wide prepared control summaries and are not allocated by geography. Historical aggregate evidence remains global."),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),("Country and AD Domain filter attributable current inventory rows and AD PC coverage. Native identity and same prepared batch only; no name merges. Unknown AD / Intune identity is not unmanaged. Security Healthy percentages are tenant-wide prepared control summaries and are not allocated by geography. Historical aggregate evidence remains global."))
		formatString: @
		displayFolder: Private exploration
		lineageTag: c287fe58-87ae-4053-8c22-0a48befac8ea

	/// Scopes only the new inventory rows to existing Country, Domain and incoming device-name drillthrough, avoiding an ambiguous second country relationship.
	measure 'Inventory Row In Scope' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _country = SELECTEDVALUE('Device Exploration Inventory'[Country])
			VAR _domain = SELECTEDVALUE('Device Exploration Inventory'[AD Domain])
			VAR _name = SELECTEDVALUE('Device Exploration Inventory'[Device Name])
			VAR _countryOK = NOT ISFILTERED('Country Selection') || _country IN VALUES('Country Selection'[Source Country])
			VAR _domainOK = NOT ISFILTERED('Daily Domain') || _domain IN VALUES('Daily Domain'[Domain])
			VAR _drillOK = NOT ISFILTERED('Device Inventory Evidence'[Device Name]) || _name IN FILTERS('Device Inventory Evidence'[Device Name])
			RETURN IF(_countryOK && _domainOK && _drillOK,1,0)),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _country = SELECTEDVALUE('Device Exploration Inventory'[Country])
			VAR _domain = SELECTEDVALUE('Device Exploration Inventory'[AD Domain])
			VAR _name = SELECTEDVALUE('Device Exploration Inventory'[Device Name])
			VAR _countryOK = NOT ISFILTERED('Country Selection') || _country IN VALUES('Country Selection'[Source Country])
			VAR _domainOK = NOT ISFILTERED('Daily Domain') || _domain IN VALUES('Daily Domain'[Domain])
			VAR _drillOK = NOT ISFILTERED('Device Inventory Evidence'[Device Name]) || _name IN FILTERS('Device Inventory Evidence'[Device Name])
			RETURN IF(_countryOK && _domainOK && _drillOK,1,0)))
		formatString: 0
		isHidden
		lineageTag: 62f95de4-892c-4427-ad69-071eb99eb62a

	measure 'Exploration Enabled AD Windows PCs Managed' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((CALCULATE([Exploration Enabled AD Windows PCs], KEEPFILTERS('Device Exploration Inventory'[Intune presence]="In Intune"))),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(CALCULATE([Exploration Enabled AD Windows PCs], KEEPFILTERS('Device Exploration Inventory'[Intune presence]="In Intune"))))
		formatString: #,0
		lineageTag: 34d9b382-0a20-4df9-9a4e-f53dcd73acfc

	measure 'Exploration Enabled AD PCs Managed (%)' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((DIVIDE([Exploration Enabled AD Windows PCs Managed],[Exploration AD Coverage Denominator])),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(DIVIDE([Exploration Enabled AD Windows PCs Managed],[Exploration AD Coverage Denominator])))
		formatString: 0.0%
		lineageTag: 0582a100-97a8-4eea-812a-c3e13041819b

	/// Amber: confirmed AD-enabled Windows PCs absent from Intune >0 to 5% of enabled AD Windows PCs; red >5%. Unknown/ambiguous identities stay excluded from the numerator. Status codes: 0 normal, 1 attention, 2 critical, 3 unknown.
	measure 'KPI Alert Level Enabled AD Windows PCs Not Found in Intune' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _n = [Enabled AD Windows PCs Not Found in Intune]
			VAR _d = [Exploration Enabled AD Windows PCs]
			VAR _r = DIVIDE(_n,_d)
			RETURN SWITCH(TRUE(), ISBLANK(_n) || ISBLANK(_r),3, _r > 0.05,2, _r > 0,1,0)),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _n = [Enabled AD Windows PCs Not Found in Intune]
			VAR _d = [Exploration Enabled AD Windows PCs]
			VAR _r = DIVIDE(_n,_d)
			RETURN SWITCH(TRUE(), ISBLANK(_n) || ISBLANK(_r),3, _r > 0.05,2, _r > 0,1,0)))
		formatString: 0
		isHidden
		displayFolder: Presentation | KPI alerts
		lineageTag: a2272cba-7947-4205-ad77-c5da9342228f

	/// User-visible threshold explanation for Enabled AD Windows PCs Not Found in Intune
	measure 'KPI Alert Details Enabled AD Windows PCs Not Found in Intune' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _s=[KPI Alert Level Enabled AD Windows PCs Not Found in Intune] RETURN SWITCH(_s,0,"Normal",1,"Attention",2,"Critical",3,"Unknown") & " | Amber: confirmed AD-enabled Windows PCs absent from Intune >0 to 5% of enabled AD Windows PCs; red >5%. Unknown/ambiguous identities stay excluded from the numerator."),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _s=[KPI Alert Level Enabled AD Windows PCs Not Found in Intune] RETURN SWITCH(_s,0,"Normal",1,"Attention",2,"Critical",3,"Unknown") & " | Amber: confirmed AD-enabled Windows PCs absent from Intune >0 to 5% of enabled AD Windows PCs; red >5%. Unknown/ambiguous identities stay excluded from the numerator."))
		isHidden
		displayFolder: Presentation | KPI alerts
		lineageTag: d0f2e705-e31b-464f-93de-16ac9f60d688

	/// Enabled AD Windows PCs confirmed not found in Intune with a qualified machine logon in the trailing 30 days. Latest AD replicated lastLogonTimestamp or Entra approximate device sign-in; native keys and loaded batch must match. Missing/future dates, ambiguous matches, Intune sync and user activity are not evidence. Country/AD Domain scope retained.
	measure 'Enabled PCs not in Intune <30D' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _now = UTCNOW()
			VAR _countries = VALUES('Country Selection'[Source Country])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _hasDomain = ISFILTERED('Daily Domain')
			VAR _base = CALCULATETABLE(
			    FILTER('Device Exploration Inventory',
			        [AD Enabled] = "Yes" && [AD Windows PC] = "Yes" &&
			        [Intune presence] = "Not found in Intune" && LEFT([Inventory Key],3) = "ad:"),
			    KEEPFILTERS(TREATAS(_countries,'Device Exploration Inventory'[Country])),
			    FILTER(VALUES('Device Exploration Inventory'[AD Domain]),NOT _hasDomain || [AD Domain] IN _domains))
			VAR _keys = ADDCOLUMNS(_base,"__ADKey",MID([Inventory Key],4,LEN([Inventory Key])-3))
			VAR _ad = ADDCOLUMNS(_keys,
			    "__ADDate",VAR _key=[__ADKey] VAR _batch=[Loaded Batch ID]
			        RETURN LOOKUPVALUE('AD Computer Evidence'[LastLogonUtcDateTime],
			            'AD Computer Evidence'[TenantADComputerKey],_key,
			            'AD Computer Evidence'[Loaded Batch ID],_batch,
			            'AD Computer Evidence'[LastLogonStatus],"UTC from replicated AD FILETIME; approximate logon"),
			    "__CloudKey",VAR _key=[__ADKey] VAR _batch=[Loaded Batch ID]
			        RETURN LOOKUPVALUE('AD Computer Evidence'[TenantDeviceKey],
			            'AD Computer Evidence'[TenantADComputerKey],_key,
			            'AD Computer Evidence'[Loaded Batch ID],_batch))
			VAR _dates = ADDCOLUMNS(_ad,"__EntraDate",
			    VAR _key=[__CloudKey] VAR _batch=[Loaded Batch ID]
			    RETURN IF(NOT ISBLANK(_key),
			        CALCULATE(MAX('Device Source Evidence'[ActivityUtcDateTime]),
			            REMOVEFILTERS('Device Source Evidence'),
			            TREATAS({_key},'Device Source Evidence'[TenantDeviceKey]),
			            TREATAS({_batch},'Device Source Evidence'[Loaded Batch ID]),
			            'Device Source Evidence'[SourceSystem]="Entra",
			            'Device Source Evidence'[ActivityStatus]="UTC qualified",
			            'Device Source Evidence'[ActivityUtcDateTime] <= _now)))
			VAR _recent = FILTER(_dates,
			    VAR _adDate = IF([__ADDate] <= _now,[__ADDate])
			    VAR _latest = MAX(_adDate,[__EntraDate])
			    RETURN NOT ISBLANK(_latest) && _latest > _now-30 && _latest <= _now)
			RETURN IF(COUNTROWS(_base)>0,COALESCE(COUNTROWS(_recent),0))),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _now = UTCNOW()
			VAR _countries = VALUES('Country Selection'[Source Country])
			VAR _domains = VALUES('Daily Domain'[Domain])
			VAR _hasDomain = ISFILTERED('Daily Domain')
			VAR _base = CALCULATETABLE(
			    FILTER('Device Exploration Inventory',
			        [AD Enabled] = "Yes" && [AD Windows PC] = "Yes" &&
			        [Intune presence] = "Not found in Intune" && LEFT([Inventory Key],3) = "ad:"),
			    KEEPFILTERS(TREATAS(_countries,'Device Exploration Inventory'[Country])),
			    FILTER(VALUES('Device Exploration Inventory'[AD Domain]),NOT _hasDomain || [AD Domain] IN _domains))
			VAR _keys = ADDCOLUMNS(_base,"__ADKey",MID([Inventory Key],4,LEN([Inventory Key])-3))
			VAR _ad = ADDCOLUMNS(_keys,
			    "__ADDate",VAR _key=[__ADKey] VAR _batch=[Loaded Batch ID]
			        RETURN LOOKUPVALUE('AD Computer Evidence'[LastLogonUtcDateTime],
			            'AD Computer Evidence'[TenantADComputerKey],_key,
			            'AD Computer Evidence'[Loaded Batch ID],_batch,
			            'AD Computer Evidence'[LastLogonStatus],"UTC from replicated AD FILETIME; approximate logon"),
			    "__CloudKey",VAR _key=[__ADKey] VAR _batch=[Loaded Batch ID]
			        RETURN LOOKUPVALUE('AD Computer Evidence'[TenantDeviceKey],
			            'AD Computer Evidence'[TenantADComputerKey],_key,
			            'AD Computer Evidence'[Loaded Batch ID],_batch))
			VAR _dates = ADDCOLUMNS(_ad,"__EntraDate",
			    VAR _key=[__CloudKey] VAR _batch=[Loaded Batch ID]
			    RETURN IF(NOT ISBLANK(_key),
			        CALCULATE(MAX('Device Source Evidence'[ActivityUtcDateTime]),
			            REMOVEFILTERS('Device Source Evidence'),
			            TREATAS({_key},'Device Source Evidence'[TenantDeviceKey]),
			            TREATAS({_batch},'Device Source Evidence'[Loaded Batch ID]),
			            'Device Source Evidence'[SourceSystem]="Entra",
			            'Device Source Evidence'[ActivityStatus]="UTC qualified",
			            'Device Source Evidence'[ActivityUtcDateTime] <= _now)))
			VAR _recent = FILTER(_dates,
			    VAR _adDate = IF([__ADDate] <= _now,[__ADDate])
			    VAR _latest = MAX(_adDate,[__EntraDate])
			    RETURN NOT ISBLANK(_latest) && _latest > _now-30 && _latest <= _now)
			RETURN IF(COUNTROWS(_base)>0,COALESCE(COUNTROWS(_recent),0))))
		formatString: #,0
		displayFolder: Private exploration
		lineageTag: 0fcdedcd-8ffd-442f-9763-7959d2e814e0

	/// Same approved threshold and denominator as the all-age AD-not-Intune card: positive to 5% amber; above 5% red; missing evidence grey.
	measure 'KPI Alert Level Enabled PCs not in Intune <30D' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _n=[Enabled PCs not in Intune <30D]
			VAR _d=[Exploration Enabled AD Windows PCs]
			VAR _r=DIVIDE(_n,_d)
			RETURN SWITCH(TRUE(),ISBLANK(_n)||ISBLANK(_r),3,_r>0.05,2,_n>0,1,0)),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _n=[Enabled PCs not in Intune <30D]
			VAR _d=[Exploration Enabled AD Windows PCs]
			VAR _r=DIVIDE(_n,_d)
			RETURN SWITCH(TRUE(),ISBLANK(_n)||ISBLANK(_r),3,_r>0.05,2,_n>0,1,0)))
		formatString: 0
		isHidden
		displayFolder: Presentation | KPI alerts
		lineageTag: 18315c1b-923f-4e85-8c0c-dad8f28e52ef

	measure 'KPI Alert Details Enabled PCs not in Intune <30D' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _s=[KPI Alert Level Enabled PCs not in Intune <30D]
			RETURN SWITCH(_s,0,"Normal",1,"Attention",2,"Critical","Unknown") & " | Enabled AD Windows PCs absent from Intune with AD/Entra machine sign-in <30D. Most recent qualified native date; same batch. Missing/future dates excluded. Amber >0 to 5% of all enabled AD Windows PCs; red >5%. AD/Entra timestamps are approximate. Last collected evidence, not a live tenant check."),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _s=[KPI Alert Level Enabled PCs not in Intune <30D]
			RETURN SWITCH(_s,0,"Normal",1,"Attention",2,"Critical","Unknown") & " | Enabled AD Windows PCs absent from Intune with AD/Entra machine sign-in <30D. Most recent qualified native date; same batch. Missing/future dates excluded. Amber >0 to 5% of all enabled AD Windows PCs; red >5%. AD/Entra timestamps are approximate. Last collected evidence, not a live tenant check."))
		isHidden
		displayFolder: Presentation | KPI alerts
		lineageTag: 75e21651-955d-4173-bc0d-6719589f5bed

	/// SAM display resolved by qualified native identity, same tenant and loaded batch. Empty text when no qualified SAM; preserves unresolved source rows in table projections.
	measure 'SAM · Device Exploration Inventory' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _display = (VAR _id=SELECTEDVALUE('Device Exploration Inventory'[Device Source ID]) VAR _tenant=SELECTEDVALUE('Device Exploration Inventory'[TenantKey]) VAR _batch=SELECTEDVALUE('Device Exploration Inventory'[Loaded Batch ID])
			 VAR _dk=IF(NOT ISBLANK(_id),LOOKUPVALUE('Native Managed Device Evidence'[TenantDeviceKey],'Native Managed Device Evidence'[ManagedDeviceId],_id,'Native Managed Device Evidence'[TenantKey],_tenant,'Native Managed Device Evidence'[Loaded Batch ID],_batch))
			 VAR _uid=IF(NOT ISBLANK(_dk),LOOKUPVALUE('Native Device Evidence'[PrimaryUserSourceId],'Native Device Evidence'[TenantDeviceKey],_dk,'Native Device Evidence'[TenantKey],_tenant,'Native Device Evidence'[Loaded Batch ID],_batch))
			 VAR _upn=IF(NOT ISBLANK(_uid),LOOKUPVALUE('Native User Evidence'[UserPrincipalName],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))
			 RETURN IF(NOT ISBLANK(_uid) && _upn=SELECTEDVALUE('Device Exploration Inventory'[Primary User UPN]),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))) RETURN IF(COUNTROWS('Device Exploration Inventory') > 0, COALESCE(_display, ""))),KEEPFILTERS(TREATAS(_pu,'Device Exploration Inventory'[Primary User (report)]))),(VAR _display = (VAR _id=SELECTEDVALUE('Device Exploration Inventory'[Device Source ID]) VAR _tenant=SELECTEDVALUE('Device Exploration Inventory'[TenantKey]) VAR _batch=SELECTEDVALUE('Device Exploration Inventory'[Loaded Batch ID])
			 VAR _dk=IF(NOT ISBLANK(_id),LOOKUPVALUE('Native Managed Device Evidence'[TenantDeviceKey],'Native Managed Device Evidence'[ManagedDeviceId],_id,'Native Managed Device Evidence'[TenantKey],_tenant,'Native Managed Device Evidence'[Loaded Batch ID],_batch))
			 VAR _uid=IF(NOT ISBLANK(_dk),LOOKUPVALUE('Native Device Evidence'[PrimaryUserSourceId],'Native Device Evidence'[TenantDeviceKey],_dk,'Native Device Evidence'[TenantKey],_tenant,'Native Device Evidence'[Loaded Batch ID],_batch))
			 VAR _upn=IF(NOT ISBLANK(_uid),LOOKUPVALUE('Native User Evidence'[UserPrincipalName],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))
			 RETURN IF(NOT ISBLANK(_uid) && _upn=SELECTEDVALUE('Device Exploration Inventory'[Primary User UPN]),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[SourceUserId],_uid,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))) RETURN IF(COUNTROWS('Device Exploration Inventory') > 0, COALESCE(_display, ""))))
		displayFolder: Private identity display
		lineageTag: 388b2ece-a1cd-429b-81dd-070c19423b04

	/// Read-only report utility applying the disconnected primary-user selector to source-qualified device rows.
	measure 'Primary user row match · Device Exploration Inventory' = VAR PresentRows = IF(ISFILTERED('Primary User Selection'[Primary user]), CALCULATE(COUNTROWS('Device Exploration Inventory'), KEEPFILTERS(TREATAS(VALUES('Primary User Selection'[Primary user]), 'Device Exploration Inventory'[Primary User (report)]))), COUNTROWS('Device Exploration Inventory')) RETURN IF(PresentRows>0,1,BLANK())
		formatString: 0
		isHidden
		lineageTag: d5eb2287-9a69-4686-be69-19006ce2e727

