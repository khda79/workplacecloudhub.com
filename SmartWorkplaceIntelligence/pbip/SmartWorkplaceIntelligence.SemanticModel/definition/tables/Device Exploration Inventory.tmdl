	column 'Country Name' =
			VAR _sourceCountry = 'Device Exploration Inventory'[Country]
			RETURN COALESCE(LOOKUPVALUE('Country Selection'[Country], 'Country Selection'[Source Country], _sourceCountry), IF(ISBLANK(_sourceCountry) || LEN(TRIM(_sourceCountry)) = 2, "Unknown", _sourceCountry))
		dataType: string
