		summarizeBy: none

	/// Observed primary user, exact source ID and tenant/batch matching only; used by the report search.
	column 'Primary User (report)' =
			VAR _t='Device Exploration Inventory'[TenantKey]
			VAR _b='Device Exploration Inventory'[Loaded Batch ID]
			VAR _gkey='Device Exploration Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Exploration Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Exploration Inventory'[Device Source ID]))
			VAR _upn=COALESCE('Device Exploration Inventory'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			RETURN IF(ISBLANK(_upn)||TRIM(_upn)="","Not resolved",_upn)
		dataType: string
		displayFolder: Report identity context
		lineageTag: 2e43e49b-d1b8-4fb2-968a-db9a605e8ef8

	/// Qualified SAM of the primary user; never inferred from UPN text.
	column 'Primary User SAM (report)' =
			VAR _t='Device Exploration Inventory'[TenantKey]
			VAR _b='Device Exploration Inventory'[Loaded Batch ID]
			VAR _gkey='Device Exploration Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Exploration Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Exploration Inventory'[Device Source ID]))
			VAR _upn=COALESCE('Device Exploration Inventory'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			VAR _sam=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User SAM],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_sam,IF(NOT ISBLANK(_upn),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[UserPrincipalName],_upn,'Native User Evidence'[TenantKey],_t,'Native User Evidence'[Loaded Batch ID],_b,BLANK())),"Not resolved")
		dataType: string
		displayFolder: Report identity context
		lineageTag: e79026dd-df54-41c6-aa06-9730e9d7ee54

	/// Last Windows console user observed at collection. Does not mean current user or last RDP session.
	column 'Last Console User (report)' =
			VAR _t='Device Exploration Inventory'[TenantKey]
			VAR _b='Device Exploration Inventory'[Loaded Batch ID]
			VAR _gkey='Device Exploration Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Exploration Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Exploration Inventory'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(_status="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon User],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())),"Not observed")
		dataType: string
		displayFolder: Report identity context
		lineageTag: 3a647ea6-cfa2-436f-8906-1725d5e8e725

	/// Source-qualified time of last observed console logon; unknown remains blank.
	column 'Last Console Logon UTC (report)' =
			VAR _t='Device Exploration Inventory'[TenantKey]
			VAR _b='Device Exploration Inventory'[Loaded Batch ID]
			VAR _gkey='Device Exploration Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Exploration Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Exploration Inventory'[Device Source ID]))
			RETURN IF(IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon UTC],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		displayFolder: Report identity context
		lineageTag: b4d3fb64-3b36-4e5d-b461-9844a24c8385

	/// Preserves source status and timestamp qualification, including stale/missing/error evidence.
	column 'Console Logon Qualification (report)' =
			VAR _t='Device Exploration Inventory'[TenantKey]
			VAR _b='Device Exploration Inventory'[Loaded Batch ID]
			VAR _gkey='Device Exploration Inventory'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Device Exploration Inventory'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Device Exploration Inventory'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _quality=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Quality],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(ISBLANK(_status),"No matched system observation",_status&" · "&_quality)
		dataType: string
		displayFolder: Report identity context
		lineageTag: 8466ec6b-4459-45a8-9086-c2093da74469

	partition 'Device Exploration Inventory' = m
		mode: import
		source =
				let
				    D = #"Device Inventory Evidence",
				    C = #"Native AD Intune Coverage",
				    A = #"AD Computer Evidence",
				    U = #"All Devices Evidence",
				    S = #"Device System Evidence",
				    CThin=Table.Buffer(Table.SelectColumns(C,{"TenantKey","TenantADComputerKey","Loaded Batch ID","IntuneManagedDeviceId","Enabled","OperatingSystem","OperatingSystemVersion","CoverageState","SourceCollectedDateTime","DeviceName"},MissingField.Ignore)),
				    AThin=Table.Buffer(Table.SelectColumns(A,{"TenantKey","TenantADComputerKey","Loaded Batch ID","ObjectGUID","DomainName","CreationRaw","CreationStatus","ModificationRaw","ModificationStatus","PasswordExpiryStatus"},MissingField.Ignore)),
				    UThin=Table.Buffer(Table.SelectColumns(U,{"TenantKey","Device Key","Loaded Batch ID","Country"},MissingField.Ignore)),
				    SThin=Table.Buffer(Table.SelectColumns(S,{"TenantKey","Device Source ID","Loaded Batch ID","Expected AV Name","Expected AV State","Third Party AV Products","Windows Update Reboot Required","BitLocker OS Protection","BitLocker OS Conversion","Encryption Comparison","Data Quality Issues","Freshness","Observation Raw"},MissingField.Ignore)),
				    Batches = List.Distinct(List.Combine(List.Transform({D,CThin,AThin,UThin,SThin}, each Table.Column(_, "Loaded Batch ID")))),
				    BatchSafe = List.Count(Batches) = 1 and Batches{0} <> null and Text.Trim(Batches{0}) <> "",
				    JoinFlat=(left as table,leftKeys as list,right as table,rightKeys as list,prefix as text) as table=>let
				        columns=Table.ColumnNames(right),renamed=Table.RenameColumns(right,List.Transform(columns,each {_,prefix&_}))
				        in Table.Join(left,leftKeys,renamed,List.Transform(rightKeys,each prefix&_),JoinKind.LeftOuter),
				    CheckKeys = (t as table, keys as list) as table =>
				        let materialized=Table.Buffer(t), count=Table.RowCount(materialized),
				            distinctCount=Table.RowCount(Table.Distinct(Table.SelectColumns(materialized,keys)))
				        in if distinctCount <> count
				        then error "Duplicate inventory identity; refusing a multiplied or deduplicated inventory" else materialized,
				    CheckedD = CheckKeys(D,{"TenantKey","Device Source ID","Loaded Batch ID"}),
				    CheckedC = CheckKeys(CThin,{"TenantKey","TenantADComputerKey","Loaded Batch ID"}),
				    CheckedA = CheckKeys(AThin,{"TenantKey","TenantADComputerKey","Loaded Batch ID"}),
				    ADFields={"ObjectGUID","DomainName","CreationRaw","CreationStatus","ModificationRaw","ModificationStatus","PasswordExpiryStatus"},
				    ADFlat=Table.Buffer(JoinFlat(CheckedC,{"TenantKey","TenantADComputerKey","Loaded Batch ID"},Table.SelectColumns(CheckedA,{"TenantKey","TenantADComputerKey","Loaded Batch ID"}&ADFields,MissingField.UseNull),{"TenantKey","TenantADComputerKey","Loaded Batch ID"},"__AD.")),
				    ADInfo = (r as record) as record => let
				        get = (n as text) => Record.FieldOrDefault(r,"__AD."&n,null)
				    in [#"AD Enabled"=if r[Enabled]=true then "Yes" else if r[Enabled]=false then "No" else "Unknown",
				        #"AD Windows PC"=if Text.Contains(Text.Lower(r[OperatingSystem] ?? ""),"windows") and not Text.Contains(Text.Lower(r[OperatingSystem] ?? ""),"server") then "Yes" else "No",
				        #"AD Domain"=get("DomainName"), #"AD Match Qualification"=r[CoverageState],
				        #"AD Created (source)"=get("CreationRaw"), #"AD Creation Qualification"=get("CreationStatus"),
				        #"AD Modified (source)"=get("ModificationRaw"), #"AD Modification Qualification"=get("ModificationStatus"),
				        #"AD Password Expiry Status"=get("PasswordExpiryStatus"), #"AD Source Collected UTC"=r[SourceCollectedDateTime]],
				    Qualify=(t as table,keys as list) as table=>let fields=List.Difference(Table.ColumnNames(t),keys),
				        g=Table.Group(t,keys,{{"__count",each Table.RowCount(_),Int64.Type},{"__first",each Record.SelectFields(Table.First(_),fields),type record}})
				        in Table.Buffer(Table.ExpandRecordColumn(g,"__first",fields,fields)),
				    ADByIntune=Qualify(ADFlat,{"TenantKey","IntuneManagedDeviceId","Loaded Batch ID"}),
				    DJoin = JoinFlat(CheckedD,{"TenantKey","Device Source ID","Loaded Batch ID"},ADByIntune,{"TenantKey","IntuneManagedDeviceId","Loaded Batch ID"},"__Match."),
				    DRecords = Table.AddColumn(DJoin,"Record",each let n=Record.FieldOrDefault(_,"__Match.__count",null),
				        match=Record.FromList(List.Transform(Table.ColumnNames(ADFlat), (field)=>Record.FieldOrDefault(_,"__Match."&field,null)),Table.ColumnNames(ADFlat)),
				        ad=if n=1 then ADInfo(match) else [#"AD Match Qualification"=if n<>null and n>1 then "Ambiguous AD identities" else "No exact AD identity"]
				        in Record.Combine({Record.SelectFields(_,Table.ColumnNames(D)),ad,[#"Inventory Key"=[#"Device Tenant Key"],#"Intune presence"="In Intune",#"Inventory Source"="Intune",#"Union Key"="intune:" & Text.Lower([#"Device Source ID"])]})),
				    DLocators=Table.AddColumn(Table.SelectColumns(CheckedD,{"TenantKey","Device Source ID","Loaded Batch ID"}),"__seen",each true,type logical),
				    CJoin = JoinFlat(ADFlat,{"TenantKey","IntuneManagedDeviceId","Loaded Batch ID"},DLocators,{"TenantKey","Device Source ID","Loaded Batch ID"},"__Intune."),
				    ADOnly = Table.SelectRows(CJoin,each [#"__Intune.__seen"]<>true and Text.Contains(Text.Lower([OperatingSystem] ?? ""),"windows") and not Text.Contains(Text.Lower([OperatingSystem] ?? ""),"server")),
				    ADRecords = Table.AddColumn(ADOnly,"Record",each let
				        guid=Record.FieldOrDefault(_,"__AD.ObjectGUID",null),
				        presence=if List.Contains({"Entra only","No exact Entra SID match"},[CoverageState]) then "Not found in Intune" else "Unknown / ambiguous"
				        in Record.Combine({ADInfo(_),[TenantKey=[TenantKey],#"Loaded Batch ID"=[#"Loaded Batch ID"],#"Inventory Key"="ad:" & [TenantADComputerKey],#"Device Name"=[DeviceName],#"Operating System Family"="Windows",#"Operating System Version"=[OperatingSystemVersion],#"Device Category"="PC Windows",Platform="Windows",#"Intune presence"=presence,#"Inventory Source"="AD only",#"Union Key"=if guid=null then null else "ad:" & Text.Lower(guid)]})),
				    Combined = Table.FromRecords(List.Combine({DRecords[Record],ADRecords[Record]}),List.Distinct(List.Combine({Table.ColumnNames(D),{"Inventory Key","Intune presence","Inventory Source","Union Key"} & {"Inventory Key", "Intune presence", "AD Enabled", "AD Windows PC", "AD Domain", "AD Match Qualification", "AD Created (source)", "AD Creation Qualification", "AD Modified (source)", "AD Modification Qualification", "AD Password Expiry Status", "Inventory Source", "Expected AV Name", "Expected AV State", "Third Party AV Products", "Windows Update Reboot Required", "BitLocker OS Protection", "BitLocker OS Conversion", "Encryption Comparison", "System Data Quality Issues", "System Freshness", "System Observation (source)", "Loaded Batch ID", "TenantKey", "AD Source Collected UTC"}})),MissingField.UseNull),
				    CountryLookup=Qualify(UThin,{"TenantKey","Device Key","Loaded Batch ID"}),
				    CountryJoin=JoinFlat(Combined,{"TenantKey","Union Key","Loaded Batch ID"},CountryLookup,{"TenantKey","Device Key","Loaded Batch ID"},"__Country."),
				    WithCountry=Table.AddColumn(CountryJoin,"Country Record",each let raw=if [Inventory Source]="Intune" then Record.FieldOrDefault(_,"Country",null) else if [#"__Country.__count"]=1 then [#"__Country.Country"] else null in [Country=if raw=null or Text.Trim(raw)="" then "Unknown" else raw]),
				    SystemLookup=Qualify(SThin,{"TenantKey","Device Source ID","Loaded Batch ID"}),
				    SysJoin=JoinFlat(WithCountry,{"TenantKey","Device Source ID","Loaded Batch ID"},SystemLookup,{"TenantKey","Device Source ID","Loaded Batch ID"},"__System."),
				    FinalRecords=Table.AddColumn(SysJoin,"Final Record",each let get=(n as text)=>if [#"__System.__count"]=1 then Record.FieldOrDefault(_,"__System."&n,null) else null
				        in Record.Combine({_,[#"Expected AV Name"=get("Expected AV Name"),#"Expected AV State"=get("Expected AV State"),#"Third Party AV Products"=get("Third Party AV Products"),#"Windows Update Reboot Required"=get("Windows Update Reboot Required"),#"BitLocker OS Protection"=get("BitLocker OS Protection"),#"BitLocker OS Conversion"=get("BitLocker OS Conversion"),#"Encryption Comparison"=get("Encryption Comparison"),#"System Data Quality Issues"=get("Data Quality Issues"),#"System Freshness"=get("Freshness"),#"System Observation (source)"=get("Observation Raw")],[Country=[Country Record][Country]]})),
				    Output = if not BatchSafe then error "Inventory inputs do not expose one common loaded batch" else Table.FromRecords(FinalRecords[Final Record],{"Device Source ID", "Device Name", "Primary User UPN", "Country", "Platform", "Device Category", "Ownership", "Management State", "Compliance State", "Manufacturer", "Model", "Operating System Family", "Operating System Version", "Windows Release", "Disk Space State", "AD to Intune Match", "Entra Match", "Tenure Confidence", "Windows Generation", "Windows 11 Upgrade Eligibility", "Windows 11 Blocking Reasons", "Windows Update State", "Windows Update Risk", "Windows Update Action Code", "Secure Boot State", "Endpoint Analytics State", "Stop Error State", "Entra Hardware ID Conflict", "Removal Candidate", "Windows 11 Release State", "Entra Account State", "Intune Encryption State", "System Drive Capacity (GB)", "Free Disk Space (GB)", "Free Disk Space (%)", "Managed Tenure (Years)", "Endpoint Analytics Score", "Stop Error Count", "Last Sync DateTime", "Observed Since", "Inventory Key", "Intune presence", "AD Enabled", "AD Windows PC", "AD Domain", "AD Match Qualification", "AD Created (source)", "AD Creation Qualification", "AD Modified (source)", "AD Modification Qualification", "AD Password Expiry Status", "Inventory Source", "Expected AV Name", "Expected AV State", "Third Party AV Products", "Windows Update Reboot Required", "BitLocker OS Protection", "BitLocker OS Conversion", "Encryption Comparison", "System Data Quality Issues", "System Freshness", "System Observation (source)", "Loaded Batch ID", "TenantKey", "AD Source Collected UTC"},MissingField.UseNull),
				    CheckedOutput = CheckKeys(Output,{"TenantKey","Inventory Key"}),
				    Typed = Table.TransformColumnTypes(CheckedOutput,{{"Device Source ID",type text},{"Device Name",type text},{"Primary User UPN",type text},{"Country",type text},{"Platform",type text},{"Device Category",type text},{"Ownership",type text},{"Management State",type text},{"Compliance State",type text},{"Manufacturer",type text},{"Model",type text},{"Operating System Family",type text},{"Operating System Version",type text},{"Windows Release",type text},{"Disk Space State",type text},{"AD to Intune Match",type text},{"Entra Match",type text},{"Tenure Confidence",type text},{"Windows Generation",type text},{"Windows 11 Upgrade Eligibility",type text},{"Windows 11 Blocking Reasons",type text},{"Windows Update State",type text},{"Windows Update Risk",type text},{"Windows Update Action Code",type text},{"Secure Boot State",type text},{"Endpoint Analytics State",type text},{"Stop Error State",type text},{"Entra Hardware ID Conflict",type text},{"Removal Candidate",type text},{"Windows 11 Release State",type text},{"Entra Account State",type text},{"Intune Encryption State",type text},{"System Drive Capacity (GB)",type number},{"Free Disk Space (GB)",type number},{"Free Disk Space (%)",type number},{"Managed Tenure (Years)",type number},{"Endpoint Analytics Score",type number},{"Stop Error Count",type number},{"Last Sync DateTime",type datetime},{"Observed Since",type datetime},{"Inventory Key",type text},{"Intune presence",type text},{"AD Enabled",type text},{"AD Windows PC",type text},{"AD Domain",type text},{"AD Match Qualification",type text},{"AD Created (source)",type text},{"AD Creation Qualification",type text},{"AD Modified (source)",type text},{"AD Modification Qualification",type text},{"AD Password Expiry Status",type text},{"Inventory Source",type text},{"Expected AV Name",type text},{"Expected AV State",type text},{"Third Party AV Products",type text},{"Windows Update Reboot Required",type text},{"BitLocker OS Protection",type text},{"BitLocker OS Conversion",type text},{"Encryption Comparison",type text},{"System Data Quality Issues",type text},{"System Freshness",type text},{"System Observation (source)",type text},{"Loaded Batch ID",type text},{"TenantKey",type text},{"AD Source Collected UTC",type datetime}},"en-US")
				in Typed

	annotation PBI_ResultType = Exception
