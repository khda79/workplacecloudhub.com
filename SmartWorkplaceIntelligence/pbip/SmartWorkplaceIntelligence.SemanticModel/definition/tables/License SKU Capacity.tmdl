/// Licences per-SKU capacity of the qualified report snapshot (M365_Licenses_ReportSkuCapacity.csv). Licences decides; the report never recomputes. Empty when the batch does not qualify the file.
table 'License SKU Capacity'
	lineageTag: c81068c8-efdf-4776-b0e4-22bcebe62244

	/// Governed (not excluded) license SKUs of the Licences capacity file; BLANK when the file is not qualified for this batch (Not qualified) or absent (Not verified batch without decision files).
	measure 'Governed License Products' = CALCULATE ( COUNTROWS ( 'License SKU Capacity' ), KEEPFILTERS ( 'License SKU Capacity'[Capacity Class] = "Governed" ) )
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 25139152-cc08-41fd-b3af-f24cd3ccbc90

	/// Governed SKUs with unassigned units (AvailableUnits > 0) in the Licences capacity file: a raw Licences fact, no SWI threshold. BLANK when the file is not qualified or absent.
	measure 'Governed License SKUs With Unassigned Units' = CALCULATE ( COUNTROWS ( 'License SKU Capacity' ), KEEPFILTERS ( 'License SKU Capacity'[Capacity Class] = "Governed" ), KEEPFILTERS ( 'License SKU Capacity'[Available Units] > 0 ) )
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: da59ef56-5aa6-4480-978f-0b8973c29fbb

	/// Unassigned units (AvailableUnits > 0) of governed SKUs in the Licences capacity file; BLANK when the file is not qualified or absent.
	measure 'Unassigned Governed License Units' = SUMX ( FILTER ( 'License SKU Capacity', 'License SKU Capacity'[Capacity Class] = "Governed" && 'License SKU Capacity'[Available Units] > 0 ), 'License SKU Capacity'[Available Units] )
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: dc39c15f-2d11-4dfb-8879-3f6b96ca9734

	measure 'Enabled License Units' = CALCULATE ( SUM ( 'License SKU Capacity'[Enabled Units] ), KEEPFILTERS ( 'License SKU Capacity'[Capacity Class] = "Governed" ) )
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 1a9e4a24-b356-4de8-ac9f-2b6e132e9260

	measure 'Consumed License Units' = CALCULATE ( SUM ( 'License SKU Capacity'[Consumed Units] ), KEEPFILTERS ( 'License SKU Capacity'[Capacity Class] = "Governed" ) )
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 9cb41275-ceab-41eb-94c7-260f2785e290

	/// Available units of governed SKUs; an over-assigned SKU counts 0, never a negative offset.
	measure 'Available License Units' = SUMX ( FILTER ( 'License SKU Capacity', 'License SKU Capacity'[Capacity Class] = "Governed" ), MAX ( 'License SKU Capacity'[Available Units], 0 ) )
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 40ed817b-69c0-494c-aa75-5a7c42124b1d

	/// Consumed units above enabled units, summed over over-assigned governed SKUs (absolute value).
	measure 'Over-assigned License Units' = SUMX ( FILTER ( 'License SKU Capacity', 'License SKU Capacity'[Capacity Class] = "Governed" ), MAX ( -'License SKU Capacity'[Available Units], 0 ) )
		formatString: #,0
		displayFolder: Licensing | Capacity
		lineageTag: 454a69ff-640a-4ecc-a412-f6f52f530a0c

	/// Available units of governed SKUs, or Over-assigned when the selection only has over-assigned capacity; the absolute value is in the tooltip.
	measure 'Available License Units Label' =
			VAR _available = [Available License Units]
			VAR _over = [Over-assigned License Units]
			RETURN IF ( _over > 0 && _available = 0, "Over-assigned", FORMAT ( _available, "#,0" ) )
		formatString: @
		displayFolder: Licensing | Capacity
		lineageTag: c29665c3-e37c-4650-ac4a-aaf96e0d96ff

	measure 'Observed License Capacity Utilization (%)' = DIVIDE ( [Consumed License Units], [Enabled License Units] )
		formatString: 0.0%
		displayFolder: Licensing | Capacity
		lineageTag: 14468e0c-7a92-409a-ba29-4aa666e1853b

	measure 'Observed Potentially Reclaimable Assignments' = [License Report Recovery Candidates]
		formatString: #,0
		displayFolder: Licensing | Optimization
		lineageTag: 1be55934-8125-4f54-ad7e-5563548d6bba

	/// Published Licences snapshot KPI intersected with the selected SKU families (Report Product). Excluded or unmapped families return BLANK, not a global total.
	measure 'Microsoft 365 Enabled Units' =
			VAR _products = VALUES ( 'License SKU Capacity'[Report Product] )
			RETURN IF (
			    ISCROSSFILTERED ( 'License SKU Capacity' ),
			    CALCULATE ( [License Report Enabled Units], KEEPFILTERS ( TREATAS ( _products, 'License Report Summary'[Product] ) ), KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) ),
			    CALCULATE ( [License Report Enabled Units], KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) )
			)
		formatString: #,0
		displayFolder: Licensing | Suites
		lineageTag: 4da9985e-eff5-41c4-b7fb-a85cc4aef981

	/// Published Licences snapshot KPI intersected with the selected SKU families (Report Product). Excluded or unmapped families return BLANK, not a global total.
	measure 'Microsoft 365 Consumed Units' =
			VAR _products = VALUES ( 'License SKU Capacity'[Report Product] )
			RETURN IF (
			    ISCROSSFILTERED ( 'License SKU Capacity' ),
			    CALCULATE ( [License Report Consumed Units], KEEPFILTERS ( TREATAS ( _products, 'License Report Summary'[Product] ) ), KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) ),
			    CALCULATE ( [License Report Consumed Units], KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) )
			)
		formatString: #,0
		displayFolder: Licensing | Suites
		lineageTag: 214c6375-67e4-428d-8b06-0c67ae755910

	measure 'Microsoft 365 Utilization (%)' = DIVIDE ( [Microsoft 365 Consumed Units], [Microsoft 365 Enabled Units] )
		formatString: 0.0%
		displayFolder: Licensing | Suites
		lineageTag: bdb2522c-ba9e-4b6c-929e-3faf08a8944d

	/// Published Licences snapshot KPI intersected with the selected SKU families (Report Product). Excluded or unmapped families return BLANK, not a global total.
	measure 'F3 Reclaimable Assignments' =
			VAR _products = VALUES ( 'License SKU Capacity'[Report Product] )
			RETURN IF (
			    ISCROSSFILTERED ( 'License SKU Capacity' ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( TREATAS ( _products, 'License Report Summary'[Product] ) ), KEEPFILTERS ( 'License Report Summary'[Product] = "Microsoft 365 F3" ) ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( 'License Report Summary'[Product] = "Microsoft 365 F3" ) )
			)
		formatString: #,0
		displayFolder: Licensing | Suites
		lineageTag: 3092df45-4c8f-47bc-a89e-7fa65a63071e

	/// Published Licences snapshot KPI intersected with the selected SKU families (Report Product). Excluded or unmapped families return BLANK, not a global total.
	measure 'E3 Reclaimable Assignments' =
			VAR _products = VALUES ( 'License SKU Capacity'[Report Product] )
			RETURN IF (
			    ISCROSSFILTERED ( 'License SKU Capacity' ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( TREATAS ( _products, 'License Report Summary'[Product] ) ), KEEPFILTERS ( 'License Report Summary'[Product] = "Microsoft 365 E3" ) ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( 'License Report Summary'[Product] = "Microsoft 365 E3" ) )
			)
		formatString: #,0
		displayFolder: Licensing | Suites
		lineageTag: 032377bd-be9a-408f-9189-314d44c4c61b

	/// Published Licences snapshot KPI intersected with the selected SKU families (Report Product). Excluded or unmapped families return BLANK, not a global total.
	measure 'E5 Reclaimable Assignments' =
			VAR _products = VALUES ( 'License SKU Capacity'[Report Product] )
			RETURN IF (
			    ISCROSSFILTERED ( 'License SKU Capacity' ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( TREATAS ( _products, 'License Report Summary'[Product] ) ), KEEPFILTERS ( 'License Report Summary'[Product] = "Microsoft 365 E5" ) ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( 'License Report Summary'[Product] = "Microsoft 365 E5" ) )
			)
		formatString: #,0
		displayFolder: Licensing | Suites
		lineageTag: 29ca757b-36c4-44fa-a699-652883102b9a

	/// Published Licences snapshot KPI intersected with the selected SKU families (Report Product). Excluded or unmapped families return BLANK, not a global total.
	measure 'E3 to F3 Review Candidates' =
			VAR _products = VALUES ( 'License SKU Capacity'[Report Product] )
			RETURN IF (
			    ISCROSSFILTERED ( 'License SKU Capacity' ),
			    CALCULATE ( [License Report E3 to F3 Review], KEEPFILTERS ( TREATAS ( _products, 'License Report Summary'[Product] ) ), KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) ),
			    CALCULATE ( [License Report E3 to F3 Review], KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) )
			)
		formatString: #,0
		displayFolder: Licensing | Suites
		lineageTag: 7927f27a-a170-40ce-aaed-965a1b740485

	/// Published Licences snapshot KPI intersected with the selected SKU families (Report Product). Excluded or unmapped families return BLANK, not a global total.
	measure 'Immediate Reclaimable Assignments' =
			VAR _products = VALUES ( 'License SKU Capacity'[Report Product] )
			RETURN IF (
			    ISCROSSFILTERED ( 'License SKU Capacity' ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( TREATAS ( _products, 'License Report Summary'[Product] ) ), KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) ),
			    CALCULATE ( [License Report Recovery Candidates], KEEPFILTERS ( 'License Report Summary'[Category] = "Suite" ) )
			)
		formatString: #,0
		displayFolder: Licensing | Suites
		lineageTag: a3623529-9063-4185-96ef-1a02ce78b59d

	measure 'License SKU Recommended Candidates' = SUM ( 'License SKU Capacity'[Recommended Candidates] )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: 867fac7d-9e1a-4765-8569-6e88d5c267ba

	measure 'License SKU Review Candidates' = SUM ( 'License SKU Capacity'[Review Candidates] )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: b5c2cbf9-fc0e-4978-87e7-808e1808cda6

	measure 'License SKU Blocked Candidates' = SUM ( 'License SKU Capacity'[Blocked Candidates] )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: cdf7733c-0848-44be-8aac-025d2981f275

	measure 'License SKU Referenced Candidates' = SUM ( 'License SKU Capacity'[Referenced Candidates] )
		formatString: #,0
		displayFolder: Licensing | SKU decisions
		lineageTag: 1d733d73-3957-46cc-9be3-39a3f7d0d2b9

	/// Tenant-wide unknown-assessment count for selected complete suite families. Not allocated geographically; this is a qualification column, not scoped candidate count.
	measure 'Selected Suite Recovery Unknown' =
			VAR _products=VALUES('License SKU Capacity'[Report Product])
			RETURN IF([License Report Snapshot Consistent]=1,
			CALCULATE(SUM('License Report Summary'[Recovery Unknown]),
			KEEPFILTERS(TREATAS(_products,'License Report Summary'[Product])),
			KEEPFILTERS('License Report Summary'[Category]="Suite")))
		formatString: #,0
		isHidden
		displayFolder: Licensing | Suites
		lineageTag: b267412b-6fcf-4cd3-8dec-56238e6261af

