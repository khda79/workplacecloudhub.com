	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: cbf39599-f841-42be-b539-393b1e77b3f6
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'License SKU Capacity' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Columns = {"SnapshotId", "TenantKey", "ReceiptRunId", "SkuId", "SkuPartNumber", "SkuDisplayName", "ReportProduct", "Excluded", "ExclusionReason", "EnabledUnits", "WarningUnits", "SuspendedUnits", "LockedOutUnits", "ConsumedUnits", "AvailableUnits", "AssignedUsers", "DisabledAccountUsers", "ActiveUsersUsageNotMeasured", "RecommendedCandidates", "ReviewCandidates", "BlockedCandidates", "ReferencedCandidates", "CopilotGraceUsers", "UsageEvidence", "UsageEvidenceReason"},
				    Raw = GetLicenseReportCsv("M365_Licenses_ReportSkuCapacity.csv", Columns),
				    Nulls = Table.ReplaceValue(Raw, "", null, Replacer.ReplaceValue, {"EnabledUnits", "WarningUnits", "SuspendedUnits", "LockedOutUnits", "ConsumedUnits", "AvailableUnits", "AssignedUsers", "DisabledAccountUsers", "ActiveUsersUsageNotMeasured", "RecommendedCandidates", "ReviewCandidates", "BlockedCandidates", "ReferencedCandidates", "CopilotGraceUsers", "ReportProduct", "ExclusionReason"}),
				    Product = Table.AddColumn(Nulls, "License Product", each if [SkuDisplayName] = null or Text.Trim([SkuDisplayName]) = "" then [SkuPartNumber] else [SkuDisplayName], type text),
				    Class = Table.AddColumn(Product, "Capacity Class", each if [Excluded] = "True" then "Excluded" else "Governed", type text),
				    Typed = Table.TransformColumnTypes(Class, {{"Excluded", type logical}} & List.Transform({"EnabledUnits", "WarningUnits", "SuspendedUnits", "LockedOutUnits", "ConsumedUnits", "AvailableUnits", "AssignedUsers", "DisabledAccountUsers", "ActiveUsersUsageNotMeasured", "RecommendedCandidates", "ReviewCandidates", "BlockedCandidates", "ReferencedCandidates", "CopilotGraceUsers"}, each {_, Int64.Type}), "en-US")
				in
				    Typed)
				in
				    Readers[Finish](BusinessRows)

	annotation PBI_ResultType = Exception
