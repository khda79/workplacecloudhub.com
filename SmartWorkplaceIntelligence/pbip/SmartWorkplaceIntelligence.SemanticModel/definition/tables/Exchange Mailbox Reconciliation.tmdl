		formatString: #,0
		displayFolder: Migration licensing scenario

	/// Estimate under approved mailbox sizing assumptions. Not a contractual order. Distinct same-batch people; retained and unresolved exception identities never migrate automatically.
	measure 'Exchange Scenario SE Gap' = VAR _need=[Exchange Scenario SE Need] VAR _covered=[Exchange Scenario SE Covered] RETURN IF(NOT ISBLANK(_need),MAX(0,_need-_covered))
		formatString: #,0
		displayFolder: Migration licensing scenario

	/// Existing CAL stock, active SA, accessors and base/additive rights are not inventoried. Gap is exposure before those rights; never a net purchase quantity.
	measure 'Exchange Scenario SE Buy Label' = "To qualify"
		formatString: @
		displayFolder: Migration licensing scenario

	/// Estimate under approved mailbox sizing assumptions. Not a contractual order. Distinct same-batch people; retained and unresolved exception identities never migrate automatically.
	measure 'Exchange Scenario Review People' =
			VAR _people=(VAR _scope=SELECTCOLUMNS('Exchange Mailbox Reconciliation',
			    "Person",IF('Exchange Mailbox Reconciliation'[Cloud Account Key]<>"","cloud|" & 'Exchange Mailbox Reconciliation'[Cloud Account Key],
			        IF('Exchange Mailbox Reconciliation'[AD Account Key]<>"","ad|" & 'Exchange Mailbox Reconciliation'[AD Account Key],"mailbox|" & 'Exchange Mailbox Reconciliation'[Mailbox GUID])),
			    "Batch",'Exchange Mailbox Reconciliation'[Loaded Batch ID],
			    "Cloud",'Exchange Mailbox Reconciliation'[Cloud Account Key],
			    "Object",LOWER(TRIM('Exchange Mailbox Reconciliation'[Object GUID])),
			    "Address",LOWER(TRIM('Exchange Mailbox Reconciliation'[Primary SMTP Address])),
			    "Kind",'Exchange Mailbox Reconciliation'[Mailbox Type],
			    "Size",'Exchange Mailbox Reconciliation'[Mailbox Size GB],
			    "Archive",'Exchange Mailbox Reconciliation'[Archive State],
			    "Hold",'Exchange Mailbox Reconciliation'[Hold and Retention],
			    "Access",'Exchange Mailbox Reconciliation'[Full Access Count],
			    "Send",'Exchange Mailbox Reconciliation'[Send As Count],
			    "Behalf",'Exchange Mailbox Reconciliation'[Send On Behalf],
			    "Retained",'Exchange Mailbox Reconciliation'[Retained On-premises],
			    "Link",'Exchange Mailbox Reconciliation'[Account Link])
			VAR _exceptions=SELECTCOLUMNS(FILTER('Mailbox Migration Exceptions',
			    'Mailbox Migration Exceptions'[Requires Review]=1),
			    "ExceptionBatch",'Mailbox Migration Exceptions'[Loaded Batch ID],
			    "Identity",LOWER(TRIM('Mailbox Migration Exceptions'[Mailbox Identity])),
			    "Candidate",LOWER(TRIM('Mailbox Migration Exceptions'[Candidate Identity])),
			    "ExceptionAddress",LOWER(TRIM('Mailbox Migration Exceptions'[Primary SMTP Address])))
			VAR _users=DISTINCT(SELECTCOLUMNS(FILTER(_scope,[Cloud]<>""),"User",[Cloud]))
			VAR _batches=DISTINCT(SELECTCOLUMNS(_scope,"Batch",[Batch]))
			VAR _plans=CALCULATETABLE(SELECTCOLUMNS(FILTER('Native User Service Plan',
			    LOWER('Native User Service Plan'[IsEnabled] & "")="true" && 'Native User Service Plan'[AssignmentState]="Success" &&
			    'Native User Service Plan'[ServicePlanName] IN {"EXCHANGE_S_STANDARD","EXCHANGE_S_ENTERPRISE","EXCHANGE_S_DESKLESS"}),
			    "PlanUser",'Native User Service Plan'[TenantUserKey],"PlanBatch",'Native User Service Plan'[Loaded Batch ID],"Plan",'Native User Service Plan'[ServicePlanName]),
			    TREATAS(_users,'Native User Service Plan'[TenantUserKey]),TREATAS(_batches,'Native User Service Plan'[Loaded Batch ID]))
			VAR _allLicenses=CALCULATETABLE(SELECTCOLUMNS('Native User License',
			    "LicenseUser",'Native User License'[TenantUserKey],"LicenseBatch",'Native User License'[Loaded Batch ID],
			    "LicenseSku",'Native User License'[TenantSkuKey],"LicenseState",'Native User License'[AssignmentState]),
			    TREATAS(_users,'Native User License'[TenantUserKey]),TREATAS(_batches,'Native User License'[Loaded Batch ID]))
			VAR _licenses=FILTER(_allLicenses,[LicenseState] IN {"Active","Success"})
			VAR _skus=SELECTCOLUMNS('Native License SKU',"SkuKey",'Native License SKU'[TenantSkuKey],
			    "SkuBatch",'Native License SKU'[Loaded Batch ID],"SkuPart",'Native License SKU'[SkuPartNumber])
			VAR _keys=DISTINCT(SELECTCOLUMNS(_scope,"Person",[Person],"Batch",[Batch]))
			RETURN GENERATE(_keys,
			    VAR _person=[Person] VAR _batch=[Batch]
			    VAR _rows=FILTER(_scope,[Person]=_person && [Batch]=_batch)
			    VAR _user=MAXX(_rows,[Cloud])
			    VAR _local=COUNTROWS(FILTER(_rows,[Retained]="Matched retained decision"))>0
			    VAR _remote=COUNTROWS(FILTER(_rows,[Retained]<>"Matched retained decision"))>0
			    VAR _special=COUNTROWS(FILTER(_rows,[Kind]<>"UserMailbox"))>0
			    VAR _pending=SUMX(_rows,VAR _object=[Object] VAR _address=[Address]
			        RETURN IF(COUNTROWS(FILTER(_exceptions,[ExceptionBatch]=_batch &&
			            ((_object<>"" && ([Identity]="local_mailboxes|" & _object || [Candidate]="local_mailboxes|" & _object)) ||
			             (_address<>"" && [ExceptionAddress]=_address))))>0,1,0))>0
			    VAR _unknown=COUNTROWS(FILTER(_rows,ISBLANK([Size]) || [Size]<0 || [Size]>100 ||
			        NOT([Archive] IN {"None","Disabled","Local","Active","HostedProvisioned","HostedPending"}) ||
			        NOT([Hold] IN {"None observed","Review - preserve settings"}) || ISBLANK([Access]) || ISBLANK([Send])))>0
			    VAR _large=COUNTROWS(FILTER(_rows,[Size]>2 || NOT([Archive] IN {"None","Disabled"}) ||
			        [Hold]="Review - preserve settings" || [Access]>0 || [Send]>0 || [Behalf]<>""))>0
			    VAR _review=_batch="" || _user="" || COUNTROWS(FILTER(_rows,[Link]<>"Unique AD GUID + native SID"))>0 || (_local && _remote)
			    VAR _bucket=SWITCH(TRUE(),_special,"Special",_local && NOT(_remote),"SE",_pending,"Register review",_review,"Identity review",
			        _unknown,"Technical review",_large,"E3","F3")
			    VAR _userPlans=FILTER(_plans,[PlanUser]=_user && [PlanBatch]=_batch && _user<>"")
			    VAR _p2=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_ENTERPRISE"))>0
			    VAR _p1=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_STANDARD"))>0
			    VAR _kiosk=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_DESKLESS"))>0
			    VAR _assigned=SELECTCOLUMNS(FILTER(_licenses,[LicenseUser]=_user && [LicenseBatch]=_batch && _user<>""),"Key",[LicenseSku])
			    VAR _suite=FILTER(_skus,[SkuKey] IN _assigned && [SkuBatch]=_batch)
			    VAR _e3=COUNTROWS(FILTER(_suite,[SkuPart] IN {"SPE_E3","SPE_E5"}))>0
			    VAR _f3=COUNTROWS(FILTER(_suite,[SkuPart]="SPE_F1"))>0
			    VAR _covered=SWITCH(_bucket,"SE",IF(_e3 || _p1 || _p2,1,0),"E3",IF(_e3,1,0),
			        "F3",IF(_f3 || _e3,1,0),0)
			    VAR _failed=SELECTCOLUMNS(FILTER(_allLicenses,[LicenseUser]=_user && [LicenseBatch]=_batch &&
			        NOT([LicenseState] IN {"Active","Success"})),"Key",[LicenseSku])
			    VAR _failedTarget=COUNTROWS(FILTER(_skus,[SkuKey] IN _failed && [SkuBatch]=_batch &&
			        ([SkuPart] IN {"SPE_E3","SPE_E5"} || (_bucket="F3" && [SkuPart]="SPE_F1"))))>0
			    VAR _target=IF(_bucket IN {"E3","F3"} && _covered=0 && _failedTarget,"Assignment review",_bucket)
			    VAR _planReview=_covered=1 && SWITCH(_bucket,"E3",NOT(_p2),"F3",NOT(_p2 || _p1 || _kiosk),FALSE())
			    RETURN ROW("Product",_target,"Covered",_covered,"Plan Review",IF(_planReview,1,0))))
			RETURN IF([Dataset Loaded Batch ID]<>"",COALESCE(COUNTROWS(FILTER(_people,[Product] IN {"Register review","Identity review","Technical review","Assignment review"})),0))
		formatString: #,0
		displayFolder: Migration licensing scenario

	/// Estimate under approved mailbox sizing assumptions. Not a contractual order. Distinct same-batch people; retained and unresolved exception identities never migrate automatically.
	measure 'Exchange Scenario Plan Remediation' =
			VAR _people=(VAR _scope=SELECTCOLUMNS('Exchange Mailbox Reconciliation',
			    "Person",IF('Exchange Mailbox Reconciliation'[Cloud Account Key]<>"","cloud|" & 'Exchange Mailbox Reconciliation'[Cloud Account Key],
			        IF('Exchange Mailbox Reconciliation'[AD Account Key]<>"","ad|" & 'Exchange Mailbox Reconciliation'[AD Account Key],"mailbox|" & 'Exchange Mailbox Reconciliation'[Mailbox GUID])),
			    "Batch",'Exchange Mailbox Reconciliation'[Loaded Batch ID],
			    "Cloud",'Exchange Mailbox Reconciliation'[Cloud Account Key],
			    "Object",LOWER(TRIM('Exchange Mailbox Reconciliation'[Object GUID])),
			    "Address",LOWER(TRIM('Exchange Mailbox Reconciliation'[Primary SMTP Address])),
			    "Kind",'Exchange Mailbox Reconciliation'[Mailbox Type],
			    "Size",'Exchange Mailbox Reconciliation'[Mailbox Size GB],
			    "Archive",'Exchange Mailbox Reconciliation'[Archive State],
			    "Hold",'Exchange Mailbox Reconciliation'[Hold and Retention],
			    "Access",'Exchange Mailbox Reconciliation'[Full Access Count],
			    "Send",'Exchange Mailbox Reconciliation'[Send As Count],
			    "Behalf",'Exchange Mailbox Reconciliation'[Send On Behalf],
			    "Retained",'Exchange Mailbox Reconciliation'[Retained On-premises],
			    "Link",'Exchange Mailbox Reconciliation'[Account Link])
			VAR _exceptions=SELECTCOLUMNS(FILTER('Mailbox Migration Exceptions',
			    'Mailbox Migration Exceptions'[Requires Review]=1),
			    "ExceptionBatch",'Mailbox Migration Exceptions'[Loaded Batch ID],
			    "Identity",LOWER(TRIM('Mailbox Migration Exceptions'[Mailbox Identity])),
			    "Candidate",LOWER(TRIM('Mailbox Migration Exceptions'[Candidate Identity])),
			    "ExceptionAddress",LOWER(TRIM('Mailbox Migration Exceptions'[Primary SMTP Address])))
			VAR _users=DISTINCT(SELECTCOLUMNS(FILTER(_scope,[Cloud]<>""),"User",[Cloud]))
			VAR _batches=DISTINCT(SELECTCOLUMNS(_scope,"Batch",[Batch]))
			VAR _plans=CALCULATETABLE(SELECTCOLUMNS(FILTER('Native User Service Plan',
			    LOWER('Native User Service Plan'[IsEnabled] & "")="true" && 'Native User Service Plan'[AssignmentState]="Success" &&
			    'Native User Service Plan'[ServicePlanName] IN {"EXCHANGE_S_STANDARD","EXCHANGE_S_ENTERPRISE","EXCHANGE_S_DESKLESS"}),
			    "PlanUser",'Native User Service Plan'[TenantUserKey],"PlanBatch",'Native User Service Plan'[Loaded Batch ID],"Plan",'Native User Service Plan'[ServicePlanName]),
			    TREATAS(_users,'Native User Service Plan'[TenantUserKey]),TREATAS(_batches,'Native User Service Plan'[Loaded Batch ID]))
			VAR _allLicenses=CALCULATETABLE(SELECTCOLUMNS('Native User License',
			    "LicenseUser",'Native User License'[TenantUserKey],"LicenseBatch",'Native User License'[Loaded Batch ID],
			    "LicenseSku",'Native User License'[TenantSkuKey],"LicenseState",'Native User License'[AssignmentState]),
			    TREATAS(_users,'Native User License'[TenantUserKey]),TREATAS(_batches,'Native User License'[Loaded Batch ID]))
			VAR _licenses=FILTER(_allLicenses,[LicenseState] IN {"Active","Success"})
			VAR _skus=SELECTCOLUMNS('Native License SKU',"SkuKey",'Native License SKU'[TenantSkuKey],
			    "SkuBatch",'Native License SKU'[Loaded Batch ID],"SkuPart",'Native License SKU'[SkuPartNumber])
			VAR _keys=DISTINCT(SELECTCOLUMNS(_scope,"Person",[Person],"Batch",[Batch]))
			RETURN GENERATE(_keys,
			    VAR _person=[Person] VAR _batch=[Batch]
			    VAR _rows=FILTER(_scope,[Person]=_person && [Batch]=_batch)
			    VAR _user=MAXX(_rows,[Cloud])
			    VAR _local=COUNTROWS(FILTER(_rows,[Retained]="Matched retained decision"))>0
			    VAR _remote=COUNTROWS(FILTER(_rows,[Retained]<>"Matched retained decision"))>0
			    VAR _special=COUNTROWS(FILTER(_rows,[Kind]<>"UserMailbox"))>0
			    VAR _pending=SUMX(_rows,VAR _object=[Object] VAR _address=[Address]
			        RETURN IF(COUNTROWS(FILTER(_exceptions,[ExceptionBatch]=_batch &&
			            ((_object<>"" && ([Identity]="local_mailboxes|" & _object || [Candidate]="local_mailboxes|" & _object)) ||
			             (_address<>"" && [ExceptionAddress]=_address))))>0,1,0))>0
			    VAR _unknown=COUNTROWS(FILTER(_rows,ISBLANK([Size]) || [Size]<0 || [Size]>100 ||
			        NOT([Archive] IN {"None","Disabled","Local","Active","HostedProvisioned","HostedPending"}) ||
			        NOT([Hold] IN {"None observed","Review - preserve settings"}) || ISBLANK([Access]) || ISBLANK([Send])))>0
			    VAR _large=COUNTROWS(FILTER(_rows,[Size]>2 || NOT([Archive] IN {"None","Disabled"}) ||
			        [Hold]="Review - preserve settings" || [Access]>0 || [Send]>0 || [Behalf]<>""))>0
			    VAR _review=_batch="" || _user="" || COUNTROWS(FILTER(_rows,[Link]<>"Unique AD GUID + native SID"))>0 || (_local && _remote)
			    VAR _bucket=SWITCH(TRUE(),_special,"Special",_local && NOT(_remote),"SE",_pending,"Register review",_review,"Identity review",
			        _unknown,"Technical review",_large,"E3","F3")
			    VAR _userPlans=FILTER(_plans,[PlanUser]=_user && [PlanBatch]=_batch && _user<>"")
			    VAR _p2=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_ENTERPRISE"))>0
			    VAR _p1=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_STANDARD"))>0
			    VAR _kiosk=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_DESKLESS"))>0
			    VAR _assigned=SELECTCOLUMNS(FILTER(_licenses,[LicenseUser]=_user && [LicenseBatch]=_batch && _user<>""),"Key",[LicenseSku])
			    VAR _suite=FILTER(_skus,[SkuKey] IN _assigned && [SkuBatch]=_batch)
			    VAR _e3=COUNTROWS(FILTER(_suite,[SkuPart] IN {"SPE_E3","SPE_E5"}))>0
			    VAR _f3=COUNTROWS(FILTER(_suite,[SkuPart]="SPE_F1"))>0
			    VAR _covered=SWITCH(_bucket,"SE",IF(_e3 || _p1 || _p2,1,0),"E3",IF(_e3,1,0),
			        "F3",IF(_f3 || _e3,1,0),0)
			    VAR _failed=SELECTCOLUMNS(FILTER(_allLicenses,[LicenseUser]=_user && [LicenseBatch]=_batch &&
			        NOT([LicenseState] IN {"Active","Success"})),"Key",[LicenseSku])
			    VAR _failedTarget=COUNTROWS(FILTER(_skus,[SkuKey] IN _failed && [SkuBatch]=_batch &&
			        ([SkuPart] IN {"SPE_E3","SPE_E5"} || (_bucket="F3" && [SkuPart]="SPE_F1"))))>0
			    VAR _target=IF(_bucket IN {"E3","F3"} && _covered=0 && _failedTarget,"Assignment review",_bucket)
			    VAR _planReview=_covered=1 && SWITCH(_bucket,"E3",NOT(_p2),"F3",NOT(_p2 || _p1 || _kiosk),FALSE())
			    RETURN ROW("Product",_target,"Covered",_covered,"Plan Review",IF(_planReview,1,0))))
			RETURN IF([Dataset Loaded Batch ID]<>"",COALESCE(SUMX(_people,[Plan Review]),0))
		formatString: #,0
		displayFolder: Migration licensing scenario

	/// Estimate under approved mailbox sizing assumptions. Not a contractual order. Distinct same-batch people; retained and unresolved exception identities never migrate automatically.
	measure 'Exchange Scenario Register Review Rows' = VAR _batch=[Dataset Loaded Batch ID] RETURN IF(_batch<>"",CALCULATE(COUNTROWS('Mailbox Migration Exceptions'),REMOVEFILTERS('Mailbox Migration Exceptions'),'Mailbox Migration Exceptions'[Loaded Batch ID]=_batch,'Mailbox Migration Exceptions'[Requires Review]=1))
		formatString: #,0
		displayFolder: Migration licensing scenario

	/// Estimate under approved mailbox sizing assumptions. Not a contractual order. Distinct same-batch people; retained and unresolved exception identities never migrate automatically.
	measure 'Exchange Scenario Row Target' =
			VAR _people=(VAR _scope=SELECTCOLUMNS('Exchange Mailbox Reconciliation',
			    "Person",IF('Exchange Mailbox Reconciliation'[Cloud Account Key]<>"","cloud|" & 'Exchange Mailbox Reconciliation'[Cloud Account Key],
			        IF('Exchange Mailbox Reconciliation'[AD Account Key]<>"","ad|" & 'Exchange Mailbox Reconciliation'[AD Account Key],"mailbox|" & 'Exchange Mailbox Reconciliation'[Mailbox GUID])),
			    "Batch",'Exchange Mailbox Reconciliation'[Loaded Batch ID],
			    "Cloud",'Exchange Mailbox Reconciliation'[Cloud Account Key],
			    "Object",LOWER(TRIM('Exchange Mailbox Reconciliation'[Object GUID])),
			    "Address",LOWER(TRIM('Exchange Mailbox Reconciliation'[Primary SMTP Address])),
			    "Kind",'Exchange Mailbox Reconciliation'[Mailbox Type],
			    "Size",'Exchange Mailbox Reconciliation'[Mailbox Size GB],
			    "Archive",'Exchange Mailbox Reconciliation'[Archive State],
			    "Hold",'Exchange Mailbox Reconciliation'[Hold and Retention],
			    "Access",'Exchange Mailbox Reconciliation'[Full Access Count],
			    "Send",'Exchange Mailbox Reconciliation'[Send As Count],
			    "Behalf",'Exchange Mailbox Reconciliation'[Send On Behalf],
			    "Retained",'Exchange Mailbox Reconciliation'[Retained On-premises],
			    "Link",'Exchange Mailbox Reconciliation'[Account Link])
			VAR _exceptions=SELECTCOLUMNS(FILTER('Mailbox Migration Exceptions',
			    'Mailbox Migration Exceptions'[Requires Review]=1),
			    "ExceptionBatch",'Mailbox Migration Exceptions'[Loaded Batch ID],
			    "Identity",LOWER(TRIM('Mailbox Migration Exceptions'[Mailbox Identity])),
			    "Candidate",LOWER(TRIM('Mailbox Migration Exceptions'[Candidate Identity])),
			    "ExceptionAddress",LOWER(TRIM('Mailbox Migration Exceptions'[Primary SMTP Address])))
			VAR _users=DISTINCT(SELECTCOLUMNS(FILTER(_scope,[Cloud]<>""),"User",[Cloud]))
			VAR _batches=DISTINCT(SELECTCOLUMNS(_scope,"Batch",[Batch]))
			VAR _plans=CALCULATETABLE(SELECTCOLUMNS(FILTER('Native User Service Plan',
			    LOWER('Native User Service Plan'[IsEnabled] & "")="true" && 'Native User Service Plan'[AssignmentState]="Success" &&
			    'Native User Service Plan'[ServicePlanName] IN {"EXCHANGE_S_STANDARD","EXCHANGE_S_ENTERPRISE","EXCHANGE_S_DESKLESS"}),
			    "PlanUser",'Native User Service Plan'[TenantUserKey],"PlanBatch",'Native User Service Plan'[Loaded Batch ID],"Plan",'Native User Service Plan'[ServicePlanName]),
			    TREATAS(_users,'Native User Service Plan'[TenantUserKey]),TREATAS(_batches,'Native User Service Plan'[Loaded Batch ID]))
			VAR _allLicenses=CALCULATETABLE(SELECTCOLUMNS('Native User License',
			    "LicenseUser",'Native User License'[TenantUserKey],"LicenseBatch",'Native User License'[Loaded Batch ID],
			    "LicenseSku",'Native User License'[TenantSkuKey],"LicenseState",'Native User License'[AssignmentState]),
			    TREATAS(_users,'Native User License'[TenantUserKey]),TREATAS(_batches,'Native User License'[Loaded Batch ID]))
			VAR _licenses=FILTER(_allLicenses,[LicenseState] IN {"Active","Success"})
			VAR _skus=SELECTCOLUMNS('Native License SKU',"SkuKey",'Native License SKU'[TenantSkuKey],
			    "SkuBatch",'Native License SKU'[Loaded Batch ID],"SkuPart",'Native License SKU'[SkuPartNumber])
			VAR _keys=DISTINCT(SELECTCOLUMNS(_scope,"Person",[Person],"Batch",[Batch]))
			RETURN GENERATE(_keys,
			    VAR _person=[Person] VAR _batch=[Batch]
			    VAR _rows=FILTER(_scope,[Person]=_person && [Batch]=_batch)
			    VAR _user=MAXX(_rows,[Cloud])
			    VAR _local=COUNTROWS(FILTER(_rows,[Retained]="Matched retained decision"))>0
			    VAR _remote=COUNTROWS(FILTER(_rows,[Retained]<>"Matched retained decision"))>0
			    VAR _special=COUNTROWS(FILTER(_rows,[Kind]<>"UserMailbox"))>0
			    VAR _pending=SUMX(_rows,VAR _object=[Object] VAR _address=[Address]
			        RETURN IF(COUNTROWS(FILTER(_exceptions,[ExceptionBatch]=_batch &&
			            ((_object<>"" && ([Identity]="local_mailboxes|" & _object || [Candidate]="local_mailboxes|" & _object)) ||
			             (_address<>"" && [ExceptionAddress]=_address))))>0,1,0))>0
			    VAR _unknown=COUNTROWS(FILTER(_rows,ISBLANK([Size]) || [Size]<0 || [Size]>100 ||
			        NOT([Archive] IN {"None","Disabled","Local","Active","HostedProvisioned","HostedPending"}) ||
			        NOT([Hold] IN {"None observed","Review - preserve settings"}) || ISBLANK([Access]) || ISBLANK([Send])))>0
			    VAR _large=COUNTROWS(FILTER(_rows,[Size]>2 || NOT([Archive] IN {"None","Disabled"}) ||
			        [Hold]="Review - preserve settings" || [Access]>0 || [Send]>0 || [Behalf]<>""))>0
			    VAR _review=_batch="" || _user="" || COUNTROWS(FILTER(_rows,[Link]<>"Unique AD GUID + native SID"))>0 || (_local && _remote)
			    VAR _bucket=SWITCH(TRUE(),_special,"Special",_local && NOT(_remote),"SE",_pending,"Register review",_review,"Identity review",
			        _unknown,"Technical review",_large,"E3","F3")
			    VAR _userPlans=FILTER(_plans,[PlanUser]=_user && [PlanBatch]=_batch && _user<>"")
			    VAR _p2=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_ENTERPRISE"))>0
			    VAR _p1=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_STANDARD"))>0
			    VAR _kiosk=COUNTROWS(FILTER(_userPlans,[Plan]="EXCHANGE_S_DESKLESS"))>0
			    VAR _assigned=SELECTCOLUMNS(FILTER(_licenses,[LicenseUser]=_user && [LicenseBatch]=_batch && _user<>""),"Key",[LicenseSku])
			    VAR _suite=FILTER(_skus,[SkuKey] IN _assigned && [SkuBatch]=_batch)
			    VAR _e3=COUNTROWS(FILTER(_suite,[SkuPart] IN {"SPE_E3","SPE_E5"}))>0
			    VAR _f3=COUNTROWS(FILTER(_suite,[SkuPart]="SPE_F1"))>0
			    VAR _covered=SWITCH(_bucket,"SE",IF(_e3 || _p1 || _p2,1,0),"E3",IF(_e3,1,0),
			        "F3",IF(_f3 || _e3,1,0),0)
			    VAR _failed=SELECTCOLUMNS(FILTER(_allLicenses,[LicenseUser]=_user && [LicenseBatch]=_batch &&
			        NOT([LicenseState] IN {"Active","Success"})),"Key",[LicenseSku])
			    VAR _failedTarget=COUNTROWS(FILTER(_skus,[SkuKey] IN _failed && [SkuBatch]=_batch &&
			        ([SkuPart] IN {"SPE_E3","SPE_E5"} || (_bucket="F3" && [SkuPart]="SPE_F1"))))>0
			    VAR _target=IF(_bucket IN {"E3","F3"} && _covered=0 && _failedTarget,"Assignment review",_bucket)
			    VAR _planReview=_covered=1 && SWITCH(_bucket,"E3",NOT(_p2),"F3",NOT(_p2 || _p1 || _kiosk),FALSE())
			    RETURN ROW("Product",_target,"Covered",_covered,"Plan Review",IF(_planReview,1,0))))
			VAR _products=DISTINCT(SELECTCOLUMNS(_people,"Target",[Product])) RETURN IF(COUNTROWS(_products)=1,CONCATENATEX(_products,[Target],""),"Multiple targets / review")
		formatString: @
		displayFolder: Migration licensing scenario

	/// Estimate under approved mailbox sizing assumptions. Not a contractual order. Distinct same-batch people; retained and unresolved exception identities never migrate automatically.
	measure 'Exchange Scenario Note' = "ESTIMATE: F3 <=2 GB, no archive/hold/delegation; frontline eligibility assumed. E3 for other known user cases <=100 GB. Assigned suites deducted even if a service plan needs repair; tenant stock assumed allocatable, shared across countries, not reserved. SE = confirmed retained users; CAL stock/SA and other accessors unknown. Unpriced people: " & FORMAT([Exchange Scenario Review People],"0") & " | Register rows to reconcile: " & FORMAT([Exchange Scenario Register Review Rows],"0") & " | Plan repairs (not purchases): " & FORMAT([Exchange Scenario Plan Remediation],"0")
		formatString: @
		displayFolder: Migration licensing scenario

	/// Distinct same-batch native mailbox GUIDs. Mailbox counts are not licence quantities. Confirmed register retention takes precedence over duplicate pending hints.
	measure 'Exchange Population Total' =
			VAR _mailboxes=(VAR _scope=SELECTCOLUMNS('Exchange Mailbox Reconciliation',
			    "Mailbox",'Exchange Mailbox Reconciliation'[Mailbox GUID],
			    "Batch",'Exchange Mailbox Reconciliation'[Loaded Batch ID],
			    "Object",LOWER(TRIM('Exchange Mailbox Reconciliation'[Object GUID])),
			    "Address",LOWER(TRIM('Exchange Mailbox Reconciliation'[Primary SMTP Address])),
			    "Retained",'Exchange Mailbox Reconciliation'[Retained On-premises])
			VAR _exceptions=SELECTCOLUMNS(FILTER('Mailbox Migration Exceptions',
			    'Mailbox Migration Exceptions'[Requires Review]=1),
			    "ExceptionBatch",'Mailbox Migration Exceptions'[Loaded Batch ID],
			    "Identity",LOWER(TRIM('Mailbox Migration Exceptions'[Mailbox Identity])),
			    "Candidate",LOWER(TRIM('Mailbox Migration Exceptions'[Candidate Identity])),
			    "ExceptionAddress",LOWER(TRIM('Mailbox Migration Exceptions'[Primary SMTP Address])))
			VAR _batches=DISTINCT(SELECTCOLUMNS(_scope,"Batch",[Batch]))
			VAR _valid=COUNTROWS(_batches)=1 && COUNTROWS(FILTER(_scope,[Batch]="" || [Mailbox]=""))=0
			VAR _keys=DISTINCT(SELECTCOLUMNS(_scope,"Mailbox",[Mailbox],"Batch",[Batch]))
			RETURN GENERATE(FILTER(_keys,_valid),
			    VAR _mailbox=[Mailbox] VAR _batch=[Batch]
			    VAR _rows=FILTER(_scope,[Mailbox]=_mailbox && [Batch]=_batch)
			    VAR _retained=COUNTROWS(FILTER(_rows,[Retained]="Matched retained decision"))>0
			    VAR _pending=SUMX(_rows,VAR _object=[Object] VAR _address=[Address]
			        RETURN IF(COUNTROWS(FILTER(_exceptions,[ExceptionBatch]=_batch &&
			            ((_object<>"" && ([Identity]="local_mailboxes|" & _object || [Candidate]="local_mailboxes|" & _object)) ||
			             (_address<>"" && [ExceptionAddress]=_address))))>0,1,0))>0
			    RETURN ROW("Population",SWITCH(TRUE(),_retained,"Register retained",_pending,"Register review","Potential before service review"))))
			RETURN IF(COUNTROWS(_mailboxes)>0,COALESCE(COUNTROWS(FILTER(_mailboxes,TRUE())),0))
		formatString: #,0
		displayFolder: Migration mailbox populations

	/// Distinct same-batch native mailbox GUIDs. Mailbox counts are not licence quantities. Confirmed register retention takes precedence over duplicate pending hints.
	measure 'Exchange Population Register Retained' =
			VAR _mailboxes=(VAR _scope=SELECTCOLUMNS('Exchange Mailbox Reconciliation',
			    "Mailbox",'Exchange Mailbox Reconciliation'[Mailbox GUID],
			    "Batch",'Exchange Mailbox Reconciliation'[Loaded Batch ID],
			    "Object",LOWER(TRIM('Exchange Mailbox Reconciliation'[Object GUID])),
			    "Address",LOWER(TRIM('Exchange Mailbox Reconciliation'[Primary SMTP Address])),
			    "Retained",'Exchange Mailbox Reconciliation'[Retained On-premises])
			VAR _exceptions=SELECTCOLUMNS(FILTER('Mailbox Migration Exceptions',
			    'Mailbox Migration Exceptions'[Requires Review]=1),
			    "ExceptionBatch",'Mailbox Migration Exceptions'[Loaded Batch ID],
			    "Identity",LOWER(TRIM('Mailbox Migration Exceptions'[Mailbox Identity])),
			    "Candidate",LOWER(TRIM('Mailbox Migration Exceptions'[Candidate Identity])),
			    "ExceptionAddress",LOWER(TRIM('Mailbox Migration Exceptions'[Primary SMTP Address])))
			VAR _batches=DISTINCT(SELECTCOLUMNS(_scope,"Batch",[Batch]))
			VAR _valid=COUNTROWS(_batches)=1 && COUNTROWS(FILTER(_scope,[Batch]="" || [Mailbox]=""))=0
			VAR _keys=DISTINCT(SELECTCOLUMNS(_scope,"Mailbox",[Mailbox],"Batch",[Batch]))
			RETURN GENERATE(FILTER(_keys,_valid),
			    VAR _mailbox=[Mailbox] VAR _batch=[Batch]
			    VAR _rows=FILTER(_scope,[Mailbox]=_mailbox && [Batch]=_batch)
			    VAR _retained=COUNTROWS(FILTER(_rows,[Retained]="Matched retained decision"))>0
			    VAR _pending=SUMX(_rows,VAR _object=[Object] VAR _address=[Address]
			        RETURN IF(COUNTROWS(FILTER(_exceptions,[ExceptionBatch]=_batch &&
			            ((_object<>"" && ([Identity]="local_mailboxes|" & _object || [Candidate]="local_mailboxes|" & _object)) ||
			             (_address<>"" && [ExceptionAddress]=_address))))>0,1,0))>0
			    RETURN ROW("Population",SWITCH(TRUE(),_retained,"Register retained",_pending,"Register review","Potential before service review"))))
			RETURN IF(COUNTROWS(_mailboxes)>0,COALESCE(COUNTROWS(FILTER(_mailboxes,[Population]="Register retained")),0))
		formatString: #,0
		displayFolder: Migration mailbox populations

	/// Distinct same-batch native mailbox GUIDs. Mailbox counts are not licence quantities. Confirmed register retention takes precedence over duplicate pending hints.
	measure 'Exchange Population Register Review' =
			VAR _mailboxes=(VAR _scope=SELECTCOLUMNS('Exchange Mailbox Reconciliation',
			    "Mailbox",'Exchange Mailbox Reconciliation'[Mailbox GUID],
			    "Batch",'Exchange Mailbox Reconciliation'[Loaded Batch ID],
			    "Object",LOWER(TRIM('Exchange Mailbox Reconciliation'[Object GUID])),
			    "Address",LOWER(TRIM('Exchange Mailbox Reconciliation'[Primary SMTP Address])),
			    "Retained",'Exchange Mailbox Reconciliation'[Retained On-premises])
			VAR _exceptions=SELECTCOLUMNS(FILTER('Mailbox Migration Exceptions',
			    'Mailbox Migration Exceptions'[Requires Review]=1),
			    "ExceptionBatch",'Mailbox Migration Exceptions'[Loaded Batch ID],
			    "Identity",LOWER(TRIM('Mailbox Migration Exceptions'[Mailbox Identity])),
			    "Candidate",LOWER(TRIM('Mailbox Migration Exceptions'[Candidate Identity])),
			    "ExceptionAddress",LOWER(TRIM('Mailbox Migration Exceptions'[Primary SMTP Address])))
			VAR _batches=DISTINCT(SELECTCOLUMNS(_scope,"Batch",[Batch]))
			VAR _valid=COUNTROWS(_batches)=1 && COUNTROWS(FILTER(_scope,[Batch]="" || [Mailbox]=""))=0
			VAR _keys=DISTINCT(SELECTCOLUMNS(_scope,"Mailbox",[Mailbox],"Batch",[Batch]))
			RETURN GENERATE(FILTER(_keys,_valid),
			    VAR _mailbox=[Mailbox] VAR _batch=[Batch]
			    VAR _rows=FILTER(_scope,[Mailbox]=_mailbox && [Batch]=_batch)
			    VAR _retained=COUNTROWS(FILTER(_rows,[Retained]="Matched retained decision"))>0
			    VAR _pending=SUMX(_rows,VAR _object=[Object] VAR _address=[Address]
			        RETURN IF(COUNTROWS(FILTER(_exceptions,[ExceptionBatch]=_batch &&
			            ((_object<>"" && ([Identity]="local_mailboxes|" & _object || [Candidate]="local_mailboxes|" & _object)) ||
			             (_address<>"" && [ExceptionAddress]=_address))))>0,1,0))>0
			    RETURN ROW("Population",SWITCH(TRUE(),_retained,"Register retained",_pending,"Register review","Potential before service review"))))
			RETURN IF(COUNTROWS(_mailboxes)>0,COALESCE(COUNTROWS(FILTER(_mailboxes,[Population]="Register review")),0))
		formatString: #,0
		displayFolder: Migration mailbox populations

	/// Distinct same-batch native mailbox GUIDs. Mailbox counts are not licence quantities. Confirmed register retention takes precedence over duplicate pending hints.
	measure 'Exchange Population Potential Before Service Review' =
			VAR _mailboxes=(VAR _scope=SELECTCOLUMNS('Exchange Mailbox Reconciliation',
			    "Mailbox",'Exchange Mailbox Reconciliation'[Mailbox GUID],
			    "Batch",'Exchange Mailbox Reconciliation'[Loaded Batch ID],
			    "Object",LOWER(TRIM('Exchange Mailbox Reconciliation'[Object GUID])),
			    "Address",LOWER(TRIM('Exchange Mailbox Reconciliation'[Primary SMTP Address])),
			    "Retained",'Exchange Mailbox Reconciliation'[Retained On-premises])
			VAR _exceptions=SELECTCOLUMNS(FILTER('Mailbox Migration Exceptions',
			    'Mailbox Migration Exceptions'[Requires Review]=1),
			    "ExceptionBatch",'Mailbox Migration Exceptions'[Loaded Batch ID],
			    "Identity",LOWER(TRIM('Mailbox Migration Exceptions'[Mailbox Identity])),
			    "Candidate",LOWER(TRIM('Mailbox Migration Exceptions'[Candidate Identity])),
			    "ExceptionAddress",LOWER(TRIM('Mailbox Migration Exceptions'[Primary SMTP Address])))
			VAR _batches=DISTINCT(SELECTCOLUMNS(_scope,"Batch",[Batch]))
			VAR _valid=COUNTROWS(_batches)=1 && COUNTROWS(FILTER(_scope,[Batch]="" || [Mailbox]=""))=0
			VAR _keys=DISTINCT(SELECTCOLUMNS(_scope,"Mailbox",[Mailbox],"Batch",[Batch]))
			RETURN GENERATE(FILTER(_keys,_valid),
			    VAR _mailbox=[Mailbox] VAR _batch=[Batch]
			    VAR _rows=FILTER(_scope,[Mailbox]=_mailbox && [Batch]=_batch)
			    VAR _retained=COUNTROWS(FILTER(_rows,[Retained]="Matched retained decision"))>0
			    VAR _pending=SUMX(_rows,VAR _object=[Object] VAR _address=[Address]
			        RETURN IF(COUNTROWS(FILTER(_exceptions,[ExceptionBatch]=_batch &&
			            ((_object<>"" && ([Identity]="local_mailboxes|" & _object || [Candidate]="local_mailboxes|" & _object)) ||
			             (_address<>"" && [ExceptionAddress]=_address))))>0,1,0))>0
			    RETURN ROW("Population",SWITCH(TRUE(),_retained,"Register retained",_pending,"Register review","Potential before service review"))))
			RETURN IF(COUNTROWS(_mailboxes)>0,COALESCE(COUNTROWS(FILTER(_mailboxes,[Population]="Potential before service review")),0))
		formatString: #,0
		displayFolder: Migration mailbox populations

	/// The prepared AD user source lacks governed AccountType; Workforce excludes non-human service accounts. Generic accounts and managed-service object classes are not substitutes. No service count or complete retained union can be inferred.
	measure 'Exchange Population Service Label' = "Not captured"
		formatString: @
		displayFolder: Migration mailbox populations

	/// Upper bound for the currently unquarantined mailbox pool, before service-account exclusion and technical checks. Excludes confirmed retained mailboxes and pending exact native-ID/SMTP hints, deduplicated. Not an EXO licence requirement.
	measure 'Exchange Population Potential Label' =
			VAR _n=[Exchange Population Potential Before Service Review]
			RETURN IF(ISBLANK(_n),"Unknown", "At most " & FORMAT(_n,"#,0"))
		formatString: @
		displayFolder: Migration mailbox populations

	/// Known minimum estimated SE user-licence scope: distinct confirmed retained user identities. Service-account scope, special-mailbox accessors and other accessors are incomplete. Observed equivalents are not subtracted from this total. Not a net purchase quantity.
	measure 'Exchange Scenario SE Required Label' =
			VAR _n=[Exchange Scenario SE Need]
			RETURN IF(ISBLANK(_n),"Unknown",">= " & FORMAT(_n,"#,0"))
		formatString: @
		displayFolder: Migration mailbox populations

	/// Distinct same-batch native mailbox GUIDs. Mailbox counts are not licence quantities. Confirmed register retention takes precedence over duplicate pending hints.
	measure 'Exchange Population Note' = "INCOMPLETE SERVICE SCOPE: classification is not captured; Generic is not Service. Potential EXO excludes confirmed retention and " & FORMAT([Exchange Population Register Review],"0") & " other mailboxes with pending register hints; upper bound before service/technical review, not licence demand. SE = known minimum user scope; service accounts and other accessors uncounted. ESTIMATE: F3 <=2 GB, no archive/hold/delegation, frontline eligibility assumed; E3 for other known user cases <=100 GB. Assigned suites deducted; free tenant stock shared, assumed allocatable, not reserved. " & FORMAT([Exchange Scenario Register Review Rows],"0") & " register rows to reconcile; " & FORMAT([Exchange Scenario Review People],"0") & " unpriced people; " & FORMAT([Exchange Scenario Plan Remediation],"0") & " plan repairs, not purchases."
		formatString: @
		displayFolder: Migration mailbox populations

