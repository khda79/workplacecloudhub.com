		sourceColumn: [SE CAL Review]

	column 'Licensing Decision'
		dataType: string
		lineageTag: 66967cc8-1126-4145-a873-8a12f994ebb5
		summarizeBy: none
		sourceColumn: [Licensing Decision]

	partition 'Exchange Mailbox Reconciliation' = calculated
		mode: import
		source =
				VAR _source0 = SELECTCOLUMNS('Exchange Mailbox Server Reference', "Loaded Batch ID", 'Exchange Mailbox Server Reference'[Loaded Batch ID], "Object GUID", 'Exchange Mailbox Server Reference'[Object GUID], "Server Name", 'Exchange Mailbox Server Reference'[Server Name])
				VAR _source1 = SELECTCOLUMNS('AD User Evidence', "CloudMatchStatus", 'AD User Evidence'[CloudMatchStatus], "Loaded Batch ID", 'AD User Evidence'[Loaded Batch ID], "ObjectGUID", 'AD User Evidence'[ObjectGUID], "TenantADUserKey", 'AD User Evidence'[TenantADUserKey], "TenantUserKey", 'AD User Evidence'[TenantUserKey], "Title", 'AD User Evidence'[Title], "UserPrincipalName", 'AD User Evidence'[UserPrincipalName])
				VAR _source2 = SELECTCOLUMNS('Native User Evidence', "JobTitle", 'Native User Evidence'[JobTitle], "Loaded Batch ID", 'Native User Evidence'[Loaded Batch ID], "TenantUserKey", 'Native User Evidence'[TenantUserKey], "UserPrincipalName", 'Native User Evidence'[UserPrincipalName])
				VAR _source3 = SELECTCOLUMNS('Native User License', "Loaded Batch ID", 'Native User License'[Loaded Batch ID], "TenantSkuKey", 'Native User License'[TenantSkuKey], "TenantUserKey", 'Native User License'[TenantUserKey])
				VAR _source4 = SELECTCOLUMNS('Native License SKU', "Loaded Batch ID", 'Native License SKU'[Loaded Batch ID], "SkuPartNumber", 'Native License SKU'[SkuPartNumber], "TenantSkuKey", 'Native License SKU'[TenantSkuKey])
				VAR _source5 = FILTER(SELECTCOLUMNS('Native User Service Plan', "AssignmentState", 'Native User Service Plan'[AssignmentState], "IsEnabled", 'Native User Service Plan'[IsEnabled], "Loaded Batch ID", 'Native User Service Plan'[Loaded Batch ID], "ServicePlanName", 'Native User Service Plan'[ServicePlanName], "TenantUserKey", 'Native User Service Plan'[TenantUserKey]), LEFT([ServicePlanName],11)="EXCHANGE_S_")
				VAR _source6 = SELECTCOLUMNS('Mailbox Migration Exceptions', "Loaded Batch ID", 'Mailbox Migration Exceptions'[Loaded Batch ID], "Mailbox Identity", 'Mailbox Migration Exceptions'[Mailbox Identity], "Requires Review", 'Mailbox Migration Exceptions'[Requires Review], "Retained", 'Mailbox Migration Exceptions'[Retained], "Status", 'Mailbox Migration Exceptions'[Status])
				RETURN
				GENERATE(
				    SELECTCOLUMNS('Mailbox Migration Inventory',
				        "Mailbox GUID", 'Mailbox Migration Inventory'[Mailbox GUID],
				        "Object GUID", 'Mailbox Migration Inventory'[Object GUID],
				        "Mailbox", 'Mailbox Migration Inventory'[Display Name],
				        "Primary SMTP Address", 'Mailbox Migration Inventory'[Primary SMTP Address],
				        "Country", 'Mailbox Migration Inventory'[Country],
				        "Exchange Version", 'Mailbox Migration Inventory'[Exchange Version],
				        "Mailbox Type", 'Mailbox Migration Inventory'[Mailbox Type],
				        "Mailbox Size GB", 'Mailbox Migration Inventory'[Mailbox Size GB],
				        "Loaded Batch ID", 'Mailbox Migration Inventory'[Loaded Batch ID],
				        "Archive State", 'Mailbox Migration Inventory'[Archive State],
				        "Hold and Retention", 'Mailbox Migration Inventory'[Hold and Retention],
				        "Full Access Count", 'Mailbox Migration Inventory'[Full Access Count],
				        "Send As Count", 'Mailbox Migration Inventory'[Send As Count],
				        "Send On Behalf", 'Mailbox Migration Inventory'[Send On Behalf]),
				    VAR _object = LOWER(TRIM([Object GUID]))
				    VAR _batch = [Loaded Batch ID]
				    VAR _servers = FILTER(_source0, _object <> "" && _batch <> "" &&
				        [Object GUID] = _object && [Loaded Batch ID] = _batch)
				    VAR _ad = FILTER(_source1, _object <> "" && _batch <> "" &&
				        LOWER(TRIM([ObjectGUID])) = _object && [Loaded Batch ID] = _batch)
				    VAR _adUnique = COUNTROWS(_ad) = 1
				    VAR _adKey = IF(_adUnique, MAXX(_ad, [TenantADUserKey]))
				    VAR _cloudKey = IF(_adUnique && MAXX(_ad, [CloudMatchStatus]) = "Unique native SID",
				        MAXX(_ad, [TenantUserKey]))
				    VAR _cloud = FILTER(_source2, _cloudKey <> "" &&
				        [TenantUserKey] = _cloudKey && [Loaded Batch ID] = _batch)
				    VAR _cloudUnique = COUNTROWS(_cloud) = 1
				    VAR _user = IF(_cloudUnique, _cloudKey)
				    VAR _licenses = FILTER(_source3, _user <> "" &&
				        [TenantUserKey] = _user && [Loaded Batch ID] = _batch)
				    VAR _skuKeys = SELECTCOLUMNS(_licenses, "Key", [TenantSkuKey])
				    VAR _skus = FILTER(_source4, [TenantSkuKey] IN _skuKeys &&
				        [Loaded Batch ID] = _batch)
				    VAR _plans = FILTER(_source5, _user <> "" &&
				        [TenantUserKey] = _user && [Loaded Batch ID] = _batch &&
				        LEFT([ServicePlanName], 11) = "EXCHANGE_S_")
				    VAR _success = FILTER(_plans, LOWER([IsEnabled]) = "true" &&
				        [AssignmentState] = "Success")
				    VAR _p1 = COUNTROWS(FILTER(_success, [ServicePlanName] = "EXCHANGE_S_STANDARD")) > 0
				    VAR _p2 = COUNTROWS(FILTER(_success, [ServicePlanName] = "EXCHANGE_S_ENTERPRISE")) > 0
				    VAR _kiosk = COUNTROWS(FILTER(_success, [ServicePlanName] = "EXCHANGE_S_DESKLESS")) > 0
				    VAR _foundation = COUNTROWS(FILTER(_success, [ServicePlanName] = "EXCHANGE_S_FOUNDATION")) > 0
				    VAR _planNames = DISTINCT(SELECTCOLUMNS(_success, "Plan", [ServicePlanName]))
				    VAR _skuNames = DISTINCT(SELECTCOLUMNS(_skus, "SKU", [SkuPartNumber]))
				    VAR _exception = FILTER(_source6, _object <> "" &&
				        [Loaded Batch ID] = _batch &&
				        LOWER([Mailbox Identity]) = "local_mailboxes|" & _object &&
				        [Status] = "Matched local" && [Retained] = 1 &&
				        [Requires Review] = 0)
				    VAR _retained = COUNTROWS(_exception) > 0
				    VAR _userMailbox = [Mailbox Type] = "UserMailbox"
				    VAR _size = [Mailbox Size GB]
				    VAR _sizeUnknown = ISBLANK(_size) || _size < 0
				    VAR _features = NOT([Archive State] IN {"None", "Disabled", "Not observed", "Unknown", ""}) ||
				        [Hold and Retention] = "Review - preserve settings" || [Full Access Count] > 0 ||
				        [Send As Count] > 0 || [Send On Behalf] <> ""
				    RETURN ROW(
				        "Server Name", IF(COUNTROWS(_servers)=1,MAXX(_servers,[Server Name]),"Not observed"),
				        "AD Account Key", _adKey,
				        "Cloud Account Key", _user,
				        "Account Link", IF(NOT(_adUnique), IF(COUNTROWS(_ad)>1,"Ambiguous AD identity","No same-batch AD identity"),
				            IF(_cloudUnique,"Unique AD GUID + native SID",IF(COUNTROWS(_cloud)>1,"Ambiguous cloud identity","AD only; cloud unresolved"))),
				        "AD Account", IF(_adUnique, MAXX(_ad, [UserPrincipalName])),
				        "Entra Account", IF(_cloudUnique, MAXX(_cloud, [UserPrincipalName])),
				        "AD Job Title", IF(_adUnique, MAXX(_ad, [Title])),
				        "Entra Job Title", IF(_cloudUnique, MAXX(_cloud, [JobTitle])),
				        "Observed SKUs", IF(_user="","Unknown - unresolved account",COALESCE(CONCATENATEX(_skuNames,[SKU],"; ",[SKU],ASC),"None observed")),
				        "Successful Exchange Plans", IF(_user="","Unknown - unresolved account",COALESCE(CONCATENATEX(_planNames,[Plan],"; ",[Plan],ASC),"None observed")),
				        "Other Exchange Plan States", CONCATENATEX(DISTINCT(SELECTCOLUMNS(FILTER(_plans,
				            LOWER([IsEnabled]) <> "true" || [AssignmentState] <> "Success"),
				            "State", [ServicePlanName] & ": " & [AssignmentState])),[State],"; ",[State],ASC),
				        "Mailbox Plan Observation", SWITCH(TRUE(),_user="","Unknown - unresolved account",_p2,"Plan 2 observed",_p1,"Plan 1 observed",_kiosk,"Kiosk observed",_foundation,"Foundation only - no mailbox right","No mailbox plan observed"),
				        "Retained On-premises", IF(_retained,"Matched retained decision","No matched retained decision; review register"),
				        "F3 Review", SWITCH(TRUE(),NOT(_userMailbox),"Special mailbox - review accessors and features",
				            _sizeUnknown,"Unknown mailbox size - review",_size>2,"Above 2 GB - Kiosk alone insufficient",
				            _features,"Feature or delegation review required","At most 2 GB - frontline eligibility and usage unverified"),
				        "E3 Review", SWITCH(TRUE(),NOT(_userMailbox),"Special mailbox rules; no automatic E3 requirement",
				            NOT(_sizeUnknown) && _size>100,"Above 100 GB - quota and archive design review",
				            NOT(_sizeUnknown) && _size>50,"Above 50 GB - Plan 2 or equivalent review",
				            _features,"Archive, hold and delegation rights review","No E3 purchase conclusion; assess complete workload"),
				        "SE CAL Review", IF(_p2,"Plan 2 observed - base/additive equivalency to verify",
				            IF(_p1,"Plan 1 observed - base equivalency to verify","CAL coverage unverified; reconcile contracts and accessors")),
				        "Licensing Decision", "Unqualified - contract, active coverage, accessors and frontline eligibility required")
				)
