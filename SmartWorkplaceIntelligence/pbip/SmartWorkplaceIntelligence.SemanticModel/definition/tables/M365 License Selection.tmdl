	column 'License Product'
		dataType: string
		lineageTag: 92ef803c-c684-4d6d-8d71-3f75bdeeef6e
		summarizeBy: none
		sourceColumn: [License Product]

	partition 'M365 License Selection' = calculated
		mode: import
