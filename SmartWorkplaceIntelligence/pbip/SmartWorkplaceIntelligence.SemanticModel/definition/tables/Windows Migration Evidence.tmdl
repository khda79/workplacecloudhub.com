	/// Count of frozen Intune Windows 10 source identities with the specified observed feature-update policy state. Excludes AD-only records. Unique tenant/policy/device-ID attribution. Success is not Windows 11 migration proof; absence is not proof of non-enrollment.
	measure 'Windows 10 Autopatch Policy Observed' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Autopatch Policy State] IN {"Success","InProgress","Error"})), 0), KEEPFILTERS('Windows Migration Evidence'[Inventory Source] = "Intune")), 0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Autopatch Policy State] IN {"Success","InProgress","Error"})), 0), KEEPFILTERS('Windows Migration Evidence'[Inventory Source] = "Intune")), 0), BLANK())))
		formatString: #,##0
		displayFolder: Migration policy context
		lineageTag: 8b5a1bc2-89f1-40b9-a5f5-6128f33b7c3f

