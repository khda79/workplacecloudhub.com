	/// Windows 10 union records without a usable readiness assessment (Not assessed or Unknown), including AD-only records. Disjoint from Already upgraded source conflicts.
	measure 'Migration Windows 10 Eligibility Unknown' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Upgrade Eligibility] IN {"Not assessed", "Unknown"})), 0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Upgrade Eligibility] IN {"Not assessed", "Unknown"})), 0), BLANK())))
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 0a9b83a8-fbf0-400e-80c1-6a95f2d0d948

	/// Inventory OS is Windows 10 while prepared readiness reports Already upgraded. Current 28 cases use name-only readiness attribution with ambiguous Intune identities. Source reconciliation flags, not proven contradictory OS on a uniquely identified physical PC.
	measure 'Migration Windows 10 Eligibility Conflicting' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Upgrade Eligibility] = "Already upgraded")), 0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Upgrade Eligibility] = "Already upgraded")), 0), BLANK())))
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 8dac260d-02fe-4d20-ba59-abe601942a90

	/// Current qualified union of Intune Windows 10 and enabled AD Windows 10 without a qualified Intune match. Source identities, not verified physical-PC uniqueness. Intersects the shared Country Selection with current task filters. Country is primary-user CountryOrRegion with UsageLocation fallback for Intune; configured domain/prefix attribution for AD-only.
	measure 'Remaining Observed Windows 10' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((VAR _countries = VALUES('Country Selection'[Country])
			VAR _filtered = ISCROSSFILTERED('Country Selection'[Country])
			RETURN
			IF(
			    COUNTROWS(ALL('Windows Migration Evidence')) > 0,
			    COALESCE(
			        IF(_filtered,
			            CALCULATE(COUNTROWS('Windows Migration Evidence'),
			                KEEPFILTERS(TREATAS(_countries, 'Windows Migration Evidence'[Country Name]))),
			            COUNTROWS('Windows Migration Evidence')),
			        0),
			    BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(VAR _countries = VALUES('Country Selection'[Country])
			VAR _filtered = ISCROSSFILTERED('Country Selection'[Country])
			RETURN
			IF(
			    COUNTROWS(ALL('Windows Migration Evidence')) > 0,
			    COALESCE(
			        IF(_filtered,
			            CALCULATE(COUNTROWS('Windows Migration Evidence'),
			                KEEPFILTERS(TREATAS(_countries, 'Windows Migration Evidence'[Country Name]))),
			            COUNTROWS('Windows Migration Evidence')),
			        0),
			    BLANK())))
		formatString: #,##0
		displayFolder: Migration planning
		lineageTag: ca387993-93a9-4818-9706-07283df9a954

	/// Enabled AD Windows 10 records with unique GUID/name and no qualified ID or unique-name match in the frozen local Intune export. Not proof of device activity or non-enrollment. Respects filters.
	measure 'Migration AD Windows 10 Without Intune Match' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Inventory Source] = "AD only")), 0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Inventory Source] = "AD only")), 0), BLANK())))
		formatString: #,##0
		displayFolder: Migration planning
		lineageTag: 257eee2d-685b-4263-a9b2-bdac9e9112e1

	/// Read-only report utility applying the disconnected primary-user selector to source-qualified device rows.
	measure 'Primary user row match · Windows Migration Evidence' = VAR PresentRows = IF(ISFILTERED('Primary User Selection'[Primary user]), CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS(TREATAS(VALUES('Primary User Selection'[Primary user]), 'Windows Migration Evidence'[Primary User (report)]))), COUNTROWS('Windows Migration Evidence')) RETURN IF(PresentRows>0,1,BLANK())
		formatString: 0
		isHidden
		lineageTag: 486f44ae-861c-46af-88cf-332aec0c2af3

	/// Current Windows 10 inventory restricted to a qualified AD replicated lastLogonTimestamp or Entra approximate device sign-in > UTCNOW()-30 and <= UTCNOW(). Exact GUID/native key + tenant + batch. Intune sync alone is not activity. Missing/future/unqualified activity is excluded. Country, AD Domain and Primary user respected.
	measure 'Windows 10 remaining active <30D' =
			VAR _now=UTCNOW()
			VAR _countries=VALUES('Country Selection'[Country])
			VAR _domains=VALUES('Daily Domain'[Domain])
			VAR _users=VALUES('Primary User Selection'[Primary user])
			VAR _cf=ISFILTERED('Country Selection') VAR _df=ISFILTERED('Daily Domain') VAR _uf=ISFILTERED('Primary User Selection')
			VAR _gf=ISCROSSFILTERED('Global Device Inventory')
			VAR _gids=VALUES('Global Device Inventory'[Device Source ID]) VAR _gkeys=VALUES('Global Device Inventory'[Canonical Device Key])
			VAR _base=SELECTCOLUMNS(FILTER('Windows Migration Evidence',(NOT _cf||[Country Name] IN _countries)&&(NOT _df||[AD Domain] IN _domains)&&(NOT _uf||[Primary User (report)] IN _users)&&(NOT _gf||IF([Inventory Source]="AD only","ad:"&RIGHT([Device Source ID],36) IN _gkeys,[Device Source ID] IN _gids))),"__Source",[Inventory Source],"__ID",[Device Source ID],"__Batch",[Loaded Batch ID])
			VAR _tenants=ADDCOLUMNS(_base,"__Tenant",
			 VAR _id=[__ID] VAR _batch=[__Batch]
			 RETURN IF([__Source]="AD only",
			 LOOKUPVALUE('AD Computer Evidence'[TenantKey],'AD Computer Evidence'[ObjectGUID],RIGHT(_id,36),'AD Computer Evidence'[Loaded Batch ID],_batch,'AD Computer Evidence'[TenantKey],MID(_id,4,MAX(0,LEN(_id)-40)),BLANK()),
			 LOOKUPVALUE('Native Managed Device Evidence'[TenantKey],'Native Managed Device Evidence'[ManagedDeviceId],_id,'Native Managed Device Evidence'[Loaded Batch ID],_batch,BLANK())))
			VAR _keys=ADDCOLUMNS(_tenants,"__Native",
			 VAR _id=[__ID] VAR _batch=[__Batch] VAR _tenant=[__Tenant]
			 RETURN IF([__Source]="AD only",
			 LOOKUPVALUE('AD Computer Evidence'[TenantDeviceKey],'AD Computer Evidence'[ObjectGUID],RIGHT(_id,36),'AD Computer Evidence'[Loaded Batch ID],_batch,'AD Computer Evidence'[TenantKey],_tenant,BLANK()),
			 LOOKUPVALUE('Native Managed Device Evidence'[TenantDeviceKey],'Native Managed Device Evidence'[ManagedDeviceId],_id,'Native Managed Device Evidence'[Loaded Batch ID],_batch,'Native Managed Device Evidence'[TenantKey],_tenant,BLANK())))
			VAR _dates=ADDCOLUMNS(_keys,
			 "__AD",VAR _id=[__ID] VAR _batch=[__Batch] VAR _tenant=[__Tenant] VAR _native=[__Native]
			 VAR _d=IF([__Source]="AD only",
			 LOOKUPVALUE('AD Computer Evidence'[LastLogonUtcDateTime],'AD Computer Evidence'[TenantKey],_tenant,'AD Computer Evidence'[Loaded Batch ID],_batch,'AD Computer Evidence'[ObjectGUID],RIGHT(_id,36),'AD Computer Evidence'[LastLogonStatus],"UTC from replicated AD FILETIME; approximate logon",BLANK()),
			 IF(NOT ISBLANK(_native) && _native<>"",LOOKUPVALUE('AD Computer Evidence'[LastLogonUtcDateTime],'AD Computer Evidence'[TenantKey],_tenant,'AD Computer Evidence'[Loaded Batch ID],_batch,'AD Computer Evidence'[TenantDeviceKey],_native,'AD Computer Evidence'[CloudMatchStatus],"Unique native SID",'AD Computer Evidence'[LastLogonStatus],"UTC from replicated AD FILETIME; approximate logon",BLANK())))
			 RETURN IF(_d<=_now,_d),
			 "__Entra",VAR _batch=[__Batch] VAR _tenant=[__Tenant] VAR _native=[__Native]
			 RETURN IF(NOT ISBLANK(_native) && _native<>"",
			 CALCULATE(MAX('Device Source Evidence'[ActivityUtcDateTime]),REMOVEFILTERS('Device Source Evidence'),TREATAS({_tenant},'Device Source Evidence'[TenantKey]),TREATAS({_batch},'Device Source Evidence'[Loaded Batch ID]),TREATAS({_native},'Device Source Evidence'[TenantDeviceKey]),'Device Source Evidence'[SourceSystem]="Entra",'Device Source Evidence'[ActivityStatus]="UTC qualified",'Device Source Evidence'[ActivityUtcDateTime]<=_now)))
			VAR _dated=ADDCOLUMNS(_dates,"__Latest",MAX([__AD],[__Entra]))
			VAR _recent=FILTER(_dated,NOT ISBLANK([__Latest]) && [__Latest]>_now-30 && [__Latest]<=_now)
			RETURN COALESCE(COUNTROWS(_recent),0)
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 6ce8c9d7-83ca-4da0-aa06-f6b4f31d58ba

