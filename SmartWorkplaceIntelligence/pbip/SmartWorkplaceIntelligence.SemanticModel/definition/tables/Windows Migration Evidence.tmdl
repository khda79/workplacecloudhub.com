	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 47bfb4c4-25e1-436e-b188-0b0eb252a885
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	/// Observed primary user, exact source ID and tenant/batch matching only; used by the report search.
	column 'Primary User (report)' =
			VAR _t=LOOKUPVALUE('Global Device Inventory'[TenantKey],'Global Device Inventory'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Global Device Inventory'[Loaded Batch ID],'Windows Migration Evidence'[Loaded Batch ID],BLANK())
			VAR _b='Windows Migration Evidence'[Loaded Batch ID]
			VAR _gkey='Windows Migration Evidence'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Windows Migration Evidence'[Device Source ID]))
			VAR _upn=COALESCE('Windows Migration Evidence'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			RETURN IF(ISBLANK(_upn)||TRIM(_upn)="","Not resolved",_upn)
		dataType: string
		displayFolder: Report identity context
		lineageTag: 73879afe-62f9-4592-980d-fbff8eeb04e0

	/// Qualified SAM of the primary user; never inferred from UPN text.
	column 'Primary User SAM (report)' =
			VAR _t=LOOKUPVALUE('Global Device Inventory'[TenantKey],'Global Device Inventory'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Global Device Inventory'[Loaded Batch ID],'Windows Migration Evidence'[Loaded Batch ID],BLANK())
			VAR _b='Windows Migration Evidence'[Loaded Batch ID]
			VAR _gkey='Windows Migration Evidence'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Windows Migration Evidence'[Device Source ID]))
			VAR _upn=COALESCE('Windows Migration Evidence'[Primary User UPN],IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User UPN],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK())),IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Primary User UPN],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
			VAR _sam=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Primary User SAM],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			RETURN COALESCE(_sam,IF(NOT ISBLANK(_upn),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[UserPrincipalName],_upn,'Native User Evidence'[TenantKey],_t,'Native User Evidence'[Loaded Batch ID],_b,BLANK())),"Not resolved")
		dataType: string
		displayFolder: Report identity context
		lineageTag: 8fb3b2d4-e76e-449d-b24b-9e310df54476

	/// Last Windows console user observed at collection. Does not mean current user or last RDP session.
	column 'Last Console User (report)' =
			VAR _t=LOOKUPVALUE('Global Device Inventory'[TenantKey],'Global Device Inventory'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Global Device Inventory'[Loaded Batch ID],'Windows Migration Evidence'[Loaded Batch ID],BLANK())
			VAR _b='Windows Migration Evidence'[Loaded Batch ID]
			VAR _gkey='Windows Migration Evidence'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Windows Migration Evidence'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(_status="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon User],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())),"Not observed")
		dataType: string
		displayFolder: Report identity context
		lineageTag: fb06706a-a85f-4b35-ab94-cc0e49908775

	/// Source-qualified time of last observed console logon; unknown remains blank.
	column 'Last Console Logon UTC (report)' =
			VAR _t=LOOKUPVALUE('Global Device Inventory'[TenantKey],'Global Device Inventory'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Global Device Inventory'[Loaded Batch ID],'Windows Migration Evidence'[Loaded Batch ID],BLANK())
			VAR _b='Windows Migration Evidence'[Loaded Batch ID]
			VAR _gkey='Windows Migration Evidence'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Windows Migration Evidence'[Device Source ID]))
			RETURN IF(IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))="Observed",IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon UTC],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK())))
		dataType: dateTime
		formatString: yyyy-MM-dd HH:mm
		displayFolder: Report identity context
		lineageTag: aceedde3-bb47-42b1-8aea-6ae4b8ef309e

	/// Preserves source status and timestamp qualification, including stale/missing/error evidence.
	column 'Console Logon Qualification (report)' =
			VAR _t=LOOKUPVALUE('Global Device Inventory'[TenantKey],'Global Device Inventory'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Global Device Inventory'[Loaded Batch ID],'Windows Migration Evidence'[Loaded Batch ID],BLANK())
			VAR _b='Windows Migration Evidence'[Loaded Batch ID]
			VAR _gkey='Windows Migration Evidence'[Device Source ID]
			VAR _resolved=IF(NOT ISBLANK(_gkey),LOOKUPVALUE('Global Device Inventory'[Device Source ID],'Global Device Inventory'[Device Source ID],_gkey,'Global Device Inventory'[TenantKey],_t,'Global Device Inventory'[Loaded Batch ID],_b,BLANK()))
			VAR _sid=COALESCE(_resolved,IF(CONTAINS('Device System Evidence','Device System Evidence'[Device Source ID],'Windows Migration Evidence'[Device Source ID],'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b),'Windows Migration Evidence'[Device Source ID]))
			VAR _status=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Status],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			VAR _quality=IF(NOT ISBLANK(_sid),LOOKUPVALUE('Device System Evidence'[Last Console Logon Quality],'Device System Evidence'[Device Source ID],_sid,'Device System Evidence'[TenantKey],_t,'Device System Evidence'[Loaded Batch ID],_b,BLANK()))
			RETURN IF(ISBLANK(_status),"No matched system observation",_status&" · "&_quality)
		dataType: string
		displayFolder: Report identity context
		lineageTag: 7497f670-aabb-4a01-98b5-2e2b635b8b0f

	/// Rebuilt from tenant-qualified local source snapshots by the prepared evidence pipeline. Versioned batch reader; missing/incomplete outputs fail, never fall back to frozen recovery JSON. No live collection; AD absence is not proof of non-enrollment.
	partition 'Windows Migration Evidence' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Source = Csv.Document(GetPreparedEvidenceFile("WindowsMigrationEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Required = Table.SelectColumns(Headers, {"Device Source ID","Device Name","Country","Primary User UPN","OS Version","Windows Release","Intune State","Autopatch Registration","Upgrade Eligibility","Hardware Reasons","Free Disk GB","Disk Review","Legacy Build Review","Update State","Update Action","Last Intune Sync","Migration Status","Risk Priority","Next Action","Evidence Date","Country Basis","AD Domain","AD Domain Match Status","Inventory Source","Inventory Observation Date","Eligibility Observation Date","Eligibility OS Version","Eligibility Match Status","Autopatch Policy State","Autopatch Device Status","Autopatch Blocking Reason","Autopatch Alert","Autopatch Observation Date","Windows 11 Policy State","Windows 11 Device Status","Windows 11 Blocking Reason","Windows 11 Alert","Windows 11 Observation Date"}),
				    Nulls = Table.ReplaceValue(Required, "", null, Replacer.ReplaceValue, {"Free Disk GB"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Device Source ID", type text},{"Device Name", type text},{"Country", type text},{"Primary User UPN", type text},{"OS Version", type text},{"Windows Release", type text},{"Intune State", type text},{"Autopatch Registration", type text},{"Upgrade Eligibility", type text},{"Hardware Reasons", type text},{"Free Disk GB", type number},{"Disk Review", type text},{"Legacy Build Review", type text},{"Update State", type text},{"Update Action", type text},{"Last Intune Sync", type text},{"Migration Status", type text},{"Risk Priority", type text},{"Next Action", type text},{"Evidence Date", type text},{"Country Basis", type text},{"AD Domain", type text},{"AD Domain Match Status", type text},{"Inventory Source", type text},{"Inventory Observation Date", type text},{"Eligibility Observation Date", type text},{"Eligibility OS Version", type text},{"Eligibility Match Status", type text},{"Autopatch Policy State", type text},{"Autopatch Device Status", type text},{"Autopatch Blocking Reason", type text},{"Autopatch Alert", type text},{"Autopatch Observation Date", type text},{"Windows 11 Policy State", type text},{"Windows 11 Device Status", type text},{"Windows 11 Blocking Reason", type text},{"Windows 11 Alert", type text},{"Windows 11 Observation Date", type text}}, "en-US"),
				    PreservedObservationUtc = Table.TransformColumns(Typed, {{"Inventory Observation Date", (raw as nullable text) as nullable text =>
				        if raw = null or Text.Trim(raw) = "" or raw = "Not observed" then raw
				        else let
				            Parsed = if Text.Contains(raw, "T") then DateTimeZone.FromText(raw, [Culture="en-US"]) else DateTime.AddZone(DateTime.FromText(raw, [Culture="en-US"]), 0)
				        in DateTimeZone.ToText(DateTimeZone.SwitchZone(Parsed, 0), "yyyy-MM-dd'T'HH:mm:ss.fff'Z'", "en-US"), type text}})
				in
				    PreservedObservationUtc)
				in
				    Readers[Finish](BusinessRows)

	annotation PBI_ResultType = Exception
