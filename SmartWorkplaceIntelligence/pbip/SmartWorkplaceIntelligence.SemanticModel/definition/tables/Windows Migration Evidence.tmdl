/// Private source-backed migration planning evidence. Unknown is not zero. No Infrastructure hybride assessment.
table 'Windows Migration Evidence'
	lineageTag: 380dd445-f2b5-44b5-b6e7-f10ba35587d8

	/// Qualified Intune Windows 10 source identities in the current frozen union; excludes AD-only records. Distinct source IDs, not proof that every identity is a separate active physical PC.
	measure 'Remaining Managed Windows 10' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Inventory Source] = "Intune")), 0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'), KEEPFILTERS('Windows Migration Evidence'[Inventory Source] = "Intune")), 0), BLANK())))
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: cd275713-ce09-416f-9584-e521c5b6a9ad

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Hardware Incompatible Windows 10' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'),KEEPFILTERS('Windows Migration Evidence'[Upgrade Eligibility] = "Not capable")),0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(CALCULATE(COUNTROWS('Windows Migration Evidence'),KEEPFILTERS('Windows Migration Evidence'[Upgrade Eligibility] = "Not capable")),0), BLANK())))
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: e22efc27-5f6a-4a92-9a7c-8f7a4f093e8e

	/// Legacy combined unknown/conflict count retained for compatibility. Use the separate Migration Windows 10 Eligibility Unknown and Conflicting measures for the new KPI row.
	measure 'Windows 10 Eligibility Unknown' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(COUNTROWS(FILTER('Windows Migration Evidence',NOT('Windows Migration Evidence'[Upgrade Eligibility] IN {"Capable","Not capable"}))),0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(COUNTROWS(FILTER('Windows Migration Evidence',NOT('Windows Migration Evidence'[Upgrade Eligibility] IN {"Capable","Not capable"}))),0), BLANK())))
		formatString: #,0
		isHidden
		displayFolder: Migration planning
		lineageTag: 85cacbfd-a76a-4a55-8c21-27b1a88a50e9

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views.
	measure 'Confirmed Autopatch Readiness' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE(("Unknown"),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),("Unknown"))
		displayFolder: Migration planning
		lineageTag: 0243c63f-1a78-443c-9652-8c235401bbfa

	/// Local source-file modification timestamps, not individual device event timestamps.
	measure 'Windows Migration Source Date' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE(("Frozen local exports: Intune 2026-10-08 22:47 UTC; AD 2026-10-09 00:39 UTC; history remains Intune-only"),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),("Frozen local exports: Intune 2026-10-08 22:47 UTC; AD 2026-10-09 00:39 UTC; history remains Intune-only"))
		displayFolder: Migration planning
		lineageTag: f9a94ad8-c625-4fea-b4e9-87c35dcba5c8

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Windows 10 Disk Review' =
			VAR _puFilter=ISFILTERED('Primary User Selection'[Primary user])
			VAR _pu=VALUES('Primary User Selection'[Primary user])
			RETURN IF(_puFilter,CALCULATE((IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(COUNTROWS(FILTER('Windows Migration Evidence',NOT ISBLANK('Windows Migration Evidence'[Free Disk GB]) && 'Windows Migration Evidence'[Free Disk GB] < 20)),0), BLANK())),KEEPFILTERS(TREATAS(_pu,'Windows Migration Evidence'[Primary User (report)]))),(IF(COUNTROWS(ALL('Windows Migration Evidence')) > 0, COALESCE(COUNTROWS(FILTER('Windows Migration Evidence',NOT ISBLANK('Windows Migration Evidence'[Free Disk GB]) && 'Windows Migration Evidence'[Free Disk GB] < 20)),0), BLANK())))
