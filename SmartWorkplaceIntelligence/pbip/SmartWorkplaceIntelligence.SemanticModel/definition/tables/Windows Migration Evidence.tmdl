	/// Country Basis from the frozen local evidence preparation; source and qualification are recorded in migration-provenance.json.
	column 'Country Basis'
		dataType: string
		lineageTag: 0b014435-a4d8-4d9a-b9f9-b4682e930447
		sourceColumn: Country Basis

	/// English display name resolved from the frozen complete ISO alpha-2 Country Reference, independently of User/Device inventory loading. Source Country is preserved. UK is a compatibility alias for GB, not an ISO code. Missing/Unknown stays Unknown; unrecognized two-letter codes remain visible as unmapped. Full source names are preserved.
	column 'Country Name' =
			VAR _sourceCountry = TRIM(COALESCE('Windows Migration Evidence'[Country], ""))
			VAR _normalizedCountry = UPPER(_sourceCountry)
			VAR _countryCode = IF(_normalizedCountry = "UK", "GB", _normalizedCountry)
			VAR _countryName =
			    LOOKUPVALUE(
			        'Country Reference'[Country Name],
			        'Country Reference'[Country Code], _countryCode
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        _sourceCountry = "" || _normalizedCountry = "UNKNOWN", "Unknown",
			        NOT ISBLANK(_countryName), _countryName,
			        LEN(_sourceCountry) = 2, "Code " & _normalizedCountry & " (unmapped)",
			        _sourceCountry
			    )
		dataType: string
		lineageTag: 69e79e5c-ebe4-4ee9-9271-69a97a4d86f8
		dataCategory: Country
		summarizeBy: none

