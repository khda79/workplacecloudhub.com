/// Native source facet migrated from DimGroup; exact source grain, unresolved links and qualification retained. Uses the unified pinned batch, not a separate CMDB reader.
table 'Native Group Evidence'
	lineageTag: 3af188ea-6a2f-414b-8b4d-f107541c8afb

	/// Exported Entra groups; no membership metric. Migrated without changing the source calculation.
	measure 'Native Groups' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimGroup"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((COALESCE(COUNTROWS('Native Group Evidence'),0)), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Group Evidence'[TenantGroupKey]))), BLANK()), BLANK()), (COALESCE(COUNTROWS('Native Group Evidence'),0)))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: 7e974ac9-f6fe-4bea-b70b-4cdf2a9566bc

	/// Detail rows only when exactly one group is selected outside visual row grouping. Blank otherwise. Migrated without changing the source calculation.
	measure 'Native Group details' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimGroup"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((IF(COUNTROWS(ALLSELECTED('Native Group Evidence')) = 1, COUNTROWS('Native Group Evidence'))), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Group Evidence'[TenantGroupKey]))), BLANK()), BLANK()), (IF(COUNTROWS(ALLSELECTED('Native Group Evidence')) = 1, COUNTROWS('Native Group Evidence'))))
		formatString: #,0
		displayFolder: Native evidence
		lineageTag: c4236137-6b68-4a98-bfef-398c151adb3c

	/// Exact native-key entity context or existing inventory context. No name matching or inferred transitive membership. Unrelated entity selections return blank.
	measure 'Native Context Rows · Native Group Evidence' =
			VAR HasEntityContext = ISFILTERED('CMDB Entity Evidence'[Selection]) || ISFILTERED('CMDB Entity Evidence'[Entity Key])
			VAR OneEntity = HASONEVALUE('CMDB Entity Evidence'[Entity Key])
			VAR NativeKeys0 = CALCULATETABLE(VALUES('CMDB Entity Alias'[Source Key]), KEEPFILTERS('CMDB Entity Alias'[Source Table] = "DimGroup"))
			RETURN IF(HasEntityContext, IF(OneEntity, SWITCH(TRUE(), COUNTROWS(NativeKeys0) > 0, CALCULATE((COUNTROWS('Native Group Evidence')), KEEPFILTERS(TREATAS(NativeKeys0, 'Native Group Evidence'[TenantGroupKey]))), BLANK()), BLANK()), (COUNTROWS('Native Group Evidence')))
		formatString: #,0
		isHidden
		lineageTag: 3a2640ab-e52a-423a-a0d1-55ec4e258bca

	/// Native DimGroup attribute; source qualification is retained.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: bf44fa01-63d5-4207-883f-ddebbde4e0fa
		summarizeBy: none
		sourceColumn: TenantKey

	/// Native DimGroup attribute; source qualification is retained.
