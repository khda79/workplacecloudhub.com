		sourceColumn: ObservedPathStatus

	/// Exact governed native-key bridge; not a display-name or transitive match.
	column 'CMDB Entity Key' = LOOKUPVALUE('CMDB Entity Alias'[Entity Key], 'CMDB Entity Alias'[Source Table], "DimGroup", 'CMDB Entity Alias'[Source Key], 'Native Group Evidence'[TenantGroupKey])
		dataType: string
		isHidden
		lineageTag: c89f0a08-7c97-4692-9f3d-a3892e72f28b
		summarizeBy: none

	partition 'Native Group Evidence' = m
		mode: import
		source = NativeEvidenceTypes(Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("DimGroup.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]), {[name="TenantKey", dataType="String"], [name="OrganizationKey", dataType="String"], [name="EnvironmentKey", dataType="String"], [name="TenantId", dataType="String"], [name="TenantGroupKey", dataType="String"], [name="CmdbGroupId", dataType="String"], [name="DisplayName", dataType="String"], [name="MailEnabled", dataType="Boolean"], [name="SecurityEnabled", dataType="Boolean"], [name="GroupTypes", dataType="String"], [name="GroupSelection", dataType="String"], [name="SourceGroupId", dataType="String"], [name="MemberStatus", dataType="String"], [name="OwnerStatus", dataType="String"], [name="SourceCollectedDateTime", dataType="DateTime"], [name="ObservedPathCount", dataType="Int64"], [name="ObservedPathStatus", dataType="String"]})

