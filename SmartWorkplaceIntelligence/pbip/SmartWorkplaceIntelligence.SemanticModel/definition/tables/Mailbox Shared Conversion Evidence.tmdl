/// Prepared shared mailbox conversion evidence: EXO user mailboxes used through delegates. The owner Entra sign-in decides; EXO last logon is informational because delegates and system processes update it.
table 'Mailbox Shared Conversion Evidence'
	lineageTag: 9919d660-b7a4-551e-b4d1-331359669bca

	/// EXO user mailboxes assessed for conversion to a shared mailbox.
	measure 'Shared Conversion Mailboxes' =
			VAR _batch = [Dataset Loaded Batch ID]
			VAR _q = IF(NOT ISBLANK(_batch), CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'), 'Directory Cleanup Source Qualification'[Source] = "Shared mailbox conversion (EXO user mailboxes)", 'Directory Cleanup Source Qualification'[Status] = "Observed", 'Directory Cleanup Source Qualification'[Loaded Batch ID] = _batch))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Shared Conversion Evidence')), 0), BLANK())
		formatString: #,0
		displayFolder: Shared Mailbox Conversion
		lineageTag: 36d246b0-4a01-50a0-bdd0-7bc47d0776e9

	/// Owner disabled, no owner sign-in beyond the inactive threshold, an active delegate, free size, no hold, no archive, no direct protocol use.
	measure 'Shared Conversion Strong Candidates' =
			VAR _batch = [Dataset Loaded Batch ID]
			VAR _q = IF(NOT ISBLANK(_batch), CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'), 'Directory Cleanup Source Qualification'[Source] = "Shared mailbox conversion (EXO user mailboxes)", 'Directory Cleanup Source Qualification'[Status] = "Observed", 'Directory Cleanup Source Qualification'[Loaded Batch ID] = _batch))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Shared Conversion Evidence'), KEEPFILTERS('Mailbox Shared Conversion Evidence'[Conversion State] = "Strong candidate")), 0), BLANK())
		formatString: #,0
		displayFolder: Shared Mailbox Conversion
		lineageTag: f7f5fc7e-22d6-5578-97bf-d91b124b23a0

	/// Delegated mailboxes whose owner has not signed in recently but at least one condition is unmet or unqualified.
	measure 'Shared Conversion Review' =
			VAR _batch = [Dataset Loaded Batch ID]
			VAR _q = IF(NOT ISBLANK(_batch), CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'), 'Directory Cleanup Source Qualification'[Source] = "Shared mailbox conversion (EXO user mailboxes)", 'Directory Cleanup Source Qualification'[Status] = "Observed", 'Directory Cleanup Source Qualification'[Loaded Batch ID] = _batch))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Shared Conversion Evidence'), KEEPFILTERS('Mailbox Shared Conversion Evidence'[Conversion State] = "Review")), 0), BLANK())
		formatString: #,0
		displayFolder: Shared Mailbox Conversion
		lineageTag: 6c0bc773-b4ef-5ab9-a07e-3cb3a7b32f4b

	/// No delegate, or the owner signed in within the active threshold.
	measure 'Shared Conversion Not Candidate' =
			VAR _batch = [Dataset Loaded Batch ID]
			VAR _q = IF(NOT ISBLANK(_batch), CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'), 'Directory Cleanup Source Qualification'[Source] = "Shared mailbox conversion (EXO user mailboxes)", 'Directory Cleanup Source Qualification'[Status] = "Observed", 'Directory Cleanup Source Qualification'[Loaded Batch ID] = _batch))
			RETURN IF(_q > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Shared Conversion Evidence'), KEEPFILTERS('Mailbox Shared Conversion Evidence'[Conversion State] = "Not candidate")), 0), BLANK())
		formatString: #,0
		displayFolder: Shared Mailbox Conversion
		lineageTag: 505a8b6d-1827-55a4-876f-0edd3d49bdc2

	/// Strong candidates whose owner still holds at least one license; the license gain needs a human licensing review.
	measure 'Shared Conversion Licensed Strong Candidates' =
			VAR _batch = [Dataset Loaded Batch ID]
			VAR _q = IF(NOT ISBLANK(_batch), CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'), 'Directory Cleanup Source Qualification'[Source] = "Shared mailbox conversion (EXO user mailboxes)", 'Directory Cleanup Source Qualification'[Status] = "Observed", 'Directory Cleanup Source Qualification'[Loaded Batch ID] = _batch))
			VAR _licenses = IF(NOT ISBLANK(_batch), CALCULATE(COUNTROWS('Directory Cleanup Source Qualification'), REMOVEFILTERS('Directory Cleanup Source Qualification'), 'Directory Cleanup Source Qualification'[Source] = "Microsoft 365 licenses", 'Directory Cleanup Source Qualification'[Status] = "Observed", 'Directory Cleanup Source Qualification'[Loaded Batch ID] = _batch))
			RETURN IF(_q > 0 && _licenses > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Shared Conversion Evidence'), KEEPFILTERS('Mailbox Shared Conversion Evidence'[Conversion State] = "Strong candidate"), KEEPFILTERS('Mailbox Shared Conversion Evidence'[Owner License Count] > 0)), 0), BLANK())
		formatString: #,0
		displayFolder: Shared Mailbox Conversion
		lineageTag: 5039782f-81f8-5fac-bb05-42de8406f205

