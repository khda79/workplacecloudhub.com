	partition 'Mailbox Shared Conversion Evidence' = m
		mode: import
		source =
				let
				 Readers = CreatePreparedReaders(),
				 Raw = Table.PromoteHeaders(Csv.Document(Readers[GetPreparedEvidenceFile]("MailboxSharedConversionEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv, ExtraValues=ExtraValues.Error]), [PromoteAllScalars=true]),
				 Selected = Table.SelectColumns(Raw, {"TenantKey", "Shared Conversion Key", "Mailbox GUID", "Primary SMTP Address", "Recipient Type", "Owner Entra Object ID", "Owner AD Object GUID", "Owner Match Status", "Owner Account State", "AD Domain", "Country", "Country Basis", "Account Type", "Account Population", "Workforce Persona", "Mailbox Size GB", "Archive State", "Litigation Hold", "Retention Hold", "Hold State", "Delegate Count", "FullAccess Delegate Count", "SendAs Delegate Count", "SendOnBehalf Delegate Count", "Resolved Delegate Count", "Unresolved Delegate Count", "Unresolved SID Delegate Count", "Active Delegate Count", "Owner Last Sign-In", "Owner Last Sign-In Source", "Owner Last Sign-In Quality", "Days Since Owner Sign-In", "EXO Last Logon", "EXO Last Logon Quality", "Direct Protocol Use", "Direct Protocol Quality", "Owner Licenses", "Owner License Count", "Conversion State", "State Sort", "Decision Reason", "Secondary Reasons", "Recommended Action", "EXO Source Status", "EXO Collected UTC", "Entra Source Status", "Entra Collected UTC", "License Source Status", "Email App Usage Source Status", "Email App Usage Report Date", "Reference UTC", "Evidence Date", "Evidence Status"}),
				 Scoped = if List.AllTrue(List.Transform(Table.Column(Selected, "TenantKey"), each _ = PreparedExpectedTenantKey)) then Selected else error "Foreign or missing tenant",
				 Nulls = Table.ReplaceValue(Scoped, "", null, Replacer.ReplaceValue, {"Mailbox Size GB", "Delegate Count", "FullAccess Delegate Count", "SendAs Delegate Count", "SendOnBehalf Delegate Count", "Resolved Delegate Count", "Unresolved Delegate Count", "Unresolved SID Delegate Count", "Active Delegate Count", "Days Since Owner Sign-In", "Owner License Count", "State Sort"}),
				 Typed = Table.TransformColumnTypes(Nulls, {{"TenantKey", type text}, {"Shared Conversion Key", type text}, {"Mailbox GUID", type text}, {"Primary SMTP Address", type text}, {"Recipient Type", type text}, {"Owner Entra Object ID", type text}, {"Owner AD Object GUID", type text}, {"Owner Match Status", type text}, {"Owner Account State", type text}, {"AD Domain", type text}, {"Country", type text}, {"Country Basis", type text}, {"Account Type", type text}, {"Account Population", type text}, {"Workforce Persona", type text}, {"Mailbox Size GB", type number}, {"Archive State", type text}, {"Litigation Hold", type text}, {"Retention Hold", type text}, {"Hold State", type text}, {"Delegate Count", Int64.Type}, {"FullAccess Delegate Count", Int64.Type}, {"SendAs Delegate Count", Int64.Type}, {"SendOnBehalf Delegate Count", Int64.Type}, {"Resolved Delegate Count", Int64.Type}, {"Unresolved Delegate Count", Int64.Type}, {"Unresolved SID Delegate Count", Int64.Type}, {"Active Delegate Count", Int64.Type}, {"Owner Last Sign-In", type text}, {"Owner Last Sign-In Source", type text}, {"Owner Last Sign-In Quality", type text}, {"Days Since Owner Sign-In", Int64.Type}, {"EXO Last Logon", type text}, {"EXO Last Logon Quality", type text}, {"Direct Protocol Use", type text}, {"Direct Protocol Quality", type text}, {"Owner Licenses", type text}, {"Owner License Count", Int64.Type}, {"Conversion State", type text}, {"State Sort", Int64.Type}, {"Decision Reason", type text}, {"Secondary Reasons", type text}, {"Recommended Action", type text}, {"EXO Source Status", type text}, {"EXO Collected UTC", type text}, {"Entra Source Status", type text}, {"Entra Collected UTC", type text}, {"License Source Status", type text}, {"Email App Usage Source Status", type text}, {"Email App Usage Report Date", type text}, {"Reference UTC", type text}, {"Evidence Date", type text}, {"Evidence Status", type text}}, "en-US"),
				 Dates = Table.TransformColumns(Typed, {{"Owner Last Sign-In", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"EXO Last Logon", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"EXO Collected UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Entra Collected UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Email App Usage Report Date", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Reference UTC", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}, {"Evidence Date", each if _ = null or _ = "" then null else if Text.Length(_) = 10 then DateTime.From(Date.FromText(_)) else DateTimeZone.RemoveZone(DateTimeZone.SwitchZone(DateTimeZone.FromText(_), 0)), type datetime}}),
				 QualifiedCountry = Table.AddColumn(Dates, "__Qualified Country", each if [Country] = null or Text.Trim([Country]) = "" then "Unknown" else [Country], type text),
				 CountryRemoved = Table.RemoveColumns(QualifiedCountry, {"Country"}),
				 CountryRenamed = Table.RenameColumns(CountryRemoved, {{"__Qualified Country", "Country"}}),
				 LicenseLabel = Table.AddColumn(CountryRenamed, "__Owner Licenses", each if [License Source Status] = "Observed" then (if [Owner Licenses] <> null and Text.Trim([Owner Licenses]) <> "" then [Owner Licenses] else if [Owner License Count] = 0 then "No license" else "Unknown") else "Unknown", type text),
				 WithoutOwnerLicenses = Table.RemoveColumns(LicenseLabel, {"Owner Licenses"}),
				 RenamedOwnerLicenses = Table.RenameColumns(WithoutOwnerLicenses, {{"__Owner Licenses", "Owner Licenses"}}),
				 OwnerLicenses = Table.ReorderColumns(RenamedOwnerLicenses, Table.ColumnNames(CountryRenamed))
				in
				 Readers[Finish](OwnerLicenses)

	annotation PBI_ResultType = Exception

