/// Private current Teams, SharePoint, and OneDrive object-level governance, activity, ownership, access, storage, and action evidence.
table 'Collaboration Object Evidence'
	lineageTag: bb87500a-254c-4697-ac42-a88328c91b25

	/// Current Teams, SharePoint, and OneDrive objects in scope.
	measure 'Collaboration Objects' = COUNTROWS('Collaboration Object Evidence')
		formatString: #,0
		displayFolder: Content | Current
		lineageTag: 3b4a239a-1aba-4ee5-92bb-18a87f965eb0

	/// Objects active in the last 30 days relative to their source snapshot.
	measure 'Active Collaboration Objects 30D' = CALCULATE([Collaboration Objects], KEEPFILTERS('Collaboration Object Evidence'[Activity State] = "Active 30D"))
		formatString: #,0
		displayFolder: Content | Current
		lineageTag: 898a8b67-4053-4a2d-bbd2-650bc41154f4

	/// Objects inactive for more than 180 days or without activity evidence.
	measure 'Inactive Collaboration Objects' = CALCULATE([Collaboration Objects], KEEPFILTERS('Collaboration Object Evidence'[Activity State] IN {"Inactive 180D+", "No activity evidence"}))
		formatString: #,0
		displayFolder: Content | Risk
		lineageTag: febbf59a-8ed6-4930-8402-76534b89aac6

	/// Objects without an observed owner.
	measure 'Orphaned Collaboration Objects' = CALCULATE([Collaboration Objects], KEEPFILTERS('Collaboration Object Evidence'[Owner State] = "No owner"))
		formatString: #,0
		displayFolder: Content | Risk
		lineageTag: c24f4d1c-4d6f-4893-8096-154a605ef9fb

	/// Objects with observed guests or external sharing.
	measure 'Collaboration Objects with External Access' = CALCULATE([Collaboration Objects], KEEPFILTERS('Collaboration Object Evidence'[External Access State] IN {"Guests present", "External sharing enabled"}))
		formatString: #,0
		displayFolder: Content | Risk
		lineageTag: b2b41f66-d8a2-435c-8b46-fd700eac7fc5

	/// Objects with a current high or medium operational signal.
	measure 'At-Risk Collaboration Objects' = CALCULATE([Collaboration Objects], KEEPFILTERS('Collaboration Object Evidence'[Risk Priority] IN {"High", "Medium"}))
		formatString: #,0
		displayFolder: Content | Risk
		lineageTag: 0468658b-c96f-4496-ab43-a0d82e5079d9

	/// Share of current collaboration objects with a high or medium operational signal.
	measure 'At-Risk Collaboration Object Rate (%)' = DIVIDE([At-Risk Collaboration Objects], [Collaboration Objects])
		formatString: 0.0%
		displayFolder: Content | Risk
		lineageTag: c704b8d4-33b7-483e-852a-89fd27ed1339

	/// Observed Teams, SharePoint, and OneDrive storage used in gigabytes.
	measure 'Collaboration Storage Used (GB)' = SUM('Collaboration Object Evidence'[Storage Used GB])
		formatString: #,0.0
		displayFolder: Content | Storage
		lineageTag: dc113fc2-b9c2-4157-b3d0-7e2d0c13624d

