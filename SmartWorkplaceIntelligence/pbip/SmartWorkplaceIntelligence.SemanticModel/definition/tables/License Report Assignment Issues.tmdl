	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 15ad9c6b-c452-4b26-8371-c8a165a10163
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	/// Private report scope. Exact unique native identity and one loaded batch; no UPN suffix or display-name inference. Blank when missing or ambiguous.
	column 'AD Domain' =
			VAR _batch = 'License Report Assignment Issues'[Loaded Batch ID]
			VAR _id = TRIM('License Report Assignment Issues'[User ID])
			VAR _tenant = 'License Report Assignment Issues'[Tenant Key]
			VAR _users = FILTER(ALL('Native User Evidence'), 'Native User Evidence'[SourceUserId] == _id && 'Native User Evidence'[Loaded Batch ID] == _batch && 'Native User Evidence'[TenantKey] == _tenant)
			RETURN IF(NOT ISBLANK(_batch) && _id <> "" && COUNTROWS(_users) = 1, MAXX(_users, 'Native User Evidence'[AD Domain]))
		dataType: string
		displayFolder: Report scope
		lineageTag: 5d9893b5-e4ba-41e1-8648-f3fdf8bfc5df
		summarizeBy: none

	/// Private report scope. Exact unique native identity and one loaded batch; no UPN suffix or display-name inference. Blank when missing or ambiguous.
	column 'Scope Country' =
			VAR _batch = 'License Report Assignment Issues'[Loaded Batch ID]
			VAR _id = TRIM('License Report Assignment Issues'[User ID])
			VAR _tenant = 'License Report Assignment Issues'[Tenant Key]
			VAR _users = FILTER(ALL('Native User Evidence'), 'Native User Evidence'[SourceUserId] == _id && 'Native User Evidence'[Loaded Batch ID] == _batch && 'Native User Evidence'[TenantKey] == _tenant)
			RETURN IF(NOT ISBLANK(_batch) && _id <> "" && COUNTROWS(_users) = 1, MAXX(_users, 'Native User Evidence'[CountryCode]))
		dataType: string
		displayFolder: Report scope
		lineageTag: bd72f1df-9abe-4dd3-bfa0-536d8350b35c
		summarizeBy: none

	partition 'License Report Assignment Issues' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Snapshot = GetLicenseReportSnapshot(),
				    HasAssignment = Record.HasFields(Snapshot, "AssignmentIssues"),
				    Assignment = if HasAssignment and LicenseReportFileUsable("M365_Licenses_ReportAssignmentIssues.csv") then Snapshot[AssignmentIssues] else [Available=false, Rows={}],
				    Columns = {"SnapshotId", "TenantKey", "Product", "Category", "UserId", "UserPrincipalName", "DisplayName", "IdentityStatus", "AccountEnabled", "UserType", "SkuIds", "AssignmentStates", "AssignmentError", "AssignmentRoutes", "AssignedByGroupIds", "AssignedByGroupNames", "HasEffectiveTargetSuite", "LastUpdatedDateTime", "AssignmentPaths"},
				    Raw = if HasAssignment then GetLicenseReportCsv("M365_Licenses_ReportAssignmentIssues.csv", Columns) else #table(Columns, {}),
				    SuiteProducts = List.Transform(Snapshot[Products], each [Product]),
				    ValidRows = Table.SelectRows(Raw, each [UserId] <> null and Text.Trim([UserId]) <> "" and
				        List.Contains(SuiteProducts, [Product]) and List.Contains({"Capacity wait", "Licensing error"}, [Category]) and
				        [AssignmentError] <> null and Text.Trim([AssignmentError]) <> ""),
				    Keys = {"Product", "Category", "UserId", "AssignmentError"},
				    SnapshotRows = Table.FromRecords(Assignment[Rows], Columns, MissingField.UseNull),
				    KeySort = List.Transform(Keys, each {_, Order.Ascending}),
				    ActualKeys = Table.ToRows(Table.Sort(Table.SelectColumns(Raw, Keys), KeySort)),
				    ExpectedKeys = Table.ToRows(Table.Sort(Table.SelectColumns(SnapshotRows, Keys), KeySort)),
				    CountsMatch = if not Assignment[Available] then Table.IsEmpty(Raw) else
				        List.AllTrue(List.Transform(SuiteProducts, (product) =>
				            let totals = Record.Field(Assignment[Counts], product),
				                waiting = List.Count(List.Distinct(Table.SelectRows(Raw, each [Product] = product and [Category] = "Capacity wait")[UserId])),
				                errors = List.Count(List.Distinct(Table.SelectRows(Raw, each [Product] = product and [Category] = "Licensing error")[UserId]))
				            in waiting = totals[CapacityWait] and errors = totals[OtherErrors])),
				    Checked = if Table.RowCount(ValidRows) = Table.RowCount(Raw) and
				        Table.RowCount(Table.Distinct(Raw, Keys)) = Table.RowCount(Raw) and ActualKeys = ExpectedKeys and CountsMatch
				        then Raw else error "Assignment issue detail does not reconcile with the qualified license snapshot",
				    Renamed = Table.RenameColumns(Checked, {{"SnapshotId", "Snapshot ID"}, {"TenantKey", "Tenant Key"}, {"Product", "Product"}, {"Category", "Category"}, {"UserId", "User ID"}, {"UserPrincipalName", "User Principal Name"}, {"DisplayName", "Display Name"}, {"IdentityStatus", "Identity Status"}, {"AccountEnabled", "Account Enabled"}, {"UserType", "User Type"}, {"SkuIds", "SKU IDs"}, {"AssignmentStates", "Assignment States"}, {"AssignmentError", "Assignment Error"}, {"AssignmentRoutes", "Assignment Routes"}, {"AssignedByGroupIds", "Assigning Group IDs"}, {"AssignedByGroupNames", "Assigning Groups"}, {"HasEffectiveTargetSuite", "Has Effective Target Suite"}, {"LastUpdatedDateTime", "Last Updated UTC"}, {"AssignmentPaths", "Assignment Paths"}}),
				    EmptyToNull = Table.ReplaceValue(Renamed, "", null, Replacer.ReplaceValue, {"Last Updated UTC", "Assignment Paths"}),
				    Typed = Table.TransformColumnTypes(EmptyToNull, {{"Last Updated UTC", type datetimezone}, {"Assignment Paths", Int64.Type}}, "en-US"),
				    UtcDate = Table.TransformColumns(Typed, {{"Last Updated UTC", each if _ = null then null else DateTimeZone.RemoveZone(DateTimeZone.ToUtc(_)), type nullable datetime}}),
				    English = Table.ReplaceValue(UtcDate, "N/D", "Unknown", Replacer.ReplaceValue, {"Assigning Groups", "Identity Status"}),
				    NormalizedUserId = Table.TransformColumns(English, {{"User ID", each Text.Lower(Text.Trim(_)), type text}})
				in
				    NormalizedUserId)
				in
				    Readers[Finish](BusinessRows)
