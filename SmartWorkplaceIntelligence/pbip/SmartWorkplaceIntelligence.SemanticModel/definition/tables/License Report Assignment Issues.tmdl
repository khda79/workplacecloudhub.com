/// Published assignment issues at user/product/category/error-code grain. Snapshot and per-suite counts are reconciled before load. Legacy snapshots return no detail and Unknown measures.
table 'License Report Assignment Issues'
	lineageTag: 19bc987c-b2fe-4b7c-ba9c-3e3ef47f9eda

	/// SAM display resolved by qualified native identity, same tenant and loaded batch. Empty text when no qualified SAM; preserves unresolved source rows in table projections.
	measure 'SAM · License Report Assignment Issues' = VAR _display = (VAR _key=SELECTEDVALUE('License Report Assignment Issues'[User ID]) VAR _tenant=SELECTEDVALUE('License Report Assignment Issues'[Tenant Key]) VAR _batch=SELECTEDVALUE('License Report Assignment Issues'[Loaded Batch ID]) RETURN IF(NOT ISBLANK(_key),LOOKUPVALUE('Native User Evidence'[SAM Account Name],'Native User Evidence'[SourceUserId],_key,'Native User Evidence'[TenantKey],_tenant,'Native User Evidence'[Loaded Batch ID],_batch))) RETURN IF(COUNTROWS('License Report Assignment Issues') > 0, COALESCE(_display, ""))
		displayFolder: Private identity display
		lineageTag: 11e0e319-5a4f-4cff-b8e6-c10a2e5d5c28

	/// Published assignment evidence: Snapshot ID
	column 'Snapshot ID'
		dataType: string
		isHidden
		lineageTag: 973b3d5b-0c3f-4353-a3bd-a92d7a73ed61
		summarizeBy: none
		sourceColumn: Snapshot ID

