/// One synthetic user and license assignment per snapshot.
table 'User License Assignments'
	lineageTag: 36c595cb-740c-4ae0-a3de-38e2b3f33adf

	/// Assigned licenses with qualified inactivity and no approved exclusion; not a monetary claim.
	measure '# Potentially Reclaimable Assignments' = CALCULATE(COUNTROWS('User License Assignments'), KEEPFILTERS('User License Assignments'[Assignment State] = "Assigned"), KEEPFILTERS('User License Assignments'[Inactivity Evidence State] = "Inactive"), KEEPFILTERS('User License Assignments'[Approved Exclusion] = FALSE()))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 0e860665-5b65-4ca8-9181-97e28aade8db

	/// Distinct eligible inactive users supporting reclaimability.
	measure '# Inactive Eligible Users' = CALCULATE(DISTINCTCOUNT('User License Assignments'[User Key]), KEEPFILTERS('User License Assignments'[Inactivity Evidence State] = "Inactive"), KEEPFILTERS('User License Assignments'[Approved Exclusion] = FALSE()))
		formatString: #,0
		displayFolder: Measures
		lineageTag: 1b54e301-0976-4366-9921-67014c72c8d6

	/// Disabled user accounts that still have at least one assigned license.
	measure '# Disabled Licensed Accounts' = CALCULATE(DISTINCTCOUNT('User License Assignments'[User Key]), KEEPFILTERS('User License Assignments'[Assignment State] = "Assigned"), KEEPFILTERS('User'[Account State] = "Disabled"))
		formatString: #,0
		displayFolder: Identity Health
		lineageTag: 648ddc46-c742-4917-9f41-d13550e3de9d

	/// Business attribute Date Key.
	column 'Date Key'
		dataType: int64
		isHidden
		isAvailableInMdx: false
		lineageTag: ebad6097-7cb1-4221-9dba-8b1d0d3384da
		summarizeBy: none
		sourceColumn: Date Key

