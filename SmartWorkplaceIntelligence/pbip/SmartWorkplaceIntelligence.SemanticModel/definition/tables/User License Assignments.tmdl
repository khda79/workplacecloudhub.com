	partition 'User License Assignments Import' = m
		mode: import
		source =
				let
				    Source = #table(type table [#"Date Key" = Int64.Type, #"Tenant Key" = Int64.Type, #"Environment Key" = Int64.Type, #"User Key" = Int64.Type, #"License Product Key" = Int64.Type, #"Assignment State" = nullable text, #"Inactivity Evidence State" = nullable text, #"Approved Exclusion" = nullable logical], {
				        {20260915, 1, 1, 1, 1, "Assigned", "Active", false},
				        {20260915, 1, 1, 2, 1, "Assigned", "Inactive", false},
				        {20260915, 1, 1, 3, 3, "Assigned", "Inactive", true},
