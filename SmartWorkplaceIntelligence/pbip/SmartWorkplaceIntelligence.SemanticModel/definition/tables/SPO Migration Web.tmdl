		summarizeBy: none
		sourceColumn: Parent Web Key

	/// Prepared, tenant-qualified migration evidence: Source URL.
	column 'Source URL'
		dataType: string
		lineageTag: f2f66570-d07b-4ccc-b675-da80387379d7
		summarizeBy: none
		sourceColumn: Source URL

	/// Prepared, tenant-qualified migration evidence: Source Name.
	column 'Source Name'
		dataType: string
		lineageTag: 15d888ff-d6f5-4488-846f-3fdbd89b02ec
		summarizeBy: none
		sourceColumn: Source Name

	/// Prepared, tenant-qualified migration evidence: Farm Key.
	column 'Farm Key'
		dataType: string
		isHidden
		lineageTag: e74ec254-b851-418c-9d49-88f6c132b5c9
		summarizeBy: none
		sourceColumn: Farm Key

	/// Prepared, tenant-qualified migration evidence: Web Application Key.
	column 'Web Application Key'
		dataType: string
		isHidden
