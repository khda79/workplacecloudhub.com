		summarizeBy: none
		sourceColumn: Web Application Key

	/// Prepared, tenant-qualified migration evidence: Coverage Kind.
	column 'Coverage Kind'
		dataType: string
		lineageTag: d18252ed-2711-4cda-88d0-f35f0ea38ca4
		summarizeBy: none
		sourceColumn: Coverage Kind

	/// Prepared, tenant-qualified migration evidence: Run ID.
	column 'Run ID'
		dataType: string
		isHidden
		lineageTag: e2e4af3d-1559-4196-9263-a4ecf3371e75
		summarizeBy: none
		sourceColumn: Run ID

	/// Prepared, tenant-qualified migration evidence: Captured UTC.
	column 'Captured UTC'
		dataType: dateTime
		isHidden
		formatString: yyyy-MM-dd HH:mm
		lineageTag: b0fa1204-a8f1-4dc2-98cc-eaf65ee5931d
		summarizeBy: none
		sourceColumn: Captured UTC

	column 'Project Identity'
		dataType: string
		isHidden
		lineageTag: 4a3d5e40-bd94-405a-a3f0-0ff0c243e184
		sourceColumn: Project Identity

	partition 'SPO Migration Web' = m
		mode: import
		source =
				let
				    Source = GetSharePointMigrationEvidence("SharePointMigrationWebEvidence.csv", {{"TenantKey", type text}, {"Project Key", type text}, {"Snapshot ID", type text}, {"Snapshot Date", type date}, {"Web Key", type text}, {"Collection Key", type text}, {"Parent Web Key", type text}, {"Source URL", type text}, {"Source Name", type text}, {"Farm Key", type text}, {"Web Application Key", type text}, {"Coverage Kind", type text}, {"Run ID", type text}, {"Captured UTC", type datetime}}),
				    Identity = Table.AddColumn(Source, "Project Identity", each Binary.ToText(Json.FromValue({[TenantKey], [Project Key]}), BinaryEncoding.Base64), type text),
				    Categories = Table.TransformColumns(Identity, List.Transform(List.Intersect({{"Business Unit", "Phase"}, Table.ColumnNames(Identity)}), (c) => {c, each if _ = null then "(Unspecified)" else _, type text}))
				in Categories
