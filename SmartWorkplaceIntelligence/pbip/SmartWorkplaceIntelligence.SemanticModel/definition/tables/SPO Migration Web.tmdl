		sourceColumn: Snapshot ID

	/// Prepared, tenant-qualified migration evidence: Snapshot Date.
	column 'Snapshot Date'
		dataType: dateTime
		formatString: yyyy-MM-dd
		lineageTag: 27623edc-a1d9-4723-98e0-97dbae3f7320
		summarizeBy: none
		sourceColumn: Snapshot Date

	/// Prepared, tenant-qualified migration evidence: Web Key.
	column 'Web Key'
		dataType: string
