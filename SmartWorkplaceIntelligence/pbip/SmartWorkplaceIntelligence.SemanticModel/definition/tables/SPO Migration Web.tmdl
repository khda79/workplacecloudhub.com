/// SPO means SharePoint Online. Grain: Web Key; source: one selected immutable prepared batch.
table 'SPO Migration Web'
	lineageTag: f02c0e88-0061-46f6-aca1-0ab29ab77610

	/// Observed Webs. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO Observed Webs' =
			VAR _sharedOnly=SELECTEDVALUE('SPO Migration Source Type'[Source Type])="Shared folders"
			VAR _business=ISFILTERED('SPO Migration Business Unit') || ISFILTERED('SPO Migration Phase')
			VAR _projects=VALUES('SPO Migration Project'[Project Identity])
			RETURN IF(NOT _sharedOnly, IF(_business, CALCULATE(DISTINCTCOUNT('SPO Migration Web'[Web Key]), TREATAS(_projects,'SPO Migration Web'[Project Identity]), TREATAS(VALUES('SPO Migration Scope'[Web Key]), 'SPO Migration Web'[Web Key])), CALCULATE(DISTINCTCOUNT('SPO Migration Web'[Web Key]), TREATAS(_projects,'SPO Migration Web'[Project Identity]))))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 15684a77-d4d8-4f3e-868e-8adc41dbf9f2

	/// Webs Without Plan. Observed webs without a plan have no attributable business unit or phase, so that global counter preserves the technical context and source flow but ignores those two business filters.
	measure 'SPO Webs Without Plan' = CALCULATE([SPO Observed Webs], KEEPFILTERS('SPO Migration Web'[Coverage Kind]="NOTINPLAN"), REMOVEFILTERS('SPO Migration Business Unit'), REMOVEFILTERS('SPO Migration Phase'))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 60b9f985-b806-43c3-bf70-d723b2d3f8f1

	/// Whole Webs Covered. Observed webs without a plan have no attributable business unit or phase, so that global counter preserves the technical context and source flow but ignores those two business filters.
	measure 'SPO Whole Webs Covered' = CALCULATE([SPO Observed Webs], KEEPFILTERS('SPO Migration Web'[Coverage Kind]="Whole web coverage"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 520e5578-f812-4a1f-818c-149a135ae656

	/// Partial Webs. Observed webs without a plan have no attributable business unit or phase, so that global counter preserves the technical context and source flow but ignores those two business filters.
	measure 'SPO Partial Webs' = CALCULATE([SPO Observed Webs], KEEPFILTERS('SPO Migration Web'[Coverage Kind]="Partial content only"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 62893cb6-2223-4feb-9cb9-6783fb4b35d8

	/// Conflicting Webs. Observed webs without a plan have no attributable business unit or phase, so that global counter preserves the technical context and source flow but ignores those two business filters.
	measure 'SPO Conflicting Webs' = CALCULATE([SPO Observed Webs], KEEPFILTERS('SPO Migration Web'[Coverage Kind]="Conflict"))
		formatString: #,##0
		displayFolder: Migration\Reconciliation
		lineageTag: 3ddb88e0-148f-452a-a6c6-d1794e7729c4

	/// On-prem Coverage Context. Operations use distinct source-type-qualified identities. Declared progress is separate from technical observation and validation.
	measure 'SPO On-prem Coverage Context' = IF(SELECTEDVALUE('SPO Migration Source Type'[Source Type])="Shared folders", "Not applicable: no SMB inventory, volume or ACL evidence", "Observed webs; partial inventory cannot prove absence or deletion")
		formatString: General
		displayFolder: Migration\Reconciliation
		lineageTag: 01890348-ef8e-4a5c-9a3c-cf1b767dcdbf

	/// Prepared, tenant-qualified migration evidence: TenantKey.
	column TenantKey
		dataType: string
		isHidden
		lineageTag: dbc9a507-d56e-4553-8a0a-340148a8321d
		summarizeBy: none
		sourceColumn: TenantKey

	/// Prepared, tenant-qualified migration evidence: Project Key.
	column 'Project Key'
		dataType: string
