		sourceColumn: Account Key

	column 'Inventory Source'
		dataType: string
		lineageTag: 9a3db194-94ba-4a64-8398-d597909b3bc7
		summarizeBy: none
		sourceColumn: Inventory Source

	column 'Account Kind'
		dataType: string
		lineageTag: c1b26805-fe8e-41f3-a185-310de8a30acc
		summarizeBy: none
		sourceColumn: Account Kind

	column 'AD State'
		dataType: string
		lineageTag: 83c38f91-eac8-4024-9768-3371e12ba3de
		summarizeBy: none
		sourceColumn: AD State

	column 'Entra State'
		dataType: string
		lineageTag: 00fb2cae-dd9c-4a44-9edc-6c62f81bb353
		summarizeBy: none
		sourceColumn: Entra State

	column 'Entra User Type'
		dataType: string
		lineageTag: d8b9d5de-6675-45d5-be7f-872f3b0439f6
