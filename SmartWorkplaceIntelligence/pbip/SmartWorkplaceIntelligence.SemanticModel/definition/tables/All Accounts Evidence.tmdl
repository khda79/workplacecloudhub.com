	column 'Country Basis'
		dataType: string
		lineageTag: 1ae4cd14-7f15-49c8-ab3b-a1d0951a031a
		summarizeBy: none
		sourceColumn: Country Basis

	column 'Match Basis'
		dataType: string
		lineageTag: 2c0c1035-1b06-47ee-9900-a920c6374f16
		summarizeBy: none
		sourceColumn: Match Basis

	column 'UPN Comparison'
		dataType: string
		lineageTag: a8749fc7-de17-4289-9a71-af63895dde34
		summarizeBy: none
		sourceColumn: UPN Comparison

	column 'AD Observation UTC'
		dataType: string
		lineageTag: c2556dbf-9b13-4402-b0e7-c3c06a4a0813
		summarizeBy: none
		sourceColumn: AD Observation UTC

	column 'Entra Observation UTC'
		dataType: string
		lineageTag: 90b11263-dae2-4810-9c49-3c6b6fd583cf
		summarizeBy: none
		sourceColumn: Entra Observation UTC

	/// Canonical country name from the complete ISO reference. Missing country is Unknown; no country inference from device names.
	column 'Country Name' =
			VAR _raw = TRIM('All Accounts Evidence'[Country])
			VAR _code = IF(UPPER(_raw) = "UK", "GB", UPPER(_raw))
			VAR _codeName = LOOKUPVALUE('Country Reference'[Country Name], 'Country Reference'[Country Code], _code)
			VAR _sourceName = LOOKUPVALUE('Country Reference'[Country Name], 'Country Reference'[Source Country Name], _raw)
			RETURN IF(_raw = "" || UPPER(_raw) = "UNKNOWN", "Unknown", COALESCE(_codeName, _sourceName, _raw))
		dataType: string
		lineageTag: bd09f327-c40e-4438-a8b1-154859f5a550
		summarizeBy: none

	/// Actual prepared batch used by this query. Technical provenance only; empty tables have no observable batch.
	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 94971a9e-98d9-4978-a9fd-1c30a5d149ec
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	partition 'All Accounts Evidence' = m
		mode: import
		source =
				let
				    Readers = CreatePreparedReaders(),
				    GetPreparedEvidenceFile = Readers[GetPreparedEvidenceFile],
				    GetPreparedBatchManifest = Readers[GetPreparedBatchManifest],
				    GetLicenseReportQualification = Readers[GetLicenseReportQualification],
				    LicenseReportFileUsable = Readers[LicenseReportFileUsable],
				    GetLicenseReportSnapshot = Readers[GetLicenseReportSnapshot],
				    GetLicenseReportCsv = Readers[GetLicenseReportCsv],
				    ReadMigrationCsv = Readers[ReadMigrationCsv],
				    CreateMailboxMigrationReader = Readers[CreateMailboxMigrationReader],
				    ReadMailboxMigrationCsv = Readers[ReadMailboxMigrationCsv],
				    ReadMigrationWeeklyHistory = Readers[ReadMigrationWeeklyHistory],
				    GetSharePointOnPremCsv = Readers[GetSharePointOnPremCsv],
				    GetSharePointMigrationEvidence = Readers[GetSharePointMigrationEvidence],
				    BusinessRows = (let
				    Source = ReadMigrationCsv(GetPreparedEvidenceFile("AllAccountsEvidence.csv"), {"TenantKey", "Account Key", "Inventory Source", "Account Kind", "AD State", "Entra State", "Entra User Type", "Country", "Country Basis", "Match Basis", "UPN Comparison", "AD Observation UTC", "Entra Observation UTC"}),
				    Selected = Table.SelectColumns(Source, {"TenantKey", "Account Key", "Inventory Source", "Account Kind", "AD State", "Entra State", "Entra User Type", "Country", "Country Basis", "Match Basis", "UPN Comparison", "AD Observation UTC", "Entra Observation UTC"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"TenantKey", type text}, {"Account Key", type text}, {"Inventory Source", type text}, {"Account Kind", type text}, {"AD State", type text}, {"Entra State", type text}, {"Entra User Type", type text}, {"Country", type text}, {"Country Basis", type text}, {"Match Basis", type text}, {"UPN Comparison", type text}, {"AD Observation UTC", type text}, {"Entra Observation UTC", type text}}),
				    NormalizeUtc = (raw as nullable text) as text => if raw = null or Text.Trim(raw) = "" then "" else let
				        Parsed = if Text.Contains(raw, "T") then DateTimeZone.FromText(raw, [Culture="en-US"]) else DateTime.AddZone(DateTime.FromText(raw, [Culture="en-US"]), 0)
				    in DateTimeZone.ToText(DateTimeZone.SwitchZone(Parsed, 0), "yyyy-MM-dd'T'HH:mm:ss'Z'", "en-US"),
				    NormalizedUtc = Table.TransformColumns(Typed, {{"AD Observation UTC", NormalizeUtc, type text}, {"Entra Observation UTC", NormalizeUtc, type text}})
				in
				    NormalizedUtc)
				in
				    Readers[Finish](BusinessRows)
