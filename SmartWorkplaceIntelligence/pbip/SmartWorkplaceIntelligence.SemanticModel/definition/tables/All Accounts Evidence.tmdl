/// Deduplicated AD user and managed-service accounts plus all Entra users. Includes disabled, guest and service accounts; excludes computer accounts, groups and contacts. Strong SID/immutable-ID matches only; never name or UPN merges. Country filters are applied virtually from Country Selection.
table 'All Accounts Evidence'
	lineageTag: ca87930c-7b4d-4be6-9f41-ed1a68dca80f

	/// All canonical AD/Entra account identities from the loaded batch, including disabled/guests/service identities. Country and AD Domain apply through the global account inventory; exact native identities only.
	measure 'All Accounts' = [Account Inventory Accounts]
		formatString: #,0
		displayFolder: Executive overview
		lineageTag: 5cbdbf1d-6da3-4609-af7f-e2e26b813552

	/// AD user and managed-service accounts + all Entra users, including disabled, guest and service accounts. Deduplicated by SID/immutable-ID; names and UPNs never merge records. Excludes computers, groups and contacts. Source-publication timestamps (UTC) are not event times; country may be Unknown.
	measure 'All Accounts Scope' = "AD user and managed-service accounts + all Entra users (disabled, guests and services included). Strong SID/immutable-ID deduplication; no name or UPN merges. Excludes computers, groups and contacts. Source-publication UTC is not an event time." & UNICHAR(10) & "AD export UTC: " & MAX('All Accounts Evidence'[AD Observation UTC]) & UNICHAR(10) & "Entra export UTC: " & MAX('All Accounts Evidence'[Entra Observation UTC])
		isHidden
		displayFolder: Evidence scope
		lineageTag: 397ebc17-38fb-430a-96ab-2bf102b19e41

	column TenantKey
		dataType: string
		isHidden
		lineageTag: 32c7e71f-c424-4b96-a6dc-31f6e2c0b384
		summarizeBy: none
		sourceColumn: TenantKey

	column 'Account Key'
		dataType: string
		isHidden
