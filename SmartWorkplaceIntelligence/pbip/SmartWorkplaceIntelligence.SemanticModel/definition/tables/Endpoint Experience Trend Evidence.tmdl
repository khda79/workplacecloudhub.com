		lineageTag: 6f88a32e-ba54-4590-8308-96593d6156ef
		summarizeBy: none
		sourceColumn: Evidence Status

	partition 'Endpoint Experience Trend Evidence Import' = m
		mode: import
		source =
				let
				    Raw = Table.PromoteHeaders(Csv.Document(GetPreparedEvidenceFile("EndpointExperienceTrendEvidence.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]), [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Raw, {"Snapshot Date", "Snapshot Week", "Endpoint Analytics Covered Devices", "Endpoint Analytics Score", "Endpoint Analytics Below 50 Devices", "Startup Covered Devices", "Startup Score", "Startup Below 50 Devices", "App Reliability Covered Devices", "App Reliability Score", "Devices with Stop Errors", "Devices with Boot Time over 60s", "Devices with Sign-in Time over 30s", "Evidence Status"}),
				    Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, {"Snapshot Date", "Endpoint Analytics Covered Devices", "Endpoint Analytics Score", "Endpoint Analytics Below 50 Devices", "Startup Covered Devices", "Startup Score", "Startup Below 50 Devices", "App Reliability Covered Devices", "App Reliability Score", "Devices with Stop Errors", "Devices with Boot Time over 60s", "Devices with Sign-in Time over 30s"}),
				    Typed = Table.TransformColumnTypes(Nulls, {{"Snapshot Date", type datetime}, {"Snapshot Week", type text}, {"Endpoint Analytics Covered Devices", Int64.Type}, {"Endpoint Analytics Score", type number}, {"Endpoint Analytics Below 50 Devices", Int64.Type}, {"Startup Covered Devices", Int64.Type}, {"Startup Score", type number}, {"Startup Below 50 Devices", Int64.Type}, {"App Reliability Covered Devices", Int64.Type}, {"App Reliability Score", type number}, {"Devices with Stop Errors", Int64.Type}, {"Devices with Boot Time over 60s", Int64.Type}, {"Devices with Sign-in Time over 30s", Int64.Type}, {"Evidence Status", type text}}, "en-US")
				in
				    Typed

