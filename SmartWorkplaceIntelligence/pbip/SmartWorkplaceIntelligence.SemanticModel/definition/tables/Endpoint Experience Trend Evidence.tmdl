/// History disabled in current-state-only mode. Empty compatibility schema retained for existing model dependencies.
table 'Endpoint Experience Trend Evidence'
	lineageTag: 65e78def-8d34-4d60-86ca-0cf95418e599

	/// Average Endpoint Analytics score in the weekly DATA-ALL aggregate.
	measure 'Trend Endpoint Analytics Score' = MAX('Endpoint Experience Trend Evidence'[Endpoint Analytics Score])
		formatString: 0.0
		displayFolder: Endpoint Experience | Trend
		lineageTag: a7751fff-47f8-49ee-a3e2-6bd9d328edc7

	/// Average startup score in the weekly DATA-ALL aggregate.
	measure 'Trend Startup Score' = MAX('Endpoint Experience Trend Evidence'[Startup Score])
		formatString: 0.0
		displayFolder: Endpoint Experience | Trend
		lineageTag: b9b28e40-e1bc-464b-ac97-6b9c03e262fe

	/// Average application reliability score in the weekly DATA-ALL aggregate.
	measure 'Trend App Reliability Score' = MAX('Endpoint Experience Trend Evidence'[App Reliability Score])
		formatString: 0.0
		displayFolder: Endpoint Experience | Trend
		lineageTag: a41d2979-97a3-412c-9563-39fd1eb53c28

	/// Endpoint Analytics covered devices in the weekly DATA-ALL aggregate.
	measure 'Trend Endpoint Analytics Covered Devices' = SUM('Endpoint Experience Trend Evidence'[Endpoint Analytics Covered Devices])
		formatString: #,0
		displayFolder: Endpoint Experience | Trend
		lineageTag: 3e44ef70-ca11-45ea-8327-e9b9bcd7ea7d

	/// Devices below an Endpoint Analytics score of 50 in the weekly DATA-ALL aggregate.
	measure 'Trend Endpoint Analytics Below 50 Devices' = SUM('Endpoint Experience Trend Evidence'[Endpoint Analytics Below 50 Devices])
		formatString: #,0
		displayFolder: Endpoint Experience | Trend
		lineageTag: 090ca9af-bc8a-450f-b34a-196ee58c2052

	/// Devices with stop errors in the weekly DATA-ALL aggregate.
	measure 'Trend Devices with Stop Errors' = SUM('Endpoint Experience Trend Evidence'[Devices with Stop Errors])
		formatString: #,0
		displayFolder: Endpoint Experience | Trend
		lineageTag: 19170ff8-df1a-4969-968a-7a721a901d3f

	/// Score change between the first and last observed Endpoint Analytics weekly snapshots.
	measure 'Endpoint Analytics Score Period Change' = VAR _FirstObservedDate = MINX(ALLSELECTED('Endpoint Experience Trend Evidence'[Snapshot Date]), 'Endpoint Experience Trend Evidence'[Snapshot Date]) VAR _LastObservedDate = MAXX(ALLSELECTED('Endpoint Experience Trend Evidence'[Snapshot Date]), 'Endpoint Experience Trend Evidence'[Snapshot Date]) VAR _FirstObservedValue = CALCULATE([Trend Endpoint Analytics Score], 'Endpoint Experience Trend Evidence'[Snapshot Date] = _FirstObservedDate) VAR _LastObservedValue = CALCULATE([Trend Endpoint Analytics Score], 'Endpoint Experience Trend Evidence'[Snapshot Date] = _LastObservedDate) RETURN IF(ISBLANK(_FirstObservedValue) || ISBLANK(_LastObservedValue), "--", FORMAT(_LastObservedValue - _FirstObservedValue, "+0.0;-0.0;0.0"))
		formatString: @
		displayFolder: Endpoint Experience | Trend
		lineageTag: 465b13d8-81a7-46db-971e-98856d8c716e

	column 'Snapshot Date'
		dataType: dateTime
		formatString: Short Date
		lineageTag: 3d80c4b1-fa8f-49a2-b5de-8e2431dee5b7
		summarizeBy: none
		sourceColumn: Snapshot Date

	column 'Snapshot Week'
		dataType: string
		lineageTag: c30a3e94-64e0-4a8a-99b9-e2af3f53cede
