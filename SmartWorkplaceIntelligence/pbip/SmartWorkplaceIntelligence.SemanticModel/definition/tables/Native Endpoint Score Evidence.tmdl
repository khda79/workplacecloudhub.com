		sourceColumn: OrganizationKey

	/// Native FactEndpointAnalyticsDevice attribute; source qualification is retained.
	column EnvironmentKey
		dataType: string
		isHidden
		lineageTag: a234cff4-c3fd-4fd4-8da0-2fb9841a1df0
		summarizeBy: none
		sourceColumn: EnvironmentKey

