/// Complete retained Exchange infrastructure source observations at source-file, record and attribute grain. Missing sources are explicit unknown markers. Global infrastructure; Country and AD Domain do not attribute server locations.
table 'Exchange On-prem Infrastructure'
	lineageTag: fc3ca5b2-7bbf-4fa6-a98e-8327fe09770a

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Captured Sources' = COALESCE(CALCULATE(DISTINCTCOUNT('Exchange On-prem Infrastructure'[Source File]), REMOVEFILTERS('Exchange On-prem Infrastructure'), 'Exchange On-prem Infrastructure'[Source Available]=TRUE()),0)
		formatString: #,0
		displayFolder: Infrastructure
		lineageTag: ca331a46-3601-4560-8fad-13ad604ef92e

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Status' = VAR _n=[Exchange Infrastructure Captured Sources] RETURN IF(_n=0,"Not captured in selected batch | Infrastructure files require a future prepared batch; unknown is not healthy.",FORMAT(_n,"0") & "/12 source files captured | Observed configuration; inspect collection status and missing evidence.")
		formatString: @
		displayFolder: Infrastructure
		lineageTag: 17a51966-4fe0-4438-95e1-40bb5c0666ef

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Servers' = VAR _n=CALCULATE(COUNTROWS('Exchange On-prem Infrastructure'),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Servers"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="Name"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE())) RETURN IF(_n>0,CALCULATE(DISTINCTCOUNT('Exchange On-prem Infrastructure'[Source Row Key]),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Servers"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="Name"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE())))
		formatString: #,0
		displayFolder: Infrastructure
		lineageTag: cee79acc-dd25-4087-8225-2a526339f373

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Physical Cores' = CALCULATE(SUM('Exchange On-prem Infrastructure'[Numeric Value]),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Compute"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="PhysicalCoreCount"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()),KEEPFILTERS('Exchange On-prem Infrastructure'[Collection Status]="OK"))
		formatString: #,0
		displayFolder: Infrastructure
		lineageTag: 2f9ac1d1-de98-4be9-ad53-8328d1637d36

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Memory GB' = CALCULATE(SUM('Exchange On-prem Infrastructure'[Numeric Value]),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Compute"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="MemoryGB"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()),KEEPFILTERS('Exchange On-prem Infrastructure'[Collection Status]="OK"))
		formatString: #,0.0
		displayFolder: Infrastructure
		lineageTag: 217eb08e-eb12-4bf7-9e85-168be42565eb

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Logical Disk GB' = CALCULATE(SUM('Exchange On-prem Infrastructure'[Numeric Value]),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Logical disks"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="SizeGB"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()),KEEPFILTERS('Exchange On-prem Infrastructure'[Collection Status]="OK"))
		formatString: #,0.0
		displayFolder: Infrastructure
		lineageTag: 758d1047-e83f-4592-af78-ed07f233d75e

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Free Disk GB' = CALCULATE(SUM('Exchange On-prem Infrastructure'[Numeric Value]),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Logical disks"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="FreeGB"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()),KEEPFILTERS('Exchange On-prem Infrastructure'[Collection Status]="OK"))
		formatString: #,0.0
		displayFolder: Infrastructure
		lineageTag: 1325cd94-3927-45f2-b547-9a02d751a9eb

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Low Space Volumes' = VAR _observed=CALCULATE(COUNTROWS('Exchange On-prem Infrastructure'),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Logical disks"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="LowSpaceWarning"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()),KEEPFILTERS('Exchange On-prem Infrastructure'[Collection Status]="OK")) RETURN IF(_observed>0,COALESCE(CALCULATE(DISTINCTCOUNT('Exchange On-prem Infrastructure'[Source Row Key]),KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Logical disks"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="LowSpaceWarning"),KEEPFILTERS('Exchange On-prem Infrastructure'[Value]="True"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()),KEEPFILTERS('Exchange On-prem Infrastructure'[Collection Status]="OK")),0))
		formatString: #,0
		displayFolder: Infrastructure
		lineageTag: 60da6e16-e90b-496b-9fd5-182324755365

	/// Observed selected-batch infrastructure. Missing captures and missing numeric observations stay blank. This is not a licensing, migration-readiness or effective health assertion.
	measure 'Exchange Infrastructure Collection Issues' = VAR _observed=CALCULATE(COUNTROWS('Exchange On-prem Infrastructure'),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE())) RETURN IF(_observed>0,COALESCE(CALCULATE(DISTINCTCOUNT('Exchange On-prem Infrastructure'[Source Row Key]),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()),KEEPFILTERS('Exchange On-prem Infrastructure'[Collection Status] IN {"ERROR","WARNING"})),0))
		formatString: #,0
		displayFolder: Infrastructure
		lineageTag: dc180926-560b-4791-a0ee-96da89bb0668

	/// Legacy means Exchange 2016 or earlier (15.1 or earlier). Percentage unavailable when a server version is unknown; denominator is observed inventoried servers.
	measure 'Exchange Legacy Servers' =
			VAR _servers=[Exchange Infrastructure Servers] VAR _rows=CALCULATETABLE(SELECTCOLUMNS('Exchange On-prem Infrastructure',"Version",'Exchange On-prem Infrastructure'[Value]),
			        KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Servers"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="AdminDisplayVersion"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()))
			RETURN IF(NOT ISBLANK(_servers),COALESCE(SUMX(_rows,VAR _text=SUBSTITUTE(LOWER(TRIM([Version])),"version ","")
			    VAR _major=IFERROR(VALUE(LEFT(_text,FIND(".",_text)-1)),BLANK())
			    VAR _rest=IFERROR(MID(_text,FIND(".",_text)+1,100),"")
			    VAR _part=SUBSTITUTE(SUBSTITUTE(_rest,"."," "),"("," ")
			    VAR _minor=IFERROR(VALUE(LEFT(_part,FIND(" ",_part & " ")-1)),BLANK())
			    VAR _valid=NOT ISBLANK(_major) && NOT ISBLANK(_minor) && _major>=6 && _minor>=0 && INT(_major)=_major && INT(_minor)=_minor RETURN IF(_valid && (_major<15 || (_major=15 && _minor<=1)),1,0)),0))
		formatString: #,0
		lineageTag: 31ee209d-7566-4eb1-b59f-d147224359f6

	/// Legacy means Exchange 2016 or earlier (15.1 or earlier). Percentage unavailable when a server version is unknown; denominator is observed inventoried servers.
	measure 'Exchange Unknown Server Versions' =
			VAR _servers=[Exchange Infrastructure Servers] VAR _rows=CALCULATETABLE(SELECTCOLUMNS('Exchange On-prem Infrastructure',"Version",'Exchange On-prem Infrastructure'[Value]),
			        KEEPFILTERS('Exchange On-prem Infrastructure'[Dataset]="Servers"),KEEPFILTERS('Exchange On-prem Infrastructure'[Attribute]="AdminDisplayVersion"),KEEPFILTERS('Exchange On-prem Infrastructure'[Source Available]=TRUE()))
			VAR _known=SUMX(_rows,VAR _text=SUBSTITUTE(LOWER(TRIM([Version])),"version ","")
			    VAR _major=IFERROR(VALUE(LEFT(_text,FIND(".",_text)-1)),BLANK())
			    VAR _rest=IFERROR(MID(_text,FIND(".",_text)+1,100),"")
			    VAR _part=SUBSTITUTE(SUBSTITUTE(_rest,"."," "),"("," ")
			    VAR _minor=IFERROR(VALUE(LEFT(_part,FIND(" ",_part & " ")-1)),BLANK())
			    VAR _valid=NOT ISBLANK(_major) && NOT ISBLANK(_minor) && _major>=6 && _minor>=0 && INT(_major)=_major && INT(_minor)=_minor RETURN IF(_valid,1,0))
			RETURN IF(NOT ISBLANK(_servers),MAX(0,_servers-COALESCE(_known,0)))
		formatString: #,0
		lineageTag: 237f7379-be05-4d0a-9180-a8a6e5045f0c

	/// Legacy means Exchange 2016 or earlier (15.1 or earlier). Percentage unavailable when a server version is unknown; denominator is observed inventoried servers.
	measure 'Exchange Legacy Server Percent' = IF([Exchange Unknown Server Versions]=0,DIVIDE([Exchange Legacy Servers],[Exchange Infrastructure Servers]))
		formatString: 0.0%
		lineageTag: a4050c2e-ce22-4331-80ad-eaea77456a4c

	/// Legacy means Exchange 2016 or earlier (15.1 or earlier). Percentage unavailable when a server version is unknown; denominator is observed inventoried servers.
	measure 'Exchange Legacy Server Display' =
			VAR _n=[Exchange Legacy Servers] VAR _pct=[Exchange Legacy Server Percent]
			RETURN IF(ISBLANK(_n),"Not captured",FORMAT(_n,"0") & " (" & IF(ISBLANK(_pct),"n/a",FORMAT(_pct,"0.0%")) & ")")
		formatString: @
		lineageTag: b65a2026-e27f-4404-8b2b-25418cf7b7e8

