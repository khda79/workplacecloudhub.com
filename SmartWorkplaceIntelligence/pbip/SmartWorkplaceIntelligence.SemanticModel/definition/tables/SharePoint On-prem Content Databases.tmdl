/// Current SharePoint Server inventory; one row per content database. Tenant and farm identity are retained in hidden relationship keys.
table 'SharePoint On-prem Content Databases'
	lineageTag: 88d28459-3069-44b2-bbec-f778091b9b14

	/// Observed content databases in the Infrastructure inventory.
	measure 'On-prem Content Databases' = COUNTROWS('SharePoint On-prem Content Databases')
		formatString: #,##0
		lineageTag: d54d5dab-c89f-433e-8934-0c8e2f9f9df4

	/// SharePoint content database CurrentSiteCount total. This is Infrastructure metadata, not a qualified Content collection count.
	measure 'Reported Site Collections' = SUM('SharePoint On-prem Content Databases'[Reported Site Collection Count])
		formatString: #,##0
		lineageTag: 6765a481-8c42-41db-b0c0-3a949c586a0f

	/// Databases whose read-only property was observed as true.
	measure 'Read-only Content Databases' = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Content Databases'), KEEPFILTERS('SharePoint On-prem Content Databases'[Database Read Only] = "True")), 0)
		formatString: #,##0
		lineageTag: 46d8bff6-9657-4afc-9192-646be2383aac

	/// Databases with an observed NeedsUpgradeIncludeChildren=true. Missing values are excluded.
	measure 'Databases Needing Upgrade' = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Content Databases'), KEEPFILTERS('SharePoint On-prem Content Databases'[Needs Upgrade] = "True"), KEEPFILTERS('SharePoint On-prem Content Databases'[Upgrade Evidence Status] = "Collected")), 0)
		formatString: #,##0
		lineageTag: 1551cc89-0386-4dc3-9717-5e0ecec447a3

	/// Databases without a qualified upgrade observation.
	measure 'Upgrade Evidence Unavailable' = CALCULATE(COUNTROWS('SharePoint On-prem Content Databases'), KEEPFILTERS('SharePoint On-prem Content Databases'[Upgrade Evidence Status] <> "Collected"))
		formatString: #,##0
		lineageTag: ebd8e5ca-95ff-4fb4-bf21-2c0820375b18

	/// Databases for which this collector does not provide measured database size.
	measure 'Database Size Unavailable' = CALCULATE(COUNTROWS('SharePoint On-prem Content Databases'), KEEPFILTERS('SharePoint On-prem Content Databases'[Database Size Status] <> "Measured"))
		formatString: #,##0
		lineageTag: 8237c09a-c586-4b6e-88c8-7c1eddd5fa65

	/// Number of content databases without measured size divided by all observed content databases in the current filter context.
	measure 'Database Size Coverage Label' = FORMAT(COALESCE([Database Size Unavailable], 0), "#,##0") & "/" & FORMAT(COALESCE([On-prem Content Databases], 0), "#,##0") & " not collected"
		formatString: @
		lineageTag: ef5e8577-1c81-4bef-946e-36628b67ff7d

	/// Infrastructure content databases reporting zero site collections; does not assess Content collection completeness.
	measure 'Empty Content Databases' = COALESCE(CALCULATE(COUNTROWS('SharePoint On-prem Content Databases'), KEEPFILTERS('SharePoint On-prem Content Databases'[Reported Site Collection Count] = 0)), 0)
		formatString: #,##0
		lineageTag: 500181c1-2fd2-4638-9ca8-84ac9ea07886

	column 'Tenant Key'
