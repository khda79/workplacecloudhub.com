	column 'Report Linked Mailbox Key' = VAR g=LOWER(SUBSTITUTE(SUBSTITUTE('Mailbox Migration Inventory'[Mailbox GUID],"{",""),"}","")) VAR b='Mailbox Migration Inventory'[Loaded Batch ID] RETURN IF(NOT ISBLANK(g),LOOKUPVALUE('Mailbox Exploration Inventory'[Mailbox Key],'Mailbox Exploration Inventory'[Report Mailbox GUID],g,'Mailbox Exploration Inventory'[Loaded Batch ID],b,BLANK()))
