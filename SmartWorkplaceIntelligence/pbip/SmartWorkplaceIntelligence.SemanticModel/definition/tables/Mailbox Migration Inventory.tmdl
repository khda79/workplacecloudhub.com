/// Private source-backed migration planning evidence. Unknown is not zero. No Infrastructure hybride assessment.
table 'Mailbox Migration Inventory'
	lineageTag: 685b37c0-abea-40f8-8d8d-c2eff6868231

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Local Business Mailboxes Remaining' = IF(COUNTROWS(ALL('Mailbox Migration Inventory')) > 0, COALESCE(COUNTROWS(FILTER('Mailbox Migration Inventory','Mailbox Migration Inventory'[Mailbox Type] IN {"UserMailbox","SharedMailbox","RoomMailbox","EquipmentMailbox","LinkedMailbox"})),0), BLANK())
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 8986d4e5-79ee-4a36-8787-70b98a8d7f3a

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Local Mailbox Inventory Records' = IF(COUNTROWS(ALL('Mailbox Migration Inventory')) > 0, COALESCE(COUNTROWS('Mailbox Migration Inventory'),0), BLANK())
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 12ced943-6901-4f3c-b6b1-da35ad780ffb

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Observed Mailbox Migration Blockers' = IF(COUNTROWS(ALL('Mailbox Migration Inventory')) > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Migration Inventory'),KEEPFILTERS('Mailbox Migration Inventory'[Migration Status]="Observed blocker")),0), BLANK())
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 3eed4ee4-9658-49ca-a72c-75527f0c6b8d

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Mailbox Migration Risk Review' = IF(COUNTROWS(ALL('Mailbox Migration Inventory')) > 0, COALESCE(CALCULATE(COUNTROWS('Mailbox Migration Inventory'),KEEPFILTERS('Mailbox Migration Inventory'[Migration Status]="Risk review required")),0), BLANK())
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: cf77b00b-4ab9-423d-980e-22adca37ce40

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views.
	measure 'Mailbox Migration Readiness' = "Unknown"
		displayFolder: Migration planning
		lineageTag: a743d8de-73d1-4656-be03-78a2fa1422ae

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views.
	measure 'Mailbox Migration Source Date' = "2026-10-08 · batch observations may be stale"
		displayFolder: Migration planning
		lineageTag: d1d8ba32-d974-4757-b873-0b868ee1cde6

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Large Mailboxes For Review' = IF(COUNTROWS(ALL('Mailbox Migration Inventory')) > 0, COALESCE(COUNTROWS(FILTER('Mailbox Migration Inventory',NOT ISBLANK('Mailbox Migration Inventory'[Mailbox Size GB]) && 'Mailbox Migration Inventory'[Mailbox Size GB] >=45)),0), BLANK())
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 660f4f7a-22a7-48f6-bc57-03b9d2e65a6e

	/// Observed local migration planning evidence. Missing evidence is not zero; see provenance and task views. Unloaded/empty source is blank, never a verified zero.
	measure 'Mailboxes With Size Unknown' = IF(COUNTROWS(ALL('Mailbox Migration Inventory')) > 0, COALESCE(COUNTROWS(FILTER('Mailbox Migration Inventory',ISBLANK('Mailbox Migration Inventory'[Mailbox Size GB]))),0), BLANK())
		formatString: #,0
		displayFolder: Migration planning
		lineageTag: 384327fe-d9be-4426-9578-43b375f003d7

	/// All local inventory records explicitly attributed to Exchange Server 2016. This population is distinct from unified mailbox evidence.
	measure 'Local Mailboxes (2016)' = CALCULATE([Local Mailbox Inventory Records], KEEPFILTERS('Mailbox Migration Inventory'[Exchange Version] = "Exchange Server 2016"))
		formatString: #,0
		displayFolder: Report refinement
		lineageTag: 0f8f9fd0-e597-4b38-9965-974d794e2196

	/// All local inventory records explicitly attributed to Exchange Server 2019 or SE. Unknown versions are excluded.
	measure 'Local Mailboxes (2019/SE)' = CALCULATE([Local Mailbox Inventory Records], KEEPFILTERS('Mailbox Migration Inventory'[Exchange Version] IN {"Exchange Server 2019", "Exchange Server SE"}))
		formatString: #,0
		displayFolder: Report refinement
		lineageTag: c26eebf9-6e71-445e-8306-618d214d5da5

