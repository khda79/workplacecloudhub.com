	column 'Report UPN' = VAR k='Mailbox Migration Inventory'[Report Linked Mailbox Key] VAR b='Mailbox Migration Inventory'[Loaded Batch ID] RETURN IF(NOT ISBLANK(k),LOOKUPVALUE('Mailbox Exploration Inventory'[User Principal Name],'Mailbox Exploration Inventory'[Mailbox Key],k,'Mailbox Exploration Inventory'[Loaded Batch ID],b,BLANK()))
