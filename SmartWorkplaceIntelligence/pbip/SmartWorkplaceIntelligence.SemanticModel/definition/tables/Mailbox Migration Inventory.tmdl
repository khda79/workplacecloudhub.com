	column 'Loaded Batch ID'
		dataType: string
		isHidden
		isAvailableInMdx: false
		lineageTag: 9516a25e-139b-4e86-bc06-407e8202b354
		summarizeBy: none
		sourceColumn: Loaded Batch ID

	/// Exact mailbox GUID + loaded batch; blank if missing or ambiguous. Existing canonical mailbox key preserves tenant qualification.
	column 'Report Linked Mailbox Key' = VAR g=LOWER(SUBSTITUTE(SUBSTITUTE('Mailbox Migration Inventory'[Mailbox GUID],"{",""),"}","")) VAR b='Mailbox Migration Inventory'[Loaded Batch ID] RETURN IF(NOT ISBLANK(g),LOOKUPVALUE('Mailbox Exploration Inventory'[Mailbox Key],'Mailbox Exploration Inventory'[Report Mailbox GUID],g,'Mailbox Exploration Inventory'[Loaded Batch ID],b,BLANK()))
		dataType: string
		isHidden
		lineageTag: 722dbddb-acd5-40be-950e-8a5f9896985b

	/// Existing loaded mailbox detail, matched uniquely by GUID + batch to a tenant-qualified mailbox identity. Unknown remains blank.
	column 'Report UPN' = VAR k='Mailbox Migration Inventory'[Report Linked Mailbox Key] VAR b='Mailbox Migration Inventory'[Loaded Batch ID] RETURN IF(NOT ISBLANK(k),LOOKUPVALUE('Mailbox Exploration Inventory'[User Principal Name],'Mailbox Exploration Inventory'[Mailbox Key],k,'Mailbox Exploration Inventory'[Loaded Batch ID],b,BLANK()))
		dataType: string
		displayFolder: Migration queue identity
		lineageTag: 39edbead-ef18-440b-a2c5-81d01652a8bd

